def _app_changes() -> None:
    """Zmiany w projekcie: z gita (stan roboczy względem HEAD), a bez gita pliki zmienione w tej sesji."""
    files: list = []
    code, top = _run_capture(["git", "rev-parse", "--show-toplevel"], timeout=10, tail=500)
    if code == 0:
        _, branch = _run_capture(["git", "rev-parse", "--abbrev-ref", "HEAD"], timeout=10, tail=200)
        _, st = _run_capture(["git", "status", "--porcelain=v1", "-uall", "--", "."], timeout=20, tail=200_000)
        for line in st.splitlines()[:80]:
            if len(line) < 4:
                continue
            # pierwsza linia mogła stracić spację na początku (wynik jest przycinany)
            flag, path = (line[:2], line[3:]) if line[2] == " " else (line[:1], line[2:])
            flag, path = flag.strip() or "M", path.strip().strip('"')
            if " -> " in path:
                path = path.split(" -> ", 1)[1]
            rel = os.path.relpath(Path(top.strip()) / path, Path.cwd())
            if rel.startswith((".doma/", "../")) or "__pycache__/" in rel or rel.endswith((".pyc", ".DS_Store")):
                continue   # kopie zapasowe Codo i pliki generowane to nie są zmiany użytkownika
            if flag == "??":
                try:
                    lines = (Path.cwd() / rel).read_text(encoding="utf-8", errors="replace").splitlines()
                except OSError:
                    lines = []
                diff = "\n".join("+" + x for x in lines[:400])
                files.append({"path": rel, "status": "new", "added": len(lines), "removed": 0, "diff": diff})
                continue
            _, diff = _run_capture(["git", "diff", "HEAD", "--", rel], timeout=20, tail=120_000)
            body = [x for x in diff.splitlines() if not x.startswith(("diff --git", "index ", "--- ", "+++ "))]
            files.append({"path": rel, "status": {"D": "deleted", "A": "new"}.get(flag[0], "modified"),
                          "added": sum(1 for x in body if x.startswith("+")),
                          "removed": sum(1 for x in body if x.startswith("-")),
                          "diff": "\n".join(body[:600])})
        _app_emit("changes", git=True, branch=branch.strip(), files=files)
        return
    for path in dict.fromkeys(SESSION.get("edited", [])):
        try:
            rel = str(Path(path).relative_to(Path.cwd()))
        except ValueError:
            rel = str(path)
        files.append({"path": rel, "status": "modified", "added": 0, "removed": 0, "diff": ""})
    _app_emit("changes", git=False, branch="", files=files)


