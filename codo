def _host_ensure(wait: float = 10.0) -> bool:
    """Gospodarz agentów działa? Jeśli nie, uruchamiamy go w tle (zostaje po zamknięciu okna)."""
    import time as _time
    if _host_call({"cmd": "state"}, timeout=3):
        return True
    HOST_DIR.mkdir(parents=True, exist_ok=True)
    (HOST_DIR / "log").mkdir(parents=True, exist_ok=True)
    try:
        out = open(HOST_DIR / "log" / "host.out", "ab")
        kw = {"creationflags": 0x08000000 | 0x00000200} if IS_WIN else {"start_new_session": True}
        subprocess.Popen([*_self_cmd(), "host", "run"], stdin=subprocess.DEVNULL, stdout=out, stderr=out, **kw)
    except OSError:
        return False
    end = _time.time() + wait
    while _time.time() < end:
        _time.sleep(0.3)
        if _host_call({"cmd": "state"}, timeout=3):
            return True
    return False


