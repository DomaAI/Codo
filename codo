def _read_terminal_key(fd: int) -> str:
    """Odczyt klawisza bez buforowania TextIO, także dla UTF-8 i strzałek."""
    import codecs
    import select
    first = os.read(fd, 1)
    if not first:
        return ""
    if first == b"\x1b":
        rest = b""
        while len(rest) < 32 and select.select([fd], [], [], 0.05)[0]:
            rest += os.read(fd, 1)
            if len(rest) >= 2 and (rest[-1:] == b"~" or 64 <= rest[-1] <= 126):
                break
        return "\x1b" + rest.decode("ascii", errors="ignore")
    decoder = codecs.getincrementaldecoder("utf-8")("replace")
    value = decoder.decode(first)
    while not value:
        part = os.read(fd, 1)
        if not part:
            return ""
        value = decoder.decode(part)
    return value


def _choose_yes_no(remember: bool = False) -> int:
    """0: nie, 1: tak jednorazowo, 2: tak i zapamiętaj."""
    if not (_tty() and sys.stdin.isatty()) or IS_WIN or os.environ.get("TERM") == "dumb":
        try:
            answer = input("  [t/N" + ("/z" if remember else "") + "] ").strip().lower()
            return 2 if remember and answer in ("2", "p", "z", "zapamiętaj") else int(answer in ("1", "t", "tak", "y", "yes"))
        except EOFError:
            return 0
    import termios
    import tty
    fd = sys.stdin.fileno()
    old = termios.tcgetattr(fd)
    options = [(1, _L("1. Tak, uruchom jednorazowo (y)"))]
    if remember:
        options.append((2, _L("2. Tak, zapamiętaj zgodę na tę czynność w tym folderze (p)")))
    options.append((0, _Lf('{0}. Nie, podam inne wskazówki (Esc)', len(options) + 1)))
    selected = 0
    drawn = False
    try:
        tty.setcbreak(fd)
        while True:
            if drawn:
                sys.stdout.write(f"\033[{len(options)}A")
            import shutil
            width = max(8, shutil.get_terminal_size((80, 24)).columns - 5)
            for i, (_, label) in enumerate(options):
                if len(label) > width:
                    label = label[:width - 1] + "…"
                marker = violet("❯") if selected == i else " "
                highlight = _c("7", label) if selected == i else label
                sys.stdout.write("\r\033[2K  " + marker + " " + highlight + "\n")
            sys.stdout.flush()
            drawn = True
            ch = _read_terminal_key(fd)
            if ch in ("\r", "\n"):
                return options[selected][0]
            if ch in ("1", "2", "3") and int(ch) <= len(options): return options[int(ch) - 1][0]
            if ch.lower() in ("t", "y"): return 1
            if remember and ch.lower() in ("z", "p"): return 2
            if ch.lower() == "n" or ch in ("\x1b", "\x03", "\x04", ""): return 0
            if ch in ("\x1b[A", "\x1b[D"): selected = (selected - 1) % len(options)
            elif ch in ("\x1b[B", "\x1b[C"): selected = (selected + 1) % len(options)
    finally:
        termios.tcsetattr(fd, termios.TCSADRAIN, old)
        if drawn:
            sys.stdout.write(f"\033[{len(options)}A" + "\r\033[2K\n" * len(options) + f"\033[{len(options)}A")
            sys.stdout.flush()


def _terminal_text(value: str) -> str:
    """Keep displayed approval text from moving the cursor or hiding commands."""
    value = re.sub(r"\x1b\][^\x07\x1b]*(?:\x07|\x1b\\)", "", str(value))
    value = re.sub(r"\x1b\[[0-?]*[ -/]*[@-~]", "", value)
    return re.sub(r"[\x00-\x08\x0b-\x1f\x7f]", "", value)


