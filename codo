def current_effort() -> str:
    eff = SESSION.get("effort") or load_settings().get("effort") or "medium"
    return eff if eff in _EFFORTS else "medium"


def _effort_parse(text: str):
    t = (text or "").strip().lower()
    return t if t in _EFFORTS else _EFFORT_ALIASES.get(t)


def _marathon_on() -> bool:
    on = SESSION.get("maraton")
    return bool(load_settings().get("maraton") if on is None else on)


def _effort_dialog() -> tuple | None:
    """Suwak wysiłku: ←/→ poziom, Tab maraton, Enter zapisz, s tylko sesja, Esc anuluj.
    Zwraca (poziom, maraton, tylko_sesja) albo None."""
    import shutil
    level = _EFFORTS.index(current_effort())
    maraton = _marathon_on()
    if not (_tty() and sys.stdin.isatty()) or IS_WIN:
        print(bold(_L("  Wysiłek: ")) + _EFFORT_PL[_EFFORTS[level]] + dim(_L("  (/effort niski|średni|wysoki|bardzo|maks)")))
        return None
    import termios
    import tty
    fd = sys.stdin.fileno()
    old = termios.tcgetattr(fd)
    cols = shutil.get_terminal_size((80, 24)).columns
    slot = 12 if cols >= 80 else 10
    bar_w = slot * (len(_EFFORTS) - 1) + 2 + len(_EFFORT_PL[_EFFORTS[-1]])
    left = max(4, (cols - bar_w) // 2 - 6)
    shown = 0
    try:
        tty.setcbreak(fd)
        sys.stdout.write("\033[?25l")
        while True:
            if shown:
                sys.stdout.write(f"\033[{shown}A")
            eff = _EFFORTS[level]
            pad = " " * left
            names = ""
            for i, e in enumerate(_EFFORTS):
                label = f"{i + 1} {_EFFORT_PL[e]}"
                cell = label.ljust(slot) if i < len(_EFFORTS) - 1 else label
                names += (bold(violet(cell)) if i == level else dim(cell))
            marker_pos = level * slot + 2 + len(_EFFORT_PL[eff]) // 2
            bar = ""
            for x in range(bar_w):
                if x == marker_pos:
                    bar += bold(_rgb((0xe9, 0xd5, 0xff), "◆"))
                elif x < marker_pos:
                    t = x / max(1, bar_w - 1)
                    rgb = tuple(int(a + (b - a) * t) for a, b in zip((0x6d, 0x4a, 0xc9), (0xc4, 0x8f, 0xff)))
                    bar += _rgb(rgb, "━")
                else:
                    bar += dim("─")
            budget = int(load_settings().get("work_budget") or _WORK_BUDGET_DEFAULT)
            hours = float(load_settings().get("work_hours") or _WORK_HOURS_DEFAULT)
            body = [(_L("prowadzi każde zadanie do skutku: odcinki, dziennik, ponawianie") if maraton
                     else _L("zadanie kończy się po jednej turze agenta")),
                    f"limity: {budget} kr · {_hours_label(hours)} · w tle: codo work --bg"]
            inner = min(cols - left - 6, max(len(b) for b in body) + 2)
            head = " Maraton " + (_L("wł.") if maraton else _L("wył.")) + " "
            frame = green if maraton else dim
            card = [frame("╭─" + head) + dim("─" * max(1, inner - len(head) - 7) + _L(" Tab ─╮"))]
            for i, line in enumerate(body):
                line = line[:inner - 2]
                text = line if (i == 0 and maraton) else dim(line)
                card.append(dim("│ ") + text + " " * (inner - 1 - len(line)) + dim("│"))
            card.append(dim("╰" + "─" * inner + "╯"))
            rows = [
                _rgb((0xa8, 0x6a, 0xf0), "─" * (cols - 1)),
                "",
                "  " + violet("✥") + " " + bold(_L("Jak mocno ma myśleć Codo?")),
                "",
                pad + dim(_L("szybko i tanio")) + " " * max(1, bar_w - 14 - 9) + dim(_L("dokładnie")),
                pad + bar,
                pad + names,
                "",
                pad + _EFFORT_DESC[eff],
                pad + dim(_Lf('do {0} kroków na zadanie · koszt: {1}', _EFFORT_STEPS[eff], _EFFORT_COST[eff])
                          + (_L(" · model myśli dłużej") if level >= 2 else "")),
                "",
                *[pad + row for row in card],
                "",
                dim(_L("  ←/→ albo 1–5 · Tab maraton · Enter zapisz · s tylko ta sesja · Esc anuluj")),
            ]
            for row in rows:
                sys.stdout.write("\r\033[2K" + row + "\n")
            sys.stdout.flush()
            shown = len(rows)
            key = _read_terminal_key(fd)
            if key in ("\x1b[D", "h"):
                level = max(0, level - 1)
            elif key in ("\x1b[C", "l"):
                level = min(len(_EFFORTS) - 1, level + 1)
            elif key == "\t":
                maraton = not maraton
            elif key in ("1", "2", "3", "4", "5"):
                level = int(key) - 1
            elif key in ("\r", "\n"):
                return _EFFORTS[level], maraton, False
            elif key in ("s", "S"):
                return _EFFORTS[level], maraton, True
            elif key in ("\x1b", "\x03", "q", ""):
                return None
    finally:
        termios.tcsetattr(fd, termios.TCSADRAIN, old)
        if shown:
            sys.stdout.write(f"\033[{shown}A\r\033[J")
        sys.stdout.write("\033[?25h")
        sys.stdout.flush()


def cmd_effort(arg: str = "") -> None:
