def _link_slug(folder: Path) -> str:
    import hashlib
    h = hashlib.sha256(str(folder).encode()).hexdigest()[:6]
    name = re.sub(r"[^a-zA-Z0-9]+", "-", folder.name).strip("-").lower() or _L("folder")
    return f"{name}-{h}"


