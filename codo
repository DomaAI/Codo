def _clean_path_arg(p) -> str:
    """Ścieżka od modelu w postaci, którą da się otworzyć: bez cudzysłowów i spacji wokół, bez file://,
    bez @ ze wzmianki (@plik), z ~ i $HOME/%USERPROFILE% na początku, a na Windows także /c/Users/… (Git Bash)
    jako C:/Users/…."""
    p = str(p or "").strip()
    if len(p) >= 2 and p[0] == p[-1] and p[0] in "\"'`":
        p = p[1:-1].strip()
    if p.lower().startswith("file://"):
        from urllib.parse import unquote, urlparse
        u = urlparse(p)
        p = unquote(u.path)
        if u.netloc and u.netloc not in ("", "localhost"):
            p = "//" + u.netloc + p
        if os.name == "nt" and re.match(r"^/[A-Za-z]:", p):
            p = p[1:]
    if p.startswith("@") and len(p) > 1 and not (Path.cwd() / p).exists():
        p = p[1:]
    if p.startswith(("$", "%")):
        p = os.path.expandvars(p)
    if p.startswith("~"):
        p = os.path.expanduser(p)   # do 0.28.0 „~/x” tworzyło w projekcie folder o nazwie „~”
    if os.name == "nt":
        m = re.match(r"^/([A-Za-z])(/.*)?$", p)
        if m and not Path(p).exists():
            p = m.group(1).upper() + ":" + (m.group(2) or "/")
    return p


def _is_within(target: Path, base: Path) -> bool:
    """target == base albo leży w base. Na Windows bez rozróżniania wielkości liter (C:\\Users = c:\\users)."""
    t, b = os.path.normcase(str(target)), os.path.normcase(str(base))
    return t == b or t.startswith(b.rstrip("\\/") + os.sep)


def _same_entry(a: Path, b: Path) -> bool:
    """a i b to ten sam plik albo folder w tym samym katalogu, różniący się tylko wielkością liter
    (system plików bez rozróżniania wielkości liter: NTFS, APFS)."""
    try:
        return (os.path.normcase(str(a.parent)) == os.path.normcase(str(b.parent)) and a.name.lower() == b.name.lower()
                and b.exists() and os.path.samefile(_long_path(a), _long_path(b)))
    except OSError:
        return False


def _in_project(path: Path) -> bool:
    try:
        return _is_within(Path(path).resolve(), Path.cwd().resolve())
    except OSError:
        return False


def _cwd_real() -> Path:
    """Katalog roboczy po resolve(), do relative_to() ze ścieżkami po resolve(). Na Windows getcwd() potrafi
    zwrócić krótką nazwę 8.3 (C:\\Users\\RUNNER~1, z %TEMP%) albo literę dysku małą; resolve() daje pełną."""
    return Path.cwd().resolve()


def _resolve_arg(p) -> Path:
    p = _clean_path_arg(p)
    base = Path.cwd().resolve()
    return (base / p).resolve() if not os.path.isabs(p) else Path(p).resolve()


def _safe_path(p: str) -> Path:
    """Ścieżki względne do cwd; absolutne dozwolone tylko wewnątrz cwd
    (agent zarządza TĄ stroną, nie całym systemem)."""
    target = _resolve_arg(p)
    if not _is_within(target, Path.cwd().resolve()):
        raise ValueError(_Lf('Ścieżka poza katalogiem roboczym: {0} (uruchom codo w katalogu strony)', p))
    return target


# Foldery spoza projektu, na które użytkownik zgodził się w tej sesji: (folder, czy także zapis).
_OUTSIDE_OK: list = []
_ASK_LOCAL = __import__("threading").local()   # równoległe odczyty nie pytają (pytanie idzie po kolei)


def _can_ask_outside() -> bool:
    return (_APP.get("out") is not None or bool(os.environ.get("CODO_ZGODY_SOCK"))
            or (_tty() and bool(sys.stdin) and sys.stdin.isatty()))


def _agent_path(p, write: bool = False) -> Path:
    """Ścieżka dla narzędzi plików agenta. W projekcie (i w kopiach zespołu do czytania) bez pytania; poza
    projektem tylko za zgodą użytkownika (pytanie w terminalu albo karta w oknie), zapamiętaną na sesję
    dla tego folderu. Bez możliwości zapytania (codo -p, praca w tle, mostek) poza projekt nie wychodzi."""
    try:
        return _safe_path(p) if write else _safe_read_path(p)
    except ValueError as err:
        target = _resolve_arg(p)
        for root, w in _OUTSIDE_OK:
            if _is_within(target, root) and (w or not write):
                return target
        if getattr(_ASK_LOCAL, "no_ask", False):
            _ASK_LOCAL.needed = True   # równoległy odczyt: policzy się jeszcze raz po kolei, z pytaniem
            raise ValueError(str(err)) from None
        if not _can_ask_outside():
            raise ValueError(_Lf('{0}. Plik leży poza folderem projektu; bez zgody użytkownika nie '
                                 'wychodzę poza projekt (skopiuj go do projektu albo uruchom codo w jego folderze).', err)) from None
        folder = target if target.is_dir() else target.parent
        q = _L("Zapisać plik poza folderem projektu?") if write else _L("Przeczytać plik spoza folderu projektu?")
        if not confirm_action(q, str(target), ["outside", "write" if write else "read", str(folder)],
                              reason=_L("Agent chce sięgnąć poza folder, w którym pracuje.")):
            raise ValueError(_L("ODRZUCONE przez użytkownika: dostęp poza folder projektu.")) from None
        _OUTSIDE_OK.append((folder, write))
        return target


def _team_read_roots() -> list:
    """Kopie członków zespołu, w którym pracuje ten agent (tylko do czytania): recenzent i prowadzący muszą
    widzieć pracę wykonawcy, zanim nadzorca ją scali (23.11: przegląd stał na „poza katalogiem roboczym”)."""
    d = os.environ.get("CODO_ZESPOL_DIR")
    if not d:
        return []
    try:
        run = TeamStore(d).load_run()
    except Exception:  # noqa: BLE001
        return []
    roots = [run.get("integration_path") or ""] + [m.get("worktree") or m.get("cwd") or "" for m in run.get("members") or []]
    return [Path(r).resolve() for r in roots if r]


def _safe_read_path(p: str) -> Path:
    """Jak _safe_path, ale do czytania wolno też zajrzeć do kopii członków tego samego zespołu."""
    try:
        return _safe_path(p)
    except ValueError:
        cp = _clean_path_arg(p)
        target = Path(cp).resolve() if os.path.isabs(cp) else None
        if target and any(_is_within(target, r) for r in _team_read_roots()):
            return target
        raise


