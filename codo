def _agent_argv(kind: str, path: str, mode: str, auto_yes: bool, sid: str | None, prompt: str) -> tuple:
    """(argv, stdin_text). Uprawnienia: read = tylko odczyt, ask = edycje plików w folderze,
    auto (--yes, tryb auto) = także polecenia bez pytania."""
    if kind == "claude":
        perm = "plan" if mode == "read" else ("bypassPermissions" if auto_yes else "acceptEdits")
        czyta_agent = mode == "read" and bool(os.environ.get("CODO_APP_AGENT"))
        if czyta_agent:
            # Stały agent bez prawa zapisu: tryb planowania blokuje każde narzędzie MCP (także agenci), więc
            # zostaje tryb zwykły, w którym bez okna zgody zmiany plików i polecenia są po prostu odrzucane.
            perm = "default"
        argv = [path, "-p", "--output-format", "stream-json", "--verbose", "--permission-mode", perm]
        if czyta_agent:
            argv += ["--disallowedTools", "Write,Edit,MultiEdit,NotebookEdit"]
        sysp = _agent_system()
        notes = _project_notes()
        if notes and not sid:
            sysp += _L("\n\nPamięć projektu (Codo.md):\n") + notes[:6000]
        argv += ["--append-system-prompt", sysp]
        servers = _agent_mcp_servers()
        if servers:
            argv += ["--mcp-config", json.dumps({"mcpServers": {k: {"command": c[0], "args": c[1:], "env": _agent_mcp_env()}
                                                                for k, c in servers.items()}}),
                     "--allowedTools", ",".join("mcp__" + k for k in servers)]
        if sid:
            argv += ["--resume", sid]
        model = load_settings().get("agent_model_claude")
        if model:
            argv += ["--model", model]
        return argv, prompt
    if kind == "codex":
        sandbox = "read-only" if mode == "read" else "workspace-write"
        # opcje exec MUSZĄ stać przed „resume” (po nim codex odrzuca -s)
        argv = [path, "exec", "--json", "--skip-git-repo-check", "-s", sandbox]
        if auto_yes and mode != "read":
            argv += ["-c", "sandbox_workspace_write.network_access=true"]
        model = load_settings().get("agent_model_codex")
        if model:
            argv += ["-m", model]
        for k, cmd in _agent_mcp_servers().items():
            argv += ["-c", f"mcp_servers.{k}.command=" + json.dumps(cmd[0]),
                     "-c", f"mcp_servers.{k}.args=" + json.dumps(cmd[1:]),
                     "-c", f"mcp_servers.{k}.tool_timeout_sec=600",
                     # bez tego codex exec odrzuca każde narzędzie MCP („requires approval, but approval policy
                     # is never”); zgody na skutki poza Codo i tak pyta karta w oknie
                     "-c", f'mcp_servers.{k}.default_tools_approval_mode="approve"']
            env = _agent_mcp_env()
            if env:
                argv += ["-c", f"mcp_servers.{k}.env=" + "{" + ", ".join(f"{n} = {json.dumps(v)}" for n, v in env.items()) + "}"]
        if sid:
            argv += ["resume", sid]
        argv.append("-")
        return argv, (prompt if sid else _agent_system() + "\n\n" + prompt)
    if kind == "grok":
        # Tryb skryptowy Grok CLI: -p, zdarzenia JSON w liniach, -r wznawia sesję.
        argv = [path, "--no-auto-update", "--output-format", "streaming-json"]
        if auto_yes and mode != "read":
            argv.append("--always-approve")
        model = load_settings().get("agent_model_grok")
        if model:
            argv += ["-m", model]
        if sid:
            argv += ["-r", sid]
        head = "" if sid else _agent_system() + "\n\n"
        if mode == "read":
            head += "READ ONLY: do not change files and do not run commands that change anything.\n\n"
        argv += ["-p", head + prompt]
        return argv, ""
    approval = "plan" if mode == "read" else ("yolo" if auto_yes else "auto_edit")
    argv = [path, "--output-format", "stream-json", "--approval-mode", approval]
    model = load_settings().get("agent_model_gemini")
    if model:
        argv += ["-m", model]
    argv.append("--prompt=" + _agent_system() + "\n\n" + prompt)
    return argv, ""


class _AgentRun:
    """Jedna tura agenta zewnętrznego: zdarzenia JSONL → panel Codo, diff, /undo, rozmowa w aplikacji."""

    def __init__(self, kind: str, quiet: bool = False):
        self.kind = kind
        self.quiet = quiet
        self.sid = None
        self.texts: list = []
        self.errors: list = []
        self.tools = 0
        self.pending: dict = {}   # id → (name, header, snapshot {path: old})
        self.limit = False
        self.auth = False
        self.usage: dict = {}

    # wyświetlanie
    def _say(self, text: str) -> None:
        text = (text or "").strip()
        if not text:
            return
        if not self.texts and not self.tools and len(text) < 500 and _AGENT_AUTH_ONLY_RE.search(text):
            # agent wypisuje sam błąd logowania (po angielsku) jako odpowiedź: człowiek dostaje wskazówkę po polsku
            self.auth = True
            self.errors.append(text)
            text = _agent_auth_hint(self.kind)
        self.texts.append(text)
        if not self.quiet:
            LIVE.status(_AGENTS[self.kind]["label"] + _L(" pisze"))
            _print_assistant(text)

    def _snap(self, paths) -> dict:
        """Treść plików przed zmianą agenta: {ścieżka: (treść, czy kopia zrobiona)}."""
        snap = {}
        for p in paths:
            try:
                path = Path(p) if os.path.isabs(str(p)) else Path.cwd() / str(p)
                path = path.resolve()
                if path.is_file() and path.stat().st_size < 2_000_000:
                    snap[path] = [_read_text_keep(path), True]
                else:
                    snap[path] = ["", False]
            except (OSError, ValueError):
                continue
        return snap

    @staticmethod
    def _reverse(new: str, args: dict) -> str | None:
        """Treść sprzed edycji odtworzona z wejścia narzędzia (old_string → new_string),
        gdy agent zapisał plik, zanim Codo zdążyło zrobić kopię."""
        edits = args.get("edits") if isinstance(args.get("edits"), list) else [args]
        text = new
        for e in reversed(edits):
            if not isinstance(e, dict):
                return None
            old_s, new_s = e.get("old_string"), e.get("new_string")
            if not isinstance(old_s, str) or not isinstance(new_s, str) or (new_s and new_s not in text):
                return None
            text = text.replace(new_s, old_s) if e.get("replace_all") else text.replace(new_s, old_s, 1)
        return text if text != new else None

    def _record_edits(self, snap: dict, args: dict | None = None) -> list:
        entries = []
        for path, (old, backed) in snap.items():
            try:
                new = path.read_text(encoding="utf-8", errors="replace") if path.is_file() else ""
            except OSError:
                continue
            kinds = {str(c.get("path")): c.get("kind") for c in (args or {}).get("changes") or [] if isinstance(c, dict)}
            existed = backed
            if new == old and kinds:
                # Codex melduje zmianę po fakcie: nowy plik = pusty przed, zmieniony = wersja z gita
                kind = next((k for p, k in kinds.items() if Path(p).name == path.name), None)
                if kind == "add":
                    old, existed = "", False
                elif kind in ("update", "modify", "delete"):
                    old = _git_head_text(path)
                    if old is None:
                        continue
                    existed = True
            elif new == old and args:
                rebuilt = self._reverse(new, args)
                if rebuilt is None:
                    continue
                old, existed = rebuilt, True
            if new == old:
                continue
            if existed:
                _backup_text(path, old)   # kopia ze stanu sprzed zmiany agenta: /undo i restore
            a, r = _linedelta(old, new)
            with _EDIT_LOCK:
                _EDIT_SEQ[0] += 1
                entry = {"seq": _EDIT_SEQ[0], "path": path, "added": a, "removed": r,
                         "new_file": not old, "diff": _unified(path, old, new)}
                EDIT_LOG.append(entry)
            entries.append(entry)
        return entries

    def begin(self, tid: str, raw_name: str, args: dict) -> None:
        name = _AGENT_TOOL_MAP.get(str(raw_name or "").lower().replace(" ", ""), "")
        shown = name or "other"
        cargs = dict(args or {})
        for src, dst in (("file_path", "path"), ("absolute_path", "path"), ("notebook_path", "path"),
                         ("pattern", "pattern"), ("url", "url"), ("query", "query")):
            if src in cargs and dst not in cargs:
                cargs[dst] = cargs[src]
        if isinstance(cargs.get("command"), list):
            cargs["command"] = " ".join(str(x) for x in cargs["command"])
        if name:
            header = _tool_header(name, cargs)
        else:
            header = f"{raw_name}"
        paths = []
        if name in ("edit_file", "multi_edit", "write_file") and cargs.get("path"):
            paths = [cargs["path"]]
        for ch in cargs.get("changes") or []:
            if isinstance(ch, dict) and ch.get("path"):
                paths.append(ch["path"])
        self.pending[tid] = (shown, header, self._snap(paths), cargs)
        self.tools += 1
        SESSION["turn_steps"] = SESSION.get("turn_steps", 0) + 1
        if not self.quiet:
            verb = _TOOL_VERBS.get(shown, str(raw_name))
            LIVE.status(verb)
            LIVE.tool_begin(header, _tool_icon(shown), _tool_detail(shown, cargs) if name else "",
                            name=str(raw_name or shown), args=cargs)

    def end(self, tid: str, ok: bool, output: str = "", raw_name: str = "", args: dict | None = None) -> None:
        if tid not in self.pending:
            self.begin(tid, raw_name, args or {})
        name, header, snap, cargs = self.pending.pop(tid)
        entries = self._record_edits(snap, cargs if name in ("edit_file", "multi_edit") or cargs.get("changes")
                                     else None) if snap else []
        if self.quiet:
            return
        lines = [] if entries else _result_lines(name, str(output or ""), False) if output else []
        LIVE.tool_end(ok, header, lines, name=name, collapse=not entries, full=str(output or ""))
        for entry in entries:
            _print_edit(entry)
            if entry["path"] not in SESSION["edited"]:
                SESSION["edited"].append(entry["path"])

    def fail(self, text: str) -> None:
        text = str(text or "").strip()
        if not text:
            return
        self.errors.append(text[:600])
        if _AGENT_LIMIT_RE.search(text):
            self.limit = True
        elif _AGENT_AUTH_RE.search(text):
            self.auth = True

    # zdarzenia poszczególnych narzędzi
    def feed(self, ev: dict) -> None:
        if not isinstance(ev, dict):
            return
        getattr(self, "_ev_" + self.kind)(ev)

    def _ev_claude(self, ev: dict) -> None:
        t = ev.get("type")
        if t == "system" and ev.get("subtype") == "init":
            self.sid = ev.get("session_id") or self.sid
        elif t == "assistant":
            for part in (ev.get("message") or {}).get("content") or []:
                if part.get("type") == "text":
                    self._say(part.get("text"))
                elif part.get("type") == "tool_use":
                    self.begin(part.get("id") or "", part.get("name") or "", part.get("input") or {})
            usage = (ev.get("message") or {}).get("usage") or {}
            if usage.get("output_tokens"):
                LIVE.add_tokens(int(usage["output_tokens"]))
        elif t == "user":
            for part in (ev.get("message") or {}).get("content") or []:
                if isinstance(part, dict) and part.get("type") == "tool_result":
                    out = part.get("content")
                    if isinstance(out, list):
                        out = "\n".join(str(x.get("text") or "") for x in out if isinstance(x, dict))
                    self.end(part.get("tool_use_id") or "", not part.get("is_error"), str(out or ""))
        elif t == "result":
            self.sid = ev.get("session_id") or self.sid
            self.usage = ev.get("usage") or {}
            if ev.get("is_error") or str(ev.get("subtype") or "").startswith("error"):
                errs = ev.get("errors") if isinstance(ev.get("errors"), list) else []
                self.fail(str(ev.get("result") or "; ".join(str(e) for e in errs) or ev.get("subtype") or _L("błąd")))
                if ev.get("subtype") == "error_max_turns":
                    self.errors[-1] = "Agent doszedł do limitu kroków w tej turze."
            elif ev.get("result") and not self.texts:
                self._say(ev.get("result"))

    def _ev_codex(self, ev: dict) -> None:
        t = ev.get("type") or ""
        item = ev.get("item") if isinstance(ev.get("item"), dict) else {}
        it = item.get("type") or item.get("item_type") or ""
        iid = str(item.get("id") or "")
        if t in ("thread.started", "session.created", "session_configured"):
            self.sid = ev.get("thread_id") or ev.get("session_id") or self.sid
        elif t == "item.started" and it in ("command_execution", "file_change", "web_search", "mcp_tool_call"):
            self.begin(iid, it, self._codex_args(item))
        elif t == "item.completed":
            if it in ("agent_message", "assistant_message"):
                self._say(item.get("text") or "")
            elif it in ("command_execution", "file_change", "web_search", "mcp_tool_call"):
                ok = (item.get("status") in (None, "completed", "success")
                      and item.get("exit_code") in (None, 0))
                self.end(iid, ok, str(item.get("aggregated_output") or item.get("output") or ""),
                         it, self._codex_args(item))
            elif it == "error":
                self.fail(item.get("message") or "")
        elif t == "turn.completed":
            self.usage = ev.get("usage") or {}
            if self.usage.get("output_tokens"):
                LIVE.add_tokens(int(self.usage["output_tokens"]))
        elif t in ("turn.failed", "error"):
            err = ev.get("error")
            self.fail((err.get("message") if isinstance(err, dict) else err) or ev.get("message") or _L("błąd"))

    @staticmethod
    def _codex_args(item: dict) -> dict:
        args = {}
        if item.get("command"):
            args["command"] = item["command"]
        changes = item.get("changes") or []
        if changes:
            args["changes"] = changes
            first = changes[0] if isinstance(changes[0], dict) else {}
            if first.get("path"):
                args["path"] = first["path"]
        if item.get("query"):
            args["query"] = item["query"]
        if item.get("tool"):
            args["tool"] = item["tool"]
        return args

    def _ev_gemini(self, ev: dict) -> None:
        t = ev.get("type")
        if t == "init":
            self.sid = ev.get("session_id") or self.sid
        elif t == "message" and ev.get("role") == "assistant":
            if ev.get("delta"):
                self.pending.setdefault("__tekst__", ("", "", {}, {}))
                self._gem = getattr(self, "_gem", "") + str(ev.get("content") or "")
            else:
                self._say(ev.get("content") or "")
        elif t == "tool_use":
            self._flush_gem()
            self.begin(str(ev.get("tool_id") or ""), ev.get("tool_name") or "", ev.get("parameters") or {})
        elif t == "tool_result":
            self.end(str(ev.get("tool_id") or ""), ev.get("status") in (None, "success"),
                     str(ev.get("output") or (ev.get("error") or {}).get("message") or ""))
        elif t == "error":
            self.fail(ev.get("message") or "")
        elif t == "result":
            self._flush_gem()
            if ev.get("status") not in (None, "success"):
                self.fail(str((ev.get("error") or {}).get("message") or ev.get("status")))

    def _ev_grok(self, ev: dict) -> None:
        """Zdarzenia Grok CLI (streaming-json). Czytane tolerancyjnie: tekst, narzędzia, błędy
        i identyfikator sesji rozpoznawane po kilku typowych nazwach pól."""
        t = str(ev.get("type") or ev.get("event") or "").lower()
        data = ev.get("data") if isinstance(ev.get("data"), dict) else ev
        for key in ("session_id", "sessionId", "thread_id"):
            if ev.get(key) or data.get(key):
                self.sid = str(ev.get(key) or data.get(key))
        def text_of(v) -> str:
            if isinstance(v, str):
                return v
            if isinstance(v, list):
                return "".join(text_of(x.get("text") if isinstance(x, dict) else x) for x in v)
            if isinstance(v, dict):
                return text_of(v.get("text") or v.get("content") or "")
            return ""
        tid = str(data.get("tool_call_id") or data.get("tool_id") or data.get("call_id") or data.get("id") or "")
        name = data.get("tool_name") or data.get("tool") or data.get("name") or ""
        if isinstance(name, dict):
            name = name.get("name") or ""
        args = data.get("arguments") or data.get("parameters") or data.get("input") or data.get("args") or {}
        if isinstance(args, str):
            try:
                args = json.loads(args)
            except ValueError:
                args = {"command": args}
        if "error" in t or "fail" in t:
            err = data.get("error") if data.get("error") is not None else data.get("message")
            self.fail(text_of(err.get("message") if isinstance(err, dict) else err) or _L("błąd"))
        elif "tool" in t and any(w in t for w in ("result", "end", "complet", "output", "finish", "response")):
            self._flush_gem()
            out = data.get("output") if data.get("output") is not None else data.get("result")
            bad = data.get("is_error") or data.get("status") in ("error", "failed") or data.get("success") is False
            self.end(tid, not bad, text_of(out) if not isinstance(out, str) else out, str(name),
                     args if isinstance(args, dict) else {})
        elif "tool" in t:
            self._flush_gem()
            self.begin(tid, str(name), args if isinstance(args, dict) else {})
        elif any(w in t for w in ("delta", "chunk")):
            if "think" in t or "reason" in t:
                return
            self.pending.setdefault("__tekst__", ("", "", {}, {}))
            self._gem = getattr(self, "_gem", "") + text_of(data.get("delta") or data.get("text") or data.get("content"))
        elif t in ("message", "assistant", "assistant_message", "agent_message", "text", "response"):
            if str(data.get("role") or "assistant") in ("assistant", "agent", "model"):
                self._flush_gem()
                self._say(text_of(data.get("content") or data.get("text") or data.get("message")))
        elif any(w in t for w in ("result", "done", "complete", "final", "end")) or (not t and len(ev) > 0):
            self._flush_gem()
            self.usage = data.get("usage") if isinstance(data.get("usage"), dict) else self.usage
            final = text_of(data.get("result") or data.get("response") or data.get("output") or data.get("text")
                            or data.get("content"))
            if final and not self.texts:
                self._say(final)

    def _flush_gem(self) -> None:
        self.pending.pop("__tekst__", None)
        text, self._gem = getattr(self, "_gem", ""), ""
        self._say(text)


def run_external_agent(kind: str, prompt: str, mode: str, auto_yes: bool, sid: str | None = None,
                       quiet: bool = False, timeout: float | None = None) -> _AgentRun:
    """Uruchamia agenta, czyta JSONL na żywo; Esc/Ctrl+C zabija całe drzewo procesów."""
    import tempfile
    import time as _t
    if _agent_acp(kind):
        return run_acp_agent(kind, prompt, mode, auto_yes, sid=sid, quiet=quiet, timeout=timeout)
    path = _agent_bin(kind)
    run = _AgentRun(kind, quiet)
    if not path:
        run.errors.append(_Lf('Nie znaleziono {0}. Instalacja: {1}', _AGENTS[kind]['label'], _AGENTS[kind]['install']))
        return run
    argv, stdin_text = _agent_argv(kind, path, mode, auto_yes, sid, prompt)
    env = dict(os.environ)
    env.pop("CLAUDECODE", None)   # zagnieżdżone uruchomienie z wnętrza innej sesji
    env.setdefault("NO_COLOR", "1")
    err_file = tempfile.TemporaryFile()
    kwargs = {"start_new_session": True} if not IS_WIN else {
        "creationflags": getattr(subprocess, "CREATE_NEW_PROCESS_GROUP", 0)}
    try:
        proc = subprocess.Popen(argv, stdin=subprocess.PIPE, stdout=subprocess.PIPE, stderr=err_file,
                                cwd=str(Path.cwd()), env=env, **kwargs)
    except OSError as e:
        run.errors.append(_Lf('Nie uruchomiono {0}: {1}', _AGENTS[kind]['label'], e))
        return run
    started = _t.monotonic()
    plain: list = []
    try:
        try:
            if stdin_text:
                proc.stdin.write(stdin_text.encode("utf-8"))
            proc.stdin.close()
        except OSError:
            pass
        for raw in iter(proc.stdout.readline, b""):
            line = raw.decode("utf-8", errors="replace").strip()
            if not line.startswith("{"):
                if kind == "grok" and line:
                    plain.append(line)   # wersja bez zdarzeń JSON: zwykły tekst odpowiedzi
                continue
            try:
                run.feed(json.loads(line))
            except ValueError:
                continue
            if timeout and _t.monotonic() - started > timeout:
                run.errors.append(f"Przekroczono czas {int(timeout)} s.")
                _kill_tree(proc)
                break
        proc.wait(timeout=30)
    except KeyboardInterrupt:
        _kill_tree(proc)
        raise
    finally:
        if proc.poll() is None:
            _kill_tree(proc)
        try:
            err_file.seek(0)
            err = err_file.read()[-4000:].decode("utf-8", errors="replace")
        except OSError:
            err = ""
        err_file.close()
    if proc.returncode not in (0, None) and not run.errors:
        tail = "\n".join(x for x in err.strip().splitlines()[-6:] if x.strip())
        run.fail(tail or _Lf('{0} zakończył się kodem {1}.', _AGENTS[kind]['label'], proc.returncode))
    elif err and proc.returncode not in (0, None) and (_AGENT_LIMIT_RE.search(err) and not run.texts):
        # Limit tylko po nieudanym końcu: ostrzeżenia o ponowieniu (rate limit, billing) w logu udanej tury
        # nie mogą przełączać agenta na godzinę na model Codo.
        run.fail(err.strip().splitlines()[-1])
    if kind == "grok":
        run._flush_gem()
        if not run.texts and plain and not run.errors:
            run._say("\n".join(plain))
    for tid in [k for k in run.pending if k != "__tekst__"]:
        run.end(tid, False, "przerwane")
    return run


def external_turn(creds, messages: list, model: str, auto_yes: bool, mode: str) -> bool:
    """Tura na agencie zewnętrznym; przy limicie planu dokończenie na modelu Codo (kredyty 𝔻)."""
    kind = agent_kind(model)
    label = _AGENTS[kind]["label"]
    SESSION["turn_lustro"] = True
    if _agent_limited(kind):
        return _agent_fallback(creds, messages, kind, auto_yes, mode, quiet_note=True)
    sids = SESSION.setdefault("agent_sid", {})
    sid = sids.get(kind) if (kind != "gemini" or _agent_acp(kind)) else None
    prompt = _agent_prompt(kind, messages, fresh=not sid)
    if not prompt:
        return False
    LIVE.status(_Lf('{0} pracuje', label), _L("na Twoim planie, bez kredytów Codo"))
    run = run_external_agent(kind, prompt, mode, auto_yes, sid=sid)
    if sid and not run.texts and not run.tools and any(
            re.search(r"no (conversation|session|rollout)|not found", e, re.I) for e in run.errors):
        # sesja agenta zniknęła (wyczyszczona, inny komputer): nowa, z kontekstem tej rozmowy
        sids.pop(kind, None)
        run = run_external_agent(kind, _agent_prompt(kind, messages, fresh=True), mode, auto_yes)
    if run.sid:
        sids[kind] = run.sid
    if run.texts:
        messages.append({"role": "assistant", "content": "\n\n".join(run.texts)})
    if run.sid or run.texts:
        brain_mark(model, messages)
    if run.limit:
        import time as _t
        SESSION.setdefault("agent_limit", {})[kind] = _t.time() + _AGENT_FALLBACK_MIN * 60
        print(yellow(_Lf('\n⏸ {0}: {1} doszedł do limitu.', label, _AGENTS[kind]['plan'])) + dim(f" ({run.errors[-1][:160]})"))
        return _agent_fallback(creds, messages, kind, auto_yes, mode)
    if run.errors and not run.texts:
        msg = run.errors[-1]
        print(red("✗ ") + f"{label}: {msg[:400]}")
        if run.auth:
            print(dim("  " + _agent_auth_hint(kind)))
        # okno i gospodarz nie widzą printów: to samo idzie jako zdarzenie błędu (po polsku, z tym, co zrobić)
        SESSION["agent_error"] = _agent_auth_hint(kind) if run.auth else f"{label}: {msg[:400]}"
        SESSION["turn_error"] = "agent"
        return False
    if run.errors:
        print(yellow("  ⚠ ") + dim(run.errors[-1][:300]))
    return not run.errors


def _agent_fallback(creds, messages, kind, auto_yes, mode, quiet_note=False) -> bool:
    label = _AGENTS[kind]["label"]
    target = _agent_fallback_target()
    if not target or load_settings().get("agent_fallback") is False:
        if not target:
            print(dim(_L("  Żeby w takiej chwili Codo dokończyło pracę na swoich modelach, zaloguj się: "))
                  + bold(_L("codo login")) + dim(_L(" (konto DomaAI, kredyty 𝔻).")))
        else:
            print(dim(_L("  Przechodzenie na model Codo jest wyłączone (/agenci zapas wł).")))
        SESSION["turn_error"] = "agent_limit"
        return False
    prov, fmodel = target
    if quiet_note:
        print(dim(_Lf('  {0} czeka na odnowienie limitu, pracuje model Codo (kredyty). /agenci pokazuje stan.', label)))
    else:
        where = {"domaai": "kredyty 𝔻", "maddlabs": "saldo MaddLabs", "endpoint": _L("Twój endpoint")}[prov]
        print(dim(_Lf('  Kończę zadanie na modelu Codo ({0}, {1}). Wrócę do {2} za {3} min albo po /model.', fmodel or 'domyślny', where, label, _AGENT_FALLBACK_MIN)))
    SYNC.add("info", {"tekst": _Lf('{0} w limicie, dalej pracuje model Codo', label)})
    # Okno Codo: widać, że odpowiada inny model i dlaczego (stopka tury nazwie ten model).
    _app_emit("fallback", agent=kind, label=label, model=fmodel or "",
              tekst=_Lf('{0} czeka na odnowienie limitu swojego planu. Odpowiada model Codo (kredyty 𝔻).', label))
    prev = SESSION.get("force_provider")
    SESSION["force_provider"] = prov
    try:
        if creds is None and prov == "domaai":
            creds = load_creds()
        return _agent_turn(creds, messages, fmodel, auto_yes, mode=mode)
    finally:
        if prev is None:
            SESSION.pop("force_provider", None)
        else:
            SESSION["force_provider"] = prev


# narzędzie dla modelu Codo: zlecenie albo sprawdzenie pracy przez innego agenta
def t_delegate(args: dict, auto_yes: bool) -> str:
    kind = str(args.get("agent") or "").lower().strip()
    found = dict(agents_available())
    if kind not in found:
        have = ", ".join(found) or "żadnego"
        return f"BŁĄD: agent „{kind}” nie jest zainstalowany na tym komputerze (dostępni: {have})."
    task = str(args.get("task") or "").strip()
    if not task:
        return "BŁĄD: podaj task (pełny opis zadania z kontekstem, agent nie widzi tej rozmowy)."
    mode = "read" if str(args.get("mode") or "") in ("review", "read") else ("auto" if auto_yes else "ask")
    if mode != "read" and not auto_yes:
        if not confirm_action(_Lf('Zlecić zadanie agentowi {0}?', _AGENTS[kind]['label']), task[:300],
                              reason=_L("agent może zmieniać pliki w tym folderze")):
            return "ODRZUCONE przez użytkownika."
    if _agent_limited(kind):
        return f"BŁĄD: {_AGENTS[kind]['label']} jest teraz w limicie planu. Zrób to sam albo wybierz innego agenta."
    run = run_external_agent(kind, task, mode, auto_yes, quiet=True, timeout=1800)
    if run.limit:
        import time as _t
        SESSION.setdefault("agent_limit", {})[kind] = _t.time() + _AGENT_FALLBACK_MIN * 60
        return f"BŁĄD: {_AGENTS[kind]['label']} doszedł do limitu planu. Dokończ zadanie sam."
    if run.errors and not run.texts:
        return f"BŁĄD: {_AGENTS[kind]['label']}: {run.errors[-1]}"
    text = "\n\n".join(run.texts)[-12000:] or "(agent nie napisał podsumowania)"
    return f"{_AGENTS[kind]['label']} ({run.tools} kroków):\n{text}"


