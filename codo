def compact_app(creds: dict, messages: list, model: str | None, hint: str = "") -> dict:
    """Porządkowanie z okna: streszczenie z postępem na żywo (zdarzenia compact) i wynikiem zamiast cichego końca.

    Mózg zewnętrzny (Codex, Claude Code…) streszcza sam, na planie użytkownika, w trybie tylko do odczytu,
    a jego sesja zaczyna się od nowa ze streszczeniem. Pozostałe mózgi: jeden krok modelu Codo.
    """
    import math
    import threading
    import time as _t
    body = [m for m in messages if m.get("role") in ("user", "assistant") and str(m.get("content") or "").strip()]
    before = int(_context_usage(messages, False).get("uzyte") or 0)
    if len(body) < 4:
        return {"ok": False, "powod": "Rozmowa jest jeszcze krótka: nie ma czego streszczać. Kontekst ma dużo miejsca."}
    kind = agent_kind(model)
    who = _AGENTS[kind]["label"] if kind else "Codo"
    lines = [("UŻYTKOWNIK: " if m["role"] == "user" else "AGENT: ") + str(m.get("content") or "")[:6000] for m in body]
    transcript = "\n\n".join(lines)[-150_000:]
    prompt = _COMPACT_PROMPT + (f"\nSzczególnie zachowaj: {hint}" if hint else "") + "\n\nROZMOWA:\n" + transcript
    _app_emit("compact", etap=f"Zbieram rozmowę ({len(body)} wiadomości)", postep=0.06, sekundy=0)
    start = _t.time()
    stop = threading.Event()

    def tick() -> None:
        # postęp płynie z czasem (krzywa nasycenia), a etap mówi, co się dzieje
        while not stop.wait(0.6):
            el = _t.time() - start
            _app_emit("compact", etap=f"{who} streszcza rozmowę", postep=round(0.1 + 0.8 * (1 - math.exp(-el / 18)), 3),
                      sekundy=int(el))

    ticker = threading.Thread(target=tick, daemon=True)
    ticker.start()
    summary, spent, err = "", 0, ""
    try:
        if kind:
            run = run_external_agent(kind, "Nie używaj narzędzi i nie zmieniaj plików. " + prompt, "read", False,
                                     quiet=True, timeout=240)
            summary = "\n\n".join(run.texts).strip()
            if not summary:
                err = (_agent_auth_hint(kind) if run.auth else (run.errors[-1][:300] if run.errors else
                       f"{who} nie zwrócił streszczenia."))
        else:
            req = {"messages": [{"role": "system", "content": "Streszczasz rozmowę z agentem programistycznym."},
                                {"role": "user", "content": prompt}], "tools": []}
            if model and model not in ("lopus", "lopus-pro"):
                req["model"] = model
            resp = api_step(creds, req)
            summary = str((resp.get("message") or {}).get("content") or "").strip()
            spent = int(resp.get("credits_spent") or 0)
            if not summary:
                err = "Model nie zwrócił streszczenia."
    except (ApiError, urllib.error.URLError, TimeoutError, OSError) as e:
        err = describe_error(e)
    finally:
        stop.set()
        ticker.join(1)
    if err or not summary:
        return {"ok": False, "powod": err or "Nie udało się streścić rozmowy.", "sekundy": int(_t.time() - start)}
    _app_emit("compact", etap="Zapisuję streszczenie", postep=0.96, sekundy=int(_t.time() - start))
    SESSION["spent"] += spent
    messages[:] = [system_message(SYSTEM_PROMPT),
                   {"role": "user", "content": _SUMMARY_HEAD + summary},
                   {"role": "assistant", "content": "Rozumiem, kontynuuję od tego miejsca."}]
    if kind:
        SESSION.get("agent_sid", {}).pop(kind, None)   # nowa sesja agenta zacznie od streszczenia
    if model in ("lopus", "lopus-pro") or maddlabs_with_domaai_tools(model):
        SESSION.pop("lopus_chat_id", None)
        SYNC.set_chat(_chat_id())
        SESSION.setdefault("pending_context", []).append("<streszczenie>\n" + summary + "\n</streszczenie>")
    after = int(_context_usage(messages, False).get("uzyte") or 0)
    return {"ok": True, "wiadomosci": len(body), "przed": before, "po": after, "kr": spent,
            "sekundy": int(_t.time() - start)}


