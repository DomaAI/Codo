def maszyna_pobierz() -> list:
    """Zmiany z maszyny → folder: nowe i różne pliki, każdy nadpisany z kopią; plików lokalnych
    spoza archiwum nie usuwa. Zwraca [(ścieżka, nowy, +linie, -linie)]."""
    import io
    import zipfile
    from urllib.parse import quote
    data = _maszyna_req("GET", f"/cli/maszyna/pobierz?chat_id={quote(_chat_id())}", timeout=600)
    root = Path.cwd().resolve()
    changed = []
    with zipfile.ZipFile(io.BytesIO(data)) as zf:
        for info in zf.infolist():
            if info.is_dir():
                continue
            rel = info.filename.replace("\\", "/")
            parts = Path(rel).parts
            if rel.startswith("/") or ".." in parts or not parts or parts[0] in _SKIP_DIRS:
                continue
            dest = (root / rel).resolve()
            if root not in dest.parents:
                continue
            new = zf.read(info)
            old = dest.read_bytes() if dest.is_file() else None
            if old == new:
                continue
            old_text = new_text = None
            try:
                old_text = old.decode("utf-8") if old is not None else ""
                new_text = new.decode("utf-8")
            except UnicodeDecodeError:
                pass
            if old is not None:
                _backup(dest)
            dest.parent.mkdir(parents=True, exist_ok=True)
            dest.write_bytes(new)
            a, r = _linedelta(old_text, new_text) if new_text is not None else (0, 0)
            with _EDIT_LOCK:
                _EDIT_SEQ[0] += 1
                entry = {"seq": _EDIT_SEQ[0], "path": dest, "added": a, "removed": r, "new_file": old is None,
                         "diff": _unified(dest, old_text or "", new_text) if new_text is not None else ""}
                EDIT_LOG.append(entry)
            _print_edit(entry)
            if dest not in SESSION["edited"]:
                SESSION["edited"].append(dest)
            changed.append((rel, old is None, a, r))
    return changed



