    print()
    messages = [system_message(WORK_SYSTEM_PROMPT), {"role": "user", "content": seed}]
    try:
        completed = agent_turn(creds, messages, model, auto_yes, tools=WORK_TOOLS,
                   max_steps=WORK_MAX_STEPS,
                   show_results=("plan_write", "plan_update", "plan_status", "check"), mode=mode)
