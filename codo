def print_mode(creds: dict, task: str, model: str | None, auto_yes: bool, as_json: bool) -> int:
    """codo -p "zadanie": bez interfejsu, do skryptów i potoków. Na stdout tylko
    ostatnia odpowiedź agenta (albo JSON), wszystko inne na stderr. Bez --yes
    akcje wymagające zgody są odrzucane, a nie zadawane jako pytanie."""
    piped = ""
    if sys.stdin and not sys.stdin.isatty():
        try:
            piped = sys.stdin.read(400_001)
        except (OSError, ValueError):
            piped = ""
    if len(piped) > 400_000:
        piped = piped[:400_000] + _L("\n… (ucięte)")
    if not task.strip() and not piped.strip():
        print(red(_L('✗ Podaj zadanie: codo -p "opisz ten projekt"')) + dim(_L("  (albo przez potok: cat log | codo -p \"wyjaśnij\")")),
              file=sys.stderr)
        return 2
    content, _ = _expand_mentions(task)
    if piped.strip():
        content = (content + "\n\n" if content.strip() else "") + _L("Dane z wejścia (stdin):\n<stdin>\n") + piped + "\n</stdin>"
    messages = [system_message(SYSTEM_PROMPT), {"role": "user", "content": content}]
    out = sys.stdout
    SESSION["noninteractive"] = True
    sys.stdout = sys.stderr
    ok = False
    try:
        ok = bool(agent_turn(creds, messages, model, auto_yes, mode="auto" if auto_yes else "ask"))
    except KeyboardInterrupt:
        ok = False
    finally:
        sys.stdout = out
        SESSION.pop("noninteractive", None)
    answer = next((str(m.get("content") or "") for m in reversed(messages) if m.get("role") == "assistant"
                   and str(m.get("content") or "").strip()), "")
    if as_json:
        print(json.dumps({"ok": ok, "result": answer, "model": SESSION.get("model") or model or "",
                          "credits": SESSION.get("spent", 0), "steps": SESSION.get("steps", 0),
                          "files_changed": [str(p) for p in SESSION.get("edited", [])]}, ensure_ascii=False))
    elif answer:
        print(answer.strip())
    return 0 if ok else 1


# ── Aplikacja okienkowa (Codo na Maca): protokół JSON w liniach na stdin/stdout ──
# codo app-server: każde zdarzenie sesji (to samo, co widzi telefon przy /rc) idzie jako jedna linia
# JSON na stdout; aplikacja wysyła polecenia liniami JSON na stdin. Teksty dla człowieka idą na stderr.
_APP: dict = {"out": None, "lock": threading.Lock(), "asks": {}, "calls": {}, "n": 0}


def _app_emit(kind: str, /, **data) -> None:
    out = _APP["out"]
    if out is None:
        return
    try:
        line = json.dumps({"type": kind, **data}, ensure_ascii=False, default=str)
        with _APP["lock"]:
            out.write(line + "\n")
            out.flush()
    except (OSError, ValueError, TypeError):
        pass  # nosec B110 — zamknięta aplikacja nie może przerwać pracy agenta


_LOG_CAP = 8000


def _log_clip(text: str, cap: int = _LOG_CAP) -> str:
    """Dla dziennika agenta (Log-Bot): bez sekretów i najwyżej ~8 KB, z informacją o przycięciu."""
    t = _mask_secrets(str(text or ""))
    if len(t) > cap:
        t = t[:cap] + f"\n[przycięte: {len(t) - cap} znaków więcej]"
    return t


def _mask_secrets(text: str) -> str:
    t = str(text or "")
    for r in _SECRET_RES:
        t = r.sub(lambda m: m.group(0)[:4] + "••••", t)
    return t


def _app_ask(question: str, detail: str, reason: str, remember: bool) -> int:
    """Zgoda jako karta w aplikacji; 0 nie, 1 tak, 2 tak i zapamiętaj."""
    with _APP["lock"]:
        _APP["n"] += 1
        ask_id = str(_APP["n"])
        ev = threading.Event()
        _APP["asks"][ask_id] = {"event": ev, "value": 0}
    options = [{"value": 1, "label": _L("Tak, jednorazowo")}]
    if remember:
        options.append({"value": 2, "label": _L("Tak, i nie pytaj więcej o to w tym folderze")})
    options.append({"value": 0, "label": _L("Nie")})
    _app_emit("ask", id=ask_id, pytanie=_plain(question), szczegol=_plain(detail)[:4000],
              powod=_plain(reason), opcje=options)
    if SYNC.enabled:
        SYNC.set_state("ask", _plain(question), {"pytanie": _plain(question), "szczegol": _plain(detail)[:4000],
                                                 "powod": _plain(reason),
                                                 "opcje": [{"wartosc": o["value"], "etykieta": o["label"]} for o in options]})
    try:
        while not ev.wait(0.2):
            if _APP["out"] is None:
                return 0
        a = _APP["asks"][ask_id]
        if a.get("zdalnie"):
            _app_emit("ask_done", id=ask_id, value=int(a["value"] or 0), zdalnie=True)
        return int(a["value"] or 0)
    finally:
        _APP["asks"].pop(ask_id, None)
        if SYNC.enabled:
            SYNC.set_state("busy", "")


def _app_interrupt() -> None:
    import time as _t
    SESSION["app_interrupt_at"] = _t.monotonic()   # Stop przed startem tury dotyczy tury, która już czeka
    _APP["cancel"] = True          # czekanie na okno (np. rój w kroku workflowu) też się kończy
    for a in list(_APP["asks"].values()):
        a["value"] = 0
        a["event"].set()
    if SESSION.get("app_busy"):
        SESSION["app_stop"] = True   # Stop kończy też przejście na zapasowy mózg
        _interrupt_main()


def _app_remote(kind, tresc: dict) -> None:
    """Telefon jako pilot okna Codo (20.11.2026): wiadomość idzie do kolejki okna jako tura,
    Stop przerywa, a odpowiedź na zgodę trafia do najnowszej otwartej karty zgody."""
    if kind == "message":
        text = str(tresc.get("tekst") or "").strip()
        if text:
            _app_emit("remote", tekst=text)
            _APP["inbox"].append({"type": "send", "text": text, "remote": True})
            _APP["wake"].set()
    elif kind == "interrupt":
        _app_emit("remote_stop")
        _app_interrupt()
    elif kind == "answer":
        asks = list(_APP["asks"].values())
        if asks:
            v = int(tresc.get("wybor") or 0)
            # „zawsze” z telefonu działa jak jednorazowe „tak” (trwałe zgody tylko z tego komputera)
            asks[-1]["value"] = 1 if v == 2 else (v if v in (0, 1) else 0)
            asks[-1]["zdalnie"] = True
            asks[-1]["event"].set()


def _app_reader(inbox: list, wake: threading.Event) -> None:
    for raw in sys.stdin:
        try:
            msg = json.loads(raw)
        except ValueError:
            continue
        if not isinstance(msg, dict):
            continue
        kind = msg.get("type")
        if kind == "answer":
            a = _APP["asks"].get(str(msg.get("id")))
            if a:
                a["value"] = int(msg.get("value") or 0)
                a["event"].set()
        elif kind == "bridge_reply":
            c = _APP["calls"].get(str(msg.get("id")))
            if c:
                c["value"] = msg.get("result")
                c["event"].set()
        elif kind == "interrupt":
            _app_interrupt()
        elif kind == "account":
            # Konto DomaAI z okna: od razu, w osobnym wątku (sieć), także w trakcie tury.
            threading.Thread(target=_app_account, args=(msg,), daemon=True).start()
        elif str(kind or "").startswith("team_"):
            # Zespół agentów: polecenia od razu, także w trakcie tury głównej rozmowy.
            threading.Thread(target=_team_app, args=(msg,), daemon=True).start()
        elif str(kind or "").startswith("group_"):
            # Grupy agentów: każdy bieg w swoim wątku, członkowie we własnych procesach.
            threading.Thread(target=_group_app, args=(msg,), daemon=True).start()
        else:
            if kind == "send":
                import time as _t
                msg["_t"] = _t.monotonic()
            inbox.append(msg)
            wake.set()
    # aplikacja się zamknęła: otwarte zgody to odmowa, a przerwana tura nie może wisieć
    _APP["out"] = None
    for a in list(_APP["asks"].values()):
        a["value"] = 0
        a["event"].set()
    for c in list(_APP["calls"].values()):
        c["event"].set()
    if SESSION.get("app_busy"):
        _interrupt_main()
    inbox.append({"type": "quit"})
    wake.set()


def _app_history(messages: list) -> list:
    out = []
    for m in messages:
        role, text = m.get("role"), m.get("content")
        if role in ("user", "assistant") and isinstance(text, str) and text.strip() \
                and not text.startswith(_SUMMARY_HEAD):
            out.append({"role": role, "tekst": text[:20000]})
    return out[-200:]


