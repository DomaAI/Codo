def cmd_rc(arg: str = "") -> None:
    """Zdalne sterowanie z telefonu: /rc włącza, /rc off wyłącza."""
    want = not (arg.lower() in ("off", "wyłącz", "wylacz", "stop", "0") or (SYNC.rc and not arg))
    if want and not app_linked():
        with LIVE.paused():
            if not link_domaai_app():
                return
    if want and not SYNC.enabled and SYNC.why is None and app_linked():
        SYNC.relink(load_creds(), SESSION.get("model") or current_model(None), _INPUT_MODE)
    try:
        url = SYNC.set_rc(want)
    except (ApiError, urllib.error.URLError, OSError) as exc:
