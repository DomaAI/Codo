def _git(*args, timeout: int = 60) -> tuple:
    try:
        p = subprocess.run(["git", "-C", str(Path.cwd()), *args], capture_output=True, text=True, encoding="utf-8", errors="replace", timeout=timeout)
        return p.returncode, (p.stdout or "").strip(), (p.stderr or "").strip()
    except (OSError, subprocess.SubprocessError) as exc:
        return 1, "", str(exc)


def _gh_bin() -> str | None:
    import shutil
    for c in (shutil.which("gh"), "/opt/homebrew/bin/gh", "/usr/local/bin/gh"):
        if c and Path(c).exists():
            return c
    return None


def _slug(text: str) -> str:
    import re
    import unicodedata
    t = unicodedata.normalize("NFKD", text.replace("ł", "l").replace("Ł", "L")).encode("ascii", "ignore").decode().lower()
    t = re.sub(r"[^a-z0-9]+", "-", t).strip("-")
    return (t[:40].rstrip("-") or "zmiany")


def pr_status() -> dict:
    code, inside, _ = _git("rev-parse", "--is-inside-work-tree")
    if code or inside != "true":
        return {"git": False}
    _, branch, _ = _git("rev-parse", "--abbrev-ref", "HEAD")
    _, porcelain, _ = _git("status", "--porcelain")
    files = [ln[3:] for ln in porcelain.splitlines() if ln.strip()][:200]
    _, remote, _ = _git("remote", "get-url", "origin")
    default = ""
    c, ref, _ = _git("symbolic-ref", "--short", "refs/remotes/origin/HEAD")
    if not c and "/" in ref:
        default = ref.split("/", 1)[1]
    default = default or ("main" if not _git("rev-parse", "--verify", "main")[0] else "master")
    ahead = 0
    c, out, _ = _git("rev-list", "--count", f"origin/{default}..HEAD")
    if not c and out.isdigit():
        ahead = int(out)
    gh = _gh_bin()
    authed = False
    if gh:
        try:
            authed = subprocess.run([gh, "auth", "status"], capture_output=True, timeout=20).returncode == 0
        except (OSError, subprocess.SubprocessError):
            authed = False
    pr_url = ""
    if gh and authed and branch not in (default, "HEAD"):
        try:
            p = subprocess.run([gh, "pr", "view", "--json", "url", "-q", ".url"], capture_output=True, text=True, encoding="utf-8", errors="replace",
                               timeout=30, cwd=str(Path.cwd()))
            pr_url = (p.stdout or "").strip() if p.returncode == 0 else ""
        except (OSError, subprocess.SubprocessError):
            pr_url = ""
    return {"git": True, "branch": branch, "default": default, "files": files, "remote": remote,
            "github": "github.com" in remote, "gh": bool(gh), "authed": authed, "ahead": ahead, "pr_url": pr_url}


def pr_create(title: str, body: str, draft: bool = False, branch: str = "", base: str = "", repo=None) -> dict:
    if branch:
        return _pr_create_branch(title, body, draft, branch, base, str(repo or Path.cwd()))
    st = pr_status()
    if not st.get("git"):
        raise ValueError(_L("Ten folder nie jest repozytorium git."))
    if not st.get("github"):
        raise ValueError(_L("Repozytorium nie ma zdalnego origin na GitHubie."))
    if not (st.get("gh") and st.get("authed")):
        raise ValueError(_L("Zaloguj się do GitHuba: w Terminalu wpisz gh auth login."))
    title = (title or "").strip()[:200] or _L("Zmiany z Codo")
    branch = st["branch"]
    if branch in (st["default"], "HEAD"):
        branch = "codo/" + _slug(title)
        base_branch, n = branch, 2
        while not _git("rev-parse", "--verify", branch)[0]:
            branch = f"{base_branch}-{n}"
            n += 1
        code, _, err = _git("checkout", "-b", branch)
        if code:
            raise ValueError(err or _L("Nie udało się utworzyć gałęzi."))
    if st.get("files"):
        _git("add", "-A")
        code, _, err = _git("commit", "-m", title + "\n\n" + _L("Przygotowane w Codo."))
        if code and "nothing to commit" not in err + _git("status")[1]:
            raise ValueError(err[-300:] or _L("Nie udało się zapisać commita."))
    code, _, err = _git("push", "-u", "origin", branch, timeout=180)
    if code:
        raise ValueError(err[-400:] or _L("Nie udało się wypchnąć gałęzi."))
    if st.get("pr_url"):
        return {"url": st["pr_url"], "branch": branch, "existing": True}
    cmd = [_gh_bin(), "pr", "create", "--title", title, "--body", body or _L("Zmiany przygotowane w Codo."),
           "--base", st["default"], "--head", branch]
    if draft:
        cmd.append("--draft")
    p = subprocess.run(cmd, capture_output=True, text=True, encoding="utf-8", errors="replace", timeout=120, cwd=str(Path.cwd()))
    if p.returncode:
        raise ValueError((p.stderr or p.stdout or "").strip()[-400:] or _L("GitHub odrzucił PR."))
    url = next((ln for ln in (p.stdout or "").splitlines() if ln.startswith("https://")), "")
    return {"url": url, "branch": branch, "existing": False}


def _pr_create_branch(title: str, body: str, draft: bool, branch: str, base: str, repo: str) -> dict:
    """PR z jawnej gałęzi (np. integracja zespołu) bez przełączania gałęzi w projekcie."""
    code, remote, _ = _git_in(repo, "remote", "get-url", "origin")
    if code or not remote:
        raise ValueError(_L("Repozytorium nie ma zdalnego origin, więc nie ma gdzie utworzyć PR. Dodaj je "
                            "(git remote add origin …) albo zostaw pracę na gałęzi."))
    gh = _gh_bin()
    if not gh:
        raise ValueError(_L("Do PR potrzebny jest program gh (GitHub CLI). Zainstaluj go i zaloguj się: gh auth login."))
    try:
        authed = subprocess.run([gh, "auth", "status"], capture_output=True, timeout=20, cwd=repo,
                                stdin=subprocess.DEVNULL).returncode == 0
    except (OSError, subprocess.SubprocessError):
        authed = False
    if not authed:
        raise ValueError(_L("Zaloguj się do GitHuba: w Terminalu wpisz gh auth login."))
    code, _, err = _git_in(repo, "push", "-u", "origin", branch, timeout=180)
    if code:
        raise ValueError(err[-400:] or _L("Nie udało się wypchnąć gałęzi."))
    if not base:
        c, ref, _ = _git_in(repo, "symbolic-ref", "--short", "refs/remotes/origin/HEAD")
        base = ref.split("/", 1)[1] if not c and "/" in ref else "main"
    title = (title or "").strip()[:200] or _L("Zmiany z Codo")
    cmd = [gh, "pr", "create", "--title", title, "--body", body or _L("Zmiany przygotowane w Codo."),
           "--base", base, "--head", branch] + (["--draft"] if draft else [])
    p = subprocess.run(cmd, capture_output=True, text=True, encoding="utf-8", errors="replace", timeout=120, cwd=repo, stdin=subprocess.DEVNULL)
    out = (p.stdout or "") + (p.stderr or "")
    url = next((w for w in out.split() if w.startswith("https://")), "")
    if p.returncode and not ("already exists" in out and url):
        raise ValueError(out.strip()[-400:] or _L("GitHub odrzucił PR."))
    return {"url": url, "branch": branch, "existing": bool(p.returncode)}


# Pilnowanie PR po otwarciu (jak PRWatch.swift na Macu): testy (checki), czy da się scalić, logi nieudanych
# testów dla agenta, scalenie (automatyczne na GitHubie, gdy repozytorium pozwala). Wszystko przez `gh` w projekcie.
_PR_FAILED = ("FAILURE", "ERROR", "TIMED_OUT", "CANCELLED", "ACTION_REQUIRED", "STARTUP_FAILURE")


def _pr_gh(args: list, timeout: int = 60) -> tuple:
    gh = _gh_bin()
    if not gh:
        return 127, _L("Do PR potrzebny jest program gh (GitHub CLI). Zainstaluj go i zaloguj się: gh auth login.")
    try:
        p = subprocess.run([gh, *args], capture_output=True, text=True, timeout=timeout, cwd=str(Path.cwd()),  # nosec B603
                           stdin=subprocess.DEVNULL, encoding="utf-8", errors="replace")
        return p.returncode, ((p.stdout or "") + (p.stderr or "")).strip()
    except (OSError, subprocess.SubprocessError) as exc:
        return 1, str(exc)


def _pr_check(c: dict) -> dict:
    """Jeden check z statusCheckRollup: nazwa, stan (passed, failed, running, skipped), link."""
    name = str(c.get("name") or c.get("context") or "check")
    status = str(c.get("status") or "").upper()
    concl = str(c.get("conclusion") or c.get("state") or "").upper()
    if status in ("IN_PROGRESS", "QUEUED", "PENDING", "WAITING", "REQUESTED") or concl in ("PENDING", "EXPECTED"):
        state = "running"
    elif concl in _PR_FAILED:
        state = "failed"
    elif concl in ("SKIPPED", "NEUTRAL"):
        state = "skipped"
    else:
        state = "passed"
    return {"name": name, "state": state, "link": str(c.get("detailsUrl") or c.get("targetUrl") or "")}


def pr_watch() -> dict:
    """Stan otwartego PR bieżącej gałęzi; number 0: nie ma PR (albo gh nie odpowiada)."""
    code, out = _pr_gh(["pr", "view", "--json", "number,url,state,mergeable,reviewDecision,headRefOid,statusCheckRollup"])
    try:
        j = json.loads(out) if not code else None
    except ValueError:
        j = None
    if not isinstance(j, dict):
        return {"number": 0}
    return {"number": int(j.get("number") or 0), "url": str(j.get("url") or ""), "state": str(j.get("state") or ""),
            "mergeable": str(j.get("mergeable") or ""), "review": str(j.get("reviewDecision") or ""),
            "head": str(j.get("headRefOid") or ""),
            "checks": [_pr_check(c) for c in (j.get("statusCheckRollup") or []) if isinstance(c, dict)]}


def pr_failed_logs(checks: list) -> list:
    """Logi nieudanych testów (gh run view --log-failed), najwyżej trzy, końcówka 6000 znaków każdy."""
    import re
    out = []
    for c in [c for c in checks if isinstance(c, dict)][:3]:
        link = str(c.get("link") or "")
        m = re.search(r"/actions/runs/(\d+)", link)
        text = ""
        if m:
            code, log = _pr_gh(["run", "view", m.group(1), "--log-failed"], timeout=90)
            text = log[-6000:] if not code or log else ""
        out.append({"name": str(c.get("name") or "check")[:200], "link": link, "log": text})
    return out


def pr_merge(number: int, auto: bool) -> dict:
    """Scalenie PR (squash, gałąź usuwana). auto: GitHub scali sam po zielonych testach, jeśli repo pozwala."""
    if number <= 0:
        raise ValueError(_L("Nie ma otwartego PR."))
    code, out = _pr_gh(["pr", "merge", str(number), *(["--auto"] if auto else []), "--squash", "--delete-branch"],
                       timeout=120)
    low = out.lower()
    return {"ok": code == 0, "auto": auto, "out": out[-300:],
            "auto_off": bool(code and auto and ("auto merge" in low or "auto-merge" in low))}


