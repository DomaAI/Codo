class Spinner:
    """Status pracy na czas jednego kroku (zgodność: `with Spinner(): ...`)."""

    def __init__(self, label: str = ""):
        self.label = label
        self._owner = False

    def __enter__(self):
        if LIVE.busy:
            if self.label:
                LIVE.status(self.label)
            return self
        self._owner = True
        LIVE.start_busy(self.label)
        return self

    def __exit__(self, *exc):
        if self._owner:
            LIVE.stop_busy()
        return False


# ── Markdown w terminalu (lekko: nagłówki, pogrubienia, kod, listy) ──────────
def _md_line(line: str, state: dict) -> str | None:
    """Jedna linia Markdown → terminal. `state` trzyma, czy jesteśmy w bloku kodu.
    Zwraca None dla linii, których nie pokazujemy."""
    fence = line.strip()
    if fence.startswith("```"):
        state["code"] = not state.get("code")
        lang = fence[3:].strip()
        return dim("╭─ " + lang if lang else "╭─") if state["code"] else dim("╰─")
    if state.get("code"):
        return dim("│ ") + cyan(line)
    m = re.match(r"^(\s*)(#{1,6})\s+(.*)", line)
    if m:
        title = bold(_md_inline(m.group(3)))
        return m.group(1) + (violet(title) if len(m.group(2)) == 1 else title)
    if re.match(r"^\s*(?:[-*_]\s*){3,}$", line):
        return dim("─" * 36)
    if re.match(r"^\s*\|?\s*:?-{3,}:?\s*(\|\s*:?-{3,}:?\s*)+\|?\s*$", line):
        return dim(re.sub(r"[^|]", "─", line.strip()).replace("|", "┼"))
    if line.lstrip().startswith("|") and line.rstrip().endswith("|"):
        cells = [c.strip() for c in line.strip()[1:-1].split("|")]
        return (" " + dim("│") + " ").join(_md_inline(c) for c in cells)
    line = re.sub(r"^(\s*)[-*+]\s+\[ \]\s+", lambda m: m.group(1) + dim("☐") + " ", line)
    line = re.sub(r"^(\s*)[-*+]\s+\[x\]\s+", lambda m: m.group(1) + green("☑") + " ", line, flags=re.I)
    line = re.sub(r"^(\s*)[-*+]\s+", lambda m: m.group(1) + violet("•") + " ", line)
    line = re.sub(r"^(\s*)(\d+[.)])\s+", lambda m: m.group(1) + cyan(m.group(2)) + " ", line)
    line = re.sub(r"^(\s*)>\s?", lambda m: m.group(1) + violet("│") + " ", line)
    return _md_inline(line)


def _md_inline(line: str) -> str:
    line = re.sub(r"\*\*(.+?)\*\*", lambda m: bold(m.group(1)), line)
    line = re.sub(r"(?<![*\w])\*([^*\n]+)\*(?!\*)", lambda m: _c("3", m.group(1)), line)
    line = re.sub(r"`([^`\n]+)`", lambda m: cyan(m.group(1)), line)
    line = re.sub(r"\[([^\]]+)\]\((https?://[^)\s]+)\)", lambda m: m.group(1) + " " + dim(m.group(2)), line)
    return line


def render_md(text: str) -> str:
    if not _tty():
        return text
    state: dict = {}
    return "\n".join(r for r in (_md_line(line, state) for line in text.splitlines()) if r is not None)


class _AnswerStream:
    """Strumień odpowiedzi: pełne linie trafiają nad panel już sformatowane,
    niedokończona linia jest podglądem w panelu (jak pisanie na żywo)."""

    def __init__(self):
        self.buf = ""
        self.text = ""
        self.lines = 0
        self.state: dict = {}

    def _prefix(self) -> str:
        return (bold("●") + " ") if self.lines == 0 else "  "

    def _emit(self, line: str) -> None:
        if self.lines == 0:
            if not line.strip():
                return
            print()
        rendered = _md_line(_terminal_text(line), self.state) if _tty() else line
        if rendered is not None:
            print(self._prefix() + rendered)
            self.lines += 1

    def feed(self, chunk: str) -> None:
        _app_emit("delta", tekst=chunk)
        self.text += chunk
        self.buf += chunk
        while "\n" in self.buf:
            line, self.buf = self.buf.split("\n", 1)
            self._emit(line)
        if LIVE.on:
            shown = _md_line(_terminal_text(self.buf), dict(self.state)) if self.buf.strip() else None
            LIVE.set_preview((self._prefix() + shown) if shown else "")

    def replace(self, text: str) -> None:
        """Serwer podmienił całą odpowiedź: dopisz tylko brakującą resztę."""
        if text.startswith(self.text):
            self.feed(text[len(self.text):])
        else:
            self.finish()
            self.text = text

    def finish(self) -> None:
        if self.buf:
            line, self.buf = self.buf, ""
            self._emit(line)
        LIVE.set_preview("")
        fresh = self.text[getattr(self, "synced", 0):].strip()
        if fresh:
            SYNC.add("assistant", {"tekst": fresh, **({"lustro": True} if SESSION.get("turn_lustro") else {})})
        self.synced = len(self.text)
        if self.lines:
            self.lines = 0
            self.state = {}


