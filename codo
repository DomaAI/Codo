# Ścieżki zawsze względem folderu projektu (cwd okna), nigdy poza nim, nigdy w .git ani .doma.
_UI_CHG_TEXT_MAX = 3 << 20          # większy plik: tylko liczniki, treść w edytorze
_UI_CHG_IMG_MAX = 8 << 20
_UI_CHG_IMG = {"png": "image/png", "jpg": "image/jpeg", "jpeg": "image/jpeg", "gif": "image/gif",
               "webp": "image/webp", "bmp": "image/bmp", "ico": "image/x-icon", "svg": "image/svg+xml"}
_UI_CHG_EMPTY_TREE = "4b825dc642cb6eb9a060e54bf8d69288fbee4904"
_UI_CHG_REVIEW = ".doma/review"     # bez gita: przyjęta wersja pliku (punkt odniesienia różnic)
_UI_CHG_UNDO: list = []             # stos operacji okna: [[{p, work, index, base}], …]
_UI_CHG_LOCK = threading.Lock()


def _ui_chg_run(args: list, cwd, data: bytes | None = None, timeout: int = 60) -> tuple:
    import shutil
    git = shutil.which("git")
    if not git:
        return 127, b"", "git"
    try:
        p = subprocess.run([git, *args], cwd=str(cwd), input=data, capture_output=True, timeout=timeout,  # nosec B603
                           stdin=None if data is not None else subprocess.DEVNULL)
        return p.returncode, p.stdout or b"", (p.stderr or b"").decode("utf-8", "replace").strip()
    except (OSError, subprocess.SubprocessError) as exc:
        return 1, b"", str(exc)


def _ui_chg_top() -> Path | None:
    code, out, _ = _ui_chg_run(["rev-parse", "--show-toplevel"], Path.cwd(), timeout=10)
    return Path(out.decode("utf-8", "replace").strip()).resolve() if code == 0 and out.strip() else None


def _ui_chg_path(rel: str) -> Path | None:
    """Plik projektu z ścieżki okna; None, gdy poza folderem albo w .git/.doma."""
    rel = str(rel or "").replace("\\", "/").strip()
    if not rel or rel.startswith("/") or "\0" in rel or re.match(r"^[A-Za-z]:", rel):
        return None
    base = Path.cwd().resolve()
    target = (base / rel).resolve()
    if base not in target.parents:
        return None
    first = target.relative_to(base).parts[0]
    return None if first in (".git", ".doma") else target


def _ui_chg_sig(data: bytes | None) -> str:
    import hashlib
    return "" if data is None else hashlib.sha1(data).hexdigest()  # nosec B324 — podpis treści, nie hasło


def _ui_chg_is_text(data: bytes | None) -> bool:
    if data is None:
        return True
    if b"\0" in data[:8000]:
        return False
    try:
        data.decode("utf-8")
        return True
    except UnicodeDecodeError:
        return False


def _ui_chg_lines(data: bytes | None) -> int:
    if not data:
        return 0
    return data.count(b"\n") + (0 if data.endswith(b"\n") else 1)


def _ui_chg_gp(top: Path, target: Path) -> str:
    return str(target.relative_to(top)).replace("\\", "/")


def _ui_chg_rel(top: Path, gp: str) -> str:
    return os.path.relpath(top / gp, Path.cwd()).replace("\\", "/")


def _ui_chg_head_ref(top: Path) -> str:
    code, _, _ = _ui_chg_run(["rev-parse", "--verify", "-q", "HEAD"], top, timeout=10)
    return "HEAD" if code == 0 else _UI_CHG_EMPTY_TREE


def _ui_chg_blob(top: Path, spec: str) -> bytes | None:
    code, out, _ = _ui_chg_run(["show", spec], top, timeout=30)
    return out if code == 0 else None


def _ui_chg_index_entry(top: Path, gp: str) -> tuple | None:
    code, out, _ = _ui_chg_run(["ls-files", "-s", "-z", "--", gp], top, timeout=10)
    for rec in out.decode("utf-8", "replace").split("\0"):
        if "\t" in rec:
            meta, name = rec.split("\t", 1)
            parts = meta.split()
            if name == gp and len(parts) >= 3 and parts[2] == "0":
                return parts[0], parts[1]
    return None


def _ui_chg_review_dir() -> Path:
    return Path.cwd() / _UI_CHG_REVIEW


def _ui_chg_accepted() -> dict:
    try:
        d = json.loads((_ui_chg_review_dir() / "_accepted.json").read_text(encoding="utf-8"))
        return d if isinstance(d, dict) else {}
    except (OSError, ValueError):
        return {}


def _ui_chg_base(rel: str) -> bytes | None:
    """Bez gita: wersja odniesienia = przyjęta w oknie, a gdy jej nie ma, najstarsza kopia w .doma/backups."""
    acc = _ui_chg_accepted().get(rel)
    if acc == "deleted":
        return None
    copy = _ui_chg_review_dir() / rel
    if acc and copy.is_file():
        return copy.read_bytes()
    target = _ui_chg_path(rel)
    try:
        _, baks = _backups_for(target) if target else (None, [])
    except (ValueError, OSError):
        baks = []
    return baks[0].read_bytes() if baks else None


def _ui_chg_set_base(rel: str, data: bytes | None) -> None:
    d = _ui_chg_review_dir()
    d.mkdir(parents=True, exist_ok=True)
    _doma_ignored()
    acc = _ui_chg_accepted()
    copy = d / rel
    if data is None:
        acc[rel] = "deleted"
        copy.unlink(missing_ok=True)
    else:
        copy.parent.mkdir(parents=True, exist_ok=True)
        _atomic_write(copy, data)
        acc[rel] = _ui_chg_sig(data)
    _atomic_write(d / "_accepted.json", json.dumps(acc, ensure_ascii=False, indent=1).encode("utf-8"))


def _ui_chg_list(extra=None) -> dict:
    top = _ui_chg_top()
    if top is None:
        return _ui_chg_list_plain(extra or [])
    cwd = Path.cwd().resolve()
    head = _ui_chg_head_ref(top)
    code, out, err = _ui_chg_run(["status", "--porcelain=v2", "-z", "--untracked-files=all", "--branch", "--", str(cwd)],
                                 top, timeout=30)
    if code:
        return {"git": True, "error": err[-300:], "files": []}
    recs = out.decode("utf-8", "replace").split("\0")
    files, branch, upstream, ahead, behind = [], "", "", 0, 0
    i = 0
    while i < len(recs):
        r = recs[i]
        i += 1
        if not r:
            continue
        if r.startswith("# branch.head "):
            branch = r[14:]
        elif r.startswith("# branch.upstream "):
            upstream = r[18:]
        elif r.startswith("# branch.ab "):
            m = re.match(r"# branch\.ab \+(\d+) -(\d+)", r)
            if m:
                ahead, behind = int(m.group(1)), int(m.group(2))
        elif r[0] in "12u":
            parts = r.split(" ", {"1": 8, "2": 9, "u": 10}[r[0]])
            xy = parts[1]
            gp = parts[-1]
            orig = ""
            if r[0] == "2":
                orig = recs[i] if i < len(recs) else ""
                i += 1
            x, y = xy[0], xy[1]
            if r[0] == "u":
                status = "conflict"
            elif x == "A":
                status = "deleted" if y == "D" else "new"
            elif orig:
                status = "renamed"
            elif x == "D" or y == "D":
                status = "deleted"
            else:
                status = "modified"
            staged = "none" if x == "." else ("full" if y == "." else "partial")
            files.append({"gp": gp, "orig_gp": orig, "status": status, "staged": staged})
        elif r[0] == "?":
            files.append({"gp": r[2:], "orig_gp": "", "status": "new", "staged": "none"})
    # liczniki +/− i pliki binarne: HEAD → stan roboczy (nowe nieśledzone liczymy z dysku)
    nums: dict = {}
    code, out, _ = _ui_chg_run(["diff", head, "--numstat", "-z", "-M", "--", str(cwd)], top, timeout=60)
    toks = out.decode("utf-8", "replace").split("\0")
    j = 0
    while j < len(toks):
        t = toks[j]
        j += 1
        if not t:
            continue
        a, d, name = (t.split("\t", 2) + ["", "", ""])[:3]
        if name == "" and j + 1 < len(toks):
            name = toks[j + 1]
            j += 2
        nums[name] = (a, d)
    out_files = []
    for f in files:
        rel = _ui_chg_rel(top, f["gp"])
        if rel.startswith("../") or rel.startswith((".doma/", ".git/")) or "__pycache__/" in rel \
                or rel.endswith((".pyc", ".DS_Store")):
            continue
        target = cwd / rel
        a, d = nums.get(f["gp"], ("", ""))
        binary = a == "-"
        size = target.stat().st_size if target.is_file() else 0
        if f["gp"] not in nums and f["status"] == "new" and target.is_file():
            data = target.read_bytes() if size <= _UI_CHG_TEXT_MAX else None
            binary = data is not None and not _ui_chg_is_text(data)
            a, d = (str(_ui_chg_lines(data)) if data is not None and not binary else "0"), "0"
        ext = rel.rsplit(".", 1)[-1].lower() if "." in rel.split("/")[-1] else ""
        row = {"path": rel, "orig": _ui_chg_rel(top, f["orig_gp"]) if f["orig_gp"] else "",
               "status": f["status"], "staged": f["staged"], "binary": binary, "image": ext in _UI_CHG_IMG,
               "added": int(a) if a.isdigit() else 0, "removed": int(d) if d.isdigit() else 0, "size": size}
        oc = _ui_chg_office_counts(rel) if _ui_chg_office_kind(rel) and f["status"] != "conflict" else None
        if oc:
            row.update(binary=False, added=oc[0], removed=oc[1], office=oc[2])
        out_files.append(row)
    out_files.sort(key=lambda x: x["path"].lower())
    code, refs, _ = _ui_chg_run(["for-each-ref", "--format=%(refname:short)", "--sort=-committerdate", "refs/heads"],
                                top, timeout=10)
    branches = [b for b in refs.decode("utf-8", "replace").splitlines() if b][:60]
    code, last, _ = _ui_chg_run(["log", "-1", "--format=%h\t%s"], top, timeout=10)
    lh, _, ls = last.decode("utf-8", "replace").strip().partition("\t")
    code, rem, _ = _ui_chg_run(["remote", "get-url", "origin"], top, timeout=10)
    return {"git": True, "branch": "" if branch == "(detached)" else branch, "detached": branch == "(detached)",
            "branches": branches, "upstream": upstream, "ahead": ahead, "behind": behind,
            "remote": rem.decode("utf-8", "replace").strip(), "last": {"hash": lh, "subject": ls},
            "has_head": head == "HEAD", "files": out_files, "can_undo": bool(_UI_CHG_UNDO)}


def _ui_chg_list_plain(extra: list) -> dict:
    """Bez gita: pliki z kopiami w .doma/backups, przyjęte w oknie i te, które silnik zgłosił w tej sesji."""
    cwd = Path.cwd()
    names: set = set()
    bdir = cwd / _BACKUP_DIR
    if bdir.is_dir():
        pat = re.compile(r"^(.*)\.\d{8}-\d{6}(?:-\d+)?\.bak$")
        for b in bdir.rglob("*.bak"):
            m = pat.match(b.name)
            if m:
                names.add((b.parent.relative_to(bdir) / m.group(1)).as_posix())
    names.update(_ui_chg_accepted().keys())
    names.update(str(x).replace("\\", "/") for x in extra if isinstance(x, str))
    files = []
    for rel in sorted(names, key=str.lower)[:2000]:
        target = _ui_chg_path(rel)
        if target is None:
            continue
        work = target.read_bytes() if target.is_file() and target.stat().st_size <= _UI_CHG_TEXT_MAX else None
        exists = target.is_file()
        base = _ui_chg_base(rel)
        if (base is None and not exists) or (exists and work is not None and base == work):
            continue
        binary = not (_ui_chg_is_text(work) and _ui_chg_is_text(base))
        a = r = 0
        oc = _ui_chg_office_counts(rel) if binary and _ui_chg_office_kind(rel) else None
        if oc:
            binary, a, r = False, oc[0], oc[1]
        elif not binary:
            import difflib
            old = (base or b"").decode("utf-8").splitlines()
            new = (work or b"").decode("utf-8").splitlines()
            for tag, i1, i2, j1, j2 in difflib.SequenceMatcher(None, old, new, autojunk=False).get_opcodes():
                if tag != "equal":
                    r += i2 - i1
                    a += j2 - j1
        ext = rel.rsplit(".", 1)[-1].lower() if "." in rel.split("/")[-1] else ""
        files.append({"path": rel, "orig": "", "status": "new" if base is None else ("deleted" if not exists else "modified"),
                      "staged": "none", "binary": binary, "image": ext in _UI_CHG_IMG, "added": a, "removed": r,
                      "size": target.stat().st_size if exists else 0, **({"office": oc[2]} if oc else {})})
    return {"git": False, "branch": "", "branches": [], "files": files, "can_undo": bool(_UI_CHG_UNDO)}


def _ui_chg_office_kind(rel: str) -> str:
    """Dokument Word/Excel/PowerPoint/ODF po rozszerzeniu ("" = nie): panel Zmiany pokazuje jego tekst."""
    name = str(rel).replace("\\", "/").split("/")[-1]
    kind = _ZIP_KINDS.get("." + name.rsplit(".", 1)[-1].lower(), "") if "." in name else ""
    return kind if kind in _OFFICE_ACTIONS else ""


def _ui_chg_office_text(target: Path, kind: str, data: bytes | None):
    """Tekst dokumentu tymi samymi czytnikami co read_file (_document_text); None = nie da się odczytać."""
    if data is None or not data.startswith(b"PK"):
        return None
    try:
        text = _document_text(target, kind, data)[0]
    except Exception:  # noqa: BLE001 — uszkodzony zip albo XML: plik zostaje binarny
        return None
    if text is None:
        return None
    text = text.replace("\r\n", "\n").replace("\r", "\n")
    return text if text.endswith("\n") or not text else text + "\n"


def _ui_chg_office_base(target: Path) -> bytes | None:
    """Wersja „przed” dokumentu spoza gita (nowy, nieśledzony): najstarsza kopia z .doma/backups."""
    try:
        _, baks = _backups_for(target)
    except (ValueError, OSError):
        baks = []
    return baks[0].read_bytes() if baks else None


def _ui_chg_office_counts(rel: str) -> tuple:
    """Liczniki +/− tekstu dokumentu do listy plików (diff --numstat daje dla zipa tylko „-”)."""
    import difflib
    st, d = _ui_chg_file(rel)
    if st != 200 or not d.get("office"):
        return None
    old = (d.get("head") or "").splitlines()
    new = (d.get("work") or "").splitlines()
    a = r = 0
    for tag, i1, i2, j1, j2 in difflib.SequenceMatcher(None, old, new, autojunk=False).get_opcodes():
        if tag != "equal":
            r += i2 - i1
            a += j2 - j1
    return a, r, d["office"]


def _ui_chg_file(rel: str, orig: str = "") -> tuple:
    target = _ui_chg_path(rel)
    if target is None:
        return 400, {"ok": False, "error": "path"}
    top = _ui_chg_top()
    work = target.read_bytes() if target.is_file() else None
    index = None
    if top is not None:
        gp = _ui_chg_gp(top, target)
        src = _ui_chg_path(orig) if orig else None
        hgp = _ui_chg_gp(top, src) if src is not None else gp
        head = _ui_chg_blob(top, f"{_ui_chg_head_ref(top)}:{hgp}") if _ui_chg_head_ref(top) == "HEAD" else None
        index = _ui_chg_blob(top, f":{gp}") if _ui_chg_index_entry(top, gp) else None
        if work is not None and b"\r\n" in work and not _ui_chg_office_kind(rel) and _ui_chg_eol_converts(top, gp):
            # Windows (core.autocrlf, domyślne w Git for Windows): w repo LF, na dysku CRLF. Git tego nie liczy
            # za zmianę, więc okno też nie: HEAD i indeks w postaci z dysku, inaczej każda linia „zmieniona”.
            head, index = _ui_chg_to_crlf(head), _ui_chg_to_crlf(index)
    else:
        head = _ui_chg_base(rel)
    okind = _ui_chg_office_kind(rel)
    base_from = ""
    if okind and top is not None and head is None and work is not None:
        head = _ui_chg_office_base(target)       # dokument spoza repozytorium: „przed” = kopia sprzed office_edit
        base_from = "backup" if head is not None else ""
    elif okind and head is not None:
        base_from = "head" if top is not None else "backup"
    ext = rel.rsplit(".", 1)[-1].lower() if "." in rel.split("/")[-1] else ""
    out = {"ok": True, "path": rel, "git": top is not None, "exists": work is not None,
           "head_exists": head is not None, "index_exists": index is not None,
           "work_sig": _ui_chg_sig(work), "index_sig": _ui_chg_sig(index),
           "size_before": len(head or b""), "size_after": len(work or b"")}
    if okind:
        # Word/Excel/PowerPoint/ODF: diff tekstu dokumentu; fragmenty się nie stosują (to zip), tylko cały plik
        texts = {k: _ui_chg_office_text(target, okind, v) for k, v in (("head", head), ("work", work), ("index", index))}
        if all(texts[k] is not None or v is None for k, v in (("head", head), ("work", work), ("index", index))):
            if max(len(t or "") for t in texts.values()) > _UI_CHG_TEXT_MAX:
                out.update(office=okind, whole_file=True, too_large=True)
                return 200, out
            out.update(texts)
            out.update(office=okind, whole_file=True, base_from=base_from, head_exists=head is not None)
            return 200, out
    big = max(len(head or b""), len(work or b""), len(index or b"")) > _UI_CHG_TEXT_MAX
    if ext in _UI_CHG_IMG and ext != "svg" or not (_ui_chg_is_text(head) and _ui_chg_is_text(work) and _ui_chg_is_text(index)):
        import base64
        out["binary"] = True
        if ext in _UI_CHG_IMG:
            mime = _UI_CHG_IMG[ext]
            for key, data in (("img_before", head), ("img_after", work)):
                if data is not None and len(data) <= _UI_CHG_IMG_MAX:
                    out[key] = "data:" + mime + ";base64," + base64.b64encode(data).decode("ascii")
        return 200, out
    if big:
        out["too_large"] = True
        return 200, out
    out["head"] = head.decode("utf-8") if head is not None else None
    out["work"] = work.decode("utf-8") if work is not None else None
    out["index"] = index.decode("utf-8") if index is not None else None
    if ext == "svg":
        import base64
        for key, data in (("img_before", head), ("img_after", work)):
            if data is not None:
                out[key] = "data:image/svg+xml;base64," + base64.b64encode(data).decode("ascii")
    return 200, out


def _ui_chg_snapshot(top: Path | None, target: Path) -> dict:
    rel = str(target.relative_to(Path.cwd().resolve())).replace("\\", "/")
    snap = {"p": rel, "work": target.read_bytes() if target.is_file() else None}
    if top is not None:
        snap["index"] = _ui_chg_index_entry(top, _ui_chg_gp(top, target))
    else:
        acc = _ui_chg_accepted().get(rel)
        copy = _ui_chg_review_dir() / rel
        snap["base"] = (acc, copy.read_bytes() if acc and copy.is_file() else None)
    return snap


def _ui_chg_write_work(target: Path, data: bytes | None) -> None:
    cur = target.read_bytes() if target.is_file() else None
    if cur == data:
        return
    if cur is not None:
        _backup(target)            # każda zmiana z okna też ma kopię (Cofnij, wcześniejsze wersje)
    if data is None:
        target.unlink(missing_ok=True)
    else:
        target.parent.mkdir(parents=True, exist_ok=True)
        _atomic_write(target, data)


def _ui_chg_eol_converts(top: Path, gp: str) -> bool:
    """Czy git zamienia CRLF z dysku na LF w repozytorium (core.autocrlf true/input albo atrybut eol=crlf)."""
    code, out, _ = _ui_chg_run(["config", "--get", "core.autocrlf"], top, timeout=10)
    if code == 0 and out.decode("utf-8", "replace").strip().lower() in ("true", "input"):
        return True
    code, out, _ = _ui_chg_run(["check-attr", "eol", "--", gp], top, timeout=10)
    return code == 0 and out.decode("utf-8", "replace").strip().endswith(": crlf")


def _ui_chg_to_crlf(data: bytes | None) -> bytes | None:
    if data is None or b"\r" in data:
        return data
    return data.replace(b"\n", b"\r\n")


def _ui_chg_write_index(top: Path, target: Path, data: bytes | None) -> str:
    gp = _ui_chg_gp(top, target)
    if data is None:
        code, _, err = _ui_chg_run(["rm", "--cached", "-q", "--ignore-unmatch", "--", gp], top)
        return "" if code == 0 else err
    # --path: filtry jak przy git add (CRLF z okna → LF w repo przy core.autocrlf), indeks zgodny z git diff
    code, sha, err = _ui_chg_run(["hash-object", "-w", "--stdin", "--path=" + gp], top, data=data)
    if code:
        return err
    entry = _ui_chg_index_entry(top, gp)
    mode = entry[0] if entry else ("100755" if target.is_file() and os.access(target, os.X_OK) and os.name != "nt" else "100644")
    code, _, err = _ui_chg_run(["update-index", "--add", "--cacheinfo", f"{mode},{sha.decode().strip()},{gp}"], top)
    return "" if code == 0 else err


def _ui_chg_restore_snap(top: Path | None, snap: dict) -> None:
    target = _ui_chg_path(snap["p"])
    if target is None:
        return
    _ui_chg_write_work(target, snap["work"])
    if top is not None:
        gp = _ui_chg_gp(top, target)
        if snap.get("index"):
            mode, sha = snap["index"]
            _ui_chg_run(["update-index", "--add", "--cacheinfo", f"{mode},{sha},{gp}"], top)
        else:
            _ui_chg_run(["rm", "--cached", "-q", "--ignore-unmatch", "--", gp], top)
    elif "base" in snap:
        acc, data = snap["base"]
        d = _ui_chg_review_dir()
        allx = _ui_chg_accepted()
        if acc is None:
            allx.pop(snap["p"], None)
            (d / snap["p"]).unlink(missing_ok=True)
        else:
            allx[snap["p"]] = acc
            if data is not None:
                (d / snap["p"]).parent.mkdir(parents=True, exist_ok=True)
                _atomic_write(d / snap["p"], data)
        if d.is_dir():
            _atomic_write(d / "_accepted.json", json.dumps(allx, ensure_ascii=False, indent=1).encode("utf-8"))


def _ui_chg_push_undo(snaps: list) -> None:
    if snaps:
        _UI_CHG_UNDO.append(snaps)
        del _UI_CHG_UNDO[:-40]


def _ui_chg_apply(msg: dict) -> tuple:
    """Fragment przyjęty albo odrzucony: okno liczy nową treść pliku (i indeksu), tu zapis z kopią."""
    target = _ui_chg_path(str(msg.get("p") or ""))
    if target is None:
        return 400, {"ok": False, "error": "path"}
    if _ui_chg_office_kind(str(msg.get("p") or "")):
        return 400, {"ok": False, "error": "whole_file"}   # tekst dokumentu to nie jego bajty: tylko cały plik
    top = _ui_chg_top()
    cur = target.read_bytes() if target.is_file() else None
    if "expect_work" in msg and str(msg.get("expect_work") or "") != _ui_chg_sig(cur):
        return 409, {"ok": False, "error": "changed"}      # plik zmienił się w międzyczasie (agent pisze dalej)
    snap = _ui_chg_snapshot(top, target)
    enc = lambda v: None if v is None else str(v).encode("utf-8")  # noqa: E731
    if "work" in msg:
        was_new = top is None and _ui_chg_base(snap["p"]) is None
        _ui_chg_write_work(target, enc(msg.get("work")))
        if was_new and msg.get("work") is None and "base" not in msg:
            _ui_chg_set_base(snap["p"], None)
    if "index" in msg and top is not None:
        err = _ui_chg_write_index(top, target, enc(msg.get("index")))
        if err:
            _ui_chg_restore_snap(top, snap)
            return 400, {"ok": False, "error": err[-300:]}
    if "base" in msg and top is None:
        _ui_chg_set_base(snap["p"], enc(msg.get("base")))
    _ui_chg_push_undo([snap])
    return 200, {"ok": True}


def _ui_chg_action(msg: dict) -> tuple:
    """Cały plik (albo kilka): accept (do indeksu / przyjęta wersja), reject (z powrotem jak w HEAD), unstage."""
    action = str(msg.get("action") or "")
    rels = [str(x) for x in (msg.get("paths") or []) if isinstance(x, str)][:2000]
    targets = [t for t in (_ui_chg_path(r) for r in rels) if t is not None]
    if action not in ("accept", "reject", "unstage") or not targets:
        return 400, {"ok": False, "error": "action"}
    top = _ui_chg_top()
    snaps = [_ui_chg_snapshot(top, t) for t in targets]
    err = ""
    if top is not None:
        head = _ui_chg_head_ref(top)
        gps = [_ui_chg_gp(top, t) for t in targets]
        if action == "accept":
            code, _, err = _ui_chg_run(["add", "-A", "--", *gps], top)
        elif action == "unstage":
            if head == "HEAD":
                code, _, err = _ui_chg_run(["reset", "-q", "--", *gps], top)
            else:
                code, _, err = _ui_chg_run(["rm", "--cached", "-q", "-r", "--ignore-unmatch", "--", *gps], top)
            err = "" if code == 0 else err
        else:
            for t, gp in zip(targets, gps):
                old = _ui_chg_blob(top, f"HEAD:{gp}") if head == "HEAD" else None
                if old is None and t.is_file() and _ui_chg_office_kind(t.name):
                    old = _ui_chg_office_base(t)   # dokument spoza repo: wraca kopia sprzed zmian, jak w diffie
                    if old is not None:
                        _ui_chg_write_work(t, old)
                        continue
                _ui_chg_write_work(t, old)
                if old is None:
                    _ui_chg_run(["rm", "--cached", "-q", "--ignore-unmatch", "--", gp], top)
                else:
                    _ui_chg_run(["reset", "-q", "--", gp], top)
    else:
        for t, s in zip(targets, snaps):
            if action == "accept":
                _ui_chg_set_base(s["p"], s["work"])
            elif action == "reject":
                base = _ui_chg_base(s["p"])
                _ui_chg_write_work(t, base)
                if base is None:            # nowy plik usunięty: jego kopia w backups nie staje się „przed”
                    _ui_chg_set_base(s["p"], None)
    _ui_chg_push_undo(snaps)
    return (400 if err else 200), {"ok": not err, "error": err[-300:]}


def _ui_chg_undo() -> tuple:
    with _UI_CHG_LOCK:
        if not _UI_CHG_UNDO:
            return 200, {"ok": False, "error": "empty"}
        snaps = _UI_CHG_UNDO.pop()
    top = _ui_chg_top()
    for s in snaps:
        _ui_chg_restore_snap(top, s)
    return 200, {"ok": True, "paths": [s["p"] for s in snaps]}


def _ui_chg_backups(rel: str) -> tuple:
    target = _ui_chg_path(rel)
    if target is None:
        return 400, {"ok": False}
    try:
        _, baks = _backups_for(target)
    except (ValueError, OSError):
        baks = []
    items = []
    for b in reversed(baks):
        m = re.search(r"\.(\d{8})-(\d{6})(?:-\d+)?\.bak$", b.name)
        when = f"{m.group(1)[:4]}-{m.group(1)[4:6]}-{m.group(1)[6:]} {m.group(2)[:2]}:{m.group(2)[2:4]}:{m.group(2)[4:]}" if m else ""
        items.append({"name": b.name, "when": when, "size": b.stat().st_size})
    return 200, {"ok": True, "items": items}


def _ui_chg_restore(msg: dict) -> tuple:
    target = _ui_chg_path(str(msg.get("p") or ""))
    name = str(msg.get("name") or "")
    if target is None or not name or "/" in name or "\\" in name:
        return 400, {"ok": False}
    try:
        _, baks = _backups_for(target)
    except (ValueError, OSError):
        baks = []
    src = next((b for b in baks if b.name == name), None)
    if src is None:
        return 404, {"ok": False}
    data = src.read_bytes()
    snap = _ui_chg_snapshot(_ui_chg_top(), target)
    _ui_chg_write_work(target, data)
    _ui_chg_push_undo([snap])
    return 200, {"ok": True}


def _ui_chg_open(msg: dict) -> tuple:
    """Otwórz w edytorze (domyślna aplikacja systemu) albo pokaż w Eksploratorze, Finderze, menedżerze plików."""
    rel = str(msg.get("p") or "")
    target = _ui_chg_path(rel) if rel else Path.cwd().resolve()
    reveal = bool(msg.get("reveal"))
    if target is None or not (target.exists() or reveal):
        return 404, {"ok": False}
    if reveal and not target.exists():
        target = target.parent
    try:
        if os.name == "nt":
            if reveal and target.is_file():
                subprocess.Popen(["explorer", "/select,", str(target)])  # nosec B603 B607 — plik projektu
            else:
                os.startfile(str(target))  # nosec B606 — plik projektu
        elif sys.platform == "darwin":
            subprocess.Popen(["open", "-R", str(target)] if reveal else ["open", str(target)])  # nosec B603 B607
        else:
            subprocess.Popen(["xdg-open", str(target.parent if reveal and target.is_file() else target)],  # nosec B603 B607
                             stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    except OSError:
        return 500, {"ok": False}
    return 200, {"ok": True}


def _ui_chg_commit(msg: dict) -> tuple:
    top = _ui_chg_top()
    text = str(msg.get("message") or "").strip()[:5000]
    if top is None or not text:
        return 400, {"ok": False, "error": "message"}
    if msg.get("all"):
        _ui_chg_run(["add", "-A", "--", str(Path.cwd().resolve())], top)
    code, out, err = _ui_chg_run(["commit", "-q", "-m", text], top, timeout=180)
    if code:
        return 400, {"ok": False, "error": (err or out.decode("utf-8", "replace")).strip()[-400:]}
    _UI_CHG_UNDO.clear()       # po commicie stare zrzuty indeksu nie mają sensu
    _, h, _ = _ui_chg_run(["log", "-1", "--format=%h"], top, timeout=10)
    return 200, {"ok": True, "hash": h.decode().strip()}


def _ui_chg_branch(msg: dict) -> tuple:
    top = _ui_chg_top()
    name = str(msg.get("name") or "").strip()
    if top is None or not name or name.startswith("-"):
        return 400, {"ok": False, "error": "name"}
    code, _, _ = _ui_chg_run(["check-ref-format", "--branch", name], top, timeout=10)
    if code:
        return 400, {"ok": False, "error": "name"}
    args = ["checkout", "-q", "-b", name] if msg.get("action") == "create" else ["checkout", "-q", name]
    code, _, err = _ui_chg_run(args, top, timeout=60)
    return (200, {"ok": True}) if code == 0 else (400, {"ok": False, "error": err[-400:]})


def _ui_chg_get(path: str, qs: dict) -> tuple:
    q = lambda k: (qs.get(k) or [""])[0]  # noqa: E731
    if path == "/api/changes/list":
        return 200, _ui_chg_list([x for x in q("extra").split("\n") if x])
    if path == "/api/changes/file":
        return _ui_chg_file(q("p"), q("orig"))
    if path == "/api/changes/backups":
        return _ui_chg_backups(q("p"))
    return 404, {"ok": False}


def _ui_chg_post(path: str, msg: dict) -> tuple:
    with _UI_CHG_LOCK if path != "/api/changes/undo" else contextlib.nullcontext():
        if path == "/api/changes/apply":
            return _ui_chg_apply(msg)
        if path == "/api/changes/action":
            return _ui_chg_action(msg)
        if path == "/api/changes/restore":
            return _ui_chg_restore(msg)
        if path == "/api/changes/commit":
            return _ui_chg_commit(msg)
        if path == "/api/changes/branch":
            return _ui_chg_branch(msg)
    if path == "/api/changes/undo":
        return _ui_chg_undo()
    if path == "/api/changes/open":
        return _ui_chg_open(msg)
    return 404, {"ok": False}


def _ui_handler(bridge: _UiBridge, token: str, port_ref: list, on_quit):
    import hmac
    import secrets
    from http.server import BaseHTTPRequestHandler

    compare = _UiCompare(bridge)
    import atexit
    atexit.register(compare.stop)

    def allowed_hosts() -> set:
        port = port_ref[0]
        return {f"127.0.0.1:{port}", f"localhost:{port}"}

    class Handler(BaseHTTPRequestHandler):
        server_version = "Codo"
        sys_version = ""

        def log_message(self, *a):   # noqa: D401 — bez dziennika żądań w terminalu
            pass

        def _headers(self, code: int, ctype: str, length: int | None = None, extra: dict | None = None) -> None:
            self.send_response(code)
            self.send_header("Content-Type", ctype)
            if length is not None:
                self.send_header("Content-Length", str(length))
            self.send_header("Cache-Control", "no-store")
            self.send_header("X-Content-Type-Options", "nosniff")
            self.send_header("Referrer-Policy", "no-referrer")
            self.send_header("X-Frame-Options", "DENY")
            self.send_header("Cross-Origin-Resource-Policy", "same-origin")
            for k, v in (extra or {}).items():
                self.send_header(k, v)
            self.end_headers()

        def _send(self, code: int, body, ctype: str = "application/json; charset=utf-8", extra: dict | None = None):
            data = body if isinstance(body, bytes) else (
                json.dumps(body, ensure_ascii=False).encode("utf-8") if not isinstance(body, str) else body.encode("utf-8"))
            self._headers(code, ctype, len(data), extra)
            if self.command != "HEAD":
                self.wfile.write(data)

        def _guard(self, post: bool) -> bool:
            host = (self.headers.get("Host") or "").strip().lower()
            origin = (self.headers.get("Origin") or "").strip().lower()
            hosts = allowed_hosts()
            ok = host in hosts and (not origin or origin in {"http://" + h for h in hosts})
            if (self.headers.get("Sec-Fetch-Site") or "").lower() == "cross-site":
                ok = False
            if post:
                given = self.headers.get("X-Codo-Token") or ""
                # application/octet-stream tylko dla plików (też nie jest „prostym” typem CORS: obca strona go nie wyśle)
                want = ("application/octet-stream" if urllib.parse.urlparse(self.path).path == "/api/upload"
                        else "application/json")
                ok = ok and (self.headers.get("Content-Type") or "").split(";")[0].strip() == want
            else:
                qs = urllib.parse.parse_qs(urllib.parse.urlparse(self.path).query)
                given = (qs.get("t") or [""])[0]
            ok = ok and hmac.compare_digest(given.encode("utf-8", "replace"), token.encode())
            if not ok:
                self._send(403, _L("Brak dostępu. Otwórz adres z tokenem, który pokazał terminal (codo ui)."),
                           "text/plain; charset=utf-8")
            return ok

        def _host_events(self):
            """Zdarzenia gospodarza agentów na żywo (SSE): stan, wpisy, prośby o zgodę."""
            import socket
            if not _host_ensure():
                return self._send(503, {"ok": False, "error": "host"})
            try:
                sock = _host_connect()
                sock.sendall(b'{"cmd": "attach"}\n')
            except (OSError, ValueError):
                return self._send(503, {"ok": False, "error": "host"})
            self._headers(200, "text/event-stream; charset=utf-8", None, {"X-Accel-Buffering": "no"})
            buf = b""
            sock.settimeout(15)
            try:
                while True:
                    try:
                        chunk = sock.recv(65536)
                    except socket.timeout:
                        self.wfile.write(b": ping\n\n")
                        self.wfile.flush()
                        continue
                    if not chunk:
                        self.wfile.write(b"event: down\ndata: {}\n\n")
                        self.wfile.flush()
                        break
                    buf += chunk
                    while b"\n" in buf:
                        line, buf = buf.split(b"\n", 1)
                        if line.strip():
                            self.wfile.write(b"data: " + line + b"\n\n")
                    self.wfile.flush()
            except OSError:
                pass
            finally:
                try:
                    sock.close()
                except OSError:
                    pass
            return None

        def do_GET(self):
            path = urllib.parse.urlparse(self.path).path
            if path in ("/api/file/preview", "/api/file/raw"):      # pliki w rozmowie: podgląd, miniatura, pobranie
                if not self._guard(False):
                    return None
                qs = urllib.parse.parse_qs(urllib.parse.urlparse(self.path).query)
                want = (qs.get("p") or [""])[0]
                if path == "/api/file/raw":
                    return _ui_file_raw(self, want, (qs.get("dl") or [""])[0] == "1")
                code, body = _ui_file_preview(want)
                return self._send(code, body)
            if path.startswith("/api/office/v/"):          # ramka edytora Biura: własny klucz, bez tokenu okna
                return _ui_office_view(self, path, port_ref[0])
            if path.startswith("/api/office/"):            # Biuro i workflowy (te same pliki co Mac)
                if not self._guard(False):
                    return None
                if path == "/api/office/events":
                    ob = _ui_office_bridge(bridge)
                    self._headers(200, "text/event-stream; charset=utf-8", extra={"X-Accel-Buffering": "no"})
                    try:
                        self.wfile.write(b"retry: 1500\n\n")
                        self.wfile.flush()
                        raw = self.headers.get("Last-Event-ID") or ""
                        ob.stream(self.wfile, int(raw) if raw.isdigit() else 0)
                    except (OSError, ValueError):
                        pass
                    return None
                code, body = _ui_office_get(path, urllib.parse.parse_qs(urllib.parse.urlparse(self.path).query))
                return self._send(code, body)
            if path.startswith("/api/changes/"):           # panel Zmiany: przegląd, przyjmij/odrzuć, cofnij, git
                if not self._guard(False):
                    return None
                code, body = _ui_chg_get(path, urllib.parse.parse_qs(urllib.parse.urlparse(self.path).query))
                return self._send(code, body)
            if path not in ("/", "/index.html", "/api/events", "/api/convos", "/api/folders", "/api/info", "/api/host/events",
                            "/api/host/config", "/api/i18n", "/api/hive", "/api/inbox", "/api/license"):
                return self._send(404, b"", "text/plain")
            if not self._guard(False):
                return None
            if path in ("/", "/index.html"):
                nonce = secrets.token_urlsafe(16)
                boot = {"lang": ui_lang(), "version": VERSION, "cwd": str(Path.cwd()),
                        "folder": Path.cwd().name or str(Path.cwd())}
                html = (_ui_page().replace('"__CODO_BOOT__"', json.dumps(boot, ensure_ascii=False).replace("<", "\\u003c"))
                        .replace("__NONCE__", nonce))
                csp = ("default-src 'none'; script-src 'nonce-" + nonce + "'; style-src 'unsafe-inline'; "
                       "img-src data: blob: 'self'; media-src 'self'; connect-src 'self'; frame-src 'self'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'")
                return self._send(200, html, "text/html; charset=utf-8", {"Content-Security-Policy": csp})
            if path == "/api/i18n":
                qs = urllib.parse.parse_qs(urllib.parse.urlparse(self.path).query)
                return self._send(200, _ui_i18n((qs.get("lang") or [""])[0]))
            if path == "/api/host/config":
                return self._send(200, _ui_host_config_read())
            if path == "/api/hive":
                return self._send(200, _ui_hive_read())
            if path == "/api/inbox":
                return self._send(200, _ui_inbox_read())
            if path == "/api/license":
                return self._send(200, _ui_license_read())
            if path == "/api/host/events":
                return self._host_events()
            if path == "/api/folders":
                return self._send(200, _ui_folders())
            if path == "/api/convos":
                want = (urllib.parse.parse_qs(urllib.parse.urlparse(self.path).query).get("folder") or [""])[0]
                where = _ui_folder_known(want) if want else None
                if want and where is None:
                    return self._send(200, {"items": []})
                items = [{"id": d["id"], "title": d.get("custom_title") or d.get("title") or "",
                          "updated": d.get("updated") or 0, "preview": _convo_preview(d)} for d in _convo_list(where)[:80]]
                return self._send(200, {"items": items})
            if path == "/api/info":
                return self._send(200, {"version": VERSION, "pid": os.getpid(), "engine_pid": bridge.engine_pid(),
                                        "compare_pids": compare.pids(),
                                        "cwd": str(Path.cwd()), "lang": ui_lang()})
            # /api/events
            raw_last = self.headers.get("Last-Event-ID") or ""
            last = int(raw_last) if raw_last.isdigit() else 0
            self._headers(200, "text/event-stream; charset=utf-8", extra={"X-Accel-Buffering": "no"})
            sock = self.connection

            def alive() -> bool:
                import select
                import socket
                try:
                    readable, _w, _x = select.select([sock], [], [], 0)
                    return not readable or bool(sock.recv(1, socket.MSG_PEEK))
                except (OSError, ValueError):
                    return False
            bridge.enter()
            try:
                self.wfile.write(b"retry: 1500\n\n")
                self.wfile.flush()
                bridge.stream(self.wfile, last, alive)
            except (OSError, ValueError):
                pass                  # karta zamknięta albo przeładowana
            finally:
                bridge.leave()
            return None

        def do_POST(self):
            path = urllib.parse.urlparse(self.path).path
            if path in ("/api/file/info", "/api/file/attach", "/api/file/open"):   # pliki w rozmowie
                if not self._guard(True):
                    return None
                try:
                    size = int(self.headers.get("Content-Length") or 0)
                    msg = json.loads(self.rfile.read(size).decode("utf-8") or "{}") if 0 < size <= 1 << 20 else None
                except (ValueError, UnicodeDecodeError):
                    msg = None
                if not isinstance(msg, dict):
                    return self._send(400, {"ok": False})
                code, body = _ui_file_post(path, msg)
                return self._send(code, body)
            if path.startswith("/api/office/"):
                if not self._guard(True):
                    return None
                try:
                    size = int(self.headers.get("Content-Length") or 0)
                    msg = json.loads(self.rfile.read(size).decode("utf-8") or "{}") if 0 < size <= 16 << 20 else None
                except (ValueError, UnicodeDecodeError):
                    msg = None
                if not isinstance(msg, dict):
                    return self._send(400, {"ok": False})
                try:
                    code, body = _ui_office_post(path, msg, bridge)
                except OSError as exc:
                    code, body = 500, {"ok": False, "error": str(exc)[:200]}
                return self._send(code, body)
            if path.startswith("/api/changes/"):           # panel Zmiany (treść pliku może być większa niż 1 MB)
                if not self._guard(True):
                    return None
                try:
                    size = int(self.headers.get("Content-Length") or 0)
                    msg = json.loads(self.rfile.read(size).decode("utf-8") or "{}") if 0 <= size <= 16 << 20 else None
                except (ValueError, UnicodeDecodeError):
                    msg = None
                if not isinstance(msg, dict):
                    return self._send(400, {"ok": False})
                try:
                    code, body = _ui_chg_post(path, msg)
                except OSError as exc:
                    code, body = 500, {"ok": False, "error": str(exc)[:200]}
                return self._send(code, body)
            if path not in ("/api/send", "/api/quit", "/api/restart", "/api/host", "/api/host/config", "/api/hive", "/api/inbox",
                            "/api/upload", "/api/compare", "/api/folder", "/api/license"):
                return self._send(404, b"", "text/plain")
            if not self._guard(True):
                return None
            if path == "/api/upload":
                try:
                    size = int(self.headers.get("Content-Length") or 0)
                except ValueError:
                    size = -1
                if size > _UI_UPLOAD_MAX:
                    return self._send(413, {"ok": False, "error": "too_big", "max": _UI_UPLOAD_MAX})
                if size < 0:
                    return self._send(400, {"ok": False, "error": "size"})
                name = urllib.parse.unquote(self.headers.get("X-Codo-Name") or "plik")
                saved = _ui_upload(name, self.rfile.read(size) if size else b"",
                                   urllib.parse.unquote(self.headers.get("X-Codo-Dir") or ""),
                                   self.headers.get("X-Codo-Group") or "")
                return self._send(200 if saved else 400, {"ok": bool(saved), "path": saved or ""})
            try:
                size = int(self.headers.get("Content-Length") or 0)
            except ValueError:
                size = -1
            if size < 0 or size > _UI_MAX_BODY:
                return self._send(413, {"ok": False})
            try:
                msg = json.loads(self.rfile.read(size).decode("utf-8") or "{}") if size else {}
            except (ValueError, UnicodeDecodeError):
                return self._send(400, {"ok": False})
            if not isinstance(msg, dict):
                return self._send(400, {"ok": False})
            if path == "/api/quit":
                self._send(200, {"ok": True})
                threading.Thread(target=on_quit, daemon=True).start()
                return None
            if path == "/api/restart":
                threading.Thread(target=bridge.restart, daemon=True).start()
                return self._send(200, {"ok": True})
            if path == "/api/folder":
                code, body = _ui_open_folder(msg, bridge)
                return self._send(code, body)
            if path == "/api/host":
                if msg.get("cmd") not in _UI_HOST_CMDS:
                    return self._send(400, {"ok": False, "error": "cmd"})
                if not _host_ensure():
                    return self._send(503, {"ok": False, "error": "host"})
                r = _host_call(msg, timeout=30)
                return self._send(200 if r is not None else 503, r if r is not None else {"ok": False})
            if path == "/api/hive":
                ok = _ui_hive_write(msg)
                return self._send(200 if ok else 400, {"ok": ok})
            if path == "/api/inbox":
                return self._send(200, {"ok": _ui_inbox_seen(msg.get("seen"))})
            if path == "/api/license":   # {use: personal|company}: jak „Zgadzam się i kontynuuj” na Macu
                ok = _ui_license_accept(msg.get("use"))
                return self._send(200 if ok else 400, {"ok": ok, **_ui_license_read()})
            if path == "/api/compare":   # Porównaj: {text, targets:[{provider, kind, model, …}]} albo {stop: true}
                if msg.get("stop"):
                    threading.Thread(target=compare.stop, daemon=True).start()
                    return self._send(200, {"ok": True})
                code, body = compare.start(msg.get("text"), msg.get("targets"))
                return self._send(code, body)
            if path == "/api/host/config":
                ok = _ui_host_config_write(str(msg.get("file") or ""), msg.get("data"))
                if ok and _host_call({"cmd": "state"}, timeout=3):
                    _host_call({"cmd": "reload"}, timeout=10)
                return self._send(200 if ok else 400, {"ok": ok})
            if msg.get("type") not in _UI_SEND_TYPES:
                return self._send(400, {"ok": False, "error": "type"})
            ok = bridge.write(msg)
            return self._send(200 if ok else 503, {"ok": ok})


    return Handler


def _app_window_browser() -> str | None:
    """Edge albo Chrome/Chromium, które otworzą Codo jako osobne okno aplikacji (bez pasków przeglądarki).
    Windows: Edge jest w każdym Windows 10 i 11. Linux: pierwszy znaleziony Chromium. Mac ma natywną aplikację."""
    if os.environ.get("CODO_UI_TAB"):
        return None
    if IS_WIN:
        roots = [os.environ.get(k) for k in ("ProgramFiles(x86)", "ProgramFiles", "LOCALAPPDATA")]
        rels = (r"Microsoft\Edge\Application\msedge.exe", r"Google\Chrome\Application\chrome.exe")
        for rel in rels:
            for root in roots:
                if root and Path(root, rel).is_file():
                    return str(Path(root, rel))
        return None
    if sys.platform == "darwin":
        return None
    import shutil
    for name in ("microsoft-edge", "microsoft-edge-stable", "google-chrome", "google-chrome-stable",
                 "chromium", "chromium-browser", "brave-browser"):
        found = shutil.which(name)
        if found:
            return found
    return None


def _app_window_cmd(exe: str, url: str) -> list:
    """Osobny profil: okno Codo ma swoją ikonę na pasku zadań i nie miesza się z kartami użytkownika."""
    if IS_WIN:
        base = Path(os.environ.get("LOCALAPPDATA") or Path.home() / "AppData" / "Local") / "Codo" / "okno"
    else:
        base = Path(os.environ.get("XDG_DATA_HOME") or Path.home() / ".local" / "share") / "codo" / "okno"
    return [exe, f"--app={url}", f"--user-data-dir={base}", "--no-first-run", "--no-default-browser-check",
            "--window-size=1280,860", "--disable-features=Translate"]


def _open_app_window(url: str) -> bool:
    exe = _app_window_browser()
    if not exe:
        return False
    try:
        flags = 0x08000000 if IS_WIN else 0   # CREATE_NO_WINDOW
        subprocess.Popen(_app_window_cmd(exe, url), stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL,
                         stderr=subprocess.DEVNULL, creationflags=flags, start_new_session=not IS_WIN)
        return True
    except OSError:
        return False


def codo_ui(args: list, model: str | None) -> int:
    """codo ui [folder] [--no-browser] [--port N]: okno Codo w przeglądarce (Windows, Linux, Mac)."""
    import secrets
    import time as _time
    no_browser = "--no-browser" in args
    as_tab = "--tab" in args or "--karta" in args
    port = 0
    rest = []
    i = 0
    while i < len(args):
        a = args[i]
        if a == "--port":
            val = args[i + 1] if i + 1 < len(args) else ""
            if not val.isdigit() or not 0 <= int(val) <= 65535:
                print(red(_L("✗ --port: podaj numer portu od 1 do 65535.")))
                return 2
            port = int(val)
            i += 2
            continue
        if a not in ("--no-browser", "--tab", "--karta"):
            if a.startswith("-"):
                print(red(_Lf('✗ Nieznana opcja {0}', a)) + dim(_L("  (codo help)")))
                return 2
            rest.append(a)
        i += 1
    if rest:
        target = Path(os.path.expanduser(rest[0]))
        if not target.is_dir():
            print(red(_Lf('✗ Nie ma takiego folderu: {0}', rest[0])))
            return 1
        os.chdir(target)
        _win_long_cwd()
    if sys.stdin and sys.stdin.isatty() and not trust_workspace():
        return 1
    token = secrets.token_urlsafe(24)
    port_ref = [port]
    bridge = _UiBridge(str(Path(__file__).resolve()), model)
    state = {"server": None}

    def quit_all() -> None:
        bridge.stop()
        srv = state["server"]
        if srv is not None:
            srv.shutdown()

    try:
        server = _http_server(("127.0.0.1", port), _ui_handler(bridge, token, port_ref, quit_all))
    except OSError as exc:
        print(red(_Lf('✗ Nie mogę uruchomić okna na porcie {0}: {1}', port, exc)))
        return 1
    server.daemon_threads = True
    state["server"] = server
    port_ref[0] = server.server_address[1]
    url = f"http://127.0.0.1:{port_ref[0]}/?t={token}"
    try:
        bridge.start()
    except OSError as exc:
        server.server_close()
        print(red(_Lf('✗ Nie mogę uruchomić silnika Codo: {0}', exc)))
        return 1
    try:
        auto_update_start()
    except Exception:
        pass  # nosec B110
    print(bold("Codo") + dim(_L(" w przeglądarce · ")) + str(Path.cwd()))
    print("  " + violet(url), flush=True)
    print(dim(_L("  Ctrl+C kończy. Zamknięcie karty też zatrzymuje Codo po chwili.")), flush=True)
    if not no_browser:
        headless = (not IS_WIN and sys.platform != "darwin"
                    and not (os.environ.get("DISPLAY") or os.environ.get("WAYLAND_DISPLAY")))
        if headless:
            print(dim(_L("  Brak ekranu graficznego: otwórz adres w przeglądarce na tym komputerze.")), flush=True)
        elif as_tab or not _open_app_window(url):
            import webbrowser
            threading.Thread(target=lambda: webbrowser.open(url), daemon=True).start()

    grace = 45.0
    try:
        grace = max(0.5, float(os.environ.get("CODO_UI_GRACE") or 45))
    except ValueError:
        pass

    def watchdog() -> None:
        while not bridge.closing:
            _time.sleep(0.5)
            if bridge.idle_for() > grace:
                quit_all()
                return

    threading.Thread(target=watchdog, daemon=True).start()
    import signal

    def on_signal(*_a) -> None:
        threading.Thread(target=quit_all, daemon=True).start()
    for name in ("SIGTERM", "SIGHUP", "SIGBREAK"):
        sig = getattr(signal, name, None)
        if sig is not None:
            try:
                signal.signal(sig, on_signal)
            except (ValueError, OSError):
                pass
    try:
        server.serve_forever(poll_interval=0.5)
    except KeyboardInterrupt:
        print()
    finally:
        bridge.stop()
        server.server_close()
    print(dim(_L("  Codo w przeglądarce zamknięte.")), flush=True)
    return 0


