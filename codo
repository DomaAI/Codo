def _group_print_ev(kind: str, d: dict) -> None:
    if kind == "group_member":
        m = d["member"]
        st = m.get("status")
        if st in ("done", "failed", "skipped", "stopped", "queued") or (st == "working" and m.get("doing") == _L("Myśli")):
            mark = {"done": green("✓"), "failed": red("✗"), "skipped": yellow("–"), "stopped": yellow("■"),
                    "queued": dim("…"), "working": violet("▶")}.get(st, "•")
            extra = m.get("reason") or (m.get("doing") if st == "queued" else "")
            cost = f" · {m['spent_kr']} 𝔻" if m.get("spent_kr") else ""
            secs = f" · {m['seconds']:.0f} s" if st == "done" else ""
            print(f"  {mark} {m['name']} {dim('(' + m.get('brain_label', '') + ')')}{dim(secs + cost)}"
                  + (dim(f"  {extra}") if extra else ""))
    elif kind == "group_phase":
        print(bold(f"\n· {d.get('title')}"))
    elif kind == "group_note":
        print(dim("  " + str(d.get("tekst") or "")))
    elif kind == "group_result" and d.get("text"):
        print(bold("\n" + _L("Wynik grupy")) + dim(f"  ({d.get('kind')})"))
        if d.get("votes"):
            print(dim("  " + _L("Głosy") + ": " + ", ".join(f"{k} {v}" for k, v in d["votes"].items())))
        print(d["text"])
    elif kind == "group_done":
        print(dim(f"\n{_L('Koniec')}: {d.get('status')} · {d.get('seconds', 0):.0f} s · {d.get('spent_kr', 0)} 𝔻")
              + (dim("  " + d["note"]) if d.get("note") else ""))


def cmd_group(argv: list) -> int:
    """codo grupa | codo group: nazwane grupy agentów z różnych dostawców."""
    a = list(argv)
    sub = a[0] if a else "list"
    rest = a[1:]
    if sub in ("list", "lista", "ls"):
        groups = _group_list()
        if not groups:
            print(dim(_L("Nie masz jeszcze grup. Utwórz: codo grupa nowa \"Nazwa\" agent:codex agent:claude --sposob vote")))
            return 0
        for g in groups:
            print(bold(g["name"]) + dim(f"  {_L(_GROUP_STRATEGIES[g['strategy']])} · {len(g['members'])} " + _L("członków")))
            for m in g["members"]:
                lead = " ★" if m["id"] == g["lead"] else ""
                print(f"  {m['name']}{lead} " + dim(f"({brain_label(m['brain'] or current_model(None))})"
                                                  + (f" · {m['role']}" if m.get("role") else "")))
        return 0
    if sub in ("strategie", "sposoby"):
        for k, v in _GROUP_STRATEGIES.items():
            print(f"{k:10} {_L(v)}")
        return 0
    if sub in ("nowa", "new", "add"):
        if not rest:
            print(red(_L("✗ Podaj nazwę grupy i mózgi członków.")))
            return 2
        name, strategy, members, i = rest[0], "parallel", [], 1
        while i < len(rest):
            x = rest[i]
            if x in ("--sposob", "--sposób", "--strategy") and i + 1 < len(rest):
                strategy, i = rest[i + 1], i + 2
                continue
            brain, _, mname = x.partition("=")
            members.append({"name": mname or brain_label(brain), "brain": brain})
            i += 1
        g, err = _group_save({"name": name, "strategy": strategy, "members": members})
        if err:
            print(red("✗ " + err))
            return 2
        print(green("✓ ") + _Lf("Grupa «{0}» zapisana ({1}).", g["name"], _L(_GROUP_STRATEGIES[g["strategy"]])))
        return 0
    if sub in ("usun", "usuń", "delete", "rm"):
        ok = bool(rest) and _group_delete(rest[0])
        print(green("✓ " + _L("Usunięto.")) if ok else red("✗ " + _L("Nie ma takiej grupy.")))
        return 0 if ok else 1
    if sub in ("biegi", "runs"):
        for r in _group_runs_list():
            print(f"{r['run_id']}  {r['group']}  {r['status']}  " + dim(r["task"][:60]))
        return 0
    if sub in ("run", "start", "uruchom"):
        flags = {}
        pos = []
        i = 0
        while i < len(rest):
            if rest[i] in ("--sposob", "--sposób", "--strategy", "--rundy", "--rounds") and i + 1 < len(rest):
                flags[rest[i].lstrip("-")] = rest[i + 1]
                i += 2
                continue
            pos.append(rest[i])
            i += 1
        if len(pos) < 2:
            print(red(_L("✗ Użycie: codo grupa run \"Nazwa\" \"zadanie\"")))
            return 2
        g, err = _group_resolve({"group": pos[0]})
        if err:
            print(red("✗ " + err))
            return 2
        st = flags.get("sposob") or flags.get("sposób") or flags.get("strategy")
        if st in _GROUP_STRATEGIES:
            g["strategy"] = st
        r = flags.get("rundy") or flags.get("rounds")
        if r and r.isdigit():
            g["limits"]["rounds"] = max(1, min(int(r), 5))
        print(bold(g["name"]) + dim(f"  {_L(_GROUP_STRATEGIES[g['strategy']])}"))
        run = GroupRun(g, " ".join(pos[1:]), Path.cwd(), emit=_group_print_ev, source={"kind": "terminal"})
        try:
            st = run.go()
        except KeyboardInterrupt:
            run.stop()
            return 130
        return 0 if st.get("status") in ("done", "handoff") else 1
    print(red(_Lf("✗ Nieznana komenda grupy: {0}", sub)) + dim("  (codo grupa list | nowa | run | usun | biegi)"))
    return 2


def cmd_team(argv: list) -> int:
    """codo team | codo zespol: zespoły agentów w tym folderze."""
    a = [x for x in argv if x not in ("--yes", "-y")]
    yes = len(a) != len(argv)
    sub = a[0] if a else ""
    rest = a[1:]
    if sub == "supervise":
        if "--dir" not in rest or rest.index("--dir") + 1 >= len(rest):
            return 2
        return team_supervise(Path(rest[rest.index("--dir") + 1]))
    if not sub:
        return _team_overview()
    if sub in ("run", "start"):
        return _team_cmd_run(rest, yes)
    if sub in ("szablony", "templates"):
        return _team_cmd_templates(rest)
    if sub not in ("status", "log", "stop", "pause", "resume", "apply", "clean", "answer", "say", "plan", "merge"):
        print(red(_Lf("✗ Nieznana komenda zespołu: {0}", sub)) + dim(_L("  (codo team)")))
        return 2
    flags = [x for x in rest if x.startswith("-")]
    pos = [x for x in rest if not x.startswith("-")]
    run_dir, err = _team_find(pos[0] if pos else None)
    if err:
        print(red("✗ " + err))
        return 1
    rid = run_dir.name
    store = TeamStore(run_dir)
    if sub == "status":
        return _team_status(run_dir, "--json" in flags)
    if sub == "log":
        if "-f" in flags or "--follow" in flags:
            return _team_follow(run_dir, interactive=False, answer=False)
        names: dict = {"human": _L("Ty"), "all": _L("wszyscy")}
        for ev in store.events():
            line = _team_event_line(ev, names)
            if line:
                print(line)
            if ev.get("type") == "team_done":
                _team_print_done(ev, rid)
        return 0
    if sub in ("stop", "pause"):
        run = store.load_run()
        if _team_sup_alive(run):
            store.control(type=sub, by="terminal")
            print(dim(_L("  Polecenie wysłane do nadzorcy.")))
        elif sub == "stop" and run.get("status") in _TEAM_RESUMABLE:
            run["status"] = "stopped"
            store.save_run(run)
            print(dim(_L("  Zespół oznaczony jako zatrzymany.")))
        else:
            print(dim(_Lf("  Nadzorca nie działa (stan: {0}).", run.get("status"))))
        return 0
    if sub == "resume":
        err = _team_resume(run_dir)
        if err:
            print(red("✗ " + err))
            return 1
        print(green(_Lf("✓ Zespół {0} wznowiony.", rid)))
        if "--bg" in flags:
            return 0
        import time
        time.sleep(0.5)
        return _team_follow(run_dir, interactive=bool(sys.stdin and sys.stdin.isatty()))
    if sub == "apply":
        how = "branch" if "--branch" in flags else "pr" if "--pr" in flags else "merge"
        ev = team_apply(run_dir, how, by="terminal")
        print((green("✓ ") if ev.get("ok") else red("✗ ")) + str(ev.get("detail")))
        return 0 if ev.get("ok") else 1
    if sub == "clean":
        res = team_cleanup(run_dir, "--zostaw-galezie" in flags or "--keep-branches" in flags)
        print((green("✓ ") if res["ok"] else red("✗ ")) + res["detail"])
        return 0 if res["ok"] else 1
    if sub == "answer":
        if len(pos) < 3:
            print(red(_L("✗ Użycie: codo team answer ID ASK t|n|z")))
            return 2
        v = pos[2].lower()
        store.control(type="answer", ask_id=pos[1], value=1 if v in ("t", "tak", "y", "1") else 2 if v in ("z", "2") else 0,
                      by="terminal")
        return 0
    if sub in ("plan", "merge"):
        need = 2 if sub == "plan" else 3
        if len(pos) < need:
            print(red(_L("✗ Użycie: codo team plan ID ok|nie|\"uwagi\" · codo team merge ID ZADANIE ok|nie|\"uwagi\"")))
            return 2
        ans = " ".join(pos[need - 1:]).strip()
        ok = ans.lower() in ("t", "tak", "y", "yes", "ok")
        notes = "" if ok or ans.lower() in ("n", "nie", "no") else ans
        if sub == "plan":
            store.control(type="plan_decide", approve=ok, notes=notes, by="terminal")
        else:
            store.control(type="merge_decide", task_id=pos[1], approve=ok, notes=notes, by="terminal")
        print(dim(_L("  Polecenie wysłane do nadzorcy.")))
        return 0
    if len(pos) < 3:   # say
        print(red(_L("✗ Użycie: codo team say ID KOMU \"tekst\"")))
        return 2
    err = _team_say(store, pos[1], " ".join(pos[2:]), by="terminal")
    print(red("✗ " + err) if err else green(_L("✓ Wysłano.")))
    return 1 if err else 0


def _team_cmd_run(rest: list, yes: bool) -> int:
    opts: dict = {"--szablon": None, "--budget": None, "--hours": None, "--rownolegle": None, "--tryb": None,
                  "--check": None, "--template": None, "--parallel": None, "--mode": None, "--z-kanalu": None,
                  "--odpowiedz-do": None, "--from-channel": None, "--reply-to": None}
    members, goal_parts, bg, shared = [], [], False, False
    i = 0
    while i < len(rest):
        x = rest[i]
        if x in ("--czlonek", "--member") and i + 1 < len(rest):
            m = _team_parse_member(rest[i + 1])
            if not m:
                print(red(_Lf("✗ --czlonek \"id:mózg:rola[:pisze]\", nie: {0}", rest[i + 1])))
                return 2
            members.append(m)
            i += 2
        elif x in opts and i + 1 < len(rest):
            opts[x] = rest[i + 1]
            i += 2
        elif x == "--bg":
            bg, i = True, i + 1
        elif x in ("--bez-kopii", "--no-copies"):
            shared, i = True, i + 1
        elif x.startswith("--"):
            print(red(_Lf("✗ Nieznana opcja {0}", x)) + dim(_L("  (codo team)")))
            return 2
        else:
            goal_parts.append(x)
            i += 1
    goal = " ".join(goal_parts).strip()
    if not goal:
        print(red(_L('Podaj cel: codo team run "dodaj koszyk do sklepu"')))
        return 1
    if not (load_creds() or load_device() or load_maddlabs() or load_endpoint() or agents_available()):
        print(red(_L("✗ To urządzenie nie jest zalogowane.")) + dim(_L(" Uruchom: codo login")))
        return 1
    tpl, err = _team_template_get(opts["--szablon"] or opts["--template"] or "para")
    if err:
        print(red("✗ " + err))
        return 1
    if members:
        tpl["members"] = members
    over: dict = {"mode": "auto" if yes else (opts["--tryb"] or opts["--mode"]), "check": opts["--check"]}
    try:
        if opts["--budget"]:
            over["budget_kr"] = max(1, int(opts["--budget"]))
        if opts["--hours"]:
            over["hours"] = float(str(opts["--hours"]).replace(",", "."))
        if opts["--rownolegle"] or opts["--parallel"]:
            over["parallel"] = int(opts["--rownolegle"] or opts["--parallel"])
    except ValueError:
        print(red(_L("✗ --budget, --hours i --rownolegle wymagają liczby")))
        return 2
    channel = opts["--z-kanalu"] or opts["--from-channel"]
    source = {"kind": "kanal", "channel": channel, "reply_to": opts["--odpowiedz-do"] or opts["--reply-to"] or ""} \
        if channel else {"kind": "terminal"}
    run_dir, err = _team_create_run(Path.cwd(), goal, tpl, over, source, shared=shared)
    if err:
        print(red("✗ " + err))
        return 1
    _team_spawn_supervisor(run_dir)
    run = TeamStore(run_dir).load_run()
    print(green(_Lf("✓ Zespół {0} rusza", run_dir.name)) + dim(f" · {run['title']} · " + ", ".join(
        f"{m['name']} ({m['brain_label']})" for m in run["members"])))
    if not run.get("git"):
        print(yellow(_L("  Bez kopii git: członkowie pracują we wspólnym folderze.")))
    if bg:
        print(dim(_Lf("  codo team status {0} · codo team log {0} -f · codo team stop {0}", run_dir.name)))
        if not yes:
            print(yellow(_L("  Bez --yes zgody czekają na Ciebie: codo team status pokaże, o co pytają.")))
        return 0
    return _team_follow(run_dir, interactive=bool(sys.stdin and sys.stdin.isatty()))


def _team_slash(arg: str, auto_yes: bool) -> int:
    """/zespol "cel" albo /zespol SZABLON cel w rozmowie: to samo co codo team run (na pierwszym planie)."""
    words = arg.split()
    name = words[0] if len(words) > 1 and not _team_template_get(words[0])[1] else ""
    goal = (arg.strip()[len(name):] if name else arg).strip().strip('"„”').strip()
    if not goal:
        return _team_overview()
    return _team_cmd_run([goal] + (["--szablon", name] if name else []), auto_yes)


def _team_cmd_templates(rest: list) -> int:
    scope = "global" if "--globalnie" in rest or "--global" in rest else "project"
    pos = [x for x in rest if not x.startswith("-")]
    sub = pos[0] if pos else ""
    if not sub:
        return _team_overview()
    name = pos[1] if len(pos) > 1 else ""
    if sub in ("pokaz", "show"):
        tpl, err = _team_template_get(name)
        print(red("✗ " + err) if err else json.dumps(tpl, ensure_ascii=False, indent=2))
        return 1 if err else 0
    if sub in ("nowy", "new"):
        if not name:
            print(red(_L("✗ Podaj nazwę: codo team szablony nowy NAZWA")))
            return 2
        base = json.loads(json.dumps(_TEAM_BUILTINS["para"]))
        base.update(name=name, title=name, description="")
        path, err = _team_template_save(base, scope)
        print(red("✗ " + err) if err else green(_Lf("✓ Zapisano szablon {0}", path)) + dim(_L(" (edytuj skład w tym pliku)")))
        return 1 if err else 0
    if sub in ("usun", "usuń", "rm"):
        p = _team_tpl_dirs()[scope] / f"{_slug(name)}.json"
        if not p.exists():
            print(red(_Lf("✗ Nie ma szablonu {0} ({1})", name, scope)))
            return 1
        p.unlink()
        print(green(_Lf("✓ Usunięto szablon {0}", name)))
        return 0
    print(red(_L("✗ Użycie: codo team szablony [pokaz|nowy|usun NAZWA] [--globalnie]")))
    return 2


