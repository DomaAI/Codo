# Paleta koniczyny z logo (iOS/web: PALETA_CIEMNA, rola koniczyny + połysk).
_CLOVER_RGB = ((0x7f, 0x45, 0xc8), (0xa8, 0x6a, 0xf0), (0xd0, 0xae, 0xff),
               (0xeb, 0xdd, 0xff), (0xd0, 0xae, 0xff), (0xa8, 0x6a, 0xf0))
_CLOVER_256 = (98, 135, 141, 183, 189, 183, 141, 135)
# Klatki: listki koniczyny rosną od pąka do pełnego znaku (✥ = cztery listki).
# Windows: ♣ jest w każdej czcionce konsoli (CP437), dingbaty ✢–✥ nie zawsze.
_CLOVER_FRAMES = ("·", "∙", "✢", "✣", "✣", "✣", "✢", "∙") if not IS_WIN else \
    ("·", "∙", "•", "♣", "♣", "♣", "•", "∙")
_CLOVER_MARK = "✣" if not IS_WIN else "♣"


def _rgb(rgb: tuple, s: str) -> str:
    if _truecolor():
        return _c("38;2;%d;%d;%d" % rgb, s)
    # przybliżenie 256 kolorów (sześcian 6×6×6)
    r, g, b = (round(v / 255 * 5) for v in rgb)
    return _c(f"38;5;{16 + 36 * r + 6 * g + b}", s)


def _clover(tick: int) -> str:
    """Pulsująca koniczyna jak pętla „myślenia” znaku w apce."""
    frame = _CLOVER_FRAMES[tick % len(_CLOVER_FRAMES)]
    rgb = _CLOVER_RGB[(tick // 2) % len(_CLOVER_RGB)]
    return _rgb(rgb, frame)


def _shimmer(text: str, tick: int) -> str:
    """Połysk przesuwający się po napisie (skan z animacji logo)."""
    if not _tty() or "NO_COLOR" in os.environ:
        return text
    base, glow, peak = (0xa8, 0x6a, 0xf0), (0xd0, 0xae, 0xff), (0xf6, 0xee, 0xff)
    n = len(text)
    head = tick % (n + 12) - 4
    out = []
    for i, ch in enumerate(text):
        d = abs(i - head)
        out.append(_rgb(peak if d == 0 else glow if d <= 2 else base, ch))
    return "".join(out)


def _duration(seconds: float) -> str:
    s = int(seconds)
    if s < 60:
        return f"{s}s"
    if s < 3600:
        return f"{s // 60}m {s % 60}s"
    return f"{s // 3600}h {s % 3600 // 60}m"


def _tokens_label(n: int) -> str:
    return f"{n / 1000:.1f}k" if n >= 1000 else str(n)


class _Keys:
    """Klawiatura bez echa i bez Entera: termios (macOS/Linux), msvcrt (Windows).
    Wklejanie (bracketed paste) przychodzi jako jeden klucz „\\x1b[200~treść”."""

    PASTE = "\x1b[200~"

    def __init__(self):
        self.fd = None
        self.old = None

    def __enter__(self):
        if not IS_WIN:
            import termios
            import tty
            self.fd = sys.stdin.fileno()
            self.old = termios.tcgetattr(self.fd)
            # TCSANOW, nie domyślne TCSAFLUSH: klawisze wpisane, zanim okno
            # pisania przejęło klawiaturę, nie mogą przepaść.
            tty.setcbreak(self.fd, termios.TCSANOW)
            sys.__stdout__.write("\033[?2004h")
            sys.__stdout__.flush()
        return self

    def __exit__(self, *exc):
        if not IS_WIN and self.old is not None:
            import termios
            sys.__stdout__.write("\033[?2004l")
            sys.__stdout__.flush()
            termios.tcsetattr(self.fd, termios.TCSADRAIN, self.old)
            self.old = None
        return False

    def read(self, timeout: float | None = None) -> str | None:
        if IS_WIN:
            return self._read_win(timeout)
        import select
        if timeout is not None and not select.select([self.fd], [], [], timeout)[0]:
            return None
        key = _read_terminal_key(self.fd)
        if key == self.PASTE:
            data = b""
            while not data.endswith(b"\x1b[201~") and len(data) < 2_000_000:
                if not select.select([self.fd], [], [], 0.5)[0]:
                    break
                data += os.read(self.fd, 65536)
            text = data.decode("utf-8", "replace")
            if text.endswith("\x1b[201~"):
                text = text[:-6]
            return self.PASTE + text
        return key

    def _read_win(self, timeout):
        import msvcrt
        import time as _time
        end = None if timeout is None else _time.monotonic() + timeout
        while not msvcrt.kbhit():
            if end is not None and _time.monotonic() >= end:
                return None
            _time.sleep(0.01)
        ch = msvcrt.getwch()
        if ch in ("\x00", "\xe0"):
            code = msvcrt.getwch()
            return {"H": "\x1b[A", "P": "\x1b[B", "K": "\x1b[D", "M": "\x1b[C",
                    "G": "\x1b[H", "O": "\x1b[F", "S": "\x1b[3~", "\x0f": "\x1b[Z",
                    "s": "\x1b[1;5D", "t": "\x1b[1;5C"}.get(code, "")
        if ch == "\r" and msvcrt.kbhit():
            # Wklejka w konsoli Windows: znaki lecą seriami — zbierz całość,
            # żeby Enter z wklejonego tekstu nie wysłał wiadomości w połowie.
            text = "\n"
            while msvcrt.kbhit():
                c = msvcrt.getwch()
                text += "\n" if c == "\r" else c
            return self.PASTE + text
        return ch


