    pinned = os.environ.get("CODO_PROVIDER")
    if pinned in ("domaai", "maddlabs", "endpoint", "agent"):
        return pinned   # okno Codo: równoległy przebieg u innego dostawcy, bez zmiany ustawień
    ml = load_maddlabs()
    chosen = load_settings().get("provider")
