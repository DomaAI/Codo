def _team_system_block() -> str:
    d, me = os.environ.get("CODO_ZESPOL_DIR"), os.environ.get("CODO_ZESPOL_CZLONEK")
    if not d or not me:
        return ""
    run = TeamStore(d).load_run()
    m = next((x for x in run.get("members") or [] if x.get("id") == me), None)
    if not m:
        return ""
    roster = "\n".join(f"- {x['id']}: {x['name']}, {x.get('role') or ''}" + ("" if x.get("writes", True) else ", tylko odczyt")
                       for x in run.get("members") or [])
    note = {"copy": " To Twoja własna kopia projektu (gałąź git); inni pracują w swoich.",
            "integration": " To kopia integracyjna: trafiają tu scalone zmiany całego zespołu.",
            "readonly": " Tylko czytasz (kopia integracyjna zespołu).",
            "shared": " Folder jest wspólny dla całego zespołu: ruszaj tylko pliki swojego zadania."}.get(m.get("isolation"), "")
    extra = (_TEAM_SYSTEM_LEAD if m.get("role") == "lead" else "")
    if m.get("tools") == "mcp":
        extra += "\n- Narzędzia team_* masz na serwerze MCP „zespol” (np. mcp__zespol__team_task_update)."
    elif m.get("tools") == "text":
        extra += "\n- Nie masz narzędzi team_*: tablicę obsługuje blok ```zespol na końcu odpowiedzi (opis w poleceniu)."
    if m.get("instructions"):
        extra += "\nTwoje instrukcje: " + str(m["instructions"])[:4000]
    return _TEAM_SYSTEM.format(id=me, name=m.get("name") or me, role=m.get("role") or "", goal=run.get("goal") or "",
                               roster=roster, cwd=m.get("cwd") or "", copy_note=note, extra=extra)


