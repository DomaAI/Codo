def _ui_hive_write(data) -> bool:
    """Zapis z okna: tylko listy bots/swarms ze słownikami, reszta pliku (klucze, których okno nie zna) zostaje."""
    if not isinstance(data, dict):
        return False
    bots, swarms = data.get("bots"), data.get("swarms")
    if not isinstance(bots, list) or not all(isinstance(b, dict) and b.get("id") for b in bots):
        return False
    if swarms is not None and (not isinstance(swarms, list) or not all(isinstance(x, dict) for x in swarms)):
        return False
    d = _ui_hive_read()
    d["bots"] = bots
    if swarms is not None:
        d["swarms"] = swarms
    _atomic_write(HIVE_FILE, json.dumps(d, ensure_ascii=False, indent=1, sort_keys=True).encode("utf-8"))
    return True


