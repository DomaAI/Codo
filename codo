_UI_STICKY = ("models", "model", "mode", "status", "limits", "effort", "context", "team_state")
_UI_MAX_BODY = 1 << 20


class _UiBridge:
    """Most między stroną a jednym potomnym `codo app-server` (jedna rozmowa naraz, jak okno na Maca)."""

    def __init__(self, script: str, model: str | None):
        self.script, self.model = script, model
        self.cond = threading.Condition()
        self.wlock = threading.Lock()
        self.events: list = []        # (seq, rodzaj, linia JSON); od „ready” bieżącego silnika
        self.seq = 0
        self.gen = 0
        self.proc = None
        self.err_tail: list = []
        self.clients = 0
        self.ever = False
        self.left_at = 0.0
        self.closing = False

    # ── silnik ──
    def start(self) -> None:
        env = dict(os.environ)
        # Dziecko pisze i czyta UTF-8 także na Windows (cp1250/cp1252 w konsoli), bez kolorów ANSI.
        env.update({"PYTHONIOENCODING": "utf-8", "PYTHONUTF8": "1", "PYTHONUNBUFFERED": "1", "NO_COLOR": "1",
                    "CODO_CLIENT": "web", "CODO_LANG": ui_lang()})
        env.update(getattr(self, "extra_env", None) or {})   # pomocnik porównania (_UiCompare): przypięty dostawca
        cmd = [*_self_cmd(self.script)] + (["--model", self.model] if self.model else []) + ["app-server"]
        kw: dict = {}
        if IS_WIN:
            # Własna grupa procesów: Ctrl+C w konsoli nie przerywa silnika w pół zdania, sprzątamy sami.
            kw["creationflags"] = getattr(subprocess, "CREATE_NEW_PROCESS_GROUP", 0x200)
        else:
            kw["start_new_session"] = True
        proc = subprocess.Popen(cmd, cwd=str(getattr(self, "cwd", None) or Path.cwd()), env=env, stdin=subprocess.PIPE,  # nosec B603
                                stdout=subprocess.PIPE, stderr=subprocess.PIPE, **kw)
        with self.cond:
            self.gen += 1
            self.proc = proc
            self.err_tail = []
            self.events = []          # nowy silnik = nowa rozmowa; strona czyści widok po „ready”
            gen = self.gen
        threading.Thread(target=self._read_out, args=(proc, gen), daemon=True).start()
        threading.Thread(target=self._read_err, args=(proc,), daemon=True).start()

    def _read_out(self, proc, gen: int) -> None:
        for raw in iter(proc.stdout.readline, b""):
            line = raw.decode("utf-8", "replace").strip()
            if not line:
                continue
            try:
                kind = str(json.loads(line).get("type") or "")
            except (ValueError, AttributeError):
                continue              # na stdout idzie tylko JSON; resztę pomijamy
            self.push(kind, line)
            if kind == "ready":
                # Każda karta (także otwarta później) dostaje modele, stan konta i saldo z bufora zdarzeń.
                for ask in ("models", "status", "limits"):
                    self.write({"type": ask})
        rc = proc.wait()
        with self.cond:
            stale = gen != self.gen or self.closing
        if not stale:
            tail = [x for x in self.err_tail if x.strip()]
            detail = next((x for x in reversed(tail) if "✗" in x), tail[-1] if tail else "")
            self.push("ui_engine_exit", json.dumps({"type": "ui_engine_exit", "code": rc,
                                                    "detail": detail.replace("✗", "").strip()[:400]},
                                                   ensure_ascii=False))

    def _read_err(self, proc) -> None:
        for raw in iter(proc.stderr.readline, b""):
            text = re.sub(r"\x1b\[[0-?]*[ -/]*[@-~]", "", raw.decode("utf-8", "replace")).rstrip()
            with self.cond:
                self.err_tail = (self.err_tail + [text])[-40:]

    def push(self, kind: str, line: str) -> None:
        with self.cond:
            self.seq += 1
            ready = next((e for e in self.events if e[1] == "ready"), None)
            if kind in ("cleared", "resumed"):
                # Nowa albo wznowiona rozmowa: stara treść nie jest już potrzebna nowej karcie.
                keep, seen = [], set()
                for e in reversed(self.events):
                    if e[1] in _UI_STICKY and e[1] not in seen:
                        seen.add(e[1])
                        keep.append(e)
                self.events = ([ready] if ready else []) + sorted(keep)
            elif len(self.events) > 8000:
                self.events = ([ready] if ready else []) + [e for e in self.events[-6000:] if e is not ready]
            self.events.append((self.seq, kind, line))
            self.cond.notify_all()

    def write(self, msg: dict) -> bool:
        kind = msg.get("type")
        if kind == "send":
            text = str(msg.get("text") or "").strip()
            if not text:
                return True
            self.push("ui_user", json.dumps({"type": "ui_user", "tekst": text}, ensure_ascii=False))
        elif kind == "answer":
            self.push("ui_answer", json.dumps({"type": "ui_answer", "id": str(msg.get("id") or ""),
                                               "value": int(msg.get("value") or 0)}))
        data = (json.dumps(msg, ensure_ascii=True) + "\n").encode("ascii")
        with self.wlock:
            p = self.proc
            if p is None or p.poll() is not None:
                return False
            try:
                p.stdin.write(data)
                p.stdin.flush()
            except (OSError, ValueError):
                return False
        return True

    @staticmethod
    def _kill(p) -> None:
        if p is None or p.poll() is not None:
            return
        try:
            p.stdin.write(b'{"type": "interrupt"}\n')
            p.stdin.flush()
            p.stdin.close()           # koniec wejścia = app-server sam kończy pracę
        except (OSError, ValueError):
            pass
        try:
            p.wait(5)
            return
        except subprocess.TimeoutExpired:
            pass
        if IS_WIN:
            # Całe drzewo (komendy agenta też); bez sygnałów POSIX.
            subprocess.run(["taskkill", "/PID", str(p.pid), "/T", "/F"],  # nosec B603 B607
                           stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, check=False)
        else:
            import signal
            try:
                os.killpg(p.pid, signal.SIGTERM)   # własna sesja: grupa = silnik i jego komendy
            except OSError:
                p.terminate()
        try:
            p.wait(3)
        except subprocess.TimeoutExpired:
            p.kill()
            try:
                p.wait(3)
            except subprocess.TimeoutExpired:
                pass

    def restart(self) -> None:
        with self.cond:
            self.gen += 1             # stary silnik kończy się po cichu, bez karty błędu
            old = self.proc
        self._kill(old)
        self.start()

    def stop(self) -> None:
        with self.cond:
            self.closing = True
            p = self.proc
            self.cond.notify_all()
        self._kill(p)

    def engine_pid(self) -> int:
        p = self.proc
        return p.pid if p is not None and p.poll() is None else 0

    # ── słuchacze (karty przeglądarki) ──
    def enter(self) -> None:
        with self.cond:
            self.clients += 1
            self.ever = True

    def leave(self) -> None:
        import time as _t
        with self.cond:
            self.clients -= 1
            if self.clients <= 0:
                self.left_at = _t.monotonic()

    def idle_for(self) -> float:
        import time as _t
        with self.cond:
            if not self.ever or self.clients > 0:
                return 0.0
            return _t.monotonic() - self.left_at

    def after(self, last: int) -> list:
        i = len(self.events)
        while i > 0 and self.events[i - 1][0] > last:
            i -= 1
        return self.events[i:]

    def stream(self, out, last: int, alive=None) -> None:
        """Server-Sent Events: zaległe zdarzenia jako „replay”, potem na żywo; ping co 15 s.
        `alive()` co 2 s sprawdza, czy karta nie zamknęła połączenia (zamknięcie karty = koniec po chwili)."""
        import time as _t
        with self.cond:
            snap = self.seq
        quiet = _t.monotonic()
        while True:
            with self.cond:
                batch = [] if self.closing else self.after(last)
                if not batch and not self.closing:
                    self.cond.wait(2)
                    batch = [] if self.closing else self.after(last)
                closing = self.closing
            if closing:
                out.write(b"event: bye\ndata: {}\n\n")
                out.flush()
                return
            if batch:
                chunk = []
                for seq, _kind, line in batch:
                    chunk.append(("event: replay\n" if seq <= snap else "") + f"id: {seq}\ndata: {line}\n\n")
                last = batch[-1][0]
                out.write("".join(chunk).encode("utf-8"))
                out.flush()
                quiet = _t.monotonic()
            elif alive is not None and not alive():
                return
            elif _t.monotonic() - quiet > 15:
                out.write(b": ping\n\n")
                out.flush()
                quiet = _t.monotonic()


# Porównaj (jak OpinionRun na Macu): ta sama wiadomość idzie do 1..4 modeli naraz, każdy w osobnym
# `codo app-server` przypiętym do swojego dostawcy, tylko do odczytu, bez historii i lustra sesji. Główny silnik
# milczy. Zdarzenia pomocników wracają do okna strumieniem głównego mostu jako {"type": "compare", "id", "run",
# "event"} (też po przeładowaniu karty), a po swojej turze każdy pomocnik się kończy.
_UI_COMPARE_FORWARD = ("ready", "turn_start", "delta", "assistant", "tool_start", "tool", "info", "error", "state",
                       "fallback", "turn_end", "ui_engine_exit")


class _UiCompareRun(_UiBridge):
    def __init__(self, owner, cid: str, run: int, target: dict, text: str):
        super().__init__(owner.main.script, str(target.get("model") or "") or None)
        kind = str(target.get("kind") or "")
        pin = "endpoint" if kind == "account" else kind
        self.extra_env = {"CODO_APP_MODE": "read", "CODO_NO_HISTORY": "1", "CODO_APP_LOCAL_ONLY": "1",
                          "DOMA_NO_SYNC": "1"}
        if pin in ("domaai", "maddlabs", "endpoint", "agent"):
            self.extra_env["CODO_PROVIDER"] = pin
        self.owner, self.cid, self.run, self.text, self.over = owner, cid, run, text, False

    def write(self, msg: dict) -> bool:
        if msg.get("type") in ("models", "status", "limits"):
            return True               # pomocnik nie potrzebuje listy modeli ani salda (ma je główny silnik)
        return super().write(msg)

    def push(self, kind: str, line: str) -> None:
        if kind == "ready" and self.text:
            text, self.text = self.text, ""
            threading.Thread(target=self.write, args=({"type": "send", "text": text},), daemon=True).start()
        if kind == "ask":   # tylko do odczytu: o nic nie pyta, a gdyby jednak, odpowiedź „nie”
            try:
                self.write({"type": "answer", "id": str(json.loads(line).get("id") or ""), "value": 0})
            except ValueError:
                pass
            return
        if kind not in _UI_COMPARE_FORWARD or self.over:
            return
        try:
            ev = json.loads(line)
        except ValueError:
            return
        self.owner.main.push("compare", json.dumps({"type": "compare", "id": self.cid, "run": self.run, "event": ev},
                                                   ensure_ascii=False))
        if kind in ("turn_end", "ui_engine_exit"):
            self.over = True
            threading.Thread(target=self.stop, daemon=True).start()


class _UiCompare:
    MAX = 4

    def __init__(self, main: _UiBridge):
        self.main, self.lock, self.runs, self.cid = main, threading.Lock(), [], ""

    def start(self, text: str, targets: list) -> tuple:
        import uuid
        text = str(text or "").strip()
        targets = [t for t in (targets or []) if isinstance(t, dict) and str(t.get("model") or "").strip()][:self.MAX]
        if not text or not targets:
            return 400, {"ok": False, "error": "targets"}
        self.stop()
        cid = uuid.uuid4().hex[:12]
        shown = [{k: str(t.get(k) or "") for k in ("provider", "kind", "title", "model", "name", "site")} for t in targets]
        self.main.push("compare_start", json.dumps({"type": "compare_start", "id": cid, "text": text,
                                                    "targets": shown}, ensure_ascii=False))
        runs = [_UiCompareRun(self, cid, i, t, text) for i, t in enumerate(shown)]
        with self.lock:
            self.cid, self.runs = cid, runs
        for i, r in enumerate(runs):
            try:
                r.start()
            except OSError as exc:
                r.over = True
                self.main.push("compare", json.dumps({"type": "compare", "id": cid, "run": i, "event": {
                    "type": "ui_engine_exit", "code": -1, "detail": str(exc)[:200]}}, ensure_ascii=False))
        return 200, {"ok": True, "id": cid}

    def stop(self) -> None:
        """Stop: każdy pomocnik dostaje przerwanie i koniec wejścia; ten, który nie skończy sam, jest zamykany."""
        with self.lock:
            runs, self.runs = self.runs, []
        for r in runs:
            if not r.over:
                r.over = True
                self.main.push("compare", json.dumps({"type": "compare", "id": r.cid, "run": r.run,
                                                      "event": {"type": "turn_end", "ok": False, "stopped": True}}))
        threads = [threading.Thread(target=r.stop, daemon=True) for r in runs]
        for t in threads:
            t.start()
        for t in threads:
            t.join(15)

    def pids(self) -> list:
        with self.lock:
            return [r.engine_pid() for r in self.runs if r.engine_pid()]


def _ui_i18n(lang: str) -> dict:
    """Tłumaczenia okna (teksty z aplikacji na Maca, klucz = tekst angielski): {"lang", "strings"}."""
    import base64
    import gzip
    lang = (lang or ui_lang() or "en").strip()
    allx = {}
    dev = Path(__file__).resolve().parent / "ui" / "i18n"
    if os.environ.get("CODO_UI_DEV") and dev.is_dir():
        for f in dev.glob("*.json"):
            try:
                allx[f.stem] = {} if f.stem == "en" else json.loads(f.read_text(encoding="utf-8"))
                extra = dev.parent / "i18n-extra" / f.name
                if f.stem != "en" and extra.exists():
                    allx[f.stem].update(json.loads(extra.read_text(encoding="utf-8")))
            except (OSError, ValueError):
                pass
    else:
        try:
            allx = json.loads(gzip.decompress(base64.b64decode("".join(_CODO_UI_I18N_GZ))).decode("utf-8"))
        except (ValueError, OSError, NameError):
            allx = {}
    if lang not in allx:
        lang = lang.split("-")[0] if lang.split("-")[0] in allx else ("pl" if lang.startswith("pl") else "en")
    return {"lang": lang, "langs": sorted(allx), "strings": allx.get(lang, {})}


def _ui_page() -> str:
    """Strona okna: osadzona w tym pliku (gzip + base64); CODO_UI_DEV=1 czyta static/cli/codo-ui.html obok."""
    if os.environ.get("CODO_UI_DEV"):
        dev = Path(__file__).resolve().parent / "codo-ui.html"
        if dev.exists():
            ui = dev.parent / "ui"
            css = "\n".join(f.read_text(encoding="utf-8") for f in sorted(ui.glob("*.css")))
            js = "\n".join(f.read_text(encoding="utf-8") for f in sorted(ui.glob("*.js")))
            return dev.read_text(encoding="utf-8").replace("/*@@UI_CSS@@*/", css).replace("//@@UI_JS@@", js)
    import base64
    import gzip
    return gzip.decompress(base64.b64decode("".join(_CODO_UI_GZ))).decode("utf-8")


