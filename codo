def _plural(n: int, forms: tuple) -> str:
    if n == 1:
        return forms[0]
    if 2 <= n % 10 <= 4 and not 12 <= n % 100 <= 14:
        return forms[1]
    return forms[2]


def _summary_text(summary: dict, running: bool = False) -> str:
    parts = []
    for group in _SUMMARY_ORDER:
        n = summary.get(group)
        if not n:
            continue
        done, now, forms = _SUMMARY_WORDS[group]
        verb = now if running else done
        if not parts:
            verb = verb[:1].upper() + verb[1:]
        parts.append(dim(verb + " ") + bold(str(n)) + dim(" " + _plural(n, forms)))
    if not parts:
        return ""
    return "  " + dim(", ").join(parts) + (dim("…") if running else "")


def _short_path(value: str, limit: int = 48) -> str:
    """Ścieżka czytelnie: względna wobec projektu, ~ zamiast katalogu domowego,
    środek skrócony, gdy za długa."""
    text = str(value)
    try:
        p = Path(text).expanduser()
        if p.is_absolute():
            try:
                text = str(p.resolve().relative_to(Path.cwd().resolve())) or "."
            except (ValueError, OSError):
                home = str(Path.home())
                text = "~" + text[len(home):] if text.startswith(home) else text
    except (OSError, ValueError):
        pass
    if len(text) > limit:
        parts = text.replace("\\", "/").split("/")
        tail = "/".join(parts[-2:])
        text = ("…/" + tail) if len(tail) + 2 <= limit else "…" + text[-(limit - 1):]
    return text


_GIT_CACHE = {"at": 0.0, "cwd": "", "branch": None}


def _git_branch() -> str | None:
    """Gałąź git bez uruchamiania gita (odczyt .git/HEAD), z krótkim cache."""
    import time as _time
    now = _time.monotonic()
    cwd = str(Path.cwd())
    if _GIT_CACHE["cwd"] == cwd and now - _GIT_CACHE["at"] < 3:
        return _GIT_CACHE["branch"]
    branch = None
    try:
        d = Path(cwd)
        for cand in (d, *d.parents):
            git = cand / ".git"
            if git.is_file():
                m = re.match(r"gitdir:\s*(.+)", git.read_text().strip())
                git = (cand / m.group(1)).resolve() if m else git
            if git.is_dir():
                head = (git / "HEAD").read_text().strip()
                branch = head[16:] if head.startswith("ref: refs/heads/") else head[:8]
                break
    except OSError:
        branch = None
    _GIT_CACHE.update(at=now, cwd=cwd, branch=branch)
    return branch


def _cwd_label(limit: int = 40) -> str:
    cwd = str(Path.cwd())
    home = str(Path.home())
    if cwd == home:
        text = "~"
    elif cwd.startswith(home + os.sep):
        text = "~" + cwd[len(home):]
    else:
        text = cwd
    if len(text) > limit:
        parts = text.replace("\\", "/").split("/")
        text = "…/" + "/".join(parts[-2:])
    return text


def _where() -> str:
    """Folder pracy (+ gałąź git) do stopki i nagłówków."""
    branch = _git_branch()
    folder = ("⌂ " if not IS_WIN else "") + _cwd_label()
    return dim(folder) + (dim(" ") + cyan(_icon("git") + " " + branch) if branch else "")


def _detail_rows(text: str, width: int, limit: int = 4) -> list:
    """Pełna treść pod nagłówkiem (np. komenda), zawinięta z wcięciem pod ⎿."""
    if not text:
        return []
    rows = []
    for raw in _terminal_text(text).split("\n"):
        rows.extend(_wrap_ansi(raw, max(10, width - 5)))
    if len(rows) > limit:
        rows = rows[:limit - 1] + [rows[limit - 1][:max(1, width - 7)] + " …"]
    return [dim(("  ⎿  " if i == 0 else "     ") + r) for i, r in enumerate(rows)]


def _ensure_sigint() -> None:
    """Start z tła (nohup, skrypt, usługa) dziedziczy ignorowany SIGINT i wtedy Esc
    niczego nie przerywał. Sesja z klawiaturą jest na pierwszym planie, więc przywracamy
    zwykłą obsługę; praca bez klawiatury zostaje nietknięta."""
    try:
        import signal
        if signal.getsignal(signal.SIGINT) is signal.SIG_IGN:
            signal.signal(signal.SIGINT, signal.default_int_handler)
    except (ValueError, OSError):       # nie główny wątek
        pass


