    def state(self) -> dict:
        return {"version": VERSION, "agents": [{"id": i, "name": self.agents[i]["name"], "job": self.agents[i].get("job") or "",
                                                "activity": self.activity(i), "line": self.line(self.agents[i]),
                                                "queue": len(self.queues.get(i) or []), "model": self.agents[i].get("model") or "",
                                                "memory": self.agents[i].get("memory") or [],
                                                "skills": self.agents[i].get("skills") or [],
                                                "conversation": self.agents[i].get("conversation") or "",
                                                **self.calm_agent(i)} for i in self.order],
                "calm": self.calm_state(),
                "profile": list(self.profile), "posts": self.posts[-80:], "telegram": bool(self.tg and self.tg.chat), "telegram_problem": getattr(self.tg, "problem", "") if self.tg else "",
                "telegram_mode": ("shared" if getattr(self.tg, "relayed", False) else "own") if self.tg else "",
                "telegram_lost": getattr(self.tg, "lost", "") if self.tg else "",
                "chats": {n: {"paired": bool(c.chat), "problem": getattr(c, "problem", ""), "title": self.chat_title(n),
                              "voice": getattr(c, "voice_mode", "off")} for n, c in self.chats.items()}, "tokens": sorted(n for n, k in _HOST_SECRET_KEYS.items() if k in _host_secrets()),
                "asks": [{"key": k, "agent": v[0], "held": any(w["key"] == k for w in self.held_asks)} for k, v in self.asks.items()],
                "swarm_runs": self.swarms.state() if hasattr(self, "swarms") else []}

    def push(self, ev: dict) -> None:
        if not self.clients:
            return
        line = (json.dumps(ev, ensure_ascii=False) + "\n").encode("utf-8")
        for c in list(self.clients):
            try:
                c.sendall(line)
            except OSError:
                self.clients.remove(c)

    def command(self, c, msg: dict) -> None:
        cmd = msg.get("cmd")

        def out(obj: dict) -> None:
            try:
                c.sendall((json.dumps({"re": cmd, **obj}, ensure_ascii=False) + "\n").encode("utf-8"))
            except OSError:
                pass
        if cmd == "state":
            out({"ok": True, "state": self.state()})
        elif cmd == "attach":
            if c not in self.clients:
                self.clients.append(c)
            out({"ok": True, "state": self.state()})
        elif cmd == "ask":
            # agent z Maca (albo pokój) pyta agenta na serwerze: odpowiedź wraca do okna zdarzeniem „answer”
            a = self.find(msg.get("agent"))
            text, key = str(msg.get("text") or "").strip(), str(msg.get("key") or "")
            if not a or not text or not key:
                out({"ok": False, "error": "Nie ma takiego agenta albo pusty tekst."})
            else:
                who = str(msg.get("from_name") or "Mac")[:80]

                def answered(answer: str, ok: bool, key=key, aid=a["id"]) -> None:
                    self.push({"ev": "answer", "key": key, "agent": aid, "text": answer, "ok": ok})
                out({"ok": True, "note": self.tell(a["id"], text, ("agent", "mac", who), back=("here", a["id"]),
                                                   depth=int(msg.get("depth") or 1), reply=answered)})
        elif cmd == "remote_answer":
            out({"ok": self.remote_answer(msg.get("key"), msg.get("text"), bool(msg.get("ok")))})
        elif cmd == "send":
            a = self.find(msg.get("agent"))
            text = str(msg.get("text") or "").strip()
            if not a or not text:
                out({"ok": False, "error": "Nie ma takiego agenta albo pusty tekst."})
            else:
                out({"ok": True, "note": self.tell(a["id"], text, ("mac",))})
        elif cmd == "log":
            # Log-Bot w oknie Codo: dziennik pracy agenta od chwili „since” (sekundy od epoki)
            a = self.find(msg.get("agent"))
            out({"ok": bool(a), "agent": a["id"] if a else "",
                 "items": self.trace_since(a["id"], float(msg.get("since") or 0), int(msg.get("limit") or 3000)) if a else []})
        elif cmd == "history":
            a = self.find(msg.get("agent"))
            out({"ok": bool(a), "agent": a["id"] if a else "", "items": self.history(a["id"], int(msg.get("limit") or 200)) if a else []})
        elif cmd == "stop":
            a = self.find(msg.get("agent")) if msg.get("agent") else None
            out({"ok": True, "stopped": self.stop_agent(a["id"]) if a else sum(self.stop_agent(i) for i in list(self.order))})
        elif cmd == "answer":
            key = msg.get("key")
            if not key and msg.get("agent"):
                # okno Codo zna numer pytania w silniku agenta, nie klucz z czatu
                a = self.find(msg.get("agent"))
                key = next((k for k, v in self.asks.items() if a and v == (a["id"], str(msg.get("id")))), None)
            out({"ok": bool(key) and self.answer_ask(str(key), int(msg.get("value") or 0))})
        elif cmd == "cancel":
            self.cancel(str(msg.get("post")))
            out({"ok": True})
        elif cmd == "handover":
            a, b = self.find(msg.get("from")), self.find(msg.get("to"))
            out({"ok": bool(a and b and self.hand_over(a["id"], b["id"], ("here", a["id"])))})
        elif cmd in _HOST_TRIG_CMDS:
            out(_host_trig_command(self, cmd, msg))
        elif cmd in _HOST_ROOM_CMDS:
            out(self.rooms.command(cmd, msg))
        elif cmd == "reload":
            self.reload()
            out({"ok": True, "state": self.state()})
        elif cmd == "shutdown":
            out({"ok": True})
            self.exit = True
        else:
            out({"ok": False, "error": f"nieznane polecenie {cmd}"})

    def reload(self) -> None:
        """Nowe definicje z okna Codo: nowi agenci wchodzą, usunięci kończą, zmienieni dostają nowe instrukcje."""
        old = dict(self.agents)
        data = _host_load("agents.json", {})
        fresh = {str(a["id"]).lower(): a for a in data.get("agents") or [] if isinstance(a, dict) and a.get("id") and a.get("name")}
        for aid, a in fresh.items():
            a["id"] = aid
            prev = old.get(aid)
            if prev:
                # to, czego agent nauczył się i gdzie jest jego rozmowa, wie gospodarz, nie okno
                a.setdefault("conversation", prev.get("conversation"))
                if prev.get("conversation") and not a.get("conversation"):
                    a["conversation"] = prev["conversation"]
                merged = list(dict.fromkeys([str(n) for n in (a.get("memory") or [])] + [str(n) for n in (prev.get("memory") or [])]))
                a["memory"] = merged[-30:]
                a["skills"] = _skills_merge(a.get("skills") or [], prev.get("skills") or [])
                if isinstance(prev.get("beat"), dict) and isinstance(a.get("beat"), dict):
                    a["beat"].setdefault("last", prev["beat"].get("last"))
                    if _beat_modern(a["beat"]):
                        # sprawdzenie zrobione tutaj jest nowsze niż to, co Mac pamięta sprzed przenosin
                        try:
                            a["beat"]["last"] = max(float(a["beat"].get("last") or 0), float(prev["beat"].get("last") or 0)) or None
                        except (TypeError, ValueError):
                            pass
                        if prev["beat"].get("skipped") is not None:
                            a["beat"].setdefault("skipped", prev["beat"]["skipped"])
                # zmieniony limit sprawdza się od nowa, a jego ponowne wyczerpanie zgłasza się jeszcze raz
                if _calm_int(prev.get("limit"), _CALM_LIMIT) != _calm_int(a.get("limit"), _CALM_LIMIT):
                    self.forget_notice(aid)
        if _calm_int(self.extra.get("cap"), _CALM_CAP) != _calm_int(data.get("cap"), _CALM_CAP):
            self.forget_notice("all")
        self.extra = {k: data[k] for k in _HOST_EXTRA if k in data}
        self.agents, self.order = fresh, list(fresh)
        self.remote = [r for r in data.get("remote") or [] if isinstance(r, dict) and r.get("id") and r.get("name")]
        # profil wraca z Maca scalony; to, co tam usunąłeś, znika i tu
        gone = {_fold(str(f)) for f in data.get("profile_forget") or []}
        self.profile = [f for f in _profile_merge(getattr(self, "profile", []), data.get("profile") or []) if _fold(f) not in gone]
        sec = _host_secrets()
        new_secrets = getattr(self, "_secrets", sec) != sec   # nowy token: silniki wstają z nowym środowiskiem
        self._secrets = sec
        for aid in list(self.engines):
            e = self.engines[aid]
            prev, now = old.get(aid), fresh.get(aid)
            changed = now is None or any(prev.get(k) != now.get(k) for k in ("model", "writes", "auto", "desk", "conversation")) if prev else True
            if (changed or new_secrets) and not e.busy:
                e.stop()
                self.engines.pop(aid, None)
        self.save_agents()
        self.refresh_personas()
        self.start_telegram()
        self.dirty = True

    def forget_notice(self, key: str) -> None:
        noticed = self.spend.get("noticed") if isinstance(self.spend, dict) else None
        if isinstance(noticed, list) and key in noticed:
            noticed.remove(key)
            _host_save("wydatki.json", self.spend)

    def start_chats(self) -> None:
        """Komunikatory z plików <nazwa>.json; Mac wgrywa je, gdy oddaje serwerowi swoje boty."""
        for name, cls in _HOST_CHATS.items():
            cfg = _host_load(f"{name}.json", {})
            # Telegram bez własnego tokena, ze znacznikiem "mode": "shared": wspólny bot Codo przez skrzynkę w DomaAI
            shared = name == "telegram" and cfg.get("mode") == "shared" and not cfg.get("token")
            if shared:
                cls = HostTelegramShared
            ready = bool(cfg.get("on")) if name == "whatsapp" else bool(cfg.get("number")) if name == "signal" else bool(
                cfg.get("imap_host") and cfg.get("user") and cfg.get("password")) if name == "email" else bool(
                shared or cfg.get("token") if name in ("telegram", "discord") else (cfg.get("app_token") and cfg.get("bot_token")))
            old = self.chats.get(name)
            if not ready:
                if old:
                    old.stop_flag = True
                    self.chats.pop(name, None)
                continue
            # "handed": Mac oddał skrzynkę wspólnego bota jeszcze raz, więc transport wstaje od nowa i przejmuje ją wprost
            keys = ("token", "app_token", "bot_token", "number", "cli", "config", "imap_host", "imap_port", "smtp_host",
                    "smtp_port", "user", "password", "handed")
            if old and type(old) is cls and not getattr(old, "ended", False) and all(old.cfg.get(k) == cfg.get(k) for k in keys):
                old.cfg.update(cfg)
                continue
            if old:
                old.stop_flag = True
            self.chats[name] = cls(cfg, self.q)
            self.chats[name].start()

    start_telegram = start_chats

    # ── pętla ──
    def after(self, seconds: float, fn) -> None:
        import time
        self.timers.append((time.time() + seconds, fn))

    def restore(self) -> None:
        """Po restarcie: zadania i wiadomości, które czekały, wracają do kolejek; pytanie, na które nikt nie czeka, przepada."""
        for p in self.posts:
            if p.get("state") not in ("queued", "working"):
                continue
            if p["kind"] == "ask" or p["to"] not in self.agents:
                p["state"], p["finished"] = "failed", _now_iso()
                continue
            p["state"] = "queued"
            origin = ("handoff", p["id"]) if p["kind"] == "handoff" else ("agent", p["from"], p["from_name"])
            self.tell(p["to"], self.brief(p), origin, back=tuple(p["back"]), depth=int(p.get("depth") or 1), post=p["id"])
        self.save_posts()
        for m in _host_load("queue.json", []):
            if isinstance(m, dict) and m.get("agent") in self.agents and m.get("text"):
                self.tell(m["agent"], m["text"], tuple(m.get("origin") or ("mac",)), back=tuple(m.get("back") or ("here", m["agent"])),
                          depth=int(m.get("depth") or 0), deliver=bool(m.get("deliver")))

    def step(self, timeout: float = 0.5) -> None:
        import queue
        import time
        try:
            item = self.q.get(timeout=timeout)
        except queue.Empty:
            item = None
        while item is not None:
            kind = item[0]
            if kind == "engine":
                _, aid, engine, ev = item
                if self.engines.get(aid) is engine:
                    t = ev.get("type")
                    if t != "turn_end":
                        self.trace(aid, ev)
                    if self.clients and t not in ("_exit", "bridge", "ready", "models", "status", "tools", "presets", "skills"):
                        # okno Codo pokazuje rozmowę agenta z tych samych zdarzeń co przy silniku na Macu
                        self.push({"ev": "raw", "agent": aid, "e": ev})
                    if t == "ready":
                        engine.ready = True
                    elif t == "assistant":
                        text = str(ev.get("tekst") or "")
                        if text.strip():
                            engine.answer = text
                            shown = self.clean(text)   # blok ```agenci``` i linie do pamięci są dla Codo, nie dla człowieka
                            if shown.strip():
                                self.log(aid, "assistant", shown)
                    elif t == "error" or (t == "info" and ev.get("blad")):
                        self.log(aid, "info", str(ev.get("tekst") or ""), src="error")
                        engine.last_error = str(ev.get("tekst") or "")
                    elif t == "ask":
                        self.on_ask(aid, engine, ev)
                    elif t == "bridge":
                        self.bridge(aid, engine, ev)
                    elif t == "turn_end":
                        self.count_turn(aid, engine, ev)
                        self.finished(aid, bool(ev.get("ok")), ev.get("convo_id"))
                        self.trace(aid, ev)   # po zapisach pamięci z tej tury
                    elif t == "_exit":
                        self.engines.pop(aid, None)
                        if aid in self.current:
                            self.finished(aid, False, None)
                        self.dirty = True
            elif kind == "tg":
                if self.tg is not None:
                    self.on_telegram(item[1])
            elif kind == "chat":
                self.on_chat(item[1], item[2])
            elif kind == "client":
                self.command(item[1], item[2])
            elif kind == "call":
                item[1]()           # wynik pracy w tle (gh, IMAP, webhook) w pętli gospodarza
            elif kind == "swarm":
                self.swarms.on_event(item[1], item[2], item[3])
            elif kind == "gone":
                if item[1] in self.clients:
                    self.clients.remove(item[1])
            try:
                item = self.q.get_nowait()
            except queue.Empty:
                item = None
        now = time.time()
        due = [t for t in self.timers if t[0] <= now]
        self.timers = [t for t in self.timers if t[0] > now]
        for _, fn in due:
            fn()
        for aid in list(self.queues):
            self.pump(aid)
        # przerwa w tykaniu (uśpiony komputer, zatrzymany proces): co wypadło w jej trakcie, było przegapione, nie spóźnione
        if self.last_tick and now - self.last_tick > 45:
            self.awake_since = now
        self.last_tick = now
        self.calm_tick(self.clock())
        if now - self.last_trig_tick >= 2:
            self.last_trig_tick = now
            self.triggers.tick(self.clock())
        # komunikator zgłosił kłopot albo przestał czytać: okno Codo ma to zobaczyć od razu, nie przy następnej zmianie
        seen = tuple((n, getattr(c, "problem", ""), getattr(c, "lost", "")) for n, c in sorted(self.chats.items()))
        if seen != getattr(self, "_chats_seen", seen):
            self.dirty = True
        self._chats_seen = seen
        if now - self.last_beat_check >= 20:
            self.last_beat_check = now
            self.check_beats()
            self.swarms.tick(self.clock())
            # silnik, który od pół godziny nic nie robi, nie musi zajmować pamięci: rozmowa jest na dysku
            for aid, e in list(self.engines.items()):
                if e.busy or aid in self.current or self.queues.get(aid):
                    e.idle_since = now
                elif not e.idle_since:
                    e.idle_since = now
                elif now - e.idle_since > 1800:
                    e.stop()
                    self.engines.pop(aid, None)
        if self.dirty:
            self.dirty = False
            self.save_queue()
            self.push({"ev": "state", "state": self.state()})

    def serve_socket(self) -> None:
        import socket
        token = ""
        if _host_unix_ok():
            path = _host_sock_path()
            try:
                os.unlink(path)
            except OSError:
                pass
            s = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
            s.bind(path)
            os.chmod(path, 0o600)
            s.listen(8)
            _host_write_private(HOST_DIR / "host.sock.path", path)
            import atexit
            atexit.register(lambda: os.path.exists(path) and os.unlink(path))
        else:
            # Windows (bez AF_UNIX): tylko 127.0.0.1, losowy port i losowy token w pliku użytkownika.
            import secrets
            token = secrets.token_urlsafe(24)
            s = socket.socket(socket.AF_INET, socket.SOCK_STREAM)
            s.bind(("127.0.0.1", 0))
            s.listen(8)
            _host_write_private(HOST_DIR / "host.sock.path", f"tcp:{s.getsockname()[1]}:{token}")

        def client(c) -> None:
            buf = b""
            if token:
                import hmac
                try:
                    c.settimeout(10)
                    while b"\n" not in buf and len(buf) < 4096:
                        chunk = c.recv(4096)
                        if not chunk:
                            break
                        buf += chunk
                    line, buf = (buf.split(b"\n", 1) + [b""])[:2]
                    given = str((json.loads(line.decode("utf-8") or "{}") or {}).get("auth") or "")
                    c.settimeout(None)
                except (OSError, ValueError, AttributeError):
                    given = ""
                if not hmac.compare_digest(given.encode(), token.encode()):
                    try:
                        c.close()
                    except OSError:
                        pass
                    return
            try:
                while True:
                    while b"\n" in buf:   # najpierw to, co przyszło razem z tokenem
                        line, buf = buf.split(b"\n", 1)
                        try:
                            msg = json.loads(line.decode("utf-8") or "{}")
                        except ValueError:
                            continue
                        if isinstance(msg, dict):
                            self.q.put(("client", c, msg))
                    chunk = c.recv(65536)
                    if not chunk:
                        break
                    buf += chunk
            except OSError:
                pass
            self.q.put(("gone", c))

        def accept() -> None:
            while not self.exit:
                try:
                    c, _ = s.accept()
                except OSError:
                    return
                threading.Thread(target=client, args=(c,), daemon=True).start()
        threading.Thread(target=accept, daemon=True).start()

    def run(self) -> int:
        HOST_DIR.mkdir(parents=True, exist_ok=True)
        (HOST_DIR / "host.pid").write_text(str(os.getpid()))
        self.serve_socket()
        self.start_telegram()
        self.restore()
        print(f"codo host {VERSION}: agentów {len(self.order)}, gniazdo {_host_sock_path()}", flush=True)
        try:
            while not self.exit:
                self.step()
        except KeyboardInterrupt:
            pass
        finally:
            for e in list(self.engines.values()):
                e.stop(2)
            try:
                (HOST_DIR / "host.pid").unlink()
            except OSError:
                pass
        return 0


def _now_iso() -> str:
    import datetime as _dt
    return _dt.datetime.now(_dt.timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ")


def _host_unix_ok() -> bool:
    import socket
    return hasattr(socket, "AF_UNIX") and not IS_WIN and not os.environ.get("CODO_HOST_TCP")


def _host_write_private(path: Path, text: str) -> None:
    path.parent.mkdir(parents=True, exist_ok=True)
    tmp = path.with_name(path.name + ".tmp")
    tmp.write_text(text, encoding="utf-8")
    try:
        os.chmod(tmp, 0o600)
    except OSError:
        pass
    os.replace(tmp, path)


def _host_connect(timeout: float | None = None):
    """Połączenie z działającym gospodarzem (gniazdo uniksowe albo 127.0.0.1 z tokenem na Windows)."""
    import socket
    try:
        where = (HOST_DIR / "host.sock.path").read_text(encoding="utf-8").strip() or _host_sock_path()
    except OSError:
        where = _host_sock_path()
    if where.startswith("tcp:"):
        _tcp, port, token = (where.split(":", 2) + ["", ""])[:3]
        s = socket.create_connection(("127.0.0.1", int(port or 0)), timeout=timeout or 10)
        s.sendall((json.dumps({"auth": token}) + "\n").encode("utf-8"))
    else:
        s = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
        if timeout:
            s.settimeout(timeout)
        s.connect(where)
    s.settimeout(timeout)
    return s


def _host_call(msg: dict, timeout: float = 15):
    """Jedno polecenie do działającego gospodarza; None, gdy nie działa."""
    try:
        with _host_connect(timeout) as s:
            s.sendall((json.dumps(msg, ensure_ascii=False) + "\n").encode("utf-8"))
            buf = b""
            while b"\n" not in buf:
                chunk = s.recv(65536)
                if not chunk:
                    break
                buf += chunk
        return json.loads(buf.split(b"\n", 1)[0].decode("utf-8") or "{}")
    except (OSError, ValueError):
        return None


def _host_attach() -> int:
    """Okno Codo po SSH: polecenia ze stdin idą do gospodarza, jego zdarzenia na stdout (JSON w liniach)."""
    import socket
    try:
        s = _host_connect()
    except (OSError, ValueError):
        print(json.dumps({"ev": "down", "error": "Gospodarz agentów nie działa na tym serwerze."}), flush=True)
        return 1
    s.sendall(b'{"cmd": "attach"}\n')

    def pump_in() -> None:
        for line in sys.stdin:
            if line.strip():
                try:
                    s.sendall(line.encode("utf-8") if line.endswith("\n") else (line + "\n").encode("utf-8"))
                except OSError:
                    return
        try:
            s.shutdown(socket.SHUT_RDWR)
        except OSError:
            pass
    threading.Thread(target=pump_in, daemon=True).start()
    out = sys.stdout.buffer
    try:
        while True:
            chunk = s.recv(65536)
            if not chunk:
                break
            out.write(chunk)
            out.flush()
    except (OSError, KeyboardInterrupt):
        pass
    return 0


def _host_service(action: str) -> str:
    """Usługa gospodarza: systemd --user (Linux) albo launchd (macOS). Wstaje po restarcie serwera."""
    import shutil as _shutil
    prog = [*_self_cmd(), "host", "run"]
    # PATH z chwili instalacji: usługi systemowe mają ubogi PATH, a agenci (claude, codex) siedzą zwykle w ~/.local/bin
    env = {k: os.environ[k] for k in ("DOMA_CONFIG_DIR", "DOMA_API_URL", "CODO_TELEGRAM_API", "CODO_DISCORD_API", "CODO_DISCORD_GATEWAY",
                                      "CODO_SLACK_API", "PATH") if os.environ.get(k)}
    plain = bool(os.environ.get("CODO_HOST_NO_SERVICE"))   # kontener albo test: zwykły proces w tle, bez usługi systemu
    if IS_MAC and not plain:
        plist = Path.home() / "Library" / "LaunchAgents" / "im.madd.codo-host.plist"
        if action == "uninstall":
            subprocess.run(["launchctl", "unload", "-w", str(plist)], capture_output=True)
            plist.unlink(missing_ok=True)
            return "usunięto"
        from xml.sax.saxutils import escape as _xml
        plist.parent.mkdir(parents=True, exist_ok=True)
        args_xml = "\n".join(f"      <string>{_xml(a)}</string>" for a in prog)
        env_xml = "".join(f"<key>{_xml(k)}</key><string>{_xml(v)}</string>" for k, v in env.items())
        plist.write_text(f"""<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0"><dict>
  <key>Label</key><string>im.madd.codo-host</string>
  <key>ProgramArguments</key><array>
{args_xml}
  </array>
  <key>EnvironmentVariables</key><dict>{env_xml}</dict>
  <key>RunAtLoad</key><true/>
  <key>KeepAlive</key><true/>
  <key>StandardOutPath</key><string>{_xml(str(HOST_DIR / "host.log"))}</string>
  <key>StandardErrorPath</key><string>{_xml(str(HOST_DIR / "host.log"))}</string>
</dict></plist>
""", encoding="utf-8")
        subprocess.run(["launchctl", "unload", str(plist)], capture_output=True)
        r = subprocess.run(["launchctl", "load", "-w", str(plist)], capture_output=True, text=True)
        return "launchd" if r.returncode == 0 else f"BŁĄD launchctl: {(r.stderr or r.stdout).strip()[:200]}"
    if _shutil.which("systemctl") and not plain:
        unit = Path.home() / ".config" / "systemd" / "user" / "codo-host.service"
        if action == "uninstall":
            subprocess.run(["systemctl", "--user", "disable", "--now", "codo-host.service"], capture_output=True)
            unit.unlink(missing_ok=True)
            subprocess.run(["systemctl", "--user", "daemon-reload"], capture_output=True)
            return "usunięto"
        unit.parent.mkdir(parents=True, exist_ok=True)
        exec_line = " ".join('"' + p.replace("\\", "\\\\").replace('"', r'\"').replace("%", "%%") + '"' for p in prog)
        env_lines = "".join(f'Environment="{k}={v}"\n' for k, v in env.items())
        unit.write_text(f"""[Unit]
Description=codo host (by MADD) — stali agenci
After=network-online.target

[Service]
ExecStart={exec_line}
{env_lines}Restart=always
RestartSec=5

[Install]
WantedBy=default.target
""")
        # usługa ma działać także bez zalogowanej sesji (po restarcie serwera)
        subprocess.run(["loginctl", "enable-linger", os.environ.get("USER") or ""], capture_output=True)
        for cmd in (["systemctl", "--user", "daemon-reload"], ["systemctl", "--user", "enable", "codo-host.service"],
                    ["systemctl", "--user", "restart", "codo-host.service"]):
            r = subprocess.run(cmd, capture_output=True, text=True)
            if r.returncode != 0:
                return f"BŁĄD systemctl: {(r.stderr or r.stdout).strip()[:200]}"
        return "systemd"
    if action == "uninstall":
        r = _host_call({"cmd": "shutdown"})
        return "zatrzymano" if r else "nie działał"
    # bez systemd i launchd: proces w tle, do następnego restartu serwera (działający zastępujemy nowym)
    if _host_call({"cmd": "shutdown"}, timeout=5):
        import time
        for _ in range(40):
            if _host_call({"cmd": "state"}, timeout=2) is None:
                break
            time.sleep(0.25)
    HOST_DIR.mkdir(parents=True, exist_ok=True)
    with open(HOST_DIR / "host.log", "ab") as log:
        subprocess.Popen(prog, stdout=log, stderr=subprocess.STDOUT, stdin=subprocess.DEVNULL, start_new_session=True)  # nosec B603
    return "w tle (bez autostartu: na tym serwerze nie ma systemd)"


# Sekrety agentów na serwerze (tokeny planów, klucze): ~/.config/doma/host/sekrety.json, prawa 600.
# Tylko znane nazwy, żeby plik nie mógł podmienić PATH ani niczego innego w środowisku agenta.
_HOST_SECRET_KEYS = {"claude": "CLAUDE_CODE_OAUTH_TOKEN", "anthropic": "ANTHROPIC_API_KEY",
                     "codex": "CODEX_API_KEY", "openai": "OPENAI_API_KEY", "gemini": "GEMINI_API_KEY"}


def _host_secrets() -> dict:
    d = _host_load("sekrety.json", {})
    allowed = set(_HOST_SECRET_KEYS.values())
    return {k: str(v) for k, v in (d.items() if isinstance(d, dict) else []) if k in allowed and v}


def _host_set_secret(name: str, value: str) -> bool:
    key = _HOST_SECRET_KEYS.get(name)
    if not key:
        return False
    d = _host_load("sekrety.json", {})
    d = d if isinstance(d, dict) else {}
    if value:
        d[key] = value
    else:
        d.pop(key, None)
    HOST_DIR.mkdir(parents=True, exist_ok=True)
    _save_private_json(HOST_DIR / "sekrety.json", d)
    return True


def _host_agent_login(kind: str) -> str:
    """Pusty napis, gdy agent ma czym się zalogować; inaczej powód. Sprawdza tylko Claude Code (reszta: brak wiedzy = OK)."""
    if kind != "claude":
        return ""
    sec = _host_secrets()
    if sec.get("CLAUDE_CODE_OAUTH_TOKEN") or sec.get("ANTHROPIC_API_KEY"):
        return ""
    path = _agent_bin("claude")
    if not path:
        return ""
    try:
        r = subprocess.run([path, "auth", "status"], capture_output=True, text=True, timeout=20)  # nosec B603 — program agenta
        st = json.loads(r.stdout or "{}")
    except (OSError, ValueError, subprocess.SubprocessError):
        return ""
    if isinstance(st, dict) and st.get("loggedIn") is False:
        return _L("Claude Code na serwerze nie jest zalogowany. Wklej w Codo token z polecenia `claude setup-token`.")
    return ""


def _host_check(models: list) -> dict:
    """Czy mózgi agentów są na tym serwerze: zainstalowany i zalogowany agent, konto z kluczem albo konto DomaAI."""
    out = {}
    have_agents = {k for k, _p in agents_available()}
    for m in models:
        m = str(m or "")
        kind = agent_kind(m)
        if not m:
            out[m] = ""
        elif kind:
            label = _AGENTS[kind]["label"]
            out[m] = (_host_agent_login(kind) if kind in have_agents
                      else f"Na serwerze nie ma programu {label}. Zainstaluj go tam i zaloguj ({_AGENTS[kind]['install']}).")
        elif m.startswith("@"):
            acct = m[1:].split("/", 1)[0]
            out[m] = "" if acct in endpoint_accounts() else f"Na serwerze nie ma konta «{acct}» z kluczem API."
        else:
            out[m] = "" if (load_device() or load_creds()) else "Ten model wymaga konta DomaAI na serwerze (codo login)."
    return out


def _host_convo_dir(folder) -> Path:
    """Katalog rozmów folderu, tak jak liczy go _convo_folder_dir() procesu pracującego w tym folderze."""
    import hashlib
    key = hashlib.sha256(str(Path(os.path.expanduser(str(folder))).resolve()).encode("utf-8", "replace")).hexdigest()[:16]
    return CONVO_DIR / key


def _host_agent_folder(aid: str):
    for a in _host_load("agents.json", {}).get("agents") or []:
        if isinstance(a, dict) and str(a.get("id") or "").lower() == aid.lower():
            p = str(a.get("desk") or "")
            if p and os.path.isdir(os.path.expanduser(p)):
                return Path(os.path.expanduser(p)).resolve()
            return (HOST_DIR / "biurka" / aid.lower()).resolve()
    return None


def _host_convo_in(aid: str, data: dict, folder=None) -> str:
    """Rozmowa agenta przeniesiona z innego komputera: zapis w jego folderze (sesje agentów zewnętrznych zostają
    tam, skąd przyszła, więc nowa sesja dostaje kontekst z wiadomości), na serwerze także w agents.json i zapisie okna."""
    import time
    if not isinstance(data, dict) or not isinstance(data.get("messages"), list) or not data.get("id"):
        raise ValueError("to nie jest zapis rozmowy")
    cid = re.sub(r"[^A-Za-z0-9._-]", "", str(data["id"]))[:80]
    target = Path(os.path.expanduser(str(folder))).resolve() if folder else _host_agent_folder(aid)
    if target is None:
        raise ValueError("nie ma takiego agenta na serwerze")
    target.mkdir(parents=True, exist_ok=True)
    out = dict(data, id=cid, cwd=str(target), agent_sid={}, maszyna=False, updated=int(data.get("updated") or time.time()))
    d = _host_convo_dir(target)
    d.mkdir(parents=True, exist_ok=True)
    try:
        os.chmod(CONVO_DIR, 0o700)
    except OSError:
        pass  # nosec B110
    tmp = d / f"{cid}.tmp"
    tmp.write_text(json.dumps(out, ensure_ascii=False), encoding="utf-8")
    os.chmod(tmp, 0o600)
    os.replace(tmp, d / f"{cid}.json")
    if folder is None:
        data_a = _host_load("agents.json", {})
        for a in data_a.get("agents") or []:
            if isinstance(a, dict) and str(a.get("id") or "").lower() == aid.lower():
                a["conversation"] = cid
        _host_save("agents.json", data_a)
        # okno Codo pokazuje rozmowę agenta na serwerze z rozmowy/<id>.jsonl: wcześniejsze wiadomości też tam trafiają
        rows = []
        for m in out["messages"][-120:]:
            text = str(m.get("content") or "") if isinstance(m.get("content"), str) else ""
            if m.get("role") in ("user", "assistant") and text.strip() and not text.startswith(_SUMMARY_HEAD):
                rows.append({"t": round(time.time(), 1), "role": m["role"], "text": text[:20000], "src": "mac" if m["role"] == "user" else ""})
        (HOST_DIR / "rozmowy").mkdir(parents=True, exist_ok=True)
        log = HOST_DIR / "rozmowy" / f"{aid.lower()}.jsonl"
        if not log.exists() or not log.read_text(encoding="utf-8").strip():
            log.write_text("".join(json.dumps(r, ensure_ascii=False) + "\n" for r in rows), encoding="utf-8")
    return cid


def _host_convo_out(aid: str, folder=None) -> dict | None:
    """Rozmowa agenta do zabrania z powrotem: najnowsza z jego folderu (albo ta z agents.json)."""
    target = Path(os.path.expanduser(str(folder))).resolve() if folder else _host_agent_folder(aid)
    if target is None:
        return None
    want = ""
    if folder is None:
        want = next((str(a.get("conversation") or "") for a in _host_load("agents.json", {}).get("agents") or []
                     if isinstance(a, dict) and str(a.get("id") or "").lower() == aid.lower()), "")
    files = sorted(_host_convo_dir(target).glob("*.json"), key=lambda p: p.stat().st_mtime, reverse=True)
    pick = next((f for f in files if f.stem == want), files[0] if files else None)
    if pick is None:
        return None
    try:
        data = json.loads(pick.read_text(encoding="utf-8"))
    except (OSError, ValueError):
        return None
    data["agent_sid"] = {}
    return data


def _host_setup_chat(name: str, args: list) -> int:
    """codo host signal / codo host email: zapis <nazwa>.json (0600), nowy kod parowania i przeładowanie gospodarza."""
    import random

    def opt(flag: str) -> str:
        return args[args.index(flag) + 1].strip() if flag in args and args.index(flag) + 1 < len(args) else ""

    def hostport(v: str, default: int) -> tuple:
        h, _, p = v.rpartition(":") if re.search(r":\d+$", v) else (v, "", "")
        return (h or v), int(p) if p else default
    if "--usun" in args or "--usuń" in args:
        try:
            (HOST_DIR / f"{name}.json").unlink()
        except OSError:
            pass
        _host_call({"cmd": "reload"}, timeout=10)
        print("usunięto")
        return 0
    cfg = _host_load(f"{name}.json", {})
    if name == "signal":
        number = opt("--number") or opt("--numer") or str(cfg.get("number") or "")
        if not re.fullmatch(r"\+\d{6,16}", number):
            print("Podaj numer bota w formacie międzynarodowym: codo host signal --number +48…")
            return 2
        if number != cfg.get("number"):
            cfg = {k: v for k, v in cfg.items() if k not in ("owner", "chat")}
        cfg["number"] = number
        for flag, key in (("--cli", "cli"), ("--config", "config")):
            if opt(flag):
                cfg[key] = opt(flag)
        where = f"na Signalu na numer {number}"
    else:
        imap, smtp = opt("--imap") or str(cfg.get("imap_host") or ""), opt("--smtp")
        user = opt("--user") or str(cfg.get("user") or "")
        if not imap or not user:
            print("Podaj co najmniej: codo host email --imap HOST[:PORT] --smtp HOST[:PORT] --user LOGIN [--from ADRES] [--owner ADRES]")
            return 2
        cfg["imap_host"], cfg["imap_port"] = hostport(imap, int(cfg.get("imap_port") or 993)) if opt("--imap") else (imap, int(cfg.get("imap_port") or 993))
        if smtp:
            cfg["smtp_host"], cfg["smtp_port"] = hostport(smtp, 465)
        cfg.setdefault("smtp_host", cfg["imap_host"])
        cfg.setdefault("smtp_port", 465)
        cfg["user"] = user
        cfg["from"] = opt("--from") or str(cfg.get("from") or (user if "@" in user else ""))
        if opt("--owner"):
            cfg["owner"] = opt("--owner").lower()
        pw = os.environ.get("CODO_EMAIL_PASSWORD") or ""
        if not pw and not cfg.get("password"):
            if sys.stdin and sys.stdin.isatty():
                import getpass
                pw = getpass.getpass("Hasło do skrzynki (najlepiej hasło do aplikacji): ")
            else:
                pw = sys.stdin.read().strip()
        if pw:
            cfg["password"] = pw
        if not cfg.get("password"):
            print("Brak hasła: podaj je w zmiennej CODO_EMAIL_PASSWORD albo na standardowym wejściu.")
            return 2
        where = f"na adres {cfg['from'] or user}"
    paired = bool(cfg.get("owner"))
    if not paired:
        cfg["code"] = f"{random.SystemRandom().randint(0, 999999):06d}"
    _host_save(f"{name}.json", cfg)
    _host_call({"cmd": "reload"}, timeout=10)
    if paired:
        print(f"Zapisane. Właściciel: {cfg['owner']}.")
    else:
        print(f"Zapisane. Wyślij {where} wiadomość z kodem {cfg['code']}, żeby połączyć się z agentami.")
    return 0


def host_main(args: list) -> int:
    """codo host run | install | uninstall | status | send AGENT TEKST | attach | reload | stop [AGENT] | check MODEL… | token NAZWA [--usun]
    | convo-in AGENT [--folder F] < rozmowa.json | convo-out AGENT [--folder F]
    | signal --number +48… [--cli ŚCIEŻKA] [--config FOLDER] [--usun]
    | email --imap HOST[:PORT] --smtp HOST[:PORT] --user LOGIN [--from ADRES] [--owner ADRES] [--usun]  (hasło: CODO_EMAIL_PASSWORD albo stdin)"""
    sub = args[0] if args else "status"
    if sub == "run":
        return AgentHost().run()
    if sub == "check":
        print(json.dumps({"version": VERSION, "models": _host_check(args[1:]), "service": bool(_host_call({"cmd": "state"}, timeout=5))},
                         ensure_ascii=False))
        return 0
    if sub == "token" and len(args) >= 2:
        # codo host token claude < plik: token na standardowym wejściu (nie w argumentach, bo te widać w ps); pusty usuwa
        value = "" if "--usun" in args else sys.stdin.read().strip()
        if not _host_set_secret(args[1], value):
            print(_Lf("Nieznany token: {0} (claude, anthropic, codex, openai, gemini)", args[1]))
            return 2
        _host_call({"cmd": "reload"}, timeout=10)
        print("ok")
        return 0
    if sub in ("convo-in", "convo-out") and len(args) >= 2:
        # codo host convo-in AGENT [--folder F] < rozmowa.json   ·   codo host convo-out AGENT [--folder F]
        folder = args[args.index("--folder") + 1] if "--folder" in args and args.index("--folder") + 1 < len(args) else None
        if sub == "convo-out":
            data = _host_convo_out(args[1], folder)
            if data is None:
                return 1
            print(json.dumps(data, ensure_ascii=False))
            return 0
        try:
            cid = _host_convo_in(args[1], json.loads(sys.stdin.read() or "{}"), folder)
        except ValueError as e:
            print(f"BŁĄD: {e}")
            return 2
        if folder is None:
            _host_call({"cmd": "reload"}, timeout=10)
        print(cid)
        return 0
    if sub in ("signal", "email", "e-mail", "mail"):
        return _host_setup_chat("signal" if sub == "signal" else "email", args[1:])
    if sub in ("install", "uninstall"):
        res = _host_service(sub)
        print(res)
        return 1 if res.startswith("BŁĄD") else 0
    if sub == "attach":
        return _host_attach()
    if sub == "status":
        r = _host_call({"cmd": "state"})
        if "--json" in args or "--json" in sys.argv:   # główny parser zabiera --json z argumentów
            print(json.dumps(r or {"ok": False, "error": "nie działa"}, ensure_ascii=False))
            return 0 if r else 1
        if not r:
            print(_L("Gospodarz agentów nie działa. Uruchom: codo host install"))
            return 1
        st = r["state"]
        on = []
        for n, c in (st.get("chats") or {}).items():
            label = c.get("title") or n.capitalize().replace("Whatsapp", "WhatsApp")
            if c.get("problem"):
                label += f" (problem: {c['problem']})"
            elif not c.get("paired"):
                label += " (czeka na kod parowania)"
            on.append(label)
        print(f"codo host {st['version']} · komunikatory: {', '.join(on) if on else 'brak'}")
        calm = st.get("calm") or {}
        for a in st["agents"]:
            stop = {"agent": " · praca w tle wstrzymana do jutra (dzienny limit agenta)",
                    "all": " · praca w tle wstrzymana do jutra (wspólny dzienny limit)"}.get(a.get("stopped") or "", "")
            print(f"  {a['name']}: {a['line']}{stop}")
        if (calm.get("quiet") or {}).get("until"):
            print("  godziny ciszy: zgłoszenia z pracy w tle czekają na ich koniec")
        return 0
    if sub == "send" and len(args) >= 3:
        r = _host_call({"cmd": "send", "agent": args[1], "text": " ".join(args[2:])})
        print(json.dumps(r or {"ok": False, "error": "nie działa"}, ensure_ascii=False))
        return 0 if r and r.get("ok") else 1
    if sub in ("reload", "stop"):
        r = _host_call({"cmd": sub, **({"agent": args[1]} if sub == "stop" and len(args) > 1 else {})})
        print(json.dumps({k: v for k, v in (r or {"ok": False}).items() if k != "state"}, ensure_ascii=False))
        return 0 if r and r.get("ok") else 1
    print(host_main.__doc__)
    return 2


def _win_own_console() -> bool:
    """Windows: Codo ma konsolę tylko dla siebie, czyli uruchomiono go dwuklikiem albo ze skrótu w menu Start
    (z cmd, PowerShell czy Windows Terminal konsolę dzieli jeszcze powłoka)."""
    if not IS_WIN:
        return False
    try:
        import ctypes
        buf = (ctypes.c_uint32 * 8)()
        n = ctypes.windll.kernel32.GetConsoleProcessList(buf, 8)
        return 0 < n <= (2 if FROZEN else 1)   # .exe z PyInstallera: program rozruchowy + Codo
    except Exception:
        return False


def _win_double_click() -> int:
    """Dwuklik w codo.exe: zamiast pytania o zaufanie do folderu Pobrane i okna, które od razu znika,
    otwieramy okno Codo w przeglądarce w folderze ~/Codo (zaufanym od razu)."""
    folder = Path.home() / "Codo"
    rc = 1
    try:
        folder.mkdir(parents=True, exist_ok=True)
        st = load_settings()
        trusted = st.get("trusted_folders") if isinstance(st.get("trusted_folders"), list) else []
        if str(folder.resolve()) not in trusted:
            st["trusted_folders"] = trusted + [str(folder.resolve())]
            save_settings(st)
        os.chdir(folder)
        print()
        print("  " + bold(f"{APP_NAME} {VERSION}"))
        print("  " + _L("Codo otwiera się w osobnym oknie. Zostaw to okno terminala otwarte, dopóki pracujesz."))
        print("  " + dim(_Lf("Folder projektów: {0}", str(folder))))
        print("  " + dim(_L("W terminalu wpisz codo, żeby pracować tutaj, w dowolnym folderze.")))
        print()
        rc = codo_ui([], None)
    except KeyboardInterrupt:
        rc = 0
    except Exception as e:  # noqa: BLE001 — okno nie może zniknąć bez słowa
        print(red(_Lf("✗ Nie udało się uruchomić Codo: {0}", e)))
        rc = 1
    if rc != 0:
        try:
            input(dim(_L("Naciśnij Enter, żeby zamknąć to okno.")))
        except (EOFError, KeyboardInterrupt):
            pass
    return rc


def _win_long_cwd() -> None:
    """Windows: katalog roboczy pod krótką nazwą 8.3 (C:\\Users\\JANKOW~1, typowe dla %TEMP%) zamieniamy na
    pełną. Inaczej Path.cwd() i Path.resolve() dają dwie różne ścieżki tego samego folderu: relative_to
    zawodzi, a find_files, grep i @pliki pokazują ścieżki bezwzględne zamiast względnych."""
    if os.name != "nt":
        return
    try:
        cur = os.getcwd()
        full = os.path.realpath(cur)
        if full != cur and "~" in cur and os.path.isdir(full):
            os.chdir(full)
    except OSError:
        pass


_ORIG_STDIN = None


def _win_nul_stdin() -> None:
    """Windows: stdin przekierowany na NUL (program uruchamia codo z stdin=DEVNULL, skrót, autostart) odpowiada
    isatty() == True, bo NUL to urządzenie znakowe. Codo brało to za terminal i pytało „Ufasz temu folderowi?”,
    a pusta odpowiedź kończyła start („Uruchomienie anulowane”). Prawdziwa konsola ma GetConsoleMode."""
    global _ORIG_STDIN
    if os.name != "nt" or not sys.stdin:
        return
    try:
        if not sys.stdin.isatty():
            return
        import ctypes
        import io
        import msvcrt
        mode = ctypes.c_uint32()
        handle = msvcrt.get_osfhandle(sys.stdin.fileno())
        if ctypes.windll.kernel32.GetConsoleMode(ctypes.c_void_p(handle), ctypes.byref(mode)):
            return

        class _NotConsole(io.TextIOWrapper):
            def isatty(self):
                return False

        _ORIG_STDIN = sys.stdin       # stary obiekt trzyma bufor; bez referencji zamknąłby go przy sprzątaniu
        sys.stdin = _NotConsole(sys.stdin.buffer, encoding=sys.stdin.encoding, errors=sys.stdin.errors)
    except (OSError, ValueError, AttributeError):
        pass


