def _parallel_reads(tool_calls: list, mode: str) -> dict:
    """Wyniki odczytów policzone z góry, równolegle (do 8 naraz), gdy model wywołał ich kilka w jednym
    kroku: prompt każe łączyć odczyty, a do 0.28.0 i tak szły po kolei. Kolejność w historii zostaje."""
    jobs = []
    for tc in tool_calls:
        fn = (tc or {}).get("function") or {}
        if fn.get("name") not in _PARALLEL_TOOLS or fn.get("name") in disabled_tool_names():
            break   # tylko odczyty PRZED pierwszym zapisem/komendą: po nim muszą widzieć nowy stan
        try:
            args = json.loads(fn.get("arguments") or "{}") if isinstance(fn.get("arguments") or "{}", str) else dict(fn["arguments"])
        except (ValueError, TypeError):
            break
        if not isinstance(args, dict) or not tc.get("id"):
            break
        jobs.append((tc["id"], fn["name"], args))
    if len(jobs) < 2:
        return {}
    import concurrent.futures as cf
    out = {}

    def quiet(n, a):
        # w wątku nikt nie pyta o zgodę (np. plik spoza projektu): taki odczyt idzie potem po kolei
        _ASK_LOCAL.no_ask, _ASK_LOCAL.needed = True, False
        try:
            r = run_tool(n, a, False)
            return None if _ASK_LOCAL.needed else r
        finally:
            _ASK_LOCAL.no_ask = False
    with cf.ThreadPoolExecutor(max_workers=min(8, len(jobs))) as pool:
        futs = {pool.submit(quiet, n, a): i for i, n, a in jobs}
        for f in cf.as_completed(futs):
            try:
                r = f.result()
                if r is not None:
                    out[futs[f]] = r
            except Exception:  # noqa: BLE001 — policzy się jeszcze raz po kolei
                pass  # nosec B110
    return out

