            _app_emit("renamed", id=SESSION.get("convo_id") or "",
                      title=SESSION.get("custom_title") or _convo_title([m for m in messages if m.get("role") != "system"]))
        elif kind == "resume":
            data = next((d for d in _convo_list() if d["id"] == msg.get("id")), None)
            if data:
                _convo_restore(data, messages)
                _app_emit("resumed", id=data["id"], title=data.get("title") or "", messages=_app_history(messages))
                _app_emit("machine", action="resume", busy=False, on=bool(SESSION.get("maszyna")),
                          chat_id=SESSION.get("lopus_chat_id") or "")
        elif kind == "undo":
            _undo_last()
            _app_emit("undone")
        elif kind == "google":
            akcja = str(msg.get("akcja") or "")
            usluga = str(msg.get("usluga") or "")
            try:
                if akcja == "polacz" and usluga in ("gmail", "kalendarz"):
                    url = api_call(load_creds(), "/cli/google/polacz", {"usluga": usluga}).get("url") or ""
                    _app_emit("google_url", usluga=usluga, url=url)
                elif akcja == "odlacz" and usluga in ("gmail", "kalendarz"):
                    api_call(load_creds(), "/cli/google/odlacz", {"usluga": usluga})
                elif akcja == "agenci":
