            "agent_limit": _L("limit planu"), "agent": _L("agent nie odpowiedział")}.get(
        err, _L("serwer nie odpowiada") if isinstance(err, int) and err >= 500 else _L("błąd"))


def _backup_brain(err, tried: set) -> str | None:
    """Następny mózg po nieudanej turze: najpierw zapas wybrany przez użytkownika, bez sieci także
    modele lokalne. Nic po błędach, których zmiana modelu nie naprawi (zła prośba, brak zgody)."""
    if err not in _FALLBACK_ERRORS:
        return None
    st = load_settings()
    if st.get("backup_brain_off"):
        return None
    cands = [str(st.get("backup_brain") or "")]
    if err == "net":
        cands += local_brains()
    net = online(force=True) if err == "net" else True
    for c in cands:
        if c and c not in tried and (net or not brain_needs_net(c)):
            return c
    return None


def brain_catchup(key: str | None, messages: list, fresh: bool = False) -> str:
    """Co ten mózg przegapił: wymiana z innymi mózgami od jego ostatniej tury (albo cała wcześniejsza
    rozmowa, gdy jeszcze tu nie pracował). Pusty tekst, gdy nic nie przegapił."""
    users = [i for i, m in enumerate(messages) if m.get("role") == "user"]
    if not users:
        return ""
    last = users[-1]
    seen = (SESSION.get("brain_seen") or {}).get(key) if key else None
    start = 1 if (fresh or seen is None) else max(1, seen)
    if start >= last:
        return ""
    lines = []
    for m in messages[start:last]:
        if m.get("role") in ("user", "assistant") and _msg_text(m) and not m.get("tool_calls"):
            who = _L("Użytkownik") if m["role"] == "user" else _L("Asystent")
            lines.append(f"{who}: {_msg_text(m)[:1500]}")
    if not lines:
        return ""
    head = (_L("Wcześniej w tej rozmowie (z innym modelem w Codo):") if (fresh or seen is None)
            else _L("W międzyczasie w tej rozmowie odpowiadał inny model w Codo:"))
    return head + "\n" + "\n\n".join(lines)[-8000:]


