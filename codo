def _windows_shell() -> tuple[str, str]:
    """(nazwa, ścieżka) PowerShella na Windows: pwsh 7 albo wbudowany 5.1."""
    import shutil
    for name in ("pwsh", "powershell"):
        found = shutil.which(name)
        if found:
            return name, found
    return "cmd", os.environ.get("COMSPEC", "cmd.exe")


def _posix_shell() -> str:
    import shutil
    login = os.environ.get("SHELL", "")
    if os.path.basename(login) in ("bash", "zsh") and os.path.exists(login):
        return login
    return shutil.which("bash") or "/bin/sh"


def _env_info() -> dict:
    if _ENV_CACHE:
        return _ENV_CACHE
    import platform
    import shutil
    info = {"arch": platform.machine() or "?", "python": platform.python_version()}
    if IS_WIN:
        ver = platform.version()
        info["os"] = f"Windows {platform.release()} ({ver})"
        name, path = _windows_shell()
        info["shell"] = {"pwsh": "PowerShell 7 (pwsh)", "powershell": "Windows PowerShell 5.1",
                         "cmd": "cmd.exe"}[name]
        info["shell_name"] = name
    elif IS_MAC:
        info["os"] = f"macOS {platform.mac_ver()[0] or platform.release()}"
        info["shell"] = os.path.basename(_posix_shell())
        info["shell_name"] = info["shell"]
    else:
        pretty = ""
        try:
            for line in Path("/etc/os-release").read_text().splitlines():
                if line.startswith("PRETTY_NAME="):
                    pretty = line.split("=", 1)[1].strip().strip('"')
        except OSError:
            pass
        info["os"] = f"Linux {pretty or platform.release()}"
        if "microsoft" in platform.release().lower():
            info["os"] += " (WSL)"
        info["shell"] = os.path.basename(_posix_shell())
        info["shell_name"] = info["shell"]
        info["root"] = hasattr(os, "geteuid") and os.geteuid() == 0
    info["tools"] = [t for t in _ENV_TOOLS if shutil.which(t)]
    cwd = Path.cwd()
    markers = {"package.json": "Node/JS", "pyproject.toml": "Python", "requirements.txt": "Python",
               "composer.json": "PHP", "Cargo.toml": "Rust", "go.mod": "Go", "pom.xml": "Java/Maven",
               "build.gradle": "Java/Gradle", "Gemfile": "Ruby", "index.html": "strona statyczna",
               "wp-config.php": "WordPress", "Dockerfile": "Docker", "docker-compose.yml": "Docker Compose",
               "Package.swift": "Swift", "pubspec.yaml": "Flutter", "artisan": "Laravel", "manage.py": "Django",
               "next.config.js": "Next.js", "vite.config.ts": "Vite", "vite.config.js": "Vite"}
    try:
        info["project"] = sorted({v for k, v in markers.items() if (cwd / k).exists()})
        info["git"] = (cwd / ".git").exists()
    except OSError:
        info["project"], info["git"] = [], False
    _ENV_CACHE.update(info)
    return _ENV_CACHE


