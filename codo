def _agent_bin(kind: str) -> str | None:
    """Ścieżka programu agenta. Dla ACP: jego plik ACP (adapter albo ten sam program) i wymagane dodatki."""
    import shutil
    env = os.environ.get("CODO_AGENT_" + kind.upper().replace("-", "_"))
    if env:
        return env if os.path.isfile(env) or shutil.which(env) else None
    info = _AGENTS[kind]
    bins = info.get("acp_bin") if info.get("native") and info.get("acp_bin") and _agent_acp(kind) else info["bin"]
    if info.get("needs") and not any(shutil.which(n) or os.path.isfile(os.path.expanduser(n))
                                     for n in info["needs"]):
        return None
    # Na serwerze (usługa, ssh bez powłoki logowania) PATH bywa ubogi: zajrzyj też tam, gdzie instalatory kładą agentów.
    extra = os.pathsep.join(os.path.expanduser(d) for d in (
        "~/.local/bin", "~/.claude/local", "~/.npm-global/bin", "~/.bun/bin", "~/.volta/bin", "/usr/local/bin", "/opt/homebrew/bin"))
    for b in ([bins] if isinstance(bins, str) else bins):
        found = shutil.which(b) or shutil.which(b, path=extra)
        if found:
            return found
    return None


_SHIM_RE = re.compile(r'"([^"]+)"\s+"%(?:dp0%|~dp0)\\?([^"]+)"\s+%\*')


def _win_unshim(argv: list) -> list:
    """Windows: shim .cmd (npm instaluje claude.cmd, codex.cmd, gemini.cmd) uruchamiany wprost jako node + skrypt.
    Przez .cmd argumenty idą przez cmd.exe: wieloliniowy --append-system-prompt urywał się na pierwszym końcu
    linii (persona agenta nie docierała), a %, ^, & i | w treści cmd.exe interpretował po swojemu."""
    if not IS_WIN or not argv or not str(argv[0]).lower().endswith((".cmd", ".bat")):
        return argv
    import shutil
    shim = Path(argv[0])
    try:
        m = _SHIM_RE.search(shim.read_text(encoding="utf-8", errors="replace"))
    except OSError:
        return argv
    if not m:
        return argv
    prog, script = m.group(1), shim.parent / m.group(2).lstrip("\\/")
    if prog == "%_prog%":   # npm cmd-shim: node.exe obok shima albo node z PATH
        local = shim.parent / "node.exe"
        prog = str(local) if local.is_file() else (shutil.which("node") or "")
    if not prog or "%" in prog or not script.is_file():
        return argv
    return [prog, str(script), *[str(a) for a in argv[1:]]]


def agents_available() -> list:
    """Wykryte agenty: [(kind, ścieżka)] w stałej kolejności."""
    if load_settings().get("agents_off"):
        return []
    return [(k, p) for k in _AGENTS for p in [_agent_bin(k)] if p]


def _agent_version(path: str) -> str:
    try:
        out = subprocess.run(_win_unshim([path, "--version"]), capture_output=True, text=True, timeout=8,
                             stdin=subprocess.DEVNULL).stdout.strip()
    except (OSError, subprocess.SubprocessError):
        return ""
    m = re.search(r"\b\d+\.\d+(\.\d+)?\b", out.splitlines()[0] if out else "")
    return m.group(0) if m else ""


