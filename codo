def _clip_middle(text: str, cap: int) -> str:
    """Długi wynik: początek i KONIEC (błędy testów, podsumowania i stopka „dalej: offset=…” są na końcu).
    Do 0.28.0 zostawał tylko początek, więc model nie widział, czym skończyła się komenda."""
    if len(text) <= cap:
        return text
    head = int(cap * 0.35)
    tail = cap - head - 200
    cut = text[head:len(text) - tail]
    lines = cut.count("\n")
    return (text[:head] + f"\n\n… [pominięto {len(cut)} znaków, {lines} linii ze środka; "
            "zawęź wynik: grep, | tail, offset/limit] …\n\n" + text[len(text) - tail:])


