_SECRET_RES = (
    re.compile(r"\bsk-(?:ant-|proj-|live-|test-)?[A-Za-z0-9_\-]{12,}"),
    re.compile(r"\b(?:ghp|gho|ghs|ghu|ghr|github_pat)_[A-Za-z0-9_]{12,}"),
    re.compile(r"\bxox[abprs]-[A-Za-z0-9\-]{8,}"),
    re.compile(r"\bBearer\s+[A-Za-z0-9._~+/=\-]{12,}", re.I),
    re.compile(r"\bAKIA[0-9A-Z]{16}\b"),
    re.compile(r"\bAIza[0-9A-Za-z_\-]{30,}"),
    re.compile(r"-----BEGIN [A-Z ]*PRIVATE KEY-----"),
    re.compile(r"(?i)\b(?:hasło|haslo|password|passwd|pwd|token|api[_ -]?key|secret|sekret)\s*[:=]\s*\S{6,}"),
    re.compile(r"\b[0-9a-fA-F]{48,}\b"),
)
_PL_FOLD = str.maketrans("ąćęłńóśźżäöüéèáíúàâêîôûç", "acelnoszzaoueeaiuaaeiouc")
_HOST_SKILL_LINE = re.compile(r"^\s*[-*]?\s*`?(?:UMIEJĘTNOŚĆ|UMIEJETNOSC|SKILL):\s*(.+?)`?\s*$")
_HOST_PROFILE_LINE = re.compile(r"^\s*[-*]?\s*`?(?:O UŻYTKOWNIKU|O UZYTKOWNIKU|ABOUT THE USER|ABOUT USER):\s*(.+?)`?\s*$")


def _secret_like(text: str) -> bool:
    """Wygląda na hasło, token albo klucz: takich rzeczy agent nie zapisuje w umiejętnościach ani w profilu."""
    t = str(text or "")
    if any(r.search(t) for r in _SECRET_RES):
        return True
    # długi ciąg jak base64: litery obu wielkości i cyfry, bez ukośników i myślników (to bywają ścieżki)
    for run in re.findall(r"[A-Za-z0-9+=_]{40,}", t):
        if re.search(r"[a-z]", run) and re.search(r"[A-Z]", run) and re.search(r"[0-9]", run):
            return True
    return False


def _fold(text: str) -> str:
    """Małe litery bez polskich znaków (ą→a, ł→l…): długość się nie zmienia, więc pozycje pasują do oryginału."""
    out = []
    for ch in str(text or ""):
        low = ch.lower()
        out.append((low if len(low) == 1 else ch).translate(_PL_FOLD))
    return "".join(out)


def _host_needs_block(model: str) -> bool:
    """Mózgi, którym Codo nie daje narzędzi (agent DomaAI w chmurze, agenci we własnym trybie): piszą blokiem i liniami."""
    m = str(model or "").lower()
    if m in ("lopus", "lopus-pro"):
        return True
    if m.startswith("agent:"):
        return m not in ("agent:claude", "agent:codex")
    return False


def _skill_key(name: str) -> str:
    return re.sub(r"\s+", " ", _fold(name)).strip()


def _skill_put(skills: list, name: str, when: str, text: str, strict: bool = True) -> tuple:
    """Zapisuje albo poprawia umiejętność (ta sama nazwa = ta sama umiejętność). Zwraca (lista, komunikat, błąd)."""
    name = re.sub(r"\s+", " ", str(name or "")).strip(" `*:")[:80]
    when = re.sub(r"\s+", " ", str(when or "")).strip()[:240]
    text = str(text or "").strip()
    if not name or not text:
        return skills, "", "Podaj nazwę i treść umiejętności (kroki i pułapki)."
    if len(text) > _SKILL_TEXT_MAX:
        if strict:
            return skills, "", f"Treść jest za długa ({len(text)} znaków, limit {_SKILL_TEXT_MAX}). Skróć ją do sedna: kroki i pułapki."
        text = text[:_SKILL_TEXT_MAX]
    if _secret_like(name + " " + when + " " + text):
        return skills, "", ("Nie zapisano: treść wygląda na hasło, token albo klucz. Umiejętność ma opisywać, jak coś zrobić, "
                            "bez sekretów; napisz, skąd je wziąć (np. z ustawień), a nie same wartości.")
    now = _now_iso()
    out = [dict(s) for s in skills if isinstance(s, dict) and s.get("nazwa")]
    key = _skill_key(name)
    old = next((s for s in out if _skill_key(s["nazwa"]) == key), None)
    if old:
        old.update({"tresc": text, "zmieniona": now})   # nazwa zostaje, jak była: lista się nie miesza
        if when:
            old["kiedy"] = when
        return out, f"Poprawiono umiejętność «{old['nazwa']}».", ""
    note = ""
    if len(out) >= _SKILL_MAX:
        drop = min(out, key=lambda s: (int(s.get("uzycia") or 0), str(s.get("zmieniona") or "")))
        out.remove(drop)
        note = f" Limit {_SKILL_MAX} umiejętności: usunięto najrzadziej używaną «{drop['nazwa']}»."
    out.append({"nazwa": name, "kiedy": when, "tresc": text, "uzycia": 0, "utworzona": now, "zmieniona": now})
    return out, f"Zapisano umiejętność «{name}»." + note, ""


def _skills_ranked(skills: list) -> list:
    """Najczęściej używane pierwsze, przy remisie świeżo poprawione."""
    rows = [s for s in skills or [] if isinstance(s, dict) and s.get("nazwa")]
    return sorted(rows, key=lambda s: (int(s.get("uzycia") or 0), str(s.get("zmieniona") or "")), reverse=True)


def _skills_merge(mine: list, theirs: list) -> list:
    """Dwie wersje tej samej listy (Mac i serwer): po nazwie wygrywa świeższa, licznik użyć większy."""
    by = {}
    for s in list(theirs or []) + list(mine or []):
        if not isinstance(s, dict) or not s.get("nazwa"):
            continue
        k = _skill_key(s["nazwa"])
        o = by.get(k)
        if o is None:
            by[k] = dict(s)
            continue
        uses = max(int(o.get("uzycia") or 0), int(s.get("uzycia") or 0))
        if str(s.get("zmieniona") or "") >= str(o.get("zmieniona") or ""):
            by[k] = dict(s)
        by[k]["uzycia"] = uses
    return _skills_ranked(list(by.values()))[:_SKILL_MAX]


def _profile_add(profile: list, fact: str) -> tuple:
    """Dopisuje fakt do wspólnego profilu. Zwraca (profil, komunikat, błąd)."""
    f = re.sub(r"\s+", " ", str(fact or "")).strip(" `-")[:300]
    if not f:
        return profile, "", "Pusty fakt."
    if _secret_like(f):
        return profile, "", "Nie zapisano: to wygląda na hasło, token albo klucz. Do profilu trafiają tylko preferencje i stałe fakty o pracy."
    rows = [str(p) for p in profile or [] if str(p).strip()]
    if _fold(f) in [_fold(p) for p in rows]:
        return rows, "To już jest w profilu użytkownika.", ""
    rows.append(f)
    return rows[-_PROFILE_MAX:], "Dopisano do profilu użytkownika (widzą go wszyscy stali agenci).", ""


def _profile_merge(a: list, b: list) -> list:
    rows, seen = [], set()
    for p in list(a or []) + list(b or []):
        p = str(p).strip()
        if p and _fold(p) not in seen:
            seen.add(_fold(p))
            rows.append(p)
    return rows[-_PROFILE_MAX:]


def _take_skill_lines(answer: str) -> tuple:
    """Linie `UMIEJĘTNOŚĆ: nazwa | kiedy | treść` i `O UŻYTKOWNIKU: fakt` z końca odpowiedzi: nie dla oczu człowieka."""
    skills, facts, kept = [], [], []
    for ln in str(answer or "").splitlines():
        ms, mp = _HOST_SKILL_LINE.match(ln), _HOST_PROFILE_LINE.match(ln)
        if ms:
            parts = [p.strip() for p in ms.group(1).split("|", 2)]
            if len(parts) == 2:
                parts = [parts[0], "", parts[1]]
            if len(parts) == 3 and parts[0] and parts[2]:
                skills.append(tuple(parts))
        elif mp:
            facts.append(mp.group(1).strip())
        else:
            kept.append(ln)
    return "\n".join(kept).strip(), skills[:3], facts[:3]


def _skills_persona(skills: list, on: bool, block: bool) -> str:
    """Sekcja persony: umiejętności agenta i jak się uczyć nowych."""
    rows = _skills_ranked(skills)
    out = ""
    if rows:
        if block:
            full = rows[:_SKILL_FULL_IN_PERSONA]
            out += "\n\nTWOJE UMIEJĘTNOŚCI (przepisy, których sam się nauczyłeś; najczęściej używane w całości):\n" + "\n\n".join(
                f"### {s['nazwa']}" + (f" (kiedy: {s.get('kiedy')})" if s.get("kiedy") else "") + "\n" + str(s.get("tresc") or "")[:_SKILL_TEXT_MAX]
                for s in full)
            rest = rows[_SKILL_FULL_IN_PERSONA:_SKILL_IN_PERSONA]
            if rest:
                out += "\n\nPozostałe (tylko nazwy):\n" + "\n".join("- " + s["nazwa"] + (": " + s["kiedy"] if s.get("kiedy") else "") for s in rest)
        else:
            out += ("\n\nTWOJE UMIEJĘTNOŚCI (przepisy, których sam się nauczyłeś; zanim zaczniesz takie zadanie, weź pełną treść: "
                    "narzędzie agenci, akcja=umiejetnosc, nazwa=...):\n"
                    + "\n".join("- " + s["nazwa"] + (": " + s["kiedy"] if s.get("kiedy") else "") for s in rows[:_SKILL_IN_PERSONA]))
    if on:
        how = ("linią na samym końcu odpowiedzi `UMIEJĘTNOŚĆ: <nazwa> | <kiedy jej użyć, jedno zdanie> | <kroki i pułapki w jednej linii>`"
               if block else "narzędziem agenci (akcja=umiejetnosc, nazwa, kiedy, tresc) albo linią na samym końcu odpowiedzi "
               "`UMIEJĘTNOŚĆ: <nazwa> | <kiedy jej użyć, jedno zdanie> | <kroki i pułapki w jednej linii>`")
        out += ("\n\nUCZYSZ SIĘ: gdy zrobisz coś niebanalnego, co może się powtórzyć (kilka kroków, konkretne miejsca, pułapki), "
                f"zapisz to jako umiejętność {how}. Gdy przepis zawiódł albo znalazłeś lepszą drogę, zapisz go pod tą samą nazwą: "
                f"to go poprawi. Nie zapisuj banałów, danych osobowych ani haseł, tokenów i kluczy. Treść do {_SKILL_TEXT_MAX} znaków.")
    return out


def _profile_persona(profile: list, on: bool, block: bool) -> str:
    rows = [str(p) for p in profile or [] if str(p).strip()][-_PROFILE_IN_PERSONA:]
    out = ""
    if rows:
        out += "\n\nO UŻYTKOWNIKU (wspólne dla agentów, może być nieaktualne):\n" + "\n".join("- " + p for p in rows)
    if on:
        out += ("\n\nGdy poznasz trwały fakt o użytkowniku, przydatny wszystkim jego agentom (preferencja, styl, stałe dane pracy), "
                + ("dopisz go linią `O UŻYTKOWNIKU: <fakt>` na końcu odpowiedzi."
                   if block else "dopisz go: narzędzie agenci, akcja=profil, fakt=... albo linia `O UŻYTKOWNIKU: <fakt>` na końcu odpowiedzi.")
                + " Bez danych wrażliwych (zdrowie, finanse, poglądy), haseł i tokenów; nie powtarzaj tego, co już jest.")
    if not block:
        out += ("\n\nGdy użytkownik nawiązuje do czegoś sprzed tej rozmowy, przeszukaj swoje dawne rozmowy: narzędzie agenci, "
                "akcja=szukaj, fraza=...")
    return out


def _search_rows(rows: list, phrase: str, limit: int = 8) -> list:
    """rows: (kiedy, kto, tekst) od najstarszych. Wszystkie słowa frazy, bez wielkości liter i polskich znaków; od najnowszych."""
    words = [w for w in re.split(r"\s+", _fold(phrase).strip()) if w]
    if not words:
        return []
    out = []
    for when, who, text in reversed(rows):
        t = str(text or "")
        f = _fold(t)
        if not all(w in f for w in words):
            continue
        at = f.find(words[0])
        a, b = max(0, at - 200), min(len(t), at + len(words[0]) + 200)
        frag = ("…" if a > 0 else "") + t[a:b].strip() + ("…" if b < len(t) else "")
        out.append({"kiedy": when, "kto": who, "fragment": frag})
        if len(out) >= limit:
            break
    return out


# ── harmonogram sprawdzania i spokojna praca w tle na gospodarzu (24.11.2026) ──
# Te same reguły co w oknie Codo na Macu, jako czyste funkcje (bez stanu, sama biblioteka standardowa): dni tygodnia,
# dokładna minuta w strefie Maca, dni kalendarzowe zamiast 24 h, jedno nadrobienie po przerwie; dzienny limit pracy
# w tle, godziny ciszy i wspólna wiadomość po nich. Chwile to sekundy od 1970, „tz” to strefa albo None (czas serwera).
_BEAT_DAY = 1440
_BEAT_KEYS = ("days", "at", "set", "zone")
_CALM_LIMIT, _CALM_CAP, _CALM_ASK_EXPIRY, _CALM_HELD_MAX = 100, 300, 900, 40
_HOST_EXTRA = ("cap", "quiet", "zone")     # ustawienia z agents.json poza agentami; gospodarz ich nie gubi przy zapisie


def _beat_tz(zone):
    """Strefa po nazwie IANA; None = czas lokalny serwera (brak nazwy, nieznana strefa, serwer bez bazy stref)."""
    name = str(zone or "").strip()
    if not name:
        return None
    try:
        import zoneinfo
        return zoneinfo.ZoneInfo(name)
    except (ImportError, KeyError, ValueError, OSError):
        return None


def _beat_wall(ts: float, tz):
    """Czas zegarowy (bez strefy) danej chwili."""
    import datetime as _dt
    return _dt.datetime.fromtimestamp(ts, tz).replace(tzinfo=None) if tz else _dt.datetime.fromtimestamp(ts)


def _beat_stamp(wall, tz) -> float:
    """Chwila dla czasu zegarowego. Pora, którą zegar przeskakuje (noc zmiany na czas letni), staje się pierwszą po niej;
    pora, która wypada dwa razy (zmiana na zimowy), jest tą pierwszą."""
    import datetime as _dt

    def ts(w) -> float:
        return w.replace(tzinfo=tz).timestamp() if tz else w.timestamp()
    if _beat_wall(ts(wall), tz) == wall:
        return ts(wall)
    back = wall
    for _ in range(240):
        back -= _dt.timedelta(minutes=1)
        if _beat_wall(ts(back), tz) == back:
            return ts(back) + 60
    return ts(wall)


def _beat_slot(minute: int, day, tz) -> float:
    """Ta minuta doby tego dnia."""
    import datetime as _dt
    return _beat_stamp(_dt.datetime.combine(day, _dt.time()) + _dt.timedelta(minutes=minute), tz)


def _beat_modern(beat: dict) -> bool:
    """Harmonogram z nowego okna Codo (ma choć jeden nowy klucz); bez nich gospodarz liczy po staremu."""
    return any(k in beat for k in _BEAT_KEYS)


def _beat_plan(beat: dict) -> dict:
    """Plan z obiektu „beat” w agents.json: co ile minut, w jakich godzinach, w które dni (1 poniedziałek … 7 niedziela;
    None = codziennie) i o której minucie doby (None = decydują godziny)."""
    def num(key: str, default: int) -> int:
        try:
            return int(beat.get(key, default))
        except (TypeError, ValueError):
            return default
    raw = beat.get("days")
    days = frozenset(int(d) for d in raw if isinstance(d, (int, float)) and 1 <= int(d) <= 7) if isinstance(raw, list) else None
    at = beat.get("at")
    return {"minutes": max(0, num("minutes", 0)), "from": num("from", 8), "to": num("to", 22), "days": days or None,
            "at": int(at) if isinstance(at, (int, float)) and not isinstance(at, bool) else None}


def _beat_last(beat: dict):
    """Ostatnie sprawdzenie albo chwila ustawienia harmonogramu, co późniejsze; None = nigdy."""
    def num(key: str) -> float:
        try:
            return float(beat.get(key) or 0)
        except (TypeError, ValueError):
            return 0.0
    return max(num("last"), num("set")) or None


def _beat_allowed(p: dict, day) -> bool:
    return not p["days"] or day.isoweekday() in p["days"]


def _beat_exact(p: dict):
    """Dokładna minuta doby, gdy plan ją ma (tylko sprawdzanie raz dziennie albo rzadziej)."""
    if p["minutes"] < _BEAT_DAY or p["at"] is None:
        return None
    return min(max(p["at"], 0), _BEAT_DAY - 1)


def _beat_whole_days(p: dict):
    """Ile pełnych dni między sprawdzeniami dla planu raz dziennie albo rzadziej w godzinach (None dla pozostałych)."""
    return p["minutes"] // _BEAT_DAY if p["minutes"] >= _BEAT_DAY and p["at"] is None and p["from"] != p["to"] else None


def _beat_counted_day(p: dict, ts: float, tz):
    """Dzień, do którego liczy się chwila: godziny przez północ należą do wieczoru, w którym się zaczęły."""
    import datetime as _dt
    w = _beat_wall(ts, tz)
    return w.date() - _dt.timedelta(days=1) if p["from"] > p["to"] and w.hour < p["to"] else w.date()


def _beat_within(p: dict, ts: float, tz) -> bool:
    """Chwila wypada w godzinach planu, w jeden z jego dni. Plan z dokładną minutą nie ma godzin."""
    if _beat_exact(p) is not None:
        return _beat_allowed(p, _beat_wall(ts, tz).date())
    h, lo, hi = _beat_wall(ts, tz).hour, p["from"], p["to"]
    inside = True if lo == hi else (lo <= h < hi if lo < hi else (h >= lo or h < hi))
    return inside and _beat_allowed(p, _beat_counted_day(p, ts, tz))


def _beat_days_passed(a: float, b: float, tz) -> int:
    return (_beat_wall(b, tz).date() - _beat_wall(a, tz).date()).days


def _beat_need(p: dict) -> int:
    """Ile dni musi minąć od ostatniego sprawdzenia przy dokładnej minucie: dni tygodnia same wskazują dzień, bez nich liczymy."""
    period = max(1, p["minutes"] // _BEAT_DAY)
    return max(1, period - 6) if p["days"] else period


def _beat_window_start(p: dict, ts: float, tz) -> float:
    """Kiedy zaczęły się godziny, w które wypada chwila."""
    return _beat_slot(p["from"] * 60, _beat_counted_day(p, ts, tz), tz)


def _beat_window_end(p: dict, start: float, tz) -> float:
    import datetime as _dt
    day = _beat_wall(start, tz).date()
    return _beat_slot(p["to"] * 60, day if p["from"] < p["to"] else day + _dt.timedelta(days=1), tz)


def _beat_planned(p: dict, last, now: float, tz):
    """Zaplanowana pora, na którą teraz wypada sprawdzenie (None: nic nie wypada)."""
    if p["minutes"] <= 0:
        return None
    at = _beat_exact(p)
    if at is not None:
        # dokładna minuta; przegapiona (gospodarz nie działał) nadrabia się raz, później tego samego dnia
        today = _beat_wall(now, tz).date()
        if not _beat_allowed(p, today):
            return None
        s = _beat_slot(at, today, tz)
        if now < s:
            return None
        if last is None:
            return s
        if last >= s:
            return None
        n = _beat_need(p)
        return None if n > 1 and _beat_days_passed(last, now, tz) < n else s
    if not _beat_within(p, now, tz):
        return None
    if last is None:
        return now
    gone, after = now - last, last + p["minutes"] * 60
    days = _beat_whole_days(p)
    if days is None:
        return after if gone >= p["minutes"] * 60 else None
    # raz dziennie albo rzadziej w godzinach: następnego dnia w swoich godzinach, kiedykolwiek było ostatnie
    # (ręczne po południu nie zabiera poranka); przez północ nie dwa razy tej samej nocy
    opened = _beat_window_start(p, now, tz)
    if gone >= p["minutes"] * 60:
        return max(opened, min(after, now))
    ok = _beat_days_passed(last, now, tz) >= days and (p["from"] < p["to"] or gone >= ((p["to"] - p["from"] + 24) % 24) * 3600)
    return opened if ok else None


def _beat_next(p: dict, last, now: float, tz):
    """Następne sprawdzenie, licząc od teraz (teraz, gdy już wypada); None = nie widać."""
    import datetime as _dt
    if p["minutes"] <= 0:
        return None
    if _beat_planned(p, last, now, tz) is not None:
        return now
    reach = min(800, max(1, p["minutes"] // _BEAT_DAY) + 9)
    at = _beat_exact(p)
    if at is not None:
        today = _beat_wall(now, tz).date()
        for i in range(reach + 1):
            s = _beat_slot(at, today + _dt.timedelta(days=i), tz)
            if s > now and _beat_planned(p, last, s, tz) is not None:
                return s
        return None
    if last is not None:
        after = last + p["minutes"] * 60
        if after > now and _beat_whole_days(p) is None and _beat_planned(p, last, after, tz) is not None:
            return after
    t = now
    for _ in range(24 * reach):
        w = _beat_wall(t, tz).replace(minute=0, second=0, microsecond=0) + _dt.timedelta(hours=1)
        t = max(_beat_stamp(w, tz), t + 60)
        if _beat_planned(p, last, t, tz) is not None:
            return t
    return None


def _beat_missed(p: dict, last, now: float, tz):
    """Zaplanowana pora, która minęła bez sprawdzenia i nie będzie nadrobiona (najnowsza). Tylko plany raz dziennie
    albo rzadziej mają takie pory; częste po prostu idą dalej."""
    import datetime as _dt
    if p["minutes"] < _BEAT_DAY or last is None:
        return None
    today = _beat_wall(now, tz).date()
    at = _beat_exact(p)
    if at is not None:
        if _beat_need(p) > 1 and not p["days"]:
            return None        # dni liczone, nie nazwane: przegapiony dzień robi się następnego
        for i in range(1, 9):
            s = _beat_slot(at, today - _dt.timedelta(days=i), tz)
            if s <= last:
                return None
            if _beat_planned(p, last, s, tz) is not None:
                return s
        return None
    if _beat_whole_days(p) is None:
        return None
    for i in range(9):
        s = _beat_slot(p["from"] * 60, today - _dt.timedelta(days=i), tz)
        if s <= last:
            return None
        if _beat_window_end(p, s, tz) > now:
            continue
        if _beat_planned(p, last, s, tz) is not None:
            return s
    return None


def _beat_caught_up(planned: float, now: float, awake: float, slack: float = 120) -> bool:
    """Sprawdzenie robione teraz było zaplanowane na „planned”: to nadrobienie, gdy tamta pora minęła, zanim gospodarz
    wstał („awake”: od kiedy działa bez przerwy)."""
    return now - planned > slack and planned < awake


def _beat_when(ts: float, tz) -> str:
    """„24.11.2026, 7:30” w strefie harmonogramu."""
    w = _beat_wall(ts, tz)
    return f"{w.day}.{w.month:02d}.{w.year}, {w.hour}:{w.minute:02d}"


def _calm_int(value, default: int) -> int:
    """Limit z agents.json: brak albo śmieć = domyślny, 0 = bez limitu."""
    if value is None or isinstance(value, bool):
        return default
    try:
        return max(0, int(value))
    except (TypeError, ValueError):
        return default


def _calm_kind(origin, deliver: bool = False) -> str:
    """Skąd przyszła tura: mac, channel, beat, agent, reply (odpowiedź, która wróciła później), handoff."""
    kind = str((origin or ("",))[0])
    return "reply" if kind == "agent" and deliver else kind


def _calm_background(kind: str, by_you: bool = False, depth: int = 0) -> bool:
    """Praca, której nikt nie wpisał: sprawdzanie, wiadomość albo zadanie od innego agenta, odpowiedź po czasie,
    w pokoju agent wciągnięty przez innego agenta (AgentCalm.background na Macu)."""
    return kind in ("beat", "trigger", "agent", "reply") or (kind == "handoff" and not by_you) or (kind == "room" and depth > 0)


def _calm_cost(credits, before: float) -> tuple:
    """Koszt tury z rosnącego licznika kredytów silnika: (koszt albo None, gdy mózg nie podaje ceny; nowy stan licznika).
    Licznik mniejszy niż poprzednio znaczy nowy proces silnika, więc cały jest kosztem tej tury."""
    try:
        c = float(credits)
    except (TypeError, ValueError):
        return None, before
    spent = c - before if c >= before else c
    return (round(spent, 4) if spent > 0 else None), c


def _calm_add(row, spent) -> dict:
    """Dopisuje turę do dziennego wydatku agenta; tura bez ceny liczy się jako 1."""
    r = row if isinstance(row, dict) else {}
    out = {"credits": float(r.get("credits") or 0), "turns": int(r.get("turns") or 0) + 1, "unpriced": int(r.get("unpriced") or 0)}
    if spent and spent > 0:
        out["credits"] = round(out["credits"] + float(spent), 4)
    else:
        out["unpriced"] += 1
    return out


def _calm_used(row) -> float:
    """Co liczy się do limitu: kredyty i po jednym za każdą turę bez ceny."""
    r = row if isinstance(row, dict) else {}
    return float(r.get("credits") or 0) + int(r.get("unpriced") or 0)


def _calm_stop(used: float, limit: int, all_used: float, cap: int) -> str:
    """Dlaczego dziś koniec pracy w tle: "agent" (własny limit), "all" (wspólny) albo "" (wolno). Limit 0 = brak."""
    if limit > 0 and used >= limit:
        return "agent"
    if cap > 0 and all_used >= cap:
        return "all"
    return ""


def _calm_day(ts: float, tz) -> str:
    return _beat_wall(ts, tz).strftime("%Y-%m-%d")


def _calm_limit_words(n: int, row) -> str:
    """Limit w jednostce, w której liczy się ten agent: kredyty albo tury, gdy jego mózg nie podaje ceny."""
    r = row if isinstance(row, dict) else {}
    if not float(r.get("credits") or 0) and int(r.get("unpriced") or 0):
        return f"{n} {_plural(n, ('tura', 'tury', 'tur'))}"
    return f"{n} 𝔻"


def _calm_quiet_cfg(raw):
    """Godziny ciszy z agents.json: (od, do, strefa) albo None (wyłączone; ta sama godzina dwa razy to też brak)."""
    if not isinstance(raw, dict):
        return None
    try:
        lo, hi = int(raw.get("from", 22)) % 24, int(raw.get("to", 7)) % 24
    except (TypeError, ValueError):
        return None
    return None if lo == hi else (lo, hi, str(raw.get("zone") or ""))


def _calm_quiet(hour: int, lo: int, hi: int) -> bool:
    """Godzina wypada w ciszy (od 22 do 7 idzie przez północ)."""
    if lo == hi:
        return False
    return lo <= hour < hi if lo < hi else (hour >= lo or hour < hi)


def _calm_quiet_end(now: float, lo: int, hi: int, tz):
    """Kiedy kończy się cisza, która trwa teraz (None: teraz nie ma ciszy)."""
    import datetime as _dt
    w = _beat_wall(now, tz)
    if not _calm_quiet(w.hour, lo, hi):
        return None
    end = _beat_slot(hi * 60, w.date(), tz)
    return end if end > now else _beat_slot(hi * 60, w.date() + _dt.timedelta(days=1), tz)


def _calm_digest(items: list, name: str, tz) -> str:
    """Wszystko, co agent wstrzymał w ciszy, jako jedna wiadomość: jedno zgłoszenie idzie bez zmian, więcej dostaje
    nagłówek i swoje godziny."""
    rows = sorted((h for h in items if isinstance(h, dict) and h.get("text")), key=lambda h: float(h.get("at") or 0))
    if not rows:
        return ""
    if len(rows) == 1:
        return str(rows[0]["text"])
    own, parts = name + "\n\n", []
    for h in rows:
        text, w = str(h["text"]), _beat_wall(float(h.get("at") or 0), tz)
        parts.append(f"{w.hour}:{w.minute:02d}\n" + (text[len(own):] if name and text.startswith(own) else text))
    return f"«{name}», wiadomości z godzin ciszy: {len(rows)}\n\n" + "\n\n".join(parts)


