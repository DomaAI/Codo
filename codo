# @plik: treść pliku dołączana do wiadomości (Tab podpowiada ścieżki)
_AT_RE = re.compile(r"(?<![\w@/.])@((?:\"[^\"]+\")|[^\s,;:!?()\[\]{}<>\"']+)")


def _at_path(token: str):
    raw = token.strip('"')
    raw = raw.rstrip(".")
    if not raw:
        return None
    p = Path(os.path.expanduser(raw))
    if not p.is_absolute():
        p = Path.cwd() / p
    try:
        return p if p.exists() else None
    except OSError:
        return None


def _expand_mentions(task: str) -> tuple[str, list]:
    """Zwraca (wiadomość z dołączonymi plikami, lista dołączonych ścieżek).
    Nieistniejące @coś (np. adres e-mail, @user) zostaje zwykłym tekstem."""
    blocks, names, budget = [], [], _ATTACH_MAX
    for match in _AT_RE.finditer(task):
        path = _at_path(match.group(1))
        if path is None:
            continue
        try:
            rel = str(path.resolve().relative_to(Path.cwd().resolve()))
        except ValueError:
            rel = str(path)
        if rel in names:
            continue
        if path.is_dir():
            try:
                entries = sorted(path.iterdir(), key=lambda e: (not e.is_dir(), e.name.lower()))
            except OSError as e:
                blocks.append(f"[@{rel}: nie mogę odczytać folderu: {e}]")
                continue
            listing = [e.name + ("/" if e.is_dir() else "") for e in entries
                       if e.name not in (".git", "node_modules", "__pycache__", _DOMA_DIR)][:200]
            body = "\n".join(listing) or "(pusty folder)"
            blocks.append(f"<folder sciezka=\"{rel}\">\n{body}\n</folder>")
        else:
            try:
                raw = path.read_bytes()
            except OSError as e:
                blocks.append(f"[@{rel}: nie mogę odczytać pliku: {e}]")
                continue
            if b"\x00" in raw[:4096]:
                blocks.append(f"[@{rel}: plik binarny ({len(raw)} B), nie dołączam treści]")
                names.append(rel)
                continue
            text = raw.decode("utf-8", errors="replace")
            limit = min(_ATTACH_FILE_MAX, budget)
            if limit <= 0:
                blocks.append(f"[@{rel}: pominięty, przekroczony łączny limit dołączonych plików; użyj read_file]")
                continue
            cut = len(text) > limit
            text = text[:limit]
            budget -= len(text)
            note = f"\n… (ucięte, plik ma {len(raw)} B; resztę przeczytaj read_file)" if cut else ""
            blocks.append(f"<plik sciezka=\"{rel}\">\n{text}{note}\n</plik>")
        names.append(rel)
    if not blocks:
        return task, []
    return task + "\n\nDołączone przez użytkownika (@):\n" + "\n\n".join(blocks), names


def _at_matches(value: str) -> list:
    """Podpowiedzi ścieżek dla ostatniego słowa zaczynającego się od @."""
    if value.startswith("/") or not value or value[-1].isspace():
        return []
    word = re.split(r"\s", value)[-1]
    if not word.startswith("@") or word.startswith("@\""):
        return []
    typed = word[1:]
    base_dir, prefix = os.path.split(typed)
    root = Path.cwd() / os.path.expanduser(base_dir) if base_dir else Path.cwd()
    try:
        entries = sorted(root.iterdir(), key=lambda e: (not e.is_dir(), e.name.lower()))
    except OSError:
        return []
    out = []
    for e in entries:
        name = e.name
        if not name.lower().startswith(prefix.lower()):
            continue
        if name.startswith(".") and not prefix.startswith("."):
            continue
        if name in ("node_modules", "__pycache__", ".git"):
            continue
        # Folder tak, jak go wpisano (src/ zostaje src/, także na Windows, gdzie os.path.join dałby src\\).
        full = typed[:len(typed) - len(prefix)] + name + ("/" if e.is_dir() else "")
        out.append(("@" + full, _L("folder") if e.is_dir() else _L("plik")))
        if len(out) >= 8:
            break
    return out


def _bang(command: str, messages: list) -> None:
    """!polecenie: uruchamia komendę od razu (wpisał ją sam użytkownik, bez pytania)
    i zapamiętuje wynik, żeby agent znał go przy następnej wiadomości."""
    command = command.strip()
    if not command:
        print(dim(_L("  Użycie: !git status  (komenda od razu, wynik trafia do kontekstu agenta)")))
        return
    with LIVE.paused():
        result = t_run_command({"command": command, "timeout": 600}, auto_yes=True)
        lines = result.rstrip().splitlines()
        head, body = (lines[0], lines[1:]) if lines else ("", [])
        if len(body) > _BANG_SHOW:
            print(dim(_Lf('  … {0} wcześniejszych linii', len(body) - _BANG_SHOW)))
        for line in body[-_BANG_SHOW:]:
            print("  " + _terminal_text(line))
        ok = head.startswith("exit=0")
        print((green("  ✓ ") if ok else red("  ✗ ")) + dim(head or _L("bez wyniku")))
    if len(result) > 12_000:
        result = _L("… (początek wyniku pominięty)\n") + result[-12_000:]
    SESSION.setdefault("pending_context", []).append(
        f"<polecenie_uzytkownika komenda=\"{command}\">\n{result}\n</polecenie_uzytkownika>")


