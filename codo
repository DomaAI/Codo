def _pair_claim(code: str) -> dict | None:
    """Flow A: kod wygenerowany w DomaAI Web (ważny 3 min) → sekret od ręki."""
    import socket
    if any(ch not in "0123456789- \t\r\n" for ch in code) or len(re.sub(r"[^0-9]", "", code)) != 14:
        print(red(_L("✗ Kod musi zawierać 14 cyfr (XXXXX-XXXX-XXXXX).")))
        return None
    try:
        data = _http("POST", "/cli/pair/claim", retries=0, json_body={
            "code": code,
            "hostname": socket.gethostname(),
            "cwd": str(Path.cwd()),
        })
    except ApiError as e:
        if e.status == 404:
            print(red(_L("✗ Kod nieprawidłowy albo wygasł (ważny 3 minuty).")))
            print(dim(_L("  Wygeneruj nowy: DomaAI Web → Codo → Sparuj urządzenie.")))
            return None
        raise
    save_device({"device_id": data["device_id"],
                 "device_secret": data["device_secret"],
                 "name": data.get("name") or socket.gethostname()})
    return data


def pair(code_arg: str | None) -> int:
    """`codo pair [KOD]` — z kodem: natychmiastowe parowanie; bez kodu:
    pyta o kod, a pusty Enter przełącza na tryb odwrotny (kod NA EKRANIE,
    wpisywany w webie — przydatny, gdy do serwera wklejać niewygodnie)."""
    import socket

    if load_device():
        device_access_token(force=True)
        print(yellow(_L("▲ To urządzenie jest już sparowane.")) +
              dim(_L(" (codo unpair usuwa lokalne parowanie)")))
        return 0

    code = (code_arg or "").strip()
    if not code:
        print(bold(_L("Parowanie urządzenia z kontem DomaAI")))
        print(_L("Wygeneruj kod: ") + bold(_L("DomaAI Web → Codo → Sparuj urządzenie")) +
              dim(_L(" (kod ważny 3 minuty)")))
        code = input(_L("Kod (XXXXX-XXXX-XXXXX), pusty Enter = pokaż kod tutaj: ")).strip()

    if code:
