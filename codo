def t_outline(args):
    """Struktura pliku: klasy/funkcje (Python przez ast, JS/TS regexem) —
    szybka nawigacja bez czytania całości."""
    path = _agent_path(args.get("path"))
    if not path.is_file():
        return f"BŁĄD: nie ma pliku {args.get('path')}."
    kind = _binary_kind(path)
    if kind:
        return f"outline: {path.name} to plik binarny ({kind}); treść: read_file."
    src = _decode_text(_long_path(path).read_bytes())[0]
    suf = path.suffix.lower()
    lines = []
    if suf == ".py":
        import ast as _ast
        try:
            tree = _ast.parse(src)
        except SyntaxError as e:
            return f"BŁĄD składni {path.name}:{e.lineno}: {e.msg}"
        for node in _ast.walk(tree):
            if isinstance(node, (_ast.FunctionDef, _ast.AsyncFunctionDef)):
                lines.append((node.lineno, f"def {node.name}()"))
            elif isinstance(node, _ast.ClassDef):
                lines.append((node.lineno, f"class {node.name}"))
    elif suf in (".js", ".mjs", ".cjs", ".ts", ".tsx", ".jsx"):
        pat = re.compile(
            r"^\s*(?:export\s+)?(?:default\s+)?"
            r"(?:(?:async\s+)?function\s+(\w+)|class\s+(\w+)"
            r"|(?:const|let|var)\s+(\w+)\s*=\s*(?:async\s*)?(?:\([^)]*\)|\w+)\s*=>)",
            re.M)
        for m in pat.finditer(src):
            name = m.group(1) or m.group(2) or m.group(3)
            kind = "class" if m.group(2) else "fn"
            lines.append((src[:m.start()].count("\n") + 1, f"{kind} {name}"))
    elif suf in (".md", ".markdown", ".mdx", ".rst"):
        fence = False
        for i, ln in enumerate(src.split("\n"), 1):
            if ln.lstrip().startswith(("```", "~~~")):
                fence = not fence
            m = None if fence else re.match(r"^(#{1,6})\s+(.+)", ln)
            if m:
                lines.append((i, "  " * (len(m.group(1)) - 1) + m.group(2).strip()))
    elif suf in _OUTLINE_RX:
        pat = re.compile(_OUTLINE_RX[suf], re.M)
        for m in pat.finditer(src):
            name = next((g for g in m.groups() if g), None)
            if name:
                kw = m.group(0).strip().split()[0] if m.group(0).strip() else ""
                lines.append((src[:m.start()].count("\n") + 1, f"{kw} {name}" if kw != name else name))
    else:
        return (f"outline wspiera .py/.js/.ts, .md oraz {', '.join(sorted(_OUTLINE_RX))} "
                f"(dostałem {suf or 'plik bez rozszerzenia'}); użyj grep albo read_file.")
    lines.sort()
    if not lines:
        return f"{path.name}: brak funkcji/klas na poziomie pliku."
    return f"{path.name} ({len(src.splitlines())} linii):\n" + "\n".join(
        f"  {ln:>5}  {sig}" for ln, sig in lines[:200])


def t_preview(args):
    """Żywy podgląd: statyczny serwer HTTP w tym katalogu. preview_action:
    start (domyślnie) | stop | status. Zwraca URL."""
    import socket as _sock
    import time as _time
    act = (args.get("preview_action") or "start").lower()
    port = int(args.get("port") or 8080)
    pidfile = Path.cwd() / _DOMA_DIR / "preview.pid"
