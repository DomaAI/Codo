def _host_ensure(wait: float = 10.0) -> bool:
    """Gospodarz agentów działa? Jeśli nie, uruchamiamy go w tle (zostaje po zamknięciu okna)."""
    import time as _time
    if _host_call({"cmd": "state"}, timeout=3):
        return True
    HOST_DIR.mkdir(parents=True, exist_ok=True)
    (HOST_DIR / "log").mkdir(parents=True, exist_ok=True)
    try:
        out = open(HOST_DIR / "log" / "host.out", "ab")
        kw = {"creationflags": 0x08000000 | 0x00000200} if IS_WIN else {"start_new_session": True}
        subprocess.Popen([*_self_cmd(), "host", "run"], stdin=subprocess.DEVNULL, stdout=out, stderr=out, **kw)
    except OSError:
        return False
    end = _time.time() + wait
    while _time.time() < end:
        _time.sleep(0.3)
        if _host_call({"cmd": "state"}, timeout=3):
            return True
    return False


def _ui_host_config_read() -> dict:
    out = {}
    for name in _UI_HOST_FILES:
        data = _host_load(name, None)
        if isinstance(data, dict) and name != "agents.json":
            data = {k: (_UI_MASK if k in _UI_SECRET_KEYS and v else v) for k, v in data.items()}
        out[name] = data
    return out


def _ui_host_config_write(name: str, data) -> bool:
    if name not in _UI_HOST_FILES or not isinstance(data, dict):
        return False
    if name != "agents.json":
        old = _host_load(name, {}) or {}
        data = {k: (old.get(k, "") if k in _UI_SECRET_KEYS and v == _UI_MASK else v) for k, v in data.items()}
        if not any(v for v in data.values()):
            try:
                (HOST_DIR / name).unlink()
            except OSError:
                pass
            return True
    _host_save(name, data)
    return True
