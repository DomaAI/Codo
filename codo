                    save_account_info({"email": info.get("email") or (load_device() or {}).get("email")
                                       or who.get("email"), "name": who.get("imie") or info.get("name"),
                                       "plan": who.get("plan")})
                    info = load_account_info()
                out["domaai"] = {"name": who.get("imie") or "",
                                 "email": info.get("email") or who.get("email") or "",
                                 "plan": who.get("plan") or "", "balance": who.get("saldo"),
                                 "agent": _app_agent(prof)}
        except BaseException:                                    # noqa: BLE001
            pass
        try:
            ml = load_maddlabs()
            if ml:
                data = (_maddlabs_http("GET", "/key", key=ml["api_key"], base=_maddlabs_base(ml), timeout=8)
                        .get("data") or {})
                free = data.get("free_tokens") or {}
                rate = data.get("rate_limit") or {}
                out["maddlabs"] = {"balance_usd": data.get("balance_usd"), "usage_month_usd": data.get("usage_month_usd"),
                                   "limit_month_usd": data.get("limit_month_usd"),
                                   "limit_remaining_usd": data.get("limit_remaining_usd"),
                                   "trial_active": bool(free.get("trial_active")),
                                   "trial_left_today": free.get("trial_left_today"), "bonus": free.get("bonus"),
                                   "tier": rate.get("tier") or "", "rpm": rate.get("requests_per_minute"),
                                   "tpm": rate.get("tokens_per_minute")}
        except BaseException:                                    # noqa: BLE001
            pass
        _app_emit("limits", **out)
    threading.Thread(target=work, daemon=True).start()


def app_server(creds: dict | None, model: str | None) -> int:
    """codo app-server: Codo jako silnik aplikacji okienkowej (jedna rozmowa w bieżącym folderze)."""
    global _INPUT_MODE
    import time as _time
    out = os.fdopen(os.dup(sys.stdout.fileno()), "w", buffering=1, encoding="utf-8")
    sys.stdout = sys.stderr
    _APP["out"] = out
    # Domyślnie okno działa lokalnie (bez lustra sesji na serwerze). Tryb „Synced” (ustawienie app_sync,
    # tylko z kontem DomaAI) pokazuje sesję w aplikacji DomaAI na telefonie i w przeglądarce.
    SESSION["app"] = True
    try:
        _zgody_serwer()
    except (OSError, AttributeError):   # Windows bez AF_UNIX (codo ui): okno działa, tylko bez gniazda zgód MCP
        pass
    mode = load_settings().get("app_mode") if load_settings().get("app_mode") in ("ask", "auto", "read") else "ask"
    if os.environ.get("CODO_APP_MODE") in ("ask", "auto", "read"):
        mode = os.environ["CODO_APP_MODE"]   # przebieg pomocniczy (np. druga opinia tylko do odczytu)

    def set_sync(on: bool) -> None:
        if SYNC.enabled:
            SYNC.close()
            SYNC.__init__()
        if on and not os.environ.get("CODO_APP_LOCAL_ONLY") and (load_device() or load_creds()):
            os.environ.pop("DOMA_NO_SYNC", None)
            SYNC.start(creds, current_model(model), mode)
        else:
            os.environ["DOMA_NO_SYNC"] = "1"
    set_sync(load_settings().get("app_sync") is True)

    def run_turn(text: str, echo: bool = True, chat: bool = False, remote: bool = False, brain: str = "",
                 queued_at: float | None = None) -> bool:
        """brain: model tylko na tę turę (węzeł workflowu), bez zapisu w ustawieniach."""
        content, attached = _expand_mentions(text)
        if SYNC.enabled:
            SYNC.add("user", {"tekst": text, "zrodlo": "telefon" if remote else "mac"})
        if len(messages) == 1:
            messages[0] = system_message(SYSTEM_PROMPT)   # świeża persona agenta i notatki projektu
        if chat:
            # Zwykły czat: rozmowa bez narzędzi i bez zmian w plikach, także u agentów i w Lopusie.
            content = ("[TRYB CZATU: to zwykła rozmowa. Nie używaj narzędzi, nie czytaj ani nie zmieniaj plików, "
                       "nie uruchamiaj poleceń. Odpowiedz wprost z własnej wiedzy.]\n\n" + content)
        messages.append({"role": "user", "content": _with_pending_context(content)})
        t0 = _time.monotonic()
        ok = False
        # Polecenia z telefonu zawsze pytają o zgodę, także w trybie auto (jak /rc w terminalu).
        turn_mode = "ask" if remote and mode == "auto" and load_settings().get("rc_auto") is not True else mode

        def one(brain):
            if chat:
                return bool(agent_turn(creds, messages, brain, False, tools=[], mode="read"))
            return bool(agent_turn(creds, messages, brain, turn_mode == "auto", mode=turn_mode))
        pin_prev, pin = SESSION.get("force_provider"), _team_brain_provider(brain) if brain else ""
        try:
            # 21.11.2026: „pracuję” dopiero wewnątrz try. Stop to SIGINT dla tego procesu: przerwanie, które
            # trafiło między ustawieniem flagi a try, kończyło cały app-server zamiast jednej tury.
            SESSION["app_busy"] = True
            if pin:
                SESSION["force_provider"] = pin   # konto albo agent węzła, ustawienia okna zostają
            if not os.environ.get("CODO_NO_HISTORY"):
                # 20.11.2026: zapis już na starcie, żeby okno mogło wznowić rozmowę przerwaną awarią lub zamknięciem.
                _convo_save(messages)
            _app_emit("turn_start", attached=attached, convo_id=SESSION.get("convo_id") or "")
            if queued_at is not None and float(SESSION.get("app_interrupt_at") or 0) >= queued_at:
                # Stop naciśnięty po wysłaniu, ale zanim tura ruszyła: dotyczy właśnie jej.
                raise KeyboardInterrupt
            main = current_model(brain or model)
            if brain_needs_net(main) and not online():
                # Bez internetu nie ma sensu czekać na limit czasu: od razu mózg lokalny, jeśli jest.
                SESSION["turn_error"] = "net"
            else:
                ok = one(brain or model)
            tried = {main}
            while not ok and not SESSION.get("app_stop"):
                nxt = _backup_brain(SESSION.get("turn_error"), tried)
                if not nxt:
                    if SESSION.get("turn_error") == "agent" and SESSION.get("agent_error"):
                        _app_emit("error", tekst=SESSION.pop("agent_error"))
                    if SESSION.get("turn_error") == "net" and not tried - {main}:
                        _app_emit("error", tekst=_L("Brak internetu. Ten model działa w chmurze. Podłącz model lokalny "
                                                    "(Ollama albo LM Studio w Ustawienia → Konta), żeby pracować offline."))
                    break
                tried.add(nxt)
                _app_emit("fallback", model=nxt, label=brain_label(nxt), od=brain_label(main),
                          tekst=_Lf('{0}: {1}. Dalej pracuje {2}.', brain_label(main),
                                    _fail_reason(SESSION.get("turn_error")), brain_label(nxt)))
                ok = one(nxt)
        except KeyboardInterrupt:
            _app_emit("info", tekst=_L("Przerwano"), blad=True)
        except (ApiError, urllib.error.URLError, OSError) as exc:
            _app_emit("error", tekst=describe_error(exc))
        finally:
            if pin:
                if pin_prev is None:
                    SESSION.pop("force_provider", None)
                else:
                    SESSION["force_provider"] = pin_prev
            SESSION.pop("app_stop", None)
            SESSION["app_busy"] = False
            if not os.environ.get("CODO_NO_HISTORY"):
                _convo_save(messages)   # tylko lokalnie, w folderze konfiguracji na tym komputerze
        _app_emit("context", **_context_usage(messages, chat))
        _app_emit("turn_end", ok=ok, seconds=round(_time.monotonic() - t0, 1),
                  credits=SESSION.get("spent", 0), model=SESSION.get("model") or current_model(brain or model),
                  convo_id=SESSION.get("convo_id"), files=[str(x) for x in SESSION.get("edited", [])][-50:],
                  title=SESSION.get("custom_title") or _convo_title([m for m in messages if m.get("role") != "system"]))
        return ok
    _INPUT_MODE = mode
    messages: list = [system_message(SYSTEM_PROMPT)]
    inbox: list = []
    wake = threading.Event()
    _APP["inbox"], _APP["wake"] = inbox, wake
    threading.Thread(target=_app_reader, args=(inbox, wake), daemon=True).start()
    logged = bool(creds or load_device() or load_maddlabs() or load_endpoint() or agents_available())
    _app_emit("ready", version=VERSION, cwd=str(Path.cwd().resolve()), lang=ui_lang(),
              model=current_model(model), provider=provider(), mode=mode, logged_in=logged,
              effort=SESSION.get("effort") or load_settings().get("effort") or "", efforts=list(_EFFORTS),
              accounts=sorted(endpoint_accounts()), agents=[k for k, _p in agents_available()],
              history=[{"id": d["id"], "title": d.get("title") or "", "updated": d.get("updated")}
                       for d in _convo_list()[:30]], features=["team1", "team2", "group1"])
    if not os.environ.get("CODO_ZESPOL_DIR"):
        try:
            _app_emit("team_runs", runs=_team_runs_list())
        except OSError:
            pass  # nosec B110
    while True:
        if not inbox:
            wake.wait(1)
            wake.clear()
            continue
        msg = inbox.pop(0)
        kind = msg.get("type")
        if kind == "quit":
            SYNC.close()
            return 0
        if kind == "sync":
            st = load_settings()
            st["app_sync"] = bool(msg.get("on"))
            save_settings(st)
            set_sync(st["app_sync"])
            _app_status()
            continue
        if kind == "rc":
            # Telefon jako pilot: sesja w aplikacji DomaAI, z której można pisać, przerwać i odpowiadać na zgody.
            on = bool(msg.get("on"))
            try:
                if on and not SYNC.enabled:
                    if not app_linked():
                        raise ApiError(400, _L("Połącz najpierw konto DomaAI (Połączenia → DomaAI)."))
                    st = load_settings()
                    st["app_sync"] = True
                    save_settings(st)
                    set_sync(True)
                url = SYNC.set_rc(on) if (on or SYNC.enabled) else ""
                _app_emit("rc", on=bool(SYNC.rc), url=url or "")
            except (ApiError, urllib.error.URLError, OSError) as exc:
                _app_emit("rc", on=False, url="", error=describe_error(exc))
            _app_status()
            continue
        if kind == "_team_chat":
            # Zespół uruchomiony z rozmowy: cel jako wiadomość użytkownika, wynik jako odpowiedź.
            messages.append({"role": "user" if msg.get("role") == "user" else "assistant",
                             "content": str(msg.get("text") or "")})
            if not os.environ.get("CODO_NO_HISTORY"):
                _convo_save(messages)
            continue
        if kind == "mode" and msg.get("mode") in ("ask", "auto", "read"):
            mode = _INPUT_MODE = msg["mode"]
            # 20.11.2026: przebiegi pomocnicze i stali agenci mają własny tryb; ustawienie użytkownika zostaje.
            if not os.environ.get("CODO_APP_MODE"):
                st = load_settings()
                st["app_mode"] = mode
                save_settings(st)
            _app_emit("mode", mode=mode)
        elif kind == "agent_persona":
            # Stały agent w oknie Codo: kim jest, co pamięta, gdzie ma biurko (odświeżane bez restartu).
            SESSION["app_persona"] = str(msg.get("text") or "")[:24000]
            messages[0] = system_message(SYSTEM_PROMPT)
        elif kind == "model" and msg.get("model"):
            if cmd_model(str(msg["model"])) == 0:
                model = None   # wybór zapisany w ustawieniach (także zmiana dostawcy: konto, agent)
            _app_emit("model", model=current_model(model), provider=provider())
        elif kind == "models":
            _app_models()
        elif kind == "catalog":
            _app_catalog()
        elif kind == "login":
            _app_login(msg)
            model = None
        elif kind == "presets":
            _app_emit("presets", items=[{"id": p[0], "title": p[1], "note": _L(p[2]), "url": p[3],
                                         "needs_key": bool(p[4]), "local": p[4] is None,
                                         "connected": p[0] in endpoint_accounts()} for p in _ENDPOINT_PRESETS])
        elif kind in ("skills", "skill_install", "skill_remove", "skill_toggle"):
            err, added = "", []
            try:
                if kind == "skill_install":
                    added = skills_install(str(msg.get("source") or ""))
                elif kind == "skill_remove":
                    skills_remove(str(msg.get("pack") or ""))
                elif kind == "skill_toggle":
                    st = load_settings()
                    off = set(st.get("skills_off") or [])
                    (off.discard if msg.get("on") else off.add)(str(msg.get("id") or ""))
                    st["skills_off"] = sorted(off)
                    save_settings(st)
            except (ApiError, ValueError, OSError, urllib.error.URLError) as exc:
                err = describe_error(exc) if isinstance(exc, ApiError) else str(exc)
            except Exception as exc:                             # noqa: BLE001 — uszkodzone archiwum itp.
                err = str(exc) or exc.__class__.__name__
            if kind != "skills" and len(messages) == 1:
                messages[:] = [system_message(SYSTEM_PROMPT)]   # nowa lista od razu w tej rozmowie
            _app_emit("skills", items=skills_list(), error=err, added=added)
        elif kind in ("own_skills", "own_skill"):
            # Własne umiejętności (zapisane przez agenta): lista, wyłącz/włącz, usuń do archiwum, przywróć, skasuj.
            err = ""
            if kind == "own_skill":
                try:
                    own_skill_action(str(msg.get("action") or ""), str(msg.get("id") or ""))
                except (ValueError, OSError) as exc:
                    err = str(exc)
                if len(messages) == 1:
                    messages[:] = [system_message(SYSTEM_PROMPT)]
            _app_emit("own_skills", items=own_skills_list(), error=err,
                      project_dir=str(_own_base("projekt")), global_dir=str(OWN_SKILLS_DIR))
        elif kind == "use" and msg.get("provider"):
            _app_use(str(msg["provider"]), str(msg.get("model") or ""))
            model = None
            _app_emit("model", model=current_model(model), provider=provider())
            _app_models()
            _app_status()
            _app_catalog()
        elif kind == "effort":
            eff = _effort_parse(str(msg.get("effort") or ""))
            if eff:
                SESSION["effort"] = eff
                st = load_settings()
                st["effort"] = eff
                save_settings(st)
            _app_emit("effort", effort=SESSION.get("effort") or "")
        elif kind == "files":
            _app_files()
        elif kind == "changes":
            _app_changes()
        elif kind == "status":
            _app_status()
        elif kind == "limits":
            _app_limits()
        elif kind in ("tools", "tool_group"):
            if kind == "tool_group":
                st = load_settings()
                off = set(disabled_tool_groups())
                (off.discard if msg.get("on") else off.add)(str(msg.get("id") or ""))
                st["disabled_tools"] = sorted(off & {g[0] for g in _TOOL_GROUPS if not g[3]})
                save_settings(st)
            off = disabled_tool_groups()
            known = {t["function"]["name"] for t in TOOLS}
            _app_emit("tools", groups=[{"id": g[0], "title": g[1], "detail": g[2], "locked": g[3],
                                        "on": g[0] not in off, "tools": [n for n in g[4] if n in known]}
                                       for g in _TOOL_GROUPS])
        elif kind == "pr":
            # PR na GitHub z bieżących zmian: status (gałąź, pliki, gh) albo utworzenie.
            def pr(action: str, m: dict) -> None:
                out = {"action": action}
                try:
                    if action == "create":
                        out.update(pr_create(str(m.get("title") or ""), str(m.get("body") or ""),
                                             bool(m.get("draft"))))
                        _app_emit("changes_hint")
                    out["status"] = pr_status()
                except (ValueError, OSError, subprocess.SubprocessError) as exc:
                    out["error"] = str(exc)
                _app_emit("pr", **out)
            threading.Thread(target=pr, args=(str(msg.get("action") or "status"), dict(msg)), daemon=True).start()
        elif kind == "billing":
            # Zakup planu i kredytów w oknie Codo (19.11.2026): katalog, Stripe Checkout, weryfikacja.
            def billing(action: str, m: dict) -> None:
                out = {"action": action}
                try:
                    token = device_access_token()
                    if not token:
                        raise ApiError(401, _L("Zakupy wymagają konta DomaAI."))
                    if action == "catalog":
                        out["plans"] = _http("GET", "/billing/plans", token=token, timeout=30).get("plans", [])
                        out["packs"] = _http("GET", "/billing/packs", token=token, timeout=30).get("packs", [])
                        st = _http("GET", "/billing/status", token=token, timeout=30)
                        out["plan"] = st.get("plan") or "free"
                        out["plan_label"] = st.get("plan_label") or ""
                        out["balance"] = st.get("credits_balance") or 0
                    elif action == "checkout":
                        body = {"kind": str(m.get("kind") or ""), "item_id": str(m.get("item") or ""),
                                "zgoda_natychmiast": bool(m.get("consent")), "zgoda_wersja": "odstapienie-v1"}
                        r = _http("POST", "/billing/stripe/checkout-session", token=token, json_body=body,
                                  timeout=60, retries=0)
                        out["url"] = r.get("url") or ""
                    elif action == "verify":
                        from urllib.parse import quote
                        out.update(_http("GET", "/billing/stripe/verify?session_id=" + quote(str(m.get("session") or "")),
                                         token=token, timeout=60))
                        _app_limits()
                except (ApiError, urllib.error.URLError, OSError) as exc:
                    out["error"] = describe_error(exc)
                _app_emit("billing", **out)
            threading.Thread(target=billing, args=(str(msg.get("action") or "catalog"), dict(msg)), daemon=True).start()
        elif kind == "machine":
            # Maszyna DomaAI: przenieś projekt, stan, pobierz zmiany, uśpij, wróć na ten komputer.
            def machine(action: str) -> None:
                out = {"action": action}
                try:
                    if action == "send":
                        _app_emit("machine", action=action, busy=True, faza="pakuje")
                        out.update(maszyna_wyslij(lambda f: _app_emit("machine", action=action, busy=True, faza=f)))
                        out["status"] = maszyna_stan()
                        # W chmurze rozmowa ma być też w aplikacjach DomaAI: lustro sesji włącza się samo.
                        if not SYNC.enabled:
                            try:
                                set_sync(True)
                            except Exception:  # noqa: BLE001 — lustro nie może zepsuć przeniesienia
                                pass
                        # Prawda o lustrze, także gdy było włączone już wcześniej (23.11: fałszywe „nie”).
                        out["synced"] = bool(SYNC.enabled)
                    elif action == "pull":
                        _app_emit("machine", action=action, busy=True)
                        out["changed"] = [{"path": c[0], "new": c[1], "added": c[2], "removed": c[3]}
                                          for c in maszyna_pobierz()]
                    elif action == "status":
                        out["status"] = maszyna_stan() if SESSION.get("maszyna") else {}
                    elif action == "sleep":
                        maszyna_uspij()
                        out["status"] = maszyna_stan()
                    elif action == "leave":
                        SESSION["maszyna"] = False
                    if SESSION.get("convo_id") and not os.environ.get("CODO_NO_HISTORY"):
                        _convo_save(messages)
                except (ApiError, urllib.error.URLError, OSError, ValueError) as exc:
                    out["error"] = describe_error(exc) if isinstance(exc, (ApiError, urllib.error.URLError)) else str(exc)
                out["on"] = bool(SESSION.get("maszyna"))
                out["chat_id"] = SESSION.get("lopus_chat_id") or ""
                _app_emit("machine", busy=False, **out)
                if action in ("pull",):
                    _app_emit("changes_hint")
            threading.Thread(target=machine, args=(str(msg.get("action") or "status"),), daemon=True).start()
        elif kind == "machines":
            # Własne maszyny (oferta, zakup przez Stripe w oknie, potwierdzenie po płatności).
            # Serwer MADD (19.11): osobna usługa, wirtualny serwer na Proxmoxie w OVH, płatność raz na 30 dni
            # w PLN, EUR albo USD; publiczny klucz SSH Codo idzie przy zakupie, „retry” zakłada serwer ponownie.
            def machines(action: str, item: str, sesja: str, waluta: str, klucz: str) -> None:
                out: dict = {"action": action}
                try:
                    if action == "buy":
                        zakup = {"id": item, "zgoda": True}
                        if waluta in ("pln", "eur", "usd"):
                            zakup["waluta"] = waluta
                        if klucz.startswith("ssh-"):
                            zakup["klucz_ssh"] = klucz[:2000]
                        body = json.dumps(zakup).encode()
                        out.update(json.loads(_maszyna_req("POST", "/cli/maszyny/kup", body, "application/json",
                                                           timeout=60).decode() or "{}"))
                    elif action == "retry":
                        out.update(json.loads(_maszyna_req("POST", "/cli/maszyny/ponow", b"{}", "application/json",
                                                           timeout=60).decode() or "{}"))
                    elif action == "confirm":
                        body = json.dumps({"sesja": sesja}).encode()
                        out.update(json.loads(_maszyna_req("POST", "/cli/maszyny/potwierdz", body, "application/json",
                                                           timeout=60).decode() or "{}"))
                    out["catalog"] = json.loads(_maszyna_req("GET", "/cli/maszyny", timeout=30).decode() or "{}")
                except ApiError as exc:
                    out["error"] = exc.human() if hasattr(exc, "human") else str(exc)
                    out["status"] = exc.status
                except (urllib.error.URLError, OSError, ValueError) as exc:
                    out["error"] = describe_error(exc) if isinstance(exc, urllib.error.URLError) else str(exc)
                _app_emit("machines", **out)
            threading.Thread(target=machines, args=(str(msg.get("action") or "catalog"), str(msg.get("item") or ""),
                                                    str(msg.get("session") or ""),
                                                    str(msg.get("currency") or "").lower(),
                                                    str(msg.get("ssh_key") or "").strip()), daemon=True).start()
        elif kind == "agent_create":
            # Kreator agenta w oknie (pierwsze uruchomienie albo Ustawienia): zapis i nowa persona od razu.
            # W osobnym wątku: zapis nie czeka na trwającą turę, a błąd serwera nie zabija silnika
            # (24.11.2026: ApiError z PUT /agent/profil wywracał app-server i okno kręciło „Zapisuję…” bez końca).
            def agent_save(m: dict) -> None:
                try:
                    prof = save_created_agent(m, settings=False)
                except ValueError as e:
                    _app_emit("agent_saved", ok=False, blad=str(e))
                    return
                except Exception as e:  # noqa: BLE001 — serwer albo sieć: agent zostaje zapisany na tym Macu
                    try:
                        prof = save_created_agent(m, local_only=True, settings=False)
                    except Exception:  # noqa: BLE001
                        _app_emit("agent_saved", ok=False, blad=_L("Nie udało się zapisać agenta. Spróbuj ponownie."))
                        return
                    kod = getattr(e, "status", None) or getattr(e, "code", None)
                    _app_emit("agent_saved", ok=True, agent=_app_agent(prof), lokalnie=True,
                              uwaga=_L("Zapisane na tym Macu. Konto DomaAI dostanie zmiany przy następnym zapisie")
