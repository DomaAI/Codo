)


def _login_ways(first_run: bool, found: list) -> list:
    """Opcje logowania. Pierwszy start (brak jakiegokolwiek konta): na górze MaddLabs z darmowymi
    kredytami na start, potem własny klucz lub model lokalny, agenci z tego komputera, DomaAI."""
    ways = list(_LOGIN_WAYS)
    if found:
        names = ", ".join(_AGENTS[k]["label"] for k, _p in found)
        ways.append(("agent", _Lf('Bez konta: {0} z tego komputera, na Twoim planie', names)))
    if not first_run:
        return ways
    order = ("maddlabs", "endpoint", "agent", "domaai", _L("klucz"))   # w EN klucz tabeli to „key”
    ways.sort(key=lambda w: order.index(w[0]) if w[0] in order else len(order))
    return [("maddlabs", _L("Zaloguj się kontem MaddLabs: darmowe kredyty na start")) if k == "maddlabs" else (k, lab)
            for k, lab in ways]


def login_menu(way: str | None = None, relogin: bool = False) -> int:
    """codo login / /login: wybór DomaAI, konta MaddLabs albo klucza API MaddLabs.
    Ponowne logowanie DomaAI odparowuje to urządzenie i paruje je od nowa."""
    aliases = {"domaai": "domaai", "doma": "domaai", "maddlabs": "maddlabs", "madd": "maddlabs",
               "konto": "maddlabs", "klucz": _L("klucz"), "api": _L("klucz"), "key": _L("klucz"), "api-key": _L("klucz"),
               "endpoint": "endpoint", "wlasny": "endpoint", "konto-api": "endpoint", "agent": "agent",
               "agenci": "agent", "bez-konta": "agent",
               **{p[0]: "endpoint" for p in _ENDPOINT_PRESETS}}
    raw_way = (way or "").strip()
    way = aliases.get((way or "").strip().lower()) if way else None
    if way is None:
        dev, ml = load_device() or load_creds(), load_maddlabs()
        now = (_Lf('teraz: {0}', _provider_label()) if (dev or ml or load_endpoint()) else _L("teraz: niezalogowane"))
        ways = _login_ways(not (dev or ml or load_endpoint()), agents_available())
        way = _pick(ways, _Lf('Zaloguj się · {0}', now))
        if not way:
            print(dim(_L("  Logowanie anulowane.")))
            return 1
    if way == "agent" or raw_way.lower() in ("agent", "agenci", "bez-konta"):
        return use_local_agents()
    if way == "endpoint":
        spec = raw_way.lower() if raw_way.lower() in _PRESET else None
        extra = SESSION.pop("login_spec", None)
        if spec:
            return login_endpoint(spec, extra)   # codo login xai [nazwa]
        return login_endpoint(extra)             # codo login endpoint [URL]
    if way == "domaai":
        if (load_device() or load_creds()) and relogin:
            print(dim(_L("  Odparowuję to urządzenie i loguję od nowa…")))
            logout()
        rc = login()
        if rc == 0:
            _set_provider("domaai")
        return rc
    rc = login_maddlabs_account() if way == "maddlabs" else login_maddlabs_key()
    if rc == 0 and not app_linked():
        print(dim(_L("  Sterowanie z telefonu i rozmowa w aplikacji DomaAI: wpisz /rc, połączę to urządzenie z aplikacją.")))
    return rc


def refresh(creds: dict) -> dict:
    data = _http("POST", "/refresh_token", token=creds["refresh_token"])
    creds["access_token"] = data["access_token"]
    creds["refresh_token"] = data.get("refresh_token") or creds["refresh_token"]
    save_creds(creds)
    return creds


def api_call(creds: dict | None, path: str, body: dict, *, method: str = "POST") -> dict:
    """POST z auto-odnowieniem autoryzacji. Preferuje token URZĄDZENIA
    (parowanie, 3-min JWT mintowany z sekretu); fallback: stare credentials
    hasłowe z refreshem przy 401."""
    dev_tok = device_access_token()
    if dev_tok is not None:
        try:
            return _http(method, path, token=dev_tok, json_body=None if method == "GET" else body)
        except ApiError as e:
            if e.status == 401:  # token 3-min właśnie wygasł → mint i ponów
                return _http(method, path, token=device_access_token(force=True),
                             json_body=None if method == "GET" else body)
            raise
    if not creds:
        raise ApiError(401, _L("To urządzenie nie jest zalogowane. Uruchom: codo login"))
    try:
        return _http(method, path, token=creds["access_token"], json_body=None if method == "GET" else body)
    except ApiError as e:
        if e.status == 401:
            creds = refresh(creds)
            return _http(method, path, token=creds["access_token"], json_body=None if method == "GET" else body)
        raise


def _provider_label() -> str:
    p = provider()
    if p == "maddlabs":
        return "MaddLabs"
    if p == "endpoint":
        return _L("własne konto ") + _endpoint_name()
    if p == "agent":
        return _L("agenci na tym komputerze")
    return "DomaAI"


def api_step(creds: dict, body: dict) -> dict:
    if provider() == "agent" or agent_kind(body.get("model")):
        # Krok tekstowy (streszczenie, kompaktowanie) przy agencie zewnętrznym: model Codo, jeśli jest konto.
        target = _agent_fallback_target()
        if not target:
            raise ApiError(400, _L("Ten krok wymaga modelu Codo. Podłącz konto: codo login"))
        body = {**body, "model": target[1]} if target[1] else {k: v for k, v in body.items() if k != "model"}
        prev = SESSION.get("force_provider")
        SESSION["force_provider"] = target[0]
        try:
            return api_step(creds or load_creds(), body)
        finally:
            if prev is None:
                SESSION.pop("force_provider", None)
            else:
                SESSION["force_provider"] = prev
    if provider() == "endpoint" or endpoint_model(body.get("model")):
        return endpoint_step(body)
    if provider() == "maddlabs":
        return maddlabs_step(body)
    return api_call(creds, "/cli/agent/step", body)


