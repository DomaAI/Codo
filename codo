# Katalog roboczy doma na maszynie usera: auto-kopie plików + stan podglądu.
_DOMA_DIR = ".doma"
_BACKUP_DIR = ".doma/backups"


def _safe_path(p: str) -> Path:
    """Ścieżki względne do cwd; absolutne dozwolone tylko wewnątrz cwd
    (agent zarządza TĄ stroną, nie całym systemem)."""
    base = Path.cwd().resolve()
    if str(p).startswith("~"):
        p = os.path.expanduser(p)   # do 0.28.0 „~/x” tworzyło w projekcie folder o nazwie „~”
    target = (base / p).resolve() if not os.path.isabs(p) else Path(p).resolve()
    if base not in target.parents and target != base:
        raise ValueError(_Lf('Ścieżka poza katalogiem roboczym: {0} (uruchom codo w katalogu strony)', p))
    return target


def _team_read_roots() -> list:
    """Kopie członków zespołu, w którym pracuje ten agent (tylko do czytania): recenzent i prowadzący muszą
    widzieć pracę wykonawcy, zanim nadzorca ją scali (23.11: przegląd stał na „poza katalogiem roboczym”)."""
    d = os.environ.get("CODO_ZESPOL_DIR")
    if not d:
        return []
    try:
        run = TeamStore(d).load_run()
    except Exception:  # noqa: BLE001
        return []
    roots = [run.get("integration_path") or ""] + [m.get("worktree") or m.get("cwd") or "" for m in run.get("members") or []]
    return [Path(r).resolve() for r in roots if r]


def _safe_read_path(p: str) -> Path:
    """Jak _safe_path, ale do czytania wolno też zajrzeć do kopii członków tego samego zespołu."""
    try:
        return _safe_path(p)
    except ValueError:
        target = Path(p).expanduser().resolve() if os.path.isabs(os.path.expanduser(p)) else None
        if target and any(r == target or r in target.parents for r in _team_read_roots()):
            return target
        raise


# ── Panel WebStudio: mapowanie i edycja stron POZA cwd ──────────────────────
# Panel może zarządzać stronami z całego serwera (nie tylko z katalogu, w którym
# wystartowano `codo serve`). Rozszerzony, ale WCIĄŻ jawny zbiór rootów; a
# `_panel_page_path` dodatkowo wpuszcza TYLKO pliki .html/.htm — żeby narzędzia
# panelu nigdy nie odczytały/nie nadpisały sekretów (.env, klucze itd.).
_PANEL_EXTRA_ROOTS = ("/var/www", "/srv", "/srv/www", "/usr/share/nginx/html")
_PAGE_SUFFIXES = (".html", ".htm")


# Szerokie rooty (HOME, web-rooty) tylko w mostku `codo serve` dla panelu WebStudio. W zwykłej
# sesji narzędzia panelu sięgają wyłącznie do folderu projektu (do 0.28.0 write_text z modelu
# mógł nadpisać dowolny plik .py/.sh/.json w katalogu domowym, z pominięciem kopii i cofania).
_SERVE = {"on": False}
# Narzędzia panelu: model w zwykłej sesji ich nie widzi (ma read_file/write_file/edit_file);
# serwer (Lopus, panel) nadal może je wywołać przez mostek, ale w granicach projektu.
_PANEL_TOOLS = {"read_raw", "write_page", "scan_sites", "list_files", "read_text", "fetch_page",
                "smart_preview", "upload_image", "write_text"}


def _safe_roots() -> list[Path]:
    roots: list[Path] = []
    cands = [Path.cwd()] + ([Path.home()] + [Path(x) for x in _PANEL_EXTRA_ROOTS] if _SERVE["on"] else [])
    seen: set[Path] = set()
    for p in cands:
        try:
            rp = p.resolve()
        except Exception:
            continue
        if rp.is_dir() and rp not in seen:
            seen.add(rp)
            roots.append(rp)
    return roots


def _panel_path(p: str) -> Path:
    """Ścieżka w obrębie dozwolonych rootów panelu (cwd/HOME/web-roots)."""
    p = (p or "").strip()
    if not p:
        raise ValueError(_L("pusta ścieżka"))
    target = Path(p).resolve() if os.path.isabs(p) else (Path.cwd() / p).resolve()
    for root in _safe_roots():
        if target == root or root in target.parents:
            return target
    raise ValueError(_Lf('Ścieżka poza dozwolonymi katalogami (cwd/HOME/web-roots): {0}', p))


def _panel_page_path(p: str) -> Path:
    """Jak `_panel_path`, ale tylko strony (.html/.htm) — twarda bariera przed
    odczytem/zapisem sekretów przez narzędzia panelu."""
    target = _panel_path(p)
    if target.suffix.lower() not in _PAGE_SUFFIXES:
        raise ValueError(_L("panel edytuje tylko pliki .html/.htm"))
    return target


def _panel_backup(path: Path):
    """Kopia zapasowa dla edycji panelu (działa też POZA cwd — obok pliku jako
    ukryty .bak; restore-owalna ręcznie)."""
    if not path.is_file():
        return None
    import shutil
    import time as _t
    ts = _t.strftime("%Y%m%d-%H%M%S")
    bak = path.with_name(f".{path.name}.{ts}.bak")
    i = 1
    while bak.exists():
        bak = path.with_name(f".{path.name}.{ts}-{i}.bak")
        i += 1
    try:
        shutil.copy2(path, bak)
    except Exception:
        return None
    return bak


# ── Panel: edytor plików serwera (CSS/JS/JSON/konfig…) ──────────────────────
# Rozszerzenie panelu poza .html: edycja plików kodu/konfiguracji strony. Jail
# = _panel_path (cwd/HOME/web-roots) + allowlista rozszerzeń + blokada sekretów.
_EDIT_SUFFIXES = {
    ".html", ".htm", ".css", ".scss", ".sass", ".less",
    ".js", ".mjs", ".cjs", ".jsx", ".ts", ".tsx", ".vue",
    ".json", ".jsonc", ".xml", ".svg", ".txt", ".md", ".markdown",
    ".yml", ".yaml", ".toml", ".ini", ".conf", ".cfg",
    ".php", ".py", ".rb", ".sh", ".map", ".webmanifest", ".csv",
}
_EDIT_NAMES = {".htaccess", "robots.txt", "sitemap.xml", "dockerfile", "makefile"}
# Twarda blokada: pliki wyglądające na sekrety/klucze — niezależnie od rozszerzenia.
_SECRET_RE = re.compile(
    r'(^\.env)|(\.pem$)|(\.key$)|(\.crt$)|(\.p12$)|(\.ppk$)|(id_rsa)'
    r'|(\.htpasswd$)|(secret)|(credential)|(password)|(\.pfx$)'
    r'|(^device\.json$)|(^credentials\.json$)|(^links\.json$)', re.I)
_MAX_EDIT_BYTES = 500_000  # < 600k (limit argów/wyniku joba daemona)


def _panel_file_path(p: str) -> Path:
    """Ścieżka edytowalnego pliku: safe-roots + allowlista typów + anty-sekret.
    Twardo poza zasięgiem: katalog konfiguracyjny CLI (device.json/
    credentials.json/links.json = sekret konta) i wszelkie kropkowe
    katalogi/pliki (spójnie z listowaniem, które je pomija)."""
    target = _panel_path(p)
    # Katalog konfiguracyjny CLI — nawet gdy leży w HOME (safe-root).
    try:
        rt, rc = target.resolve(), CONFIG_DIR.resolve()
        if rt == rc or str(rt).startswith(str(rc) + os.sep):
            raise ValueError(_L("plik konfiguracyjny CLI — dostęp zablokowany"))
    except OSError:
        pass  # nosec B110 — nie da się rozwiązać ścieżki: dalsze bramki złapią
    # Kropkowy segment (np. .config, .ssh, .git) — panel ich nie tyka.
    if any(part.startswith(".") and part not in (".", "..")
           for part in target.parts):
        raise ValueError(_L("ukryty katalog/plik (kropkowy) — dostęp zablokowany"))
    name = target.name.lower()
    if _SECRET_RE.search(name):
        raise ValueError(_L("plik wygląda na sekret/klucz — edycja zablokowana"))
    if target.suffix.lower() not in _EDIT_SUFFIXES and name not in _EDIT_NAMES:
        raise ValueError(f"nieedytowalny typ pliku: {target.suffix or target.name}")
    return target


def _is_editable_file(path: Path) -> bool:
    name = path.name.lower()
    if _SECRET_RE.search(name):
        return False
    return path.suffix.lower() in _EDIT_SUFFIXES or name in _EDIT_NAMES


def t_list_files(args):
    """Mapuje WSZYSTKIE edytowalne pliki (kod/konfig/strony) w safe-rootach lub
    w podanym katalogu `dir`. Zwraca 'abs_path\\trozmiar' po jednej w linii."""
    max_files = int(args.get("limit") or 1500)
    max_depth = int(args.get("max_depth") or 8)
    ref = (args.get("dir") or "").strip()
    if ref:
        try:
            roots = [_panel_path(ref)]
        except ValueError as e:
            return f"BŁĄD: {e}"
    else:
        roots = _safe_roots()
    out: list[str] = []
    seen: set[str] = set()
    for root in roots:
        if not root.is_dir():
            continue
        base_depth = str(root).count(os.sep)
        for dirpath, dirnames, filenames in os.walk(root):
            dirnames[:] = [d for d in dirnames
                           if d not in _SKIP_DIRS and not d.startswith(".")]
            if dirpath.count(os.sep) - base_depth >= max_depth:
                dirnames[:] = []
            for fn in filenames:
                if fn.startswith("."):
                    continue
                full = os.path.join(dirpath, fn)
                if full in seen:
                    continue
                if not _is_editable_file(Path(full)):
                    continue
                try:
                    size = os.path.getsize(full)
                except OSError:
                    size = 0
                seen.add(full)
                out.append(f"{full}\t{size}")
                if len(out) >= max_files:
                    break
            if len(out) >= max_files:
                break
        if len(out) >= max_files:
            break
    out.sort()
    return "\n".join(out) or "(brak edytowalnych plików)"


def t_read_text(args):
    """Odczyt dowolnego edytowalnego pliku (kod/konfig). Jail + anty-sekret."""
    try:
        path = _panel_file_path(args["path"])
    except ValueError as e:
        return f"BŁĄD: {e}"
    if not path.is_file():
        return "BŁĄD: plik nie istnieje."
    try:
        if path.stat().st_size > _MAX_EDIT_BYTES:
            return f"BŁĄD: plik za duży do edycji (>{_MAX_EDIT_BYTES // 1000}k bajtów)."
        return _read_text_keep(path)
    except Exception as e:
        return f"BŁĄD odczytu: {e}"


def t_write_text(args):
    """Zapis dowolnego edytowalnego pliku (kod/konfig) + kopia zapasowa."""
    try:
        path = _panel_file_path(args["path"])
    except ValueError as e:
        return f"BŁĄD: {e}"
    new = args.get("content") or ""
    if len(new.encode("utf-8", "replace")) > _MAX_EDIT_BYTES:
        return f"BŁĄD: treść za duża (>{_MAX_EDIT_BYTES // 1000}k bajtów)."
    try:
        old = _read_text_keep(path, missing_ok=True)
    except OSError as e:
        return f"BŁĄD odczytu: {e}"
    if old == new.replace("\r\n", "\n"):
        return "write_text: brak zmian (treść identyczna)."
    inside = Path.cwd().resolve() in path.parents
    if not inside:
        _panel_backup(path)   # poza projektem (tylko `codo serve`): kopia obok pliku
        try:
            enc, crlf, bom = _FILE_FMT.get(path) or ("utf-8", False, False)
            out = new.replace("\r\n", "\n")
            _atomic_write(path, (_UTF8_BOM if bom else b"") + (out.replace("\n", "\r\n") if crlf else out).encode(enc))
        except Exception as e:
            return f"BŁĄD zapisu: {e}"
        a, r = _linedelta(old, new)
        return f"write_text → {path} (+{a}/-{r} linii, kopia zapasowa zrobiona)"
    # w projekcie: ta sama droga co edit_file (kopia w .doma/backups, cofanie, dziennik zmian)
    return _apply(path, old, new.replace("\r\n", "\n"), {}, "write_text")


