    "ODT": {"replace": _odf_replace}, "ODS": {"replace": _odf_replace}, "ODP": {"replace": _odf_replace},
}
_OFFICE_ALIASES = {"set": "set_cell", "set_cells": "set_cell", "cell": "set_cell", "insert": "insert_paragraph",
                   "add_paragraph": "insert_paragraph", "append": "insert_paragraph", "delete": "delete_paragraph",
                   "remove_paragraph": "delete_paragraph", "new_slide": "add_slide", "new_sheet": "add_sheet",
