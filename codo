def _team_root(cwd=None) -> Path:
    cwd = Path(cwd or Path.cwd()).resolve()
    code, top, _ = _git_in(cwd, "rev-parse", "--show-toplevel")
    return Path(top).resolve() if code == 0 and top else cwd


def _team_tpl_dirs(cwd=None) -> dict:
    return {"global": CONFIG_DIR / "zespoly", "project": _team_root(cwd) / ".codo" / "zespoly"}


def _team_template_check(t) -> tuple:
    """Szablon w wersji 1: poprawny skład (najwyżej 8 z prowadzącym), unikalne id, znane wartości polityki."""
    if not isinstance(t, dict):
        return None, "Szablon zespołu musi być obiektem JSON."
    t = json.loads(json.dumps(t))
    name = _slug(str(t.get("name") or t.get("title") or "zespol"))[:40]
    lead = t.get("lead", {"brain": "", "instructions": ""})
    if lead is not None and not isinstance(lead, dict):
        lead = {"brain": str(lead)}
    members, ids = [], set()
    for raw in t.get("members") or []:
        if not isinstance(raw, dict):
            continue
        m = {**_team_m("", "", ""), **raw}
        m["id"] = _slug(str(m.get("id") or m.get("name") or f"czlonek-{len(members) + 1}"))[:24]
        if m["id"] in ids or m["id"] in ("lead", "all", "human"):
            return None, f"Powtórzony albo zastrzeżony identyfikator członka: {m['id']}."
        ids.add(m["id"])
        m["name"] = str(m.get("name") or m["id"])[:60]
        m["writes"] = bool(m.get("writes", True))
        m["isolation"] = m.get("isolation") if m.get("isolation") in ("copy", "shared", "readonly") else "copy"
        m["copies"] = max(1, min(int(m.get("copies") or 1), 4))
        members.append(m)
    count = sum(m["copies"] for m in members) + (1 if lead is not None else 0)
    if not members:
        return None, "Zespół potrzebuje co najmniej jednego członka."
    if count > _TEAM_MAX_MEMBERS:
        return None, f"Najwyżej {_TEAM_MAX_MEMBERS} członków razem z prowadzącym (jest {count})."
    pol = t.get("policy") if isinstance(t.get("policy"), dict) else {}
    if pol.get("mode") not in (None, "ask", "auto", "read"):
        return None, "policy.mode to ask, auto albo read."
    tasks = [x for x in t.get("tasks") or [] if isinstance(x, dict)]
    return {"version": 1, "name": name, "title": str(t.get("title") or name)[:80],
            "description": str(t.get("description") or "")[:400], "lead": lead, "members": members,
            "tasks": tasks, "policy": pol}, ""


def _team_templates_list(cwd=None) -> list:
    out = [{**v, "scope": "builtin"} for v in _TEAM_BUILTINS.values()]
    for scope, d in _team_tpl_dirs(cwd).items():
        try:
            files = sorted(d.glob("*.json"))
        except OSError:
            files = []
        for p in files:
            try:
                t, err = _team_template_check(json.loads(p.read_text(encoding="utf-8")))
            except (OSError, ValueError):
                continue
            if t and not err:
                out.append({**t, "scope": scope})
    return out


def _team_template_get(name: str, cwd=None) -> tuple:
    name = str(name or "").strip()
    found = [t for t in _team_templates_list(cwd) if t["name"] == name or t["name"] == _slug(name)]
    order = {"project": 0, "global": 1, "builtin": 2}
    found.sort(key=lambda t: order.get(t.get("scope"), 3))
    if not found:
        names = ", ".join(sorted({t["name"] for t in _team_templates_list(cwd)}))
        return None, _Lf("Nie ma szablonu zespołu {0}. Dostępne: {1}", name, names)
    return {k: v for k, v in found[0].items() if k != "scope"}, ""


def _team_template_save(t, scope: str = "project", cwd=None) -> tuple:
    t, err = _team_template_check(t)
    if err:
        return "", err
    d = _team_tpl_dirs(cwd).get(scope if scope in ("project", "global") else "project")
    d.mkdir(parents=True, exist_ok=True)
    p = d / f"{t['name']}.json"
    p.write_text(json.dumps(t, ensure_ascii=False, indent=2) + "\n", encoding="utf-8")
    return str(p), ""


def _team_brains() -> list:
    """Mózgi do wyboru w edytorze składu (bez zapytań do sieci)."""
    out = [{"id": "", "label": _L("Model bieżący"), "kind": "current"},
           {"id": "mix", "label": _L("Mieszany: różne mózgi"), "kind": "mix"}]
    if load_device() or load_creds():
        out += [{"id": "lopus", "label": "Lopus", "kind": "domaai"},
