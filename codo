def use_local_agents() -> int:
    """Codo bez konta: pracują agenci zainstalowani na tym komputerze."""
    found = agents_available()
    if not found:
        print(red(_L("✗ Nie znalazłem agentów na tym komputerze."))
              + dim(_L(" Zainstaluj np. ") + _AGENTS["claude"]["install"] + _L(" albo podłącz klucz: codo login openai")))
        return 1
    models = agent_models()
    if len(models) == 1 or not (_tty() and sys.stdin and sys.stdin.isatty()):
        pick = models[0][0]
    else:
        pick = _choose_model(models, None, _L("Który agent ma pracować?")) or ""
    if not pick:
        print(dim(_L("  Anulowano.")))
        return 1
    _set_provider("agent")
    st = load_settings()
    st["model_agent"] = pick
    save_settings(st)
    kind = agent_kind(pick)
    print(green(_Lf('✓ Codo pracuje przez {0}', _AGENTS[kind]['label'])) + dim(_Lf(' na Twoim {0}, bez kredytów.', _AGENTS[kind]['plan'])))
    print(dim(_L("  Konto DomaAI (codo login) doda telefon, kanały i dokończenie pracy, gdy plan dojdzie do limitu.")))
    return 0


def cmd_agents(arg: str = "") -> int:
    """/agenci, codo agenci: wykryci agenci, stan limitów, przełączanie zapasu."""
    import time as _t
    a = (arg or "").strip().lower()
    st = load_settings()
    if a.startswith(("zapas", "fallback")):
        on = not a.endswith(("wył", "wyl", "off", "nie", "no"))
        st["agent_fallback"] = on
        save_settings(st)
        print(green("✓ ") + (_L("Przy limicie agenta pracę dokończy model Codo.") if on
                             else _L("Przy limicie agenta Codo zatrzyma się i zapyta.")))
        return 0
    if a in ("wył", "wyl", "off"):
        st["agents_off"] = True
        save_settings(st)
        print(green(_L("✓ Agenci zewnętrzni ukryci.")) + dim(_L(" /agenci wł przywraca.")))
        return 0
    if a in ("wł", "wl", "on"):
        st.pop("agents_off", None)
        save_settings(st)
    if a.startswith("acp"):
        # /agenci acp gemini wł|wył: agent z własnym trybem pracuje przez ACP (adapter albo flaga ACP)
        parts = a.split()
        kind = parts[1] if len(parts) > 1 else ""
        info = _AGENTS.get(kind) or {}
        if not info.get("native") or "acp" not in info:
            natives = ", ".join(k for k, v in _AGENTS.items() if v.get("native") and "acp" in v)
            print(dim(_Lf('  Użycie: /agenci acp AGENT wł|wył (AGENT: {0}). Pozostali agenci zawsze pracują przez ACP.', natives)))
            return 1
        on = not (len(parts) > 2 and parts[2] in ("wył", "wyl", "off", "nie", "no"))
        chosen = [k for k in (st.get("agent_acp") or []) if k != kind] + ([kind] if on else [])
        st["agent_acp"] = chosen
        save_settings(st)
        SESSION.get("agent_sid", {}).pop(kind, None)
        if on:
            print(green(_Lf('✓ {0} pracuje teraz przez ACP.', info['label']))
                  + (dim(_L(" Adapter: ") + info['acp_install']) if info.get('acp_install') else ""))
        else:
            print(green(_Lf('✓ {0} wraca do swojego trybu.', info['label'])))
        return 0
    found = dict((k, p) for k, p in ((k, _agent_bin(k)) for k in _AGENTS) if p)
    versions: dict = {}
    if found:
        from concurrent.futures import ThreadPoolExecutor
        with ThreadPoolExecutor(max_workers=min(8, len(found))) as pool:
            for k, v in zip(found, pool.map(_agent_version, found.values())):
                versions[k] = v
    rows = []
    missing = []
    for k, info in _AGENTS.items():
        p = found.get(k)
        acp = _agent_acp(k)
        if not p:
            how = info.get("acp_install") if acp and info.get("acp_install") else info["install"]
            missing.append(dim(_Lf('○ {0}  nie zainstalowany · {1}', info['label'], how)))
            continue
        lim = (SESSION.get("agent_limit") or {}).get(k)
        state = (yellow(_Lf('w limicie, wraca za {0} min', max(1, int((lim - _t.time()) / 60)))) if lim and lim > _t.time()
                 else green(_L("gotowy")))
        tag = dim(" ACP") if acp else ""
        rows.append(f"{green('●')} {bold(info['label'])} {dim(versions.get(k, ''))}{tag}  {state}  {dim('/model agent:' + k)}")
    rows += missing
    rows.append("")
    rows.append(dim(_L("Zapas przy limicie: ") + (_L("model Codo") if st.get("agent_fallback", True) else _L("wyłączony"))
                    + _L(" · /agenci zapas wł|wył")))
    rows.append(dim(_L("Agenci pracują na Twoim planie u dostawcy. Codo ich nie rozlicza.")))
    rows.append(dim(_L("ACP: Codo rozmawia z agentem przez Agent Client Protocol. /agenci acp gemini wł przełącza agenta z własnym trybem.")))
    panel(_L("Agenci na tym komputerze"), rows)
    return 0


# ── Agenci ACP (Agent Client Protocol, agentclientprotocol.com): JSON-RPC 2.0 po stdio (0.24.0) ──
# Jeden klient dla każdego agenta CLI z trybem ACP. Codo jest klientem: startuje agenta w folderze
# projektu, prowadzi sesję (initialize, session/new|load, session/prompt, session/cancel) i obsługuje
# jego prośby: zgody (ta sama karta co dla narzędzi Codo), odczyt i zapis plików (tylko w folderze
# projektu, z kopią w .doma/backups) oraz terminale (polecenia w folderze projektu, wyjście z limitem).
# Proces agenta żyje jedną turę; ciągłość rozmowy daje session/load (gdy agent ją ma) albo skrót
# rozmowy w pierwszym poleceniu nowej sesji, jak u pozostałych agentów.

_ACP_PROTOCOL = 1
_ACP_INIT_TIMEOUT = 120      # s: pierwsze npx może ściągać adapter
_ACP_READ_KINDS = ("read", "search", "think", "fetch")
_ACP_KIND_TOOL = {"read": "read_file", "edit": "edit_file", "delete": "edit_file", "move": "edit_file",
                  "search": "grep", "execute": "run_command", "fetch": "web_fetch"}


def _agent_acp(kind: str) -> bool:
    """Czy agent pracuje przez ACP. Agenci z własnym trybem (Claude Code, Codex, Gemini CLI, Grok)
    zostają na nim, chyba że użytkownik włączy ACP: /agenci acp gemini wł."""
    info = _AGENTS.get(kind) or {}
    if "acp" not in info:
        return False
    if not info.get("native"):
        return True
    return kind in (load_settings().get("agent_acp") or [])


def _agent_login_cmd(kind: str) -> str:
    """Polecenie logowania do uruchomienia w Terminalu (okno Codo), gdy podpowiedź zaczyna się od programu."""
    info = _AGENTS.get(kind) or {}
    cmd = str(info.get("login") or "").split(",")[0].split(" (")[0].strip()
    bins = info.get("bin") if isinstance(info.get("bin"), list) else [info.get("bin")]
    known = [str(b) for b in bins if b] + [str(b).replace("-acp", "") for b in bins if b] + ["docker"]
    return cmd if cmd and cmd.split()[0] in known else ""


class _AcpError(Exception):
    def __init__(self, error):
        err = error if isinstance(error, dict) else {"message": str(error)}
        self.code = err.get("code")
        data = err.get("data")
        msg = str(err.get("message") or "błąd ACP")
        if isinstance(data, dict) and data.get("message"):
            msg += ": " + str(data["message"])
        elif isinstance(data, str) and data:
            msg += ": " + data
        super().__init__(msg)


class _AcpTerminal:
    """terminal/create: polecenie agenta w folderze projektu, wyjście scalone z limitem bajtów."""

    def __init__(self, command: str, args: list, cwd: Path, env: dict, limit: int | None):
        kwargs = {"start_new_session": True} if not IS_WIN else {
            "creationflags": getattr(subprocess, "CREATE_NEW_PROCESS_GROUP", 0)}
        argv = [command] + [str(a) for a in args] if args else command
        self.proc = subprocess.Popen(argv, shell=not args, cwd=str(cwd), env=env, stdin=subprocess.DEVNULL,
                                     stdout=subprocess.PIPE, stderr=subprocess.STDOUT, **kwargs)  # nosec B602
        self.limit = int(limit) if limit else 1_000_000
        self.buf = b""
        self.truncated = False
        self.done = threading.Event()
        threading.Thread(target=self._pump, daemon=True).start()

    def _pump(self) -> None:
        for chunk in iter(lambda: self.proc.stdout.read1(4096) if hasattr(self.proc.stdout, "read1")
                          else self.proc.stdout.read(4096), b""):
            self.buf += chunk
            if len(self.buf) > self.limit:
                cut = len(self.buf) - self.limit
                while cut < len(self.buf) and (self.buf[cut] & 0xC0) == 0x80:   # granica znaku UTF-8
                    cut += 1
                self.buf = self.buf[cut:]
                self.truncated = True
        self.proc.wait()
        self.done.set()

    def exit_status(self) -> dict | None:
        if not self.done.is_set():
            return None
        rc = self.proc.returncode
        if rc is not None and rc < 0:
            import signal as _sig
            try:
                return {"exitCode": None, "signal": _sig.Signals(-rc).name}
            except ValueError:
                return {"exitCode": None, "signal": str(-rc)}
        return {"exitCode": rc, "signal": None}

    def output(self) -> dict:
        out = {"output": self.buf.decode("utf-8", errors="replace"), "truncated": self.truncated}
        st = self.exit_status()
        if st:
            out["exitStatus"] = st
        return out

    def kill(self) -> None:
        if self.proc.poll() is None:
            _kill_tree(self.proc)


class _AcpRun(_AgentRun):
    """Tura agenta ACP: session/update → panel Codo, prośby agenta → zgody, pliki, terminale."""

    def __init__(self, kind: str, quiet: bool, mode: str, auto_yes: bool):
        super().__init__(kind, quiet)
        self.mode = mode
        self.auto_yes = auto_yes
        self.calls: dict = {}           # toolCallId → zebrany stan wywołania
        self.before: dict = {}          # Path → [treść sprzed zmiany, czy plik istniał]
        self.touched: list = []         # pliki zapisane przez fs/write_text_file, jeszcze nie pokazane
        self.terminals: dict = {}
        self.loading = False            # session/load odtwarza historię: nie pokazujemy jej drugi raz
        self.stream = None
        self._gem = ""
        self._thought = ""
        self._thought_t0 = None
        self.stop = ""
        self.plan_sig = None

    @property
    def label(self) -> str:
        return _AGENTS[self.kind]["label"]

    # tekst i myślenie
    def _chunk(self, text: str) -> None:
        if not text:
            return
        self._flush_thought()
        self._gem += text
        if self.quiet:
            return
        if self.stream is None:
            self.stream = _AnswerStream()
            LIVE.status(self.label + _L(" pisze"))
        self.stream.feed(text)

    def _flush_gem(self) -> None:
        text, self._gem = self._gem, ""
        if self.stream is not None:
            self.stream.finish()
            self.stream = None
        if text.strip():
            self.texts.append(text.strip())

    def _think(self, text: str) -> None:
        import time as _t
        if not text:
            return
        if self._thought_t0 is None:
            self._thought_t0 = _t.monotonic()
        self._thought += text
        if not self.quiet:
            LIVE.add_tokens(max(1, len(text) // 4))
            LIVE.status(_L("Myślę"), " ".join(self._thought.split())[-110:])

    def _flush_thought(self) -> None:
        import time as _t
        if self._thought_t0 is None:
            return
        secs = _t.monotonic() - self._thought_t0
        text, self._thought, self._thought_t0 = self._thought, "", None
        if not self.quiet and text.strip():
            LIVE.thought += float(secs)
            SYNC.add("thinking", {"sekundy": round(float(secs), 1), "tekst": text[-4000:]})

    # pliki
    def _path(self, p) -> Path:
        return _safe_path(str(p or ""))

    def _remember_before(self, path: Path) -> None:
        if path in self.before:
            return
        try:
            if path.is_file() and path.stat().st_size < 2_000_000:
                self.before[path] = [_read_text_keep(path), True]
            elif not path.exists():
                self.before[path] = ["", False]
        except (OSError, ValueError):
            pass

    def _record(self, path: Path, old: str, existed: bool, backed: bool = False) -> dict | None:
        try:
            new = path.read_text(encoding="utf-8", errors="replace") if path.is_file() else ""
        except OSError:
            return None
        if new == old:
            return None
        if existed and not backed:
            _backup_text(path, old)
        a, r = _linedelta(old, new)
        with _EDIT_LOCK:
            _EDIT_SEQ[0] += 1
            entry = {"seq": _EDIT_SEQ[0], "path": path, "added": a, "removed": r,
                     "new_file": not existed, "diff": _unified(path, old, new)}
            EDIT_LOG.append(entry)
        return entry

    def _show_edits(self, entries: list) -> None:
        if self.quiet:
            return
        for entry in entries:
            _print_edit(entry)
            if entry["path"] not in SESSION["edited"]:
                SESSION["edited"].append(entry["path"])

    @staticmethod
    def _now(path: Path) -> str | None:
        try:
            return path.read_text(encoding="utf-8", errors="replace") if path.is_file() else ""
        except OSError:
            return None

    def _settle(self, paths: list, diffs: dict) -> list:
        """Zmiany plików po zakończonym narzędziu: stan sprzed (kopia Codo, zapis przez fs/write albo
        oldText z diffu agenta) kontra stan na dysku."""
        entries = []
        for path in paths:
            prev = self.before.pop(path, None)
            backed = path in self.touched
            if path in self.touched:
                self.touched.remove(path)
            if path in diffs and (prev is None or (not backed and self._now(path) == prev[0])):
                # kopia Codo mogła powstać już po zapisie agenta (wyścig): wtedy stan sprzed daje oldText
                old = diffs[path]
                prev = [old or "", old is not None]
            if prev is None:
                continue
            entry = self._record(path, prev[0], prev[1], backed=backed)
            if entry:
                entries.append(entry)
        return entries

    # narzędzia
    def _tool_args(self, call: dict) -> tuple:
        """(nazwa Codo, argumenty Codo) z wywołania ACP: kind, rawInput, locations, title."""
        kind = str(call.get("kind") or "other")
        raw = call.get("rawInput") if isinstance(call.get("rawInput"), dict) else {}
        title = str(call.get("title") or "")
        name = _ACP_KIND_TOOL.get(kind) or _AGENT_TOOL_MAP.get(title.split(" ")[0].lower().strip("`:"), "")
        if kind == "think":
            name = ""
        cargs = dict(raw)
        for src, dst in (("file_path", "path"), ("absolute_path", "path"), ("filePath", "path"),
                         ("pattern", "pattern"), ("url", "url"), ("query", "query"), ("cmd", "command")):
            if src in cargs and dst not in cargs:
                cargs[dst] = cargs[src]
        locs = [loc.get("path") for loc in call.get("locations") or [] if isinstance(loc, dict) and loc.get("path")]
        if locs and not cargs.get("path"):
            cargs["path"] = locs[0]
        if isinstance(cargs.get("command"), list):
            cargs["command"] = " ".join(str(x) for x in cargs["command"])
        if name == "run_command" and not cargs.get("command"):
            cargs["command"] = title.strip("`")
        if cargs.get("path"):
            try:
                cargs["path"] = str(Path(str(cargs["path"])).resolve().relative_to(Path.cwd().resolve()))
            except (ValueError, OSError):
                pass
        return name, cargs, title, kind

    def _call_paths(self, call: dict) -> tuple:
        """(ścieżki w projekcie, {ścieżka: oldText}) z locations i z diffów w content."""
        paths, diffs = [], {}
        items = [loc.get("path") for loc in call.get("locations") or [] if isinstance(loc, dict)]
        for c in call.get("content") or []:
            if isinstance(c, dict) and c.get("type") == "diff" and c.get("path"):
                items.append(c["path"])
                try:
                    diffs[self._path(c["path"])] = c.get("oldText")
                except ValueError:
                    pass
        for p in items:
            try:
                path = self._path(p)
            except ValueError:
                continue
            if path not in paths:
                paths.append(path)
        return paths, diffs

    def _tool_start(self, call: dict) -> None:
        tid = str(call.get("toolCallId") or "")
        self.calls[tid] = dict(call)
        name, cargs, title, kind = self._tool_args(call)
        if kind in ("edit", "delete", "move"):
            for path in self._call_paths(call)[0]:
                self._remember_before(path)
        header = _tool_header(name, cargs) if name else (bold(title) if title else kind)
        self.pending[tid] = (name or "other", header, {}, cargs)
        self.tools += 1
        SESSION["turn_steps"] = SESSION.get("turn_steps", 0) + 1
        if not self.quiet:
            LIVE.status(_TOOL_VERBS.get(name, title or kind))
            LIVE.tool_begin(header, _tool_icon(name or "other"), _tool_detail(name, cargs) if name else "",
                            name=name or title or kind, args=cargs)

    def _tool_output(self, call: dict) -> str:
        out = []
        for c in call.get("content") or []:
            if not isinstance(c, dict):
                continue
            if c.get("type") == "content" and isinstance(c.get("content"), dict):
                out.append(str(c["content"].get("text") or ""))
            elif c.get("type") == "terminal" and c.get("terminalId") in self.terminals:
                out.append(self.terminals[c["terminalId"]].output()["output"])
        if not any(x.strip() for x in out) and call.get("rawOutput") is not None:
            raw = call["rawOutput"]
            if isinstance(raw, dict):
                raw = raw.get("output") or raw.get("stdout") or raw.get("content") or raw.get("result") or ""
            out.append(raw if isinstance(raw, str) else json.dumps(raw, ensure_ascii=False)[:4000])
        return "\n".join(x for x in out if x)

    def _tool_end(self, tid: str) -> None:
        call = self.calls.get(tid) or {}
        if tid not in self.pending:
            self._tool_start(call)
        name, header, _snap, cargs = self.pending.pop(tid)
        ok = call.get("status") != "failed"
        paths, diffs = self._call_paths(call)
        if str(call.get("kind") or "") in ("edit", "delete", "move") or diffs:
            paths += [p for p in self.touched if p not in paths]
        entries = self._settle(paths, diffs)
        if self.quiet:
            return
        output = self._tool_output(call)
        lines = [] if entries else (_result_lines(name, output, False) if output or ok
                                    else [red(_L("Nie udało się"))])
        LIVE.tool_end(ok, header, lines, name=name if name != "other" else "", collapse=not entries, full=output)
        self._show_edits(entries)

    def _plan(self, entries: list) -> None:
        todos = [{"content": str(e.get("content") or ""), "status": str(e.get("status") or "pending")}
                 for e in entries if isinstance(e, dict) and str(e.get("content") or "").strip()]
        sig = json.dumps(todos, sort_keys=True)
        if not todos or sig == self.plan_sig:
            return
        self.plan_sig = sig
        result = t_todo_write({"todos": todos})
        if self.quiet:
            return
        header = _tool_header("todo_write", {})
        LIVE.tool_begin(header, _tool_icon("todo_write"))
        LIVE.tool_end(True, header, _todo_lines(result), name="todo_write", collapse=False)

    # session/update
    def update(self, upd: dict) -> None:
        if not isinstance(upd, dict):
            return
        t = upd.get("sessionUpdate")
        if self.loading:
            return
        if t == "agent_message_chunk":
            c = upd.get("content") if isinstance(upd.get("content"), dict) else {}
            if c.get("type", "text") == "text":
                self._chunk(str(c.get("text") or ""))
        elif t == "agent_thought_chunk":
            c = upd.get("content") if isinstance(upd.get("content"), dict) else {}
            self._think(str(c.get("text") or ""))
        elif t == "tool_call":
            self._flush_gem()
            self._flush_thought()
            tid = str(upd.get("toolCallId") or "")
            self._tool_start(upd)
            if upd.get("status") in ("completed", "failed"):
                self._tool_end(tid)
        elif t == "tool_call_update":
            tid = str(upd.get("toolCallId") or "")
            call = self.calls.setdefault(tid, {"toolCallId": tid})
            for k, v in upd.items():
                if k != "sessionUpdate" and v is not None:
                    call[k] = v
            if tid not in self.pending and call.get("status") not in ("completed", "failed"):
                self._flush_gem()
                self._tool_start(call)
            elif call.get("status") in ("completed", "failed"):
                self._flush_gem()
                self._tool_end(tid)
        elif t == "plan":
            self._flush_gem()
            self._plan(upd.get("entries") or [])

    # prośby agenta
    def permission(self, params: dict) -> dict:
        call = params.get("toolCall") if isinstance(params.get("toolCall"), dict) else {}
        tid = str(call.get("toolCallId") or "")
        merged = dict(self.calls.get(tid) or {}, **{k: v for k, v in call.items() if v is not None})
        options = [o for o in params.get("options") or [] if isinstance(o, dict) and o.get("optionId")]

        def pick(allow: bool) -> dict:
            wanted = ("allow_once", "allow_always") if allow else ("reject_once", "reject_always")
            for w in wanted:
                for o in options:
                    if o.get("kind") == w:
                        return {"outcome": {"outcome": "selected", "optionId": o["optionId"]}}
            if allow and options:
                return {"outcome": {"outcome": "selected", "optionId": options[0]["optionId"]}}
            return {"outcome": {"outcome": "cancelled"}}

        name, cargs, title, kind = self._tool_args(merged)
        if self.mode == "read":
            return pick(kind in _ACP_READ_KINDS)
        if self.auto_yes or kind in _ACP_READ_KINDS + ("edit", "delete", "move"):
            # tryb pytania: edycje w folderze bez pytania (kopie i /undo), jak u innych agentów
            if kind in ("edit", "delete", "move"):
                for path in self._call_paths(merged)[0]:
                    self._remember_before(path)
            return pick(True)
        self._flush_gem()
        if name == "run_command" and cargs.get("command"):
            cmd = str(cargs["command"])
            ok = confirm_action(_L("Czy uruchomić tę komendę?"), cmd, ["command", cmd],
                                reason=_Lf('{0} chce uruchomić polecenie w tym folderze.', self.label))
        else:
            detail = title or kind
            if cargs.get("path"):
                detail += "\n" + str(cargs["path"])
            ok = confirm_action(_Lf('Zgoda dla {0}?', self.label), detail, ["acp", self.kind, kind, title],
                                reason=_Lf('{0} prosi o zgodę na tę czynność.', self.label))
        return pick(ok)

    def handle(self, method: str, params: dict) -> object:
        """Odpowiedź na żądanie agenta albo wyjątek _AcpError."""
        if method == "session/request_permission":
            return self.permission(params)
        if method == "fs/read_text_file":
            try:
                path = self._path(params.get("path"))
                text = path.read_text(encoding="utf-8", errors="replace")
            except (ValueError, OSError) as e:
                raise _AcpError({"code": -32002, "message": str(e)}) from None
            line, limit = params.get("line"), params.get("limit")
            if line or limit:
                rows = text.splitlines(keepends=True)
                start = max(0, int(line or 1) - 1)
                text = "".join(rows[start:start + int(limit)] if limit else rows[start:])
            return {"content": text}
        if method == "fs/write_text_file":
            if self.mode == "read":
                raise _AcpError({"code": -32000, "message": "Codo is in read only mode: no file changes."})
            busy = _team_reserved(str(params.get("path") or ""))
            if busy:
                raise _AcpError({"code": -32000, "message": busy})   # zespół bez gita: plik innego zadania
            try:
                path = self._path(params.get("path"))
                if path not in self.touched:
                    self._remember_before(path)
                    prev = self.before.get(path)
                    if prev and prev[1]:
                        _backup_text(path, prev[0])   # kopia przed pierwszym zapisem w tej turze: /undo
                    self.touched.append(path)
                path.parent.mkdir(parents=True, exist_ok=True)
                path.write_text(str(params.get("content") or ""), encoding="utf-8")
            except (ValueError, OSError) as e:
                raise _AcpError({"code": -32002, "message": str(e)}) from None
            return None
        if method == "terminal/create":
            if self.mode == "read":
                raise _AcpError({"code": -32000, "message": "Codo is in read only mode: no commands."})
            try:
                cwd = self._path(params.get("cwd") or str(Path.cwd()))
                env = dict(os.environ)
                for e in params.get("env") or []:
                    if isinstance(e, dict) and e.get("name"):
                        env[str(e["name"])] = str(e.get("value") or "")
                term = _AcpTerminal(str(params.get("command") or ""), list(params.get("args") or []), cwd, env,
                                    params.get("outputByteLimit"))
            except (ValueError, OSError) as e:
                raise _AcpError({"code": -32002, "message": str(e)}) from None
            self.n_term = getattr(self, "n_term", 0) + 1
            tid = f"term-{self.n_term}"
            self.terminals[tid] = term
            return {"terminalId": tid}
        if method.startswith("terminal/"):
            term = self.terminals.get(str(params.get("terminalId") or ""))
            if term is None:
                raise _AcpError({"code": -32602, "message": "unknown terminalId"})
            if method == "terminal/output":
                return term.output()
            if method == "terminal/kill":
                term.kill()
                return None
            if method == "terminal/release":
                term.kill()
                return None
            if method == "terminal/wait_for_exit":
                return "__wait__"
        raise _AcpError({"code": -32601, "message": f"Method not found: {method}"})

    def close_terminals(self) -> None:
        for term in self.terminals.values():
            term.kill()

    def flush_rest(self) -> None:
        self._flush_gem()
        self._flush_thought()
        for tid in list(self.pending):
            call = self.calls.setdefault(tid, {"toolCallId": tid})
            call.setdefault("status", "failed")
            self._tool_end(tid)
        if self.touched:
            entries = self._settle(list(self.touched), {})
            self._show_edits(entries)


class _AcpConn:
    """JSON-RPC 2.0 po stdio: wątek czyta linie agenta do kolejki, główny wątek prowadzi rozmowę."""

    def __init__(self, proc, run: _AcpRun):
        import queue
        self.proc = proc
        self.run = run
        self.q: "queue.Queue" = queue.Queue()
        self.n = 0
        self.wlock = threading.Lock()
        self.sid = None
        threading.Thread(target=self._reader, daemon=True).start()

    def _reader(self) -> None:
        for raw in iter(self.proc.stdout.readline, b""):
            line = raw.decode("utf-8", errors="replace").strip()
            if not line.startswith("{"):
                continue
            try:
                msg = json.loads(line)
            except ValueError:
                continue
            if isinstance(msg, dict):
                self.q.put(msg)
        self.q.put(None)

    def send(self, obj: dict) -> None:
        data = (json.dumps(dict({"jsonrpc": "2.0"}, **obj), ensure_ascii=False) + "\n").encode("utf-8")
        with self.wlock:
            try:
                self.proc.stdin.write(data)
                self.proc.stdin.flush()
            except (OSError, ValueError):
                pass

    def _answer(self, mid, method: str, params: dict) -> None:
        try:
            result = self.run.handle(method, params if isinstance(params, dict) else {})
        except _AcpError as e:
            self.send({"id": mid, "error": {"code": e.code or -32603, "message": str(e)}})
            return
        except Exception as e:   # błąd po stronie Codo nie może zawiesić agenta
            self.send({"id": mid, "error": {"code": -32603, "message": str(e)[:300]}})
            return
        if result == "__wait__":
            term = self.run.terminals[str(params.get("terminalId"))]

            def later():
                term.done.wait()
                self.send({"id": mid, "result": term.exit_status()})
            threading.Thread(target=later, daemon=True).start()
            return
        self.send({"id": mid, "result": result})

    def pump(self, wait_id=None, deadline: float | None = None, cancelling: bool = False):
        """Obsługuje wiadomości do odpowiedzi na wait_id; zwraca jej wynik albo rzuca _AcpError."""
        import queue
        import time as _t
        while True:
            left = None if deadline is None else deadline - _t.monotonic()
            if left is not None and left <= 0:
                raise TimeoutError
            try:
                msg = self.q.get(timeout=min(0.25, left) if left is not None else 0.25)
            except queue.Empty:
                continue
            if msg is None:
                raise _AcpError({"code": -32099, "message": "agent process ended"})
            method = msg.get("method")
            if method and "id" in msg:
                if cancelling and method == "session/request_permission":
                    self.send({"id": msg["id"], "result": {"outcome": {"outcome": "cancelled"}}})
                else:
                    self._answer(msg["id"], str(method), msg.get("params") or {})
            elif method:
                if method == "session/update":
                    p = msg.get("params") or {}
                    if not self.sid or p.get("sessionId") in (None, self.sid):
                        self.run.update(p.get("update") or {})
            elif "id" in msg and msg.get("id") == wait_id:
                if msg.get("error") is not None:
                    raise _AcpError(msg["error"])
                return msg.get("result")

    def call(self, method: str, params: dict, timeout: float | None = None):
        import time as _t
        self.n += 1
        mid = self.n
        self.send({"id": mid, "method": method, "params": params})
        return self.pump(mid, None if timeout is None else _t.monotonic() + timeout)


def _acp_mcp_servers() -> list:
    env = [{"name": n, "value": v} for n, v in _agent_mcp_env().items()]
    return [{"name": k, "command": c[0], "args": c[1:], "env": env} for k, c in _agent_mcp_servers().items()]


def run_acp_agent(kind: str, prompt: str, mode: str, auto_yes: bool, sid: str | None = None,
                  quiet: bool = False, timeout: float | None = None) -> _AcpRun:
    """Jedna tura agenta ACP. Esc/Ctrl+C: session/cancel, krótka chwila na domknięcie, potem koniec procesu."""
    import tempfile
    import time as _t
    run = _AcpRun(kind, quiet, mode, auto_yes)
    info = _AGENTS[kind]
    path = _agent_bin(kind)
    if not path:
        run.errors.append(_Lf('Nie znaleziono {0}. Instalacja: {1}', info['label'], info['install']))
        return run
    argv = [path] + list(info["acp"])
    env = dict(os.environ)
    env.pop("CLAUDECODE", None)
    env.setdefault("NO_COLOR", "1")
    err_file = tempfile.TemporaryFile()
    kwargs = {"start_new_session": True} if not IS_WIN else {
        "creationflags": getattr(subprocess, "CREATE_NEW_PROCESS_GROUP", 0)}
    try:
        proc = subprocess.Popen(argv, stdin=subprocess.PIPE, stdout=subprocess.PIPE, stderr=err_file,
                                cwd=str(Path.cwd()), env=env, **kwargs)
    except OSError as e:
        run.errors.append(_Lf('Nie uruchomiono {0}: {1}', info['label'], e))
        return run
    conn = _AcpConn(proc, run)
    started = _t.monotonic()
    prompt_id = None
    try:
        init = conn.call("initialize", {
            "protocolVersion": _ACP_PROTOCOL,
            "clientCapabilities": {"fs": {"readTextFile": True, "writeTextFile": True}, "terminal": True},
            "clientInfo": {"name": "codo", "title": "Codo", "version": VERSION}}, timeout=_ACP_INIT_TIMEOUT) or {}
        caps = init.get("agentCapabilities") or {}
        cwd = str(Path.cwd())
        session = None
        if sid and caps.get("loadSession"):
            run.loading = True
            try:
                session = conn.call("session/load", {"sessionId": sid, "cwd": cwd, "mcpServers": _acp_mcp_servers()},
                                    timeout=_ACP_INIT_TIMEOUT) or {}
                conn.sid = sid
            except _AcpError as e:
                run.errors.append(f"session not found ({e})")
                return run
            finally:
                run.loading = False
        elif sid:
            run.errors.append("session not found (agent without session/load)")
            return run
        else:
            session = conn.call("session/new", {"cwd": cwd, "mcpServers": _acp_mcp_servers()},
                                timeout=_ACP_INIT_TIMEOUT) or {}
            conn.sid = str(session.get("sessionId") or "")
        if caps.get("loadSession") and conn.sid:
            run.sid = conn.sid
        modes = session.get("modes") if isinstance(session.get("modes"), dict) else {}
        ids = [str(m.get("id")) for m in modes.get("availableModes") or [] if isinstance(m, dict)]
        want = None
        if mode == "read":
            want = next((m for m in ("plan", "read-only", "readonly", "read_only", "ask") if m in ids), None)
        if want and want != modes.get("currentModeId"):
            try:
                conn.call("session/set_mode", {"sessionId": conn.sid, "modeId": want}, timeout=30)
            except (_AcpError, TimeoutError):
                pass
        text = prompt
        if not sid:
            text = _agent_system() + "\n\n" + prompt
        if mode == "read":
            text = "READ ONLY: do not change files and do not run commands that change anything.\n\n" + text
        conn.n += 1
        prompt_id = conn.n
        conn.send({"id": prompt_id, "method": "session/prompt",
                   "params": {"sessionId": conn.sid, "prompt": [{"type": "text", "text": text}]}})
        result = conn.pump(prompt_id, None if not timeout else started + timeout) or {}
        run.stop = str(result.get("stopReason") or "")
        if isinstance(result.get("usage"), dict):
            run.usage = result["usage"]
        if run.stop == "refusal":
            run.fail(_Lf('{0} odmówił wykonania tego polecenia.', info['label']))
        elif run.stop in ("max_tokens", "max_turn_requests"):
            run.errors.append(_L("Agent doszedł do limitu kroków w tej turze."))
    except TimeoutError:
        run.errors.append(f"Przekroczono czas {int(timeout or _ACP_INIT_TIMEOUT)} s.")
        if prompt_id and conn.sid:
            conn.send({"method": "session/cancel", "params": {"sessionId": conn.sid}})
    except _AcpError as e:
        run.fail(str(e))
        if e.code == -32000 or re.search(r"auth", str(e), re.I):
            run.auth = True
    except KeyboardInterrupt:
        if prompt_id and conn.sid:
            conn.send({"method": "session/cancel", "params": {"sessionId": conn.sid}})
            try:
                conn.pump(prompt_id, _t.monotonic() + 3, cancelling=True)
            except (_AcpError, TimeoutError, KeyboardInterrupt):
                pass
        run.close_terminals()
        _kill_tree(proc)
        run.flush_rest()
        raise
    finally:
        run.close_terminals()
        try:
            proc.stdin.close()
        except OSError:
            pass
        try:
            proc.wait(timeout=3)
        except subprocess.TimeoutExpired:
            _kill_tree(proc)
        try:
            err_file.seek(0)
            err = err_file.read()[-4000:].decode("utf-8", errors="replace")
        except (OSError, ValueError):
            err = ""
        err_file.close()
    run.flush_rest()
    if not run.texts and not run.tools and err.strip():
        # agent padł zanim cokolwiek powiedział (np. „Not signed in” tylko na stderr): człowiek ma wiedzieć dlaczego
        tail = "\n".join(x for x in err.strip().splitlines()[-6:] if x.strip())
        if _AGENT_LIMIT_RE.search(tail):
            run.fail(tail)
        elif _AGENT_AUTH_RE.search(tail):
            run.auth = True
            run.errors.append(tail[:600])
        elif not run.errors and proc.returncode not in (0, None):
            run.errors.append(tail[:600])
    return run


