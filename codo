_IMSG_EPOKA = 978307200   # 2001-01-01 w sekundach Uniksa


def _imsg_baza() -> Path:
    return Path(os.environ.get("CODO_IMESSAGE_DB") or (Path.home() / "Library/Messages/chat.db"))


def _imsg_polacz():
    import sqlite3
    sciezka = _imsg_baza()
    if not sciezka.exists():
        return None, _L("Na tym Macu nie ma bazy Wiadomości (aplikacja Wiadomości nie była używana).")
    try:
        con = sqlite3.connect(f"file:{sciezka}?mode=ro", uri=True, timeout=5)
        con.execute("select 1 from message limit 1")
        return con, ""
    except sqlite3.Error:
        return None, _L("Codo nie ma dostępu do Wiadomości. Powiedz userowi: Ustawienia systemowe, Prywatność i ochrona, "
                        "Pełny dostęp do dysku, włącz Codo i uruchom Codo ponownie.")


def _imsg_tekst(text, blob) -> str:
    if text:
        return str(text)
    if not blob:
        return ""
    try:
        b = bytes(blob)
        i = b.index(b"NSString") + len(b"NSString")
        i = b.index(b"+", i) + 1
        n = b[i]
        i += 1
        if n == 0x81:
            n = int.from_bytes(b[i:i + 2], "little")
            i += 2
        elif n == 0x82:
            n = int.from_bytes(b[i:i + 4], "little")
            i += 4
        return b[i:i + n].decode("utf-8", "replace")
    except (ValueError, IndexError):
        return ""


def _imsg_czas(d) -> str:
    import time as _t
    try:
        d = int(d or 0)
    except (TypeError, ValueError):
        return ""
    sek = d / 1e9 if d > 1e12 else d
    return _t.strftime("%Y-%m-%d %H:%M", _t.localtime(sek + _IMSG_EPOKA))


def t_imessage(args: dict, ask=None) -> str:
    akcja = str(args.get("akcja") or "")
    limit = max(1, min(int(args.get("limit") or 30), 100))
    if akcja == "wyslij":
        return _imsg_wyslij(str(args.get("czat") or ""), str(args.get("do") or ""), str(args.get("tekst") or ""), ask)
    con, blad = _imsg_polacz()
    if con is None:
        return blad
    try:
        if akcja == "czaty":
            wiersze = con.execute(
                "select c.guid, coalesce(nullif(c.display_name,''), c.chat_identifier), c.service_name, max(m.date) "
                "from chat c join chat_message_join j on j.chat_id = c.ROWID join message m on m.ROWID = j.message_id "
                "group by c.ROWID order by max(m.date) desc limit ?", (limit,)).fetchall()
            return json.dumps([{"czat": g, "nazwa": n, "usluga": s, "ostatnia": _imsg_czas(d)} for g, n, s, d in wiersze],
                              ensure_ascii=False)
        if akcja in ("czytaj", "szukaj"):
            sql = ("select m.date, m.is_from_me, h.id, m.text, m.attributedBody, m.cache_has_attachments, c.guid "
                   "from message m left join handle h on h.ROWID = m.handle_id "
                   "join chat_message_join j on j.message_id = m.ROWID join chat c on c.ROWID = j.chat_id ")
            if akcja == "czytaj":
                czat = str(args.get("czat") or "")
                if not czat:
                    return _L("Podaj `czat` (id z akcji czaty).")
                wiersze = con.execute(sql + "where c.guid = ? or c.chat_identifier = ? order by m.date desc limit ?",
                                      (czat, czat, limit)).fetchall()
            else:
                fraza = str(args.get("fraza") or "").strip().lower()
                if not fraza:
                    return _L("Podaj `fraza`.")
                wiersze = [w for w in con.execute(sql + "order by m.date desc limit 20000").fetchall()
                           if fraza in _imsg_tekst(w[3], w[4]).lower()][:limit]
            out = []
            for d, ja, kto, text, blob, zal, guid in reversed(wiersze):
                tekst = _imsg_tekst(text, blob)
                if not tekst and not zal:
                    continue
                w = {"czas": _imsg_czas(d), "od": "ja" if ja else (kto or ""), "tekst": tekst[:2000] or _L("(załącznik)")}
                if akcja == "szukaj":
                    w["czat"] = guid
                out.append(w)
            return json.dumps(out, ensure_ascii=False) if out else _L("Brak wiadomości.")
        return _L("Nieznana akcja. Dostępne: czaty, czytaj, szukaj, wyslij.")
    finally:
        con.close()


def _imsg_wyslij(czat: str, do: str, tekst: str, ask=None) -> str:
    import subprocess
    tekst = tekst.strip()
    if not tekst or not (czat or do):
        return _L("Podaj `tekst` oraz `czat` (id z listy) albo `do` (numer telefonu lub e-mail).")
    if sys.platform != "darwin":
        return _L("iMessage działa tylko na Macu.")
    cel = czat or do
    pytanie = _Lf("Wysłać wiadomość do {0}?", cel) + "\n\n" + tekst[:1500]
    zgoda = (ask or (lambda q: confirm_action(_L("Wysłać iMessage?"), q, reason=_L("wiadomość do innej osoby"))))(pytanie)
    if not zgoda:
        return _L("User NIE zgodził się na wysłanie. Nic nie poszło.")
    if czat:
        skrypt = ['on run argv', 'tell application "Messages" to send (item 1 of argv) to chat id (item 2 of argv)', 'end run']
    else:
        skrypt = ['on run argv', 'tell application "Messages"',
                  'set s to 1st account whose service type = iMessage',
                  'send (item 1 of argv) to participant (item 2 of argv) of s', 'end tell', 'end run']
    argv = ["osascript"]
    for linia in skrypt:
        argv += ["-e", linia]
    r = subprocess.run(argv + [tekst, cel], capture_output=True, text=True, timeout=60)
    if r.returncode != 0:
        return _L("Wiadomości nie wysłały: ") + (r.stderr or "").strip()[:300]
    return json.dumps({"wyslano": True, "do": cel}, ensure_ascii=False)


