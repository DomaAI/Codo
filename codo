_OLD_COMMANDS = ("domaai", "doma", "domaai-code")


def _ensure_codo_command() -> bool:
    """Starsze instalacje mają tylko komendy domaai/doma. Dokłada obok `codo`
    (dowiązanie, na Windows kopia shima .cmd), żeby nowa nazwa działała po
    samej aktualizacji, bez ponownego instalatora. True = właśnie dodano."""
    try:
        launched = Path(sys.argv[0]).absolute()
        if IS_WIN:
            bin_dir = launched.parent
            new = bin_dir / "codo.cmd"
            if new.exists():
                return False
            for old in _OLD_COMMANDS:
                shim = bin_dir / f"{old}.cmd"
                if shim.is_file():
                    new.write_bytes(shim.read_bytes())   # bajty: shim jest w kodowaniu OEM
                    return True
            return False
        if launched.name not in _OLD_COMMANDS or (launched.parent / "install.sh").exists():
            return False                                  # uruchomienie z repo (plik też nazywa się doma)
        new = launched.parent / "codo"
        if new.exists() or new.is_symlink():
            return False
        os.symlink(launched.resolve(), new)
        return True
    except OSError:
        return False


