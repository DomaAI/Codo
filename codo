def _odf_replace(pkg, a: dict) -> str:
    find, repl = str(a.get("find") or ""), str(a.get("replace") if a.get("replace") is not None else "")
    if not find:
        raise _OfficeError("podaj find i replace")
    doc = pkg.xml("content.xml")
    pars = []
    for p in list(doc.getElementsByTagNameNS(_ODF_TEXT, "p")) + list(doc.getElementsByTagNameNS(_ODF_TEXT, "h")):
        if _ox_ancestor(p, _ODF_OFFICE, "annotation") is not None:
            continue
        cell = _ox_ancestor(p, _ODF_TABLE, "table-cell")
        if cell is not None and (_ox_attr(cell, "value-type", _ODF_OFFICE) or "string") != "string":
            continue   # liczba, data, waluta: tekst komórki to tylko widok wartości
        pars.append(p)
    order = {id(p): i for i, p in enumerate(doc.getElementsByTagName("*"))}
    pars.sort(key=lambda p: order.get(id(p), 0))
    n, places = _ox_replace_in(pars, "odf", find, repl, bool(a.get("all")), lambda p: "akapit")
    if places:
        raise _OfficeError(f"„{find}” występuje {n}× ({'; '.join(places)}). Podaj dłuższy fragment albo all=true")
    if not n:
        raise _OfficeError(_ox_not_found(pars, "odf", find, "dokumencie"))
    for p in pars:   # zapamiętana wartość tekstowa komórki przestałaby się zgadzać
        cell = _ox_ancestor(p, _ODF_TABLE, "table-cell")
        if cell is not None and cell.hasAttributeNS(_ODF_OFFICE, "string-value"):
            cell.removeAttributeNS(_ODF_OFFICE, "string-value")
    pkg.touch("content.xml")
    return f"zamiana {n}×"


def _pptx_plain_text(data: bytes) -> str | None:
    """Slajdy jako tekst do read_file i podglądu zmian: tytuł (#), każde pole tekstowe i tabela w kolejności
    na slajdzie, notatki prelegenta. Czytnik pokazu w Biurze pomija treść pierwszego slajdu, ten nie."""
    pkg = _OfficePkg(data)
    if not pkg.has("ppt/presentation.xml") and not pkg.rels(""):
        return None
    _pres, _doc, slides = _pptx_slides(pkg)
    out = []
    for n, part in enumerate(slides, 1):
        lines = [f"--- slajd {n} ---"]
        for sp in pkg.xml(part).getElementsByTagNameNS(_OX_P, "sp") + pkg.xml(part).getElementsByTagNameNS(_OX_P, "graphicFrame"):
            ph = _pptx_ph(sp) if sp.localName == "sp" else None
            ty = ph.getAttribute("type") if ph is not None else ""
            if ty in ("sldNum", "dt", "ftr"):
                continue
            for p in sp.getElementsByTagNameNS(_OX_A, "p"):
                t = _ox_par_text(p, "a")
                if not t.strip():
                    continue
                ppr = _ox_kid(p, _OX_A, "pPr")
                lvl = int(ppr.getAttribute("lvl") or 0) if ppr is not None else 0
                lines.append(("# " if ty in ("title", "ctrTitle") else "  " * lvl) + t)
        for nt in pkg.rels_of_type(part, "notesSlide"):
            if not pkg.has(nt):
                continue
            for sp in pkg.xml(nt).getElementsByTagNameNS(_OX_P, "sp"):
                ph = _pptx_ph(sp)
                if ph is not None and ph.getAttribute("type") == "body":
                    t = "\n".join(_ox_par_text(p, "a") for p in sp.getElementsByTagNameNS(_OX_A, "p")).strip()
                    if t:
                        lines.append("Notatki prelegenta: " + t)
        out.append("\n".join(lines))
    return "\n\n".join(out) if out else None


_OFFICE_ACTIONS = {
    "DOCX": {"replace": _docx_replace, "insert_paragraph": _docx_insert, "delete_paragraph": _docx_delete,
             "set_cell": _docx_set_cell, "add_row": _docx_add_row},
