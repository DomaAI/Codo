def _team_brain_provider(brain: str) -> str:
    b = str(brain or "")
    if b.startswith("agent:"):
        return "agent"
    if b.startswith("@"):
        return "endpoint"
    if b in ("lopus", "lopus-pro"):
        return "domaai"
    return ""


def _team_tools_mode(brain: str) -> str:
    """native: narzędzia Codo; mcp: agent dostaje serwer `codo mcp --zespol` (agenci claude, codex i ACP);
    text: blok ```zespol na końcu odpowiedzi (Lopus, Gemini CLI i Grok w trybie własnym)."""
    eff = str(brain or current_model(None) or "")
    kind = agent_kind(eff)
    if kind:
        return "mcp" if kind in ("claude", "codex") or _agent_acp(kind) else "text"
    return "text" if eff in ("lopus", "lopus-pro") else "native"


