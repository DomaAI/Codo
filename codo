                       ("pytest.ini", "conftest.py", "tests"))
                   or "pytest" in ((cwd / "pyproject.toml").read_text(encoding="utf-8", errors="replace")
                                   if (cwd / "pyproject.toml").exists() else "")):
        cmd = [pytest, "-q"] + (["-k", filt] if filt else [])
        desc = "pytest -q" + (f" -k {filt}" if filt else "")
    elif (cwd / "package.json").exists():
        try:
            pkg = json.loads((cwd / "package.json").read_text(encoding="utf-8"))
        except Exception:
            pkg = {}
        if (pkg.get("scripts") or {}).get("test"):
            cmd = ["npm", "test", "--silent"]
            desc = "npm test"
    if not cmd:
        return ("BŁĄD: nie wykryto testów (brak pytest/tests/ ani "
                "package.json scripts.test). Mogę je napisać — zapytaj usera.")
    _note("Testy", f"{bold(desc)}")
    if not auto_yes:
        if not confirm_action(_L("Uruchomić testy?"), desc, ["tests", cmd]):
            return "ODRZUCONE przez użytkownika — nie uruchamiam testów."
    code, out = _run_capture(cmd, timeout=600, tail=6000)
    status = "OK ✓" if code == 0 else f"BŁĘDY (exit={code})"
    return f"{desc} → {status}\n{out}"


