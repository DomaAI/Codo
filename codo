def _zgody_serwer() -> None:
    """Gniazdo zgód dla serwerów MCP agentów: pytanie → karta w oknie Codo → odpowiedź."""
    import socket
    import secrets
    # Gniazda po oknach, które już nie działają (zabity proces nie sprząta po sobie).
    try:
        for stare in CONFIG_DIR.glob("zgody-*.sock"):
            pid = stare.stem.split("-", 1)[1]
            if pid.isdigit():
                try:
                    os.kill(int(pid), 0)
                except ProcessLookupError:
                    stare.unlink(missing_ok=True)
                except OSError:
                    pass
    except OSError:
        pass
    sciezka = str(CONFIG_DIR / f"zgody-{os.getpid()}.sock")
    if len(sciezka.encode()) > 100:
        # Gniazdo uniksowe ma limit długości ścieżki (104 bajty na macOS): długi folder ustawień dostaje je w tmp.
        import tempfile
        sciezka = os.path.join(tempfile.gettempdir(), f"codo-zgody-{os.getpid()}.sock")
        if len(sciezka.encode()) > 100:
            sciezka = f"/tmp/codo-zgody-{os.getpid()}.sock"
    try:
        os.unlink(sciezka)
    except OSError:
        pass
    token = secrets.token_hex(16)
    s = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
    s.bind(sciezka)
    os.chmod(sciezka, 0o600)
    s.listen(4)
    os.environ["CODO_ZGODY_SOCK"], os.environ["CODO_ZGODY_TOKEN"] = sciezka, token
    import atexit
    atexit.register(lambda: os.path.exists(sciezka) and os.unlink(sciezka))

    def obsluz(c):
        with c:
            try:
                dane = b""
                while not dane.endswith(b"\n") and len(dane) < 400000:
                    k = c.recv(65536)
                    if not k:
                        break
                    dane += k
                msg = json.loads(dane.decode() or "{}")
                ok = False
                if msg.get("token") == token and str(msg.get("most") or "").startswith(("agenci.", "browser.")):
                    # Stały agent na Claude Code, Codexie albo ACP: jego narzędzia agenci i przeglądarka idą do okna
                    # tym gniazdem (przeglądarka to panel obok jego rozmowy, z jego własnym profilem).
                    limit = max(5.0, min(float(msg.get("timeout") or 60), 1300.0))
                    wynik = _app_call(str(msg["most"]), msg.get("args") if isinstance(msg.get("args"), dict) else {},
                                      timeout=limit)
                    c.sendall((json.dumps({"wynik": wynik}, ensure_ascii=False) + "\n").encode())
                    return
                if msg.get("token") == token:
                    ok = _app_ask(str(msg.get("tytul") or "")[:120] or _L("Agent prosi o zgodę na akcję"),
                                  str(msg.get("pytanie") or "")[:2000],
                                  _L("skutek poza Codo"), False) != 0
                c.sendall((json.dumps({"zgoda": ok}) + "\n").encode())
            except (OSError, ValueError):
                pass

    def petla():
        while True:
            try:
                c, _ = s.accept()
            except OSError:
                return
            threading.Thread(target=obsluz, args=(c,), daemon=True).start()
    threading.Thread(target=petla, daemon=True).start()


