    return _trig_has(frm + " " + str(m.get("name") or ""), sender) and _trig_has(m.get("subject") or "", subject)


def _trig_address(raw) -> tuple:
    """„Jan Kowalski <jan@firma.pl>” → ("jan@firma.pl", "Jan Kowalski")."""
    f = str(raw or "").strip()
    lt, gt = f.rfind("<"), f.rfind(">")
    if 0 <= lt < gt:
        n = f[:lt].strip()
        if len(n) >= 2 and n[0] == n[-1] == '"':
            n = n[1:-1]
        return f[lt + 1:gt].strip().lower(), n
    return f.lower(), ""


def _trig_pr_state(c: dict) -> str:
    status = str(c.get("status") or "").upper()
    concl = str(c.get("conclusion") or c.get("state") or "").upper()
    if status in ("IN_PROGRESS", "QUEUED", "PENDING") or concl in ("PENDING", "EXPECTED"):
        return "running"
    if concl in ("FAILURE", "ERROR", "TIMED_OUT", "CANCELLED", "ACTION_REQUIRED", "STARTUP_FAILURE"):
        return "failed"
    return "skipped" if concl in ("SKIPPED", "NEUTRAL") else "passed"


def _trig_pr_look(j) -> dict:
    """Wynik `gh pr view --json …` jako to, co wyzwalacz porównuje (PRWatch.look); numer 0: nie ma otwartego PR."""
    j = j if isinstance(j, dict) else {}
    notes = []
    for key, review in (("comments", False), ("reviews", True)):
        for n in j.get(key) or []:
            if not isinstance(n, dict):
                continue
            state = str(n.get("state") or "").upper() if review else ""
            if not n.get("id") or state == "PENDING":
                continue
            notes.append({"id": str(n["id"]), "author": str((n.get("author") or {}).get("login") or ""),
                          "body": str(n.get("body") or ""), "state": state})
    failed = [str(c.get("name") or c.get("context") or "check") for c in j.get("statusCheckRollup") or []
              if isinstance(c, dict) and _trig_pr_state(c) == "failed"]
    number = int(j.get("number") or 0) if str(j.get("state") or "") == "OPEN" else 0
    return {"number": number, "head": str(j.get("headRefOid") or ""), "failed": failed, "notes": notes,
            "url": str(j.get("url") or "")}


def _trig_pr_news(look: dict, seen) -> tuple:
    """Co nowego w PR od ostatniego spojrzenia; seen None = pierwsze spojrzenie: to, co jest, nie jest nowością."""
    num, head = look["number"], look["head"]
    every = set(seen or ())
    failed, notes = [], []
    for name in look["failed"]:
        k = f"c:{num}:{head}:{name}"
        if k not in every:
            every.add(k)
            failed.append(name)
    for n in look["notes"]:
        k = f"n:{num}:{n['id']}"
        if k not in every:
            every.add(k)
            notes.append(n)
    if seen is None or num <= 0:
        return [], [], every
    return failed, notes, every


def _trig_hook_item(body, event, at: str, cap: int = _TRIG_BODY_CAP) -> str:
