# ── Maraton: codo work na godziny i dni ──────────────────────────────────────

_WORK_DIR = ".doma/work"
_DONE_MARK = "PRACA ZAKOŃCZONA"
_BLOCK_MARK = "PRACA ZABLOKOWANA"
_WORK_BUDGET_DEFAULT = 3000      # kr; twardy limit wydatku maratonu (zmiana: --budget)
_WORK_HOURS_DEFAULT = 24.0       # h; twardy limit czasu (zmiana: --hours / --days)
_WORK_HOURS_MAX = 24.0 * 14
_STALL_LIMIT = 3                 # tyle odcinków bez postępu = utknął

MARATHON_PROMPT = """
TRYB MARATONU: możesz pracować wiele godzin, a nawet dni. Praca jest dzielona na odcinki; między nimi \
rozmowa jest streszczana, więc wszystko, co ważne, zapisuj na bieżąco w planie (plan_update z notatką: \
co zrobione, gdzie, co dalej). Duży cel rozbij na tyle zadań, ile trzeba (do 40); gdy wyjdą nowe, \
plan_write z pełną listą (zrobione zostaw jako done).
- Nikt nie odpowie na pytania: decyzje podejmuj sam, rozsądnie, i zapisuj je w notatce planu.
- Commituj postęp w git po każdym większym kroku (jeśli to repozytorium), żeby nic nie przepadło.
- Gdy WSZYSTKO jest zrobione i sprawdzone (testy, uruchomienie), napisz wiadomość zaczynającą się od \
„PRACA ZAKOŃCZONA” i krótkie podsumowanie.
- Gdy dalsza praca naprawdę wymaga człowieka (hasło, płatność, decyzja nieodwracalna), napisz \
„PRACA ZABLOKOWANA: powód” i co już zrobiłeś.
"""


def _hours_label(hours: float) -> str:
    if hours >= 48 and hours % 24 == 0:
        return f"{int(hours // 24)} dni"
    return f"{hours:g} h"


def _wpath(name: str) -> Path:
    return Path.cwd() / _WORK_DIR / name


def _wjson(name: str, default=None):
    try:
        return json.loads(_wpath(name).read_text(encoding="utf-8"))
    except (OSError, ValueError):
        return default


def _wsave(name: str, data) -> None:
    p = _wpath(name)
    try:
        p.parent.mkdir(parents=True, exist_ok=True)
        tmp = p.with_suffix(".tmp")
        tmp.write_text(json.dumps(data, ensure_ascii=False, indent=1), encoding="utf-8")
        os.replace(tmp, p)
    except OSError:
        pass  # nosec B110 — stan maratonu to wygoda, praca idzie dalej


def _journal(text: str) -> None:
    import time
    try:
        p = _wpath("dziennik.md")
        p.parent.mkdir(parents=True, exist_ok=True)
        with open(p, "a", encoding="utf-8") as f:
            f.write(f"\n## {time.strftime('%Y-%m-%d %H:%M')}\n{text.strip()}\n")
    except OSError:
        pass  # nosec B110


def _journal_tail(limit: int = 8000) -> str:
    try:
        text = _wpath("dziennik.md").read_text(encoding="utf-8")
    except OSError:
        return ""
    return text[-limit:]


def _notify(title: str, text: str) -> None:
    """Powiadomienie systemowe na koniec maratonu (macOS / Linux), bez błędów, gdy się nie da."""
    import shutil
    try:
        if sys.platform == "darwin" and shutil.which("osascript"):
            esc = lambda v: v.replace("\\", "\\\\").replace('"', '\\"')[:200]
            subprocess.run(["osascript", "-e", f'display notification "{esc(text)}" with title "{esc(title)}"'],
                           timeout=10, capture_output=True)
        elif shutil.which("notify-send"):
            subprocess.run(["notify-send", title, text[:200]], timeout=10, capture_output=True)
    except (OSError, subprocess.SubprocessError):
        pass  # nosec B110


def _summarize(creds: dict, messages: list, model: str | None, hint: str = "") -> tuple:
    """(streszczenie, kr) jednym krokiem modelu bez narzędzi; ("", 0) przy błędzie."""
    body = [m for m in messages if m.get("role") in ("user", "assistant") and str(m.get("content") or "").strip()]
    tools_used = []
    for m in messages:
        for tc in m.get("tool_calls") or []:
            fn = (tc.get("function") or {})
            tools_used.append(f"{fn.get('name')}({str(fn.get('arguments') or '')[:160]})")
    lines = [("UŻYTKOWNIK: " if m["role"] == "user" else "AGENT: ") + str(m.get("content"))[:6000] for m in body]
    if tools_used:
        lines.append("WYWOŁANE NARZĘDZIA (ostatnie):\n" + "\n".join(tools_used[-60:]))
    transcript = "\n\n".join(lines)[-150_000:]
    req = {"messages": [{"role": "system", "content": "Streszczasz pracę agenta programistycznego."},
                        {"role": "user", "content": _COMPACT_PROMPT + (f"\nSzczególnie zachowaj: {hint}" if hint else "")
                         + "\n\nROZMOWA:\n" + transcript}], "tools": []}
    if model and model not in ("lopus", "lopus-pro"):
        req["model"] = model
    try:
        resp = api_step(creds, req)
    except (ApiError, urllib.error.URLError, TimeoutError, OSError):
        return "", 0
    spent = int(resp.get("credits_spent") or 0)
    SESSION["spent"] += spent
    return str((resp.get("message") or {}).get("content") or "").strip(), spent


def _work_fingerprint() -> tuple:
    plan = _plan_load() or {}
    return (json.dumps(plan.get("tasks") or [], sort_keys=True, ensure_ascii=False), _EDIT_SEQ[0])


def _plan_open(plan) -> list:
    return [t for t in (plan or {}).get("tasks") or [] if t.get("status") not in ("done", "blocked")]


def _work_running():
    st = _wjson("stan.json")
    if st and st.get("status") == "running" and st.get("pid") != os.getpid() and _pid_alive(st.get("pid")):
        return st
    return None


def marathon(creds: dict, goal: str, model: str | None, auto_yes: bool, resume: bool = False,
             mode: str = "ask", budget: int | None = None, hours: float | None = None) -> int:
    """Długa, samodzielna praca: odcinki z planem, streszczenie między odcinkami, ponawianie po
    błędach sieci, twarde limity kredytów i czasu, kolejka celów. Stan w .doma/work/."""
    import signal
    import time
    running = _work_running()
    if running:
        print(red(_Lf('✗ W tym folderze już trwa praca (pid {0}).', running.get('pid')))
              + dim(_L(" codo work status · codo work stop")))
        return 1
    settings = load_settings()
    budget = int(budget or settings.get("work_budget") or _WORK_BUDGET_DEFAULT)
    hours = min(_WORK_HOURS_MAX, float(hours or settings.get("work_hours") or _WORK_HOURS_DEFAULT))
    prev = _wjson("stan.json", {}) if resume else {}
    if resume and not goal:
        goal = (prev or {}).get("goal") or ((_plan_load() or {}).get("goal")) or ""
    if not goal:
        queue = _wjson("kolejka.json", [])
        if queue:
            goal = queue.pop(0)
            _wsave("kolejka.json", queue)
    if not goal:
        print(red(_L('Podaj cel: codo work "zbuduj sklep z koszykiem i płatnościami"')))
        return 1
    try:
        _wpath("stop").unlink()
    except OSError:
        pass  # nosec B110
    state = {"goal": goal, "status": "running", "pid": os.getpid(),
             "started": (prev or {}).get("started") if resume and prev else time.strftime("%Y-%m-%d %H:%M:%S"),
             "segments": int((prev or {}).get("segments") or 0) if resume else 0,
             "spent": int((prev or {}).get("spent") or 0) if resume else 0,
             "steps": int((prev or {}).get("steps") or 0) if resume else 0,
             "budget": budget, "hours": hours, "effort": current_effort(), "model": model or "",
             "updated": time.strftime("%Y-%m-%d %H:%M:%S")}
    _wsave("stan.json", state)
    if not resume:
        _journal(f"START · cel: {goal}")
    t_end = time.monotonic() + hours * 3600
    spent0 = SESSION["spent"]

    def on_term(*_):
        raise KeyboardInterrupt
    old_term = None
    if threading.current_thread() is threading.main_thread():
        try:
            old_term = signal.signal(signal.SIGTERM, on_term)
        except (ValueError, OSError):
            old_term = None
    print(bold(_Lf('codo work {0} · maraton', VERSION)) + dim(f" · {_cwd_label(50)}"))
    print(dim(f"  Cel: {goal[:200]}"))
    print(dim(_Lf('  Limity: {0} kr · {1} · wysiłek {2}', budget, _hours_label(hours), _EFFORT_PL[current_effort()])
              + (_L(" · pełna autonomia (--yes)") if auto_yes else _L(" · komendy pytają o zgodę"))))
    plan = _plan_load()
    if resume and plan:
        seed = (f"Cel: {goal}\n\nWznawiasz pracę. Stan planu:\n{_plan_render(plan)}\n\n"
                f"Dziennik (końcówka):\n{_journal_tail()}\n\nKontynuuj od pierwszego nieukończonego zadania.")
    else:
        seed = (f"Cel: {goal}\n\nZacznij od plan_write (konkretny podział na zadania), "
                "a potem wykonuj je po kolei aż do końca.")
    system = system_message(WORK_SYSTEM_PROMPT + MARATHON_PROMPT)
    messages = [system, {"role": "user", "content": seed}]
    status, stall, backoff, result_text = "running", 0, 30, ""
    SESSION["marathon"] = True   # samodzielna praca: bez zgód „z cytatu” (cel pisał model w dzienniku)
    try:
        while True:
            if _wpath("stop").exists():
                status = "zatrzymana"
                break
            used = state["spent"] + (SESSION["spent"] - spent0)
            if used >= budget:
                status = "budżet"
                break
            if time.monotonic() >= t_end:
                status = "czas"
                break
            before = _work_fingerprint()
            steps_before = SESSION["steps"]
            state["segments"] += 1
            print(dim(_Lf('\n  ── odcinek {0} · {1}/{2} kr ──', state['segments'], used, budget)))
            # Budżet sprawdzany po każdym kroku, nie tylko między odcinkami (odcinek to do 400 kroków).
            SESSION["spend_cap"] = SESSION["spent"] + (budget - used)
            try:
                ok = agent_turn(creds, messages, model, auto_yes, tools=WORK_TOOLS,
                                max_steps=_EFFORT_STEPS.get(current_effort(), 100),
                                show_results=("plan_write", "plan_update", "plan_status", "check"), mode=mode)
            finally:
                SESSION.pop("spend_cap", None)
            state["spent"] += SESSION["spent"] - spent0
            spent0 = SESSION["spent"]
            state["steps"] += SESSION["steps"] - steps_before
            state["updated"] = time.strftime("%Y-%m-%d %H:%M:%S")
            _wsave("stan.json", state)
            err = SESSION.get("turn_error")
            if err in (401, 402, 403):
                status = {401: "wylogowane", 402: "brak kredytów", 403: "brak dostępu"}[err]
                break
            if err in (400, 413, 422) and not ok:
                # Żądanie, które się nie uda niezależnie od czekania (za duża historia, zepsute pary
                # wywołań): świeży kontekst ze streszczenia. Do 0.28.0 ponawiane z czekaniem przez 24 h.
                bad = state.get("bad_requests", 0) + 1
                state["bad_requests"] = bad
                _journal(f"Błąd {err}, świeży kontekst (próba {bad})")
                if bad >= 3:
                    status = "błąd"
                    break
                messages = [system_message(WORK_SYSTEM_PROMPT + MARATHON_PROMPT), {"role": "user", "content": (
                    f"Cel: {goal}\n\nKontekst wyczyszczony po błędzie serwera.\nPlan:\n"
                    f"{_plan_render(_plan_load()) or '(brak planu: zacznij od plan_write)'}\n\n"
                    f"Dziennik (końcówka):\n{_journal_tail()}\n\nPracuj dalej, mniejszymi krokami.")}]
                continue
            if err is not None and not ok:
                # sieć, 429, 5xx: czekamy i próbujemy dalej tym samym kontekstem
                print(yellow(_Lf('  Przerwa w łączności ({0}). Ponawiam za {1}.', err, _duration(backoff))))
                _journal(f"Błąd {err}, ponowienie za {backoff} s")
                deadline = time.monotonic() + backoff
                while time.monotonic() < deadline and not _wpath("stop").exists():
                    time.sleep(min(5, max(0.1, deadline - time.monotonic())))
                backoff = min(backoff * 2, 1800)
                state["segments"] -= 1
                continue
            backoff = 30
            state["bad_requests"] = 0
            last = next((str(m.get("content") or "") for m in reversed(messages)
                         if m.get("role") == "assistant" and str(m.get("content") or "").strip()), "")
            if _DONE_MARK in last.upper() and not _plan_open(_plan_load()):
                status, result_text = "zakończona", last
                break
            if _BLOCK_MARK in last.upper():
                status, result_text = "zablokowana", last
                break
            progress = _work_fingerprint() != before or SESSION["steps"] - steps_before > 2
            stall = 0 if progress else stall + 1
            if stall >= _STALL_LIMIT:
                status = "utknęła"
                break
            # następny odcinek: streszczenie do dziennika i świeży kontekst
            summary, _ = _summarize(creds, messages, model, "stan planu, zmienione pliki, co dalej")
            if summary:
                _journal(f"Odcinek {state['segments']}:\n{summary}")
            plan = _plan_load()
            nudge = ("Plan ma nieukończone zadania." if _plan_open(plan) else
                     "Plan wygląda na ukończony: sprawdź całość (testy, uruchomienie) i zakończ "
                     f"wiadomością „{_DONE_MARK}”, albo dopisz brakujące zadania.")
            if _DONE_MARK in last.upper():
                nudge = "Napisałeś PRACA ZAKOŃCZONA, ale plan ma nieukończone zadania: dokończ je albo oznacz blocked."
            messages = [system_message(WORK_SYSTEM_PROMPT + MARATHON_PROMPT), {"role": "user", "content": (
                f"Cel: {goal}\n\nTo kolejny odcinek długiej pracy (kontekst wyczyszczony).\n"
                f"Plan:\n{_plan_render(plan) if plan else '(brak planu: zacznij od plan_write)'}\n\n"
                f"Dziennik (końcówka):\n{_journal_tail()}\n\n{nudge} Nikt nie odpowie na pytania: "
                "decyduj sam i pracuj dalej.")}]
            if model in ("lopus", "lopus-pro") or maddlabs_with_domaai_tools(model):
                SESSION.pop("lopus_chat_id", None)
    except KeyboardInterrupt:
        status = "zatrzymana"
    finally:
        SESSION.pop("marathon", None)
        if old_term is not None:
            try:
                signal.signal(signal.SIGTERM, old_term)
            except (ValueError, OSError):
                pass  # nosec B110
        state["spent"] += SESSION["spent"] - spent0
        state["status"] = status if status != "running" else "zatrzymana"
        state["finished"] = time.strftime("%Y-%m-%d %H:%M:%S")
        state["updated"] = state["finished"]
        if result_text:
            state["result"] = result_text[:4000]
        _wsave("stan.json", state)
        _journal(f"KONIEC · {state['status']} · {state['spent']} kr · {state['steps']} kroków"
                 + (f"\n{result_text[:2000]}" if result_text else ""))
    plan = _plan_load()
    if plan:
        print(dim("\n" + _plan_render(plan)))
    color = green if state["status"] == "zakończona" else yellow
    print(color(_Lf('\n  Praca {0}', state['status'])) + dim(_Lf(' · {0} odcinków · {1} kroków · {2} kr', state['segments'], state['steps'], state['spent'])))
    hints = {"budżet": f"Limit {budget} kr wyczerpany. Dalej: codo work --resume --budget {budget * 2}",
             "czas": "Limit czasu minął. Dalej: codo work --resume --hours 24",
             "zatrzymana": "Wznów: codo work --resume",
             "utknęła": "Brak postępu przez kilka odcinków. Zobacz: codo work log, potem codo work --resume",
             "brak kredytów": "Doładuj kredyty i wznów: codo work --resume"}
    if state["status"] in hints:
        print(dim("  " + hints[state["status"]]))
    _notify("Codo", f"Praca {state['status']}: {goal[:80]}")
    if state["status"] == "zakończona":
        queue = _wjson("kolejka.json", [])
        if queue:
            nxt = queue.pop(0)
            _wsave("kolejka.json", queue)
            _wsave("stan.json", {**state, "status": "następny"})
            try:
                (Path.cwd() / _PLAN_FILE).unlink()
            except OSError:
                pass  # nosec B110
            print(bold(_L("\n  Następny cel z kolejki: ")) + nxt[:120])
            return marathon(creds, nxt, model, auto_yes, mode=mode, budget=budget, hours=hours)
    return 0 if state["status"] == "zakończona" else 1


def work_background(argv_rest: list) -> int:
    """codo work --bg …: proces odłączony od terminala (przeżywa zamknięcie okna),
    na macOS pod caffeinate (bez usypiania), wyjście w .doma/work/praca.log."""
    import shutil
    running = _work_running()
    if running:
        print(red(_Lf('✗ W tym folderze już trwa praca (pid {0}).', running.get('pid'))) + dim(_L(" codo work status")))
        return 1
    log_path = _wpath("praca.log")
    log_path.parent.mkdir(parents=True, exist_ok=True)
    script = str(Path(sys.argv[0]).resolve())
    cmd = [*_self_cmd(script), "work", *argv_rest, "--w-tle"]
    if sys.platform == "darwin" and shutil.which("caffeinate"):
        cmd = ["caffeinate", "-i", *cmd]
    env = {**os.environ, "CODO_NO_CLEAR": "1", "DOMA_PLAIN": "1", "PYTHONUNBUFFERED": "1", "NO_COLOR": "1"}
    kwargs = {"stdin": subprocess.DEVNULL, "env": env, "cwd": str(Path.cwd())}
    if IS_WIN:
        kwargs["creationflags"] = 0x00000008 | 0x00000200   # DETACHED_PROCESS | CREATE_NEW_PROCESS_GROUP
    else:
        kwargs["start_new_session"] = True
    with open(log_path, "ab") as log:
        kwargs["stdout"] = log
        kwargs["stderr"] = subprocess.STDOUT
        proc = subprocess.Popen(cmd, **kwargs)  # nosec B603 — własny program z argumentami użytkownika
    print(green(_L("✓ Praca ruszyła w tle")) + dim(_Lf(' (pid {0}); możesz zamknąć terminal.', proc.pid)))
    print(dim(_L("  codo work status · codo work log -f · codo work stop")))
    if "--yes" not in argv_rest and "-y" not in argv_rest:
        print(yellow(_L("  Bez --yes komendy wymagające zgody będą odrzucane (nikt ich nie potwierdzi).")))
    return 0


def work_status() -> int:
    st = _wjson("stan.json")
    if not st:
        print(dim(_L("  W tym folderze nie było jeszcze pracy codo work.")))
        return 1
    alive = st.get("status") == "running" and _pid_alive(st.get("pid"))
    status = st.get("status")
    if status == "running" and not alive:
        status = _L("przerwana (proces nie żyje): codo work --resume")
    lines = [f"Cel: {st.get('goal', '')[:200]}",
             f"Stan: {'pracuje (pid ' + str(st.get('pid')) + ')' if alive else status}",
             f"Start: {st.get('started')} · ostatnio: {st.get('updated')}",
             f"Odcinki: {st.get('segments')} · kroki: {st.get('steps')} · {st.get('spent')}/{st.get('budget')} kr"]
    plan = _plan_load()
    if plan:
        lines += [""] + _plan_render(plan).splitlines()[1:]
    queue = _wjson("kolejka.json", [])
    if queue:
        lines += ["", f"Kolejka ({len(queue)}):"] + [f"  {i}. {g[:100]}" for i, g in enumerate(queue, 1)]
    panel(_L("codo work"), lines)
    return 0


def work_stop() -> int:
    st = _wjson("stan.json") or {}
    try:
