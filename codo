def login_password() -> dict:
    """Password + OTP creates a revocable device; temporary web session is closed."""
    import getpass
    import socket
    print(bold(_L("Logowanie hasłem")) + dim(f" ({API_URL})"))
    form = {"email": input(_L("E-mail: ")).strip(), "password": getpass.getpass(_L("Hasło: "))}
    for attempt in range(4):
        try:
            data = _http("POST", "/login", form=form, retries=0)
            break
        except ApiError as exc:
            flags = exc.payload
            if exc.status != 403 or not (flags.get("requires_2fa") or flags.get("requires_email_otp")) or attempt == 3:
                raise
            key = "totp_code" if flags.get("requires_2fa") else "email_otp"
            print(dim(exc.human()))
            form[key] = getpass.getpass(_L("Kod z aplikacji / kod zapasowy: ") if key == "totp_code" else _L("Kod z e-maila: ")).strip()
    token = data["access_token"]
    try:
        dev = _http("POST", "/cli/pair/self", json_body={
            "hostname": socket.gethostname(), "device_name": socket.gethostname(),
        }, token=token, retries=0)
        save_device({"device_id": dev["device_id"], "device_secret": dev["device_secret"],
                     "name": dev.get("name") or socket.gethostname()})
    finally:
        try:
            _http("POST", "/logout", token=token, retries=0, timeout=15)
        except Exception:
            pass  # session cleanup is best effort; never persist a full web session
    print(green(_L("✓ Zalogowano i sparowano urządzenie.")) + dim(_L(" Zarządzaj nim w DomaAI Web → Codo.")))
    return {"device": True}


def _wait_for_pairing(start: dict) -> int:
    """Both browser and code login share deadlines and transient error handling."""
    import socket
    import time as clock
    deadline = clock.monotonic() + int(start.get("expires_in", 900))
    delay = 2
    while clock.monotonic() < deadline:
        clock.sleep(min(delay, max(0, deadline - clock.monotonic())))
        if clock.monotonic() >= deadline:
            break
        try:
            state = _http("POST", "/cli/pair/poll",
                          json_body={"device_token": start["device_token"]}, timeout=15, retries=0)
        except (urllib.error.URLError, TimeoutError, ConnectionError):
            delay = min(delay + 2, 15)
            continue
        except ApiError as exc:
            if exc.status == 429 or exc.status >= 500:
                delay = min(delay + 2, 15)
                continue
            raise
        delay = 2
        status = state.get("status")
        if status == "confirmed":
            save_device({"device_id": state["device_id"], "device_secret": state["device_secret"],
                         "name": state.get("name") or socket.gethostname()})
            print(green(_L("\n✓ Urządzenie sparowane!")) + f" {bold(state.get('name') or socket.gethostname())}")
            print(dim(_L("  Agent: codo · połączenie z czatem web: codo serve")))
            return 0
        if status == "claimed":
            print(red(_L("✗ Poświadczenia zostały już odebrane. Jeśli nie zapisano ich lokalnie, odparuj urządzenie w webie i uruchom codo login.")))
            return 1
        if status in ("expired", "unknown"):
            break
    print(red(_L("✗ Kod wygasł — uruchom ponownie: codo login")))
    return 1


