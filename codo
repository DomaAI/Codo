def _team_fmt_task(t: dict) -> str:
    return (f"{t['id']} [{t['status']}] {t['title']}" + (f" · dla {t['assignee']}" if t.get("assignee") else "")
            + (f" · wykonuje {t['claimed_by']}" if t.get("claimed_by") else "")
            + (f" · po {', '.join(t['depends_on'])}" if t.get("depends_on") else "")
            + (f"\n  {t['detail'][:600]}" if t.get("detail") else "")
            + (f"\n  Wynik: {t['result'][:600]}" if t.get("result") else ""))


def t_team(name: str, args: dict) -> str:
    d, me = os.environ.get("CODO_ZESPOL_DIR"), os.environ.get("CODO_ZESPOL_CZLONEK")
    if not d or not me:
        return "BŁĄD: narzędzia zespołu działają tylko w zespole agentów (codo team run)."
    st = TeamStore(d)
    lead = os.environ.get("CODO_ZESPOL_ROLA") == "lead"
    if name == "team_board":
        run = st.load_run()
        members = "\n".join(f"- {m['id']} ({m['name']}, {m.get('role')}): {m.get('status')}"
                            + (f", {m['task_id']}" if m.get("task_id") else "") for m in run.get("members") or [])
        tasks = "\n".join(_team_fmt_task(t) for t in st.board()["tasks"]) or "(pusto)"
        return (f"Cel: {run.get('goal')}\nStan: {run.get('status')}\nSkład:\n{members}\nZadania:\n{tasks}\n"
                f"Nieprzeczytane wiadomości: {len(st.inbox(me, mark=False))}")
    if name == "team_task_create":
        if not lead and not (st.load_run().get("policy") or {}).get("members_create_tasks", True):
            return "ODRZUCONE: w tym zespole zadania dodaje tylko prowadzący. Napisz do niego team_send."
        created, err = st.task_create(me, args.get("tasks"))
        return err or "Dodano: " + ", ".join(f"{t['id']} „{t['title']}”" for t in created)
    if name == "team_task_claim":
        t, err = st.task_claim(me, args.get("id") or None)
        return err or (_team_fmt_task(t) if t else "Brak gotowych zadań dla Ciebie.")
    if name == "team_task_update":
        t, err = st.task_update(me, args.get("id"), args.get("status"), args.get("result") or "", args.get("note") or "")
        return err or f"Zapisano: {t['id']} → {t['status']}."
    if name == "team_send":
        msg, err = st.send(me, args.get("to"), args.get("text"), args.get("task_id") or "")
        return err or f"Wysłano do {msg['to']}."
    if name == "team_inbox":
        msgs = st.inbox(me)
        return "\n".join(f"[{x['id']}] od {x['from']}: {x['text']}" for x in msgs) or "Brak nowych wiadomości."
    if name == "team_request_review":
        t, err = st.request_review(me, args.get("id"), args.get("reviewer") or "", args.get("note") or args.get("result") or "")
        return err or f"Zapisano: {t['id']} czeka na przegląd ({t['status']})."
    if name == "team_review":
        t, err = st.task_review("lead" if lead else me, args.get("id"), args.get("verdict"), args.get("notes") or "")
        return err or f"Zapisano werdykt {t['review']['verdict']} dla {t['id']} (stan: {t['status']})."
    if name in _TEAM_LEAD_TOOLS and not lead:
        return "ODRZUCONE: to narzędzie ma tylko prowadzący. Napisz do niego team_send."
    if name == "team_finish":
        st.control(type="finish", summary=str(args.get("summary") or "")[:8000], by=me)
        return "Zapisano podsumowanie. Nadzorca zamknie pracę zespołu po tej turze."
    if name == "team_task_edit":
        patch = args.get("patch") if isinstance(args.get("patch"), dict) else {k: v for k, v in args.items() if k != "id"}
        t, err = st.task_edit(me, args.get("id"), patch)
        return err or f"Zapisano: {t['id']} ({t['status']})."
    if name == "team_member_add":
        run = st.load_run()
        if len(run.get("members") or []) >= _TEAM_MAX_MEMBERS:
            return f"ODRZUCONE: zespół ma już {_TEAM_MAX_MEMBERS} członków (limit)."
        if not str(args.get("name") or "").strip():
            return "BŁĄD: podaj name i role nowego członka."
        m = _team_new_member(run, args)
        st.control(type="member_add", member={**{k: args.get(k) for k in ("name", "role", "brain", "writes", "instructions")
                                                 if k in args}, "id": m["id"]}, by=me)
        return (f"Dodaję członka {m['id']} ({m['name']}). Za chwilę będzie w składzie (team_board); "
                f"zadania dla niego: team_task_create z assignee=\"{m['id']}\".")
    if name == "team_ask_human":
        import secrets
        q = str(args.get("question") or "").strip()
        if not q:
            return "BŁĄD: podaj question."
        qid = "q-" + secrets.token_hex(2)
        opts = args.get("options") if isinstance(args.get("options"), list) else []
        st.control(type="question", id=qid, frm=me, text=q[:4000], options=[str(o) for o in opts][:8])
        return f"Pytanie {qid} wysłane do człowieka. Odpowiedź przyjdzie jako wiadomość w jednej z kolejnych tur."
    return f"BŁĄD: nieznane narzędzie {name}"


def t_team_run(args: dict, auto_yes: bool) -> str:
    """Narzędzie czatu: zespół w tle; wynik przychodzi do rozmowy po team_done (okno) albo przy kolejnej turze."""
    goal = str(args.get("goal") or "").strip()
    if not goal:
        return "BŁĄD: podaj goal (cel zespołu z pełnym kontekstem)."
    tpl, err = _team_template_get(str(args.get("template") or "para"))
    if err:
        return "BŁĄD: " + err
    if not auto_yes and not confirm_action(_Lf("Uruchomić zespół agentów „{0}”?", tpl.get("title") or tpl["name"]),
                                           goal[:400], reason=_L("członkowie zmieniają pliki we własnych kopiach "
                                                                 "projektu i zużywają kredyty")):
        return "ODRZUCONE przez użytkownika."
    over: dict = {"mode": "auto" if auto_yes else None}
    for k, typ in (("budget_kr", int), ("hours", float), ("parallel", int)):
        try:
            if args.get(k) not in (None, ""):
                over[k] = typ(args[k])
        except (TypeError, ValueError):
            pass
    run_dir, err = _team_create_run(Path.cwd(), goal, tpl, over, {"kind": "chat", "convo_id": SESSION.get("convo_id") or ""})
    if err:
        return "BŁĄD: " + err
    if _APP["out"] is not None:
        _TEAM_APP["chat"].add(run_dir.name)
        _team_tail_start(run_dir, 0)
    _team_spawn_supervisor(run_dir)
    if _APP["out"] is None:
        threading.Thread(target=_team_watch, args=(run_dir,), daemon=True).start()
    run = TeamStore(run_dir).load_run()
    who = ", ".join(f"{m['name']} ({m.get('brain_label') or ''})" for m in run.get("members") or [])
    return (f"Zespół {run_dir.name} ruszył ({run.get('title')}: {who}). Wynik przyjdzie sam, gdy zespół skończy; "
            f"nie czekaj na niego w tej turze. Podgląd: codo team status {run_dir.name}.")


def _team_watch(run_dir: Path) -> None:
    """Terminal: koniec zespołu z czatu trafia do kolejnej tury rozmowy jako kontekst."""
    import time
    store = TeamStore(run_dir)
    while True:
        time.sleep(2)
        run = store.load_run()
        if run.get("status") in _TEAM_RUN_END + ("paused",):
            break
    summary = str(run.get("summary") or "").strip()
    SESSION.setdefault("pending_context", []).append(
        _Lf("Zespół {0} skończył pracę ({1}).", run_dir.name, run.get("status")) + "\n" + summary[:6000])
    print("\n" + dim(_Lf("  Zespół {0} skończył pracę ({1}). Wynik dostanę w następnej wiadomości.", run_dir.name,
                          _L(_TEAM_STATUS_PL.get(run.get("status"), run.get("status") or "")))))


def _team_reserved(path: str) -> str:
    """Tryb shared (bez gita): plik z task.files zadania innego członka w toku jest zarezerwowany."""
    import fnmatch
    d, me = os.environ.get("CODO_ZESPOL_DIR"), os.environ.get("CODO_ZESPOL_CZLONEK")
    if not d or not me or not path:
        return ""
    st = TeamStore(d)
    run = st.load_run()
    members = {m["id"]: m for m in run.get("members") or [] if m.get("id")}
    if (members.get(me) or {}).get("isolation") != "shared":
        return ""
    root = Path(members[me].get("worktree") or run.get("project") or Path.cwd()).resolve()
    try:
        rel = (Path(path) if os.path.isabs(path) else Path.cwd() / path).resolve().relative_to(root).as_posix()
    except (ValueError, OSError):
        return ""
    for t in st.board()["tasks"]:
        who = t.get("claimed_by") or ""
        if t["status"] not in ("in_progress", "review") or who in ("", me):
            continue
        for pat in t.get("files") or []:
            pat = str(pat).strip()
            pat = (pat[2:] if pat.startswith("./") else pat).rstrip("/")
            if pat and (rel == pat or rel.startswith(pat + "/") or fnmatch.fnmatch(rel, pat)):
                return (f"ODRZUCONE: plik {rel} należy do zadania {t['id']} ({(members.get(who) or {}).get('name') or who}). "
                        f"Napisz do niego team_send.")
    return ""


