def _team_now() -> str:
    import time
    return time.strftime("%Y-%m-%dT%H:%M:%SZ", time.gmtime())


def _team_age(ts: str) -> float:
    """Sekundy od znacznika czasu z run.json (duża liczba, gdy brak)."""
    import calendar
    import time
    try:
        return time.time() - calendar.timegm(time.strptime(str(ts), "%Y-%m-%dT%H:%M:%SZ"))
    except (ValueError, TypeError):
        return 1e9


def _team_script() -> str:
    return os.environ.get("CODO_TEAM_SCRIPT") or os.path.abspath(__file__)


# ── git w jawnym folderze ──

def _git_in(path, *args, timeout: int = 60) -> tuple:
    """_git z jawnym folderem (kopie członków), bez wejścia ze stdin (app-server czyta tam polecenia)."""
    try:
        p = subprocess.run(["git", "-C", str(path), *args], capture_output=True, text=True, encoding="utf-8", errors="replace", timeout=timeout,
                           stdin=subprocess.DEVNULL, env={**os.environ, "GIT_TERMINAL_PROMPT": "0"})
        return p.returncode, (p.stdout or "").strip(), (p.stderr or "").strip()
    except (OSError, subprocess.SubprocessError) as exc:
        return 1, "", str(exc)


def _team_ident(path) -> list:
    """Tożsamość dla commitów nadzorcy tylko wtedy, gdy repozytorium jej nie ma."""
    if os.environ.get("GIT_AUTHOR_EMAIL") and os.environ.get("GIT_COMMITTER_EMAIL"):
        return []
    code, out, _ = _git_in(path, "config", "user.email")
    return [] if code == 0 and out else ["-c", "user.name=Codo", "-c", "user.email=codo@localhost"]


def _team_short_title(goal: str, limit: int = 72) -> str:
    """Tytuł PR z celu: pierwsze zdanie, ucięte na granicy słowa (23.11: «… z te»)."""
    g = " ".join(goal.split())
    first = re.split(r"(?<=[.!?])\s", g, maxsplit=1)[0].rstrip(".")
    if len(first) <= limit:
        return first
    cut = first[:limit].rsplit(" ", 1)[0].rstrip(",;:")
    return cut + "…"


def _team_commit_all(path, msg: str) -> str:
    """git add -A i commit (gdy są zmiany); zwraca sha HEAD."""
    _git_in(path, "add", "-A", timeout=120)
    if _git_in(path, "diff", "--cached", "--quiet")[0] == 1:
        _git_in(path, *_team_ident(path), "commit", "-q", "--no-verify", "-m", msg, timeout=120)
    return _git_in(path, "rev-parse", "HEAD")[1]


def _team_worktree_add(base, path, branch: str, start: str) -> str:
    """Kopia projektu na własnej gałęzi; pusty wynik to sukces, inaczej opis błędu."""
    if Path(path).exists():
        return ""   # wznowienie: kopia już jest
    Path(path).parent.mkdir(parents=True, exist_ok=True)
    code, _, err = _git_in(base, "worktree", "add", "-q", "-b", branch, str(path), start, timeout=300)
    if code and "already exists" in err:
        code, _, err = _git_in(base, "worktree", "add", "-q", str(path), branch, timeout=300)
    return "" if code == 0 else (err or "git worktree add")[-400:]


def _team_exclude(project) -> None:
    """.doma/ w info/exclude: automatyczny commit w kopii nie może wciągnąć kopii zapasowych Codo."""
    code, common, _ = _git_in(project, "rev-parse", "--git-common-dir")
    if code:
        return
    p = Path(common) if os.path.isabs(common) else Path(project) / common
    f = p / "info" / "exclude"
    try:
        text = f.read_text(encoding="utf-8") if f.exists() else ""
        if ".doma/" not in text.split():
            f.parent.mkdir(parents=True, exist_ok=True)
            f.write_text(text + ("" if not text or text.endswith("\n") else "\n") + ".doma/\n", encoding="utf-8")
    except OSError:
        pass  # nosec B110 — bez wpisu commit i tak pomija pliki, które są w .gitignore


def _team_copy_env(src, dst) -> None:
    """Pliki spoza gita potrzebne do uruchomienia (.env*, .npmrc, local.properties), jak kopie na Macu."""
    import shutil
    for p in Path(src).iterdir():
        if (p.name.startswith(".env") or p.name in (".npmrc", "local.properties")) and p.is_file():
            if not (Path(dst) / p.name).exists():
                try:
                    shutil.copy2(p, Path(dst) / p.name)
                except OSError:
                    pass  # nosec B110


def _team_diff_stat(repo, base: str, head: str) -> dict:
    out = {"files": 0, "added": 0, "removed": 0}
    code, text, _ = _git_in(repo, "diff", "--numstat", f"{base}..{head}")
    if code:
        return out
    for line in text.splitlines():
        parts = line.split("\t")
        if len(parts) >= 3:
            out["files"] += 1
            out["added"] += int(parts[0]) if parts[0].isdigit() else 0
            out["removed"] += int(parts[1]) if parts[1].isdigit() else 0
    return out


def _team_markers(path) -> bool:
    """Plik ma jeszcze znaczniki konfliktu git."""
    try:
        text = Path(path).read_text(encoding="utf-8", errors="replace")
    except OSError:
        return False
    return re.search(r"^(<{7}|>{7})( |$)", text, re.M) is not None


def _team_guess_check(project) -> str:
    p = Path(project)
    try:
        pkg = json.loads((p / "package.json").read_text(encoding="utf-8"))
        test = str((pkg.get("scripts") or {}).get("test") or "")
        if test and "no test specified" not in test:
            return "npm test"
    except (OSError, ValueError, AttributeError):
        pass
    if (p / "pytest.ini").exists() or (p / "pyproject.toml").exists() or (p / "tests").is_dir():
        return "python3 -m pytest -q"
    if (p / "Cargo.toml").exists():
        return "cargo test"
    if (p / "go.mod").exists():
        return "go test ./..."
    return ""


# ── blokada i pliki przebiegu ──

_TEAM_LOCKS: dict = {}
_TEAM_LOCKS_GUARD = threading.Lock()


def _team_flock(f, on: bool) -> None:
    if IS_WIN:
        import msvcrt
        import time
        f.seek(0)
        if not on:
            try:
                msvcrt.locking(f.fileno(), msvcrt.LK_UNLCK, 1)
            except OSError:
                pass  # nosec B110
            return
        while True:
            try:
                msvcrt.locking(f.fileno(), msvcrt.LK_LOCK, 1)
                return
            except OSError:
                time.sleep(0.05)
    import fcntl
    fcntl.flock(f.fileno(), fcntl.LOCK_EX if on else fcntl.LOCK_UN)


@contextlib.contextmanager
def _team_lock(run_dir):
    """Blokada plików przebiegu między procesami (flock, na Windows msvcrt), wielokrotna w wątku."""
    key = os.path.abspath(str(run_dir))
    with _TEAM_LOCKS_GUARD:
        ent = _TEAM_LOCKS.setdefault(key, {"lock": threading.RLock(), "depth": 0, "f": None})
    with ent["lock"]:
        if ent["depth"] == 0:
            ent["f"] = open(os.path.join(key, "lock"), "a+b")
            _team_flock(ent["f"], True)
        ent["depth"] += 1
        try:
            yield
        finally:
            ent["depth"] -= 1
            if ent["depth"] == 0:
                _team_flock(ent["f"], False)
                ent["f"].close()
                ent["f"] = None


def _team_cycle(graph: dict) -> bool:
    state: dict = {}

    def visit(n) -> bool:
        if state.get(n) == 1:
            return True
        if state.get(n) == 2:
            return False
        state[n] = 1
        if any(visit(d) for d in graph.get(n, [])):
            return True
        state[n] = 2
        return False
    return any(visit(n) for n in list(graph))


def _team_ready(task: dict, by_id: dict, soft: bool = False) -> bool:
    """Zależności gotowe; przy merge=at_end (soft) wystarczy praca czekająca w kolejce scaleń."""
    def ok(d):
        t = by_id.get(d) or {}
        return t.get("status") == "done" or (soft and t.get("status") == "merge_queue"
                                              and (t.get("merge") or {}).get("state") == "queued")
    return all(ok(d) for d in task.get("depends_on") or [])


def _team_fits(task: dict, member: dict) -> bool:
    if member.get("role") == "lead":
        return False
    if task.get("assignee") and task["assignee"] != member.get("id"):
        return False
    return member.get("writes", True) or (task.get("kind") or "build") in ("research", "review")


def _team_pick(board: dict, member: dict, soft: bool = False) -> dict | None:
    by_id = {t["id"]: t for t in board["tasks"]}
    ready = [t for t in board["tasks"] if t["status"] == "open" and _team_ready(t, by_id, soft) and _team_fits(t, member)]
    mine = [t for t in ready if t.get("assignee") == member.get("id")]
    return (mine or [t for t in ready if not t.get("assignee")] or [None])[0]


class TeamStore:
    """Pliki jednego przebiegu zespołu. Każdy zapis pod blokadą: piszą nadzorca, członkowie i okna."""

    def __init__(self, run_dir):
        self.dir = Path(run_dir)

    def lock(self):
        return _team_lock(self.dir)

    def _read(self, name: str, default):
        try:
            data = json.loads((self.dir / name).read_text(encoding="utf-8"))
            return data if isinstance(data, type(default)) else default
        except (OSError, ValueError):
            return default

    def _write(self, name: str, data) -> None:
        p = self.dir / name
        tmp = p.with_name(f"{p.name}.{os.getpid()}.{threading.get_ident()}.tmp")
        tmp.write_text(json.dumps(data, ensure_ascii=False, indent=1), encoding="utf-8")
        os.replace(tmp, p)

    def _append(self, name: str, obj: dict) -> None:
        with open(self.dir / name, "a", encoding="utf-8") as f:
            f.write(json.dumps(obj, ensure_ascii=False, default=str) + "\n")

    def _lines(self, name: str) -> list:
        out = []
        try:
            with open(self.dir / name, encoding="utf-8") as f:
                for raw in f:
                    try:
                        obj = json.loads(raw)
                    except ValueError:
                        continue
                    if isinstance(obj, dict):
                        out.append(obj)
        except OSError:
            pass
        return out

    def load_run(self) -> dict:
        return self._read("run.json", {})

    def save_run(self, run: dict) -> None:
        with self.lock():
            run["updated"] = _team_now()
            run["seq"] = self.seq()
            self._write("run.json", run)

    def board(self) -> dict:
        b = self._read("board.json", {})
        return b if isinstance(b.get("tasks"), list) else {"tasks": [], "next_id": 1}

    def members(self) -> dict:
        return {m["id"]: m for m in self.load_run().get("members") or [] if isinstance(m, dict) and m.get("id")}

    def seq(self) -> int:
        try:
            return int((self.dir / "seq").read_text().strip() or 0)
        except (OSError, ValueError):
            return 0

    def append_event(self, kind: str, **data) -> dict:
        with self.lock():
            n = self.seq() + 1
            (self.dir / "seq").write_text(str(n))
            ev = {"type": kind, "run_id": self.dir.name, "seq": n, "ts": _team_now(), **data}
            self._append("events.jsonl", ev)
        return ev

    def events(self, since: int = 0) -> list:
        return [e for e in self._lines("events.jsonl") if int(e.get("seq") or 0) > since]

    def live(self, member: str, event: dict) -> None:
        """team_member_event: na żywo dla okien, bez seq i bez trwałego zapisu (plik bywa obcinany)."""
        try:
            self._append("live.jsonl", {"type": "team_member_event", "run_id": self.dir.name, "member": member,
                                        "event": event})
        except OSError:
            pass  # nosec B110

    def patch_task(self, tid: str, **fields) -> dict | None:
        with self.lock():
            board = self.board()
            t = next((x for x in board["tasks"] if x["id"] == tid), None)
            if t is None:
                return None
            t.update(fields, updated=_team_now())
            self._write("board.json", board)
            self.append_event("team_task", task=t)
        return t

    def policy(self) -> dict:
        return {**_TEAM_POLICY, **(self.load_run().get("policy") or {})}

    @staticmethod
    def _norm(it: dict, i: int, members: dict, known: set, new_ids: list, base: dict | None = None) -> tuple:
        """Pola zadania z elementu paczki albo z poprawki istniejącego (base); (pola, błąd)."""
        workers = [k for k in members if k != "lead"]
        out: dict = {}
        if base is None or "title" in it:
            title = str(it.get("title") or "").strip()
            if not title:
                return None, f"BŁĄD: zadanie {i + 1} nie ma tytułu (title)."
            out["title"] = title[:200]
        if base is None or "detail" in it:
            out["detail"] = str(it.get("detail") or "").strip()[:8000]
        if base is None or "assignee" in it:
            who = str(it.get("assignee") or "").strip()
            if who and who not in workers:
                return None, f"BŁĄD: nie ma członka „{who}”. Członkowie: {', '.join(workers) or 'brak'}."
            out["assignee"] = who
        if base is None or "depends_on" in it:
            me = base["id"] if base else new_ids[i]
            raw, deps = it.get("depends_on") or [], []
            for d in ([raw] if isinstance(raw, str) else raw if isinstance(raw, list) else []):
                d = str(d).strip()
                if d.startswith("#") and d[1:].isdigit() and 1 <= int(d[1:]) <= len(new_ids):
                    d = new_ids[int(d[1:]) - 1]
                if d == me:
                    return None, f"BŁĄD: zadanie {base['id'] if base else i + 1} nie może zależeć od siebie."
                if d not in known and d not in new_ids:
                    return None, f"BŁĄD: zadanie {base['id'] if base else i + 1} zależy od nieistniejącego {d}."
                if d not in deps:
                    deps.append(d)
            out["depends_on"] = deps
        if base is None or "kind" in it or "assignee" in out:
            kind = str(it.get("kind") or (base or {}).get("kind") or "build").lower()
            kind = kind if kind in ("build", "research", "test", "review") else "build"
            who = out.get("assignee", (base or {}).get("assignee"))
            if who and not members[who].get("writes", True) and kind not in ("research", "review"):
                kind = "research"
            out["kind"] = kind
        if base is None or "files" in it:
            files = it.get("files") if isinstance(it.get("files"), list) else []
            out["files"] = [str(x)[:300] for x in files][:40]
        if base is None or "needs_review" in it:
            out["needs_review"] = bool(it.get("needs_review"))
        return out, ""

    @staticmethod
    def _new_task(tid: str, by: str, f: dict) -> dict:
        now = _team_now()
        return {"id": tid, "title": f["title"], "detail": f["detail"], "kind": f["kind"], "assignee": f["assignee"],
                "created_by": by, "depends_on": f["depends_on"], "files": f["files"], "status": "open",
                "claimed_by": "", "needs_review": f["needs_review"], "reviewer": "",
                "review": {"verdict": "", "notes": "", "by": "", "round": 0}, "result": "", "commit": "",
                "merge": {"state": "", "sha": "", "conflicts": [], "check_output": ""},
                "attempts": 0, "created": now, "updated": now}

    def task_create(self, by: str, items) -> tuple:
        if isinstance(items, dict):
            items = [items]
        if not isinstance(items, list) or not items:
            return [], "BŁĄD: podaj tasks=[{title, detail, assignee?, depends_on?, files?, kind?}]."
        members = self.members()
        with self.lock():
            board = self.board()
            tasks = board["tasks"]
            if len(tasks) + len(items) > _TEAM_MAX_TASKS:
                return [], f"BŁĄD: limit {_TEAM_MAX_TASKS} zadań w zespole (na tablicy jest {len(tasks)})."
            known = {t["id"] for t in tasks}
            nid = int(board.get("next_id") or len(tasks) + 1)
            new_ids = [f"T{nid + i}" for i in range(len(items))]
            created = []
            for i, it in enumerate(items):
                f, err = self._norm(it if isinstance(it, dict) else {}, i, members, known, new_ids)
                if err:
                    return [], err
                created.append(self._new_task(new_ids[i], by, f))
            graph = {t["id"]: list(t.get("depends_on") or []) for t in tasks + created}
            if _team_cycle(graph):
                return [], "BŁĄD: zależności tworzą cykl. Popraw depends_on."
            tasks.extend(created)
            board["next_id"] = nid + len(created)
            self._write("board.json", board)
            for t in created:
                self.append_event("team_task", task=t)
        return created, ""

    def task_edit(self, by: str, tid, patch) -> tuple:
        """Poprawka zadania (prowadzący, człowiek): pola, anulowanie albo ponowne otwarcie."""
        if not isinstance(patch, dict) or not patch:
            return None, "BŁĄD: podaj patch={title?, detail?, assignee?, depends_on?, files?, kind?, status?}."
        members = self.members()
        with self.lock():
            board = self.board()
            by_id = {t["id"]: t for t in board["tasks"]}
            t = by_id.get(str(tid or ""))
            if t is None:
                return None, f"BŁĄD: nie ma zadania {tid}."
            st = str(patch.get("status") or "")
            if st not in ("", "cancelled", "open"):
                return None, "BŁĄD: status w patch to cancelled albo open."
            if {"assignee", "depends_on", "kind"} & set(patch) and t["status"] not in ("open", "blocked") and st != "open":
                return None, f"BŁĄD: przypisanie, zależności i rodzaj zmienisz tylko w zadaniu open albo blocked ({tid}: {t['status']})."
            f, err = self._norm({k: v for k, v in patch.items() if k != "status"}, 0, members, set(by_id), [], base=t)
            if err:
                return None, err
            if "depends_on" in f:
                graph = {x["id"]: list(x.get("depends_on") or []) for x in board["tasks"]}
                graph[t["id"]] = f["depends_on"]
                if _team_cycle(graph):
                    return None, "BŁĄD: zależności tworzą cykl. Popraw depends_on."
            if st == "cancelled":
                if t["status"] in ("done", "merging"):
                    return None, f"BŁĄD: zadania {tid} w stanie {t['status']} nie da się anulować."
                f["status"] = "cancelled"
            elif st == "open":
                if t["status"] not in ("blocked", "failed", "cancelled"):
                    return None, f"BŁĄD: ponownie otworzyć można zadanie blocked, failed albo cancelled ({tid}: {t['status']})."
                f.update(status="open", claimed_by="", commit="", reviewer="",
                         merge={"state": "", "sha": "", "conflicts": [], "check_output": ""},
                         review={"verdict": "", "notes": "", "by": "", "round": 0})
            t.update(f, updated=_team_now(), edited_by=by)
            self._write("board.json", board)
            self.append_event("team_task", task=t)
        return t, ""

    def plan_apply(self, by: str, items, dry: bool = False) -> str:
        """Edytowana lista zadań z team_plan_decide: znane id nadpisują pola, brakujące otwarte zadania znikają
        (cancelled), elementy bez id są nowe. Błąd nie zmienia niczego."""
        if not isinstance(items, list):
            return "BŁĄD: tasks to lista zadań."
        members = self.members()
        with self.lock():
            board = self.board()
            tasks = board["tasks"]
            by_id = {t["id"]: t for t in tasks}
            items = [x for x in items if isinstance(x, dict)]
            old = [x for x in items if str(x.get("id") or "") in by_id]
            fresh = [x for x in items if str(x.get("id") or "") not in by_id]
            if len(tasks) + len(fresh) > _TEAM_MAX_TASKS:
                return f"BŁĄD: limit {_TEAM_MAX_TASKS} zadań w zespole."
            nid = int(board.get("next_id") or len(tasks) + 1)
            new_ids = [f"T{nid + i}" for i in range(len(fresh))]
            keep = {str(x["id"]) for x in old}
            gone = {t["id"] for t in tasks if t["status"] == "open" and t["id"] not in keep}
            changes, created = {}, []
            fields = ("title", "detail", "assignee", "depends_on", "files", "kind", "needs_review")
            for x in old:
                f, err = self._norm({k: v for k, v in x.items() if k in fields}, 0, members, set(by_id), new_ids,
                                    base=by_id[str(x["id"])])
                if err:
                    return err
                changes[str(x["id"])] = f
            for i, x in enumerate(fresh):
                f, err = self._norm(x, i, members, set(by_id), new_ids)
                if err:
                    return err
                created.append(self._new_task(new_ids[i], by, f))
            graph = {t["id"]: list(changes.get(t["id"], {}).get("depends_on", t.get("depends_on") or []))
                     for t in tasks if t["id"] not in gone}
            graph.update({t["id"]: t["depends_on"] for t in created})
            if any(d in gone for deps in graph.values() for d in deps):
                return "BŁĄD: zadanie zależy od zadania usuniętego z planu."
            if _team_cycle(graph):
                return "BŁĄD: zależności tworzą cykl. Popraw depends_on."
            if dry:
                return ""
            now = _team_now()
            touched = []
            for t in tasks:
                if t["id"] in changes and any(t.get(k) != v for k, v in changes[t["id"]].items()):
                    t.update(changes[t["id"]], updated=now, edited_by=by)
                    touched.append(t)
                elif t["id"] in gone:
                    t.update(status="cancelled", updated=now, edited_by=by)
                    touched.append(t)
            tasks.extend(created)
            board["next_id"] = nid + len(created)
            self._write("board.json", board)
            for t in touched + created:
                self.append_event("team_task", task=t)
        return ""

    def task_claim(self, member_id: str, tid: str | None = None) -> tuple:
        member = self.members().get(member_id)
        if not member:
            return None, f"BŁĄD: nieznany członek {member_id}."
        with self.lock():
            board = self.board()
            by_id = {t["id"]: t for t in board["tasks"]}
            if tid:
                t = by_id.get(str(tid))
                if t is None:
                    return None, f"BŁĄD: nie ma zadania {tid}."
                if t["status"] == "in_progress" and t.get("claimed_by") == member_id:
                    return t, ""
                if t["status"] != "open":
                    return None, f"BŁĄD: zadanie {tid} ma stan {t['status']}, nie da się go wziąć."
                if not _team_fits(t, member):
                    return None, f"BŁĄD: zadanie {tid} nie jest dla Ciebie (przypisane: {t.get('assignee') or 'rodzaj ' + t.get('kind', '')})."
                if not _team_ready(t, by_id, self.policy().get("merge") == "at_end"):
                    wait = [d for d in t.get("depends_on") or [] if (by_id.get(d) or {}).get("status") != "done"]
                    return None, f"BŁĄD: {tid} czeka na {', '.join(wait)}."
            else:
                t = _team_pick(board, member, self.policy().get("merge") == "at_end")
                if t is None:
                    return None, ""
            t.update(status="in_progress", claimed_by=member_id, attempts=int(t.get("attempts") or 0) + 1,
                     updated=_team_now())
            self._write("board.json", board)
            self.append_event("team_task", task=t)
        return t, ""

    def task_update(self, member_id: str, tid, status, result="", note="") -> tuple:
        status = str(status or "").strip()
        if status not in ("done", "blocked", "failed", "in_progress"):
            return None, "BŁĄD: status to done, blocked, failed albo in_progress."
        members = self.members()
        me = members.get(member_id) or {}
        with self.lock():
            board = self.board()
            t = next((x for x in board["tasks"] if x["id"] == str(tid or "")), None)
            if t is None:
                return None, f"BŁĄD: nie ma zadania {tid}."
            if t.get("claimed_by") != member_id and me.get("role") != "lead":
                return None, f"BŁĄD: zadanie {tid} nie jest Twoje (wykonuje je {t.get('claimed_by') or 'nikt'})."
            if t["status"] not in ("in_progress", "blocked", "open"):
                return None, f"BŁĄD: zadanie {tid} ma już stan {t['status']}."
            result = str(result or "").strip()
            if status == "done" and len(result) < 10:
                return None, "BŁĄD: status done wymaga wyniku (co najmniej 10 znaków): co zrobiłeś i które pliki."
            owner = members.get(t.get("claimed_by")) or me
            pol = self.policy()
            if status == "done" and owner.get("isolation") == "copy" and owner.get("branch"):
                t["status"] = "merge_queue"   # gotowe dopiero po scaleniu do gałęzi integracyjnej
                t["merge"] = {**(t.get("merge") or {}), "state": "queued", "sha": "", "conflicts": [], "check_output": ""}
            elif status == "done" and owner.get("writes", True) and owner.get("role") != "lead" \
                    and (t.get("needs_review") or pol.get("review") in ("lead", "cross")) \
                    and t.get("kind") not in ("research", "review") and (t.get("review") or {}).get("verdict") != "approve":
                t["status"] = "review"        # wspólny folder: przegląd bez kopii, recenzenta wybiera nadzorca
            else:
                t["status"] = status
            if result:
                t["result"] = result[:6000]
            if note:
                t["note"] = str(note)[:2000]
            t["updated"] = _team_now()
            self._write("board.json", board)
            self.append_event("team_task", task=t)
        return t, ""

    def request_review(self, member_id: str, tid, reviewer="", note="") -> tuple:
        """Wykonawca kończy zadanie i prosi o przegląd (opcjonalnie wskazanego członka)."""
        reviewer, note = str(reviewer or "").strip(), str(note or "").strip()
        members = self.members()
        if reviewer and (reviewer == member_id or (reviewer != "lead" and reviewer not in members)):
            return None, f"BŁĄD: recenzentem może być lead albo inny członek ({', '.join(k for k in members if k != member_id)})."
        with self.lock():
            board = self.board()
            t = next((x for x in board["tasks"] if x["id"] == str(tid or "")), None)
            if t is None or t.get("claimed_by") != member_id or t["status"] != "in_progress":
                return None, f"BŁĄD: {tid} nie jest Twoim zadaniem w toku."
            result = note if len(note) >= 10 else str(t.get("result") or note)
            t["needs_review"] = True
            if reviewer:
                t["reviewer"] = reviewer
            self._write("board.json", board)
            return self.task_update(member_id, tid, "done", result)

    def task_review(self, by: str, tid, verdict, notes="") -> tuple:
        """Werdykt przeglądu: approve idzie do scalenia (albo do człowieka przy approve_merge=each), changes wraca
        do wykonawcy; trzecie changes blokuje zadanie i budzi prowadzącego."""
        verdict, notes = str(verdict or "").strip().lower(), str(notes or "").strip()
        if verdict not in ("approve", "changes"):
            return None, "BŁĄD: verdict to approve albo changes."
        if verdict == "changes" and len(notes) < 10:
            return None, "BŁĄD: przy changes podaj uwagi (co najmniej 10 znaków): plik, miejsce, co poprawić."
        run = self.load_run()
        pol = {**_TEAM_POLICY, **(run.get("policy") or {})}
        boss = by in ("lead", "nadzorca", "human")
        with self.lock():
            board = self.board()
            t = next((x for x in board["tasks"] if x["id"] == str(tid or "")), None)
            if t is None:
                return None, f"BŁĄD: nie ma zadania {tid}."
            rv = t.get("review") or {}
            if t["status"] == "blocked" and boss and int(rv.get("round") or 0) >= 3:
                pass   # po trzech rundach rozstrzyga prowadzący
            elif t["status"] != "review":
                return None, f"BŁĄD: zadanie {tid} nie czeka na przegląd (stan: {t['status']})."
            elif not boss and t.get("reviewer") != by:
                return None, f"BŁĄD: przegląd {tid} należy do {t.get('reviewer') or 'nadzorcy'}."
            if by == t.get("claimed_by"):
                return None, "BŁĄD: nie przeglądasz własnej pracy."
            rnd = int(rv.get("round") or 0) + 1
            t["review"] = {"verdict": verdict, "notes": notes[:4000], "by": by, "round": rnd}
            merge, state = dict(t.get("merge") or {}), ""
            if verdict == "approve":
                if t.get("commit") and run.get("git"):
                    t["status"] = "merge_queue"
                    state = merge["state"] = ("waiting_human" if pol.get("approve_merge") == "each"
                                              and not merge.get("approved") else "queued")
                else:
                    t["status"] = "done"
            elif rnd >= 3:
                t["status"] = "blocked"
                t["note"] = "Trzy rundy przeglądu bez akceptacji. Ostatnie uwagi: " + notes[:1500]
            else:
                t["status"], t["commit"], merge["state"] = "in_progress", "", ""
            t["merge"] = merge
            t["updated"] = _team_now()
            self._write("board.json", board)
            self.append_event("team_task", task=t)
            if state:
                self.append_event("team_merge", task_id=t["id"], member=t.get("claimed_by") or "", state=state,
                                  files=merge.get("files") or [], conflicts=[])
        return t, ""

    def messages(self) -> list:
        return self._lines("messages.jsonl")

    def send(self, frm: str, to, text, task_id="") -> tuple:
        to = str(to or "lead").strip() or "lead"
        text = str(text or "").strip()
        if not text:
            return None, "BŁĄD: pusta wiadomość."
        members = self.members()
        if to == "lead" and "lead" not in members:
            to = "human"   # zespół bez prowadzącego: pytania idą do człowieka
        if to not in ("lead", "all", "human") and to not in members:
            return None, f"BŁĄD: nie ma adresata „{to}”. Do wyboru: lead, all, human, {', '.join(members)}."
        with self.lock():
            n = self.seq() + 1
            msg = {"seq": n, "id": f"m{n}", "from": frm, "to": to, "text": text[:8000],
                   "task_id": str(task_id or ""), "ts": _team_now()}
            self._append("messages.jsonl", msg)
            self.append_event("team_message", message=msg)
        return msg, ""

    def inbox(self, member: str, mark: bool = True) -> list:
        with self.lock():
            msgs = self.messages()
            cur = self._read("inbox.json", {})
            last = int(cur.get(member) or 0)
            out = [m for m in msgs if int(m.get("seq") or 0) > last and m.get("from") != member
                   and m.get("to") in (member, "all")]
            if mark and msgs:
                cur[member] = max(int(m.get("seq") or 0) for m in msgs)
                self._write("inbox.json", cur)
        return out

    def control(self, **cmd) -> None:
        with self.lock():
            self._append("control.jsonl", {**cmd, "ts": _team_now()})

    def read_control(self, offset: int) -> tuple:
        try:
            with open(self.dir / "control.jsonl", "rb") as f:
                f.seek(offset)
                data = f.read()
        except OSError:
            return [], offset
        end = data.rfind(b"\n") + 1
        out = []
        for raw in data[:end].splitlines():
            try:
                obj = json.loads(raw.decode("utf-8", "replace"))
            except ValueError:
                continue
            if isinstance(obj, dict):
                out.append(obj)
        return out, offset + end

    def state(self) -> dict:
        run, board = self.load_run(), self.board()
        pol = run.get("policy") or {}
        return {"run_id": run.get("id") or self.dir.name, "seq": self.seq(), "status": run.get("status") or "",
                "goal": run.get("goal") or "", "name": run.get("name") or "", "title": run.get("title") or "",
                "created": run.get("created") or "", "elapsed_s": run.get("elapsed_s") or 0,
                "spent_kr": run.get("spent_kr") or 0,
                "limits": {"budget_kr": pol.get("budget_kr") or 0, "hours": pol.get("hours") or 0,
                           "parallel": pol.get("parallel") or 0},
                "git": bool(run.get("git")), "base_branch": run.get("base_branch") or "",
                "integration_branch": run.get("integration_branch") or "", "members": run.get("members") or [],
                "tasks": board["tasks"], "messages_tail": self.messages()[-50:],
                "pending_asks": run.get("pending_asks") or [], "summary": run.get("summary") or "",
                "pending_questions": run.get("pending_questions") or [], "plan_round": int(run.get("plan_round") or 0),
                "source": run.get("source") or {}}


_TEAM_BLOCK_RE = re.compile(r"```zespol[^\n]*\n(.*?)```", re.S)


def _team_parse_block(text: str) -> dict | None:
    """Tryb text: ostatni blok ```zespol z JSON-em; błędny JSON to brak bloku."""
    blocks = _TEAM_BLOCK_RE.findall(text or "")
    if not blocks:
        return None
    try:
        data = json.loads(blocks[-1].strip())
    except ValueError:
        return None
    return data if isinstance(data, dict) else None


