# Codex i Claude Code dostają Gmail, Kalendarz i Dysk Google jako narzędzia MCP.
# Karta zgody: serwer MCP to proces agenta, więc pyta okno Codo przez gniazdo
# app-servera (CODO_ZGODY_SOCK); bez okna (terminal) pyta systemowe okienko macOS.

def _zgoda_przez_okno(pytanie: str, tytul: str = "") -> bool:
    sock_path = os.environ.get("CODO_ZGODY_SOCK") or ""
    if sock_path and os.path.exists(sock_path):
        import socket
        try:
            with socket.socket(socket.AF_UNIX, socket.SOCK_STREAM) as s:
                s.settimeout(600)
                s.connect(sock_path)
                s.sendall((json.dumps({"token": os.environ.get("CODO_ZGODY_TOKEN", ""), "pytanie": pytanie,
                                       "tytul": tytul}) + "\n").encode())
                odp = b""
                while not odp.endswith(b"\n"):
                    kawalek = s.recv(4096)
                    if not kawalek:
                        break
                    odp += kawalek
            return bool(json.loads(odp.decode() or "{}").get("zgoda"))
        except (OSError, ValueError):
            return False
    if sys.platform == "darwin":
        import subprocess
        tekst = pytanie.replace("\\", "\\\\").replace('"', '\\"')[:900]
        r = subprocess.run(["osascript", "-e", f'display dialog "{tekst}" with title "Codo" buttons {{"Nie", "Tak"}} '
                            'default button "Nie" cancel button "Nie" with icon caution'],
                           capture_output=True, text=True, timeout=600)
        return r.returncode == 0 and "Tak" in r.stdout
    return False


def _most_przez_gniazdo(action: str, args: dict | None = None, timeout: float = 60) -> dict:
    """Prośba serwera MCP do okna Codo, przez gniazdo app-servera (ten sam token co zgody)."""
    sock_path = os.environ.get("CODO_ZGODY_SOCK") or ""
    if not sock_path or not os.path.exists(sock_path):
        return {"error": _L("To narzędzie działa tylko w aplikacji Codo na Maca.")}
    import socket
    try:
        with socket.socket(socket.AF_UNIX, socket.SOCK_STREAM) as s:
            s.settimeout(timeout + 20)
            s.connect(sock_path)
            s.sendall((json.dumps({"token": os.environ.get("CODO_ZGODY_TOKEN", ""), "most": action,
                                   "args": args or {}, "timeout": timeout}, ensure_ascii=False) + "\n").encode())
            odp = b""
            while not odp.endswith(b"\n"):
                kawalek = s.recv(65536)
                if not kawalek:
                    break
                odp += kawalek
        wynik = json.loads(odp.decode() or "{}").get("wynik")
        return wynik if isinstance(wynik, dict) else {"error": _L("Okno Codo nie odpowiedziało.")}
    except (OSError, ValueError):
        return {"error": _L("Okno Codo nie odpowiedziało.")}


def _mcp_agent_okna() -> bool:
    """Serwer MCP stałego agenta z okna Codo (ma gniazdo do okna): dostaje narzędzie agenci."""
    return bool(os.environ.get("CODO_APP_AGENT") and os.environ.get("CODO_ZGODY_SOCK"))


