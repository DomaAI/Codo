# ── Maszyna DomaAI (18.11.2026): projekt z tego komputera na komputer w chmurze ──
# Projekt idzie na maszynę rozmowy Lopusa (ta sama co tryb Maszyna w aplikacji DomaAI),
# agent pracuje tam (tura z maszyna=true), a zmiany wracają do folderu przez „pobierz”
# z kopią każdego nadpisanego pliku w .doma/backups (cofanie jak po zwykłej edycji).
_MASZYNA_MAX_PLIK = 20 << 20      # pojedynczy plik
_MASZYNA_MAX_RAZEM = 250 << 20    # przed spakowaniem
_MASZYNA_MAX_GZ = 60 << 20        # limit serwera


def _maszyna_req(method: str, path: str, data: bytes | None = None, ctype: str = "",
                 timeout: int = 300) -> bytes:
    """Żądanie z tokenem urządzenia, treść i odpowiedź jako bajty (archiwa projektu)."""
    token = device_access_token()
    if not token:
        raise ApiError(401, _L("Komputer w chmurze wymaga konta DomaAI. Zaloguj się w Codo kontem DomaAI."))
    for attempt in range(2):
        headers = {"User-Agent": f"doma-cli/{VERSION}", "Authorization": f"Bearer {token}"}
        if ctype:
            headers["Content-Type"] = ctype
        req = urllib.request.Request(API_URL + path, data=data, headers=headers, method=method)
        try:
            with urllib.request.urlopen(req, timeout=timeout, context=_ssl_ctx()) as resp:
                return resp.read()
        except urllib.error.HTTPError as e:
            if e.code == 401 and attempt == 0:
                token = device_access_token(force=True)
                continue
            body = e.read().decode(errors="replace")
            try:
                detail = json.loads(body).get("detail", body)
            except (ValueError, AttributeError):
                detail = body
            raise ApiError(e.code, detail) from None
    raise ApiError(401, _L("Sesja urządzenia wygasła. Zaloguj się ponownie."))


def maszyna_spakuj(root: Path | None = None) -> tuple:
    """Projekt → tar.gz w pamięci: bez .git, zależności i budowania, bez sekretów (.env)."""
    import io
    import tarfile
    root = (root or Path.cwd()).resolve()
    buf = io.BytesIO()
    n, total, skipped = 0, 0, []
    with tarfile.open(fileobj=buf, mode="w:gz", compresslevel=6) as tar:
        for directory, dirs, files in os.walk(root, followlinks=False):
            dirs[:] = sorted(d for d in dirs if d not in _SKIP_DIRS and d not in (".idea", ".next", ".cache", ".pytest_cache"))
            for name in sorted(files):
                if name in (".env", ".DS_Store") or (name.startswith(".env.") and name != ".env.example"):
                    continue
                full = Path(directory) / name
                if full.is_symlink() or not full.is_file():
                    continue
                size = full.stat().st_size
                rel = str(full.relative_to(root)).replace("\\", "/")
                if size > _MASZYNA_MAX_PLIK or total + size > _MASZYNA_MAX_RAZEM:
                    skipped.append(rel)
                    continue
                info = tar.gettarinfo(str(full), arcname=rel)
                info.uid = info.gid = 0
                info.uname = info.gname = ""
                with open(full, "rb") as fh:
                    tar.addfile(info, fh)
                n += 1
                total += size
    return buf.getvalue(), n, total, skipped


def maszyna_wyslij(faza=None) -> dict:
    faza = faza or (lambda _f: None)
    faza("pakuje")
    data, n, total, skipped = maszyna_spakuj()
    if not n:
        raise ApiError(400, _L("Ten folder jest pusty: nie ma czego przenieść."))
    if len(data) > _MASZYNA_MAX_GZ:
        raise ApiError(413, _L("Projekt jest za duży do przeniesienia (ponad 60 MB po spakowaniu)."))
    from urllib.parse import quote
    import socket
    faza("wysyla")
    # Nazwa folderu i komputera: projekt widać pod tą nazwą w aplikacjach DomaAI (web, iOS, Android).
    q = (f"chat_id={quote(_chat_id())}&nazwa={quote(Path.cwd().name[:120])}"
         f"&host={quote(socket.gethostname()[:120])}&pliki={n}")
    try:
        out = json.loads(_maszyna_req("POST", f"/cli/maszyna/wyslij?{q}", data,
                                      "application/gzip").decode() or "{}")
    except ApiError as e:
        # Rozmowę tego projektu usunięto w DomaAI: zaczynamy nową (nowy chat_id) i wysyłamy jeszcze raz,
        # żeby projekt znów był widać w aplikacjach.
        if not (e.status == 409 and isinstance(e.detail, dict) and e.detail.get("kod") == "ROZMOWA_USUNIETA"):
            raise
        import uuid
        SESSION["lopus_chat_id"] = str(uuid.uuid4())
        q = (f"chat_id={quote(_chat_id())}&nazwa={quote(Path.cwd().name[:120])}"
             f"&host={quote(socket.gethostname()[:120])}&pliki={n}")
        out = json.loads(_maszyna_req("POST", f"/cli/maszyna/wyslij?{q}", data,
                                      "application/gzip").decode() or "{}")
    faza("gotowe")
    SESSION["maszyna"] = True
    SESSION["maszyna_od"] = __import__("time").time()
    return {"files": n, "bytes": total, "packed": len(data), "skipped": skipped[:20],
            "boot_s": out.get("boot_s")}


