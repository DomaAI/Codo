# Dysk Google na Macu
_DYSK_TEKST = {".txt", ".md", ".csv", ".json", ".tsv", ".html", ".htm", ".xml", ".yml", ".yaml", ".log", ".rtf"}
_DYSK_SKROTY = {".gdoc": "Dokument Google", ".gsheet": "Arkusz Google", ".gslides": "Prezentacja Google",
                ".gform": "Formularz Google", ".gdraw": "Rysunek Google", ".gmap": "Mapa Google"}


def dysk_foldery() -> list:
    """Konta Dysku Google zamontowane przez aplikację Dysk Google: [(konto, folder Mój dysk)]."""
    out = []
    base = Path.home() / "Library" / "CloudStorage"
    try:
        for d in sorted(base.glob("GoogleDrive-*")):
            konto = d.name.removeprefix("GoogleDrive-")
            moj = next((d / n for n in ("My Drive", "Mój dysk", "Meine Ablage", "Mi unidad", "Mon Drive", "Il mio Drive")
                        if (d / n).is_dir()), None)
            if moj is None:
                moj = next((c for c in d.iterdir() if c.is_dir() and not c.name.startswith(".")), d)
            out.append((konto, moj))
    except OSError:
        pass
    return out


def _dysk_opis() -> dict:
    f = dysk_foldery()
    if not f:
        return {"jest": False}
    return {"jest": True, "konto": f[0][0], "folder": str(f[0][1]), "konta": [k for k, _ in f]}


def _dysk_sciezka(root: Path, rel: str) -> Path:
    root = root.resolve()
    p = (root / str(rel or "").lstrip("/")).resolve()
    if p != root and root not in p.parents:
        raise ValueError(_L("ścieżka poza Dyskiem Google"))
    return p


def _dysk_skrot(p: Path) -> str:
    rodzaj = _DYSK_SKROTY.get(p.suffix.lower(), "Plik Google")
    url = ""
    try:
        d = json.loads(p.read_text(encoding="utf-8", errors="replace")[:20000])
        url = d.get("url") or (f"https://docs.google.com/open?id={d['doc_id']}" if d.get("doc_id") else "")
    except Exception:  # noqa: BLE001 — skrót w chmurze bez treści
        pass
    return json.dumps({"plik": p.name, "rodzaj": rodzaj, "url": url,
                       "uwaga": "To skrót do pliku w chmurze Google; treści nie ma na Macu. Podaj userowi link."},
                      ensure_ascii=False)


def _dysk_tekst(p: Path) -> str:
    suf = p.suffix.lower()
    if suf in _DYSK_SKROTY:
        return _dysk_skrot(p)
    if suf in _DYSK_TEKST or p.stat().st_size < 400_000 and suf == "":
        return p.read_text(encoding="utf-8", errors="replace")[:200_000]
    if suf in (".pdf", ".docx", ".doc", ".rtf", ".odt", ".pages", ".xlsx", ".pptx"):
        if suf == ".pdf" and __import__('shutil').which("pdftotext"):
            r = subprocess.run(["pdftotext", "-layout", str(p), "-"], capture_output=True, text=True, timeout=60)
            return r.stdout[:200_000] or _L("PDF bez warstwy tekstowej (skan).")
        if suf == ".pdf":
            r = subprocess.run(["mdls", "-raw", "-name", "kMDItemTextContent", str(p)], capture_output=True, text=True, timeout=30)
            t = r.stdout.strip()
            return t[:200_000] if t and t != "(null)" else _L("Nie umiem tu wyciągnąć tekstu z PDF; poproś usera o otwarcie albo skopiuj plik do projektu.")
        if suf in (".docx", ".doc", ".rtf", ".odt"):
            r = subprocess.run(["textutil", "-convert", "txt", "-stdout", str(p)], capture_output=True, text=True, timeout=60)
            return r.stdout[:200_000]
        if suf in (".xlsx", ".pptx"):
            import zipfile
            with zipfile.ZipFile(p) as z:
                czesci = [n for n in z.namelist() if n.startswith(("xl/sharedStrings", "ppt/slides/slide")) and n.endswith(".xml")]
                tekst = " ".join(re.sub(r"<[^>]+>", " ", z.read(n).decode("utf-8", "replace")) for n in sorted(czesci)[:200])
            return re.sub(r"\s+", " ", tekst)[:200_000]
    return _L("Tego rodzaju pliku nie odczytam jako tekst. Skopiuj go do projektu, jeśli trzeba go przetworzyć.")


def t_dysk(args: dict, ask=None) -> str:
    foldery = dysk_foldery()
    if not foldery:
        return _L("Dysk Google nie jest zainstalowany na tym Macu. Powiedz userowi: zainstaluj aplikację Dysk Google "
                  "(google.com/drive/download) i zaloguj się; Codo zobaczy folder sam.")
    root = foldery[0][1].resolve()
    akcja = str(args.get("akcja") or "")
    try:
        if akcja == "szukaj":
            fraza = str(args.get("fraza") or "").casefold().strip()
            if not fraza:
                return _L("BŁĄD: podaj frazę.")
            wyniki, odwiedzone = [], 0
            for dirpath, dirnames, filenames in os.walk(root):
                dirnames[:] = [d for d in dirnames if not d.startswith(".")]
                odwiedzone += 1
                for n in dirnames + filenames:
                    if fraza in n.casefold():
                        wyniki.append(str((Path(dirpath) / n).relative_to(root)) + ("/" if n in dirnames else ""))
                if len(wyniki) >= 60 or odwiedzone > 4000:
                    break
            return json.dumps({"konto": foldery[0][0], "wyniki": wyniki[:60],
                               "uwaga": "" if odwiedzone <= 4000 else "Przeszukałem 4000 folderów; zawęź frazę."}, ensure_ascii=False)
        if akcja == "lista":
            p = _dysk_sciezka(root, str(args.get("folder") or ""))
            pozycje = sorted(p.iterdir(), key=lambda c: (not c.is_dir(), c.name.casefold()))
            return json.dumps({"folder": str(p.relative_to(root)) if p != root else "",
                               "pozycje": [c.name + ("/" if c.is_dir() else "") for c in pozycje if not c.name.startswith(".")][:300]},
                              ensure_ascii=False)
        if akcja == "czytaj":
            p = _dysk_sciezka(root, str(args.get("plik") or ""))
            if not p.is_file():
                return _L("BŁĄD: nie ma takiego pliku na Dysku.")
            return _dysk_tekst(p)
        if akcja == "zapisz":
            zrodlo = (Path.cwd() / str(args.get("z_projektu") or "")).resolve()
            if Path.cwd().resolve() not in zrodlo.parents or not zrodlo.is_file():
                return _L("BŁĄD: z_projektu musi wskazywać plik w folderze projektu.")
            cel_dir = _dysk_sciezka(root, str(args.get("folder") or ""))
            cel = cel_dir / zrodlo.name
            pytanie = _Lf("Skopiować {0} na Dysk Google ({1})?", zrodlo.name, str(cel.relative_to(root)))
            if not (ask or (lambda q: confirm_action(_L("Dysk Google"), q)))(pytanie):
                return _L("User nie zgodził się na zapis na Dysku.")
            cel_dir.mkdir(parents=True, exist_ok=True)
            __import__('shutil').copy2(zrodlo, cel)
            return json.dumps({"ok": True, "zapisano": str(cel.relative_to(root))}, ensure_ascii=False)
    except (OSError, ValueError) as e:
        return f"BŁĄD: {e}"
    return _L("BŁĄD: akcja to szukaj, lista, czytaj albo zapisz.")


