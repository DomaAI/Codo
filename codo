_EDIT_TEXT_MAX = 20_000_000   # większych plików nie edytujemy podmianą (pamięć, czas): narzędzia powłoki


def _not_editable(path: Path) -> str:
    """Pliki, których narzędzia tekstowe nie mogą edytować bez szkody: binarne, dokumenty biurowe (zip), ogromne."""
    try:
        size = path.stat().st_size
    except OSError:
        return ""
    if size > _EDIT_TEXT_MAX:
        return (f"BŁĄD: {path.name} ma {_human_size(size)}; edycja tekstowa tak dużego pliku jest zablokowana. "
                "Użyj run_command (sed, PowerShell) albo podziel plik.")
    kind = _binary_kind(path)
    if kind:
        return (f"BŁĄD: {path.name} to plik binarny ({kind}); edycja tekstowa by go zepsuła. "
                + ("Treść przeczytasz przez read_file, a zmienisz w miejscu narzędziem office_edit "
                   "(np. action=replace z find/replace; formatowanie zostaje)." if kind in _OFFICE_ACTIONS else
                   "Treść przeczytasz przez read_file; zmiany zrób skryptem (pypdf przez run_code) "
                   "albo zapisz nową wersję obok." if kind == "PDF" else
                   "Zmień go programem do tego typu plików albo skryptem."))
    return ""


_EDIT_PREFIX_RE = re.compile(r"^ *\d+\t")


def _strip_line_numbers(s: str) -> str | None:
    """old_string skopiowany z wyniku read_file razem z numerami linii („12<TAB>kod”): bez numerów."""
    lines = s.split("\n")
    body = [x for x in lines if x.strip()]
    if not body or not all(_EDIT_PREFIX_RE.match(x) for x in body):
        return None
    return "\n".join(_EDIT_PREFIX_RE.sub("", x, count=1) for x in lines)


_UNI_FOLD = str.maketrans({"‘": "'", "’": "'", "‚": "'", "‛": "'", "“": '"', "”": '"',
                           "„": '"', "«": '"', "»": '"', "–": "-", "—": "-", "−": "-",
                           " ": " ", " ": " ", " ": " ", "​": "", "﻿": ""})


def _ws_fold(s: str) -> str:
    return re.sub(r"[ \t]+", " ", s.translate(_UNI_FOLD).replace("…", "...")).strip()


def _spans(text: str, old: str) -> list:
    out, i = [], text.find(old)
    while i >= 0:
        out.append(i)
        i = text.find(old, i + len(old))
    return out


def _line_of(text: str, pos: int) -> int:
    return text.count("\n", 0, pos) + 1


def _reindent(new: str, old_ind: str, file_ind: str) -> str:
    """Treść new_string z wcięciem przesuniętym tak, jak różni się old_string od pliku (np. model zgubił
    4 spacje bloku): linie zaczynające się wcięciem old dostają wcięcie pliku."""
    if old_ind == file_ind:
        return new
    out = []
    for line in new.split("\n"):
        if not line.strip():
            out.append(line)
        elif line.startswith(old_ind):
            out.append(file_ind + line[len(old_ind):])
        elif not old_ind:
            out.append(file_ind + line)
        else:
            out.append(line)
    return "\n".join(out)


def _locate_edit(text: str, old: str, new: str, replace_all: bool = False) -> tuple:
    """Podmiana old→new jak u najlepszych agentów: najpierw dokładnie, potem z tolerancją. Zwraca
    (ok, nowy_tekst_albo_błąd, liczba_podmian, notka). Tolerancja (tylko gdy dopasowanie jest JEDNO):
    numery linii z read_file w old_string, \\r\\n w plikach mieszanych, spacje na końcu linii, inne wcięcie
    (new_string dostaje wcięcie pliku), typograficzne cudzysłowy/myślniki/twarde spacje i podwójne spacje."""
    n_old = old.replace("\r\n", "\n")
    cands = [(n_old, new.replace("\r\n", "\n"), "")]
    stripped = _strip_line_numbers(n_old)
    if stripped is not None:
        cands.append((stripped, _strip_line_numbers(new.replace("\r\n", "\n")) or new.replace("\r\n", "\n"),
                      " (usunięto numery linii z old_string)"))
    if "\r\n" in text:
        cands.append((n_old.replace("\n", "\r\n"), new.replace("\r\n", "\n").replace("\n", "\r\n"), ""))
    for o, nw, note in cands:
        pos = _spans(text, o)
        if len(pos) == 1 or (pos and replace_all):
            out = text.replace(o, nw) if replace_all else text[:pos[0]] + nw + text[pos[0] + len(o):]
            return True, out, len(pos), note
        if len(pos) > 1:
            lines = [_line_of(text, p) for p in pos]
            shown = ", ".join(map(str, lines[:12])) + (" …" if len(lines) > 12 else "")
            return False, (f"BŁĄD: old_string występuje {len(pos)}× (linie {shown}). Dodaj do old_string kilka "
                           "sąsiednich linii, żeby był unikalny, albo replace_all=true, jeśli zmiana ma objąć "
                           "wszystkie. Nic nie zapisano."), 0, ""
    # ── dopasowanie z tolerancją, po liniach ──
    o_src = stripped if stripped is not None else n_old
    nw_src = (_strip_line_numbers(new.replace("\r\n", "\n")) if stripped is not None else None) or new.replace("\r\n", "\n")
    t_lines = text.split("\n")
    trail = o_src.endswith("\n")
    o_lines = (o_src[:-1] if trail else o_src).split("\n")
    while o_lines and not o_lines[0].strip() and len(o_lines) > 1:
        o_lines = o_lines[1:]
    n = len(o_lines)
    levels = (("spacje na końcu linii", lambda x: x.rstrip(" \t\r")),
              ("inne wcięcie", lambda x: x.strip(" \t\r")),
              ("inne białe znaki albo typograficzne cudzysłowy/myślniki", _ws_fold))
    if n > 1 or o_src.strip() == o_src.strip(" \t"):
        for label, key in levels:
            want = [key(x) for x in o_lines]
            if not any(want):
                continue
            keyed = [key(x) for x in t_lines]
            hits = [i for i in range(len(t_lines) - n + 1) if keyed[i:i + n] == want]
            if n == 1 and not hits:
                # jedna linia: także fragment w środku linii (np. „a  =  1” w „x = a = 1”)
                rx = re.compile(r"[ \t]*".join(re.escape(tok) for tok in re.split(r"[ \t]+", _ws_fold(o_src))))
                folded = [ln.translate(_UNI_FOLD) for ln in t_lines]
                inl = [(i, m) for i, ln in enumerate(folded) for m in [rx.search(ln)] if m]
                if len(inl) == 1 and label != "spacje na końcu linii":
                    i, m = inl[0]
                    line = t_lines[i]
                    if len(folded[i]) == len(line):
                        t_lines[i] = line[:m.start()] + nw_src.rstrip("\n") + line[m.end():]
                        return True, "\n".join(t_lines), 1, f" (dopasowano z tolerancją: {label}, linia {i + 1})"
                continue
            if len(hits) > 1:
                shown = ", ".join(str(h + 1) for h in hits[:12])
                return False, (f"BŁĄD: old_string nie pasuje dokładnie, a z tolerancją ({label}) pasuje w {len(hits)} "
                               f"miejscach (linie {shown}). Skopiuj fragment dokładnie z read_file i dodaj sąsiednie "
                               "linie. Nic nie zapisano."), 0, ""
            if len(hits) == 1:
                i = hits[0]
                rep = nw_src[:-1] if trail and nw_src.endswith("\n") else nw_src
                if label != "spacje na końcu linii":
                    first = next((k for k, x in enumerate(o_lines) if x.strip()), 0)
                    o_ind = re.match(r"[ \t]*", o_lines[first]).group(0)
                    f_ind = re.match(r"[ \t]*", t_lines[i + first]).group(0)
                    rep = _reindent(rep, o_ind, f_ind)
                if "\r\n" in text and t_lines[i + n - 1].endswith("\r") and not rep.endswith("\r"):
                    rep = rep.replace("\n", "\r\n") + "\r"   # plik mieszany: linie z \r\n zostają z \r\n
                t_lines[i:i + n] = rep.split("\n") if rep or not trail else []
                out = "\n".join(t_lines)
                return True, out, 1, (f" (dopasowano z tolerancją: {label}, linie {i + 1}-{i + n}"
                                      + ("; wcięcie new_string dopasowane do pliku" if label != "spacje na końcu linii" else "")
                                      + ")")
    return False, "BŁĄD: old_string nie znaleziony w pliku. Nic nie zapisano." + _near_miss(text, o_src), 0, ""


def _near_miss(text: str, old: str) -> str:
    """Podpowiedź, gdy old_string nie pasuje: najbardziej podobny fragment pliku z numerami linii
    (model kopiuje go dokładnie zamiast zgadywać) i pierwsza linia, która się różni."""
    import difflib
    o_lines = [x for x in old.replace("\r\n", "\n").strip("\n").split("\n")]
    if not "".join(o_lines).strip():
        return ""
    t_lines = text.replace("\r\n", "\n").split("\n")
    n = len(o_lines)
    if len(t_lines) > 200_000:
        return " Przeczytaj plik jeszcze raz (read_file) i skopiuj fragment dokładnie."
    keyed = [_ws_fold(x) for x in t_lines]
    anchors = set()
    for k, ol in enumerate(o_lines):
        f = _ws_fold(ol)
        if len(f) < 3:
            continue
        for i, line in enumerate(keyed):
            if line and (line == f or (len(f) > 12 and (f in line or line in f))):
                anchors.add(max(0, i - k))
        if len(anchors) > 400:
            break
    if not anchors:
        firsts = difflib.get_close_matches(_ws_fold(o_lines[0]), keyed, n=5, cutoff=0.6)
        anchors = {i for i, line in enumerate(keyed) if line in firsts}
    if not anchors:
        return " Podobnego fragmentu nie ma: plik mógł się zmienić. Przeczytaj go jeszcze raz (read_file albo grep)."
    want = "\n".join(_ws_fold(x) for x in o_lines)
    best = max(((difflib.SequenceMatcher(None, "\n".join(keyed[a:a + n]), want, autojunk=False).ratio(), a)
                for a in sorted(anchors)[:400]), default=(0, 0))
    ratio, a = best
    if ratio < 0.5:
        return " Przeczytaj plik jeszcze raz (mógł się zmienić) i skopiuj fragment dokładnie."
    window = t_lines[a:a + min(n, 15)]
    diff_at = next((k for k in range(min(n, len(window))) if _ws_fold(window[k]) != _ws_fold(o_lines[k])), None)
    shown = "\n".join(f"{a + 1 + k}\t{x[:300]}" for k, x in enumerate(window))
    msg = f" Najbardziej podobny fragment ({int(ratio * 100)}% zgodności) to linie {a + 1}-{a + len(window)}:\n{shown}"
    if diff_at is not None:
        msg += (f"\nPierwsza różnica w linii {a + 1 + diff_at}: w pliku {window[diff_at].strip()[:160]!r}, "
                f"w old_string {o_lines[diff_at].strip()[:160]!r}.")
    return msg + "\nSkopiuj fragment dokładnie z pliku (bez numerów linii)."


def _human_size(n: int) -> str:
    for unit in ("B", "kB", "MB", "GB"):
        if n < 1024 or unit == "GB":
            return f"{n:.0f}{unit}" if unit == "B" else f"{n:.1f}{unit}"
        n /= 1024
    return f"{n}B"


_MAGIC = ((b"%PDF", "PDF"), (b"\x89PNG\r\n\x1a\n", "PNG"), (b"\xff\xd8\xff", "JPEG"), (b"GIF87a", "GIF"),
          (b"GIF89a", "GIF"), (b"\x1f\x8b", "gzip"), (b"SQLite format 3\x00", "SQLite"), (b"\x7fELF", "program ELF"),
          (b"MZ", "program Windows"), (b"\xcf\xfa\xed\xfe", "program Mach-O"), (b"\xca\xfe\xba\xbe", "program/klasa Java"),
          (b"BZh", "bzip2"), (b"\xfd7zXZ\x00", "xz"), (b"7z\xbc\xaf\x27\x1c", "7z"), (b"Rar!", "RAR"),
          (b"OggS", "Ogg"), (b"fLaC", "FLAC"), (b"ID3", "MP3"), (b"\x00\x00\x01\x00", "ICO"), (b"BM", "BMP"),
          (b"wOFF", "font WOFF"), (b"wOF2", "font WOFF2"), (b"\xd0\xcf\x11\xe0", "dokument Office 97-2003"))
_ZIP_KINDS = {".docx": "DOCX", ".docm": "DOCX", ".dotx": "DOCX", ".xlsx": "XLSX", ".xlsm": "XLSX", ".pptx": "PPTX",
              ".odt": "ODT", ".ods": "ODS", ".odp": "ODP", ".epub": "EPUB", ".jar": "JAR", ".apk": "APK"}


def _binary_kind(path: Path) -> str:
    """Rodzaj pliku binarnego po pierwszych bajtach ("" = tekst). UTF-16/UTF-32 (z BOM albo bez) to tekst,
    choć ma bajty zerowe: do 0.30 read_file brał takie pliki za binarne."""
    try:
        with _long_path(path).open("rb") as f:
            chunk = f.read(8192)
    except OSError:
        return ""
    if not chunk:
        return ""
    if any(chunk.startswith(b) for b, _e in _BOMS):
        return ""
    if chunk.startswith(b"PK\x03\x04") or chunk.startswith(b"PK\x05\x06"):
        kind = _ZIP_KINDS.get(path.suffix.lower())
        if not kind and b"word/" in chunk:
            kind = "DOCX"
        elif not kind and b"xl/" in chunk:
            kind = "XLSX"
        elif not kind and b"ppt/" in chunk:
            kind = "PPTX"
        return kind or "ZIP"
    if chunk[:4] == b"RIFF" and chunk[8:12] == b"WEBP":
        return "WEBP"
    if chunk[4:8] == b"ftyp":
        return "HEIC" if chunk[8:12] in (b"heic", b"heix", b"mif1") else "MP4/MOV"
    for magic, kind in _MAGIC:
        if chunk.startswith(magic) and (kind not in ("BMP", "ICO", "program Windows") or b"\x00" in chunk):
            return kind
    if b"\x00" in chunk:
        return "" if _sniff_utf16(chunk) else "binarny"
    return ""


def _is_binary(path: Path) -> bool:
    return bool(_binary_kind(path))


_IMAGE_MIME = {"PNG": "image/png", "JPEG": "image/jpeg", "GIF": "image/gif", "WEBP": "image/webp"}
_DOC_KINDS = ("PDF", "DOCX", "XLSX", "PPTX", "ODT", "ODS", "ODP")
_VISION_MAX_BYTES = 3_750_000          # obraz do modelu (limit dostawców ~5 MB po base64)
_VISION_QUEUE: list = []               # obrazy z read_file czekające na dołączenie do następnego kroku
_VISION_LOCK = __import__("threading").Lock()


def _image_size(data: bytes) -> tuple | None:
    """(szerokość, wysokość) z nagłówka PNG/GIF/JPEG/WEBP, bez bibliotek."""
    import struct
    try:
        if data.startswith(b"\x89PNG"):
            return struct.unpack(">II", data[16:24])
        if data[:3] == b"GIF":
            return struct.unpack("<HH", data[6:10])
        if data[:4] == b"RIFF" and data[8:12] == b"WEBP":
            if data[12:16] == b"VP8X":
                return (int.from_bytes(data[24:27], "little") + 1, int.from_bytes(data[27:30], "little") + 1)
            if data[12:16] == b"VP8L":
                b = int.from_bytes(data[21:25], "little")
                return ((b & 0x3FFF) + 1, ((b >> 14) & 0x3FFF) + 1)
            if data[12:16] == b"VP8 ":
                w, h = struct.unpack("<HH", data[26:30])
                return (w & 0x3FFF, h & 0x3FFF)
        if data[:2] == b"\xff\xd8":
            i = 2
            while i + 9 < len(data):
                if data[i] != 0xFF:
                    i += 1
                    continue
                marker = data[i + 1]
                if marker in (0xC0, 0xC1, 0xC2, 0xC3, 0xC5, 0xC6, 0xC7, 0xC9, 0xCA, 0xCB, 0xCD, 0xCE, 0xCF):
                    h, w = struct.unpack(">HH", data[i + 5:i + 9])
                    return (w, h)
                if marker in (0xD8, 0x01) or 0xD0 <= marker <= 0xD7:
                    i += 2
                    continue
                i += 2 + struct.unpack(">H", data[i + 2:i + 4])[0]
    except (struct.error, IndexError, ValueError):
        return None
    return None


def _shrink_image(path: Path, data: bytes, limit: int) -> tuple:
    """Obraz za duży dla modelu: zmniejszony przez Pillow (gdy jest) albo sips na macOS. (bajty, mime) albo (None, "")."""
    import io
    try:
        from PIL import Image  # type: ignore
        im = Image.open(io.BytesIO(data))
        im = im.convert("RGB") if im.mode not in ("RGB", "L") else im
        for side in (2048, 1568, 1024, 768, 512):
            cp = im.copy()
            cp.thumbnail((side, side))
            buf = io.BytesIO()
            cp.save(buf, "JPEG", quality=82)
            if buf.tell() <= limit:
                return buf.getvalue(), "image/jpeg"
    except Exception:  # noqa: BLE001 — brak Pillow albo obraz, którego nie zna
        pass  # nosec B110
    if sys.platform == "darwin" and __import__("shutil").which("sips"):
        import tempfile
        with tempfile.TemporaryDirectory() as d:
            for side in (1568, 1024, 640):
                out = Path(d) / "x.jpg"
                try:
                    subprocess.run(["sips", "-Z", str(side), "-s", "format", "jpeg", str(path), "--out", str(out)],
                                   capture_output=True, timeout=30, stdin=subprocess.DEVNULL)  # nosec B603 B607
                    if out.is_file() and out.stat().st_size <= limit:
                        return out.read_bytes(), "image/jpeg"
                except (OSError, subprocess.SubprocessError):
                    break
    return None, ""


def _read_image(p: str, path: Path, kind: str) -> str:
    """Obraz: opis (typ, wymiary, rozmiar) w wyniku, a sam obraz idzie do modelu w następnym kroku
    jako część wiadomości (model bez obsługi obrazów dostaje tylko opis)."""
    import base64
    try:
        data = _long_path(path).read_bytes()
    except OSError as e:
        return f"BŁĄD odczytu {p}: {e}"
    dims = _image_size(data)
    info = f"Obraz {kind} {p}: " + (f"{dims[0]}×{dims[1]} px, " if dims else "") + _human_size(len(data))
    mime = _IMAGE_MIME.get(kind)
    if not mime:
        return info + f". Tego formatu ({kind}) model nie obejrzy; przekonwertuj go na PNG/JPEG (run_command)."
    if len(data) > _VISION_MAX_BYTES:
        data, mime = _shrink_image(path, data, _VISION_MAX_BYTES)
        if not data:
            return info + ". Obraz jest za duży, żeby pokazać go modelowi; zmniejsz go (np. run_command: sips/magick)."
        info += f" (zmniejszony do {_human_size(len(data))} na potrzeby podglądu)"
    with _VISION_LOCK:
        _VISION_QUEUE.append({"path": p, "mime": mime, "b64": base64.b64encode(data).decode("ascii")})
        del _VISION_QUEUE[:-4]
    return info + ". Obraz dołączam do następnego kroku, żebyś go zobaczył (jeśli model obsługuje obrazy)."


def _vision_attach(messages: list, budget_chars: int | None = None) -> int:
    """Obrazy z kolejki jako jedna wiadomość użytkownika (format OpenAI: image_url z data URL). Zwraca liczbę
    dołączonych. budget_chars: limit znaków base64 (np. serwer DomaAI liczy treść do 300 tys. znaków)."""
    with _VISION_LOCK:
        pending, _VISION_QUEUE[:] = list(_VISION_QUEUE), []
    parts, names = [], []
    for img in pending:
        if budget_chars is not None and len(img["b64"]) > budget_chars:
            continue
        if budget_chars is not None:
            budget_chars -= len(img["b64"])
        parts.append({"type": "image_url", "image_url": {"url": f"data:{img['mime']};base64,{img['b64']}"}})
        names.append(img["path"])
    if not parts:
        return 0
    messages.append({"role": "user", "_codo_image": True, "content": [
        {"type": "text", "text": "(Obraz z read_file: " + ", ".join(names) + ")"}] + parts})
    return len(parts)


def _vision_detach(messages: list, note: str = "") -> None:
    """Po kroku obraz zostaje w historii jako krótka notka: historia, zapis rozmowy i okno widzą zwykły tekst,
    a kontekst nie rośnie o base64 w każdym kolejnym kroku."""
    for m in messages:
        if m.get("_codo_image") and isinstance(m.get("content"), list):
            names = next((c.get("text") for c in m["content"] if c.get("type") == "text"), "(obraz)")
            m["content"] = names + (" " + note if note else " Obraz był pokazany w poprzednim kroku; "
                                    "przeczytaj plik ponownie, jeśli chcesz zobaczyć go znowu.")
            m.pop("_codo_image", None)


def _xml_text(xml: str) -> str:
    import html as _html
    xml = re.sub(r"</(text:p|text:h|a:p|w:p)>", "\n", xml)
    xml = re.sub(r"<(text:tab|w:tab)\s*/>", "\t", xml)
    xml = re.sub(r"<text:line-break\s*/>|<w:br\s*/>", "\n", xml)
    return _html.unescape(re.sub(r"<[^>]+>", "", xml))


def _html_tables_text(html: str) -> str:
    """Tabele HTML (z _office_sheet_table) jako wiersze „a | b | c”, z nazwą arkusza i formułami."""
    import html as _html
    out = []
    for name, body in re.findall(r'<table(?: data-name="([^"]*)")?>(.*?)</table>', html, re.S):
        if name:
            out.append(f"## Arkusz: {_html.unescape(name)}")
        for row in re.findall(r"<tr>(.*?)</tr>", body, re.S):
            cells = []
            for attrs, val in re.findall(r"<t[dh]([^>]*)>(.*?)</t[dh]>", row, re.S):
                v = _html.unescape(val)
                f = re.search(r'data-f="([^"]*)"', attrs)
                cells.append(v + (f" {{{_html.unescape(f.group(1))}}}" if f else ""))
            while cells and not cells[-1]:
                cells.pop()
            out.append(" | ".join(cells))
        out.append("")
    return "\n".join(out).strip()


def _xlsx_text_openpyxl(path: Path) -> str | None:
    try:
        import openpyxl  # type: ignore
    except ImportError:
        return None
    try:
        wb = openpyxl.load_workbook(str(path), read_only=True, data_only=True)
    except Exception:  # noqa: BLE001 — uszkodzony plik: wersja wbudowana spróbuje sama
        return None
    try:   # formuły obok wartości (jak czytnik wbudowany): formuła wpisana przez office_edit nie ma jeszcze wyniku
        wbf = openpyxl.load_workbook(str(path), read_only=True, data_only=False)
    except Exception:  # noqa: BLE001
        wbf = None
    out = []
    try:
        for si, ws in enumerate(wb.worksheets):
            out.append(f"## Arkusz: {ws.title}")
            frows = wbf.worksheets[si].iter_rows(values_only=True) if wbf is not None else None
            for i, row in enumerate(ws.iter_rows(values_only=True)):
                if i >= 20000:
                    out.append("… (dalsze wiersze pominięte)")
                    break
                frow = next(frows, None) if frows is not None else None
                cells = ["" if v is None else str(v) for v in row]
                for j, f in enumerate(frow or ()):
                    if isinstance(f, str) and f.startswith("=") and len(f) > 1:
                        while len(cells) <= j:
                            cells.append("")
                        cells[j] = (cells[j] + " " if cells[j] else "") + "{" + f + "}"
                while cells and not cells[-1]:
                    cells.pop()
                out.append(" | ".join(cells))
            out.append("")
    finally:
        for w in (wb, wbf):
            try:
                if w is not None:
                    w.close()
            except Exception:  # noqa: BLE001
                pass  # nosec B110
    return "\n".join(out).strip()


def _pdf_text(path: Path, data: bytes) -> str | None:
    """Tekst z PDF: pdftotext (poppler), pypdf, gdy jest zainstalowany, albo czytnik wbudowany (czysty Python)."""
    import shutil
    if shutil.which("pdftotext"):
        try:
            r = subprocess.run(["pdftotext", "-layout", "-enc", "UTF-8", str(path), "-"], capture_output=True,
                               timeout=90, stdin=subprocess.DEVNULL)  # nosec B603 B607
            t = r.stdout.decode("utf-8", "replace")
            if r.returncode == 0 and t.strip():
                pages = t.split("\f")
                return "\n".join(f"--- strona {i} ---\n{pg.rstrip()}" for i, pg in enumerate(pages, 1) if pg.strip())
        except (OSError, subprocess.SubprocessError):
            pass  # nosec B110
    try:
        import pypdf  # type: ignore
        reader = pypdf.PdfReader(str(path))
        pages = [(pg.extract_text() or "") for pg in reader.pages[:2000]]
        if any(x.strip() for x in pages):
            return "\n".join(f"--- strona {i} ---\n{x.rstrip()}" for i, x in enumerate(pages, 1))
    except Exception:  # noqa: BLE001 — brak pypdf albo PDF, którego nie umie
        pass  # nosec B110
    return _office_pdf_text(data)


def _ipynb_text(data: bytes) -> str | None:
    try:
        nb = json.loads(_decode_text(data)[0])
    except ValueError:
        return None
    if not isinstance(nb, dict) or not isinstance(nb.get("cells"), list):
        return None
    lang = ((nb.get("metadata") or {}).get("kernelspec") or {}).get("language") or "python"
    out = []
    for i, c in enumerate(nb["cells"], 1):
        if not isinstance(c, dict):
            continue
        kind = c.get("cell_type") or "code"
        src = c.get("source")
        src = "".join(src) if isinstance(src, list) else str(src or "")
        out.append(f"# ── komórka {i} [{kind}{', ' + lang if kind == 'code' else ''}] ──")
        out.append(src.rstrip())
        for o in c.get("outputs") or []:
            if not isinstance(o, dict):
                continue
            t = o.get("text")
            if t is None:
                d = o.get("data") or {}
                t = d.get("text/plain") or (f"[{o.get('ename')}: {o.get('evalue')}]" if o.get("ename") else None)
                if t is None and any(k.startswith("image/") for k in d):
                    t = "[obraz w wyniku]"
            if t is not None:
                t = "".join(t) if isinstance(t, list) else str(t)
                t = t if len(t) <= 3000 else t[:3000] + " …"
                out.append("# wynik:\n" + "\n".join("# " + x for x in t.rstrip().split("\n")))
    return "\n".join(out)


def _document_text(path: Path, kind: str, data: bytes | None = None) -> tuple:
    """Dokument jako tekst do czytania: (tekst albo None, opis formatu). Bez nowych twardych zależności:
    biblioteka, gdy jest (openpyxl, pypdf, pdftotext), inaczej czysty Python na zip/xml.
    Z podanymi bajtami (podgląd zmian office_edit) arkusz czyta zawsze czytnik wbudowany."""
    given = data is not None
    if data is None:
        data = _long_path(path).read_bytes()
    if kind == "PDF":
        return _pdf_text(path, data), "PDF"
    if kind == "DOCX":
        html = _office_docx_html(data, None)
        if html is None:
            return None, "DOCX"
        html = re.sub(r"</t[dh]>", " | ", html)
        return _html_to_text(html)[1], "DOCX"
    if kind == "XLSX":
        t = None if given else _xlsx_text_openpyxl(path)
        if t is None:
            html = _office_sheet_table(data, "xlsx")
            t = _html_tables_text(html) if html else None
            if t and not given:
                t += "\n\n(czytnik wbudowany: do 2000 wierszy i 60 kolumn na arkusz; {=…} to formuła komórki)"
        return t, "XLSX"
    if kind == "PPTX":
        try:
            t = _pptx_plain_text(data)
        except (_OfficeError, KeyError, ValueError):
            t = None
        if t:
            return t, "PPTX"
        html = _office_pptx_html(data, None)
        if html is None:
            return None, "PPTX"
        slides = []
        for i, sec in enumerate(re.findall(r"<section[^>]*>(.*?)</section>", html, re.S), 1):
            sec = re.sub(r'<aside class="notes">(.*?)</aside>', r"<p>Notatki prelegenta: \1</p>", sec, flags=re.S)
            slides.append(f"--- slajd {i} ---\n" + _html_to_text(sec)[1])
        return "\n\n".join(slides), "PPTX"
    if kind in ("ODT", "ODS", "ODP"):
        z = _office_zip(data)
        xml = _office_part(z, "content.xml") if z else None
        if not xml:
            return None, kind
        xml = re.sub(r"</table:table-cell>", " | ", xml)
        xml = re.sub(r"</table:table-row>", "\n", xml)
        return re.sub(r"\n{3,}", "\n\n", _xml_text(xml)).strip(), kind
    return None, kind


# ── Edycja dokumentów biurowych w miejscu: office_edit (27.11.2026) ──────────
# Czysty Python (zipfile + minidom), bez nowych zależności. minidom zostawia prefiksy przestrzeni nazw
# i deklaracje xmlns tak, jak były (ElementTree zmienia je na ns0:, a Word odrzuca wtedy mc:Ignorable).
# Zmieniane są tylko części, których dotyczy edycja; reszta paczki przechodzi bajt w bajt.
_OX_W = "http://schemas.openxmlformats.org/wordprocessingml/2006/main"
_OX_A = "http://schemas.openxmlformats.org/drawingml/2006/main"
_OX_P = "http://schemas.openxmlformats.org/presentationml/2006/main"
_OX_S = "http://schemas.openxmlformats.org/spreadsheetml/2006/main"
_OX_R = "http://schemas.openxmlformats.org/officeDocument/2006/relationships"
_OX_MC = "http://schemas.openxmlformats.org/markup-compatibility/2006"
_OX_RT = "http://schemas.openxmlformats.org/officeDocument/2006/relationships/"
_OX_CT = "application/vnd.openxmlformats-officedocument."
_ODF_TEXT = "urn:oasis:names:tc:opendocument:xmlns:text:1.0"
_ODF_OFFICE = "urn:oasis:names:tc:opendocument:xmlns:office:1.0"
_ODF_TABLE = "urn:oasis:names:tc:opendocument:xmlns:table:1.0"
_ODF_DRAW = "urn:oasis:names:tc:opendocument:xmlns:drawing:1.0"
_OFFICE_PART_MAX = 40_000_000   # większych części XML nie wczytujemy do DOM (pamięć)
_OX_FOLD = str.maketrans({"‘": "'", "’": "'", "‚": "'", "‛": "'", "“": '"', "”": '"', "„": '"',
                          "«": '"', "»": '"', "–": "-", "—": "-", "−": "-", " ": " ",
                          " ": " ", " ": " "})   # 1:1 znak na znak, więc pozycje się zgadzają


_OX_PREFIX = {_OX_W: "w", _OX_A: "a", _OX_P: "p", _OX_R: "r", _ODF_TEXT: "text"}


class _OfficeError(Exception):
    pass


def _ox_kids(el, ns=None, local=None) -> list:
    """Dzieci-elementy (opcjonalnie o danej nazwie lokalnej i przestrzeni nazw)."""
    return [c for c in el.childNodes if c.nodeType == 1 and (local is None or c.localName == local)
            and (ns is None or c.namespaceURI == ns)]


def _ox_kid(el, ns, local):
    k = _ox_kids(el, ns, local)
    return k[0] if k else None


def _ox_new(doc, like, local: str, ns: str | None = None):
    """Nowy element w przestrzeni nazw i z prefiksem elementu `like` (w:, a:, text: albo domyślna)."""
    ns = ns or like.namespaceURI
    prefix = None
    node = like
    while node is not None and node.nodeType == 1:   # prefiks dla tej przestrzeni nazw z przodka
        if node.namespaceURI == ns:
            prefix = node.prefix
            break
        node = node.parentNode
    if prefix is None and ns == like.namespaceURI:
        prefix = like.prefix
    elif prefix is None and ns != like.namespaceURI:   # prefiks zadeklarowany w korzeniu (xmlns:a=…)
        root = doc.documentElement
        for i in range(root.attributes.length):
            at = root.attributes.item(i)
            if at.prefix == "xmlns" and at.value == ns:
                prefix = at.localName
                break
        else:
            prefix = _OX_PREFIX.get(ns, "ns0")
            root.setAttribute(f"xmlns:{prefix}", ns)
    return doc.createElementNS(ns, f"{prefix}:{local}" if prefix else local)


def _ox_attr(el, local: str, ns: str | None = None) -> str | None:
    """Wartość atrybutu po nazwie lokalnej (w:val, r:id albo bez prefiksu)."""
    for i in range(el.attributes.length):
        a = el.attributes.item(i)
        if (a.localName or a.name.split(":")[-1]) == local and (ns is None or a.namespaceURI == ns):
            return a.value
    return None


def _ox_set_attr(el, local: str, value: str, ns: str | None = None, prefix: str | None = None) -> None:
    for i in range(el.attributes.length):
        a = el.attributes.item(i)
        if (a.localName or a.name.split(":")[-1]) == local and (ns is None or a.namespaceURI == ns):
            a.value = value
            return
    if ns and prefix:
        el.setAttributeNS(ns, f"{prefix}:{local}", value)
    else:
        el.setAttribute(local, value)


def _ox_ancestor(el, ns, local):
    p = el.parentNode
    while p is not None and p.nodeType == 1:
        if p.localName == local and (ns is None or p.namespaceURI == ns):
            return p
        p = p.parentNode
    return None


class _OfficePkg:
    """Paczka zip dokumentu: części czytane leniwie, DOM tylko dla zmienianych, zapis w tej samej kolejności."""

    def __init__(self, data: bytes):
        import io
        import zipfile
        try:
            self.zf = zipfile.ZipFile(io.BytesIO(data))
        except (zipfile.BadZipFile, ValueError, OSError):
            raise _OfficeError("plik nie jest poprawnym dokumentem (uszkodzony zip)") from None
        seen, self.infos = set(), []
        for i in self.zf.infolist():
            if i.filename not in seen:
                seen.add(i.filename)
                self.infos.append(i)
        self.names = [i.filename for i in self.infos]
        self.dom: dict = {}
        self.dirty: set = set()
        self.added: dict = {}
        self.removed: set = set()
        self.decl: dict = {}

    def has(self, name: str) -> bool:
        return name not in self.removed and (name in self.added or name in self.names)

    def read(self, name: str) -> bytes:
        if name in self.dom and name in self.dirty:
            return self._serialize(name)
        if name in self.added:
            return self.added[name]
        return self.zf.read(name)

    def xml(self, name: str):
        from xml.dom import minidom
        from xml.parsers.expat import ExpatError
        if name in self.dom:
            return self.dom[name]
        if not self.has(name):
            raise _OfficeError(f"brak części {name} w dokumencie")
        info = next((i for i in self.infos if i.filename == name), None)
        if info is not None and info.file_size > _OFFICE_PART_MAX:
            raise _OfficeError(f"część {name} ma {info.file_size // 1_000_000} MB; za duża do edycji wbudowanej")
        raw = self.read(name)
        m = re.match(rb"\s*<\?xml[^>]*\?>", raw)
        self.decl[name] = m.group(0).decode("ascii", "replace").strip() if m else ""
        try:
            self.dom[name] = minidom.parseString(raw)
        except (ExpatError, ValueError) as e:
            raise _OfficeError(f"nie da się odczytać {name}: {e}") from None
        return self.dom[name]

    def touch(self, name: str) -> None:
        self.dirty.add(name)

    def put(self, name: str, data, ctype: str | None = None) -> None:
        """Nowa część (bajty albo tekst XML); z ctype dopisuje Override w [Content_Types].xml."""
        self.added[name] = data.encode("utf-8") if isinstance(data, str) else data
        self.removed.discard(name)
        self.dom.pop(name, None)
        if ctype:
            self.ct_override(name, ctype)

    def remove(self, name: str) -> None:
        if self.has(name):
            self.removed.add(name)
            self.added.pop(name, None)
            self.ct_remove(name)

    def fresh_name(self, pattern: str) -> str:
        """Wolna nazwa części według wzorca z {n}, np. ppt/slides/slide{n}.xml."""
        n = 1
        while self.has(pattern.format(n=n)):
            n += 1
        return pattern.format(n=n)

    def _serialize(self, name: str) -> bytes:
        doc = self.dom[name]
        decl = self.decl.get(name) or ""
        standalone = ' standalone="yes"' if re.search(r"standalone\s*=\s*['\"]yes", decl) else ""
        head = f'<?xml version="1.0" encoding="UTF-8"{standalone}?>\n'
        return (head + "".join(c.toxml() for c in doc.childNodes)).encode("utf-8")

    # relacje i typy zawartości
    @staticmethod
    def rels_name(part: str) -> str:
        d, _, f = part.rpartition("/")
        return f"{d}/_rels/{f}.rels" if d else f"_rels/{f}.rels"

    @staticmethod
    def resolve(part: str, target: str) -> str:
        import posixpath
        if target.startswith("/"):
            return target[1:]
        return posixpath.normpath(posixpath.join(posixpath.dirname(part), target)).lstrip("/")

    def rels(self, part: str) -> list:
        """[(Id, typ bez przedrostka, ścieżka części, element)] relacji części; zewnętrzne pomija."""
        rn = self.rels_name(part)
        if not self.has(rn):
            return []
        out = []
        for r in self.xml(rn).documentElement.getElementsByTagName("Relationship"):
            if (r.getAttribute("TargetMode") or "") == "External":
                continue
            typ = r.getAttribute("Type").rsplit("/", 1)[-1]
            out.append((r.getAttribute("Id"), typ, self.resolve(part, r.getAttribute("Target")), r))
        return out

    def rel_target(self, part: str, rid: str) -> str | None:
        return next((t for i, _ty, t, _r in self.rels(part) if i == rid), None)

    def rels_of_type(self, part: str, typ: str) -> list:
        return [t for _i, ty, t, _r in self.rels(part) if ty == typ]

    def add_rel(self, part: str, typ: str, target_part: str) -> str:
        import posixpath
        rn = self.rels_name(part)
        if not self.has(rn):
            self.put(rn, '<?xml version="1.0" encoding="UTF-8" standalone="yes"?>\n<Relationships '
                         'xmlns="http://schemas.openxmlformats.org/package/2006/relationships"/>')
        doc = self.xml(rn)
        root = doc.documentElement
        ids = {r.getAttribute("Id") for r in root.getElementsByTagName("Relationship")}
        n = 1
        while f"rId{n}" in ids:
            n += 1
        el = doc.createElementNS(root.namespaceURI, "Relationship")
        el.setAttribute("Id", f"rId{n}")
        el.setAttribute("Type", _OX_RT + typ if "/" not in typ else typ)
        el.setAttribute("Target", posixpath.relpath(target_part, posixpath.dirname(part) or "."))
        root.appendChild(el)
        self.touch(rn)
        return f"rId{n}"

    def drop_rel(self, part: str, target_part: str) -> None:
        rn = self.rels_name(part)
        for _i, _ty, t, r in self.rels(part):
            if t == target_part:
                r.parentNode.removeChild(r)
                self.touch(rn)

    def ct_override(self, part: str, ctype: str) -> None:
        if not self.has("[Content_Types].xml"):
            return
        doc = self.xml("[Content_Types].xml")
        root = doc.documentElement
        pn = "/" + part
        for o in root.getElementsByTagName("Override"):
            if o.getAttribute("PartName").lower() == pn.lower():
                o.setAttribute("ContentType", ctype)
                self.touch("[Content_Types].xml")
                return
        el = doc.createElementNS(root.namespaceURI, "Override")
        el.setAttribute("PartName", pn)
        el.setAttribute("ContentType", ctype)
        root.appendChild(el)
        self.touch("[Content_Types].xml")

    def ct_remove(self, part: str) -> None:
        if not self.has("[Content_Types].xml"):
            return
        root = self.xml("[Content_Types].xml").documentElement
        for o in root.getElementsByTagName("Override"):
            if o.getAttribute("PartName").lower() == ("/" + part).lower():
                root.removeChild(o)
                self.touch("[Content_Types].xml")

    def main_part(self, default: str) -> str:
        """Główna część dokumentu z _rels/.rels (officeDocument), inaczej nazwa domyślna."""
        for _i, ty, t, _r in self.rels(""):
            if ty == "officeDocument" and self.has(t):
                return t
        return default

    def save(self) -> bytes:
        import io
        import time
        import zipfile
        out = io.BytesIO()
        with zipfile.ZipFile(out, "w", zipfile.ZIP_DEFLATED) as z:
            for info in self.infos:
                n = info.filename
                if n in self.removed:
                    continue
                zi = zipfile.ZipInfo(n, date_time=info.date_time)
                zi.compress_type = info.compress_type   # ODF: „mimetype” zostaje pierwszy i bez kompresji
                zi.external_attr = info.external_attr
                z.writestr(zi, self.read(n))
            now = time.localtime()[:6]
            for n in self.added:
                if n in self.names:
                    continue
                zi = zipfile.ZipInfo(n, date_time=now)
                zi.compress_type = zipfile.ZIP_DEFLATED
                z.writestr(zi, self.read(n))
        return out.getvalue()


# Tekst akapitu jako ciąg odcinków: edytowalne węzły tekstu i stałe elementy (tabulator, złamanie linii),
# żeby zamiana działała także wtedy, gdy Word podzielił zdanie na kilka „runów” o tym samym formacie.
_OX_FLAVOURS = {
    "w": {"para": {(_OX_W, "p")}, "t": (_OX_W, "t"),
          "fixed": {(_OX_W, "tab"): "\t", (_OX_W, "br"): "\n", (_OX_W, "cr"): "\n"},
          "skip": {(_OX_W, "instrText"), (_OX_W, "delText"), (_OX_W, "pPr"), (_OX_MC, "Fallback")}},
    "a": {"para": {(_OX_A, "p")}, "t": (_OX_A, "t"), "fixed": {(_OX_A, "br"): "\n"},
          "skip": {(_OX_A, "fld"), (_OX_A, "pPr"), (_OX_A, "endParaRPr")}},
    "x": {"para": set(), "t": (None, "t"), "fixed": {}, "skip": {(None, "rPh"), (None, "phoneticPr")}},
    "odf": {"para": {(_ODF_TEXT, "p"), (_ODF_TEXT, "h")}, "t": None,
            "fixed": {(_ODF_TEXT, "tab"): "\t", (_ODF_TEXT, "line-break"): "\n"},
            "skip": {(_ODF_TEXT, "note"), (_ODF_OFFICE, "annotation"), (_ODF_DRAW, "frame"),
                     (_ODF_DRAW, "custom-shape")}},
}


def _ox_key_in(el, keys) -> bool:
    return any(el.localName == loc and (ns is None or el.namespaceURI == ns) for ns, loc in keys)


def _ox_segments(par, fl: str) -> list:
    """[[węzeł, tekst, edytowalny]] akapitu w kolejności dokumentu (bez akapitów zagnieżdżonych)."""
    cfg = _OX_FLAVOURS[fl]
    segs: list = []

    def walk(node):
        for ch in node.childNodes:
            if ch.nodeType in (3, 4):   # tekst, CDATA
                parent = ch.parentNode
                ok = cfg["t"] is None or _ox_key_in(parent, {cfg["t"]})
                if ok and fl == "a" and (parent.parentNode is None or parent.parentNode.localName != "r"):
                    ok = False
                if ok:
                    segs.append([ch, ch.data, True])
            elif ch.nodeType == 1:
                if _ox_key_in(ch, cfg["para"]) or _ox_key_in(ch, cfg["skip"]):
                    continue
                if fl == "odf" and ch.namespaceURI == _ODF_TEXT and ch.localName == "s":
                    segs.append([ch, " " * max(1, int(_ox_attr(ch, "c") or 1)), False])
                    continue
                fixed = next((v for k, v in cfg["fixed"].items() if _ox_key_in(ch, {k})), None)
                if fixed is not None:
                    segs.append([ch, fixed, False])
                    continue
                walk(ch)
    walk(par)
    return segs


def _ox_par_text(par, fl: str) -> str:
    return "".join(s[1] for s in _ox_segments(par, fl))


def _ox_find(text: str, find: str) -> list:
    """Pozycje wystąpień: dokładnie, a gdy brak, po ujednoliceniu cudzysłowów, myślników i twardych spacji."""
    out, i = [], text.find(find)
    while i >= 0 and find:
        out.append(i)
        i = text.find(find, i + len(find))
    if out or not find:
        return out
    ft, ff = text.translate(_OX_FOLD), find.translate(_OX_FOLD)
    i = ft.find(ff)
    while i >= 0:
        out.append(i)
        i = ft.find(ff, i + len(ff))
    return out


def _ox_breaks(tnode, parts: list, fl: str) -> None:
    """Tekst z \\n i \\t w miejscu jednego węzła: pierwszy kawałek zostaje w węźle, reszta po nim
    jako złamania linii / tabulatory w formacie dokumentu (w:br, a:br, text:line-break)."""
    doc = tnode.ownerDocument
    tnode.data = parts[0][1]
    anchor = tnode
    if fl == "w":
        t_el = tnode.parentNode
        anchor = t_el
        for sep, chunk in parts[1:]:
            br = _ox_new(doc, t_el, "tab" if sep == "\t" else "br")
            anchor.parentNode.insertBefore(br, anchor.nextSibling)
            nt = _ox_new(doc, t_el, "t")
            nt.setAttribute("xml:space", "preserve")
            nt.appendChild(doc.createTextNode(chunk))
            br.parentNode.insertBefore(nt, br.nextSibling)
            anchor = nt
    elif fl == "a":
        run = tnode.parentNode.parentNode
        anchor = run
        for _sep, chunk in parts[1:]:   # w prezentacji tabulator zostaje znakiem tekstu
            br = _ox_new(doc, run, "br")
            rpr = _ox_kid(run, _OX_A, "rPr")
            if rpr is not None:
                br.appendChild(rpr.cloneNode(True))
            anchor.parentNode.insertBefore(br, anchor.nextSibling)
            nr = run.cloneNode(True)
            for t in nr.getElementsByTagNameNS(_OX_A, "t"):
                while t.firstChild:
                    t.removeChild(t.firstChild)
                t.appendChild(doc.createTextNode(chunk))
            br.parentNode.insertBefore(nr, br.nextSibling)
            anchor = nr
    elif fl == "odf":
        for sep, chunk in parts[1:]:
            el = doc.createElementNS(_ODF_TEXT, "text:tab" if sep == "\t" else "text:line-break")
            anchor.parentNode.insertBefore(el, anchor.nextSibling)
            nt = doc.createTextNode(chunk)
            el.parentNode.insertBefore(nt, el.nextSibling)
            anchor = nt


_OX_SPLIT = {"w": r"([\n\t])", "odf": r"([\n\t])", "a": r"(\n)"}   # arkusz: \n zostaje znakiem


def _ox_replace_at(par, fl: str, start: int, end: int, repl: str) -> bool:
    """Zamiana tekstu akapitu na pozycjach [start, end): format pierwszego znaku zostaje, reszta
    dopasowania znika z kolejnych runów. False, gdy dopasowanie przecina stały element w połowie."""
    pos, hit = 0, []
    segs = _ox_segments(par, fl)
    for s in segs:
        a, b = pos, pos + len(s[1])
        pos = b
        if a < end and b > start or start == end and s[2] and (a < start <= b or start == a == 0):
            hit.append((s, a, b))
            if start == end:   # samo wstawienie: do odcinka ze znakiem przed nim
                break
    if not hit or any(not s[2] and (a < start or b > end) for s, a, b in hit):
        return False
    first = next((h for h in hit if h[0][2]), None)
    if first is None:
        return False
    for h in hit:
        s, a, b = h
        node = s[0]
        if not s[2]:   # tabulator / złamanie linii w środku dopasowania znika razem z nim
            if node.parentNode is not None:
                node.parentNode.removeChild(node)
            continue
        text = node.data
        lo, hi = max(0, start - a), min(len(text), end - a)
        if h is not first:
            node.data = text[:lo] + text[hi:]
            continue
        new = text[:lo] + repl + text[hi:]
        chunks = re.split(_OX_SPLIT[fl], new) if fl in _OX_SPLIT else [new]
        if len(chunks) > 1:
            _ox_breaks(node, [("", chunks[0])] + [(chunks[i], chunks[i + 1]) for i in range(1, len(chunks) - 1, 2)], fl)
        else:
            node.data = new
        if fl in ("w", "x") and node.parentNode is not None:   # spacje na brzegach giną bez xml:space
            node.parentNode.setAttribute("xml:space", "preserve")
    _ox_drop_empty_runs(par, fl)
    return True


def _ox_replace_smart(par, fl: str, start: int, end: int, repl: str) -> bool:
    """Zamiana słowo po słowie: zmienione słowa dostają format słów, które zastępują („2025” pogrubione
    → „2026” pogrubione), a nie format pierwszego znaku całego dopasowania."""
    import difflib
    pos, fixed = 0, False
    for s in _ox_segments(par, fl):
        a, b = pos, pos + len(s[1])
        pos = b
        if not s[2] and a < end and b > start:
            fixed = True
    old = _ox_par_text(par, fl)[start:end]
    if fixed or fl == "x":
        return _ox_replace_at(par, fl, start, end, repl)
    tok = re.compile(r"\w+|\s+|[^\w\s]")
    ta, tb = tok.findall(old), tok.findall(repl)
    offs = [0]
    for t in ta:
        offs.append(offs[-1] + len(t))
    ops = [(offs[i1], offs[i2], "".join(tb[j1:j2]))
           for tag, i1, i2, j1, j2 in difflib.SequenceMatcher(None, ta, tb, autojunk=False).get_opcodes()
           if tag != "equal"]
    if not ops:
        return True
    ok = True
    for s, e, r in reversed(ops):
        ok = _ox_replace_at(par, fl, start + s, start + e, r) and ok
    return ok


def _ox_drop_empty_runs(par, fl: str) -> None:
    """Runy, z których zamiana zabrała cały tekst (tylko rPr i pusty t), wypadają."""
    if fl not in ("w", "a"):
        return
    ns = _OX_W if fl == "w" else _OX_A
    for r in list(par.getElementsByTagNameNS(ns, "r")):
        kids = _ox_kids(r)
        ts = [k for k in kids if k.localName == "t"]
        if ts and all(k.localName in ("rPr", "t") for k in kids) and not "".join(
                (t.firstChild.data if t.firstChild else "") for t in ts):
            r.parentNode.removeChild(r)


def _ox_short(t: str, n: int = 80) -> str:
    t = " ".join(t.split())
    return t if len(t) <= n else t[:n - 1] + "…"


def _ox_replace_in(pars: list, fl: str, find: str, repl: str, every: bool, where) -> tuple:
    """Zamiana w akapitach: (liczba zamian, lista miejsc dla komunikatu o niejednoznaczności).
    where(par) opisuje miejsce akapitu (np. „slajd 2”)."""
    if "\n" in find:
        raise _OfficeError("find nie może przechodzić przez kilka akapitów; zamieniaj akapit po akapicie")
    found = []
    for par in pars:
        hits = _ox_find(_ox_par_text(par, fl), find)
        if hits:
            found.append((par, hits))
    total = sum(len(h) for _p, h in found)
    if total == 0:
        return 0, []
    if total > 1 and not every:
        places = []
        for par, hits in found[:6]:
            t = _ox_par_text(par, fl)
            places.append(f"{where(par)}: „{_ox_short(t)}”"
                          + (f" ({len(hits)}×)" if len(hits) > 1 else ""))
        return total, places
    n = 0
    for par, hits in found:
        for i in sorted(hits, reverse=True):   # od końca: wcześniejsze pozycje zostają ważne
            if _ox_replace_smart(par, fl, i, i + len(find), repl):
                n += 1
    return n, []


def _ox_not_found(pars: list, fl: str, find: str, what: str) -> str:
    low = find.lower()
    for par in pars:
        t = _ox_par_text(par, fl)
        i = t.lower().find(low)
        if i >= 0:
            return (f"nie znaleziono „{find}” w {what}; jest „{t[i:i + len(find)]}” (inna wielkość liter). "
                    "Podaj find dokładnie jak w dokumencie")
    return (f"nie znaleziono „{_ox_short(find, 120)}” w {what}. Zamiana działa w obrębie jednego akapitu "
            "(komórki); przeczytaj dokument przez read_file i skopiuj fragment dokładnie")


# ── DOCX ────────────────────────────────────────────────────────────────────
def _docx_parts(pkg) -> list:
    main = pkg.main_part("word/document.xml")
    extra = [t for _i, ty, t, _r in pkg.rels(main) if ty in ("header", "footer", "footnotes", "endnotes")]
    return [main] + [t for t in extra if pkg.has(t)]


def _docx_pars(doc) -> list:
    return [p for p in doc.getElementsByTagNameNS(_OX_W, "p") if _ox_ancestor(p, _OX_MC, "Fallback") is None]


def _docx_body(pkg):
    main = pkg.main_part("word/document.xml")
    doc = pkg.xml(main)
    body = doc.getElementsByTagNameNS(_OX_W, "body")
    if not body:
        raise _OfficeError("dokument nie ma treści (w:body)")
    return main, doc, body[0]


def _docx_where(par) -> str:
    return "tabela" if _ox_ancestor(par, _OX_W, "tc") is not None else "akapit"


def _docx_find_par(pkg, frag: str, what: str = "after"):
    """Jeden akapit zawierający fragment (do wstawiania i usuwania)."""
    main, doc, body = _docx_body(pkg)
    pars = _docx_pars(doc)
    hit = [p for p in pars if _ox_find(_ox_par_text(p, "w"), frag)]
    if not hit:
        raise _OfficeError(_ox_not_found(pars, "w", frag, "dokumencie") + f" ({what})")
    if len(hit) > 1:
        raise _OfficeError(f"„{frag}” jest w {len(hit)} akapitach: "
                           + "; ".join("„" + _ox_short(_ox_par_text(p, 'w')) + "”" for p in hit[:5])
                           + ". Podaj dłuższy, jednoznaczny fragment")
    return main, doc, hit[0]


def _docx_styles(pkg) -> tuple:
    """(nazwa części styles.xml albo None, {styleId: (nazwa, typ, element)})."""
    main = pkg.main_part("word/document.xml")
    sp = next(iter(pkg.rels_of_type(main, "styles")), None)
    if not sp or not pkg.has(sp):
        return None, {}
    out = {}
    for st in pkg.xml(sp).getElementsByTagNameNS(_OX_W, "style"):
        nm = _ox_kid(st, _OX_W, "name")
        out[_ox_attr(st, "styleId") or ""] = ((_ox_attr(nm, "val") if nm is not None else "") or "",
                                             _ox_attr(st, "type") or "", st)
    return sp, out


def _docx_is_heading_style(styles: dict, sid: str | None) -> bool:
    if not sid:
        return False
    name = (styles.get(sid) or ("",))[0].lower()
    return bool(re.match(r"(heading \d|title|subtitle)$", name) or re.match(r"(Heading|Nagwek)\d|Title$", sid))


def _docx_style_id(pkg, style: str | None, heading: int | None) -> str | None:
    """styleId dla stylu podanego nazwą lub id albo poziomu nagłówka; brakujący nagłówek dopisuje do styles.xml."""
    sp, styles = _docx_styles(pkg)
    if heading:
        lvl = max(1, min(9, int(heading)))
        for sid, (nm, ty, _e) in styles.items():
            if ty == "paragraph" and nm.lower() == f"heading {lvl}":
                return sid
        sid = f"Heading{lvl}"
        if sid in styles or sp is None:
            return sid
        doc = pkg.xml(sp)
        root = doc.documentElement
        normal = next((s for s, (_n, ty, e) in styles.items()
                       if ty == "paragraph" and _ox_attr(e, "default") in ("1", "true")), None)
        size = {1: 32, 2: 28, 3: 26, 4: 24}.get(lvl, 22)
        from xml.dom import minidom
        frag = minidom.parseString(
            f'<w:style xmlns:w="{_OX_W}" w:type="paragraph" w:styleId="{sid}"><w:name w:val="heading {lvl}"/>'
            + (f'<w:basedOn w:val="{normal}"/><w:next w:val="{normal}"/>' if normal else "")
            + f'<w:uiPriority w:val="9"/><w:qFormat/><w:pPr><w:keepNext/><w:spacing w:before="240" w:after="80"/>'
            f'<w:outlineLvl w:val="{lvl - 1}"/></w:pPr><w:rPr><w:b/><w:bCs/><w:sz w:val="{size}"/>'
            f'<w:szCs w:val="{size}"/></w:rPr></w:style>').documentElement
        node = doc.importNode(frag, True)
        if node.hasAttribute("xmlns:w"):
            node.removeAttribute("xmlns:w")
        root.appendChild(node)
        pkg.touch(sp)
        return sid
    if not style:
        return None
    if style in styles:
        return style
    low = style.lower()
    for sid, (nm, ty, _e) in styles.items():
        if nm.lower() == low and ty in ("paragraph", ""):
            return sid
    if not styles:
        return style
    names = [nm or sid for sid, (nm, ty, _e) in styles.items() if ty == "paragraph"][:25]
    raise _OfficeError(f"nie ma stylu akapitu „{style}”. Dostępne: {', '.join(names)}. Nagłówek: heading=1…6")


def _w_fill_run(doc, run, text: str) -> None:
    """Treść runu z tekstu: w:t, a \\n i \\t jako w:br i w:tab."""
    for i, chunk in enumerate(re.split(r"([\n\t])", text)):
        if i % 2:
            run.appendChild(_ox_new(doc, run, "br" if chunk == "\n" else "tab"))
        elif chunk or i == 0:
            t = _ox_new(doc, run, "t")
            t.setAttribute("xml:space", "preserve")
            t.appendChild(doc.createTextNode(chunk))
            run.appendChild(t)


def _w_par(doc, like, text: str, ppr=None, rpr=None):
    p = _ox_new(doc, like, "p", _OX_W)
    if ppr is not None:
        p.appendChild(ppr)
    r = _ox_new(doc, p, "r")
    if rpr is not None:
        r.appendChild(rpr.cloneNode(True))
    _w_fill_run(doc, r, text)
    p.appendChild(r)
    return p


def _w_set_par_text(doc, p, text: str) -> None:
    """Cała treść akapitu na nowy tekst w formacie jego pierwszego runu (pPr zostaje)."""
    runs = p.getElementsByTagNameNS(_OX_W, "r")
    rpr = _ox_kid(runs[0], _OX_W, "rPr") if runs else None
    rpr = rpr.cloneNode(True) if rpr is not None else None
    for k in list(p.childNodes):
        if not (k.nodeType == 1 and k.namespaceURI == _OX_W and k.localName == "pPr"):
            p.removeChild(k)
    if text:
        r = _ox_new(doc, p, "r", _OX_W)
        if rpr is not None:
            r.appendChild(rpr)
        _w_fill_run(doc, r, text)
        p.appendChild(r)


def _docx_replace(pkg, a: dict) -> str:
    find, repl = str(a.get("find") or ""), str(a.get("replace") if a.get("replace") is not None else "")
    if not find:
        raise _OfficeError("podaj find (tekst do zamiany) i replace")
    pars_all, owners = [], {}
    for part in _docx_parts(pkg):
        for p in _docx_pars(pkg.xml(part)):
            pars_all.append(p)
            owners[id(p)] = part
    n, places = _ox_replace_in(pars_all, "w", find, repl, bool(a.get("all")), _docx_where)
    if places:
        raise _OfficeError(f"„{find}” występuje {n}× ({'; '.join(places)}). Podaj dłuższy fragment albo all=true")
    if not n:
        raise _OfficeError(_ox_not_found(pars_all, "w", find, "dokumencie"))
    for part in set(owners.values()):
        pkg.touch(part)
    return f"zamiana {n}×"


def _docx_insert(pkg, a: dict) -> str:
    text = str(a.get("text") if a.get("text") is not None else a.get("value") or "")
    heading = a.get("heading")
    try:
        heading = int(heading) if heading not in (None, "", 0, False) else None
    except (TypeError, ValueError):
        raise _OfficeError("heading to poziom nagłówka 1…6") from None
    sid = _docx_style_id(pkg, a.get("style"), heading)
    _sp, styles = _docx_styles(pkg)
    after, before = a.get("after"), a.get("before")
    if after or before:
        main, doc, anchor = _docx_find_par(pkg, str(after or before), "after" if after else "before")
    else:
        main, doc, body = _docx_body(pkg)
        anchor = None
    like_ppr, like_rpr = None, None
    if anchor is not None:
        ppr = _ox_kid(anchor, _OX_W, "pPr")
        ps = _ox_kid(ppr, _OX_W, "pStyle") if ppr is not None else None
        anchor_heading = _docx_is_heading_style(styles, _ox_attr(ps, "val") if ps is not None else None)
        if ppr is not None and not sid and not anchor_heading:
            like_ppr = ppr.cloneNode(True)
            for k in _ox_kids(like_ppr, _OX_W, "sectPr"):
                like_ppr.removeChild(k)
            runs = anchor.getElementsByTagNameNS(_OX_W, "r")
            like_rpr = _ox_kid(runs[0], _OX_W, "rPr") if runs else None
    new = []
    for line in (text.split("\n") if text else [""]):
        ppr = like_ppr.cloneNode(True) if like_ppr is not None else None
        if sid:
            ppr = _ox_new(doc, doc.documentElement, "pPr", _OX_W)
            st = _ox_new(doc, ppr, "pStyle")
            st.setAttributeNS(_OX_W, st.prefix + ":val" if st.prefix else "val", sid)
            ppr.appendChild(st)
        new.append(_w_par(doc, doc.documentElement, line, ppr, like_rpr))
    if anchor is not None:
        ref = anchor.nextSibling if after else anchor
        for p in new:
            anchor.parentNode.insertBefore(p, ref)
    else:
        at = str(a.get("at") or "end")
        kids = _ox_kids(body)
        if at == "start":
            ref = kids[0] if kids else None
        else:
            ref = kids[-1] if kids and kids[-1].localName == "sectPr" else None
        for p in new:
            body.insertBefore(p, ref)
    pkg.touch(main)
    kind = f"nagłówek {heading}" if heading else ("akapit" if len(new) == 1 else f"{len(new)} akapity")
    return f"wstawiono {kind}"


def _docx_delete(pkg, a: dict) -> str:
    frag = str(a.get("find") or a.get("text") or "")
    if not frag:
        raise _OfficeError("podaj find: fragment akapitu do usunięcia")
    main, doc, body = _docx_body(pkg)
    pars = _docx_pars(doc)
    hit = [p for p in pars if _ox_find(_ox_par_text(p, "w"), frag)]
    if not hit:
        raise _OfficeError(_ox_not_found(pars, "w", frag, "dokumencie"))
    if len(hit) > 1 and not a.get("all"):
        raise _OfficeError(f"„{frag}” jest w {len(hit)} akapitach; podaj dłuższy fragment albo all=true")
    cleared = 0
    for p in hit:
        parent = p.parentNode
        ppr = _ox_kid(p, _OX_W, "pPr")
        keep = (ppr is not None and _ox_kid(ppr, _OX_W, "sectPr") is not None) or \
            (parent.localName in ("tc", "txbxContent", "body", "hdr", "ftr") and len(_ox_kids(parent, _OX_W, "p")) == 1)
        if keep:   # koniec sekcji albo jedyny akapit komórki: zostaje pusty
            _w_set_par_text(doc, p, "")
            cleared += 1
        else:
            parent.removeChild(p)
    pkg.touch(main)
    return f"usunięto {len(hit) - cleared} akap." + (f", wyczyszczono {cleared} (koniec sekcji / jedyny w komórce)"
                                                     if cleared else "")


def _docx_table(pkg, a: dict):
    main, doc, body = _docx_body(pkg)
    tables = [t for t in body.getElementsByTagNameNS(_OX_W, "tbl")]
    try:
        ti = int(a.get("table") or 1)
    except (TypeError, ValueError):
        raise _OfficeError("table to numer tabeli od 1") from None
    if not tables:
        raise _OfficeError("dokument nie ma tabel")
    if not 1 <= ti <= len(tables):
        raise _OfficeError(f"dokument ma {len(tables)} tabel(e); table={ti} nie istnieje")
    return main, doc, tables[ti - 1], ti


def _docx_set_cell(pkg, a: dict) -> str:
    main, doc, tbl, ti = _docx_table(pkg, a)
    rows = _ox_kids(tbl, _OX_W, "tr")
    try:
        r, c = int(a.get("row")), int(a.get("col"))
    except (TypeError, ValueError):
        raise _OfficeError("podaj row i col (od 1)") from None
    if not 1 <= r <= len(rows):
        raise _OfficeError(f"tabela {ti} ma {len(rows)} wierszy; row={r} nie istnieje")
    cells = _ox_kids(rows[r - 1], _OX_W, "tc")
    if not 1 <= c <= len(cells):
        raise _OfficeError(f"wiersz {r} tabeli {ti} ma {len(cells)} komórek; col={c} nie istnieje")
    _docx_cell_text(doc, cells[c - 1], str(a.get("text") if a.get("text") is not None else a.get("value") or ""))
    pkg.touch(main)
    return f"tabela {ti}, komórka [{r},{c}]"


def _docx_cell_text(doc, tc, text: str) -> None:
    if _ox_kids(tc, _OX_W, "tbl"):
        raise _OfficeError("komórka zawiera zagnieżdżoną tabelę; zmień jej tekst przez replace")
    ps = _ox_kids(tc, _OX_W, "p")
    if not ps:
        tc.appendChild(_w_par(doc, tc, ""))
        ps = _ox_kids(tc, _OX_W, "p")
    for p in ps[1:]:
        tc.removeChild(p)
    lines = text.split("\n")
    _w_set_par_text(doc, ps[0], lines[0])
    prev = ps[0]
    for line in lines[1:]:   # kolejne linie jako akapity w tym samym formacie
        p = prev.cloneNode(True)
        _w_set_par_text(doc, p, line)
        tc.insertBefore(p, prev.nextSibling)
        prev = p


def _docx_add_row(pkg, a: dict) -> str:
    main, doc, tbl, ti = _docx_table(pkg, a)
    rows = _ox_kids(tbl, _OX_W, "tr")
    if not rows:
        raise _OfficeError(f"tabela {ti} nie ma wierszy")
    values = a.get("values")
    if not isinstance(values, list):
        values = [values] if values not in (None, "") else []
    if values and isinstance(values[0], list):
        values = values[0]
    try:
        after = int(a.get("after_row") or len(rows))
    except (TypeError, ValueError):
        raise _OfficeError("after_row to numer wiersza od 1") from None
    if not 0 <= after <= len(rows):
        raise _OfficeError(f"tabela {ti} ma {len(rows)} wierszy; after_row={after} nie istnieje")
    tpl = rows[max(0, after - 1)] if after else rows[0]
    new = tpl.cloneNode(True)
    trpr = _ox_kid(new, _OX_W, "trPr")
    if trpr is not None:
        for k in _ox_kids(trpr, _OX_W, "tblHeader"):
            trpr.removeChild(k)
    cells = _ox_kids(new, _OX_W, "tc")
    if len(values) > len(cells):
        raise _OfficeError(f"wiersz ma {len(cells)} komórek, a values ma {len(values)} wartości")
    for i, tc in enumerate(cells):
        tcpr = _ox_kid(tc, _OX_W, "tcPr")
        if tcpr is not None:
            for k in _ox_kids(tcpr, _OX_W, "vMerge"):
                tcpr.removeChild(k)
        for nested in _ox_kids(tc, _OX_W, "tbl"):
            tc.removeChild(nested)
        _docx_cell_text(doc, tc, "" if i >= len(values) or values[i] is None else str(values[i]))
    tbl.insertBefore(new, rows[after - 1].nextSibling if after else rows[0])
    pkg.touch(main)
    return f"tabela {ti}: nowy wiersz {after + 1}"


# ── XLSX ────────────────────────────────────────────────────────────────────
def _xl_col(letters: str) -> int:
    n = 0
    for ch in letters.upper():
        n = n * 26 + ord(ch) - 64
    return n


def _xl_letters(n: int) -> str:
    s = ""
    while n:
        n, r = divmod(n - 1, 26)
        s = chr(65 + r) + s
    return s


def _xl_ref(ref: str) -> tuple:
    m = re.fullmatch(r"\$?([A-Za-z]{1,3})\$?(\d{1,7})", str(ref or "").strip())
    if not m:
        raise _OfficeError(f"„{ref}” to nie adres komórki (np. B2)")
    c, r = _xl_col(m.group(1)), int(m.group(2))
    if not (1 <= c <= 16384 and 1 <= r <= 1048576):
        raise _OfficeError(f"adres {ref} poza arkuszem")
    return c, r


_XL_REF_RE = re.compile(r"(?<![A-Za-z0-9_.\"'])(\$?)([A-Z]{1,3})(\$?)(\d{1,7})(?![A-Za-z0-9_(])")


def _xl_shift_formula(f: str, dr: int, dc: int) -> str:
    """Formuła przesunięta o (dr, dc) jak przy kopiowaniu komórki: zmieniają się adresy bez $."""
    def shift(m):
        c = _xl_col(m.group(2)) + (0 if m.group(1) else dc)
        r = int(m.group(4)) + (0 if m.group(3) else dr)
        if c < 1 or r < 1:
            return "#REF!"
        return f"{m.group(1)}{_xl_letters(c)}{m.group(3)}{r}"
    parts = re.split(r'("(?:[^"]|"")*")', f)
    return "".join(p if i % 2 else _XL_REF_RE.sub(shift, p) for i, p in enumerate(parts))


def _xl_cells(sd):
    for row in _ox_kids(sd, None, "row"):
        yield from _ox_kids(row, None, "c")


class _XlBook:
    """Skoroszyt w paczce: arkusze, wspólne ciągi (sharedStrings), tabele i przeliczanie."""

    def __init__(self, pkg):
        self.pkg = pkg
        self.wb = pkg.main_part("xl/workbook.xml")
        self.doc = pkg.xml(self.wb)
        self._sst = None
        self._sst_index = None
        self.touched_sheets: set = set()

    def sheets(self) -> list:
        """[(nazwa, część arkusza albo None dla wykresu, element sheet)]."""
        out = []
        rels = {i: (ty, t) for i, ty, t, _r in self.pkg.rels(self.wb)}
        sheets = _ox_kid(self.doc.documentElement, None, "sheets")
        for s in (_ox_kids(sheets, None, "sheet") if sheets is not None else []):
            ty, part = rels.get(_ox_attr(s, "id", _OX_R) or _ox_attr(s, "id") or "", ("", None))
            ok = ty == "worksheet" and part and self.pkg.has(part)
            out.append((s.getAttribute("name"), part if ok else None, s))
        return out

    def sheet(self, name) -> tuple:
        sh = [x for x in self.sheets() if x[1]]
        if not sh:
            raise _OfficeError("skoroszyt nie ma arkuszy z komórkami")
        if name in (None, ""):
            return sh[0][0], sh[0][1]
        if isinstance(name, int) or str(name).isdigit():
            i = int(name)
            if 1 <= i <= len(sh) and not any(x[0] == str(name) for x in sh):
                return sh[i - 1][0], sh[i - 1][1]
        for nm, part, _e in sh:
            if nm == str(name) or nm.lower() == str(name).lower():
                return nm, part
        raise _OfficeError(f"nie ma arkusza „{name}”. Arkusze: {', '.join(x[0] for x in sh)}")

    # wspólne ciągi
    def sst(self):
        if self._sst is None:
            part = next(iter(self.pkg.rels_of_type(self.wb, "sharedStrings")), None)
            if not part or not self.pkg.has(part):
                part = "xl/sharedStrings.xml" if not self.pkg.has("xl/sharedStrings.xml") else self.pkg.fresh_name(
                    "xl/sharedStrings{n}.xml")
                self.pkg.put(part, f'<?xml version="1.0" encoding="UTF-8" standalone="yes"?>\n'
                                   f'<sst xmlns="{_OX_S}" count="0" uniqueCount="0"/>',
                             _OX_CT + "spreadsheetml.sharedStrings+xml")
                self.pkg.add_rel(self.wb, "sharedStrings", part)
            self._sst = (part, self.pkg.xml(part))
        return self._sst

    def sst_items(self) -> list:
        return _ox_kids(self.sst()[1].documentElement, None, "si")

    def sst_text(self, idx: int) -> str:
        items = self.sst_items()
        return _ox_par_text(items[idx], "x") if 0 <= idx < len(items) else ""

    def sst_add(self, text: str = "", node=None) -> int:
        part, doc = self.sst()
        root = doc.documentElement
        items = self.sst_items()
        if node is None:
            if self._sst_index is None:
                self._sst_index = {}
                for i, si in enumerate(items):
                    kids = _ox_kids(si)
                    if len(kids) == 1 and kids[0].localName == "t":
                        self._sst_index.setdefault(_ox_par_text(si, "x"), i)
            if text in self._sst_index:
                self._sst_bump(root, len(items), 1)
                return self._sst_index[text]
            node = _ox_new(doc, root, "si")
            t = _ox_new(doc, root, "t")
            if text != text.strip() or "\n" in text:
                t.setAttribute("xml:space", "preserve")
            t.appendChild(doc.createTextNode(text))
            node.appendChild(t)
        ext = _ox_kid(root, None, "extLst")
        root.insertBefore(node, ext)
        idx = len(items)
        if self._sst_index is not None and text:
            self._sst_index.setdefault(text, idx)
        self._sst_bump(root, idx + 1, 1)
        return idx

    def _sst_bump(self, root, unique: int, refs: int) -> None:
        try:
            count = int(root.getAttribute("count") or 0) + refs
        except ValueError:
            count = unique
        root.setAttribute("count", str(max(count, unique)))
        root.setAttribute("uniqueCount", str(unique))
        self.pkg.touch(self.sst()[0])

    # arkusz
    def sheet_data(self, part: str):
        doc = self.pkg.xml(part)
        ws = doc.documentElement
        sd = _ox_kid(ws, None, "sheetData")
        if sd is None:
            raise _OfficeError(f"arkusz {part} nie ma sheetData")
        if part not in self.touched_sheets:   # brakujące r w wierszach i komórkach (dozwolone): uzupełniamy
            rn = 0
            for row in _ox_kids(sd, None, "row"):
                rn = int(row.getAttribute("r") or rn + 1)
                row.setAttribute("r", str(rn))
                cn = 0
                for c in _ox_kids(row, None, "c"):
                    cn = _xl_ref(c.getAttribute("r"))[0] if c.getAttribute("r") else cn + 1
                    c.setAttribute("r", f"{_xl_letters(cn)}{rn}")
            self.touched_sheets.add(part)
            self.pkg.touch(part)
        return doc, ws, sd

    def cell(self, part: str, col: int, row: int, create: bool = True):
        doc, ws, sd = self.sheet_data(part)
        rows = _ox_kids(sd, None, "row")
        r_el = next((x for x in rows if int(x.getAttribute("r")) == row), None)
        if r_el is None:
            if not create:
                return None
            r_el = _ox_new(doc, sd, "row")
            r_el.setAttribute("r", str(row))
            sd.insertBefore(r_el, next((x for x in rows if int(x.getAttribute("r")) > row), None))
        if r_el.hasAttribute("spans"):
            r_el.removeAttribute("spans")   # podpowiedź zakresu; po dopisaniu komórek byłaby nieaktualna
        ref = f"{_xl_letters(col)}{row}"
        cells = _ox_kids(r_el, None, "c")
        c_el = next((x for x in cells if x.getAttribute("r") == ref), None)
        if c_el is None and create:
            c_el = _ox_new(doc, sd, "c")
            c_el.setAttribute("r", ref)
            nxt = next((x for x in cells if _xl_ref(x.getAttribute("r"))[0] > col), None)
            r_el.insertBefore(c_el, nxt if nxt is not None else _ox_kid(r_el, None, "extLst"))
            style = r_el.getAttribute("s") if r_el.getAttribute("customFormat") in ("1", "true") else ""
            if style:
                c_el.setAttribute("s", style)
        return c_el

    def _expand_shared(self, part: str, master) -> None:
        """Formuła współdzielona, której wzorzec nadpisujemy: każda komórka grupy dostaje własną formułę."""
        f = _ox_kid(master, None, "f")
        si, base = f.getAttribute("si"), (f.firstChild.data if f.firstChild else "")
        mc, mr = _xl_ref(master.getAttribute("r"))
        _doc, _ws, sd = self.sheet_data(part)
        for c in _xl_cells(sd):
            g = _ox_kid(c, None, "f")
            if g is None or c is master or g.getAttribute("t") != "shared" or g.getAttribute("si") != si:
                continue
            cc, cr = _xl_ref(c.getAttribute("r"))
            while g.firstChild:
                g.removeChild(g.firstChild)
            g.appendChild(c.ownerDocument.createTextNode(_xl_shift_formula(base, cr - mr, cc - mc)))
            for at in ("t", "si", "ref"):
                if g.hasAttribute(at):
                    g.removeAttribute(at)

    def set(self, part: str, col: int, row: int, value) -> None:
        c = self.cell(part, col, row)
        doc = c.ownerDocument
        f = _ox_kid(c, None, "f")
        if f is not None and f.getAttribute("t") == "shared" and f.getAttribute("ref"):
            self._expand_shared(part, c)
        if f is not None and f.getAttribute("t") == "array" and ":" in (f.getAttribute("ref") or ""):
            raise _OfficeError(f"{c.getAttribute('r')} zaczyna formułę tablicową {f.getAttribute('ref')}; "
                               "zmień ją w Excelu")
        for k in list(c.childNodes):
            if not (k.nodeType == 1 and k.localName == "extLst"):
                c.removeChild(k)
        for at in ("t", "cm", "vm"):   # typ i metadane starej wartości (np. obraz w komórce)
            if c.hasAttribute(at):
                c.removeAttribute(at)

        def add(local, text):
            el = _ox_new(doc, c, local)
            el.appendChild(doc.createTextNode(text))
            c.insertBefore(el, _ox_kid(c, None, "extLst"))
            return el
        if value is None or value == "":
            pass
        elif isinstance(value, bool):
            c.setAttribute("t", "b")
            add("v", "1" if value else "0")
        elif isinstance(value, (int, float)):
            if value != value or value in (float("inf"), float("-inf")):
                raise _OfficeError("wartość nie jest liczbą skończoną")
            add("v", str(int(value)) if isinstance(value, int) or float(value).is_integer() and abs(value) < 1e15
                else repr(float(value)))
        else:
            s = str(value)
            if s.startswith("=") and len(s) > 1:
                add("f", s[1:])
            elif re.fullmatch(r"-?(0|[1-9]\d{0,14})(\.\d+)?", s):
                add("v", s)
            else:
                if s.startswith("'"):
                    s = s[1:]
                c.setAttribute("t", "s")
                add("v", str(self.sst_add(s)))
        self._dimension(part, col, row)
        self._table_header(part, col, row, value)
        self.pkg.touch(part)

    def _dimension(self, part: str, col: int, row: int) -> None:
        ws = self.pkg.xml(part).documentElement
        dim = _ox_kid(ws, None, "dimension")
        if dim is None:
            return
        ref = dim.getAttribute("ref") or "A1"
        try:
            a, _, b = ref.partition(":")
            c1, r1 = _xl_ref(a)
            c2, r2 = _xl_ref(b) if b else (c1, r1)
        except _OfficeError:
            return
        c1, r1, c2, r2 = min(c1, col), min(r1, row), max(c2, col), max(r2, row)
        dim.setAttribute("ref", f"{_xl_letters(c1)}{r1}" + (f":{_xl_letters(c2)}{r2}" if (c1, r1) != (c2, r2) else ""))

    def tables(self, part: str) -> list:
        return [t for t in self.pkg.rels_of_type(part, "table") if self.pkg.has(t)]

    def _table_header(self, part: str, col: int, row: int, value) -> None:
        """Nagłówek tabeli Excela musi się zgadzać z nazwą kolumny w xl/tables (inaczej Excel „naprawia” plik)."""
        for tp in self.tables(part):
            root = self.pkg.xml(tp).documentElement
            try:
                a, _, b = root.getAttribute("ref").partition(":")
                (c1, r1), (c2, _r2) = _xl_ref(a), _xl_ref(b or a)
            except _OfficeError:
                continue
            if root.getAttribute("headerRowCount") == "0" or row != r1 or not c1 <= col <= c2:
                continue
            cols = root.getElementsByTagNameNS(root.namespaceURI, "tableColumn")
            if col - c1 < len(cols):
                name = "" if value is None else str(value).lstrip("=")
                cols[col - c1].setAttribute("name", name or f"Kolumna{col - c1 + 1}")
                self.pkg.touch(tp)

    def last_row(self, part: str) -> int:
        _doc, _ws, sd = self.sheet_data(part)
        rows = [int(r.getAttribute("r")) for r in _ox_kids(sd, None, "row")
                if any(_ox_kids(c) for c in _ox_kids(r, None, "c"))]
        return max(rows) if rows else 0

    def recalc(self) -> None:
        """Po zmianie komórek: Excel i LibreOffice przeliczą formuły przy otwarciu; stary łańcuch obliczeń znika."""
        if not self.touched_sheets:
            return
        for cc in self.pkg.rels_of_type(self.wb, "calcChain"):
            self.pkg.drop_rel(self.wb, cc)
            self.pkg.remove(cc)
        root = self.doc.documentElement
        calc = _ox_kid(root, None, "calcPr")
        if calc is None:
            calc = _ox_new(self.doc, root, "calcPr")
            after = ("oleSize", "customWorkbookViews", "pivotCaches", "smartTagPr", "smartTagTypes",
                     "webPublishing", "fileRecoveryPr", "webPublishObjects", "extLst")
            ref = next((k for k in _ox_kids(root) if k.localName in after), None)
            root.insertBefore(calc, ref)
        calc.setAttribute("fullCalcOnLoad", "1")
        self.pkg.touch(self.wb)


def _xl_values_arg(a: dict):
    vals = a.get("values")
    if vals is None and "value" in a:
        return [[a.get("value")]]
    if vals is None and a.get("text") is not None:
        return [[a.get("text")]]
    if not isinstance(vals, list):
        return [[vals]]
    if vals and not any(isinstance(v, list) for v in vals):
        return [vals]
    return [v if isinstance(v, list) else [v] for v in vals]


def _xlsx_set(pkg, a: dict, book) -> str:
    name, part = book.sheet(a.get("sheet"))
    ref = str(a.get("cell") or a.get("range") or "").strip()
    if not ref:
        raise _OfficeError("podaj cell (np. B2) albo range (np. A1:C3)")
    first, _, last = ref.partition(":")
    c1, r1 = _xl_ref(first)
    vals = _xl_values_arg(a)
    if last:
        c2, r2 = _xl_ref(last)
        h, w = r2 - r1 + 1, c2 - c1 + 1
        if h < 1 or w < 1:
            raise _OfficeError(f"zakres {ref} jest odwrócony; podaj lewy górny róg pierwszy")
        if len(vals) == 1 and len(vals[0]) == 1:
            vals = [[vals[0][0]] * w for _ in range(h)]   # jedna wartość do całego zakresu
        elif len(vals) != h or any(len(v) != w for v in vals):
            raise _OfficeError(f"zakres {ref} ma {h}×{w} komórek, a values ma {len(vals)} wierszy")
    if sum(len(v) for v in vals) > 200_000:
        raise _OfficeError("za dużo komórek naraz (limit 200 tys.)")
    n = 0
    for i, rowv in enumerate(vals):
        for j, v in enumerate(rowv):
            book.set(part, c1 + j, r1 + i, v)
            n += 1
    end = f"{_xl_letters(c1 + max(len(v) for v in vals) - 1)}{r1 + len(vals) - 1}"
    where = first.upper() if n == 1 else f"{first.upper()}:{end}"
    return f"arkusz {name}: {where} ({n} kom.)"


def _xlsx_add_row(pkg, a: dict, book) -> str:
    name, part = book.sheet(a.get("sheet"))
    vals = _xl_values_arg(a)
    last = book.last_row(part)
    try:
        row = int(a.get("row") or last + 1)
    except (TypeError, ValueError):
        raise _OfficeError("row to numer wiersza od 1") from None
    if row < 1:
        raise _OfficeError("row to numer wiersza od 1")
    _doc, _ws, sd = book.sheet_data(part)
    r_el = next((x for x in _ox_kids(sd, None, "row") if int(x.getAttribute("r")) == row), None)
    if r_el is not None and any(_ox_kids(c) for c in _ox_kids(r_el, None, "c")):
        raise _OfficeError(f"wiersz {row} arkusza {name} nie jest pusty; bez row nowy wiersz trafia na koniec, "
                           "a istniejące komórki zmienia set_cell")
    colarg = str(a.get("col") or "A").strip()
    col0 = int(colarg) if colarg.isdigit() else _xl_ref(f"{colarg}1")[0]
    styles = {}
    if row > 1:   # styl komórek z wiersza powyżej (formaty liczb, dat, obramowania)
        _doc, _ws, sd = book.sheet_data(part)
        above = next((x for x in _ox_kids(sd, None, "row") if int(x.getAttribute("r")) == row - 1), None)
        if above is not None:
            styles = {_xl_ref(c.getAttribute("r"))[0]: c.getAttribute("s") for c in _ox_kids(above, None, "c")
                      if c.getAttribute("s")}
    n = 0
    for rowv in vals:
        for j, v in enumerate(rowv):
            c = book.cell(part, col0 + j, row)
            if styles.get(col0 + j) and not c.getAttribute("s"):
                c.setAttribute("s", styles[col0 + j])
            book.set(part, col0 + j, row, v)
            n += 1
        # tabela Excela kończąca się tuż nad nowym wierszem rośnie o ten wiersz
        for tp in book.tables(part):
            root = pkg.xml(tp).documentElement
            try:
                ta, _, tb = root.getAttribute("ref").partition(":")
                (tc1, tr1), (tc2, tr2) = _xl_ref(ta), _xl_ref(tb or ta)
            except _OfficeError:
                continue
            if tr2 == row - 1 and root.getAttribute("totalsRowCount") in ("", "0") and tc1 <= col0 <= tc2:
                new_ref = f"{_xl_letters(tc1)}{tr1}:{_xl_letters(tc2)}{row}"
                root.setAttribute("ref", new_ref)
                af = _ox_kid(root, None, "autoFilter")
                if af is not None:
                    af.setAttribute("ref", new_ref)
                pkg.touch(tp)
        row += 1
    return f"arkusz {name}: nowy wiersz {row - len(vals)}" + (f"…{row - 1}" if len(vals) > 1 else "") + f" ({n} kom.)"


def _xlsx_add_sheet(pkg, a: dict, book) -> str:
    name = str(a.get("name") or a.get("sheet") or "").strip()
    if not name:
        raise _OfficeError("podaj name nowego arkusza")
    if len(name) > 31 or re.search(r"[\[\]:*?/\\]", name) or name.startswith("'") or name.endswith("'"):
        raise _OfficeError("nazwa arkusza: do 31 znaków, bez [ ] : * ? / \\ i apostrofu na brzegach")
    if any(nm.lower() == name.lower() for nm, _p, _e in book.sheets()):
        raise _OfficeError(f"arkusz „{name}” już jest")
    part = pkg.fresh_name("xl/worksheets/sheet{n}.xml")
    pkg.put(part, f'<?xml version="1.0" encoding="UTF-8" standalone="yes"?>\n<worksheet xmlns="{_OX_S}" '
                  f'xmlns:r="{_OX_R}"><dimension ref="A1"/><sheetViews><sheetView workbookViewId="0"/></sheetViews>'
                  '<sheetFormatPr defaultRowHeight="15"/><sheetData/><pageMargins left="0.7" right="0.7" '
                  'top="0.75" bottom="0.75" header="0.3" footer="0.3"/></worksheet>',
            _OX_CT + "spreadsheetml.worksheet+xml")
    rid = book.pkg.add_rel(book.wb, "worksheet", part)
    root = book.doc.documentElement
    sheets = _ox_kid(root, None, "sheets")
    ids = [int(e.getAttribute("sheetId") or 0) for _n, _p, e in book.sheets()]
    el = _ox_new(book.doc, sheets, "sheet")
    el.setAttribute("name", name)
    el.setAttribute("sheetId", str(max(ids + [0]) + 1))
    prefix = next((root.attributes.item(i).localName for i in range(root.attributes.length)
                   if root.attributes.item(i).value == _OX_R and root.attributes.item(i).prefix == "xmlns"), None)
    if not prefix:
        root.setAttribute("xmlns:r", _OX_R)
        prefix = "r"
    el.setAttributeNS(_OX_R, f"{prefix}:id", rid)
    sheets.appendChild(el)
    pkg.touch(book.wb)
    out = f"nowy arkusz {name}"
    if a.get("values") is not None:
        out += "; " + _xlsx_set(pkg, {"sheet": name, "cell": "A1", "values": a["values"]}, book)
    else:
        book.sheet_data(part)
    return out


def _xlsx_replace(pkg, a: dict, book) -> str:
    find, repl = str(a.get("find") or ""), str(a.get("replace") if a.get("replace") is not None else "")
    if not find:
        raise _OfficeError("podaj find i replace")
    targets = [book.sheet(a["sheet"])] if a.get("sheet") else [(n, p) for n, p, _e in book.sheets() if p]
    hits = []   # (arkusz, część, komórka, węzeł z tekstem, liczba)
    for name, part in targets:
        _doc, _ws, sd = book.sheet_data(part)
        for c in _xl_cells(sd):
            t = c.getAttribute("t")
            if t == "s":
                v = _ox_kid(c, None, "v")
                try:
                    idx = int(v.firstChild.data) if v is not None and v.firstChild else -1
                except ValueError:
                    continue
                k = len(_ox_find(book.sst_text(idx), find))
                if k:
                    hits.append((name, part, c, idx, k))
            elif t == "inlineStr":
                is_ = _ox_kid(c, None, "is")
                k = len(_ox_find(_ox_par_text(is_, "x"), find)) if is_ is not None else 0
                if k:
                    hits.append((name, part, c, is_, k))
    total = sum(h[4] for h in hits)
    if not total:
        raise _OfficeError(f"nie znaleziono „{find}” w tekstach komórek"
                           + (f" arkusza {targets[0][0]}" if a.get("sheet") else "")
                           + " (formuł i liczb replace nie zmienia; do nich set_cell)")
    if total > 1 and not a.get("all"):
        raise _OfficeError(f"„{find}” występuje {total}× (" + ", ".join(f"{h[0]}!{h[2].getAttribute('r')}"
                                                                     for h in hits[:8])
                           + "). Podaj sheet/dłuższy tekst albo all=true")
    n = 0
    items = book.sst_items()
    for name, part, c, ref, _k in hits:
        node = items[ref].cloneNode(True) if isinstance(ref, int) else ref
        for i in sorted(_ox_find(_ox_par_text(node, "x"), find), reverse=True):
            if _ox_replace_at(node, "x", i, i + len(find), repl):
                n += 1
        if isinstance(ref, int):
            v = _ox_kid(c, None, "v")
            v.firstChild.data = str(book.sst_add(node=node))
        col, row = _xl_ref(c.getAttribute("r"))
        book._table_header(part, col, row, _ox_par_text(node, "x"))
        pkg.touch(part)
    return f"zamiana {n}× w {len(hits)} kom."


