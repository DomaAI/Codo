def fetch_models() -> tuple[list, str | None]:
    """Fresh account-specific catalog; never fall back to the public legacy list."""
    if provider() == "endpoint":
        models = _endpoint_models()
        ep = load_endpoint() or {}
        default = f"@{ep['id']}/{ep['model']}" if ep.get("model") else (models[0][0] if models else None)
        return models + agent_models(), default
    if provider() == "agent":
        models = agent_models()
        return models, (models[0][0] if models else None)
    if provider() == "maddlabs":
        models = _maddlabs_models()
        ready = [m for m in models if m[3]] or models
        return [m[:3] for m in models] + _endpoint_models() + agent_models(), (ready[0][0] if ready else None)
    try:
        info = api_call(load_creds(), "/cli/models", {}, method="GET")
        _models_cache_put("domaai", info)
    except (ApiError, urllib.error.URLError, TimeoutError, OSError) as exc:
        # Bez sieci albo serwer chwilowo nie odpowiada: ostatnia znana lista z dysku, a obok wszystko,
        # co działa lokalnie (agenci z tego komputera, własne konta, Ollama, LM Studio).
        if isinstance(exc, ApiError) and exc.status in (401, 403):
            raise
        info = _models_cache_get("domaai")
        local = _endpoint_models() + agent_models()
        if info is None and not local:
            raise
        info = info or {}
    models = info.get("models") or []
    return [(m["id"], (m.get("label") or m["id"]) + (_L(" · bez narzędzi") if m.get("supports_tools") is False else ""),
             m.get("min_plan") or "free") for m in models] + _endpoint_models() + agent_models(), info.get("default_model")


# ── Praca bez sieci i zmiana mózgu w trakcie rozmowy ─────────────────────────
# Lista modeli zostaje na dysku (ostatnia udana), więc wybór działa też offline. Każdy mózg z własną
# pamięcią rozmowy (Lopus na serwerze, Codex, Claude Code, Gemini w swoich sesjach) dostaje przy
# kolejnej turze to, co w międzyczasie powiedziały inne mózgi, a nie tylko ostatnie polecenie.
_MODELS_CACHE = CONFIG_DIR / "modele-cache.json"
_ONLINE = {"at": 0.0, "ok": True}


def _models_cache_put(key: str, data) -> None:
    try:
        all_ = json.loads(_MODELS_CACHE.read_text(encoding="utf-8")) if _MODELS_CACHE.exists() else {}
    except (OSError, ValueError):
        all_ = {}
    all_[key] = data
    try:
        CONFIG_DIR.mkdir(parents=True, exist_ok=True)
        tmp = _MODELS_CACHE.with_suffix(".tmp")
        tmp.write_text(json.dumps(all_, ensure_ascii=False), encoding="utf-8")
        os.replace(tmp, _MODELS_CACHE)
    except OSError:
        pass


def _models_cache_get(key: str):
    try:
        return json.loads(_MODELS_CACHE.read_text(encoding="utf-8")).get(key)
    except (OSError, ValueError, AttributeError):
        return None


def online(force: bool = False) -> bool:
    """Czy jest internet (szybkie połączenie TCP z serwerem Codo, wynik ważny 20 s)."""
    import socket
    import time as _t
    now = _t.monotonic()
    if not force and now - _ONLINE["at"] < 20:
        return _ONLINE["ok"]
    if os.environ.get("CODO_OFFLINE") or os.environ.get("CODO_ONLINE"):
        ok = not os.environ.get("CODO_OFFLINE")
    else:
        # Serwer Codo albo dowolny internet (agenci z tego komputera działają też, gdy nasz serwer leży).
        u = urllib.parse.urlparse(API_URL)
        targets = [(u.hostname or "bymadd.pl", u.port or (443 if API_URL.startswith("https") else 80)),
                   ("1.1.1.1", 443)]
        ok = False
        # Druga, dłuższa próba: jedna nieudana w 1,5 s (start procesu, chwilowy zator) kończyła turę
        # komunikatem „Brak internetu”, choć sieć działała (21.11.2026).
        why = []
        for limit in (1.5, 4.0):
            for host, port in targets:
                try:
                    socket.create_connection((host, port), timeout=limit).close()
                    ok = True
                    break
                except OSError as exc:
                    why.append(f"{host}:{port} {type(exc).__name__}: {exc}")
                    continue
            if ok:
                break
        if not ok and sys.platform == "darwin":
            # Próby połączenia z tego procesu bywają fałszywie negatywne (21.11.2026: tura stałego agenta
            # kończyła się „Brak internetu” przy działającej sieci). Drugie zdanie ma system: gdy mówi, że
            # sieć jest osiągalna, pracujemy dalej, a prawdziwy brak sieci pokaże sama tura.
            try:
                import subprocess
                r = subprocess.run(["/usr/sbin/scutil", "-r", "1.1.1.1"], capture_output=True, text=True, timeout=3)
                ok = r.returncode == 0 and "Reachable" in r.stdout and "Not Reachable" not in r.stdout
            except (OSError, subprocess.SubprocessError):
                pass
        if why:
            # do logu silnika: co zawiodło przy sprawdzaniu sieci
            print(dim("  (sprawdzenie sieci: " + "; ".join(why[-2:]) + (" → system: sieć jest" if ok else "") + ")"),
                  file=sys.stderr)
    _ONLINE.update(at=now, ok=ok)
    return ok


def _is_local_url(url: str) -> bool:
    host = (urllib.parse.urlparse(str(url or "")).hostname or "").lower()
    return host in ("localhost", "127.0.0.1", "::1", "0.0.0.0") or host.endswith(".local")


