# Własne komendy: .codo/commands/NAZWA.md w projekcie i ~/.config/doma/commands/NAZWA.md
_USER_CMD_DIRS = (lambda: Path.cwd() / ".codo" / "commands", lambda: CONFIG_DIR / "commands")


def _user_commands() -> dict:
    """{"/nazwa": {"path", "description", "body", "scope"}}; projekt wygrywa z globalnymi,
    wbudowane komendy wygrywają ze wszystkimi."""
    found = {}
    for scope, getter in zip((_L("projekt"), "globalna"), _USER_CMD_DIRS):
        try:
            files = sorted(getter().glob("*.md"))
        except OSError:
            continue
        for path in files:
            name = "/" + re.sub(r"[^a-z0-9_-]", "-", path.stem.lower())
            if name in found or name in _SLASH:
                continue
            try:
                text = path.read_text(encoding="utf-8", errors="replace")
            except OSError:
                continue
            desc = ""
            if text.startswith("---"):
                end = text.find("\n---", 3)
                if end > 0:
                    for line in text[3:end].splitlines():
                        k, _, v = line.partition(":")
                        if k.strip().lower() in ("description", "opis"):
                            desc = v.strip().strip("\"'")
                    text = text[end + 4:].lstrip("\n")
            if not desc:
                first = next((ln.strip("# ").strip() for ln in text.splitlines() if ln.strip()), "")
                desc = first[:60]
            found[name] = {"path": path, "description": desc or "własna komenda", "body": text, "scope": scope}
    return found


def _user_command_prompt(body: str, arg: str) -> str:
    if "$ARGUMENTS" in body:
        return body.replace("$ARGUMENTS", arg)
    return body + (f"\n\n{arg}" if arg else "")


