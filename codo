def _team_say(store, to, text, task_id="", reply_to="", by="human") -> str:
    """Wiadomość od człowieka; odpowiedź autorowi pytania (team_question) zamyka jego pytania."""
    msg, err = store.send("human", to or "lead", text, task_id or "")
