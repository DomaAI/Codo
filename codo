    def log(self, aid: str, role: str, text: str, src: str = "") -> None:
        import time
        item = {"t": round(time.time(), 1), "role": role, "text": str(text)[:20000], "src": src}
        try:
            (HOST_DIR / "rozmowy").mkdir(parents=True, exist_ok=True)
            with open(HOST_DIR / "rozmowy" / f"{aid}.jsonl", "a", encoding="utf-8") as f:
                f.write(json.dumps(item, ensure_ascii=False) + "\n")
        except OSError:
            pass
        self.push({"ev": "item", "agent": aid, **item})

    # 23.11.2026 Log-Bot: pełny dziennik pracy agenta (co dostał, co myślał, narzędzia, zgody, koniec tury)
    _TRACE_KINDS = ("thinking", "assistant", "tool_start", "tool", "tool_result", "ask", "ask_done", "error",
                    "info", "fallback", "turn_start", "turn_end", "context")
    _TRACE_MAX = 20 * 1024 * 1024

    def trace(self, aid: str, ev: dict) -> None:
        import time
        t = ev.get("type")
        if not str(t).startswith("_") and t not in self._TRACE_KINDS:
            return
        if t == "info" and not ev.get("blad") and not ev.get("tekst"):
            return
        e = {}
        for k, v in ev.items():
            if k in ("diff", "opcje", "messages"):
                continue
            e[k] = _log_clip(v) if isinstance(v, str) else v
        path = HOST_DIR / "dziennik" / f"{aid}.jsonl"
        try:
            path.parent.mkdir(parents=True, exist_ok=True)
            with open(path, "a", encoding="utf-8") as f:
                f.write(json.dumps({"t": round(time.time(), 3), "e": e}, ensure_ascii=False, default=str) + "\n")
            if path.stat().st_size > self._TRACE_MAX:
                # najstarsza połowa i wpisy sprzed 30 dni odpadają
                keep, cut = [], time.time() - 30 * 86400
                lines = path.read_text(encoding="utf-8").splitlines()
                for ln in lines[len(lines) // 2:]:
                    try:
                        if json.loads(ln).get("t", 0) >= cut:
                            keep.append(ln)
                    except ValueError:
                        continue
                path.write_text("\n".join(keep) + "\n", encoding="utf-8")
        except OSError:
            pass

    def trace_since(self, aid: str, since: float = 0.0, limit: int = 3000) -> list:
        try:
            lines = (HOST_DIR / "dziennik" / f"{aid}.jsonl").read_text(encoding="utf-8").splitlines()
        except OSError:
            return []
        out = []
        for ln in reversed(lines):
            try:
                it = json.loads(ln)
            except ValueError:
                continue
            if float(it.get("t") or 0) <= since:
                break
            out.append(it)
            if len(out) >= limit:
                break
        out.reverse()
        return out

    def history(self, aid: str, limit: int = 200) -> list:
        try:
            lines = (HOST_DIR / "rozmowy" / f"{aid}.jsonl").read_text(encoding="utf-8").splitlines()
        except OSError:
            return []
        out = []
        for ln in lines[-limit:]:
            try:
                out.append(json.loads(ln))
            except ValueError:
                continue
        return out

    # ── kto jest kim ──
    def find(self, raw, than: str | None = None):
        name = str(raw or "").strip(" @«»\n").lower()
        if not name:
            return None
        if name in self.agents and name != than:
            return self.agents[name]
        cands = [self.agents[i] for i in self.order if i != than]
        return next((a for a in cands if a["name"].lower() == name), None) \
            or next((a for a in cands if a["name"].lower().startswith(name)), None)

