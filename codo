def t_upload_image(args):
    """Zapisuje przesłany obraz (base64) na serwerze — jail safe-roots + tylko
    rozszerzenia obrazów, z kopią zapasową gdy nadpisujemy."""
    try:
        path = _panel_img_path(args["path"])
    except ValueError as e:
        return f"BŁĄD: {e}"
    import base64
    try:
        data = base64.b64decode(args.get("content_b64") or "")
    except Exception as e:
        return f"BŁĄD: nieprawidłowe dane obrazu ({e})."
    if not data:
        return "BŁĄD: pusty plik."
    if len(data) > _MAX_EDIT_BYTES:
        return f"BŁĄD: obraz za duży (>{_MAX_EDIT_BYTES // 1000}k bajtów) — zmniejsz go."
    existed = path.is_file()
    inside = _in_project(path)
    if existed:
        try:
            _backup(path) if inside else _panel_backup(path)
        except OSError as e:
