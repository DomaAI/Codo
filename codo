def _keep_shebang(target: Path, data: bytes) -> bytes:
    """Instalator wpisuje do pierwszej linii ścieżkę interpretera, gdy `python3` z PATH
    się nie nadaje (brak albo za stary). Aktualizacja tę linię zachowuje, inaczej nowa
    wersja wróciłaby do `env python3` i przestała się uruchamiać."""
    try:
        with open(target, "rb") as f:
            first = f.readline(400)
    except OSError:
        return data
    if not first.startswith(b"#!") or not first.endswith(b"\n") or b"/env " in first:
        return data
    interp = first[2:].strip().split(b" ")[0]
    if not interp or not os.path.exists(os.fsdecode(interp)) or not data.startswith(b"#!"):
        return data
    return first + data.split(b"\n", 1)[1]


def self_update(force: bool = False) -> int:
    """Pobiera najnowsze CLI z serwera, sprawdza SHA-256 i podmienia ten plik."""
    import hashlib
    if FROZEN:
        print(dim(_Lf('Sprawdzam {0} …', f"{API_URL}/static/codo/cli/")))
        try:
            data, _v = _fetch_update()
            if not data:
                print(green(_Lf('✓ Masz najnowszą wersję ({0}).', VERSION)))
                return 0
            _install_update(data)
        except Exception as e:  # noqa: BLE001
            print(red(_L("✗ Pobieranie nie powiodło się: ")) + describe_error(e))
            return 1
        print(green(_L("✓ Zaktualizowano. Nowa wersja działa od następnego uruchomienia.")))
        return 0
    target = Path(_self_path())
    print(dim(_Lf('Sprawdzam {0}/cli/doma …', API_URL)))
    try:
        req = urllib.request.Request(f"{API_URL}/cli/doma",
                                     headers={"User-Agent": f"doma-cli/{VERSION}"})
        with urllib.request.urlopen(req, timeout=60, context=_ssl_ctx()) as resp:  # nosec B310 — stały https API_URL
            data = resp.read()
        req = urllib.request.Request(f"{API_URL}/cli/doma.sha256",
                                     headers={"User-Agent": f"doma-cli/{VERSION}"})
        with urllib.request.urlopen(req, timeout=20, context=_ssl_ctx()) as resp:  # nosec B310
            expected = resp.read().decode().strip()[:64]
    except Exception as e:  # noqa: BLE001
        print(red(_L("✗ Pobieranie nie powiodło się: ")) + describe_error(e))
        return 1
    if b"doma" not in data[:400] or hashlib.sha256(data).hexdigest() != expected:
        print(red(_L("✗ Pobrany plik nie przeszedł weryfikacji (SHA-256). Nic nie zmieniono.")))
        return 1
    m = re.search(rb'^VERSION = "([^"]+)"', data, re.M)
    new_ver = m.group(1).decode() if m else "?"
    if new_ver == VERSION and not force:
        print(green(_Lf('✓ Masz najnowszą wersję ({0}).', VERSION)))
        return 0
    if m and _ver_tuple(new_ver) < _ver_tuple(VERSION) and not force:
        print(green(_Lf('✓ Masz nowszą wersję ({0}) niż serwer ({1}).', VERSION, new_ver))
              + dim(_L(" Cofnięcie: codo update --force")))
        return 0
    tmp = target.with_name(target.name + ".new")
    try:
        tmp.write_bytes(_keep_shebang(target, data))
        if not IS_WIN:
            os.chmod(tmp, 0o755)
        os.replace(tmp, target)
    except OSError as e:
        tmp.unlink(missing_ok=True)
        print(red(_Lf('✗ Nie mogę podmienić {0}: {1}', target, e)))
        print(dim(_L("  Zainstaluj ponownie: curl -fsSL https://bymadd.pl/install.sh | bash")))
        return 1
    st = load_settings()
    st.update(latest_version=new_ver)
    save_settings(st)
    print(green(_Lf('✓ Zaktualizowano: {0} → {1}', VERSION, new_ver)))
    links = _links_load()
    if links:
        print(dim(_L("  Mostki z autostartem przejdą na nową wersję po restarcie usługi"
                  " (albo: codo unlink && codo link w danym folderze).")))
    return 0



# ── Aktualizacje same (0.29.2) ───────────────────────────────────────────────────────────
# Raz na dobę Codo sprawdza /cli/info; gdy jest nowsza wersja, w tle pobiera ją, sprawdza
# SHA-256 i podmienia siebie. Działa dla skryptu (codo.py, ~/.local/bin/codo) i dla pojedynczego
# pliku (codo.exe, codo-linux-x64, codo-macos-*), który pobiera swój własny plik z SHA256SUMS.
# Nowa wersja rusza od następnego uruchomienia. Wyłączenie: codo update --auto off
# albo CODO_NO_AUTO_UPDATE=1. Aplikacja na Maca aktualizuje swój silnik sama, więc tu nie.

def _frozen_asset_name() -> str | None:
    import platform
    arm = platform.machine().lower() in ("arm64", "aarch64")
    if IS_WIN:
        return "codo-windows-x64.exe"
    if IS_MAC:
        return "codo-macos-arm64" if arm else "codo-macos-x64"
    if sys.platform.startswith("linux"):
        return "codo-linux-arm64" if arm else "codo-linux-x64"
    return None


def _update_target() -> Path:
    return Path(sys.executable if FROZEN else _self_path()).resolve()


def _auto_update_allowed() -> bool:
    if os.environ.get("CODO_NO_AUTO_UPDATE") or os.environ.get("CI"):
        return False
    if load_settings().get("auto_update") is False:
        return False
    t = _update_target()
    s = str(t).replace("\\", "/")
    if ".app/Contents/" in s or s.endswith("static/cli/doma") or "site-packages" in s:
        return False   # aplikacja na Maca, kopia robocza repozytorium, pakiet pip
    return os.access(t.parent, os.W_OK) and os.access(t, os.W_OK)


def _download(url: str, timeout: int = 120) -> bytes:
    req = urllib.request.Request(url, headers={"User-Agent": f"codo/{VERSION}"})
    with urllib.request.urlopen(req, timeout=timeout, context=_ssl_ctx()) as resp:  # nosec B310 — stały https API_URL
        return resp.read()


def _fetch_update() -> tuple:
    """(dane, wersja albo None) najnowszego Codo dla tej instalacji, sprawdzone SHA-256. Wyjątek przy błędzie."""
    import hashlib
    if FROZEN:
        name = _frozen_asset_name()
        if not name:
            raise RuntimeError("unsupported platform")
        sums = _download(f"{API_URL}/static/codo/cli/SHA256SUMS", 20).decode("utf-8", "replace")
        expected = next((ln.split()[0] for ln in sums.splitlines()
                         if len(ln.split()) == 2 and ln.split()[1].lstrip("*") == name), "")
        if len(expected) != 64:
            raise RuntimeError("no checksum for " + name)
        if hashlib.sha256(_update_target().read_bytes()).hexdigest() == expected:
            return b"", None   # ten sam plik: nic do zrobienia
        data = _download(f"{API_URL}/static/codo/cli/{name}", 300)
        if hashlib.sha256(data).hexdigest() != expected:
            raise RuntimeError("SHA-256")
        return data, None
    data = _download(f"{API_URL}/cli/doma", 60)
    expected = _download(f"{API_URL}/cli/doma.sha256", 20).decode().strip()[:64]
    if b"doma" not in data[:400] or hashlib.sha256(data).hexdigest() != expected:
        raise RuntimeError("SHA-256")
    m = re.search(rb'^VERSION = "([^"]+)"', data, re.M)
    return data, (m.group(1).decode() if m else None)


def _install_update(data: bytes) -> None:
    """Podmiana siebie. Windows nie pozwala nadpisać działającego .exe, ale pozwala zmienić mu nazwę."""
    target = _update_target()
    tmp = target.with_name(target.name + ".new")
    tmp.write_bytes(data if FROZEN else _keep_shebang(target, data))
    if not IS_WIN:
        os.chmod(tmp, 0o755)
    if IS_WIN and FROZEN:
        old = target.with_name(target.stem + ".old.exe")
        try:
            old.unlink(missing_ok=True)
        except OSError:
            old = target.with_name(f"{target.stem}.old-{os.getpid()}.exe")
        os.replace(target, old)
        try:
            os.replace(tmp, target)
        except OSError:
            os.replace(old, target)   # przywracamy działający plik
            raise
        return
    os.replace(tmp, target)


def _auto_update_worker(latest: str) -> None:
    try:
        data, ver = _fetch_update()
        if not data:
            return
        if ver and _ver_tuple(ver) <= _ver_tuple(VERSION):
            return
        _install_update(data)
        st = load_settings()
        st["auto_updated_to"] = ver or latest
        save_settings(st)
    except Exception:
        pass  # nosec B110 — aktualizacja w tle nigdy nie przerywa pracy; spróbuje jutro


def auto_update_start() -> None:
    """Na starcie: komunikat o aktualizacji z poprzedniego razu i (raz na dobę) aktualizacja w tle."""
    if IS_WIN and FROZEN:   # stary .exe odłożony przy poprzedniej aktualizacji
        for old in _update_target().parent.glob(_update_target().stem + ".old*.exe"):
            try:
                old.unlink()
            except OSError:
                pass  # nosec B110 — jeszcze działa, usuniemy następnym razem
    st = load_settings()
    done = st.pop("auto_updated_to", None)
    if done:
        save_settings(st)
        if _ver_tuple(done) <= _ver_tuple(VERSION) or FROZEN:
            print(green(_Lf("✓ Codo zaktualizowało się samo do wersji {0}.", done)))
    if not _auto_update_allowed():
        return
    newer = update_hint()
    if newer:
        threading.Thread(target=_auto_update_worker, args=(newer,), daemon=True).start()

def _tool_path(name: str) -> str | None:
    """Ścieżka programu albo None. Na macOS bez narzędzi wiersza poleceń /usr/bin/git
    to atrapa, która zamiast działać otwiera okno instalacji Xcode."""
    import shutil
    found = shutil.which(name)
    if found and IS_MAC and found.startswith("/usr/bin/"):
        try:
            if subprocess.run(["xcode-select", "-p"], capture_output=True, timeout=5).returncode != 0:
                return None
        except (OSError, subprocess.SubprocessError):
            pass  # nosec B110 — nie umiemy sprawdzić, przyjmujemy że działa
    return found


def _install_hint(pkg: str) -> str:
    """Polecenie instalacji pakietu dla tego systemu (do `codo doctor`)."""
    import shutil
    if IS_WIN:
        ids = {"git": "Git.Git", "ripgrep": "BurntSushi.ripgrep.MSVC"}
        return f"winget install -e --id {ids[pkg]}" if pkg in ids else ""
    if IS_MAC:
        if shutil.which("brew"):
            return "" if pkg == "ca-certificates" else f"brew install {pkg}"
        return {"git": "xcode-select --install", "ripgrep": "https://brew.sh → brew install ripgrep"}.get(pkg, "")
    sudo = "" if hasattr(os, "geteuid") and os.geteuid() == 0 else "sudo "
    for pm, cmd in (("apt-get", "apt-get install -y"), ("dnf", "dnf install -y"), ("yum", "yum install -y"),
                    ("pacman", "pacman -S --needed"), ("zypper", "zypper install"), ("apk", "apk add")):
        if shutil.which(pm):
            return f"{sudo}{cmd} {pkg}"
    return f"brew install {pkg}" if shutil.which("brew") else ""


def _ca_source() -> str:
    """Skąd Codo bierze certyfikaty TLS; pusty tekst = znikąd (HTTPS nie zadziała)."""
    import ssl
    if IS_WIN:
        return _L("magazyn systemu Windows")
    paths = ssl.get_default_verify_paths()
    for f in (os.environ.get("SSL_CERT_FILE"), paths.cafile, paths.openssl_cafile):
        if f and os.path.exists(f):
            return f
    if paths.capath and os.path.isdir(paths.capath) and os.listdir(paths.capath):
        return paths.capath
    for bundle in _CA_BUNDLES:
        if os.path.exists(bundle):
            return bundle
    try:
        import certifi  # noqa: F401 — sama obecność modułu wystarcza
        return "certifi"
    except Exception:
        pass  # nosec B110 — certifi to tylko jedna z dróg
    return _L("pęk kluczy macOS") if IS_MAC else ""


def doctor() -> int:
    import platform
    import shutil
    import time as _time
    ok_all = True

    def row(ok: bool | None, label: str, detail: str = "") -> None:
        nonlocal ok_all
        icon = green("✓") if ok else (yellow("!") if ok is None else red("✗"))
        if ok is False:
            ok_all = False
        print(f"  {icon} {label}" + (dim(f"  {detail}") if detail else ""))

    print(bold(_Lf('{0} {1} · diagnoza\n', APP_NAME, VERSION)))
    py_ok = sys.version_info >= (3, 9)
    row(py_ok, f"Python {platform.python_version()}", sys.executable if py_ok else _L("wymagany 3.9+"))
    row(True, f"System {platform.system()} {platform.release()}")
    t0 = _time.time()
    try:
        info = _http("GET", "/cli/info", timeout=8, retries=0)
        ms = int((_time.time() - t0) * 1000)
        row(True, _Lf('Połączenie z {0}', API_URL), f"{ms} ms")
        srv = info.get("version") or "?"
        if _ver_tuple(srv) > _ver_tuple(VERSION):
            row(None, _Lf('Wersja {0}, na serwerze {1}', VERSION, srv), "codo update")
        else:
            row(True, _Lf('Wersja aktualna ({0})', VERSION))
    except Exception as e:  # noqa: BLE001
        row(False, _Lf('Połączenie z {0}', API_URL),
            describe_error(e).replace(" Sprawdź internet albo uruchom: codo doctor", " Sprawdź internet."))
    dev = load_device()
    if dev:
        try:
            device_access_token(force=True)
            row(True, _L("Konto: urządzenie sparowane"), dev.get("name") or "")
        except SystemExit:
            row(False, _L("Konto: urządzenie odparowane"), "codo login")
        except Exception as e:  # noqa: BLE001
            row(False, _L("Konto: nie udało się potwierdzić urządzenia"), describe_error(e))
    elif load_creds():
        row(None, _L("Konto: stare logowanie hasłem"), "zalecane: codo logout && codo login")
    else:
        row(False, _L("Konto: niezalogowane"), "codo login")
    m = load_settings().get("model")
    row(True, "Model", m or _L("domyślny serwera"))
    bin_dir = str(Path(_self_path()).parent)
    on_path = any(Path(p).resolve() == Path(bin_dir).resolve()
                  for p in os.environ.get("PATH", "").split(os.pathsep) if p)
    row(on_path or None, "Komenda codo w PATH" if on_path else f"{bin_dir} poza PATH",
        "" if on_path else f'export PATH="{bin_dir}:$PATH"')
    try:
        CONFIG_DIR.mkdir(parents=True, exist_ok=True)
        probe = CONFIG_DIR / ".zapis"
        probe.write_text("ok")
        probe.unlink()
        row(True, "Konfiguracja", str(CONFIG_DIR))
    except OSError as e:
        row(False, _L("Konfiguracja nie do zapisu"), f"{CONFIG_DIR}: {e}")
    links = _links_load()
    for folder, meta in links.items():
        exists = Path(folder).is_dir()
        row(exists, _Lf('Stałe połączenie: {0}', folder),
            f"autostart {meta.get('autostart')}" if exists else _L("folder nie istnieje, codo unlink"))
    ca = _ca_source()
    row(bool(ca), _L("Certyfikaty TLS") if ca else _L("Brak certyfikatów TLS"),
        ca or _install_hint("ca-certificates"))
    for tool, pkg, why in (("git", "git", _L("zmiany w repozytorium, /diff")),
                           ("rg", "ripgrep", _L("szybkie szukanie w kodzie"))):
        if _tool_path(tool):
            row(True, pkg)
        else:
            row(None, _Lf('Brak {0} (zalecane: {1})', pkg, why), _install_hint(pkg))
    tools = [t for t in ("node", "npm", "ruff") if shutil.which(t)]
    if tools:
        row(True, _L("Narzędzia"), ", ".join(tools))
    print()
    print(green(_L("Wszystko działa.")) if ok_all else yellow(_L("Są problemy — szczegóły wyżej.")))
    return 0 if ok_all else 1


