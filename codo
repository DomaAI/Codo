    cwd, chats = Path.cwd().resolve(), _ui_chats_folder()
    seen: list = []
    for raw in [str(cwd)] + [str(x) for x in (load_settings().get("ui_folders") or []) if isinstance(x, str)]:
        if raw in seen or Path(raw) == chats or not Path(raw).is_dir():
            continue
        seen.append(raw)
