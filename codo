def _crash_log(exc: BaseException) -> str:
    """Ślad stosu do ~/.config/doma/crash.log (najwyżej ~200 kB), żeby błąd dało się zgłosić."""
    import time
    import traceback
    path = CONFIG_DIR / "crash.log"
    try:
        CONFIG_DIR.mkdir(parents=True, exist_ok=True)
        if path.exists() and path.stat().st_size > 200_000:
            path.write_text(path.read_text(encoding="utf-8", errors="replace")[-100_000:], encoding="utf-8")
        with path.open("a", encoding="utf-8") as f:
            f.write(f"\n=== {time.strftime('%Y-%m-%d %H:%M:%S')} Codo {VERSION} ===\n")
            f.write("".join(traceback.format_exception(type(exc), exc, exc.__traceback__)))
    except OSError:
        pass  # nosec B110
    return str(path)


def _hangup_as_interrupt() -> None:
    """Zamknięte okno terminala (SIGHUP) albo `kill` (SIGTERM): przerwanie jak Ctrl+C, więc rozmowa
    i historia poleceń się zapisują (do 0.28.0 proces ginął bez zapisu)."""
    import signal
    def handler(signum, frame):
        SESSION["signalled"] = True   # REPL po zapisie kończy pracę (nie wraca do pytania)
        raise KeyboardInterrupt
    for name in ("SIGHUP", "SIGTERM"):
        sig = getattr(signal, name, None)
        if sig is not None and threading.current_thread() is threading.main_thread():
            try:
                signal.signal(sig, handler)
            except (OSError, ValueError):
                pass  # nosec B110


