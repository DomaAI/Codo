_TEAM_APP: dict = {"tails": {}, "chat": set()}


def _team_say(store, to, text, task_id="", reply_to="", by="human") -> str:
    """Wiadomość od człowieka; odpowiedź autorowi pytania (team_question) zamyka jego pytania."""
    msg, err = store.send("human", to or "lead", text, task_id or "")
    if not err and (reply_to or any(q.get("from") == msg["to"] for q in store.load_run().get("pending_questions") or [])):
        store.control(type="answered", id=str(reply_to or ""), to=msg["to"], by=by)
    return err


def _team_diff(run_dir, member: str = "", task_id: str = "") -> dict:
    """team_diff: zmiany całości (base..integracja), członka (z niezatwierdzonymi w jego kopii) albo zadania."""
    store = TeamStore(run_dir)
    run = store.load_run()
    if not run.get("git"):
        return {"error": _L("Zespół pracuje bez gita, więc nie ma podglądu zmian.")}
    proj, integ = run["project"], run["integration_branch"]
    members = {m["id"]: m for m in run.get("members") or []}
    repo, rng, scope, untracked = proj, [run.get("base_sha") or "HEAD", integ], "all", False
    t = next((x for x in store.board()["tasks"] if x["id"] == task_id), None) if task_id else None
    if task_id and not t:
        return {"error": _Lf("Nie ma zadania {0}.", task_id)}
    use_member = bool(member)
    if t is not None:
        scope, merge, use_member = f"task:{task_id}", t.get("merge") or {}, False
        if merge.get("state") == "merged" and merge.get("sha"):
            rng = [merge["sha"] + "^1", merge["sha"]]
        elif t.get("commit"):
            rng = [f"{integ}...{t['commit']}"]
        elif t.get("claimed_by"):
            member, use_member = t["claimed_by"], True
        else:
            return {"error": _Lf("Zadanie {0} nie ma jeszcze zmian.", task_id)}
    elif member:
        scope = f"member:{member}"
    if use_member:
        m = members.get(member)
        if not m:
            return {"error": _Lf("Nie ma członka {0}.", member)}
        if m.get("isolation") == "copy":
            repo = m["worktree"]
            rng = [_git_in(repo, "merge-base", integ, "HEAD")[1] or integ]
            untracked = True
        else:
            repo, rng = run.get("integration_path") or proj, ["HEAD"]
    files: dict = {}
    for line in _git_in(repo, "diff", "--name-status", "-M", *rng)[1].splitlines():
        parts = line.split("\t")
        if len(parts) >= 2:
            files[parts[-1]] = {"path": parts[-1], "status": parts[0][:1], "added": 0, "removed": 0}
    for line in _git_in(repo, "diff", "--numstat", "-M", *rng)[1].splitlines():
        parts = line.split("\t")
        if len(parts) >= 3:
            path = parts[2].split(" => ")[-1].rstrip("}")
            f = files.setdefault(path, {"path": path, "status": "M", "added": 0, "removed": 0})
            f["added"] = int(parts[0]) if parts[0].isdigit() else 0
            f["removed"] = int(parts[1]) if parts[1].isdigit() else 0
    patch = _git_in(repo, "diff", "-M", *rng, timeout=120)[1]
    if untracked:
        for path in _git_in(repo, "ls-files", "--others", "--exclude-standard")[1].splitlines()[:200]:
            extra = _git_in(repo, "diff", "--no-index", "--", os.devnull, path)[1]
            added = sum(1 for x in extra.splitlines() if x.startswith("+") and not x.startswith("+++"))
            files[path] = {"path": path, "status": "A", "added": added, "removed": 0}
            patch += "\n" + extra
    limit = 200_000
    return {"scope": scope, "files": list(files.values())[:500], "patch": patch[:limit], "truncated": len(patch) > limit}


def _team_member_log(run_dir, member: str, since: int = 0) -> dict:
    store = TeamStore(run_dir)
    known = {m["id"] for m in store.load_run().get("members") or []}
    lines = store._lines(f"log/{member}.jsonl") if member in known else []
    since = max(0, int(since or 0))
    return {"member": member, "events": lines[since:][-2000:], "next": len(lines)}


def _team_tail(run_dir: Path, since: int, stop: threading.Event) -> None:
    """Zdarzenia przebiegu do okna: events.jsonl od since_seq, potem migawka team_state i live.jsonl na żywo."""
    import time
    store, rid = TeamStore(run_dir), Path(run_dir).name
    offs = {"events.jsonl": 0, "live.jsonl": 0}
    try:
        offs["live.jsonl"] = (Path(run_dir) / "live.jsonl").stat().st_size
    except OSError:
        pass
    first = True
    while not stop.is_set() and _APP["out"] is not None:
        for name in ("events.jsonl", "live.jsonl"):
            p = Path(run_dir) / name
            try:
                size = p.stat().st_size
                if size < offs[name]:
                    offs[name] = 0   # plik obcięty
                with open(p, "rb") as f:
                    f.seek(offs[name])
                    data = f.read()
            except OSError:
                continue
            end = data.rfind(b"\n") + 1
            offs[name] += end
            for raw in data[:end].splitlines():
                try:
                    ev = json.loads(raw.decode("utf-8", "replace"))
                except ValueError:
                    continue
                if not isinstance(ev, dict) or (name == "events.jsonl" and int(ev.get("seq") or 0) <= since):
                    continue
                _app_emit(str(ev.get("type")), **{k: v for k, v in ev.items() if k != "type"})
                if ev.get("type") == "team_done" and rid in _TEAM_APP["chat"]:
                    _TEAM_APP["chat"].discard(rid)
                    _APP["inbox"].append({"type": "_team_chat", "role": "assistant",
                                          "text": _Lf("Zespół zakończył pracę ({0}).", ev.get("status")) + "\n\n"
                                          + str(ev.get("summary") or "")})
                    _APP["wake"].set()
            if first and name == "events.jsonl":
                first = False
                st = store.state()
                _app_emit("team_state", **{k: v for k, v in st.items()})
        time.sleep(0.2)


def _team_workflow_node(node: dict, goal: str, wf: str, nid: str, index: int, total: int, title: str) -> dict:
    """Węzeł „team” workflowu: zespół w tym projekcie, czekanie na koniec, podsumowanie dla kolejnych kroków."""
    import time
    tpl, err = (node["team"], "") if isinstance(node.get("team"), dict) else _team_template_get(str(node.get("template") or "para"))
    if err:
        return {"error": err}
    over = {k: node.get(k) for k in ("budget_kr", "hours", "mode", "parallel")}
    run_dir, err = _team_create_run(Path.cwd(), goal, tpl, over, {"kind": "workflow", "workflow": wf, "node": nid})
    if err:
        return {"error": err}
    rid, store = run_dir.name, TeamStore(run_dir)
    _team_tail_start(run_dir, 0)
    _team_spawn_supervisor(run_dir)
    _app_emit("workflow", name=wf, node=nid, index=index, total=total, title=title, node_kind="team", state="running",
              run_id=rid, prompt=goal)
    _APP["cancel"] = False
    while True:
        time.sleep(0.5)
        run = store.load_run()
        if _APP.get("cancel") or _APP["out"] is None:
            store.control(type="stop", by="workflow")
            return {"error": _L("Zatrzymano."), "run_id": rid}
        if run.get("status") == "paused":
            return {"error": _L("Zespół wstrzymany."), "run_id": rid}
        if run.get("status") in _TEAM_RUN_END:
            break
    summary = str(run.get("summary") or "").strip()
    if run.get("status") not in ("review_final", "done", "applied"):
        return {"error": _Lf("Zespół skończył ze stanem {0}.", run.get("status")) + (" " + summary[:400] if summary else ""),
                "run_id": rid}
    if node.get("apply") and run.get("status") == "review_final":
        ev = team_apply(run_dir, "merge", by="workflow")
        summary += "\n\n" + str(ev.get("detail") or "")
    return {"run_id": rid, "summary": summary or _L("Zespół skończył bez podsumowania.")}


def _team_tail_start(run_dir: Path, since: int = 0) -> None:
    rid = Path(run_dir).name
    old = _TEAM_APP["tails"].get(rid)
    if old:
        old.set()
    stop = threading.Event()
    _TEAM_APP["tails"][rid] = stop
    threading.Thread(target=_team_tail, args=(Path(run_dir), int(since or 0), stop), daemon=True).start()


def _team_app(msg: dict) -> None:
    """Polecenia team_* z okna; działa w osobnym wątku, żeby nie czekać na turę głównej rozmowy."""
    kind = str(msg.get("type") or "")
    rid = str(msg.get("run_id") or "")
    run_dir = None
    try:
        if rid:
            run_dir, err = _team_find(rid)
            if err:
                _app_emit("team_error", run_id=rid, tekst=err)
                return
        if kind == "team_templates":
            _app_emit("team_templates", templates=_team_templates_list(), brains=_team_brains())
        elif kind == "team_template_save":
            _path, err = _team_template_save(msg.get("template"), str(msg.get("scope") or "project"))
            if err:
                _app_emit("team_error", tekst=err)
            _app_emit("team_templates", templates=_team_templates_list(), brains=_team_brains())
        elif kind == "team_template_delete":
            p = _team_tpl_dirs().get(str(msg.get("scope") or "project"), Path("/nonexistent")) / f"{_slug(str(msg.get('name') or ''))}.json"
            try:
                p.unlink()
            except OSError:
                _app_emit("team_error", tekst=_L("Nie ma takiego szablonu."))
            _app_emit("team_templates", templates=_team_templates_list(), brains=_team_brains())
        elif kind == "team_start":
            tpl = msg.get("team") if isinstance(msg.get("team"), dict) else None
            err = ""
            if tpl is None:
                tpl, err = _team_template_get(str(msg.get("template") or "para"))
            if err:
                _app_emit("team_error", tekst=err)
                return
            src = msg.get("source") if isinstance(msg.get("source"), dict) else {"kind": "app"}
            over = {"mode": msg.get("mode"), "budget_kr": msg.get("budget_kr"), "hours": msg.get("hours"),
                    "parallel": msg.get("parallel")}
            run_dir, err = _team_create_run(Path.cwd(), str(msg.get("goal") or ""), tpl, over, src,
                                            base=str(msg.get("base") or "head"))
            if err:
                _app_emit("team_error", tekst=err)
                return
            if src.get("kind") == "chat":
                _TEAM_APP["chat"].add(run_dir.name)
                _APP["inbox"].append({"type": "_team_chat", "role": "user", "text": str(msg.get("goal") or "")})
                _APP["wake"].set()
            _team_tail_start(run_dir, 0)
            _team_spawn_supervisor(run_dir)
        elif kind == "team_runs":
            _app_emit("team_runs", runs=_team_runs_list())
        elif kind == "team_attach" and run_dir:
            _team_tail_start(run_dir, int(msg.get("since_seq") or 0))
        elif kind == "team_detach":
            stop = _TEAM_APP["tails"].pop(rid, None)
            if stop:
                stop.set()
        elif kind == "team_answer" and run_dir:
            TeamStore(run_dir).control(type="answer", ask_id=str(msg.get("ask_id") or ""),
                                       value=int(msg.get("value") or 0), by=str(msg.get("by") or "mac"))
        elif kind == "team_message" and run_dir:
            err = _team_say(TeamStore(run_dir), msg.get("to") or "lead", msg.get("text"), msg.get("task_id") or "",
                            str(msg.get("reply_to") or ""), by=str(msg.get("by") or "human"))
            if err:
                _app_emit("team_error", run_id=rid, tekst=err)
        elif kind == "team_plan_decide" and run_dir:
            store = TeamStore(run_dir)
            err = store.plan_apply("human", msg["tasks"], dry=True) if msg.get("approve") and isinstance(msg.get("tasks"), list) else ""
            if store.load_run().get("status") != "waiting_human":
                err = _L("Plan nie czeka na decyzję.")
            if err:
                _app_emit("team_error", run_id=rid, tekst=err)
            else:
                store.control(type="plan_decide", approve=bool(msg.get("approve")), notes=str(msg.get("notes") or ""),
                              **({"tasks": msg["tasks"]} if isinstance(msg.get("tasks"), list) else {}),
                              by=str(msg.get("by") or "mac"))
        elif kind == "team_merge_decide" and run_dir:
            TeamStore(run_dir).control(type="merge_decide", task_id=str(msg.get("task_id") or ""),
                                       approve=bool(msg.get("approve")), notes=str(msg.get("notes") or ""),
                                       by=str(msg.get("by") or "mac"))
        elif kind == "team_task_add" and run_dir:
            _c, err = TeamStore(run_dir).task_create("human", [msg.get("task") if isinstance(msg.get("task"), dict) else {}])
            if err:
                _app_emit("team_error", run_id=rid, tekst=err)
        elif kind == "team_task_edit" and run_dir:
            _t, err = TeamStore(run_dir).task_edit("human", str(msg.get("task_id") or ""), msg.get("patch"))
            if err:
                _app_emit("team_error", run_id=rid, tekst=err)
        elif kind in ("team_member_stop", "team_member_add") and run_dir:
            store = TeamStore(run_dir)
            if kind == "team_member_add":
                spec = msg.get("member") if isinstance(msg.get("member"), dict) else {}
                if len(store.load_run().get("members") or []) >= _TEAM_MAX_MEMBERS or not str(spec.get("name") or "").strip():
                    _app_emit("team_error", run_id=rid, tekst=_Lf("Podaj nazwę członka; zespół ma najwyżej {0} osób.",
                                                                 _TEAM_MAX_MEMBERS))
                    return
                store.control(type="member_add", member=spec, by="human")
            else:
                store.control(type="member_stop", member=str(msg.get("member") or ""), by="human")
        elif kind == "team_diff" and run_dir:
            res = _team_diff(run_dir, str(msg.get("member") or ""), str(msg.get("task_id") or ""))
            if res.get("error"):
                _app_emit("team_error", run_id=rid, tekst=res["error"])
            else:
                _app_emit("team_diff", run_id=rid, **res)
        elif kind == "team_member_log" and run_dir:
            _app_emit("team_member_log", run_id=rid, **_team_member_log(run_dir, str(msg.get("member") or ""),
                                                                       int(msg.get("since") or 0)))
        elif kind in ("team_stop", "team_pause") and run_dir:
            store = TeamStore(run_dir)
            run = store.load_run()
            if _team_sup_alive(run):
                store.control(type=kind[5:], by=str(msg.get("by") or "mac"))
            elif kind == "team_stop" and run.get("status") in _TEAM_RESUMABLE:
                run["status"] = "stopped"
                store.save_run(run)
                store.append_event("team_done", status="stopped", summary=_L("Zatrzymane przez człowieka."),
                                   spent_kr=run.get("spent_kr") or 0, seconds=run.get("elapsed_s") or 0,
                                   diff_stat={"files": 0, "added": 0, "removed": 0}, apply_options=[], merged=[],
                                   source=run.get("source") or {})
        elif kind == "team_resume" and run_dir:
            err = _team_resume(run_dir)
            if err:
                _app_emit("team_error", run_id=rid, tekst=err)
            elif rid not in _TEAM_APP["tails"]:
                _team_tail_start(run_dir, TeamStore(run_dir).seq())
        elif kind == "team_apply" and run_dir:
            ev = team_apply(run_dir, str(msg.get("how") or "merge"), by=str(msg.get("by") or "mac"),
                            title=str(msg.get("title") or ""))
            if rid not in _TEAM_APP["tails"]:
                _app_emit("team_applied", **{k: v for k, v in ev.items() if k != "type"})
        elif kind == "team_cleanup" and run_dir:
            res = team_cleanup(run_dir, bool(msg.get("keep_branches")))
            if not res["ok"]:
                _app_emit("team_error", run_id=rid, tekst=res["detail"])
            _app_emit("team_runs", runs=_team_runs_list())
        elif not run_dir and kind in ("team_attach", "team_answer", "team_message", "team_stop", "team_pause",
                                      "team_resume", "team_apply", "team_cleanup", "team_plan_decide",
                                      "team_merge_decide", "team_task_add", "team_task_edit", "team_member_stop",
                                      "team_member_add", "team_diff", "team_member_log"):
            _app_emit("team_error", tekst=_L("Brak run_id."))
        else:
            _app_emit("team_error", run_id=rid, tekst=_Lf("Nieznane polecenie zespołu: {0}", kind))
    except Exception as exc:  # noqa: BLE001 — błąd jednego polecenia nie może zamknąć okna
        _app_emit("team_error", run_id=rid, tekst=str(exc)[:400])


