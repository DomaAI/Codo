            html = _office_sheet_table(data, "xlsx")
            if html:     # nazwa arkusza nad jego tabelą
                html = re.sub(r'<table data-name="([^"]*)">', r'<h3 class="sheet">\1</h3>\n<table>', html)
        elif kind == "PPTX":
            html = _office_pptx_html(data, None)
    except Exception:  # noqa: BLE001 — sam tekst wystarczy
        html = None
    out = {"kind": "office", "format": kind, "text": text[:_UI_PREVIEW_TEXT], "truncated": len(text) > _UI_PREVIEW_TEXT}
    if html and len(html) <= 4 * _UI_PREVIEW_TEXT:
        out["html"] = html
    return out


def _ui_file_preview(raw) -> tuple:
    p = _ui_file_path(raw)
    if p is None:
        return 403, {"ok": False, "error": "outside"}
    info = _ui_file_info(p)
    if info is None:
        return 404, {"ok": False, "error": "missing"}
    if info["dir"]:
        try:
            entries = sorted(p.iterdir(), key=lambda e: (not e.is_dir(), e.name.lower()))
        except OSError:
            entries = []
        items = []
        for e in entries[:400]:
            if e.name in (".git", "node_modules", "__pycache__", _DOMA_DIR):
                continue
            try:
                items.append({"name": e.name, "dir": e.is_dir(), "size": 0 if e.is_dir() else e.stat().st_size})
            except OSError:
                continue
        return 200, {**info, "kind": "dir", "entries": items, "more": max(0, len(entries) - 400)}
    try:
        with open(p, "rb") as fh:
            head = fh.read(_UI_PREVIEW_READ)
    except OSError as exc:
        return 403, {"ok": False, "error": "read", "detail": str(exc)[:200]}
    kind = _ui_file_kind(p, head)
    out = {**info, "kind": kind}
    okind = _ZIP_KINDS.get(p.suffix.lower(), "")
    if okind in _DOC_KINDS and head.startswith(b"PK") and info["size"] <= _UI_OFFICE_PREVIEW_MAX:
        doc = _ui_office_preview(p, okind)
        if doc:
            return 200, {**out, **doc}
    if kind in ("text", "md", "html"):
        text = head.decode("utf-8", errors="replace")
        out["truncated"] = len(text) > _UI_PREVIEW_TEXT or info["size"] > _UI_PREVIEW_READ
        out["text"] = text[:_UI_PREVIEW_TEXT]
    return 200, out


def _ui_file_raw(handler, raw, download: bool) -> None:
    """Bajty pliku dla podglądu (obraz, PDF, wideo) albo pobrania. Wszystko poza PDF w piaskownicy CSP:
    obraz SVG czy plik HTML z projektu nie uruchomi skryptu w adresie okna (z tokenem)."""
    p = _ui_file_path(raw)
    if p is None or not p.is_file():
        return handler._send(404, {"ok": False})
    try:
        size = p.stat().st_size
    except OSError:
        return handler._send(404, {"ok": False})
    if size > _UI_RAW_MAX:
        return handler._send(413, {"ok": False, "error": "too_big", "max": _UI_RAW_MAX})
    ext = p.suffix.lower().lstrip(".")
    ctype = "application/octet-stream" if download else _UI_RAW_TYPES.get(ext, "application/octet-stream")
    quoted = urllib.parse.quote(p.name)
    handler.send_response(200)
    handler.send_header("Content-Type", ctype)
    handler.send_header("Content-Length", str(size))
    handler.send_header("Cache-Control", "no-store")
    handler.send_header("X-Content-Type-Options", "nosniff")
    handler.send_header("Referrer-Policy", "no-referrer")
    handler.send_header("Cross-Origin-Resource-Policy", "same-origin")
    if ctype == "application/pdf":
        handler.send_header("X-Frame-Options", "SAMEORIGIN")      # PDF w ramce podglądu okna
        handler.send_header("Content-Disposition", "inline; filename*=UTF-8''" + quoted)
    else:
        handler.send_header("X-Frame-Options", "DENY")
        handler.send_header("Content-Security-Policy", "sandbox; default-src 'none'; img-src data:; style-src 'unsafe-inline'")
        handler.send_header("Content-Disposition", ("attachment" if download or ctype == "application/octet-stream" else "inline")
                            + "; filename*=UTF-8''" + quoted)
    handler.end_headers()
    if handler.command == "HEAD":
        return None
    try:
        with open(p, "rb") as fh:
            while True:
                chunk = fh.read(1 << 16)
                if not chunk:
                    break
                handler.wfile.write(chunk)
    except OSError:
        pass
    return None


def _ui_file_open(msg: dict) -> tuple:
    """Plik w domyślnej aplikacji systemu albo zaznaczony w Eksploratorze / Finderze / menedżerze plików."""
    p = _ui_file_path(msg.get("p"))
    if p is None:
        return 403, {"ok": False, "error": "outside"}
    if not p.exists():
        return 404, {"ok": False, "error": "missing"}
    reveal = bool(msg.get("reveal"))
    try:
        if os.name == "nt":
            if reveal and p.is_file():
                subprocess.Popen(["explorer", "/select,", str(p)])  # nosec B603 B607 - plik z projektu lub załączników
            else:
                os.startfile(str(p))  # nosec B606 - plik z projektu lub załączników
        elif sys.platform == "darwin":
            subprocess.Popen(["open", "-R", str(p)] if reveal else ["open", str(p)])  # nosec B603 B607
        else:
            target = p.parent if reveal and p.is_file() else p
            subprocess.Popen(["xdg-open", str(target)], stdout=subprocess.DEVNULL,  # nosec B603 B607
                             stderr=subprocess.DEVNULL, start_new_session=True)
    except OSError as exc:
        return 500, {"ok": False, "error": "open", "detail": str(exc)[:200]}
    return 200, {"ok": True}


def _ui_file_post(path: str, msg: dict) -> tuple:
    if path == "/api/file/info":       # {paths: [...]}: które istnieją (linki w odpowiedziach, karty plików)
        out = {}
        for raw in [x for x in (msg.get("paths") or []) if isinstance(x, str)][:200]:
            p = _ui_file_path(raw)
            out[raw] = _ui_file_info(p) if p is not None else None
        return 200, {"ok": True, "items": out}
    if path == "/api/file/attach":     # wklejona ścieżka (np. „Kopiuj jako ścieżkę” w Eksploratorze)
        p = _ui_file_raw_path(msg.get("path"))
        if p is None or not p.exists():
            return 404, {"ok": False, "error": "missing"}
        _UI_FILE_EXTRA.add(p)
        return 200, _ui_file_info(p) or {"ok": False}
    if path == "/api/file/open":
        return _ui_file_open(msg)
    return 404, {"ok": False}


# ── Okno: workflowy i Biuro (26.11.2026), te same pliki co aplikacja na Maca ──────────────────
# Workflowy: ~/.config/doma/workflows.json (lista, format WorkflowStore.swift), okno czyta i zapisuje całość.
# Biuro: folder ~/Documents/Codo (CODO_OFFICE_FOLDER albo wybrany w oknie), pliki *.deck|doc|sheet.html
