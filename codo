def t_http_request(args):
    """Testuj LOKALNY endpoint (http://localhost/127.0.0.1) — np. po run_app.
    Celowo nie wychodzi w internet (od tego jest przeglądarka agenta w czacie)."""
    from urllib.parse import urlparse
    url = args.get("url") or ""
    host = urlparse(url).hostname or ""
    if host not in ("localhost", "127.0.0.1", "::1", "0.0.0.0"):  # nosec B104
        return "BŁĄD: http_request działa tylko na localhost (test własnej aplikacji)."
    method = (args.get("method") or "GET").upper()
    body = args.get("body")
    data = body.encode() if isinstance(body, str) and body else None
    headers = args.get("headers") or {}
    req = urllib.request.Request(url, data=data, method=method,
                                 headers={"User-Agent": f"doma-cli/{VERSION}",
                                          **headers})
    try:
        with urllib.request.urlopen(req, timeout=20) as resp:  # nosec B310 — localhost-only (guard wyżej)
            payload = resp.read(64_000).decode(errors="replace")
            ctype = resp.headers.get("Content-Type", "?")
            return f"HTTP {resp.status} · {ctype}\n{payload}"
    except urllib.error.HTTPError as e:
        return f"HTTP {e.code}\n{e.read(8000).decode(errors='replace')}"
    except Exception as e:
        return f"BŁĄD połączenia: {e} (aplikacja działa? sprawdź run_app status)"


