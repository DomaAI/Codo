def _set_title(text: str) -> None:
    """Tytuł karty terminala (OSC 0), np. „✳ Safari i YouTube”."""
    if not _tty() or os.environ.get("TERM") == "dumb":
        return
    clean = "".join(ch for ch in text if ch.isprintable())[:60]
    try:
