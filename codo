def _domaai_brain_family(brain: str) -> str | None:
    """Rodzina dla profilu agenta, gdy wybrany mózg to model z konta DomaAI; None = mózg spoza DomaAI
    (Codex, Claude Code, własny klucz, MaddLabs): wtedy profil w DomaAI zostaje bez zmian."""
    b = (brain or "").strip()
    if b in ("lopus", "lopus-pro"):
        return ""
    ids = {str(m.get("id")) for m in ((_models_cache_get("domaai") or {}).get("models") or []) if isinstance(m, dict)}
