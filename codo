def mcp_server(argv: list | None = None) -> int:
    """codo mcp: serwer MCP (stdio, JSON-RPC w liniach) z Gmailem, Kalendarzem i Dyskiem Google.
    codo mcp --zespol DIR --czlonek ID: tylko narzędzia team_* członka zespołu agentów."""
    argv = list(argv or [])
    zespol = argv[argv.index("--zespol") + 1] if "--zespol" in argv[:-1] else ""
    if zespol:
        me = argv[argv.index("--czlonek") + 1] if "--czlonek" in argv[:-1] else os.environ.get("CODO_ZESPOL_CZLONEK", "")
        role = next((m.get("role") for m in TeamStore(zespol).load_run().get("members") or [] if m.get("id") == me), "")
        os.environ.update(CODO_ZESPOL_DIR=zespol, CODO_ZESPOL_CZLONEK=me,
                          CODO_ZESPOL_ROLA="lead" if role == "lead" else "member")
    wyjscie = sys.stdout
    sys.stdout = sys.stderr   # każdy print z reszty Codo idzie do logu agenta, nie do protokołu

    def odpisz(msg_id, wynik=None, blad=None):
        m = {"jsonrpc": "2.0", "id": msg_id}
        if blad is not None:
            m["error"] = {"code": -32601, "message": blad}
        else:
            m["result"] = wynik
        wyjscie.write(json.dumps(m, ensure_ascii=False) + "\n")
        wyjscie.flush()

    for linia in sys.stdin:
        try:
            msg = json.loads(linia)
        except ValueError:
            continue
        if not isinstance(msg, dict):
            continue
        metoda, msg_id = msg.get("method"), msg.get("id")
        if msg_id is None:
            continue   # powiadomienia (notifications/initialized)
        if metoda == "initialize":
            odpisz(msg_id, {"protocolVersion": (msg.get("params") or {}).get("protocolVersion") or "2025-06-18",
                            "capabilities": {"tools": {}},
                            "serverInfo": {"name": "codo", "version": VERSION}})
        elif metoda == "tools/list":
            odpisz(msg_id, {"tools": _team_mcp_tools() if zespol else _mcp_narzedzia()})
        elif metoda == "tools/call":
            p = msg.get("params") or {}
            nazwa, args = str(p.get("name") or ""), p.get("arguments") or {}
            if zespol:
                tekst = (t_team(nazwa, args if isinstance(args, dict) else {})
                         if nazwa in {t["name"] for t in _team_mcp_tools()} else f"BŁĄD: nieznane narzędzie {nazwa}")
            elif nazwa == "agenci" and _mcp_agent_okna():
                # Agent zewnętrzny nie powinien wisieć 20 minut na jednym wywołaniu: czeka krócej, potem odpowiedź
                # i tak wróci do niego jako osobna wiadomość.
                tekst = t_agenci(args if isinstance(args, dict) else {}, most=_most_przez_gniazdo, czekaj_max=480)
            elif nazwa == "przegladarka" and _mcp_agent_okna():
                tekst = _t_przegladarka_mcp(args if isinstance(args, dict) else {})
            elif nazwa == "dysk":
                tekst = t_dysk(args, ask=_zgoda_przez_okno)
            elif nazwa == "imessage":
                tekst = t_imessage(args, ask=_zgoda_przez_okno)
            elif nazwa in _GOOGLE_NAZWY:
                tekst = google_wywolaj(nazwa, args, ask=_zgoda_przez_okno)
            else:
                tekst = konektor_wywolaj(nazwa, args, ask=_zgoda_przez_okno)
            odpisz(msg_id, {"content": [{"type": "text", "text": tekst}],
                            "isError": tekst.startswith("BŁĄD")})
        elif metoda == "ping":
            odpisz(msg_id, {})
        else:
            odpisz(msg_id, blad=f"Nieznana metoda {metoda}")
    return 0


