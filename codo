        elif kind == "context":
            _app_emit("context", **_context_usage(messages, False))
        elif kind == "compact":
            # Porządkowanie kontekstu z okna: streszczenie rozmowy jednym krokiem modelu.
            SESSION["app_busy"] = True
            try:
                res = compact_app(creds, messages, model, str(msg.get("hint") or ""))
