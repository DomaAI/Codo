        out += "\n\nTwoje biurko to folder roboczy tej rozmowy: trzymaj tu swoje notatki i pliki."
        if not a.get("writes"):
            out += " Nie zmieniaj plików: czytaj, sprawdzaj i doradzaj."
        return out

    # ── silniki ──
    def wake(self, aid: str):
        a = self.agents.get(aid)
        if not a:
            return None
        e = self.engines.get(aid)
        if e and e.alive():
            return e
        e = self.factory(a, self.desk(a), self.q)
        e.spawn()
        self.engines[aid] = e
        e.send({"type": "agent_persona", "text": self.persona(a)})
        if a.get("conversation"):
            e.send({"type": "resume", "id": a["conversation"]})
        return e

    def refresh_personas(self) -> None:
        for aid, e in self.engines.items():
            if aid in self.agents and e.alive():
                e.send({"type": "agent_persona", "text": self.persona(self.agents[aid])})

    def activity(self, aid: str) -> str:
        e = self.engines.get(aid)
        if e and e.ask_id:
            return "asking"
        if aid in self.current or (e and e.busy):
            return "working"
        if self.queues.get(aid):
            return "queued"
        return "ready" if e and e.alive() else "asleep"

    def line(self, a: dict) -> str:
        act, aid = self.activity(a["id"]), a["id"]
        if act == "asking":
            return "Czeka na Twoją zgodę"
        if act == "working":
            if aid in self.waiting:
                other = self.agents.get(self.waiting[aid])
                return f"Zapytał: {other['name']}, czeka" if other else "Pracuje"
            m = self.current.get(aid) or {}
            kind = (m.get("origin") or ("",))[0]
            if kind == "beat":
                return "Sprawdza"
            if kind == "channel":
                return "Odpowiada " + self.chat_word(m["origin"][1] if len(m["origin"]) > 1 else "telegram")
            if kind == "agent":
                return f"Pracuje dla: {m['origin'][2]}"
            if kind == "handoff":
                p = self.post(m["origin"][1])
                return f"Zadanie od: {p['from_name']}" if p else "Pracuje"
            return "Pracuje"
        if act == "queued":
            return f"W kolejce: {len(self.queues.get(aid) or [])}"
        return a.get("job") or "Gotowy"

    # ── wiadomości ──
    def tell(self, aid: str, text: str, origin: tuple, back=None, depth: int = 0, post: str | None = None,
             deliver: bool = False, reply=None, voice: bool = False, by_you: bool = False) -> str:
        a = self.agents.get(aid)
        if not a:
            if post:
                self.set_post(post, state="failed", finished=_now_iso())
            return "Tego agenta już nie ma."
        by_you = by_you or bool(post and (self.post(post) or {}).get("by_you"))
        # praca w tle staje na dziennym limicie, do jutra; to, co użytkownik pisze sam, idzie dalej
        if _calm_background(_calm_kind(origin, deliver), by_you, depth):
            line = self.closed(aid)
            if line:
                if post:
                    self.set_post(post, state="failed", finished=_now_iso(), answer=line)
                if reply:
                    reply(line, False)
                return line
        ahead = len(self.queues.get(aid) or []) + (1 if aid in self.current else 0)
        if back is None:
            back = ("channel", origin[1]) if origin[0] == "channel" else (("reports", aid) if origin[0] in ("beat", "trigger") else ("here", aid))
        self.queues.setdefault(aid, []).append({"text": text, "origin": origin, "back": back, "depth": depth,
                                                 "post": post, "deliver": deliver, "reply": reply, "voice": voice,
                                                 "by_you": by_you})
        self.wake(aid)
        self.dirty = True
        return "" if ahead == 0 else f"«{a['name']}» jest zajęty. Twoja wiadomość jest {ahead}. w kolejce."

    def pump(self, aid: str) -> None:
        q = self.queues.get(aid)
        if not q or aid in self.current:
            return
        e = self.engines.get(aid)
        if e is None or not e.alive():
            e = self.wake(aid)
        if e is None or not e.ready or e.busy or e.ask_id:
            return
        m = q.pop(0)
        kind = m["origin"][0]
        shown = m["text"]
        if kind == "beat":
            note = ""
        elif kind == "channel":
            ch = self.chat_title(m["origin"][1] if len(m["origin"]) > 1 else "telegram")
            note = f"Wiadomość od użytkownika (kanał: {ch}). Twoja odpowiedź trafi tam sama: pisz krótko, jak na czacie, bez tabel."
        elif kind == "agent":
            p = self.post(m["post"]) if m.get("post") else None
            note = self.note_reply(m["back"]) if m.get("deliver") else (self.note_for(p) if p else "")
        elif kind == "handoff":
            p = self.post(m["origin"][1])
            note = self.note_for(p) if p else ""
        elif kind == "room":
            # pokój niesie swój kontekst pod notką [Codo]: w zapisie rozmowy zostaje sama wiadomość
            shown, _sep, note = m["text"].partition(_HOST_NOTE)
        else:
            note = ""
        if not e.send({"type": "send", "text": shown + (_HOST_NOTE + note if note else "")}):
            q.insert(0, m)
            return
        e.busy, e.answer = True, ""
        self.current[aid] = m
        self.turn_sent[aid] = set()
        self.log(aid, "user", shown, src=kind)
        who = ""
        if kind == "agent":
            who = str(m["origin"][2] if len(m["origin"]) > 2 else "")
        elif kind == "channel":
            who = self.chat_title(m["origin"][1] if len(m["origin"]) > 1 else "telegram")
        elif kind == "handoff":
            p = self.post(m["origin"][1])
            who = str((p or {}).get("from_name") or "")
        elif kind == "room":
            who = str(m["origin"][2] if len(m["origin"]) > 2 else "")
        self.trace(aid, {"type": "_in", "tekst": shown, "src": kind, "od": who, "post": m.get("post") or ""})
        if m.get("post"):
            self.set_post(m["post"], state="working", began=_now_iso())
        self.dirty = True

    def finished(self, aid: str, ok: bool, convo) -> None:
        e = self.engines.get(aid)
        a = self.agents.get(aid)
        if e:
            e.busy, e.ask_id = False, None
        m = self.current.get(aid)
        answer = (e.answer if e else "").strip()
        if e:
            e.answer = ""
        if a is None:
            self.current.pop(aid, None)
            return
        # mózgi bez narzędzi: blok ```agenci``` na końcu odpowiedzi, póki wiadomość mówi, skąd przyszła praca
        answer, orders = self.take_orders(answer)
        wrong = self.orders(orders, aid) if ok and orders else ""
        self.turn_sent.pop(aid, None)
        self.current.pop(aid, None)
        answer, facts = self.take_memories(answer)
        if facts:
            self.trace(aid, {"type": "_pamiec", "rodzaj": "pamiec", "fakty": facts})
        if facts and a.get("memory_on"):
            notes = [str(n) for n in (a.get("memory") or [])]
            for f in facts:
                if f.lower() not in [n.lower() for n in notes]:
                    notes.append(f)
            a["memory"] = notes[-30:]
            self.save_agents()
            self.refresh_personas()
        answer, learned, about = _take_skill_lines(answer)
        if learned:
            self.trace(aid, {"type": "_pamiec", "rodzaj": "umiejetnosc", "fakty": [str(x) for x in learned]})
        if about:
            self.trace(aid, {"type": "_pamiec", "rodzaj": "profil", "fakty": [str(x) for x in about]})
        if (learned or about) and a.get("memory_on"):
            self.learn(aid, learned, about)
        if wrong:
            answer = (answer + "\n\n" if answer else "") + wrong
        if convo and a.get("conversation") != convo:
            a["conversation"] = convo
            self.save_agents()
        by_you = aid in self.stopped
        self.stopped.discard(aid)
        if m:
            kind = m["origin"][0]
            if kind in ("beat", "trigger"):
                if not (ok and _host_quiet(answer)) and answer:
                    self.deliver(m["back"], a["name"] + "\n\n" + answer)
            elif kind == "channel":
                why = getattr(self.engines.get(aid), "last_error", "") if not ok else ""
                body = answer or ("Gotowe, bez odpowiedzi na piśmie." if ok else (why or "Przerwane przed końcem."))
                self.deliver(m["back"], a["name"] + "\n\n" + body, spoken=answer if m.get("voice") and answer else None)
            if m.get("reply"):
                m["reply"](answer, ok)
            self.settle(m, aid, a["name"], answer, ok, by_you)
        self.dirty = True
        self.pump(aid)

    def learn(self, aid: str, learned: list, about: list) -> None:
        """Umiejętności i fakty o użytkowniku z linii na końcu odpowiedzi (mózgi bez narzędzi też tak się uczą)."""
        a = self.agents.get(aid)
        if not a:
            return
        changed = False
        for name, when, text in learned:
            a["skills"], said, err = _skill_put(a.get("skills") or [], name, when, text, strict=False)
            if err:
                self.log(aid, "info", f"Umiejętność «{name}» nie zapisana: {err}", src="error")
            changed = changed or not err
        for f in about:
            self.profile, said, err = _profile_add(self.profile, f)
            if err:
                self.log(aid, "info", err, src="error")
            changed = changed or not err
        if changed:
            self.save_agents()
            self.refresh_personas()
            self.dirty = True

    @staticmethod
    def clean(text: str) -> str:
        """Odpowiedź tak, jak czyta ją człowiek: bez bloków dla Codo i linii do pamięci, umiejętności i profilu."""
        t = AgentHost.take_orders(str(text or ""))[0]
        t = AgentHost.take_memories(t)[0]
        return _take_skill_lines(t)[0]

    def skill_call(self, a: dict, me: dict) -> dict:
        """agenci.umiejetnosc: bez nazwy lista, z nazwą odczyt (liczy użycie), z treścią zapis albo poprawka, usun=true usuwa."""
        skills = [s for s in me.get("skills") or [] if isinstance(s, dict) and s.get("nazwa")]
        name = str(a.get("nazwa") or "").strip()
        if not name:
            rows = [{"nazwa": s["nazwa"], "kiedy": s.get("kiedy") or "", "uzycia": int(s.get("uzycia") or 0),
                     "zmieniona": s.get("zmieniona") or ""} for s in _skills_ranked(skills)]
            return {"umiejetnosci": rows, "uwaga": "" if rows else "Nie masz jeszcze żadnych umiejętności."}
        key = _skill_key(name)
        hit = next((s for s in skills if _skill_key(s["nazwa"]) == key), None)
        if a.get("usun"):
            if not hit:
                return {"error": f"Nie masz umiejętności «{name}»."}
            me["skills"] = [s for s in skills if s is not hit]
            self.save_agents()
            self.refresh_personas()
            self.dirty = True
            return {"text": f"Usunięto umiejętność «{hit['nazwa']}»."}
        if str(a.get("tresc") or "").strip():
            if not me.get("memory_on"):
                return {"error": "Ten agent ma wyłączoną pamięć w Codo, więc nie zapisuje umiejętności."}
            me["skills"], said, err = _skill_put(skills, name, a.get("kiedy"), a.get("tresc"))
            if err:
                return {"error": err}
            self.save_agents()
            self.refresh_personas()
            self.dirty = True
            return {"text": said}
        hit = hit or next((s for s in skills if _skill_key(s["nazwa"]).startswith(key) or key in _skill_key(s["nazwa"])), None)
        if not hit:
            return {"error": f"Nie masz umiejętności «{name}».", "umiejetnosci": [s["nazwa"] for s in _skills_ranked(skills)]}
        hit["uzycia"] = int(hit.get("uzycia") or 0) + 1
        hit["uzyta"] = _now_iso()
        self.save_agents()
        self.dirty = True
        return {"nazwa": hit["nazwa"], "kiedy": hit.get("kiedy") or "", "tresc": hit.get("tresc") or "", "uzycia": hit["uzycia"],
                "uwaga": "Gdy ten przepis zawiedzie albo znajdziesz lepszą drogę, popraw go: akcja=umiejetnosc z tą samą nazwą i nową treścią."}

    def search(self, aid: str, phrase: str, limit: int = 8) -> list:
        """Wszystkie dawne rozmowy agenta (rozmowy/<id>.jsonl), nie tylko bieżąca."""
        import datetime as _dt
        a = self.agents.get(aid) or {}
        try:
            lines = (HOST_DIR / "rozmowy" / f"{aid}.jsonl").read_text(encoding="utf-8").splitlines()
        except OSError:
            return []
        rows = []
        for ln in lines:
            try:
                it = json.loads(ln)
            except ValueError:
                continue
            role, src, text = it.get("role"), str(it.get("src") or ""), str(it.get("text") or "")
            if role == "assistant":
                who = a.get("name") or "agent"
            elif role == "user":
                m = re.match(r"\[(?:Zadanie|Pytanie|Wiadomość|Odpowiedź) od «([^»]+)»\]", text)
                who = (f"agent «{m.group(1)}»" if m else "inny agent") if src in ("agent", "handoff") else (
                    "regularne sprawdzanie" if src == "beat" else ("Ty (kanał)" if src == "channel" else "Ty"))
            else:
                continue
            try:
                when = _dt.datetime.fromtimestamp(float(it.get("t") or 0)).strftime("%Y-%m-%d %H:%M")
            except (OverflowError, OSError, ValueError):
                when = ""
            rows.append((when, who, text))
        return _search_rows(rows, phrase, limit)

    @staticmethod
    def take_memories(answer: str) -> tuple:
        facts, kept = [], []
        for ln in answer.splitlines():
            mm = re.match(r"\s*`?(?:ZAPAMIĘTAJ|REMEMBER):\s*(.+?)`?\s*$", ln)
            if mm:
                facts.append(mm.group(1).strip()[:300])
            else:
                kept.append(ln)
        return "\n".join(kept).strip(), facts[:3]

    @staticmethod
    def take_orders(answer: str) -> tuple:
        orders = []
        while "```agenci" in answer:
            a = answer.index("```agenci")
            b = answer.find("```", a + 9)
            if b < 0:
                break
            try:
                o = json.loads(answer[a + 9:b])
                orders += [o] if isinstance(o, dict) else [x for x in o if isinstance(x, dict)]
            except ValueError:
                pass
            answer = (answer[:a] + answer[b + 3:]).strip()
        return answer, orders

    # ── poczta między agentami ──
    def post(self, key):
        return next((p for p in self.posts if p["id"] == key), None)

    def set_post(self, key, **changes) -> None:
        p = self.post(key)
        if p is not None:
            p.update(changes)
            self.save_posts()
            self.dirty = True

    def refusal(self, me: str):
        import time
        now = time.time()
        self.sent = [t for t in self.sent if now - t < 3600]
        if len(self.sent) >= _HOST_HOURLY:
            return f"Limit wiadomości między agentami na godzinę ({_HOST_HOURLY}) jest wyczerpany. Zrób to sam albo napisz użytkownikowi, co zostało."
        if int((self.current.get(me) or {}).get("depth") or 0) + 1 > _HOST_MAX_DEPTH:
            return f"Ten łańcuch między agentami jest już za długi ({_HOST_MAX_DEPTH} kroków bez człowieka). Zakończ i napisz użytkownikowi, na czym stanęło."
        return None

    def waits(self, a: str, b: str) -> bool:
        seen, at = set(), a
        while at in self.waiting and at not in seen:
            seen.add(at)
            if self.waiting[at] == b:
                return True
            at = self.waiting[at]
        return False

    def carry(self, raw, src_agent: dict, dst_agent: dict) -> tuple:
        names = [str(n).strip() for n in (raw if isinstance(raw, list) else []) if str(n).strip()]
        if not names:
            return [], None
        src, dst = self.desk(src_agent), self.desk(dst_agent)
        found, count, size = [], 0, 0
        for n in names:
            u = (Path(n) if os.path.isabs(n) else src / n).resolve()
            if src not in u.parents:
                return [], f"Plik spoza Twojego folderu: {n}. Przekazać możesz tylko to, co masz u siebie."
            if not u.exists():
                return [], f"Nie ma takiego pliku: {n}."
            files = [f for f in u.rglob("*") if f.is_file()] if u.is_dir() else [u]
            count += len(files)
            size += sum(f.stat().st_size for f in files)
            found.append(u)
        if count > _HOST_MAX_FILES:
            return [], f"Za dużo plików naraz ({count}, limit {_HOST_MAX_FILES}). Wybierz najważniejsze albo spakuj je."
        if size > _HOST_MAX_BYTES:
            return [], f"Za duże pliki (limit {_HOST_MAX_BYTES // 1024 // 1024} MB naraz)."
        if src == dst:
            return [str(u.relative_to(src)) for u in found], None
        import filecmp
        import shutil
        rel = "Poczta/" + (re.sub(r"[/:]", "-", src_agent["name"]) or "agent")
        box = dst / rel
        out = []
        try:
            box.mkdir(parents=True, exist_ok=True)
            for u in found:
                target, n = box / u.name, 2
                if target.exists() and u.is_file() and target.is_file() and filecmp.cmp(u, target, shallow=False):
                    out.append(f"{rel}/{target.name}")
                    continue
                while target.exists():
                    target = box / (f"{u.stem}-{n}{u.suffix}")
                    n += 1
                if u.is_dir():
                    shutil.copytree(u, target)
                else:
                    shutil.copy2(u, target)
                out.append(f"{rel}/{target.name}")
        except OSError as exc:
            return [], f"Nie udało się skopiować plików: {exc}"
        return out, None

    @staticmethod
    def brief(p: dict) -> str:
        head = {"handoff": "Zadanie", "ask": "Pytanie", "note": "Wiadomość"}[p["kind"]]
        if p["kind"] == "handoff":
            own = p.get("title") != _host_headline(p.get("text") or "")
            out = f"[{head} od «{p['from_name']}»]" + (" " + p["title"] if own else "") + "\n\n" + p["text"]
        else:
            out = f"[{head} od «{p['from_name']}»]\n\n" + p["text"]
        if p.get("files"):
            out += f"\n\nPliki od «{p['from_name']}» (w Twoim folderze):\n" + "\n".join("- " + f for f in p["files"])
        return out

    def note_for(self, p: dict) -> str:
        back = p["back"]
        place = (self.chat_word(back[1] if len(back) > 1 else "telegram") + " (pisz krótko, jak na czacie, bez tabel)") if back[0] == "channel" else "w Codo"
        who = p["from_name"]
        if p["kind"] == "handoff":
            return (f"Zadanie przekazane Ci przez «{who}», innego stałego agenta użytkownika. Teraz jest Twoje: zrób je w całości. "
                    f"Twoja odpowiedź trafi prosto do użytkownika {place}, nie do «{who}»: napisz mu wynik, bez opowiadania o "
                    "przekazaniu. Gdy to wyraźnie nie Twoja działka, przekaż dalej (agenci, akcja=przekaz) komuś, kto tego "
                    "zadania jeszcze nie miał.")
        if p["kind"] == "note" and p.get("wants_reply"):
            return (f"Wiadomość od «{who}», innego stałego agenta użytkownika. Nie czeka na Ciebie: Twoja odpowiedź trafi do niego "
                    "jako osobna wiadomość, gdy skończysz. Odpowiedz konkretnie i w całości.")
        if p["kind"] == "note":
            return (f"Wiadomość od «{who}», innego stałego agenta użytkownika, do Twojej wiadomości. Nie czeka na odpowiedź: "
                    "zrób, o co prosi, albo przyjmij to do wiadomości jednym zdaniem.")
        return (f"Wiadomość od «{who}», innego stałego agenta użytkownika. Czeka na Ciebie: Twoja odpowiedź wróci do niego sama, "
                "odpowiedz konkretnie i w całości.")

    def note_reply(self, back) -> str:
        place = (self.chat_word(back[1] if len(back) > 1 else "telegram") + ": krótko, jak na czacie") if back[0] == "channel" else "w Codo"
        return ("To odpowiedź na wiadomość, którą zostawiłeś innemu agentowi. Jeśli wynika z niej coś dla użytkownika, napisz mu "
                f"to teraz (trafi do niego {place}). Jeśli nic, odpowiedz dokładnie jednym słowem: CISZA.")

    def new_post(self, kind: str, me: dict, to: dict, text: str, title: str, files: list, wants_reply: bool = False) -> dict:
        import time
        cur = self.current.get(me["id"]) or {}
        p = {"id": _host_key(), "kind": kind, "from": me["id"], "from_name": me["name"], "to": to["id"], "to_name": to["name"],
             "chain": [me["id"], to["id"]], "title": title or _host_headline(text), "text": text, "files": files,
             "back": list(cur.get("back") or ("here", me["id"])), "state": "queued", "created": _now_iso(), "finished": None,
             "answer": "", "depth": int(cur.get("depth") or 0) + 1, "wants_reply": wants_reply, "retries": 0}
        self.posts.append(p)
        self.posts = self.posts[-300:]
        self.sent.append(time.time())
        self.turn_sent.setdefault(me["id"], set()).add(to["id"])
        self.save_posts()
        self.trace(me["id"], {"type": "_post", "rodzaj": kind, "do": to["name"], "tytul": p["title"], "tekst": text,
                              "pliki": list(files or []), "czeka": wants_reply, "post": p["id"]})
        return p

    def leave(self, a: dict, me: dict, wants_reply: bool) -> dict:
        to = self.find(a.get("agent"), than=me["id"])
        if not to:
            return {"error": "Nie ma takiego agenta (innego niż Ty). Sprawdź akcja=lista."}
        text = str(a.get("tekst") or "").strip()
        if not text:
            return {"error": "Pusty tekst."}
        no = self.refusal(me["id"]) or self.closed(to["id"])
        if no:
            return {"error": no}
        files, err = self.carry(a.get("pliki"), me, to)
        if err:
            return {"error": err}
        p = self.new_post("note", me, to, text, "", files, wants_reply)
        line = self.tell(to["id"], self.brief(p), ("agent", me["id"], me["name"]), back=tuple(p["back"]), depth=p["depth"], post=p["id"])
        return {"text": f"Zostawiono w kolejce agenta «{to['name']}»." + (" " + line if line else "")
                + (" Jego odpowiedź przyjdzie do Ciebie jako osobna wiadomość: nie czekaj na nią, dokończ swoją turę."
                   if wants_reply else " Odpowiedź do Ciebie nie wróci.")}

    def hand(self, a: dict, me: dict) -> dict:
        to = self.find(a.get("agent"), than=me["id"])
        if not to:
            return {"error": "Nie ma takiego agenta (innego niż Ty). Sprawdź akcja=lista."}
        text = str(a.get("tekst") or "").strip()
        if not text:
            return {"error": f"Pusty tekst. Opisz zadanie tak, żeby «{to['name']}» zrozumiał je bez Twojej rozmowy."}
        no = self.refusal(me["id"]) or self.closed(to["id"])
        if no:
            return {"error": no}
        title = str(a.get("tytul") or "").strip()[:120]
        cur = self.current.get(me["id"]) or {}
        origin = cur.get("origin") or ("",)
        old = self.post(origin[1]) if origin[0] == "handoff" else None
        if old and old["to"] == me["id"] and old["state"] in ("queued", "working"):
            if to["id"] in old["chain"]:
                return {"error": f"«{to['name']}» już miał to zadanie. Zrób je sam albo napisz użytkownikowi, czego brakuje."}
            if len(old["chain"]) >= _HOST_MAX_OWNERS:
                return {"error": f"To zadanie przeszło już przez {len(old['chain'])} agentów. Zrób je sam albo napisz użytkownikowi, na czym stanęło."}
            files, err = self.carry(a.get("pliki"), me, to)
            if err:
                return {"error": err}
            import time
            old.update({"from": me["id"], "from_name": me["name"], "to": to["id"], "to_name": to["name"],
                        "chain": old["chain"] + [to["id"]], "text": text, "files": files, "state": "queued",
                        "depth": int(cur.get("depth") or 0) + 1, "by_you": False})
            if title:
                old["title"] = title
            self.sent.append(time.time())
            self.turn_sent.setdefault(me["id"], set()).add(to["id"])
            self.save_posts()
            line = self.tell(to["id"], self.brief(old), ("handoff", old["id"]), back=tuple(old["back"]), depth=old["depth"], post=old["id"])
            if old["back"][0] != "here":
                self.deliver(tuple(old["back"]), f"«{me['name']}» przekazał zadanie «{old['title']}» dalej: «{to['name']}».")
            return {"text": self.handed(old, line)}
        files, err = self.carry(a.get("pliki"), me, to)
        if err:
            return {"error": err}
        p = self.new_post("handoff", me, to, text, title, files)
        line = self.tell(to["id"], self.brief(p), ("handoff", p["id"]), back=tuple(p["back"]), depth=p["depth"], post=p["id"])
        return {"text": self.handed(p, line)}

    @staticmethod
    def handed(p: dict, line: str) -> str:
        return (f"Przekazano agentowi «{p['to_name']}» (zadanie {p['id']}: {p['title']})." + (" " + line if line else "")
                + " Teraz to jego zadanie: wynik trafi prosto do użytkownika tam, skąd przyszła prośba. Nie rób go sam i nie "
                  "czekaj: zakończ turę jednym zdaniem, komu przekazałeś i dlaczego.")

    def orders(self, orders: list, me_id: str) -> str:
        me = self.agents.get(me_id)
        wrong = []
        for a in orders[:3]:
            to = self.find(a.get("agent"), than=me_id)
            if to and to["id"] in (self.turn_sent.get(me_id) or set()):
                continue
            box: dict = {}
            act = "przekaz" if a.get("akcja") == "przekaz" else "napisz"
            # agent z Maca: blokiem nie da się czekać, więc wiadomość zawsze z odpowiedzią później
            args = a if act == "przekaz" else dict(a, odpowiedz="nie" if a.get("odpowiedz") == "nie" else "pozniej")
            if a.get("akcja") in ("przekaz", "napisz") and self.remote_bridge(act, args, me, box.update):
                r = box
            elif a.get("akcja") == "przekaz":
                r = self.hand(a, me)
            elif a.get("akcja") == "napisz":
                r = self.leave(a, me, a.get("odpowiedz") != "nie")
            else:
                continue
            if r.get("error"):
                wrong.append(r["error"])
        return "\n".join(wrong)

    def bridge(self, aid: str, engine, ev: dict) -> None:
        """Narzędzie agenci z silnika: odpowiedź od razu albo po turze drugiego agenta."""
        call, action = str(ev.get("id")), str(ev.get("action") or "")
        a = ev.get("args") if isinstance(ev.get("args"), dict) else {}
        me = self.agents.get(aid)

        def reply(result: dict) -> None:
            engine.send({"type": "bridge_reply", "id": call, "result": result})
        if not action.startswith("agenci.") or me is None:
            reply({"error": "To narzędzie działa tylko w oknie Codo na Maca, a ten agent pracuje na serwerze."})
            return
        act = action.split(".", 1)[1]
        if act in ("napisz", "przekaz") and self.remote_bridge(act, a, me, reply):
            return
        if act == "umiejetnosc":
            reply(self.skill_call(a, me))
            return
        if act == "szukaj":
            phrase = str(a.get("fraza") or "").strip()
            if not phrase:
                reply({"error": "Podaj frazę do szukania."})
                return
            try:
                n = max(1, min(int(a.get("ile") or 8), 30))
            except (TypeError, ValueError):
                n = 8
            rows = self.search(aid, phrase, n)
            reply({"wyniki": rows, "uwaga": "" if rows else f"Nic o «{phrase}» w Twoich dawnych rozmowach."})
            return
        if act == "profil":
            fact = str(a.get("fakt") or "").strip()
            if not fact:
                reply({"profil": list(self.profile), "uwaga": "" if self.profile else "Profil użytkownika jest jeszcze pusty."})
                return
            if not me.get("memory_on"):
                reply({"error": "Ten agent ma wyłączoną pamięć w Codo, więc nie dopisuje do profilu użytkownika."})
                return
            self.profile, said, err = _profile_add(self.profile, fact)
            if not err:
                self.save_agents()
                self.refresh_personas()
                self.dirty = True
            reply({"error": err} if err else {"text": said})
            return
        if act == "lista":
            lst = [{"nazwa": o["name"], "rola": o.get("job") or "", "stan": self.line(o),
                    "wolny": self.activity(o["id"]) in ("ready", "asleep"), "w_kolejce": len(self.queues.get(o["id"]) or [])}
                   for o in (self.agents[i] for i in self.order if i != aid)]
            lst += [{"nazwa": r["name"], "rola": r.get("job") or "", "gdzie": "na Macu użytkownika",
                     "stan": "Gotowy" if self.clients else "Mac teraz niedostępny", "wolny": bool(self.clients), "w_kolejce": 0}
                    for r in self.remote]
            reply({"agenci": lst, "uwaga": "" if lst else "Nie ma innych stałych agentów."})
        elif act == "zadania":
            mine = [p for p in self.posts if (p["from"] == aid or p["to"] == aid or aid in p["chain"]) and p["kind"] != "ask"][-12:]
            words = {"queued": "w kolejce", "working": "w toku", "done": "zrobione", "failed": "niedokończone"}
            rows = [{"id": p["id"], "rodzaj": "zadanie" if p["kind"] == "handoff" else "wiadomość", "tytul": p["title"],
                     "od": p["from_name"], "do": p["to_name"], "stan": words[p["state"]],
                     **({"wynik": p["answer"][:1500]} if p.get("answer") else {})} for p in reversed(mine)]
            reply({"zadania": rows, "uwaga": "" if rows else "Nic nie przekazywałeś i nic Ci nie przekazano."})
        elif act == "przekaz":
            reply(self.hand(a, me))
        elif act == "napisz":
            mode = a.get("odpowiedz") if a.get("odpowiedz") in ("teraz", "pozniej", "nie") else ("nie" if a.get("czekaj") is False else "teraz")
            if mode != "teraz":
                reply(self.leave(a, me, mode == "pozniej"))
                return
            to = self.find(a.get("agent"), than=aid)
            text = str(a.get("tekst") or "").strip()
            if not to:
                reply({"error": "Nie ma takiego agenta (innego niż Ty). Sprawdź akcja=lista."})
                return
            if not text:
                reply({"error": "Pusty tekst."})
                return
            if self.waits(to["id"], aid):
                reply({"error": f"«{to['name']}» czeka teraz na Twoją odpowiedź, więc nie odpowie Tobie. Zrób to sam, odpowiedz mu najpierw albo napisz z odpowiedz=pozniej."})
                return
            no = self.refusal(aid) or self.closed(to["id"])
            if no:
                reply({"error": no})
                return
            files, err = self.carry(a.get("pliki"), me, to)
            if err:
                reply({"error": err})
                return
            p = self.new_post("ask", me, to, text, "", files)
            limit = max(20.0, min(float(a.get("limit") or 1200), 1200.0))
            state = {"done": False}
            self.waiting[aid] = to["id"]

            def answered(answer: str, ok: bool) -> None:
                if state["done"]:
                    return
                state["done"] = True
                self.waiting.pop(aid, None)
                if answer:
                    reply({"text": f"Odpowiedź od «{to['name']}»:\n\n" + answer})
                else:
                    self.set_post(p["id"], state="failed", finished=_now_iso())
                    reply({"error": f"«{to['name']}» skończył bez odpowiedzi na piśmie." if ok else f"«{to['name']}» nie odpowiedział (przerwane)."})

            def late() -> None:
                if state["done"]:
                    return
                state["done"] = True
                self.waiting.pop(aid, None)
                # jeszcze pracuje: pytanie staje się wiadomością, na którą odpowiedź przyjdzie później
                self.set_post(p["id"], kind="note", wants_reply=True)
                reply({"text": f"«{to['name']}» jeszcze nie odpowiedział (minęło {int(limit // 60)} min). Nie czekaj dłużej: jego "
                               "odpowiedź przyjdzie do Ciebie jako osobna wiadomość. Dokończ, co możesz, i powiedz użytkownikowi, że reszta dojdzie."})
            self.tell(to["id"], self.brief(p), ("agent", aid, me["name"]), back=tuple(p["back"]), depth=p["depth"], post=p["id"], reply=answered)
            self.after(limit, late)
        else:
            reply({"error": f"unknown action {action}"})

    def settle(self, m: dict, aid: str, name: str, answer: str, ok: bool, stopped: bool) -> None:
        key = m.get("post")
        p = self.post(key) if key else None
        if p:
            if p["kind"] == "handoff" and p["to"] != aid:
                return
            if p["state"] not in ("queued", "working"):
                return
            tries = int(p.get("retries") or 0)
            if not ok and not answer and not stopped and tries < len(_HOST_RETRY_AFTER) and not m.get("reply"):
                self.set_post(key, retries=tries + 1, state="queued", began=None)
                origin, back, depth = m["origin"], m["back"], m["depth"]

                def again() -> None:
                    q = self.post(key)
                    if q and q["state"] == "queued" and q["to"] == aid:
                        self.tell(aid, self.brief(q), origin, back=back, depth=depth, post=key)
                self.after(_HOST_RETRY_AFTER[tries], again)
                return
            good = ok and bool(answer)
            self.set_post(key, state="done" if good else "failed", finished=_now_iso(), answer=answer[:20000])
            if p["kind"] == "handoff":
                body = (name + "\n\n" + answer) if answer else (
                    f"«{name}» skończył zadanie «{p['title']}» bez odpowiedzi na piśmie." if ok else f"«{name}» nie dokończył zadania «{p['title']}».")
                self.deliver(tuple(p["back"]), body, speaker=aid)
            elif p["kind"] == "note" and p.get("wants_reply") and good and not _host_quiet(answer) and p["from"] in self.agents:
                text = f"[Odpowiedź od «{name}»] na: {p['title'][:120]}\n\n{answer}"
                if p["depth"] + 1 > _HOST_MAX_DEPTH:
                    self.deliver(tuple(p["back"]), name + "\n\n" + answer)
                else:
                    self.tell(p["from"], text, ("agent", aid, name), back=tuple(p["back"]), depth=p["depth"] + 1, deliver=True)
        elif m.get("deliver") and not (ok and _host_quiet(answer)) and answer and m["back"][0] != "here":
            self.deliver(m["back"], name + "\n\n" + answer)

    def voice_out(self, c, text: str, spoken: str | None = None) -> None:
        """Odpowiedź także głosem: na wiadomość głosową (tryb „auto”) albo zawsze (tryb „always”). W tle, po tekście."""
        mode = getattr(c, "voice_mode", "off")
        if mode == "off" or (mode == "auto" and spoken is None) or not hasattr(c, "speak"):
            return
        threading.Thread(target=c.speak, args=(spoken if spoken is not None else text,), daemon=True).start()

    def deliver(self, back, text: str, speaker: str | None = None, spoken: str | None = None) -> None:
        kind = back[0]
        if kind == "here":
            return   # zapis rozmowy i tablica pokażą to w oknie Codo
        if kind == "reports":
            self.report(back[1], text)   # jak znalezisko ze sprawdzania: w godzinach ciszy czeka na ich koniec
            return
        name = back[1] if len(back) > 1 else "telegram"
        c = self.chats.get(name)
        if c is None:
            # komunikatora już tu nie ma (odłączony): wynik nie przepada, idzie tam, gdzie agent zgłasza się sam
            for n in self.report_chats(speaker or ""):
                self.chats[n].send(text)
            return
        now = self.talking.get(name)
        if speaker and kind == "channel" and now and now != speaker and speaker in self.agents:
            old = self.agents.get(now)
            self.talking[name] = speaker
            if old:
                text += f"\n\nDalej piszesz z «{self.agents[speaker]['name']}». @{old['name']} wraca do «{old['name']}»."
        if c.send(text):
            self.voice_out(c, text, spoken)

    def cancel(self, key: str) -> None:
        p = self.post(key)
        if not p or p["state"] not in ("queued", "working"):
            return
        self.set_post(key, state="failed", finished=_now_iso(), cancelled=True)
        q = self.queues.get(p["to"]) or []
        hit = next((m for m in q if m.get("post") == key), None)
        if hit:
            q.remove(hit)
            if hit.get("reply"):
                hit["reply"]("", False)
        elif (self.current.get(p["to"]) or {}).get("post") == key:
            self.interrupt(p["to"])

    def interrupt(self, aid: str) -> None:
        e = self.engines.get(aid)
        if e and (e.busy or aid in self.current):
            self.stopped.add(aid)
            e.send({"type": "interrupt"})

    def stop_agent(self, aid: str) -> int:
        n = 1 if aid in self.current else 0
        self.interrupt(aid)
        for m in self.queues.pop(aid, []):
            n += 1
            if m.get("reply"):
                m["reply"]("", False)
            if m.get("post"):
                self.set_post(m["post"], state="failed", finished=_now_iso())
        return n

    # ── zgody ──
    def on_ask(self, aid: str, engine, ev: dict) -> None:
        a = self.agents.get(aid) or {}
        engine.ask_id = str(ev.get("id"))
        key = _host_key()
        self.asks[key] = (aid, engine.ask_id)
        question = f"«{a.get('name', '')}» pyta:\n{ev.get('pytanie') or ''}" + ("\n\n" + str(ev.get("szczegol"))[:900] if ev.get("szczegol") else "")
        self.log(aid, "info", question, src="ask")
        m = self.current.get(aid) or {}
        back = m.get("back") or ("here", aid)
        where = [back[1]] if back[0] == "channel" and len(back) > 1 else (self.report_chats(back[1]) if back[0] == "reports" else [])
        where = [n for n in where if n in self.chats]
        # prośba z pracy w tle czeka przez godziny ciszy (chyba że agent może budzić); zegar rusza, gdy dotrze
        until = self.quiet_end() if where and m and self.is_background(m) and not a.get("may_wake") else None
        self.push({"ev": "ask", "agent": aid, "key": key, "question": ev.get("pytanie") or "", "detail": str(ev.get("szczegol") or "")[:4000],
                   **({"held_until": until} if until else {})})
        if until:
            self.held_asks.append({"key": key, "agent": aid, "text": question, "where": where, "until": until})
        else:
            self.ask_out(key, question, where)
        self.dirty = True

    def ask_out(self, key: str, question: str, where: list) -> None:
        """Pytanie idzie na komunikatory z przyciskami; bez odpowiedzi przez kwadrans kończy się odmową."""
        for n in where:
            if n in self.chats:
                self.chats[n].send(question, buttons=[[("Zezwól", "ay|" + key), ("Odmów", "an|" + key)]])

        def expire() -> None:
            if key in self.asks:
                self.answer_ask(key, 0)
        self.after(_CALM_ASK_EXPIRY, expire)

    def answer_ask(self, key: str, value: int) -> bool:
        hit = self.asks.pop(key, None)
        if not hit:
            return False
        aid, ask_id = hit
        e = self.engines.get(aid)
        if e and e.ask_id == ask_id:
            e.send({"type": "answer", "id": ask_id, "value": int(value)})
            e.ask_id = None
            self.dirty = True
            return True
        return False

    # ── regularne sprawdzanie ──
    def check_beats(self) -> None:
        import datetime as _dt
        now = self.clock()
        hour = _dt.datetime.fromtimestamp(now).hour
        for aid in self.order:
            a = self.agents[aid]
            beat = a.get("beat") or {}
            minutes = int(beat.get("minutes") or 0)
            if minutes <= 0:
                continue
            modern = _beat_modern(beat)
            tz, planned = (_beat_tz(beat.get("zone")) if modern else None), None
            if modern:
                # harmonogram z nowego okna Codo: dni tygodnia, dokładna minuta w strefie Maca, dni kalendarzowe
                plan, last = _beat_plan(beat), _beat_last(beat)
                self.note_missed(aid, beat, plan, last, now, tz)
                planned = _beat_planned(plan, last, now, tz)
                if planned is None:
                    continue
            else:
                lo, hi = int(beat.get("from", 8)), int(beat.get("to", 22))
                inside = True if lo == hi else (lo <= hour < hi if lo < hi else (hour >= lo or hour < hi))
                if not inside or now - float(beat.get("last") or 0) < minutes * 60:
                    continue
            if aid in self.current or any(m["origin"][0] == "beat" for m in self.queues.get(aid) or []):
                continue
            beat["last"] = now
            a["beat"] = beat
            self.save_agents()
            if planned is not None and minutes >= _BEAT_DAY and _beat_caught_up(planned, now, self.awake_since):
                self.beat_note(aid, "caught_up", planned,
                               f"Regularne sprawdzenie zaplanowane na {_beat_when(planned, tz)} wykonane teraz, o {_beat_when(now, tz)}: "
                               "o tamtej porze gospodarz na serwerze nie działał. Nadrabia je jedno sprawdzenie.")
            # „days” zna ten gospodarz sam, więc bierze listę bez linii o milczeniu w pozostałe dni
            lst = str((beat.get("list_plain", beat.get("list")) if "days" in beat else beat.get("list")) or "").strip()
            stamp = _beat_wall(now, tz).strftime("%d.%m.%Y, %H:%M")
            what = ("Przejdź po kolei swoją listę:\n" + lst) if lst else \
                "Rozejrzyj się w tym, czym się zajmujesz (Twój folder, Twoje zadania, nasza rozmowa) i sprawdź, czy coś wymaga uwagi użytkownika."
            self.tell(aid, f"[Twoje regularne sprawdzenie: {stamp}]\n{what}\n\nDziałaj tylko w swoim zakresie i nie zaczynaj dużych "
                           "prac bez prośby. Gdy nic nie wymaga uwagi użytkownika, odpowiedz dokładnie jednym słowem: CISZA. Gdy coś "
                           "wymaga, napisz krótko co i dlaczego, bez wstępów: to trafi do niego jako wiadomość.", ("beat",))

    def note_missed(self, aid: str, beat: dict, plan: dict, last, now: float, tz) -> None:
        """Zaplanowana pora, która minęła i nie będzie nadrobiona, zostawia jedną linię w dzienniku agenta, raz."""
        missed = _beat_missed(plan, last, now, tz)
        if missed is None or beat.get("skipped") == missed:
            return
        beat["skipped"] = missed
        self.agents[aid]["beat"] = beat
        self.save_agents()
        why = "gospodarz na serwerze nie działał do końca tamtego dnia" if _beat_exact(plan) is not None \
            else "gospodarz na serwerze nie działał w godzinach sprawdzania"
        line = f"Regularne sprawdzenie zaplanowane na {_beat_when(missed, tz)} zostało pominięte: {why}."
        nxt = _beat_next(plan, last, now, tz)
        if nxt is not None:
            line += f" Następne sprawdzenie o {_beat_when(nxt, tz)}."
        self.beat_note(aid, "skipped", missed, line)

    def beat_note(self, aid: str, what: str, planned: float, line: str) -> None:
        """Linia o nadrobionym albo pominiętym sprawdzeniu: w dzienniku agenta, w jego rozmowie i w logu gospodarza."""
        self.log(aid, "info", line, src="beat")
        self.trace(aid, {"type": "info", "tekst": line, "beat": what, "planned": int(planned)})
        print(f"[sprawdzanie] {(self.agents.get(aid) or {}).get('name', aid)}: {line}", flush=True)

    # ── spokojna praca w tle: dzienny limit i godziny ciszy ──
    def day_tz(self):
        """Strefa, w której liczy się dzień limitu: „zone” z agents.json, potem strefa ciszy, potem harmonogramu agentów."""
        quiet = self.extra.get("quiet") if isinstance(self.extra.get("quiet"), dict) else {}
        names = [self.extra.get("zone"), quiet.get("zone")] + [(self.agents[i].get("beat") or {}).get("zone") for i in self.order]
        return next((tz for tz in (_beat_tz(n) for n in names if n) if tz), None)

    def spend_today(self) -> dict:
        day = _calm_day(self.clock(), self.day_tz())
        s = self.spend
        if not isinstance(s, dict) or s.get("day") != day or not isinstance(s.get("agents"), dict):
            self.spend = s = {"day": day, "agents": {}, "noticed": []}
        if not isinstance(s.get("noticed"), list):
            s["noticed"] = []
        return s

    def limits(self, aid: str) -> tuple:
        """(dzienny limit agenta, wspólny limit wszystkich); 0 = bez limitu."""
        return _calm_int((self.agents.get(aid) or {}).get("limit"), _CALM_LIMIT), _calm_int(self.extra.get("cap"), _CALM_CAP)

    def limit_stop(self, aid: str) -> str:
        """Dlaczego agent nie pracuje już dziś w tle: "agent", "all" albo ""."""
        rows = self.spend_today()["agents"]
        limit, cap = self.limits(aid)
        return _calm_stop(_calm_used(rows.get(aid)), limit, sum(_calm_used(r) for r in rows.values()), cap)

    def is_background(self, m: dict) -> bool:
        return _calm_background(_calm_kind(m.get("origin"), bool(m.get("deliver"))), bool(m.get("by_you")), int(m.get("depth") or 0))

    def count_turn(self, aid: str, engine, ev: dict) -> None:
        """Koniec tury: koszt z licznika kredytów silnika; tura z pracy w tle dolicza się do dzisiejszego wydatku agenta."""
        spent, seen = _calm_cost(ev.get("credits"), float(getattr(engine, "credits_seen", 0) or 0))
        engine.credits_seen = seen
        m = self.current.get(aid)
        if not m or not self.is_background(m):
            return
        s = self.spend_today()
        s["agents"][aid] = _calm_add(s["agents"].get(aid), spent)
        _host_save("wydatki.json", s)
        self.dirty = True

    def closed(self, aid: str):
        """Limit zatrzymał pracę w tle: użytkownik słyszy o tym raz tego dnia (który agent, dlaczego, jak podnieść limit).
        Zwraca linię dla tego, kto prosił, albo None (wolno)."""
        a = self.agents.get(aid)
        why = self.limit_stop(aid) if a else ""
        if not why:
            return None
        s = self.spend_today()
        limit, cap = self.limits(aid)
        key = aid if why == "agent" else "all"
        if key not in s["noticed"]:
            s["noticed"].append(key)
            _host_save("wydatki.json", s)
            if why == "agent":
                text = (f"«{a['name']}» do jutra nie pracuje w tle: wyczerpał swój dzienny limit ({_calm_limit_words(limit, s['agents'].get(aid))}). "
                        "To, co napiszesz do niego samodzielnie, nadal działa. Aby podnieść limit, otwórz jego ustawienia w Codo: "
                        "Dzienny limit pracy w tle.")
            else:
                text = (f"Twoi agenci do jutra nie pracują w tle: razem wyczerpali dzienny limit ({cap} 𝔻). To, co napiszesz do nich "
                        "samodzielnie, nadal działa. Aby podnieść limit, otwórz w Codo Ustawienia, Ogólne: Agenci w tle.")
            self.log(aid, "info", text, src="limit")
            self.trace(aid, {"type": "info", "tekst": text, "limit": why})
            self.report(aid, text)
            self.dirty = True
        return f"«{a['name']}» nie wykonuje dziś więcej pracy w tle: dzienny limit jest wyczerpany. Wróci do niej jutro."

    def quiet_end(self, now: float | None = None):
        """Kiedy kończą się godziny ciszy, które trwają teraz (None: teraz nie ma ciszy)."""
        cfg = _calm_quiet_cfg(self.extra.get("quiet"))
        if not cfg:
            return None
        return _calm_quiet_end(self.clock() if now is None else now, cfg[0], cfg[1], _beat_tz(cfg[2]))

    def report(self, aid: str, text: str) -> None:
        """Znalezisko ze sprawdzania albo wynik pracy w tle: na komunikatory, na które agent zgłasza się sam. W godzinach
        ciszy czeka, a wszystko, co agent wstrzymał, przychodzi po nich jedną wiadomością."""
        if self.quiet_end() is None:
            self.send_report(aid, text)
            return
        rows = self.held.setdefault(aid, [])
        rows.append({"at": round(self.clock(), 1), "text": str(text)[:20000]})
        del rows[:-_CALM_HELD_MAX]
        self.save_held()
        self.dirty = True

    def send_report(self, aid: str, text: str) -> None:
        for n in self.report_chats(aid):
            if self.chats[n].send(text):
                self.voice_out(self.chats[n], text)

    def save_held(self) -> None:
        _host_save("cisza.json", self.held)

    def flush_held(self) -> None:
        held, self.held = self.held, {}
        self.save_held()
        quiet = self.extra.get("quiet") if isinstance(self.extra.get("quiet"), dict) else {}
        tz = _beat_tz(quiet.get("zone")) or self.day_tz()
        for aid, items in held.items():
            text = _calm_digest(items, (self.agents.get(aid) or {}).get("name") or "", tz)
            if text:
                self.send_report(aid, text)
        self.dirty = True

    def calm_tick(self, now: float) -> None:
        """Koniec godzin ciszy: wstrzymane zgłoszenia wychodzą jedną wiadomością na agenta, a wstrzymane prośby o zgodę
        idą na komunikatory i dopiero od tej chwili liczy się ich kwadrans."""
        if not self.held and not self.held_asks:
            return
        loud = self.quiet_end(now) is None
        if self.held and loud:
            self.flush_held()
        for w in list(self.held_asks):
            if w["key"] not in self.asks:
                self.held_asks.remove(w)     # odpowiedziano w oknie Codo
            elif loud or now >= w["until"]:
                self.held_asks.remove(w)
                self.ask_out(w["key"], w["text"], w["where"])
                self.dirty = True

    def calm_state(self) -> dict:
        """Dzisiejsza praca w tle, limity, kto stoi i godziny ciszy: dla okna Codo i `codo host status --json`."""
        s = self.spend_today()
        rows = s["agents"]
        cfg = _calm_quiet_cfg(self.extra.get("quiet"))
        total = {"credits": round(sum(float(r.get("credits") or 0) for r in rows.values()), 4),
                 "turns": sum(int(r.get("turns") or 0) for r in rows.values()),
                 "unpriced": sum(int(r.get("unpriced") or 0) for r in rows.values())}
        total["used"] = round(_calm_used(total), 4)
        return {"day": s["day"], "cap": _calm_int(self.extra.get("cap"), _CALM_CAP), "spend": total,
                "stopped": {i: self.limit_stop(i) for i in self.order if self.limit_stop(i)}, "noticed": list(s["noticed"]),
                "quiet": {"on": bool(cfg), "from": cfg[0] if cfg else None, "to": cfg[1] if cfg else None,
                          "zone": cfg[2] if cfg else "", "until": self.quiet_end()},
                "held": {i: len(v) for i, v in self.held.items() if v}, "held_asks": [w["key"] for w in self.held_asks]}

    def calm_agent(self, aid: str) -> dict:
        row = self.spend_today()["agents"].get(aid) or {}
        return {"limit": self.limits(aid)[0], "stopped": self.limit_stop(aid), "may_wake": bool(self.agents[aid].get("may_wake")),
                "spend": {"credits": float(row.get("credits") or 0), "turns": int(row.get("turns") or 0),
                          "unpriced": int(row.get("unpriced") or 0), "used": round(_calm_used(row), 4)}}

    # ── komunikatory (Telegram, Discord, Slack, WhatsApp) ──
    def on_telegram(self, u: dict) -> None:
        """Surowa aktualizacja Telegrama (testy i stare wywołania) na wspólne zdarzenie komunikatora."""
        cb = u.get("callback_query")
        if cb:
            chat = (cb.get("message") or {}).get("chat", {}).get("id")
            cid = str(cb.get("id"))
            self.on_chat("telegram", {"button": str(cb.get("data") or ""), "who": str(chat), "where": chat,
                                      "ack": lambda t: self.tg.answer_cb(cid, t)})
            return
        msg = u.get("message") or {}
        chat = (msg.get("chat") or {}).get("id")
        if chat is not None:
            self.on_chat("telegram", {"text": str(msg.get("text") or "").strip(), "who": str(chat), "where": chat})

    def on_chat(self, name: str, ev: dict) -> None:
        c = self.chats.get(name)
        if c is None:
            return
        cfg = c.cfg
        who, where = str(ev.get("who") or ""), ev.get("where")
        owner = cfg.get("owner")
        mine = (str(owner) == who) if owner else (cfg.get("chat") is not None and str(cfg.get("chat")) == str(where))
        relayed = getattr(c, "name", name) == "whatsapp" or bool(getattr(c, "relayed", False))
        if relayed:
            mine = True               # numer albo czat i właściciela paruje DomaAI
        if ev.get("button") is not None:
            if not mine:
                return
            parts = str(ev["button"]).split("|")
            ok = False
            if len(parts) == 2 and parts[0] in ("ay", "an"):
                ok = self.answer_ask(parts[1], 1 if parts[0] == "ay" else 0)
            # Przycisk, którego tu nikt nie zna (wysłany z Maca przed przeniesieniem albo już rozstrzygnięty): krótko,
            # zamiast ciszy.
            note = ("Zezwolono" if parts[0] == "ay" else "Odmówiono") if ok else _HOST_STALE_BUTTON
            if ev.get("ack"):
                ev["ack"](note)
            elif not ok:
                c.send("→ " + note)
            return
        text = str(ev.get("text") or "").strip()
        if not text:
            return
        if not cfg.get("owner") and not cfg.get("chat") and name != "whatsapp" and not relayed:
            if cfg.get("code") and re.sub(r"\D", "", text) == str(cfg["code"]):
                cfg["chat"] = where
                if name != "telegram":
                    cfg["owner"] = who
                cfg.pop("code", None)
                _host_save(f"{name}.json", cfg)
                c.send("Połączono z Codo na Twoim serwerze.\n\n" + self.tg_help(c))
            return
        if not mine:
            return
        if where is not None and str(where) != str(cfg.get("chat")) and not getattr(c, "relayed", False):
            cfg["chat"] = where      # odpisujemy tam, skąd właściciel napisał ostatnio (prywatnie albo na kanale)
            _host_save(f"{name}.json", cfg)
        word = text.split()[0].lower().split("@")[0]
        talking = self.talking.get(name)
        if word in ("/start", "/help", "/pomoc"):
            c.send(self.tg_help(c))
        elif word in ("/agents", "/agenci", "/status", "/stan"):
            c.send("Agenci na serwerze\n" + "\n".join(f"• {self.agents[i]['name']}: {self.line(self.agents[i])}" for i in self.order)
                   + "\n\nNapisz @Nazwa i wiadomość. Dalej pisz już bez @; /koniec kończy rozmowę.")
        elif word in ("/end", "/koniec"):
            old = self.agents.get(talking or "")
            self.talking.pop(name, None)
            c.send(f"Rozmowa z «{old['name']}» zakończona. @{old['name']} zaczyna ją znowu." if old else "Nie rozmawiasz z żadnym agentem.")
        elif word in ("/glos", "/głos", "/voice"):
            if not getattr(c, "speaks", True):
                c.send("Tutaj odpowiadam tylko tekstem." + (" Wiadomości głosowe odsłuchuję i odpisuję na nie tekstem."
                                                            if getattr(c, "hears", False) else ""))
                return
            arg = (text.split(None, 1)[1].strip().lower() if len(text.split(None, 1)) > 1 else "")
            mode = {"auto": "auto", "zawsze": "always", "always": "always", "wyłącz": "off", "wylacz": "off", "wyłączony": "off",
                    "off": "off", "nie": "off", "wył": "off"}.get(arg)
            if mode:
                cfg["voice"] = mode
                _host_save(f"{name}.json", cfg)
            now = {"auto": "głosem odpowiadam tylko na wiadomości głosowe", "always": "odpowiadam zawsze także głosem",
                   "off": "odpowiadam tylko tekstem"}[getattr(c, "voice_mode", "auto")]
            c.send(("Ustawione: " if mode else "Teraz: ") + now + ".\n/glos auto, /glos zawsze albo /glos wyłącz zmienia to.")
        elif word == "/stop":
            n = sum(self.stop_agent(i) for i in list(self.order))
            c.send(f"Zatrzymano: {n}" if n else "Nic teraz nie pracuje.")
        elif word in ("/przekaz", "/przekaż", "/handover", "/pass"):
            src = self.agents.get(talking or "")
            to = self.find(text.split(None, 1)[1] if len(text.split(None, 1)) > 1 else "", than=(src or {}).get("id"))
            if not src:
                c.send("Najpierw napisz do agenta (@Nazwa i wiadomość), potem /przekaz Nazwa odda mu to zadanie.")
            elif not to:
                others = [self.agents[i]["name"] for i in self.order if i != src["id"]]
                c.send(("Komu przekazać? /przekaz i jedno z: " + ", ".join(others)) if others else "Nie ma innego agenta, któremu można to przekazać.")
            elif self.hand_over(src["id"], to["id"], ("channel", name)):
                self.talking[name] = to["id"]
                c.send(f"Przekazane: «{to['name']}». Dalej piszesz z nim, odpowiedź przyjdzie tutaj.")
            else:
                c.send(f"W rozmowie z «{src['name']}» nie ma jeszcze Twojej prośby do przekazania.")
        else:
            target, body = None, text
            if ev.get("voice") and not text.startswith("@"):
                # na głos nikt nie mówi „@”: „Badacz, sprawdź ceny” też trafia do Badacza
                said = re.sub(r"^(do|hej|cześć|halo)\s+", "", text, flags=re.I)
                hit = max((self.agents[i] for i in self.order if re.match(re.escape(self.agents[i]["name"]) + r"\b", said, re.I)),
                          key=lambda a: len(a["name"]), default=None)
                if hit:
                    text = "@" + hit["name"] + said[len(hit["name"]):]
            if text.startswith("@"):
                rest = text[1:]
                hit = max((self.agents[i] for i in self.order if rest.lower().startswith(self.agents[i]["name"].lower())),
                          key=lambda a: len(a["name"]), default=None)
                if not hit:
                    c.send("Nie ma agenta o tej nazwie. /agenci pokaże listę.")
                    return
                target, body = hit, rest[len(hit["name"]):].strip(" :,.\n")
            elif talking in self.agents:
                target = self.agents[talking]
            elif len(self.order) == 1:
                target = self.agents[self.order[0]]
            if not target:
                c.send("Do kogo? Napisz @Nazwa i wiadomość. /agenci pokaże listę.")
                return
            first = talking != target["id"]
            self.talking[name] = target["id"]
            if not body:
                c.send(f"Rozmawiasz z «{target['name']}». Pisz; /koniec kończy.")
                return
            line = self.tell(target["id"], body, ("channel", name), voice=bool(ev.get("voice")))
            notes = ([f"Rozmawiasz z «{target['name']}». Pisz dalej bez @, /koniec kończy."] if first else []) + ([line] if line else [])
            if notes:
                c.send("\n".join(notes))

    @staticmethod
    def tg_help(c=None) -> str:
        """Pomoc komunikatora; o głosie tylko to, co ten komunikator naprawdę umie (bez `c`: pełna, jak dawniej)."""
        hears = True if c is None else bool(getattr(c, "hears", False))
        speaks = True if c is None else bool(getattr(c, "speaks", False))
        voice = ("\n\nMożesz też nagrać wiadomość głosową." if speaks else
                 "\n\nMożesz też nagrać wiadomość głosową; odpowiem tekstem.") if hears else ""
        return ("Twoi stali agenci pracują na serwerze także wtedy, gdy Mac jest wyłączony.\n\n"
                "@Agent wiadomość: rozmowa ze stałym agentem, dalej piszesz już bez @\n"
                "/agenci: agenci i co robią\n/przekaz Nazwa: oddaj ostatnią prośbę innemu agentowi\n"
                "/koniec: kończy rozmowę z agentem\n" + ("/glos auto|zawsze|wyłącz: odpowiedzi głosem\n" if speaks else "")
                + "/stop: zatrzymuje wszystko" + voice)

    def hand_over(self, src: str, dst: str, back) -> bool:
        a, b = self.agents.get(src), self.agents.get(dst)
        if not a or not b or src == dst:
            return False
        asked = said = ""
        for it in reversed(self.history(src, 60)):
            if it["role"] == "user" and it.get("src") in ("mac", "channel") and not asked:
                asked = it["text"]
                break
            if it["role"] == "assistant" and not said:
                said = it["text"]
        if not asked:
            return False
        text = asked + (f"\n\nCo dotąd odpowiedział «{a['name']}»:\n" + said[:3000] if said.strip() else "")
        import time
        p = {"id": _host_key(), "kind": "handoff", "from": src, "from_name": a["name"], "to": dst, "to_name": b["name"],
             "chain": [src, dst], "title": _host_headline(asked), "text": text, "files": [], "back": list(back),
             "state": "queued", "created": _now_iso(), "finished": None, "answer": "", "depth": 1, "wants_reply": False, "retries": 0,
             "by_you": True}    # przekazał użytkownik (/przekaz albo okno): to nie praca w tle
        self.posts.append(p)
        self.sent.append(time.time())
        self.save_posts()
        self.tell(dst, self.brief(p), ("handoff", p["id"]), back=tuple(back), depth=1, post=p["id"])
        return True

