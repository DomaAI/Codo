def t_outline(args):
    """Struktura pliku: klasy/funkcje (Python przez ast, JS/TS regexem) —
    szybka nawigacja bez czytania całości."""
    path = _safe_path(args["path"])
    src = path.read_text(errors="replace")
    suf = path.suffix.lower()
    lines = []
    if suf == ".py":
        import ast as _ast
        try:
            tree = _ast.parse(src)
        except SyntaxError as e:
            return f"BŁĄD składni {path.name}:{e.lineno}: {e.msg}"
        for node in _ast.walk(tree):
            if isinstance(node, (_ast.FunctionDef, _ast.AsyncFunctionDef)):
                lines.append((node.lineno, f"def {node.name}()"))
            elif isinstance(node, _ast.ClassDef):
                lines.append((node.lineno, f"class {node.name}"))
    elif suf in (".js", ".mjs", ".cjs", ".ts", ".tsx", ".jsx"):
        pat = re.compile(
            r"^\s*(?:export\s+)?(?:default\s+)?"
            r"(?:(?:async\s+)?function\s+(\w+)|class\s+(\w+)"
            r"|(?:const|let|var)\s+(\w+)\s*=\s*(?:async\s*)?(?:\([^)]*\)|\w+)\s*=>)",
            re.M)
        for m in pat.finditer(src):
            name = m.group(1) or m.group(2) or m.group(3)
            kind = "class" if m.group(2) else "fn"
            lines.append((src[:m.start()].count("\n") + 1, f"{kind} {name}"))
    else:
        return f"outline wspiera .py/.js/.ts (dostałem {suf or 'plik bez rozszerzenia'})."
    lines.sort()
    if not lines:
        return f"{path.name}: brak funkcji/klas na poziomie pliku."
    return f"{path.name} ({len(src.splitlines())} linii):\n" + "\n".join(
        f"  {ln:>5}  {sig}" for ln, sig in lines[:200])


def t_preview(args):
    """Żywy podgląd: statyczny serwer HTTP w tym katalogu. preview_action:
    start (domyślnie) | stop | status. Zwraca URL."""
    import socket as _sock
    import time as _time
    act = (args.get("preview_action") or "start").lower()
    port = int(args.get("port") or 8080)
    pidfile = Path.cwd() / _DOMA_DIR / "preview.pid"
    pidfile.parent.mkdir(parents=True, exist_ok=True)

    def _alive():
        if not pidfile.exists():
            return False
        try:
            return _pid_alive(int(pidfile.read_text()))
        except Exception:
            return False

    if act == "stop":
        if _alive():
            try:
                _pid_terminate(int(pidfile.read_text()))
            except Exception:
                pass
        pidfile.unlink(missing_ok=True)
        return "Podgląd zatrzymany."

    ip = "127.0.0.1"
    try:
        s = _sock.socket(_sock.AF_INET, _sock.SOCK_DGRAM)
        s.connect(("8.8.8.8", 80)); ip = s.getsockname()[0]; s.close()
    except Exception:
        pass

    if act == "status":
        return (f"Podgląd DZIAŁA: http://{ip}:{port}/" if _alive()
                else "Podgląd nie jest uruchomiony (preview_action=start).")

    if _alive():
        return f"Podgląd już działa: http://{ip}:{port}/"
    proc = subprocess.Popen(
        [_python_cmd(), "-m", "http.server", str(port), "--bind", "0.0.0.0"],
        cwd=str(Path.cwd()), stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,
    )
    pidfile.write_text(str(proc.pid))
    _time.sleep(0.5)
    if not _alive():
        return f"Nie udało się wystartować podglądu na porcie {port} (zajęty?)."
    return (f"Podgląd na żywo: http://{ip}:{port}/\n"
            f"(serwer statyczny w tym katalogu. Jeśli nie otwiera się z zewnątrz, "
            f"otwórz port {port} w firewall. Zatrzymanie: preview_action=stop)")


