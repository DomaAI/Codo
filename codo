def save_created_agent(msg: dict, local_only: bool = False, settings: bool = True) -> dict:
    """Zapisuje agenta z kreatora: na koncie DomaAI albo lokalnie (także gdy serwer zawiódł: local_only).
    `settings=False`: ustawienia Maca zapisał już wołający (okno zapisuje je w głównej pętli, przed wątkiem).
    Zwraca profil jak load_agent_profile."""
    d = _clean_agent(msg)
    if settings:
        save_created_agent_settings(msg)
    token = None if local_only else (device_access_token() or (load_creds() or {}).get("access_token"))
    if token:
        body = {"nazwa": d["agent"], "kolor_orba": d["kolor_agenta"], "kolory_orba": d["kolory_agenta"],
                "kolor_oczu": d["kolor_oczu"], "ton": d["ton"], "cechy": d["cechy"],
                "przezroczystosc": d["przezroczystosc"], "przezroczystosc_plynu": d["przezroczystosc_plynu"]}
        if d["udzialy_kolorow"]:
            body["udzialy_kolorow"] = d["udzialy_kolorow"]
        if d["prompt"]:
            body["prompt"] = d["prompt"]
        _http("PUT", "/agent/profil", json_body=body, token=token, timeout=15, retries=1)
        fam = _domaai_brain_family(str(msg.get("brain") or ""))
        if fam is not None:
            try:   # osobno: model spoza planu nie może zepsuć zapisu wyglądu i charakteru
                _http("PUT", "/agent/profil", json_body={"model_glowny": fam}, token=token, timeout=15, retries=0)
            except (ApiError, urllib.error.URLError, OSError):
                pass  # nosec B110 — mózg w Codo i tak ustawiony lokalnie
        who = _http("GET", "/cli/whoami", token=token, timeout=8, retries=0)
        prof = save_agent_profile(who)
    else:
        prof = dict(d, persona=_local_persona(d))
        CONFIG_DIR.mkdir(parents=True, exist_ok=True)
        # Zalogowany, a serwer zawiódł: profil konta czyta AGENT_FILE, więc tam też trafia nowa wersja.
        target = AGENT_FILE if (local_only and (load_device() or load_creds())) else AGENT_LOCAL_FILE
        if target == AGENT_FILE:
            try:
                old = json.loads(AGENT_FILE.read_text(encoding="utf-8"))
                prof = dict(old if isinstance(old, dict) else {}, **prof)
            except (OSError, ValueError):
                pass  # nosec B110 — brak starego profilu: zostaje sam nowy
        fd = os.open(str(target), os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600)
        with os.fdopen(fd, "w", encoding="utf-8") as f:
            json.dump(prof, f, ensure_ascii=False)
    return prof


