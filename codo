def _trig_mail_heads(cfg: dict, after: int, validity: int) -> dict:
    """Nagłówki nowej poczty w skrzynce kanału e-mail: nic nie jest otwierane ani oznaczane jako przeczytane.
    {"validity", "last", "mails": [{"uid", "from", "name", "subject"}]} albo {"error"}. Pierwsze spojrzenie (after 0
    albo inna skrzynka) tylko zapamiętuje, gdzie jest koniec."""
    import email as _email
    import email.policy as _policy
    import imaplib
    try:
        host, port = str(cfg.get("imap_host") or ""), int(cfg.get("imap_port") or 993)
        if port == 143:
            m = imaplib.IMAP4(host, port, timeout=30)
            m.starttls()
        else:
            m = imaplib.IMAP4_SSL(host, port, timeout=30)
        m.login(str(cfg.get("user") or ""), str(cfg.get("password") or ""))
    except (OSError, ValueError, imaplib.IMAP4.error) as exc:
        return {"error": str(exc)[:200]}
    try:
        typ, data = m.status("INBOX", "(UIDNEXT UIDVALIDITY)")
        line = (data[0] or b"").decode("latin-1") if typ == "OK" and data else ""
        nxt = re.search(r"UIDNEXT (\d+)", line)
        val = re.search(r"UIDVALIDITY (\d+)", line)
        if not nxt or not val:
            return {"error": "INBOX"}
        v, last = int(val.group(1)), int(nxt.group(1)) - 1
        if after <= 0 or v != validity or last <= after:
            return {"validity": v, "last": max(last, 0) if (after <= 0 or v != validity) else after, "mails": []}
        m.select("INBOX", readonly=True)
        lo = max(after + 1, last - 49)
        typ, got = m.uid("FETCH", f"{lo}:{last}", "(UID BODY.PEEK[HEADER.FIELDS (FROM SUBJECT)])")
        mails = []
        for x in got or []:
            if not isinstance(x, tuple) or len(x) < 2:
                continue
            u = re.search(rb"UID (\d+)", x[0] or b"")
            if not u or int(u.group(1)) <= after:
                continue
            msg = _email.message_from_bytes(x[1] or b"", policy=_policy.default)
            addr, name = _trig_address(str(msg.get("From") or ""))
            mails.append({"uid": int(u.group(1)), "from": addr, "name": name, "subject": str(msg.get("Subject") or "")})
        mails.sort(key=lambda r: r["uid"])
        return {"validity": v, "last": max([last] + [r["uid"] for r in mails]), "mails": mails}
    except (OSError, ValueError, imaplib.IMAP4.error) as exc:
        return {"error": str(exc)[:200]}
    finally:
        try:
            m.logout()
        except (OSError, imaplib.IMAP4.error):
            pass


def _trig_hook_cfg() -> dict:
    """Lokalny serwer webhooków: host/webhook.json {"bind", "port", "public"}; domyślnie 127.0.0.1:8789.
    "public": adres, pod którym serwer widać z zewnątrz (np. https://moj.serwer.pl:8789), do linku w oknie."""
    c = _host_load("webhook.json", {})
    c = c if isinstance(c, dict) else {}
    try:
        port = int(os.environ.get("CODO_HOOK_PORT") or c.get("port") or _TRIG_HOOK_PORT)
    except (TypeError, ValueError):
        port = _TRIG_HOOK_PORT
    bind = str(c.get("bind") or "127.0.0.1")
    shown = bind if bind not in ("", "0.0.0.0", "::") else "127.0.0.1"   # nosec B104 — tylko do podpisu
    base = str(c.get("public") or f"http://{shown}:{port}").rstrip("/")
    return {"bind": bind, "port": port, "base": base}


def _trig_hook_serve(bind: str, port: int, check, on_event):
    """Serwer webhooków (POST /hook/<id> z kluczem w nagłówku Authorization: Bearer …). Bez zależności."""
    import http.server

    class _Hook(http.server.BaseHTTPRequestHandler):
        server_version = "codo-host"

        def log_message(self, *args) -> None:
            pass

        def _out(self, code: int, obj: dict) -> None:
            data = json.dumps(obj).encode()
            self.send_response(code)
            self.send_header("Content-Type", "application/json")
            self.send_header("Content-Length", str(len(data)))
            self.end_headers()
            self.wfile.write(data)

        def do_GET(self) -> None:
            self._out(405, {"ok": False, "error": "POST"})

        def do_POST(self) -> None:
            u = urllib.parse.urlsplit(self.path)
            m = re.fullmatch(r"/hook/([A-Za-z0-9_-]{8,64})/?", u.path)
            if not m:
                return self._out(404, {"ok": False})
            qs = urllib.parse.parse_qs(u.query)
            auth = str(self.headers.get("Authorization") or "")
            key = auth[7:].strip() if auth.lower().startswith("bearer ") else str(self.headers.get("X-Codo-Key") or "")
            if not check(m.group(1), key):
                return self._out(401, {"ok": False})
            try:
                n = int(self.headers.get("Content-Length") or 0)
            except ValueError:
                n = 0
            if n > _TRIG_HOOK_MAX:
                return self._out(413, {"ok": False})
            body = self.rfile.read(n).decode("utf-8", "replace") if n > 0 else ""
            event = (self.headers.get("X-GitHub-Event") or self.headers.get("X-Event-Key") or self.headers.get("X-Event")
                     or (qs.get("event") or [""])[0])
            on_event(m.group(1), body, str(event or ""))
            self._out(202, {"ok": True})

    try:
        srv = _http_server((bind, port), _Hook)
    except OSError as exc:
        print(f"[wyzwalacze] serwer webhooków nie wstał na {bind}:{port}: {exc}", flush=True)
        return None
    srv.daemon_threads = True
    threading.Thread(target=srv.serve_forever, daemon=True).start()
    return srv


def _trig_hash(key: str) -> str:
    import hashlib
    return hashlib.sha256(str(key or "").encode()).hexdigest()


class HostTriggers:
    """Wyzwalacze stałych agentów u gospodarza (AgentTriggers.swift): pętla gospodarza woła tick() co 2 s.
    Prace, które czekają (gh, IMAP), idą w tle; ich wynik wraca do kolejki gospodarza zdarzeniem "call"."""

    def __init__(self, host):
        self.h = host
        self.batches: dict = {}
        self.snaps: dict = {}           # wyzwalacz folderu → (folder, stan plików)
        self.last_scan: dict = {}
        self.last_busy: dict = {}
        self.own_noted: set = set()
        self.last_pr: dict = {}
        self.looking: set = set()
        self.last_mail = 0.0
        self.mail_looking = False
        self.had_mail = None
        st = _host_load("wyzwalacze.json", {})
        self.state = st if isinstance(st, dict) else {}
        hooks = _host_load("webhooki.json", {})
        self.hooks = hooks if isinstance(hooks, dict) else {}   # adres → {"agent", "key": skrót klucza, "made"}
        self.server = None
        # podstawiane w testach: bez sieci, bez gh, bez wątków
        self.pr_view = _trig_gh
        self.mail_heads = _trig_mail_heads
        self.serve = _trig_hook_serve
        self.spawn = lambda fn: threading.Thread(target=fn, daemon=True).start()

    def save(self) -> None:
        _host_save("wyzwalacze.json", self.state)

    def live(self) -> list:
        out = []
        for aid in self.h.order:
            for t in (self.h.agents.get(aid) or {}).get("triggers") or []:
                if _trig_works(t):
                    out.append((aid, t))
        return out

    def find(self, tid: str):
        return next(((aid, t) for aid, t in self.live() if t["id"] == tid), (None, None))

    def note(self, aid: str, t: dict, what: str, line: str) -> None:
        """Linia w LogBocie agenta i w logu gospodarza (nie w rozmowie: to nie jest wiadomość)."""
        self.h.trace(aid, {"type": "info", "tekst": line, "trigger": t.get("kind"), "what": what, "id": str(t.get("id"))})
        print(f"[wyzwalacz {what}] {(self.h.agents.get(aid) or {}).get('name', aid)}: {line}", flush=True)

    def tick(self, now: float) -> None:
        live = self.live()
        mail_now = any(t["kind"] == "mail" for _, t in live)
        if self.had_mail is False and mail_now:
            self.state["mail_validity"] = 0        # pierwszy wyzwalacz poczty po przerwie: liczy się poczta od teraz
            self.save()
        self.had_mail = mail_now
        self.listen(any(t["kind"] == "webhook" and t.get("hook") for _, t in live))
        if not live and not self.batches:
            self.snaps.clear()
            return
        for aid, _ in live:
            if aid in self.h.current:
                self.last_busy[aid] = now
            else:
                self.own_noted.discard(aid)
        self.look_folders(live, now)
        self.look_prs(live, now)
        self.look_mail(live, now)
        ids = {t["id"] for _, t in live}
        for k in [k for k in self.batches if k not in ids]:
            del self.batches[k]
        for aid, t in live:
            self.step(aid, t, now)

    # ── foldery: odpytywanie co kilka sekund ──
    def look_folders(self, live: list, now: float) -> None:
        want = {}
        for aid, t in live:
            p = _trig_expand(t.get("path")) if t["kind"] == "folder" else ""
            if p and os.path.isdir(p):
                want[t["id"]] = (aid, p)
        for k in [k for k in self.snaps if k not in want or self.snaps[k][0] != want[k][1]]:
            del self.snaps[k]
        for tid, (aid, p) in want.items():
            if now - self.last_scan.get(tid, 0.0) < _TRIG_SCAN_EVERY:
                continue
            self.last_scan[tid] = now
            snap = _trig_scan(p)
            old = self.snaps.get(tid)
            self.snaps[tid] = (p, snap)
            if old is not None:      # pierwsze spojrzenie: to, co już jest, nie jest nowością
                fresh = _trig_diff(old[1], snap)
                if fresh:
                    self.changed(tid, aid, fresh, now)

    def changed(self, tid: str, aid: str, paths: list, now: float) -> None:
        _, t = self.find(tid)
        a = self.h.agents.get(aid)
        if not t or not a:
            return
        root = _trig_expand(t.get("path"))
        fresh = [p for p in paths if not _trig_ignored(p, root)]
        busy = self.last_busy.get(aid)
        if fresh and (aid in self.h.current or (busy is not None and now - busy < _TRIG_OWN_WINDOW)):
            # to, co agent sam zapisuje na swoim biurku w trakcie pracy, nie jest dla niego nowością
            desk = os.path.realpath(str(self.h.desk(a)))
            own = [p for p in fresh if _trig_inside(os.path.realpath(p), desk)]
            fresh = [p for p in fresh if p not in own]
            if own and aid not in self.own_noted:
                self.own_noted.add(aid)
                self.note(aid, t, "own", f"{_trig_title(t)}: zmiany, które agent zrobił sam w trakcie pracy, się nie liczą.")
        if fresh:
            _trig_add(self.batches.setdefault(tid, _trig_batch()), fresh, now)

    # ── pull requesty: gh co dwie minuty na repozytorium ──
    def look_prs(self, live: list, now: float) -> None:
        mine = [t for _, t in live if t["kind"] == "pr" and _trig_expand(t.get("path"))]
        for path in sorted({_trig_expand(t.get("path")) for t in mine}):
            if path in self.looking or now - self.last_pr.get(path, 0.0) < _TRIG_LOOK_EVERY:
                continue
            self.last_pr[path] = now
            self.looking.add(path)
            tids = [t["id"] for t in mine if _trig_expand(t.get("path")) == path]

            def work(path=path, tids=tids) -> None:
                j = self.pr_view(path)
                self.h.q.put(("call", lambda: self.took_pr(path, j, tids)))
            self.spawn(work)

    def took_pr(self, path: str, j, tids: list) -> None:
        self.looking.discard(path)
        look = _trig_pr_look(j) if isinstance(j, dict) else None
        if not look or look["number"] <= 0:
            return
        seen_all = self.state.setdefault("pr_seen", {})
        for tid in tids:
            failed, notes, seen = _trig_pr_news(look, set(seen_all[tid]) if tid in seen_all else None)
            seen_all[tid] = sorted(seen)[-600:]
            num = look["number"]
            items = [f"Sprawdzenie «{n}» nie przechodzi (PR #{num}, commit {look['head'][:7]})." for n in failed]
            for n in notes:
                what = f"recenzja ({n['state']})" if n["state"] else "komentarz"
                body = n["body"].strip()
                items.append(f"Nowy {what} od {n['author'] or 'kogoś'} w PR #{num}" + (": " + _trig_clip(body, 500) if body else "."))
            if items:
                if look["url"]:
                    items.append(look["url"])
                _trig_add(self.batches.setdefault(tid, _trig_batch()), items, self.h.clock())
        alive = {t["id"] for _, t in self.live()}
        self.state["pr_seen"] = {k: v for k, v in seen_all.items() if k in alive}
        self.save()

    # ── poczta: nagłówki ze skrzynki kanału e-mail co dwie minuty ──
    def look_mail(self, live: list, now: float) -> None:
        if not any(t["kind"] == "mail" for _, t in live) or self.mail_looking or now - self.last_mail < _TRIG_LOOK_EVERY:
            return
        cfg = _host_load("email.json", {})
        if not (isinstance(cfg, dict) and cfg.get("imap_host") and cfg.get("user") and cfg.get("password")):
            return
        self.last_mail, self.mail_looking = now, True
        after, validity = int(self.state.get("mail_uid") or 0), int(self.state.get("mail_validity") or 0)

        def work() -> None:
            r = self.mail_heads(cfg, after, validity)
            self.h.q.put(("call", lambda: self.took_mail(r, cfg)))
        self.spawn(work)

    def took_mail(self, r, cfg: dict) -> None:
        self.mail_looking = False
        if not isinstance(r, dict) or r.get("error"):
            return
        if "validity" in r:
            self.state["mail_validity"] = int(r["validity"] or 0)
        if "last" in r:
            self.state["mail_uid"] = int(r["last"] or 0)
        self.save()
        own = [str(cfg.get(k) or "").lower() for k in ("user", "from", "owner")]
        for _, t in self.live():
            if t["kind"] != "mail":
                continue
            fit = [m for m in r.get("mails") or [] if isinstance(m, dict) and _trig_fits(m, t.get("sender") or "", t.get("subject") or "", own)]
            items = ["Od: " + (f"{m['name']} <{m['from']}>" if m.get("name") else m["from"]) + ", temat: "
                     + (_trig_clip(m.get("subject"), 200) or "(bez tematu)") for m in fit]
            if items:
                _trig_add(self.batches.setdefault(t["id"], _trig_batch()), items, self.h.clock())

    # ── webhooki: lokalny serwer, tylko gdy jakiś wyzwalacz go potrzebuje ──
    def listen(self, on: bool) -> None:
        if on and self.server is None:
            c = _trig_hook_cfg()
            self.server = self.serve(c["bind"], c["port"], self.check_key, self.took_hook_raw) or False
        elif not on and self.server:
            try:
                self.server.shutdown()
                self.server.server_close()
            except (OSError, AttributeError):
                pass
            self.server = None

    def check_key(self, hook: str, key: str) -> bool:
        import hmac
        want = str((self.hooks.get(hook) or {}).get("key") or "")
        return bool(want and key) and hmac.compare_digest(want, _trig_hash(key))

    def took_hook_raw(self, hook: str, body: str, event: str) -> None:
        at = self.h.clock()
        self.h.q.put(("call", lambda: self.took_hook(hook, body, event, at)))

    def took_hook(self, hook: str, body: str, event: str, at: float) -> None:
        import datetime as _dt
        hit = next(((aid, t) for aid, t in self.live() if t["kind"] == "webhook" and t.get("hook") == hook), None)
        if not hit:
            print("[wyzwalacze] webhook na adres, którego żaden agent tu nie ma", flush=True)
            return
        aid, t = hit
        w = _dt.datetime.fromtimestamp(at)
        _trig_add(self.batches.setdefault(t["id"], _trig_batch()), [_trig_hook_item(body, event, f"{w:%H:%M:%S}")], self.h.clock())
        self.h.trace(aid, {"type": "info", "tekst": f"Webhook: {len(body.encode())} B", "trigger": "webhook", "what": "event"})

    def new_hook(self, agent: str) -> dict:
        import secrets
        hook = secrets.token_urlsafe(12).replace("-", "a").replace("_", "b")
        key = secrets.token_urlsafe(24)
        self.hooks[hook] = {"agent": str(agent or "").lower(), "key": _trig_hash(key), "made": _now_iso()}
        _host_save("webhooki.json", self.hooks)
        return {"hook": hook, "url": _trig_hook_cfg()["base"] + "/hook/" + hook, "key": key}

    # ── budzenie ──
    def step(self, aid: str, t: dict, now: float) -> None:
        b = self.batches.get(t["id"])
        if not b or _trig_count(b) <= 0:
            return
        st = _trig_step(b, now, _trig_settle(t), _trig_rate(t))
        if st[0] == "held" and st[2] > 0:
            import datetime as _dt
            b["noted"] = _trig_count(b)
            w = _dt.datetime.fromtimestamp(st[1])
            self.note(aid, t, "held", f"{_trig_title(t)}: wstrzymane jeszcze {st[2]}, najwyżej jedno obudzenie na "
                                      f"{max(1, int(_trig_rate(t) / 60))} min. Pójdą z następną wiadomością, około {w:%H:%M}.")
        elif st[0] == "fire":
            self.wake(aid, t, b, now)

    def wake(self, aid: str, t: dict, b: dict, now: float) -> None:
        # jedno naraz: póki jego poprzednia wiadomość z tego wyzwalacza czeka albo trwa, nowe zdarzenia czekają w paczce
        def mine(m) -> bool:
            return tuple((m or {}).get("origin") or ())[:2] == ("trigger", t["id"])
        if mine(self.h.current.get(aid)) or any(mine(m) for m in self.h.queues.get(aid) or []):
            return
        title = _trig_title(t)
        kept = dict(b, items=list(b["items"]))
        if t["kind"] == "folder":
            # plik, którego już nie ma (przeniesiony, pobieranie przemianowane na końcu), nie trafia na listę
            kept["items"] = [p for p in b["items"] if os.path.exists(p)]
            if _trig_count(kept) <= 0:
                self.batches[t["id"]] = _trig_batch(b["last_wake"])
                return
        limited = bool(self.h.limit_stop(aid))
        self.batches[t["id"]] = _trig_batch(now)
        self.h.tell(aid, _trig_prompt(t, kept, now), ("trigger", t["id"], title))
        n = _trig_count(kept)
        if limited:
            self.note(aid, t, "limit", f"{title}: nie obudzony, dzienny limit pracy w tle jest wyczerpany (odrzucone zdarzenia: {n}).")
        else:
            self.note(aid, t, "wake", f"{title}: obudzony, zdarzeń: {n}." + (" Razem z wcześniej wstrzymanymi." if b["noted"] else ""))


