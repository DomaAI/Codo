def _unified(path: Path, old: str, new: str) -> str:
    """Unified diff a/… → b/… (jak `git diff`), z limitem długości."""
    import difflib
    rel = path.name
    diff = "".join(difflib.unified_diff(
        old.splitlines(keepends=True), new.splitlines(keepends=True),
        fromfile=f"a/{rel}", tofile=f"b/{rel}",
    ))
    if not diff:
        return _L("(brak zmian — treść identyczna)")
    if len(diff) > 8000:
        diff = diff[:8000] + _L("\n… (diff obcięty)")
    return diff


def _linedelta(old: str, new: str) -> tuple:
    """(dodane, usunięte) linie — do zwięzłego podsumowania po zapisie."""
    import difflib
    added = removed = 0
    for line in difflib.ndiff(old.splitlines(), new.splitlines()):
        if line.startswith("+ "):
            added += 1
        elif line.startswith("- "):
            removed += 1
    return added, removed


def _backup(path: Path) -> Path | None:
    """Kopia pliku PRZED zmianą → .doma/backups/<ścieżka>.<ts>.bak. Pozwala
    przywrócić (restore) dowolną wcześniejszą wersję. None gdy pliku nie było."""
    if not path.exists() or not path.is_file():
        return None
    import shutil
    import time as _time
    rel = _backup_rel(path)
    dest_dir = Path.cwd() / _BACKUP_DIR / rel.parent
    dest_dir.mkdir(parents=True, exist_ok=True)
    _doma_ignored()
    ts = _time.strftime("%Y%m%d-%H%M%S")
    bak = dest_dir / f"{rel.name}.{ts}.bak"
    i = 1
    while bak.exists():
        bak = dest_dir / f"{rel.name}.{ts}-{i}.bak"
        i += 1
    shutil.copy2(_long_path(path), _long_path(bak))
    try:
        _, olds = _backups_for(path)
        for old in olds[:-_BACKUPS_KEEP]:   # najstarsze ponad limit (do 0.28.0 kopie rosły bez końca)
            Path(old).unlink(missing_ok=True)
    except (OSError, ValueError, TypeError, IndexError):
        pass  # nosec B110 — porządki nie mogą blokować edycji
    return bak


_BACKUPS_KEEP = 20


def _backup_rel(path: Path) -> Path:
    """Miejsce kopii w .doma/backups: ścieżka względna w projekcie; plik spoza projektu (za zgodą
    użytkownika) trafia pod _poza/<dysk>/<pełna ścieżka>, więc restore i /undo działają tak samo."""
    path = Path(path)
    for base in (Path.cwd(), Path.cwd().resolve()):
        try:
            return path.relative_to(base)
        except ValueError:
            continue
    try:
        return path.resolve().relative_to(Path.cwd().resolve())
    except (ValueError, OSError):
        pass
    a = Path(os.path.abspath(path))
    drive = re.sub(r"[^A-Za-z0-9]", "", a.drive) or "root"
    return Path("_poza", drive, *[x for x in a.parts[1:] if x not in ("", "\\", "/")])


def _doma_ignored() -> None:
    """.doma/.gitignore z „*”: kopie, logi procesów i kosz (np. usunięty .env) nigdy nie trafią do commita
    po `git add -A` (do 0.28.0 wykluczenie dopisywał tylko zespół agentów)."""
    f = Path.cwd() / _DOMA_DIR / ".gitignore"
    if not f.exists():
        try:
            f.parent.mkdir(parents=True, exist_ok=True)
            f.write_text("# Codo: kopie zapasowe, logi i kosz; nie do repozytorium\n*\n", encoding="utf-8")
        except OSError:
            pass  # nosec B110


def _git_head_text(path: Path) -> str | None:
    """Treść pliku z ostatniego commita (None poza gitem albo dla nowego pliku)."""
    try:
        rel = path.relative_to(_cwd_real())
        out = subprocess.run(["git", "show", f"HEAD:./{rel.as_posix()}"], capture_output=True, timeout=10,
                             stdin=subprocess.DEVNULL)
    except (ValueError, OSError, subprocess.SubprocessError):
        return None
    return out.stdout.decode("utf-8", errors="replace") if out.returncode == 0 else None


def _backup_text(path: Path, text: str) -> Path | None:
    """Kopia z podanej treści (stan sprzed zmiany odtworzony po fakcie, agenci zewnętrzni)."""
    rel = _backup_rel(path)
    import time as _time
    dest_dir = Path.cwd() / _BACKUP_DIR / rel.parent
    dest_dir.mkdir(parents=True, exist_ok=True)
    ts = _time.strftime("%Y%m%d-%H%M%S")
    bak = dest_dir / f"{rel.name}.{ts}.bak"
    i = 1
    while bak.exists():
        bak = dest_dir / f"{rel.name}.{ts}-{i}.bak"
        i += 1
    bak.write_text(text, encoding="utf-8")
    return bak


# Ostatnie zapisy agenta: podgląd zmian w terminalu i /undo. Ograniczone,
# bo mostek `serve` żyje tygodniami i też przechodzi przez _apply.
import collections
import threading as _threading
EDIT_LOG: "collections.deque" = collections.deque(maxlen=50)
_EDIT_SEQ = [0]
_EDIT_LOCK = _threading.Lock()


# Format pliku zapamiętany przy odczycie do edycji: (kodowanie, CRLF, BOM).
# Edycja ma zmienić tylko wskazany fragment, więc zapis odtwarza to, co było
# na dysku. Wcześniej odczyt z errors="replace" + zapis UTF-8 zamieniał polskie
# znaki w plikach cp1250 na U+FFFD, a CRLF na LF w całym pliku.
_FILE_FMT: dict = {}
_UTF8_BOM = b"\xef\xbb\xbf"


# Znaczniki kolejności bajtów: UTF-32 przed UTF-16 (FF FE 00 00 zaczyna się jak FF FE).
_BOMS = ((b"\xff\xfe\x00\x00", "utf-32-le"), (b"\x00\x00\xfe\xff", "utf-32-be"),
         (_UTF8_BOM, "utf-8"), (b"\xff\xfe", "utf-16-le"), (b"\xfe\xff", "utf-16-be"))


def _sniff_utf16(data: bytes) -> str | None:
    """UTF-16 bez BOM (eksporty z Windows, np. reg, logi PowerShell): co drugi bajt zero."""
    sample = data[:4096]
    if len(sample) < 8:
        return None
    sample = sample[:len(sample) // 2 * 2]
    even, odd = sample[0::2], sample[1::2]
    enc = None
    if odd.count(0) > len(odd) * 0.4 and even.count(0) < len(even) * 0.05:
        enc = "utf-16-le"
    elif even.count(0) > len(even) * 0.4 and odd.count(0) < len(odd) * 0.05:
        enc = "utf-16-be"
    if not enc:
        return None
    text = sample.decode(enc, "replace")
    ok = sum(1 for ch in text if ch.isprintable() or ch in "\r\n\t")
    return enc if ok >= len(text) * 0.95 else None   # bajty zerowe co drugi bajt, a treść nieczytelna: binarny


def _decode_bytes(data: bytes) -> tuple:
    """bytes → (tekst bez BOM, kodowanie, BOM jako bajty). Kolejność: BOM (UTF-8/16/32), UTF-16 bez BOM,
    UTF-8, cp1250 (polskie pliki z Windows), latin-1 (przyjmuje każdy bajt, więc zapis odtwarza plik 1:1)."""
    for bom, enc in _BOMS:
        if data.startswith(bom):
            try:
                return data[len(bom):].decode(enc), enc, bom
            except UnicodeDecodeError:
                break
    u16 = _sniff_utf16(data) if b"\x00" in data[:4096] else None
    if u16:
        try:
            return data.decode(u16), u16, b""
        except UnicodeDecodeError:
            pass  # nosec B110 — jednak nie UTF-16
    for enc in ("utf-8", "cp1250"):
        try:
            return data.decode(enc), enc, b""
        except UnicodeDecodeError:
            continue
    return data.decode("latin-1"), "latin-1", b""


def _decode_text(data: bytes):
    """bytes → (tekst, kodowanie). Jak _decode_bytes, bez BOM w tekście."""
    text, enc, _bom = _decode_bytes(data)
    return text, enc


def _eol_of(text: str) -> str:
    """Koniec linii całego pliku: \\r\\n tylko gdy KAŻDE \\n ma \\r przed sobą, \\r gdy plik ma wyłącznie \\r
    (stary Mac), inaczej \\n. Pliki mieszane zostają jak są (edycja dopasowuje \\r\\n osobno)."""
    n = text.count("\n")
    if n and text.count("\r\n") == n:
        return "\r\n"
    if not n and "\r" in text:
        return "\r"
    return "\n"


def _read_text_keep(path: Path, missing_ok: bool = False) -> str:
    """Treść pliku do edycji z końcami linii jako \\n; format (kodowanie, koniec linii, BOM) trafia do _FILE_FMT,
    a zapis przez _apply odtwarza go bajt w bajt poza zmienionym fragmentem."""
    if missing_ok and not path.exists():
        _FILE_FMT.pop(path, None)
        return ""
    data = _long_path(path).read_bytes()
    text, enc, bom = _decode_bytes(data)
    eol = _eol_of(text)
    if eol != "\n":
        text = text.replace(eol, "\n")
    _FILE_FMT[path] = (enc, eol, bom)
    return text


def _fmt_encode(path: Path, text: str) -> bytes:
    """Tekst z \\n → bajty w formacie zapamiętanym przy odczycie (nowy plik: UTF-8, \\n, bez BOM).
    Rzuca UnicodeEncodeError, gdy znak nie mieści się w kodowaniu pliku."""
    enc, eol, bom = _FILE_FMT.get(path) or ("utf-8", "\n", b"")
    if eol is True:        # stary zapis formatu (crlf jako bool)
        eol = "\r\n"
    elif eol is False:
        eol = "\n"
    if bom is True:
        bom = _UTF8_BOM
    out = text   # plik mieszany (\n i \r\n) zostaje dokładnie taki, jaki przyszedł z edycji
    if eol != "\n":
        out = text.replace("\r\n", "\n").replace("\n", eol)
    return (bom or b"") + out.encode(enc)


def _long_path(path: Path) -> Path:
    """Windows: ścieżka dłuższa niż ~260 znaków działa tylko z przedrostkiem \\\\?\\ (gdy w systemie nie
    włączono LongPathsEnabled). Na macOS i Linuksie bez zmian."""
    if os.name != "nt":
        return path
    s = str(path)
    if len(s) < 240 or s.startswith("\\\\?\\"):
        return path
    if s.startswith("\\\\"):
        return Path("\\\\?\\UNC\\" + s[2:])
    return Path("\\\\?\\" + s)


def _atomic_write(path: Path, data: bytes) -> None:
    """Zapis przez plik tymczasowy w tym samym folderze i os.replace: brak miejsca albo przerwanie
    w połowie nie zostawia uciętego pliku. Uprawnienia istniejącego pliku zostają; dowiązanie
    symboliczne zostaje dowiązaniem (zapis idzie do pliku, na który wskazuje).
    Plik tylko do odczytu NIE jest nadpisywany (os.replace na Linuksie/macOS zrobiłby to po cichu).
    Windows: plik chwilowo trzymany przez antywirusa albo indeksowanie dostaje kilka ponowień; folder bez
    prawa tworzenia plików, ale z zapisywalnym plikiem, dostaje zapis w miejscu."""
    import errno
    import tempfile
    import time as _time
    path.parent.mkdir(parents=True, exist_ok=True)
    real = path.resolve() if path.is_symlink() else path
    lp = _long_path(real)
    mode = owner = None
    try:
        st = lp.stat()
        mode, owner = st.st_mode & 0o7777, (st.st_uid, st.st_gid)
    except OSError:
        pass  # nosec B110 — nowy plik
    if mode is not None and not os.access(lp, os.W_OK):
        raise PermissionError(errno.EACCES, _L("plik jest tylko do odczytu"), str(real))
    try:
        fd, tmp = tempfile.mkstemp(prefix="." + real.name[:80] + ".", suffix=".codo-tmp", dir=str(lp.parent))
    except PermissionError:
        if mode is None:
            raise
        with open(lp, "r+b") as f:   # folder bez prawa zapisu, sam plik zapisywalny: zapis w miejscu
            f.write(data)
            f.truncate()
            f.flush()
            os.fsync(f.fileno())
        return
    try:
        with os.fdopen(fd, "wb") as f:
            f.write(data)
            f.flush()
            os.fsync(f.fileno())
        if mode is not None:
            os.chmod(tmp, mode)
            if owner and hasattr(os, "chown") and os.name != "nt":
                try:
                    os.chown(tmp, *owner)   # plik innego użytkownika/grupy (np. www-data) zostaje jego
                except OSError:
                    pass  # nosec B110 — bez uprawnień zostaje właściciel bieżący
        for attempt in range(6):
            try:
                os.replace(tmp, lp)
                break
            except PermissionError:
                if os.name != "nt":
                    raise
                if attempt < 5:
                    _time.sleep(0.05 * (2 ** attempt))   # Windows: plik chwilowo otwarty przez inny proces
                    continue
                # Windows: inny program trzyma plik otwarty bez FILE_SHARE_DELETE (podgląd logu, IDE), więc
                # podmiana nazwy się nie uda, ale zapis w miejscu tak. Gdy i on nie przejdzie, zostaje błąd.
                if mode is None:
                    raise
                with open(lp, "r+b") as f:
                    f.write(data)
                    f.truncate()
                    f.flush()
                    os.fsync(f.fileno())
                os.unlink(tmp)
                return
    except BaseException:
        try:
            os.unlink(tmp)
        except OSError:
            pass  # nosec B110
        raise


def _write_error(path: Path, e: OSError) -> str:
    """Zrozumiały powód nieudanego zapisu (model wie, co zrobić, a nie tylko „Errno 13”)."""
    import errno
    win = getattr(e, "winerror", None)
    if win in (32, 33):
        why = _L("plik jest otwarty w innym programie (np. Word, Excel, edytor); zamknij go i spróbuj ponownie")
    elif isinstance(e, PermissionError) or e.errno in (errno.EACCES, errno.EPERM):
        ro = path.exists() and not os.access(_long_path(path), os.W_OK)
        why = (_L("plik jest tylko do odczytu; zdejmij ochronę (chmod u+w / Właściwości → Tylko do odczytu) "
                  "albo poproś użytkownika") if ro else
               _L("brak uprawnień do zapisu w tym miejscu") + (
                   _L(" albo plik jest otwarty w innym programie") if os.name == "nt" else ""))
    elif e.errno == errno.ENOSPC:
        why = _L("brak miejsca na dysku")
    elif e.errno == errno.ENAMETOOLONG or win == 206:
        why = _L("ścieżka jest za długa")
    elif e.errno == errno.EROFS:
        why = _L("system plików jest tylko do odczytu")
    else:
        why = str(e)
    return _Lf('BŁĄD zapisu {0}: {1}. Plik został bez zmian.', path.name, why)


def _apply(path: Path, old: str, new: str, args: dict, label: str) -> str:
    """Zapis LUB podgląd (dry_run). Przed każdym realnym zapisem robi kopię
    pliku (restore-owalną). Agent może najpierw zobaczyć diff (dry_run)."""
    if old == new and path.exists():
        return _Lf('{0}: brak zmian (treść identyczna).', label)
    if args.get("dry_run"):
        return f"PODGLĄD — {label} (NIE zapisano):\n{_unified(path, old, new)}"
    enc = (_FILE_FMT.get(path) or ("utf-8",))[0]
    try:
        data = _fmt_encode(path, new)
    except UnicodeEncodeError as e:
        bad = e.object[e.start:e.end] if isinstance(e.object, str) else ""
        return (f"BŁĄD: {path.name} jest w kodowaniu {enc}, a nowa treść ma znaki spoza niego"
                + (f" ({bad!r})" if bad else "") + ". Nic nie zapisano. Użyj znaków z tego kodowania albo za zgodą "
                "użytkownika przekonwertuj plik na UTF-8 (write_file z całą treścią po przeczytaniu).")
    existed = path.exists()
    if existed and not os.access(_long_path(path), os.W_OK):
        return _write_error(path, PermissionError(13, "read-only"))
    try:
        _backup(path)  # auto-kopia PRZED nadpisaniem (bezpieczne cofnięcie)
    except OSError as e:
        return _Lf('BŁĄD: nie udało się zrobić kopii zapasowej {0} ({1}). Nic nie zapisano.', path.name, e)
    try:
        _atomic_write(path, data)
    except OSError as e:
        return _write_error(path, e)
    _FILE_FMT[path] = _FILE_FMT.get(path) or ("utf-8", "\n", b"")
    a, r = _linedelta(old, new)
    with _EDIT_LOCK:
        _EDIT_SEQ[0] += 1
        EDIT_LOG.append({"seq": _EDIT_SEQ[0], "path": path, "added": a, "removed": r,
                         "new_file": not existed, "diff": _unified(path, old, new)})
    return f"{label} → {path} (+{a}/-{r} linii, kopia zapasowa zrobiona)"


def t_diff(args):
    """Podgląd WSZYSTKICH niezapisanych zmian w repo (git diff, read-only —
    działa bez --yes). Opcjonalnie zawężony do `path`."""
    cmd = ["git", "-C", str(Path.cwd()), "diff", "--no-color"]
    rel = args.get("path")
    if rel:
        cmd += ["--", str(_safe_path(rel).relative_to(_cwd_real()))]
    try:
        proc = subprocess.run(cmd, capture_output=True, text=True, encoding="utf-8", errors="replace", timeout=30)
    except FileNotFoundError:
        return "git niedostępny na serwerze — podgląd rób przez dry_run na edycjach."
    if "not a git repository" in (proc.stderr or "").lower():
        return ("To nie jest repozytorium git. Podgląd pojedynczej zmiany: "
                "wywołaj edycję z dry_run=true. (Opcjonalnie `git init` przez run_command.)")
    out = proc.stdout.strip()
    if not out:
        return "(brak niezapisanych zmian w repo)"
    if len(out) > 12000:
        out = out[:12000] + "\n… (diff obcięty)"
    return out


def _backups_for(path: Path):
    rel = _backup_rel(path)
    bdir = Path.cwd() / _BACKUP_DIR / rel.parent
    if not bdir.exists():
        return rel, []
    # Dokładny wzorzec nazwy: glob "style.css.*.bak" łapał też kopie
    # style.css.map. Sortowanie po (znacznik czasu, numer): "-1" < "." w ASCII,
    # więc druga kopia z tej samej sekundy lądowała przed pierwszą.
    pat = re.compile(re.escape(rel.name) + r"\.(\d{8}-\d{6})(?:-(\d+))?\.bak$")
    found = []
    for b in bdir.iterdir():
        m = pat.fullmatch(b.name)
        if m:
            found.append(((m.group(1), int(m.group(2) or 0)), b))
    return rel, [b for _, b in sorted(found, key=lambda item: item[0])]


def t_restore(args):
    """Przywraca plik z auto-kopii. Bez `version` = ostatnia kopia (cofnięcie
    ostatniej zmiany). Przed przywróceniem robi kopię bieżącego stanu."""
    import shutil
    path = _agent_path(args.get("path"), write=True)
    rel, baks = _backups_for(path)
    if not baks:
        return f"Brak kopii dla {rel} — agent jeszcze nie edytował tego pliku."
    version = args.get("version")
    if version:
        chosen = [b for b in baks if version in b.name]
        if not chosen:
            avail = ", ".join(b.name for b in baks[-6:])
            return f"Nie znaleziono kopii '{version}'. Ostatnie: {avail}"
        src = chosen[-1]
    else:
        src = baks[-1]
    data = src.read_bytes()   # przed _backup: przycinanie starych kopii mogłoby usunąć właśnie tę
    _backup(path)  # bieżący stan też zachowujemy (restore jest odwracalny)
    try:
        _atomic_write(path, data)
    except OSError as e:
        return _write_error(path, e)
    _FILE_FMT.pop(path, None)
    try:
        shutil.copystat(src, path)
    except OSError:
        pass  # nosec B110 — czas i uprawnienia to dodatek
    return f"Przywrócono {rel} z kopii {src.name}"


def t_backups(args):
    """Lista dostępnych kopii (dla `path` albo wszystkich)."""
    root = Path.cwd() / _BACKUP_DIR
    if not root.exists():
        return "(brak kopii — jeszcze nic nie edytowano przez agenta)"
    flt = args.get("path")
    out = []
    for b in sorted(root.rglob("*.bak")):
        rel = b.relative_to(root)
        if flt and flt not in str(rel):
            continue
        out.append(str(rel))
    return "\n".join(out[-120:]) or "(brak kopii dla tej ścieżki)"


def t_check(args):
    """Sam sprawdza projekt: składnia JSON/Python/JS (node --check). Zwraca
    listę błędów albo potwierdzenie. Nie wykonuje kodu użytkownika."""
    import json as _json
    root = _safe_path(args.get("path") or ".")
    problems, checked, node_missing = [], 0, False
    targets = [root] if root.is_file() else []
    if not targets:
        # os.walk z przycinaniem: rglob schodził w node_modules i .venv, zanim odfiltrował ścieżki
        for d, dirs, files in os.walk(root):
            dirs[:] = [x for x in dirs if x not in _SKIP_DIRS]
            targets += [Path(d) / f for f in files if f.lower().endswith((".json", ".py", ".js", ".mjs", ".cjs"))]
            if len(targets) > 5000:
                break
    for f in targets:
        suf = f.suffix.lower()
        rel = f.relative_to(_cwd_real())
        try:
            if suf == ".json":
                _json.loads(f.read_text(encoding="utf-8-sig")); checked += 1
            elif suf == ".py":
                compile(f.read_bytes(), str(f), "exec"); checked += 1   # bajty: kodowanie z nagłówka pliku, nie z systemu
            elif suf in (".js", ".mjs", ".cjs"):
                r = subprocess.run(["node", "--check", str(f)],
                                   capture_output=True, text=True, timeout=20)
                checked += 1
                if r.returncode != 0:
                    err = (r.stderr or r.stdout).strip().splitlines()
                    problems.append(f"{rel}: {err[-1][:200] if err else 'błąd składni JS'}")
        except FileNotFoundError:
            node_missing = True  # brak node — pomijamy JS
        except SyntaxError as e:
            problems.append(f"{rel}:{e.lineno}: {e.msg}")
        except Exception as e:
            problems.append(f"{rel}: {str(e).splitlines()[0][:200]}")
    head = f"Sprawdzono {checked} plików. "
    if node_missing:
        head += "(node niedostępny — pliki JS pominięte) "
    if problems:
        return head + f"ZNALEZIONO {len(problems)} błędów:\n" + "\n".join(problems[:60])
    return head + "Brak błędów składni ✓"


def _venv_bindir(venv: Path) -> Path:
    """Katalog z binariami venva — Scripts na Windows, bin na POSIX."""
    return venv / ("Scripts" if IS_WIN else "bin")


def _find_bin(*candidates: str) -> str | None:
    """Pierwszy istniejący program: venv (bin/Scripts) → node_modules/.bin →
    PATH. Na Windows próbuje też rozszerzeń .exe/.cmd (pip.exe, eslint.cmd)."""
    import shutil
    cwd = Path.cwd()
    exts = ("", ".exe", ".cmd", ".bat") if IS_WIN else ("",)
    for name in candidates:
        for base in (_venv_bindir(cwd / ".venv"), cwd / "node_modules" / ".bin"):
            for ext in exts:
                p = base / (name + ext)
                if p.exists():
                    return str(p)
        w = shutil.which(name)
        if w:
            return w
    return None


def _run_capture(cmd: list, timeout: int = 120, tail: int = 4000) -> tuple:
    """(exit_code, ogon_wyjścia) — wspólny runner dla lint/testów/format."""
    try:
        r = subprocess.run(cmd, capture_output=True, text=True, errors="replace", timeout=timeout,
                           cwd=str(Path.cwd()))
    except FileNotFoundError:
        return 127, _Lf('brak narzędzia: {0}', cmd[0])
    except subprocess.TimeoutExpired:
        return 124, f"timeout {timeout}s"
    out = ((r.stdout or "") + (r.stderr or "")).strip()
    return r.returncode, out[-tail:]


def t_lint(args):
    """Znajdowanie błędów: agreguje dostępne lintery (ruff/eslint/tsc) +
    natywny check składni. Read-only, niczego nie naprawia."""
    # SECURITY: path od agenta — zamknij w cwd (bez tego `lint path=/etc`
    # ujawniłby cudze pliki). Względna ścieżka do przekazania linterom.
    try:
        target = str(_safe_path(args.get("path") or ".").relative_to(Path.cwd().resolve()))
    except (ValueError, OSError) as e:
        return f"BŁĄD: {e}"
    target = target or "."
    sections = []
    ruff = _find_bin("ruff")
    has_py = any(Path.cwd().rglob("*.py"))
    if ruff and has_py:
        code, out = _run_capture([ruff, "check", target, "--output-format",
                                  "concise"], timeout=120)
        sections.append("── ruff (Python) ──\n"
                        + (out or ("OK — brak uwag" if code == 0 else f"exit={code}")))
    eslint = _find_bin("eslint")
    has_eslint_cfg = any((Path.cwd() / n).exists() for n in (
        ".eslintrc", ".eslintrc.js", ".eslintrc.cjs", ".eslintrc.json",
        "eslint.config.js", "eslint.config.mjs"))
    if eslint and has_eslint_cfg:
        code, out = _run_capture([eslint, target, "--format", "unix"], timeout=180)
        sections.append("── eslint (JS/TS) ──\n"
                        + (out or ("OK — brak uwag" if code == 0 else f"exit={code}")))
    tsc = _find_bin("tsc")
    if tsc and (Path.cwd() / "tsconfig.json").exists():
        code, out = _run_capture([tsc, "--noEmit", "--pretty", "false"], timeout=240)
        sections.append("── tsc (TypeScript) ──\n"
                        + (out or ("OK — brak błędów typów" if code == 0 else f"exit={code}")))
    sections.append("── składnia (check) ──\n" + t_check({"path": args.get("path")}))
    return "\n\n".join(sections)


def t_run_tests(args, auto_yes=False):
