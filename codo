def login_maddlabs_account() -> int:
    """Konto MaddLabs przez przeglądarkę: potwierdzasz na maddlabs.co/cli, Codo dostaje własny klucz."""
    import socket
    import time as clock
    import webbrowser
    try:
        start = _maddlabs_http("POST", "/api/cli/start",
                               json_body={"client": "codo", "host": socket.gethostname()[:60]}, timeout=20)
    except (ApiError, urllib.error.URLError, TimeoutError, OSError) as e:
        print(red(_L("✗ Nie rozpoczęto logowania w MaddLabs: "))
              + (str(e.detail) if isinstance(e, ApiError) else describe_error(e)))
        print(dim(_L("  Możesz wkleić klucz API: codo login klucz")))
        return 1
    url = start.get("verification_url") or f"{MADDLABS_URL}/cli?code={start.get('user_code', '')}"
    print(bold(_L("Zaloguj się kontem MaddLabs w przeglądarce:")))
    print("  " + violet(bold(url)))
    print(dim(_Lf('  Sprawdź, czy kod na stronie to {0}, i kliknij Pozwól.', start.get('user_code', ''))))
    try:
        webbrowser.open(url)
    except Exception:
        pass
    deadline = clock.monotonic() + int(start.get("expires_in") or 600)
    step = max(1, int(start.get("interval") or 2))
    print(dim(_L("Czekam na potwierdzenie…")))
    while clock.monotonic() < deadline:
        clock.sleep(step)
        try:
            st = _maddlabs_http("POST", "/api/cli/poll", json_body={"device_code": start["device_code"]}, timeout=15)
        except (urllib.error.URLError, TimeoutError, OSError):
            continue
        except ApiError as e:
            if e.status == 429 or e.status >= 500:
                continue
            raise
        status = st.get("status")
        if status == "confirmed" and st.get("api_key"):
            _maddlabs_save({"api_key": st["api_key"], "base_url": st.get("base_url") or f"{MADDLABS_URL}/v1",
                            "how": _L("konto"), "account": st.get("account") or "",
                            "email": st.get("email") or "", "key_name": st.get("key_name") or ""})
            who = st.get("email") or st.get("account") or _L("konto MaddLabs")
            print(green(_Lf('\n✓ Zalogowano kontem MaddLabs ({0}).', who))
                  + dim(_L(" Klucz „") + (st.get("key_name") or "Codo") + _L("” zobaczysz w maddlabs.co → Klucze API.")))
            return 0
        if status == "denied":
            print(yellow(_L("✗ Logowanie odrzucone w przeglądarce.")))
            return 1
        if status == "expired":
            break
    print(red(_L("✗ Kod wygasł. Spróbuj ponownie: /login")))
    return 1


def maddlabs_step(body: dict) -> dict:
    ml = load_maddlabs()
    if not ml:
        raise ApiError(401, _L("Brak logowania MaddLabs. Użyj /login"))
    model = body.get("model") or _maddlabs_default_model(ml)
    payload = {"model": model, "messages": body["messages"], "max_tokens": body.get("max_tokens") or 8000}
    if body.get("tools"):
        payload["tools"] = body["tools"]
    data = _chat_live(lambda p: _maddlabs_http("POST", "/chat/completions", key=ml["api_key"], json_body=p,
                                               base=_maddlabs_base(ml)), payload, "maddlabs")
    try:
        message = data["choices"][0]["message"]
        finish = data["choices"][0].get("finish_reason") or ""
    except (KeyError, IndexError, TypeError, AttributeError):
        raise ApiError(502, _L("Nieprawidłowa odpowiedź modelu MaddLabs.")) from None
    thought = _take_reasoning(message)
    message = {k: v for k, v in message.items() if k in ("role", "content", "tool_calls") and v is not None}
    message.setdefault("role", "assistant")
    return {"message": message, "model": data.get("model") or model, "credits_spent": 0,
            "usage": data.get("usage") or {}, "thinking": thought, "finish_reason": finish}


def _take_reasoning(message: dict) -> str:
    """23.11.2026 Log-Bot: myślenie modelu zgodnego z OpenAI (reasoning_content / reasoning albo <think> na początku
    treści). Zdejmowane z wiadomości (nie wraca do historii), pokazywane w dzienniku agenta."""
    out = ""
    for k in ("reasoning_content", "reasoning"):
        v = message.get(k)
        if isinstance(v, str) and v.strip():
            out = v.strip()
            break
    c = message.get("content")
    if isinstance(c, str):
        m = re.match(r"\s*<think>(.*?)</think>\s*", c, re.S)
        if m:
            out = out or m.group(1).strip()
            message["content"] = c[m.end():]
    return out


def _maddlabs_models(ml: dict | None = None) -> list:
    ml = ml or load_maddlabs() or {}
    data = _maddlabs_http("GET", "/models", key=ml.get("api_key"), base=_maddlabs_base(ml), timeout=20)
    out = []
    for m in data.get("data") or []:
        mid = m.get("id")
        if not mid:
            continue
        label = m.get("name") or mid
        if m.get("is_ready") is False:
            label += _L(" · teraz wyłączony")
        out.append((mid, label, "free", m.get("is_ready") is not False))
    return out


def _maddlabs_default_model(ml: dict | None = None) -> str:
    models = _maddlabs_models(ml)
    ready = [m for m in models if m[3]] or models
    if not ready:
        raise ApiError(503, _L("MaddLabs nie ma teraz dostępnych modeli."))
    return ready[0][0]

