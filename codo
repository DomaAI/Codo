def _partial_json_str(raw: str, key: str) -> str | None:
    """Wartość tekstowa pola `key` z NIEDOKOŃCZONEGO JSON-a argumentów narzędzia (tyle, ile już przyszło).
    None, gdy pole jeszcze się nie zaczęło."""
    m = re.search(r'"' + re.escape(key) + r'"\s*:\s*"', raw)
    if not m:
        return None
    i, n, out = m.end(), len(raw), []
    while i < n:
        ch = raw[i]
        if ch == '"':
            break
        if ch == "\\":
            if i + 1 >= n:
                break
            nxt = raw[i + 1]
            if nxt == "u":
                if i + 6 > n:
                    break
                try:
                    out.append(chr(int(raw[i + 2:i + 6], 16)))
                except ValueError:
                    pass
                i += 6
                continue
            out.append({"n": "\n", "t": "\t", "r": "\r", "b": "\b", "f": "\f"}.get(nxt, nxt))
            i += 2
            continue
        out.append(ch)
        i += 1
    text = "".join(out)
    # pary zastępcze (emoji) przychodzą jako dwa \\uXXXX: składamy je, połówkę na końcu pomijamy
    try:
        return text.encode("utf-16", "surrogatepass").decode("utf-16")
    except UnicodeError:
        return text.encode("utf-8", "ignore").decode("utf-8")


_WRITING = {"t": 0.0, "len": -1}


def _writing_emit(name: str, raw: str, *, force: bool = False) -> None:
    """Aplikacja widzi plik w trakcie pisania: treść write_file / new_string edit_file, zanim model skończy."""
    import time as _t
    if name not in ("write_file", "edit_file") or _APP["out"] is None:
        return
    now = _t.monotonic()
    if not force and (now - _WRITING["t"] < 0.07 or len(raw) == _WRITING["len"]):
        return
    path = _partial_json_str(raw, "path")
    if not path or (re.search(r'"path"\s*:\s*"[^"\\]*$', raw)):   # ścieżka jeszcze niepełna
        return
    if name == "write_file":
        text = _partial_json_str(raw, "content")
        if text is None:
            return
        _app_emit("writing", plik=path, tryb="write", tekst=text)
    else:
        new = _partial_json_str(raw, "new_string")
        old = _partial_json_str(raw, "old_string")
        if new is None or old is None:
            return
        _app_emit("writing", plik=path, tryb="edit", tekst=new, stary=old)
    _WRITING["t"], _WRITING["len"] = now, len(raw)


def _sse_chat(resp) -> dict:
    """Składa odpowiedź /chat/completions ze strumienia SSE do kształtu odpowiedzi zwykłej."""
    content, calls, model, usage, got, thought = [], {}, None, {}, False, []
    for raw in resp:
        line = raw.decode("utf-8", "replace").strip()
        if not line.startswith("data:"):
            continue
        chunk = line[5:].strip()
        if chunk == "[DONE]":
            break
        try:
            ev = json.loads(chunk)
        except ValueError:
            continue
        if not isinstance(ev, dict):
            continue
        if isinstance(ev.get("error"), dict):
            raise ApiError(502, str(ev["error"].get("message") or ev["error"])[:300], ev)
        model = ev.get("model") or model
        if isinstance(ev.get("usage"), dict):
            usage = ev["usage"]
        for ch in ev.get("choices") or []:
            delta = ch.get("delta") if isinstance(ch, dict) else None
            if not isinstance(delta, dict):
                continue
            got = True
            if isinstance(delta.get("content"), str):
                content.append(delta["content"])
            for k in ("reasoning_content", "reasoning"):
                if isinstance(delta.get(k), str):
                    thought.append(delta[k])
                    break
            for tc in delta.get("tool_calls") or []:
                if not isinstance(tc, dict):
                    continue
                idx = tc.get("index") if isinstance(tc.get("index"), int) else len(calls)
                cur = calls.setdefault(idx, {"id": "", "type": "function", "function": {"name": "", "arguments": ""}})
                if tc.get("id"):
                    cur["id"] = tc["id"]
                fn = tc.get("function") or {}
                if fn.get("name"):
                    cur["function"]["name"] = fn["name"]
                if isinstance(fn.get("arguments"), str):
                    cur["function"]["arguments"] += fn["arguments"]
                    _writing_emit(cur["function"]["name"], cur["function"]["arguments"])
    if not got:
        raise ApiError(502, _L("Pusty strumień odpowiedzi modelu."))
    for cur in calls.values():
        _writing_emit(cur["function"]["name"], cur["function"]["arguments"], force=True)
    message = {"role": "assistant", "content": "".join(content) or None}
    if thought:
        message["reasoning_content"] = "".join(thought)
    if calls:
        message["tool_calls"] = [calls[i] for i in sorted(calls)]
    return {"choices": [{"message": message}], "model": model, "usage": usage}


_NO_STREAM: set = set()


_RETRY_STEP = (429, 500, 502, 503, 504, 529)


def _with_retry(call, payload: dict) -> dict:
    """Przeciążenie dostawcy (429/5xx/529) albo zerwane połączenie: do 4 prób z odstępem z Retry-After
    albo rosnącym (z losowym rozrzutem), najwyżej 60 s. Do 0.28.0 jedno 429 od OpenAI czy Anthropic
    kończyło turę."""
    import random
    import time
    for attempt in range(5):
        try:
            return call(payload)
        except ApiError as e:
            if e.status not in _RETRY_STEP or attempt == 4:
                raise
            try:
                wait = float((e.payload or {}).get("_retry_after") or 0)
            except (TypeError, ValueError):
                wait = 0
        except urllib.error.URLError as e:
            reason = getattr(e, "reason", None)
            # nieuruchomiony serwer lokalny (Ollama) i zły certyfikat: od razu, bez 30 s czekania
            if attempt == 4 or isinstance(reason, ConnectionRefusedError) or "CERTIFICATE_VERIFY_FAILED" in str(reason):
                raise
            wait = 0
        wait = min(60.0, wait or (2 ** attempt * 2 + random.uniform(0, 1.5)))  # nosec B311 — rozrzut, nie kryptografia
        LIVE.status(_Lf("Dostawca przeciążony, ponawiam za {0} s", int(wait)))
        time.sleep(wait)
    return call(payload)


def _chat_live(call, payload: dict, where: str) -> dict:
    """W aplikacji krok z narzędziami idzie strumieniem (treść pliku widać w trakcie pisania).
    Serwer, który strumienia nie obsłuży, dostaje to samo żądanie zwyczajnie i jest zapamiętany."""
    if _APP["out"] is None or not payload.get("tools") or where in _NO_STREAM or os.environ.get("CODO_NO_STREAM"):
        return _with_retry(call, payload)
    try:
        return _with_retry(call, {**payload, "stream": True})
    except ApiError as e:
        # 502 to zwykle chwilowa awaria, nie brak strumienia (do 0.28.0 jedno 502 wyłączało go na zawsze)
        if e.status not in (400, 404, 405, 415, 422, 501):
            raise
        _NO_STREAM.add(where)
        return _with_retry(call, payload)


def _maddlabs_http(method: str, path: str, *, key: str | None = None, json_body: dict | None = None,
                   timeout: int = 240, base: str | None = None, who: str = "maddlabs") -> dict:
    url = (base or MADDLABS_URL) + path
    headers = {"User-Agent": f"codo/{VERSION}", "Accept": "application/json"}
    data = None
    live = bool(json_body and json_body.get("stream"))
    if json_body is not None:
        data = json.dumps(json_body).encode()
        headers["Content-Type"] = "application/json"
    if live:
        headers["Accept"] = "text/event-stream, application/json"
    if key:
        headers["Authorization"] = f"Bearer {key}"
    req = urllib.request.Request(url, data=data, headers=headers, method=method)
    try:
        with urllib.request.urlopen(req, timeout=timeout, context=_ssl_ctx()) as resp:
            if live and "event-stream" in (resp.headers.get("Content-Type") or ""):
                return _sse_chat(resp)
            return json.loads(resp.read().decode() or "{}")
    except urllib.error.HTTPError as e:
        body = e.read().decode(errors="replace")
        try:
            payload = json.loads(body)
        except ValueError:
            payload = {}
        err = payload.get("error") if isinstance(payload, dict) else None
        detail = (err.get("message") if isinstance(err, dict) else None) or body[:300] or f"HTTP {e.code}"
        if who == "endpoint":
            if e.code in (401, 403):
                detail = _Lf('Serwer odrzucił klucz API ({0}).', e.code)
            elif e.code == 402:
                detail = _L("Brak środków u dostawcy endpointu. ") + str(detail)[:200]
        elif e.code == 401:
            detail = _L("Klucz MaddLabs jest nieważny albo wycofany. Zaloguj się ponownie: /login")
        elif e.code == 402:
            detail = _L("Brak środków na koncie MaddLabs. Doładuj saldo na maddlabs.co.")
        info = payload if isinstance(payload, dict) else {}
        ra = e.headers.get("Retry-After") if e.headers else None
        if ra:
            info = {**info, "_retry_after": ra}
        raise ApiError(e.code, detail, info) from None


def _maddlabs_base(ml: dict) -> str:
