_GIT_FILES_CACHE: dict = {}


def _git_files(root: Path):
    """Pliki śledzone i nieignorowane (git ls-files -co --exclude-standard) albo None poza repozytorium.
    Pamięć podręczna na kilka sekund: grep wołany kilka razy pod rząd nie pyta gita za każdym razem."""
    import time as _time
    key = str(root)
    hit = _GIT_FILES_CACHE.get(key)
    if hit and _time.monotonic() - hit[0] < 5:
        return hit[1]
    files = None
    try:
        r = subprocess.run(["git", "-C", str(root), "ls-files", "-co", "--exclude-standard", "-z"],
                           capture_output=True, timeout=20, stdin=subprocess.DEVNULL)  # nosec B603 B607
        if r.returncode == 0:
            names = sorted(x for x in r.stdout.decode("utf-8", "replace").split("\0") if x)
            files = [root / x for x in names if (root / x).is_file()]
    except (OSError, subprocess.SubprocessError):
        files = None
    _GIT_FILES_CACHE.clear()
    _GIT_FILES_CACHE[key] = (_time.monotonic(), files)
    return files


def t_file_op(args, auto_yes=False):
    """Operacje na plikach: przenieś / kopiuj / usuń (do kosza .doma/trash) / utwórz katalog.
    Nadpisywany plik ma kopię w .doma/backups, każda operacja trafia do dziennika i /undo ją cofa.
    Poza folderem projektu tylko za zgodą użytkownika."""
    import shutil
    action = (args.get("action") or "").lower()
    src = _clean_path_arg(args.get("path") or "")
    dest = _clean_path_arg(args.get("dest") or "")
    if action not in ("move", "copy", "delete", "mkdir", "rename"):
        return "BŁĄD: action = move | copy | delete | mkdir"
    if not src:
        return "BŁĄD: podaj path."
    if action == "rename":
        action = "move"
        if dest and not any(c in dest for c in "/\\"):
            dest = str(Path(src).parent / dest)   # rename: sama nowa nazwa w tym samym folderze
    if action == "mkdir":
        target = _agent_path(src, write=True)
        existed = target.exists()
        if existed and not target.is_dir():
            return f"BŁĄD: {src} istnieje i jest plikiem."
        target.mkdir(parents=True, exist_ok=True)
        if not existed:
            _log_file_op(action="mkdir", src=target)
        return f"Utworzono katalog {src}" if not existed else f"Katalog {src} już istnieje."
    source = _agent_path(src, write=action in ("move", "delete"))
    # Dowiązanie symboliczne: przenosimy/usuwamy samo dowiązanie, nie plik, na który wskazuje
    # (do 0.28.0 „delete link” wynosiło do kosza prawdziwy plik i zostawiało martwe dowiązanie).
    unresolved = Path(os.path.abspath(Path.cwd() / src if not os.path.isabs(src) else src))
    if unresolved.is_symlink() and action in ("move", "delete"):
        _agent_path(str(unresolved.parent), write=True)   # katalog dowiązania musi leżeć w projekcie
        source = unresolved
    if not source.exists() and not source.is_symlink():
        hint = _similar_paths(src)
        return f"BŁĄD: nie ma {src}" + (f". Może: {', '.join(hint)}" if hint else "")
    if _is_within(Path.cwd().resolve(), source) and not source.is_symlink():
        return "BŁĄD: nie operuję na całym katalogu roboczym ani na folderze, który go zawiera."
    if _is_within(source, Path.cwd().resolve() / _DOMA_DIR):
        return "BŁĄD: .doma to kopie zapasowe i kosz Codo; nie ruszam ich narzędziem file_op."
    try:
        if action in ("move", "copy"):
            if not dest:
                return "BŁĄD: podaj dest."
            target = _agent_path(dest, write=True)
            if action == "move" and _same_entry(source, target):
                # Ta sama pozycja pod inną wielkością liter (Windows, macOS: „Raport.TXT” → „raport.txt”).
                # Bez tego: „już istnieje”, a z overwrite=true usunięcie celu usuwało sam plik.
                want = Path(dest.replace("\\", "/")).name or target.name
                if want == source.name:
                    return f"{src}: nazwa bez zmian."
                final = source.with_name(want)
                step = source.with_name(source.name + ".codo-case")
                os.rename(_long_path(source), _long_path(step))
                os.rename(_long_path(step), _long_path(final))
                _log_file_op(action=action, src=source, dest=final, overwrote=False)
                return f"Przeniesiono {src} → {_rel_shown(final)}"
            if target.exists() and target.is_dir() and not (source.is_dir() and args.get("overwrite") and action == "copy"):
                target = target / source.name
            if source.is_dir() and _is_within(target, source):
                return "BŁĄD: nie da się przenieść ani skopiować folderu do jego własnego wnętrza."
            if target.exists() and not args.get("overwrite"):
                return f"BŁĄD: {_rel_shown(target)} już istnieje (overwrite=true, żeby nadpisać; zrobię kopię)."
            if target.exists() and target.is_dir() and action == "move":
                return f"BŁĄD: {_rel_shown(target)} to istniejący folder; przenieś do niego (dest = folder) albo usuń go najpierw."
            target.parent.mkdir(parents=True, exist_ok=True)
            overwrote = target.is_file()
            if overwrote:
                _backup(target)
            if action == "move":
                if overwrote:
                    os.unlink(_long_path(target))   # Windows: rename na istniejący plik się nie udaje
                shutil.move(str(_long_path(source)), str(_long_path(target)))
            elif source.is_dir():
                shutil.copytree(_long_path(source), _long_path(target), dirs_exist_ok=bool(args.get("overwrite")))
            else:
                shutil.copy2(_long_path(source), _long_path(target))
            _log_file_op(action=action, src=source, dest=target, overwrote=overwrote)
            verb = "Przeniesiono" if action == "move" else "Skopiowano"
            return f"{verb} {src} → {_rel_shown(target)}" + (" (poprzednia wersja w .doma/backups)" if overwrote else "")
        what = f"{src}" + (" (katalog)" if source.is_dir() else "")
        if not auto_yes and not confirm_action(_L("Usunąć?"), what, ["delete", src],
                                               reason=args.get("reason") or _L("Porządki zlecone przez agenta.")):
            return "ODRZUCONE przez użytkownika — nie usuwam."
        import time as _time
        trash = Path.cwd() / _DOMA_DIR / "trash" / _time.strftime("%Y%m%d-%H%M%S")
        i = 1
        while (trash / source.name).exists() or os.path.lexists(trash / source.name):
            trash = trash.with_name(trash.name.split("_")[0] + f"_{i}")
            i += 1
        trash.mkdir(parents=True, exist_ok=True)
        _doma_ignored()
        shutil.move(str(_long_path(source)), str(_long_path(trash / source.name)))
        _log_file_op(action="delete", src=source, dest=trash / source.name)
        return f"Usunięto {src} (kopia: {_rel_shown(trash / source.name)}; /undo przywraca)"
    except OSError as e:
        return _write_error(source, e).replace("BŁĄD zapisu", "BŁĄD " + action)


def _html_to_text(html: str) -> tuple:
    """Czytelny tekst ze strony: nagłówki, akapity, listy, linki; bez skryptów i stylów."""
    import html as _html
    title = ""
    m = re.search(r"<title[^>]*>(.*?)</title>", html, re.I | re.S)
    if m:
        title = _html.unescape(re.sub(r"\s+", " ", m.group(1))).strip()
    body = re.sub(r"(?is)<head\b.*?</head>", " ", html)
    body = re.sub(r"(?is)<(script|style|noscript|svg|template|iframe)\b[^>]*>.*?</\1>", " ", body)
    body = re.sub(r"(?is)<!--.*?-->", " ", body)
    body = re.sub(r"(?is)<(nav|footer)[^>]*>.*?</\1>", " ", body) if len(body) > 20000 else body
    body = re.sub(r"(?i)<h([1-6])[^>]*>", lambda m: "\n\n" + "#" * int(m.group(1)) + " ", body)
    body = re.sub(r"(?i)</h[1-6]>", "\n", body)
    body = re.sub(r"(?i)<li\b[^>]*>", "\n- ", body)
    body = re.sub(r"(?i)<(br|/p|/div|/tr|/section|/article|/ul|/ol|/table|p|div|tr)[^>]*>", "\n", body)
    body = re.sub(r'(?is)<a[^>]+href="([^"#][^"]*)"[^>]*>(.*?)</a>',
                  lambda m: f"{re.sub(r'<[^>]+>', '', m.group(2)).strip()} ({m.group(1)})", body)
    body = re.sub(r"(?s)<[^>]+>", " ", body)
    body = _html.unescape(body)
    lines = [re.sub(r"[ \t ]+", " ", line).strip() for line in body.splitlines()]
    text = "\n".join(line for line in lines if line)
    return title, re.sub(r"\n{3,}", "\n\n", text)


def t_web_fetch(args):
    """Pobierz stronę z internetu jako czysty tekst (dokumentacja, artykuł, API JSON)."""
    url = (args.get("url") or "").strip()
    if not re.match(r"^https?://", url, re.I):
        return "BŁĄD: podaj pełny adres http(s)://"
    limit = max(1000, min(100_000, int(args.get("max_chars") or 40_000)))
    req = urllib.request.Request(url, headers={
        "User-Agent": f"Mozilla/5.0 (compatible; Codo/{VERSION})",
        "Accept": "text/html,application/json,text/plain;q=0.9,*/*;q=0.5",
        "Accept-Language": "pl,en;q=0.8"})
    try:
        with urllib.request.urlopen(req, timeout=25, context=_ssl_ctx()) as resp:  # nosec B310 — adres podany przez usera/agenta, tylko http(s)
            ctype = resp.headers.get("Content-Type", "")
            raw = resp.read(3_000_000)
            final = resp.geturl()
            status = resp.status
    except urllib.error.HTTPError as e:
        return f"BŁĄD: HTTP {e.code} dla {url}"
    except (urllib.error.URLError, OSError, TimeoutError) as e:
        return f"BŁĄD: nie udało się pobrać {url}: {describe_error(e)}"
    charset = "utf-8"
    m = re.search(r"charset=([\w-]+)", ctype, re.I)
    if m:
        charset = m.group(1)
    try:
        text = raw.decode(charset, errors="replace")
    except LookupError:
        text = raw.decode("utf-8", errors="replace")
    head = f"URL: {final} · HTTP {status} · {ctype.split(';')[0] or '?'}"
    if "json" in ctype:
        try:
            text = json.dumps(json.loads(text), ensure_ascii=False, indent=1)
        except ValueError:
            pass
        return head + "\n\n" + text[:limit] + ("\n… (obcięte)" if len(text) > limit else "")
    if "html" in ctype or text.lstrip()[:15].lower().startswith(("<!doctype", "<html")):
        title, text = _html_to_text(text)
        head += f"\nTytuł: {title}" if title else ""
    if "text" not in ctype and "html" not in ctype and "xml" not in ctype and "json" not in ctype and ctype:
        return head + f"\n(treść binarna, {_human_size(len(raw))} — nie pokazuję)"
    return head + "\n\n" + text[:limit] + ("\n… (obcięte — podaj większe max_chars albo inny adres)" if len(text) > limit else "")


# ── Procesy w tle (dev serwery, watchery, długie buildy) ───────────────────
_PROC_DIR = ".doma/proc"
_PROCS: dict = {}


def _proc_alive(pid: int) -> bool:
    return _pid_alive(pid)


def _start_background(cmd: str, shell: str = "auto") -> str:
    import time as _time
    import uuid
    pdir = Path.cwd() / _PROC_DIR
    pdir.mkdir(parents=True, exist_ok=True)
    _doma_ignored()
    pid_key = uuid.uuid4().hex[:6]
    log = pdir / f"{pid_key}.log"
    argv, label = _shell_argv(cmd, shell)
    kw: dict = {"stdin": subprocess.DEVNULL, "cwd": str(Path.cwd())}
    if IS_WIN:
        kw["creationflags"] = 0x00000200  # NEW_PROCESS_GROUP — stop bez zabijania konsoli
    else:
        kw["start_new_session"] = True
    with open(log, "wb") as out:
        proc = subprocess.Popen(argv, stdout=out, stderr=subprocess.STDOUT, **kw)  # nosec B603 — komenda zatwierdzona
    meta = {"id": pid_key, "pid": proc.pid, "cmd": cmd, "log": str(log), "start": _time.time()}
    (pdir / f"{pid_key}.json").write_text(json.dumps(meta, ensure_ascii=False), encoding="utf-8")
    _PROCS[pid_key] = proc
    _time.sleep(2.0)
    tail = _log_tail(log, 30)
    state = _L("działa") if proc.poll() is None else _Lf('zakończony (exit={0})', proc.returncode)
    return (_Lf('Proces w tle id={0} (pid {1}) — {2}.\nPodgląd wyjścia: process action=output id={3}; stop: action=stop.\n', pid_key, proc.pid, state, pid_key)
            + (f"Pierwsze linie:\n{tail}" if tail.strip() else _L("(brak wyjścia)")))


def _log_tail(path: Path, lines: int = 60) -> str:
    try:
        # Tylko koniec pliku: log serwera rośnie bez końca, a do 0.28.0 każdy podgląd czytał całość.
        with open(path, "rb") as f:
            f.seek(0, os.SEEK_END)
            size = f.tell()
            f.seek(max(0, size - 200_000))
            data = f.read()
    except OSError:
        return ""
    return "\n".join(_decode_output(data).splitlines()[-lines:])


def _proc_list() -> list:
    pdir = Path.cwd() / _PROC_DIR
    out = []
    for meta_file in sorted(pdir.glob("*.json")) if pdir.is_dir() else []:
        try:
            meta = json.loads(meta_file.read_text(encoding="utf-8"))
        except (OSError, ValueError):
            continue
        proc = _PROCS.get(meta["id"])
        alive = proc.poll() is None if proc else _proc_alive(int(meta["pid"]))
        meta["alive"] = alive
        out.append(meta)
    return out


def t_process(args):
    import time as _time
    action = (args.get("action") or "list").lower()
    pid_key = str(args.get("id") or "")
    procs = _proc_list()
    if action == "list":
        if not procs:
            return "(brak procesów w tle)"
        return "\n".join(f"{p['id']}  {'działa' if p['alive'] else 'zakończony'}  "
                         f"{int(_time.time() - p['start'])}s  $ {p['cmd'][:120]}" for p in procs)
    meta = next((p for p in procs if p["id"] == pid_key), None)
    if not meta:
        return f"BŁĄD: nie ma procesu {pid_key}. Lista: process action=list"
    if action == "output":
        n = max(10, min(400, int(args.get("lines") or 80)))
        tail = _log_tail(Path(meta["log"]), n)
        return f"[{pid_key} {'działa' if meta['alive'] else 'zakończony'}]\n" + (tail or "(brak wyjścia)")
    if action == "stop":
        proc = _PROCS.get(pid_key)
        if meta["alive"]:
            if IS_WIN:
                subprocess.run(["taskkill", "/PID", str(meta["pid"]), "/T", "/F"],  # nosec B603 B607
                               capture_output=True)
            else:
                import signal
                try:
                    os.killpg(int(meta["pid"]), signal.SIGTERM)
                except (OSError, ProcessLookupError):
                    _pid_terminate(int(meta["pid"]))
            if proc:
                try:
                    proc.wait(5)
                except subprocess.TimeoutExpired:
                    proc.kill()
        try:
            (Path.cwd() / _PROC_DIR / f"{pid_key}.json").unlink()
        except OSError:
            pass
        return f"Zatrzymano {pid_key}. Ostatnie linie:\n{_log_tail(Path(meta['log']), 15)}"
    return "BŁĄD: action = list | output | stop"


def _win_fix_start(cmd: str) -> str:
    r"""cmd.exe: `start "X"` traktuje PIERWSZY cudzysłów jako TYTUŁ okna —
    `start "C:\...\App.lnk"` otwiera pustą konsolę i NIC nie uruchamia.
    Gdy jedyny argument w cudzysłowie wygląda na ścieżkę/plik, wstrzykujemy
    pusty tytuł: `start "" "C:\...\App.lnk"` (klasyczna pułapka Windows)."""
    m = re.match(r'^\s*start\s+"([^"]+)"\s*$', cmd, re.IGNORECASE)
    if not m:
        return cmd
    arg = m.group(1)
    looks_like_path = ("\\" in arg or "/" in arg
                       or re.match(r"^[A-Za-z]:", arg)
                       or re.search(r"\.[A-Za-z0-9]{1,4}$", arg))
    if looks_like_path:
        return f'start "" "{arg}"'
    return cmd


def _kill_tree(proc) -> None:
    """Zabija komendę RAZEM z dziećmi. Samo proc.kill() ubijało tylko powłokę:
    `npm run build` albo `sleep` żyły dalej po limicie czasu i po Esc."""
    try:
        if IS_WIN:
            subprocess.run(["taskkill", "/F", "/T", "/PID", str(proc.pid)],  # nosec B603 B607
                           capture_output=True, timeout=15)
        else:
            import signal
            pgid = os.getpgid(proc.pid)
            os.killpg(pgid, signal.SIGTERM)
            try:
                proc.wait(timeout=3)
            except subprocess.TimeoutExpired:
                os.killpg(pgid, signal.SIGKILL)
    except (OSError, subprocess.SubprocessError):
        pass  # nosec B110 — proces już nie żyje
    try:
        proc.kill()
        proc.wait(timeout=5)
    except (OSError, subprocess.SubprocessError):
        pass  # nosec B110


def _run_tree(argv, out_file, timeout: int, env: dict) -> int:
    """subprocess.run z własną grupą procesów; limit czasu i przerwanie (Esc,
    Ctrl+C) sprzątają całe drzewo."""
    kwargs = {"creationflags": 0x00000200} if IS_WIN else {"start_new_session": True}  # CREATE_NEW_PROCESS_GROUP
    proc = subprocess.Popen(argv, stdout=out_file, stderr=subprocess.STDOUT,  # nosec B603 — komenda zatwierdzona
                            stdin=subprocess.DEVNULL, env=env, cwd=str(Path.cwd()), **kwargs)
    try:
        return proc.wait(timeout=timeout)
    except BaseException:  # TimeoutExpired, KeyboardInterrupt
        _kill_tree(proc)
        raise


def t_run_command(args, auto_yes=False):
    cmd = args["command"]
    reason = args.get("reason") or ""
    if not auto_yes:
        if not confirm_action(_L("Czy uruchomić tę komendę?"), cmd, ["command", cmd], reason=reason or _L("Wykonanie komendy zaproponowanej przez agenta.")):
            return "ODRZUCONE przez użytkownika — zaproponuj inne podejście albo zapytaj."
    if args.get("background"):
        return _start_background(cmd, str(args.get("shell") or "auto"))
    # BEZ pipe'ów na OBU systemach (audyt 2026-07-09, F3): gdy komenda odpala
    # aplikację okienkową / proces dziedziczący stdout (start, xdg-open, serwer
    # bez przekierowania), wnuk trzyma uchwyt pipe'a i capture_output wisi NA
    # ZAWSZE — nawet po timeout+kill drugi communicate() czeka na EOF pipe'a
    # trzymanego przez żywego wnuka → worker daemona martwy. Wyjście przez plik
    # tymczasowy + stdin=DEVNULL (nikt nie trzyma naszych uchwytów). Wcześniej
    # tę ochronę miała tylko gałąź Windows; POSIX wisiał identycznie.
    try:
        timeout = max(5, min(900, int(args.get("timeout") or 120)))
    except (TypeError, ValueError):
        timeout = 120
    argv, label = _shell_argv(cmd, str(args.get("shell") or "auto"))
    try:
        import tempfile
        with tempfile.NamedTemporaryFile(mode="r", suffix=".out", delete=False,
                                         encoding="utf-8", errors="replace") as tf:
            out_path = tf.name
        env = {**os.environ, "GIT_PAGER": "cat", "PAGER": "cat", "GIT_TERMINAL_PROMPT": "0",
               "DEBIAN_FRONTEND": "noninteractive", "PYTHONIOENCODING": "utf-8", "NO_COLOR": "1",
               "npm_config_yes": "true"}
        timed_out = False
        code = None
        try:
            with open(out_path, "wb") as out_file:
                # Wyjście do pliku, nie do pipe'a (patrz wyżej: wnuk trzyma uchwyt).
                try:
                    code = _run_tree(argv, out_file, timeout, env)
                except subprocess.TimeoutExpired:
                    timed_out = True
            raw = Path(out_path).read_bytes()
            out = _decode_output(raw)
        finally:
            try:
                Path(out_path).unlink()
            except OSError:
                pass  # nosec B110 — plik może być trzymany przez wnuka
        if timed_out:
            # To, co komenda zdążyła wypisać, zwykle mówi, na czym stanęła.
            tail = out.strip()[-3000:]
            return (f"BŁĄD: przekroczono limit {timeout}s, komenda i jej procesy zostały zatrzymane. "
                    "Serwer albo watcher uruchom z background=true, długi build z większym timeout."
                    + (f"\nOstatnie wyjście:\n{tail}" if tail else ""))
        head = f"exit={code}" + (f" · {label}" if IS_WIN else "")
        return f"{head}\n{out}" if out.strip() else f"{head} (brak wyjścia)"
    except FileNotFoundError as e:
        return f"BŁĄD: nie znaleziono powłoki ({e})"


_CMD_ISMS = re.compile(r'(^\s*start\s+"|%[A-Za-z_]+%|^\s*(dir|copy|del|type|move|ren|rd|md)\s+/|\bset\s+\w+=|^\s*@echo\b|\.(bat|cmd)\b)', re.I)


def _shell_argv(cmd: str, shell: str = "auto") -> tuple:
    """Właściwa powłoka dla systemu. Windows: PowerShell (UTF-8, bez profilu,
    bez pasków postępu) albo cmd.exe dla poleceń w składni cmd."""
    shell = (shell or "auto").lower()
    if IS_WIN:
        name, path = _windows_shell()
        use_cmd = shell == "cmd" or name == "cmd" or (shell == "auto" and _CMD_ISMS.search(cmd))
        if shell in ("bash", "sh"):
            import shutil
            bash = shutil.which("bash")
            if bash:
                return [bash, "-c", cmd], "bash"
        if use_cmd:
            comspec = os.environ.get("COMSPEC", "cmd.exe")
            # Jeden napis, nie lista: list2cmdline zamieniłby " na \\", czego cmd nie rozumie.
            return f'"{comspec}" /d /s /c "chcp 65001 >nul & {_win_fix_start(cmd)}"', "cmd"
        prelude = ("$ProgressPreference='SilentlyContinue'; $ErrorActionPreference='Continue'; "
                   "[Console]::OutputEncoding=[Text.Encoding]::UTF8; $OutputEncoding=[Text.Encoding]::UTF8; ")
        return [path, "-NoLogo", "-NoProfile", "-NonInteractive", "-ExecutionPolicy", "Bypass",
                "-Command", prelude + cmd], name
    if shell == "sh":
        return ["/bin/sh", "-c", cmd], "sh"
    return [_posix_shell(), "-c", cmd], os.path.basename(_posix_shell())


def _decode_output(raw: bytes) -> str:
    """Wyjście komend: UTF-8, a na Windows awaryjnie strona kodowa konsoli."""
    try:
        return raw.decode("utf-8")
    except UnicodeDecodeError:
        if IS_WIN:
            import locale
            for enc in ("cp852", locale.getpreferredencoding(False), "cp1250"):
                try:
                    return raw.decode(enc)
                except (UnicodeDecodeError, LookupError):
                    continue
        return raw.decode("utf-8", "replace")


# ── Aplikacje okienkowe usera: uruchamianie po nazwie + sterowanie ─────────
# open_app: znajdź aplikację (PATH / Start Menu / pulpit / typowe lokalizacje)
# i uruchom ODŁĄCZONĄ od daemona (zero pipe'ów — patrz gotcha w run_command).
# app_use: steruj ŻYWĄ aplikacją — na start Blender (socket-most do bpy).



def _find_app(name: str) -> tuple[str | None, str]:
    """(ścieżka_lub_None, rodzaj) — rodzaj: exe|lnk|mac_app|desktop.
    Szuka po nazwie: PATH → skróty Start Menu/pulpit (Windows) →
    /Applications (mac) → .desktop (Linux). Substring, case-insensitive."""
    import glob
    import shutil
    needle = name.strip().lower()
    if not needle:
        return None, ""
    w = shutil.which(name) or (shutil.which(name + ".exe") if IS_WIN else None)
    if w:
        return w, "exe"
    if IS_WIN:
        home = Path.home()
        roots = [
            Path(os.environ.get("APPDATA", home)) /
            "Microsoft/Windows/Start Menu/Programs",
            Path(os.environ.get("PROGRAMDATA", "C:/ProgramData")) /
            "Microsoft/Windows/Start Menu/Programs",
            home / "Desktop",
            home / "OneDrive/Pulpit", home / "OneDrive/Desktop",
        ]
        hits = []
        for root in roots:
            if not root.is_dir():
                continue
            for pat in ("**/*.lnk", "**/*.url"):
                for p in glob.glob(str(root / pat), recursive=True):
                    if needle in Path(p).stem.lower():
                        hits.append(p)
        if hits:
            # najkrótsza nazwa = najbardziej "główny" skrót (Blender 5.1.lnk
            # wygrywa z Blender 5.1 - odinstaluj.lnk)
            hits.sort(key=lambda p: (len(Path(p).stem), p))
            return hits[0], "lnk"
    elif IS_MAC:
        for p in glob.glob("/Applications/*.app") + glob.glob(
                str(Path.home() / "Applications/*.app")):
            if needle in Path(p).stem.lower():
                return p, "mac_app"
    else:
        for p in glob.glob("/usr/share/applications/*.desktop") + glob.glob(
                str(Path.home() / ".local/share/applications/*.desktop")):
            if needle in Path(p).stem.lower():
                return p, "desktop"
    return None, ""


def _find_blender_exe() -> str | None:
    """Ścieżka do BINARKI Blendera (nie skrótu) — potrzebna, by wystartować
    z mostkiem sterowania (--python). Typowe lokalizacje per system."""
    import glob
    import shutil
    w = shutil.which("blender")
    if w:
        return w
    cands: list[str] = []
    if IS_WIN:
        for pf in (os.environ.get("PROGRAMFILES", "C:/Program Files"),
                   os.environ.get("PROGRAMFILES(X86)", "C:/Program Files (x86)")):
            cands += glob.glob(str(Path(pf) / "Blender Foundation" /
                                   "Blender*" / "blender.exe"))
        cands += glob.glob(str(Path.home() / "AppData/Local/Programs/"
                               "Blender Foundation/Blender*/blender.exe"))
    elif IS_MAC:
        cands += glob.glob("/Applications/Blender.app/Contents/MacOS/Blender")
    else:
        cands += glob.glob("/usr/bin/blender") + glob.glob("/snap/bin/blender")
    # najnowsza wersja (sort po ścieżce łapie "Blender 4.2" < "Blender 5.1")
    return sorted(cands)[-1] if cands else None


# Most bpy: nasluch 127.0.0.1:PORT (losowy), exec kodu w GLOWNYM watku Blendera
# (bpy.app.timers) - zmiany widac na zywo. Bezpieczenstwo (audyt 2026-07-09,
# F4): protokol = pierwsza linia to TOKEN (wspoldzielony sekret z pliku 0600),
# reszta = kod. Zly/brak tokenu -> odmowa. Bez tego dowolny lokalny proces mogl
# sie polaczyc z portem i wykonac kod jako user (lokalne RCE).
_BLENDER_BRIDGE_SRC = r'''
import bpy, socket, threading, queue, io, traceback
from contextlib import redirect_stdout

_PORT = {port}
_TOKEN = {token!r}
_q = queue.Queue()

def _serve():
    s = socket.socket(socket.AF_INET, socket.SOCK_STREAM)
    s.setsockopt(socket.SOL_SOCKET, socket.SO_REUSEADDR, 1)
    try:
        s.bind(("127.0.0.1", _PORT))
    except OSError:
        return  # inny Blender juz trzyma most - ta instancja bez nasluchu
    s.listen(4)
    while True:
        c = None
        try:
            c, _ = s.accept()
            c.settimeout(10)
            chunks = []
            while True:
                b = c.recv(65536)
                if not b:
                    break
                chunks.append(b)
            data = b"".join(chunks).decode("utf-8", "replace")
            tok, _, code = data.partition("\n")
            if tok.strip() != _TOKEN:
                try:
                    c.sendall(b"ERROR\nbrak/zly token mostu")
                    c.shutdown(socket.SHUT_WR)
                finally:
                    c.close()
                continue
            _q.put((c, code))
        except Exception:
            if c is not None:
                try:
                    c.close()
                except Exception:
                    pass

def _pump():
    while not _q.empty():
        c, code = _q.get_nowait()
        buf = io.StringIO()
        try:
            with redirect_stdout(buf):
                exec(compile(code, "<doma>", "exec"), {{"bpy": bpy, "print": print}})
            out = "OK\n" + buf.getvalue()
        except Exception:
            out = "ERROR\n" + buf.getvalue() + traceback.format_exc()
        try:
            c.sendall(out[:20000].encode("utf-8", "replace"))
            c.shutdown(socket.SHUT_WR)
            c.close()
        except Exception:
            pass
    return 0.2

threading.Thread(target=_serve, daemon=True).start()
bpy.app.timers.register(_pump, persistent=True)
print("[doma] most Blendera aktywny (127.0.0.1:%d, token wymagany)" % _PORT)
'''


def _blender_bridge_meta(create: bool = False):
    """Zwraca (port, token) mostu Blendera z CONFIG_DIR/blender_bridge.json.
    create=True → losuje nowe i zapisuje plik 0600 (przy starcie przez open_app).
    Bez create zwraca zapisane meta albo (None, None)."""
    import json as _json
    import secrets as _secrets
    meta_file = CONFIG_DIR / "blender_bridge.json"
    if create:
        port = _secrets.randbelow(20000) + 40000  # 40000..59999
        token = _secrets.token_hex(16)
        CONFIG_DIR.mkdir(parents=True, exist_ok=True)
        meta_file.write_text(_json.dumps({"port": port, "token": token}),
                             encoding="utf-8")
        try:
            os.chmod(meta_file, 0o600)
        except OSError:
            pass  # nosec B110 — chmod best-effort (Windows brak POSIX perms)
        return port, token
    try:
        d = _json.loads(meta_file.read_text(encoding="utf-8"))
        return int(d["port"]), str(d["token"])
    except (OSError, ValueError, KeyError):
        return None, None


def _http_server(addr: tuple, handler):
    """ThreadingHTTPServer bez socket.getfqdn() w server_bind: odwrotne DNS dla 127.0.0.1 potrafi trwać
    kilkanaście sekund (macOS w CI, sieci z wolnym DNS) i tyle czekało okno `codo ui`, zanim podało adres."""
    import http.server
    import socketserver

    class _Server(http.server.ThreadingHTTPServer):
        def server_bind(self):
            socketserver.TCPServer.server_bind(self)
            host, port = self.server_address[:2]
            self.server_name, self.server_port = str(host), port

    return _Server(addr, handler)


def _launch_detached(cmd_list: list | None = None, shell_cmd: str | None = None):
    """Start aplikacji okienkowej CAŁKOWICIE odłączonej od daemona: DEVNULL na
    wszystkich uchwytach (wnuk z pipe'em = wiszący worker) + nowa sesja/grupa."""
    kw: dict = dict(stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL,
                    stderr=subprocess.DEVNULL)
    if IS_WIN:
        kw["creationflags"] = 0x00000008 | 0x00000200  # DETACHED | NEW_GROUP
    else:
        kw["start_new_session"] = True
    if shell_cmd is not None:
        subprocess.Popen(shell_cmd, shell=True, **kw)  # nosec B602 — celowo
    else:
        subprocess.Popen(cmd_list, **kw)  # nosec B603


def t_open_app(args, auto_yes=False):
    """Uruchom aplikację na TEJ maszynie po nazwie (np. "blender", "discord").
    Blender startuje z mostkiem sterowania (app_use wykonuje kod bpy na żywo)."""
    name = (args.get("name") or "").strip()
    if not name:
        return "BŁĄD: podaj name (nazwa aplikacji, np. blender)."
    _note("Aplikacja", f"{bold(name)}")
    if not auto_yes:
        if not confirm_action(_L("Uruchomić aplikację?"), name, ["open_app", name]):
            return "ODRZUCONE przez użytkownika."
    # Blender: binarka + --python most → sterowanie przez app_use.
    if "blender" in name.lower():
        exe = _find_blender_exe()
        if exe:
            bridge = CONFIG_DIR / "blender_bridge.py"
            try:
                CONFIG_DIR.mkdir(parents=True, exist_ok=True)
                _bport, _btoken = _blender_bridge_meta(create=True)
                bridge.write_text(
                    _BLENDER_BRIDGE_SRC.format(port=_bport, token=_btoken),
                    encoding="utf-8")
                _launch_detached([exe, "--python", str(bridge)])
                return (f"OK: Blender uruchomiony ({exe}) Z MOSTKIEM sterowania "
                        "— akcja app_use (app=blender, code=python z bpy) "
                        "wykonuje kod w otwartym Blenderze na żywo. Daj mu "
                        "kilka sekund na start przed pierwszym app_use.")
            except OSError as e:
                return f"BŁĄD startu Blendera: {e}"
    path, kind = _find_app(name)
    if not path:
        return (f"BŁĄD: nie znalazłem aplikacji „{name}” (PATH, Start Menu, "
                "pulpit). Poproś użytkownika o dokładną nazwę albo ścieżkę.")
    try:
        if kind == "lnk":
            _launch_detached(shell_cmd=f'start "" "{path}"')
        elif kind == "mac_app":
            _launch_detached(["open", "-a", path])
        elif kind == "desktop":
            gio = _find_bin("gio")
            if gio:
                _launch_detached([gio, "launch", path])
            else:
                return ("BŁĄD: znalazłem skrót .desktop, ale brak `gio` do "
                        "uruchomienia. Użyj run_command z binarką aplikacji.")
        else:
            _launch_detached([path])
    except OSError as e:
        return f"BŁĄD uruchamiania {path}: {e}"
    extra = (" (uruchomiony bez mostka sterowania — nie znalazłem binarki "
             "blender.exe, app_use nie zadziała)"
             if "blender" in name.lower() else "")
    return f"OK: uruchomiono {Path(path).name} ({path}){extra}"


def t_app_use(args, auto_yes=False):
    """Steruj URUCHOMIONĄ aplikacją. Obsługiwane: app=blender — code (python
    z bpy) wykonuje się w otwartym Blenderze usera (żywy viewport)."""
    import socket as _sock
    app = (args.get("app") or "").strip().lower()
    code_src = args.get("code") or ""
    if app != "blender":
        return ("BŁĄD: app_use obsługuje na razie app=blender. Inne aplikacje: "
                "uruchom przez open_app, a operacje rób ich CLI/API przez "
                "run_command (np. ffmpeg, git, soffice --convert-to).")
    if not code_src.strip():
        return "BŁĄD: puste pole code (python z bpy)."
    _bport, _btoken = _blender_bridge_meta()
    if not _bport:
        return ("BŁĄD: brak aktywnego mostu Blendera. Uruchom Blendera akcją "
                "open_app (name=blender) — dopiero wtedy powstaje most z tokenem.")
    _note("Blender", f"{dim(code_src.splitlines()[0][:100])}")
    if not auto_yes:
        if not confirm_action(_L("Wykonać w Blenderze?"), code_src, ["blender", code_src]):
            return "ODRZUCONE przez użytkownika."
    try:
        c = _sock.create_connection(("127.0.0.1", _bport), timeout=5)
    except OSError:
        return ("BŁĄD: brak połączenia z Blenderem — most nie działa. "
                "Uruchom Blendera akcją open_app (name=blender), odczekaj "
                "kilka sekund i ponów. (Blender otwarty ręcznie przez usera "
                "NIE ma mostka — trzeba go uruchomić przez open_app.)")
    try:
        c.settimeout(60)
        # Protokół: pierwsza linia = token (sekret z pliku 0600), reszta = kod.
        c.sendall((_btoken + "\n" + code_src).encode("utf-8"))
        c.shutdown(_sock.SHUT_WR)
        chunks = []
        while True:
            b = c.recv(65536)
            if not b:
                break
            chunks.append(b)
        reply = b"".join(chunks).decode("utf-8", "replace")
    except _sock.timeout:
        return "BŁĄD: Blender nie odpowiedział w 60s (ciężka operacja?)."
    finally:
        try:
            c.close()
        except OSError:
            pass
    if reply.startswith("ERROR\n"):
        return f"BŁĄD w Blenderze:\n{reply[6:][:6000]}"
    out = reply[3:].strip() if reply.startswith("OK\n") else reply.strip()
    return f"OK (wykonane w Blenderze)\n{out[:6000]}" if out else \
        "OK (wykonane w Blenderze, bez wyjścia)"


def _detect_pm():
    """Wykryj menedżer zależności po plikach projektu."""
    cwd = Path.cwd()
    if (cwd / "requirements.txt").exists() or (cwd / "pyproject.toml").exists():
        return "pip"
    if (cwd / "package.json").exists():
        return "npm"
    return None


def t_install(args, auto_yes=False):
    """Instaluje zależności — pip (w .venv, omija PEP 668) lub npm. Za zgodą
    użytkownika. packages: lista paczek; brak = z requirements.txt/package.json."""
    manager = (args.get("manager") or _detect_pm() or "").lower()
    packages = args.get("packages") or []
    if isinstance(packages, str):
        packages = [packages]
    if manager not in ("pip", "npm"):
        return ("BŁĄD: nie wykryto menedżera zależności (brak requirements.txt / "
                "package.json). Podaj manager=pip|npm albo utwórz plik zależności.")
    if manager == "pip":
        desc = ("pip install " + (" ".join(packages) if packages else "-r requirements.txt")
                + " (w .venv)")
    else:
        desc = "npm install" + (" " + " ".join(packages) if packages else "")
    _note("Instalacja", f"{bold(desc)}")
    if not auto_yes:
        if not confirm_action(_L("Czy zainstalować zależności?"), desc, ["install", manager, packages], reason=args.get("reason") or _L("Pobranie pakietów potrzebnych do uruchomienia projektu.")):
            return "ODRZUCONE przez użytkownika — nie instaluję."
    if manager == "pip":
        venv = Path.cwd() / ".venv"
        if not venv.exists():
            v = subprocess.run([_python_cmd(), "-m", "venv", ".venv"],
                               capture_output=True, text=True)
            if v.returncode != 0:
                return f"BŁĄD tworzenia .venv:\n{(v.stderr or v.stdout)[:2000]}"
        # Windows: pip.exe w Scripts\; POSIX: bin/pip. Gdy brak pliku pip,
        # użyj `python -m pip` (zawsze działa w świeżym venvie).
        bindir = _venv_bindir(venv)
        pip_exe = bindir / ("pip.exe" if IS_WIN else "pip")
        py_exe = bindir / ("python.exe" if IS_WIN else "python")
        if pip_exe.exists():
            base = [str(pip_exe)]
        else:
            base = [str(py_exe) if py_exe.exists() else _python_cmd(), "-m", "pip"]
        cmd = [*base, "install", *(packages or ["-r", "requirements.txt"])]
    else:
        cmd = ["npm", "install", *packages]
    try:
        r = subprocess.run(cmd, capture_output=True, text=True, errors="replace", timeout=600,
                           cwd=str(Path.cwd()))
    except FileNotFoundError:
        return f"BŁĄD: brak narzędzia {cmd[0]} na serwerze."
    except subprocess.TimeoutExpired:
        return "BŁĄD: instalacja przekroczyła 600s."
    out = ((r.stdout or "") + (r.stderr or "")).strip()
    tail = out[-3000:]
    if r.returncode != 0:
        return f"install {desc} → BŁĄD (kod {r.returncode}):\n{tail}"
    hint = ("\nGotowe. Uruchom aplikację przez run_app "
            "(np. command='.venv/bin/python app.py', port=5000)."
            if manager == "pip" else "\nGotowe (npm).")
    return f"install {desc} → OK\n{tail}{hint}"


_RUN_APP: dict = {}   # folder → Popen aplikacji z run_app (poll widzi, że padła)


def t_run_app(args, auto_yes=False):
    """Uruchamia/zatrzymuje aplikację w TLE (dynamiczny serwer, np. Flask/Node) i
    zwraca URL. app_action: start (domyślnie) | stop | status | logs.
    command: polecenie startu; port: na jakim porcie nasłuchuje aplikacja."""
    import socket as _sock
    import time as _time
    act = (args.get("app_action") or "start").lower()
    port = int(args.get("port") or 5000)
    pidfile = Path.cwd() / _DOMA_DIR / "app.pid"
    logfile = Path.cwd() / _DOMA_DIR / "app.log"
    pidfile.parent.mkdir(parents=True, exist_ok=True)

    def _alive():
        proc = _RUN_APP.get(str(Path.cwd()))
        if proc is not None:
            return proc.poll() is None   # własne dziecko: poll odróżnia działający proces od zombie
        try:
            return _pid_alive(int(pidfile.read_text()))
        except Exception:
            return False

    ip = "127.0.0.1"
    try:
        s = _sock.socket(_sock.AF_INET, _sock.SOCK_DGRAM)
        s.connect(("8.8.8.8", 80)); ip = s.getsockname()[0]; s.close()
    except Exception:
        pass

    if act == "stop":
        if pidfile.exists() and _alive():
            try:
                pid = int(pidfile.read_text())
                if IS_WIN:
                    _pid_terminate(pid)
                else:
                    import signal
                    # cała grupa procesów: `cd x && npm run dev` zostawiało do 0.28.0 serwer na porcie
                    try:
                        os.killpg(pid, signal.SIGTERM)
                    except OSError:
                        _pid_terminate(pid)
            except Exception:
                pass  # nosec B110
        proc = _RUN_APP.pop(str(Path.cwd()), None)
        if proc is not None:
            try:
                proc.wait(3)
            except Exception:  # noqa: BLE001
                pass  # nosec B110
        pidfile.unlink(missing_ok=True)
        return "Aplikacja zatrzymana."
    if act == "logs":
        tail = _log_tail(logfile, 80)
        return ("Log aplikacji (ostatnie linie):\n" + tail) if tail else "(brak logów — aplikacja jeszcze nie startowała)"
    if act == "status":
        return (f"Aplikacja DZIAŁA: http://{ip}:{port}/" if pidfile.exists() and _alive()
                else "Aplikacja nie jest uruchomiona (app_action=start).")

    # start
    if pidfile.exists() and _alive():
        return f"Aplikacja już działa: http://{ip}:{port}/ (stop: app_action=stop)"
    command = args.get("command")
    if not command:
        return "BŁĄD: podaj command startu, np. '.venv/bin/python app.py'."
    print(f"\n  {yellow(_L('▶ Uruchomienie aplikacji:'))} {bold(command)}")
    if not auto_yes:
        if not confirm_action(_L("Uruchomić aplikację?"), command, ["run_app", command, port]):
            return "ODRZUCONE przez użytkownika — nie uruchamiam."
    kw: dict = {"stdin": subprocess.DEVNULL, "cwd": str(Path.cwd())}
    if IS_WIN:
        kw["creationflags"] = 0x00000200  # NEW_PROCESS_GROUP
    else:
        kw["start_new_session"] = True     # własna grupa: stop zabija też dzieci powłoki
    log = open(logfile, "wb")
    try:
        proc = subprocess.Popen(command, shell=True, stdout=log, stderr=subprocess.STDOUT, **kw)  # nosec B602 — komenda zatwierdzona
    finally:
        log.close()  # dziecko dziedziczy fd; rodzic nie trzyma uchwytu
    pidfile.write_text(str(proc.pid))
    _RUN_APP[str(Path.cwd())] = proc
    # Do 15 s: czekamy, aż port odpowie albo proces się skończy (do 0.28.0 po 1,5 s zgłaszaliśmy
    # sukces także wtedy, gdy aplikacja padła: proces-zombie wyglądał na żywy).
    listening = False
    deadline = _time.monotonic() + 15
    while _time.monotonic() < deadline:
        if proc.poll() is not None:
            break
        try:
            with _sock.create_connection(("localhost", port), timeout=0.5):   # IPv4 i ::1 (Vite, Node)
                listening = True
                break
        except OSError:
            _time.sleep(0.4)
    if proc.poll() is not None:
        pidfile.unlink(missing_ok=True)
        _RUN_APP.pop(str(Path.cwd()), None)
        return f"BŁĄD: aplikacja zakończyła się zaraz po starcie (kod {proc.returncode}).\n{_log_tail(logfile, 40)}"
    if not listening:
        return (f"Aplikacja działa w tle (pid {proc.pid}), ale po 15 s nic nie nasłuchuje na porcie {port}. "
                "Sprawdź port w logach (app_action=logs) albo podaj właściwy port.\n" + _log_tail(logfile, 20))
    return (f"Aplikacja uruchomiona i odpowiada: http://127.0.0.1:{port}/ (w sieci: http://{ip}:{port}/)\n"
            f"(w tle; logi: app_action=logs, zatrzymanie: app_action=stop. "
            f"Jeśli nie otwiera się z zewnątrz — otwórz port {port} w firewall.)")


# ── Live preview w oknie canvas: HTML „na wynos" (inline CSS/JS/obrazy) ──────
def _find_asset(base: Path, ref: str) -> Path | None:
    ref = ref.split("?")[0].split("#")[0].strip()
    if not ref:
        return None
    base = base.resolve()
    cwd = Path.cwd().resolve()
    for cand in (base / ref, base / ref.lstrip("/"),
                 base / "static" / ref.lstrip("/"), base / "public" / ref.lstrip("/"),
                 cwd / ref.lstrip("/"), cwd / "static" / ref.lstrip("/"),
                 cwd / "public" / ref.lstrip("/")):
        try:
            rc = cand.resolve()
            # Jail: zasób musi leżeć w poddrzewie strony ALBO cwd (bez ../ ucieczki
            # poza katalog strony — chroni przed inlinowaniem sekretów).
            if cand.is_file() and (
                base in rc.parents or rc == base
                or cwd in rc.parents or rc == cwd
            ):
                return cand
        except Exception:
            continue
    return None


def _inline_assets(html: str, base: Path) -> str:
    """Zamienia lokalne <link>/<script>/<img> na treść inline / data-URI, żeby
    strona wyrenderowała się samodzielnie w iframe srcdoc (bez serwera)."""
    import base64
    import mimetypes
    ext = ("http://", "https://", "//", "data:")

    def css_sub(m):
        href = m.group("h")
        if href.startswith(ext):
            return m.group(0)
        f = _find_asset(base, href)
        if not f:
            return m.group(0)
        try:
            return f"<style>\n{f.read_text(encoding='utf-8', errors='replace')}\n</style>"
        except Exception:
            return m.group(0)

    html = re.sub(r'<link\b[^>]*\brel=["\']stylesheet["\'][^>]*\bhref=["\'](?P<h>[^"\']+)["\'][^>]*>',
                  css_sub, html, flags=re.I)
    html = re.sub(r'<link\b[^>]*\bhref=["\'](?P<h>[^"\']+)["\'][^>]*\brel=["\']stylesheet["\'][^>]*>',
                  css_sub, html, flags=re.I)

    def js_sub(m):
        src = m.group("s")
        if src.startswith(ext):
            return m.group(0)
        f = _find_asset(base, src)
        if not f:
            return m.group(0)
        try:
            return f"<script>\n{f.read_text(encoding='utf-8', errors='replace')}\n</script>"
        except Exception:
            return m.group(0)

    html = re.sub(r'<script\b[^>]*\bsrc=["\'](?P<s>[^"\']+)["\'][^>]*>\s*</script>',
                  js_sub, html, flags=re.I)

    def img_sub(m):
        src = m.group("s")
        if src.startswith(ext):
            return m.group(0)
        f = _find_asset(base, src)
        if not f:
            return m.group(0)
        try:
            b = f.read_bytes()
            if len(b) > 512 * 1024:
                return m.group(0)
            mime = mimetypes.guess_type(str(f))[0] or "image/png"
            return m.group(0).replace(src, f"data:{mime};base64,{base64.b64encode(b).decode()}")
        except Exception:
            return m.group(0)

    html = re.sub(r'<img\b[^>]*\bsrc=["\'](?P<s>[^"\']+)["\']', img_sub, html, flags=re.I)
    return html


def t_render(args):
    """Zwraca samodzielny HTML strony (inline assety) do podglądu w oknie canvas.
    Domyślnie szuka index.html (też w templates/ i public/)."""
    ref = (args.get("path") or "").strip()
    cands = []
    if ref:
        # SECURITY: path bywa wrogim inputem. `_panel_page_path` wpuszcza tylko
        # .html/.htm w cwd/HOME/web-rootach → `render path=../../.env` odrzucone
        # (nie-.html), a strony spoza cwd (mapper panelu) działają.
        try:
            cands.append(_panel_page_path(ref))
        except ValueError as e:
            return f"BŁĄD: {e}"
    cands += [Path.cwd() / "index.html", Path.cwd() / "templates" / "index.html",
              Path.cwd() / "public" / "index.html", Path.cwd() / "src" / "index.html"]
    target = None
    for c in cands:
        try:
            if c.is_file():
                target = c
                break
        except Exception:
            continue
    if not target:
        return "BŁĄD: nie znalazłem pliku HTML do podglądu — podaj path (np. index.html)."
    html = target.read_text(encoding="utf-8", errors="replace")
    html = _inline_assets(html, target.parent)
    return html


# Popularne porty lokalnych serwerów aplikacji (Flask/Django/Node/Vite/…).
_LOCAL_PORTS = (5000, 8000, 8080, 3000, 5173, 4000, 8888, 80)


def _looks_like_html(data: bytes) -> bool:
    head = data[:2048].lstrip().lower()
    return head.startswith((b"<!doctype", b"<html")) or b"<head" in head or b"<body" in head


def _detect_nginx():
    """Czyta konfigurację nginx (read-only) i wyłuskuje: domeny (server_name),
    lokalne upstreamy (proxy_pass na 127.0.0.1) i katalogi statyczne (root).
    Dzięki temu podgląd znajduje strona serwera SAM, bez wpisywania adresu."""
    import glob
    domains, upstreams, roots = [], [], []
    files = (glob.glob("/etc/nginx/sites-enabled/*")
             + glob.glob("/etc/nginx/conf.d/*.conf")
             + ["/etc/nginx/nginx.conf"])
    for f in files:
        try:
            txt = Path(f).read_text(errors="replace")
        except Exception:
            continue  # nosec B112 — brak dostępu do configu = pomiń
        for m in re.finditer(r'server_name\s+([^;]+);', txt):
            for d in m.group(1).split():
                d = d.strip()
                if (d and "." in d and d not in ("_", "localhost")
                        and not d.startswith("*") and d not in domains):
                    domains.append(d)
        for m in re.finditer(r'proxy_pass\s+(https?://[^;\s]+)', txt):
            u = m.group(1).rstrip("/")
            if re.search(r'127\.0\.0\.1|localhost|\[::1\]', u) and u + "/" not in upstreams:
                upstreams.append(u + "/")
        for m in re.finditer(r'\broot\s+([^;]+);', txt):
            r = m.group(1).strip()
            if r and r not in roots and Path(r).is_dir():
                roots.append(r)
    return {"domains": domains, "upstreams": upstreams, "roots": roots}


def _nginx_site_for_cwd():
    """Domena z nginx dla KATALOGU URUCHOMIENIA: zwraca https://domena tylko,
    gdy cwd jest pod rootem vhosta (albo root pod cwd — monorepo z podkatalogiem
    web-root). Domeny i rooty łączone per plik konfiguracyjny, żeby nie skleić
    domeny jednego vhosta z rootem innego."""
    import glob
    cwd = Path.cwd().resolve()
    files = (glob.glob("/etc/nginx/sites-enabled/*")
             + glob.glob("/etc/nginx/conf.d/*.conf")
             + ["/etc/nginx/nginx.conf"])
    for f in files:
        try:
            txt = Path(f).read_text(errors="replace")
        except Exception:
            continue  # nosec B112 — brak dostępu do configu = pomiń
        doms = [d for m in re.finditer(r'server_name\s+([^;]+);', txt)
                for d in m.group(1).split()
                if "." in d and d not in ("_", "localhost")
                and not d.startswith("*")]
        if not doms:
            continue
        for m in re.finditer(r'\broot\s+([^;]+);', txt):
            r = m.group(1).strip().strip('"').strip("'")
            try:
                rp = Path(r).resolve()
            except Exception:
                continue  # nosec B112 — krzywa ścieżka w configu = pomiń
            if not rp.is_dir():
                continue
            if cwd == rp or rp in cwd.parents or cwd in rp.parents:
                return "https://" + doms[0]
    return None


def _probe_html(urls, timeout=2.5):
    """Sonduje wiele URL RÓWNOLEGLE (krótki timeout) i zwraca pierwszy (wg
    priorytetu z listy), który zwrócił HTML. Bez tego 8 portów × timeout wisiało."""
    import concurrent.futures as cf
    uniq, seen = [], set()
    for u in urls:
        if u and u not in seen:
            seen.add(u)
            uniq.append(u)
    got = {}
    with cf.ThreadPoolExecutor(max_workers=min(10, len(uniq) or 1)) as ex:
        futs = {ex.submit(_fetch_url_bytes, u, 4_000_000, timeout): u for u in uniq}
        for fut in cf.as_completed(futs):
            u = futs[fut]
            try:
                data = fut.result()
            except Exception:
                data = None
            if data and _looks_like_html(data):
                got[u] = data
    for u in uniq:  # zachowaj priorytet
        if u in got:
            return u, got[u]
    return None, None


def t_smart_preview(args):
    """AUTOMATYCZNY podgląd strony Z SERWERA — bez wpisywania adresu. Kolejność:
    1) publiczny URL (jeśli znany), 2) domena z nginx (server_name), 3) upstream
    z nginx (proxy_pass), 4) lokalny serwer na typowych portach — łapie
    wyrenderowany Flask/Django/PHP z SZABLONÓW, 5) render z plików (root nginx →
    cwd). Zawsze inline'uje CSS/JS/obrazy. Sondowanie równoległe (szybkie)."""
    from urllib.parse import urljoin
    path = (args.get("path") or "").strip()
    site_url = (args.get("site_url") or "").strip()
    route = path if path.startswith("/") else ""
    r = (route or "/").lstrip("/")

    nginx = _detect_nginx()
    candidates = []
    if site_url.startswith(("http://", "https://")):
        base = site_url if site_url.endswith("/") else site_url + "/"
        candidates.append(urljoin(base, r))
    for dom in nginx["domains"]:
        candidates.append(f"https://{dom}/{r}")
    for up in nginx["upstreams"]:
        candidates.append(urljoin(up, r))
    for p in _LOCAL_PORTS:
        candidates.append(f"http://127.0.0.1:{p}/{r}")

    url, data = _probe_html(candidates, timeout=2.5)
    if data:
        html = data.decode("utf-8", "replace")
        try:
            html = _inline_assets_url(html, url)
        except Exception:
            pass  # nosec B110 — inline best-effort
        if len(html) > 600000:
            html = html[:600000] + "\n<!-- … (obcięte) -->"
        return f"<!-- doma-preview-src: {url} -->\n{html}"

    # Nic po sieci → render statyczny z plików: najpierw root(y) nginx, potem cwd.
    for root in nginx["roots"]:
        idx = Path(root) / (path if path.endswith((".html", ".htm")) else "index.html")
        try:
            if idx.is_file():
                html = _inline_assets(idx.read_text(encoding="utf-8", errors="replace"), idx.parent)
                return f"<!-- doma-preview-src: {idx} -->\n{html}"
        except Exception:
            continue  # nosec B112
    out = t_render({"path": path})
    if out.startswith("BŁĄD"):
        hint = ""
        if nginx["domains"]:
            hint = f" Wykryto domeny nginx: {', '.join(nginx['domains'][:3])} — sprawdź, czy strona odpowiada."
        return ("BŁĄD: nie znalazłem strony do podglądu (brak żywego serwera i pliku "
                f".html w tym katalogu).{hint} Uruchom `codo serve` w katalogu strony "
                "lub z flagą --site https://twoja-domena.")
    return f"<!-- doma-preview-src: pliki -->\n{out}"


