def _trig_expand(path) -> str:
    p = str(path or "").strip()
    return os.path.normpath(os.path.abspath(os.path.expanduser(p))) if p else ""


def _trig_inside(path: str, folder: str) -> bool:
    f = folder.rstrip("/\\")
    return bool(f) and (path == f or path.startswith(f + os.sep) or path.startswith(f + "/"))


def _trig_ignored(path: str, root: str) -> bool:
    """Nie warte obudzenia: poza folderem, ukryte (także w ukrytym folderze), pobieranie w toku, pliki tymczasowe."""
    r = root.rstrip("/\\")
    if not _trig_inside(path, r) or path == r:
        return True
    parts = [p for p in re.split(r"[\\/]", path[len(r) + 1:]) if p]
    for p in parts:
        if p.startswith((".", "~$")) or p.endswith("~") or p == "Icon\r" or p.lower() in ("desktop.ini", "thumbs.db"):
            return True
        if "." in p and p.rsplit(".", 1)[1].lower() in _TRIG_TEMP:
            return True
    return not parts


def _trig_batch(last_wake=None) -> dict:
    """To, co wydarzyło się od ostatniego obudzenia (TriggerMath.Batch)."""
    return {"items": [], "more": 0, "first": None, "last": None, "last_wake": last_wake, "noted": 0}


def _trig_count(b: dict) -> int:
    return len(b["items"]) + int(b["more"])


def _trig_add(b: dict, new: list, at: float, keep: int = _TRIG_KEPT) -> None:
    """Nowe zdarzenia do paczki: każde raz, w kolejności przyjścia; to samo jeszcze raz zaczyna spokój od nowa."""
    seen, fresh = set(b["items"]), False
    for n in new:
        if n in seen:
            continue
        fresh = True
        seen.add(n)
        if len(b["items"]) < keep:
            b["items"].append(n)
        else:
            b["more"] += 1
    if new:
        b["last"] = at
    if fresh and b["first"] is None:
        b["first"] = at


def _trig_step(b: dict, now: float, settle: float, every: float) -> tuple:
    """("idle",) | ("settling",) | ("held", do_kiedy, ile_nowych) | ("fire",)."""
    if _trig_count(b) <= 0:
        return ("idle",)
    if b["last"] is not None and now - b["last"] < settle:
        return ("settling",)
    if b["last_wake"] is not None and now - b["last_wake"] < every:
        return ("held", b["last_wake"] + every, max(0, _trig_count(b) - int(b["noted"])))
    return ("fire",)


def _trig_shown(b: dict, cap: int = _TRIG_LISTED) -> tuple:
    return b["items"][:cap], max(0, len(b["items"]) - cap) + int(b["more"])


def _trig_clip(text, n: int) -> str:
    t = " ".join(str(text or "").split())
    return t if len(t) <= n else t[:n - 1].rstrip() + "…"


def _trig_fold(s) -> str:
    import unicodedata
    t = unicodedata.normalize("NFKD", str(s or "").lower().replace("ł", "l"))
    return "".join(c for c in t if not unicodedata.combining(c)).strip()


def _trig_has(text, words) -> bool:
    """Któreś ze słów (po przecinku) jest w tekście; bez słów pasuje wszystko."""
    ws = [w for w in (_trig_fold(x) for x in str(words or "").split(",")) if w]
    if not ws:
        return True
    t = _trig_fold(text)
    return any(w in t for w in ws)


def _trig_fits(m: dict, sender: str, subject: str, own: list) -> bool:
    """Mail pasuje: nie Twój (to, co piszesz do Codo, jest poleceniem), od tego nadawcy, z tym w temacie."""
    frm = str(m.get("from") or "").lower()
    if not frm or any(o and str(o).lower() == frm for o in own):
