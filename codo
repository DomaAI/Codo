    try:
        return _repl(creds, model, auto_yes)
    finally:
        LIVE.session_end()
        SYNC.close()
        _set_title("")


def _repl(creds: dict, model: str | None, auto_yes: bool) -> int:
    global _INPUT_MODE
    _setup_readline()
    mode = "auto" if auto_yes else "ask"
    SESSION["interactive"] = True
    messages: list = [system_message(SYSTEM_PROMPT)]
    start = SESSION.pop("start_resume", None)
    if start == "last":
        last = _convo_list()
        if last:
            _convo_restore(last[0], messages)
        else:
            print(dim(_L("  Brak zapisanej rozmowy w tym folderze, zaczynam nową.")))
    elif start == "pick":
        picked = _convo_pick()
        if picked:
            _convo_restore(picked, messages)
    import shutil
    hint = _L("  /commands komendy  ·  @ plik  ·  ! komenda  ·  esc przerywa")
    if shutil.get_terminal_size((80, 24)).columns <= len(hint):
        hint = _L("  /commands komendy  ·  esc przerywa")
    if not start and shutil.get_terminal_size((80, 24)).columns > len(hint) + 24 and _convo_any():
        hint += "  ·  /resume wznawia"
    print(dim(hint))
    LIVE.session_start()
    while True:
        try:
            _INPUT_MODE = mode
            queued = SESSION.get("queued", [])
            if queued:
                task = queued.pop(0)
            else:
                task = _read_input()
            remote = _take_remote(task)
            if task.strip():
                _echo_user(task, remote)
                if not task.startswith("/"):
                    _m = current_model(model)
                    # tury przez agenta DomaAI (Lopus albo model MaddLabs z narzędziami DomaAI) zapisuje
                    # w rozmowie sam serwer: lustro dałoby wiadomość dwa razy
                    SYNC.add("user", {"tekst": task, "zrodlo": "telefon" if remote else "konsola",
                                      **({"lustro": True} if _m not in ("lopus", "lopus-pro")
                                         and not maddlabs_with_domaai_tools(_m) else {})})
            mode = _INPUT_MODE
            auto_yes = mode == "auto"
        except (EOFError, KeyboardInterrupt):
            print()
            return 0
        if not task:
            continue
        if remote and task.lstrip().startswith(("/", "!")):
            # komendy sesji (/yes, /mode, /login, /rc, /model…) zmieniają uprawnienia i konto: tylko z klawiatury
            info = (_L("Komendy z ukośnikiem i polecenia z ! działają tylko z klawiatury terminala. "
                    "Napisz zadanie zwykłym tekstem."))
            print(yellow("  " + info))
            SYNC.add("assistant", {"tekst": info, "lustro": True})
            continue
        if task.startswith("!"):
            _bang(task[1:], messages)
            continue
        if task.startswith("/"):
            _cmd, _, _arg = task.partition(" ")
            if _cmd == "/init":
                task = _INIT_PROMPT
            elif _cmd not in _SLASH:
                _uc = _user_commands().get(_cmd)
