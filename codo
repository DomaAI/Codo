def _ui_open_folder(msg: dict, bridge) -> tuple:
    """Rozmowa w innym folderze: zwykły folder, klon z GitHuba (~/Codo/GitHub/właściciel/nazwa) albo czaty."""
    import shutil
    if msg.get("chats"):
        target = _ui_chats_folder()
    elif msg.get("git"):
        m = _UI_GIT_RE.match(str(msg.get("git") or "").strip())
        if not m or m.group(1) in (".", "..") or m.group(2) in (".", ".."):
            return 400, {"ok": False, "error": "git"}
        owner, name = m.group(1), m.group(2)
        target = Path.home() / "Codo" / "GitHub" / owner / name
        if not (target / ".git").is_dir():
            git = shutil.which("git")
            if not git:
                return 400, {"ok": False, "error": "nogit"}
            try:
                target.parent.mkdir(parents=True, exist_ok=True)
                r = subprocess.run([git, "clone", "--", f"https://github.com/{owner}/{name}.git", str(target)],  # nosec B603
                                   capture_output=True, text=True, timeout=900)
            except (OSError, subprocess.TimeoutExpired) as exc:
                return 400, {"ok": False, "error": str(exc)[:300]}
            if r.returncode != 0:
                return 400, {"ok": False, "error": (r.stderr or "").strip()[-300:]}
    else:
        raw = str(msg.get("folder") or "").strip()
        if not raw:
            return 400, {"ok": False, "error": "folder"}
        target = Path(raw).expanduser()
        if not target.is_dir():
            return 400, {"ok": False, "error": "folder"}
    target = target.resolve()
    try:
        os.chdir(target)
    except OSError:
        return 400, {"ok": False, "error": "folder"}
    bridge.cwd = str(target)
    if target != _ui_chats_folder():
        st = load_settings()
        st["ui_folders"] = ([str(target)] + [x for x in (st.get("ui_folders") or []) if x != str(target)])[:12]
        save_settings(st)
    threading.Thread(target=bridge.restart, daemon=True).start()
    return 200, {"ok": True, **_ui_folders()}


def _ui_upload(name: str, data: bytes, sub: str = "", group: str = "") -> str | None:
    """Plik wrzucony do okna (przycisk + albo przeciągnięcie): zapis w CONFIG_DIR/zalaczniki/<data>/, zwraca ścieżkę,
    którą okno wstawia jako @ścieżka (tak jak aplikacja na Maca wstawia plik wybrany z dysku).
    Folder (przeciągnięty albo wybrany): sub = ścieżka w folderze („Projekt/src”), group = losowy znacznik
    jednego upuszczenia, więc cały folder ląduje w zalaczniki/<data>/<group>/Projekt/src/…"""
    import time
    clean = lambda s: re.sub(r"[^\w.\- ()]+", "_", s).strip(" .")[:120]   # noqa: E731
    base = clean(Path(str(name or "plik").replace("\\", "/")).name) or "plik"
    folder = CONFIG_DIR / "zalaczniki" / time.strftime("%Y-%m-%d")
    if group and re.fullmatch(r"[A-Za-z0-9]{4,32}", group):
        parts = [clean(p) for p in str(sub or "").replace("\\", "/").split("/") if p not in ("", ".", "..")]
        folder = folder.joinpath(group, *[p for p in parts if p][:12])
    folder.mkdir(parents=True, exist_ok=True)
    target = folder / base[:120]
    stem, suf = target.stem, target.suffix
    n = 2
    while target.exists():
        target = folder / f"{stem} ({n}){suf}"
        n += 1
    _atomic_write(target, data)
    return str(target)


