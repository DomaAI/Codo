def _authorized_install_call(name: str, args: dict, messages: list) -> bool:
    """Instalacja bez pytania tylko wtedy, gdy użytkownik sam o nią poprosił w ostatniej wiadomości
    i wymienił każdą paczkę. Do 0.28.0 obejmowało też run_command i wystarczał dowolny 8-znakowy
    fragment wiadomości: „zainstaluj requests” przepuszczał run_command z dowolną komendą."""
    if name != "install" or SESSION.get("marathon"):
        return False
    quote = args.get("user_authorization")
    latest = next((m.get("content") for m in reversed(messages) if m.get("role") == "user"), "")
    if not isinstance(latest, str) or not isinstance(quote, str) or len(quote.strip()) < 8:
        return False
    typed = latest.split("<polecenie_uzytkownika>")[0].split("\n\nDołączone przez użytkownika (@):")[0]
    if quote not in typed or not re.search(r"instal|install|dodaj|add\b|pip|npm", quote, re.I):
        return False
    packages = args.get("packages") or []
    if isinstance(packages, str):
        packages = [packages]
    low = typed.casefold()
    for p in packages:
        spec = str(p).strip()
        # adresy, flagi i spacje (np. „requests @ https://…”, „--index-url”) zawsze pytają
        if not spec or re.search(r"\s|://|^-", spec):
            return False
        name = re.split(r"[=<>~!;\[]", spec, maxsplit=1)[0]
        if "@" in name[1:]:
            name = name[:name.index("@", 1)]   # npm: pakiet@wersja, także @zakres/pakiet@wersja
        name = name.casefold()
        if not re.search(r"[a-z0-9]", name):
            return False
        if not re.search(r"(?<![\w@/-])" + re.escape(name) + r"(?![\w-])", low):
            return False
    return True


