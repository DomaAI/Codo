def _slash_matches(value: str) -> list:
    if not value.startswith("/") or " " in value or "\n" in value:
        return _at_matches(value) if "\n" not in value else []
    own = [(c, d["description"][:50]) for c, d in _user_commands().items() if c.startswith(value)]
    shown = {"/konta": "/accounts", "/agenci": "/agents"} if ui_lang() == "en" else {}
    return [(shown.get(c, c), _SLASH_DESC.get(c, "")) for c in _SLASH
            if shown.get(c, c).startswith(value) and c != "/quit"] + own


def _echo_user(task: str, remote: bool = False) -> None:
    """Wysłana wiadomość w transkrypcie (szare tło)."""
    if not _tty():
        if remote:
            print(_L("> (telefon) ") + task)
        return
    import shutil
    width = max(20, shutil.get_terminal_size((80, 24)).columns - 1)
    print()
    if remote:
        print(cyan(" " + _icon("net") + _L(" z telefonu")))
    lines = _terminal_text(task).split("\n")
    shown = lines[:12] + ([f"… +{len(lines) - 12} linii"] if len(lines) > 12 else [])
    for i, line in enumerate(shown):
        prefix = "❯ " if i == 0 else "  "
        for row in _wrap_ansi(prefix + line, width - 2):
            print(_c("48;5;236", row + " " * max(0, width - _display_width(row))))


def _read_input() -> str:
    """Jedna wiadomość: linie kończone \\ łączą się, blok \"\"\" … \"\"\" = wiele linii."""
    if LIVE.available() and LIVE.keyboard():
        return LIVE.prompt().strip()
    first = input(_prompt())
    if first.strip() == '"""':
        lines = []
        while True:
            ln = input(dim("… "))
            if ln.strip() == '"""':
                break
            lines.append(ln)
        return "\n".join(lines).strip()
    lines = [first]
    while lines[-1].endswith("\\"):
        lines[-1] = lines[-1][:-1]
        lines.append(input(dim("… ")))
    return "\n".join(lines).strip()


