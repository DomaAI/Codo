def t_scan_sites(args):
    """Mapuje strony (pliki .html) w bezpiecznych rootach serwera: cwd, katalog
    domowy, typowe web-rooty. Zwraca absolutne ścieżki (po jednej w linii).
    Prune katalogów-śmieci + ukrytych, limit głębokości i liczby plików."""
    max_files = int(args.get("limit") or 800)
    max_depth = int(args.get("max_depth") or 6)
    found: list[str] = []
    seen: set[str] = set()
    for root in _safe_roots():
        root_str = str(root)
        base_depth = root_str.count(os.sep)
        for dirpath, dirnames, filenames in os.walk(root):
            # Prune: śmieci, ukryte, i nasze kopie zapasowe.
            dirnames[:] = [d for d in dirnames
                           if d not in _SKIP_DIRS and not d.startswith(".")]
            if dirpath.count(os.sep) - base_depth >= max_depth:
                dirnames[:] = []
            for fn in filenames:
                if fn.lower().endswith(_PAGE_SUFFIXES) and not fn.startswith("."):
                    full = os.path.join(dirpath, fn)
                    if full not in seen:
                        seen.add(full)
                        found.append(full)
                        if len(found) >= max_files:
                            break
            if len(found) >= max_files:
                break
        if len(found) >= max_files:
            break
    found.sort()
    return "\n".join(found) or "(brak stron .html w cwd/HOME/web-rootach)"


