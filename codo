    ".rb": r"^\s*(?:class\s+([\w:]+)|module\s+([\w:]+)|def\s+(?:self\.)?(\w+[?!]?))",
    ".c": r"^(?:[\w*]+\s+)+\**(\w+)\s*\([^;]*\)\s*\{?\s*$|^(?:typedef\s+)?struct\s+(\w+)",
    ".h": r"^(?:[\w*]+\s+)+\**(\w+)\s*\([^;]*\)\s*;|^(?:typedef\s+)?struct\s+(\w+)",
