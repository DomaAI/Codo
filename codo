def work_background(argv_rest: list) -> int:
    """codo work --bg …: proces odłączony od terminala (przeżywa zamknięcie okna),
    na macOS pod caffeinate (bez usypiania), wyjście w .doma/work/praca.log."""
    import shutil
    running = _work_running()
    if running:
        print(red(_Lf('✗ W tym folderze już trwa praca (pid {0}).', running.get('pid'))) + dim(_L(" codo work status")))
        return 1
    log_path = _wpath("praca.log")
    log_path.parent.mkdir(parents=True, exist_ok=True)
    script = str(Path(sys.argv[0]).resolve())
    cmd = [*_self_cmd(script), "work", *argv_rest, "--w-tle"]
    if sys.platform == "darwin" and shutil.which("caffeinate"):
        cmd = ["caffeinate", "-i", *cmd]
    env = {**os.environ, "CODO_NO_CLEAR": "1", "DOMA_PLAIN": "1", "PYTHONUNBUFFERED": "1", "NO_COLOR": "1",
           "PYTHONIOENCODING": "utf-8"}   # praca.log czytany jako UTF-8 (na Windows potok/plik miał cp1252)
    kwargs = {"stdin": subprocess.DEVNULL, "env": env, "cwd": str(Path.cwd())}
    if IS_WIN:
        kwargs["creationflags"] = 0x00000008 | 0x00000200   # DETACHED_PROCESS | CREATE_NEW_PROCESS_GROUP
    else:
        kwargs["start_new_session"] = True
    with open(log_path, "ab") as log:
        kwargs["stdout"] = log
        kwargs["stderr"] = subprocess.STDOUT
        proc = subprocess.Popen(cmd, **kwargs)  # nosec B603 — własny program z argumentami użytkownika
    print(green(_L("✓ Praca ruszyła w tle")) + dim(_Lf(' (pid {0}); możesz zamknąć terminal.', proc.pid)))
    print(dim(_L("  codo work status · codo work log -f · codo work stop")))
    if "--yes" not in argv_rest and "-y" not in argv_rest:
        print(yellow(_L("  Bez --yes komendy wymagające zgody będą odrzucane (nikt ich nie potwierdzi).")))
    return 0


