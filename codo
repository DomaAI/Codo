def _endpoints_load() -> dict:
    try:
        d = json.loads(ENDPOINTS_FILE.read_text(encoding="utf-8"))
    except (OSError, ValueError):
        return {"konta": {}, "aktywne": None}
    if not isinstance(d, dict) or not isinstance(d.get("konta"), dict):
        return {"konta": {}, "aktywne": None}
    d["konta"] = {k: v for k, v in d["konta"].items()
                  if isinstance(v, dict) and str(v.get("base_url") or "").strip()}
    return d


def _endpoints_save(d: dict) -> None:
    _save_private_json(ENDPOINTS_FILE, d)


def endpoint_accounts() -> dict:
    return _endpoints_load()["konta"]


def load_endpoint(acct: str | None = None) -> dict | None:
    """Konto o tej nazwie albo aktywne (z polem id); None, gdy żadnego nie ma."""
    d = _endpoints_load()
    accts = d["konta"]
    if not accts:
        return None
    key = acct if acct in accts else (d.get("aktywne") if d.get("aktywne") in accts else next(iter(accts)))
    if acct and acct not in accts:
        return None
    return {**accts[key], "id": key}


def _endpoint_update(acct: str, **fields) -> None:
    d = _endpoints_load()
    if acct in d["konta"]:
        d["konta"][acct].update(fields)
        _endpoints_save(d)


def endpoint_model(model: str | None) -> bool:
    """Model z własnego konta („@xai/grok-4”)."""
    m = str(model or "")
    return m.startswith("@") and m[1:].partition("/")[0] in endpoint_accounts()


def _endpoint_split(model: str | None) -> tuple:
    """„@xai/grok-4” → (konto xai, „grok-4”); model bez nazwy konta → aktywne konto."""
    m = str(model or "").lstrip("@")
    accts = endpoint_accounts()
    head, _, rest = m.partition("/")
    if rest and head in accts:
        return load_endpoint(head), rest
    return load_endpoint(), (m or None)


def _endpoint_local(base: str) -> bool:
    """Adres w tym komputerze albo w sieci lokalnej (tam wolno zwykłe http)."""
    import ipaddress
    from urllib.parse import urlparse
    host = (urlparse(base).hostname or "").lower()
    if host in ("localhost", "host.docker.internal") or host.endswith(".local"):
        return True
    try:
        ip = ipaddress.ip_address(host)
    except ValueError:
        return False
    return ip.is_loopback or ip.is_private or ip.is_link_local


def _endpoint_base_ok(base: str) -> str | None:
    """Normalizuje adres bazowy; None, gdy niebezpieczny albo niepoprawny."""
    from urllib.parse import urlparse
    base = (base or "").strip().rstrip("/")
    for suffix in ("/chat/completions", "/models"):
        if base.endswith(suffix):
            base = base[: -len(suffix)]
    u = urlparse(base)
    if u.scheme not in ("http", "https") or not u.hostname or u.username or u.password:
        return None
    if u.scheme == "http" and not _endpoint_local(base):
        return None   # klucz API zwykłym http przez internet: nie
    return base


def _endpoint_name(ep: dict | None = None) -> str:
    ep = ep or load_endpoint() or {}
    from urllib.parse import urlparse
    return ep.get("name") or urlparse(ep.get("base_url") or "").hostname or "endpoint"


def _endpoint_call(method: str, path: str, ep: dict, json_body: dict | None = None, timeout: int = 600) -> dict:
    try:
        return _maddlabs_http(method, path, key=ep.get("api_key") or None, json_body=json_body,
                              timeout=timeout, base=ep["base_url"], who="endpoint")
    except ApiError as e:
        if e.status in (401, 403) and ep.get("id"):
            raise ApiError(e.status, _Lf('{0} odrzucił klucz API ({1}). Podłącz ponownie: codo login {2}', _endpoint_name(ep), e.status, ep['id']), e.payload) from None
        raise


_CHAT_SKIP = re.compile(r"embed|whisper|tts|dall-e|image|moderation|audio|transcri|realtime|search-preview"
                        r"|rerank|guard|-ocr", re.I)


def _endpoint_models_of(ep: dict) -> list:
    """[(id modelu, nazwa)] jednego konta; lista z /models, bez embeddingów i modeli audio."""
    import time as _t
    cached = _ENDPOINT_MODELS_CACHE.get(ep["id"])
    if cached and _t.monotonic() - cached[0] < 300:
        return cached[1]
    try:
        data = _endpoint_call("GET", "/models", ep, timeout=15)
    except (ApiError, urllib.error.URLError, TimeoutError, OSError):
        data = {}
    out, seen = [], set()
    rows = data.get("data") if isinstance(data, dict) else None
    for m in rows if isinstance(rows, list) else []:
        mid = m.get("id") if isinstance(m, dict) else None
        if not mid or mid in seen or _CHAT_SKIP.search(mid):
            continue
        mid = mid[len("models/"):] if mid.startswith("models/") else mid   # Google podaje „models/…”
        seen.add(mid)
        out.append((mid, m.get("display_name") or m.get("name") or mid))
    if ep.get("model") and ep["model"] not in seen:
        out.insert(0, (ep["model"], ep["model"]))
    elif ep.get("model"):
        out.sort(key=lambda x: x[0] != ep["model"])
    _ENDPOINT_MODELS_CACHE[ep["id"]] = (_t.monotonic(), out)
    return out


def _endpoint_models(ep: dict | None = None) -> list:
    """Do /model: modele ze wszystkich kont jako „konto/model” (albo z jednego konta)."""
    accts = [ep] if ep else [load_endpoint(a) for a in endpoint_accounts()]
    out = []
    for acct in accts:
        if not acct:
            continue
        for mid, label in _endpoint_models_of(acct):
            out.append((f"@{acct['id']}/{mid}", _Lf('{0} · {1} · Twój klucz', _endpoint_name(acct), label), "free"))
    return out


def endpoint_step(body: dict) -> dict:
    ep, model = _endpoint_split(body.get("model"))
    if not ep:
        raise ApiError(401, _L("Brak podłączonego konta. Dodaj: codo login openai (anthropic, xai, ollama…)"))
    model = model or ep.get("model")
    if not model:
        models = _endpoint_models_of(ep)
        if not models:
            raise ApiError(400, _Lf('{0} nie podał listy modeli. Wybierz model: /model @{1}/NAZWA', _endpoint_name(ep), ep['id']))
        model = models[0][0]
    limit = body.get("max_tokens") or int(ep.get("max_tokens") or 8000)
    payload = {"model": model, "messages": body["messages"]}
    payload["max_completion_tokens" if ep.get("max_field") == "max_completion_tokens" else "max_tokens"] = limit
    if body.get("tools") and ep.get("tools") is not False:
        payload["tools"] = body["tools"]
    live = lambda p: _endpoint_call("POST", "/chat/completions", ep, json_body=p)   # noqa: E731
    try:
        data = _chat_live(live, payload, ep["id"])
    except ApiError as e:
        text = str(e.detail or "").lower()
        if e.status == 400 and "max_tokens" in text and "max_completion_tokens" in text and "max_tokens" in payload:
            # Nowsze modele OpenAI przyjmują tylko max_completion_tokens: zapamiętujemy i ponawiamy.
            _endpoint_update(ep["id"], max_field="max_completion_tokens")
            payload["max_completion_tokens"] = payload.pop("max_tokens")
            data = _chat_live(live, payload, ep["id"])
        elif e.status in (400, 404, 422) and "tool" in text and payload.get("tools"):
            raise ApiError(e.status, _Lf('Model {0} nie obsługuje narzędzi (function calling), więc nie może pracować na plikach. Wybierz inny: /model', model), e.payload) from None
        else:
            raise
    try:
        message = data["choices"][0]["message"]
        finish = data["choices"][0].get("finish_reason") or ""
    except (KeyError, IndexError, TypeError, AttributeError):
        raise ApiError(502, _Lf('Nieprawidłowa odpowiedź od {0}.', _endpoint_name(ep))) from None
    thought = _take_reasoning(message)
    message = {k: v for k, v in message.items() if k in ("role", "content", "tool_calls") and v is not None}
    message.setdefault("role", "assistant")
    if isinstance(message.get("content"), list):   # część serwerów oddaje treść jako listę części
        message["content"] = "".join(str(p.get("text") or "") for p in message["content"] if isinstance(p, dict))
    for tc in message.get("tool_calls") or []:
        fn = tc.get("function") or {}
        if isinstance(fn.get("arguments"), dict):   # część serwerów oddaje obiekt zamiast tekstu JSON
            fn["arguments"] = json.dumps(fn["arguments"], ensure_ascii=False)
        tc.setdefault("type", "function")
    return {"message": message, "model": f"@{ep['id']}/{data.get('model') or model}", "credits_spent": 0,
            "usage": data.get("usage") or {}, "thinking": thought, "finish_reason": finish}


def _endpoint_new_id(base_id: str) -> str:
    accts = endpoint_accounts()
    if base_id not in accts:
        return base_id
    n = 2
    while f"{base_id}{n}" in accts:
        n += 1
    return f"{base_id}{n}"


def login_endpoint(spec: str | None = None, name: str | None = None) -> int:
    """codo login openai|anthropic|xai|google|mistral|deepseek|groq|openrouter|ollama|lmstudio|URL [nazwa]:
    podłącza konto u dostawcy. Kilka kont naraz; ponowne logowanie tym samym podmienia klucz."""
    import getpass
    interactive = bool(sys.stdin and sys.stdin.isatty())
    spec = (spec or os.environ.get("CODO_ENDPOINT_URL") or "").strip()
    if not spec:
        if not interactive:
            print(red(_L("✗ Podaj dostawcę: codo login openai|anthropic|xai|google|mistral|ollama|https://…/v1")))
            return 1
        have = endpoint_accounts()
        spec = _pick([(p[0], f"{p[1]} · {p[2]}" + (_L(" · podłączone") if p[0] in have else ""))
                      for p in _ENDPOINT_PRESETS], _L("Podłącz konto u dostawcy modeli")) or ""
        if not spec:
            print(dim(_L("  Anulowano.")))
            return 1
    preset = _PRESET.get(spec.lower())
    if preset and preset[3]:
        acct_id, label, base, env_key = preset[0], preset[1], preset[3], preset[4]
    else:
        base = spec if spec.lower() != "wlasny" else ""
        if not base and interactive:
            try:
                base = input(_L("  Adres bazowy (np. https://serwer/v1): ")).strip()
            except (EOFError, KeyboardInterrupt):
                return 1
        env_key, label, acct_id = "", "", ""
    base_ok = _endpoint_base_ok(base)
    if not base_ok:
        print(red(_L("✗ Niepoprawny adres.")) + dim(_L(" Wymagane https:// (zwykłe http tylko w tym komputerze i sieci lokalnej).")))
        return 1
    if not acct_id:
        from urllib.parse import urlparse
        host = (urlparse(base_ok).hostname or "wlasny").split(".")
        acct_id = re.sub(r"[^a-z0-9-]", "", (host[-2] if len(host) > 1 and not host[-1].isdigit() else host[0]).lower()) or "wlasny"
        label = urlparse(base_ok).hostname or acct_id
    if name:
        acct_id = re.sub(r"[^a-z0-9-]", "", name.lower())[:24] or acct_id
        label = name
    existing = endpoint_accounts().get(acct_id)
    if existing and existing.get("base_url") != base_ok:
        acct_id = _endpoint_new_id(acct_id)
    key = (os.environ.get("CODO_ENDPOINT_KEY") or (os.environ.get(env_key) if env_key else "") or "").strip()
    if not key and env_key is not None:
        if interactive:
            hint = _L(" (Enter, jeśli serwer nie wymaga)") if env_key == "" else ""
            key = getpass.getpass(_Lf('  Klucz API {0}{1}, nie będzie widoczny: ', label, hint)).strip()
        elif sys.stdin:
            key = sys.stdin.readline().strip()
        if env_key and not key:
            print(dim(_Lf('  Anulowano: {0} wymaga klucza API.', label)))
            return 1
    ep = {"id": acct_id, "base_url": base_ok, "api_key": key, "name": label}
    try:
        _endpoint_call("GET", "/models", ep, timeout=20)
    except ApiError as e:
        if e.status in (401, 403):
            print(red("✗ ") + str(e.detail))
            return 1
    except (urllib.error.URLError, TimeoutError, OSError) as e:
        print(red(_Lf('✗ Nie połączono z {0}: ', base_ok)) + describe_error(e))
        if _endpoint_local(base_ok):
            print(dim(_L("  Sprawdź, czy serwer modeli jest uruchomiony (np. ollama serve).")))
        return 1
    _ENDPOINT_MODELS_CACHE.pop(acct_id, None)
    models = _endpoint_models_of(ep)
    model = (os.environ.get("CODO_ENDPOINT_MODEL") or "").strip()
    if not model and models:
        if interactive and len(models) > 1:
            model = _choose_model([(m, lab, "free") for m, lab in models], None, _Lf('Domyślny model {0}', label)) or ""
        else:
            model = models[0][0]
    if not model and interactive:
        try:
            model = input(_L("  Nazwa modelu: ")).strip()
        except (EOFError, KeyboardInterrupt):
            model = ""
    if not model:
        print(red(_L("✗ Nie wybrano modelu.")))
        return 1
    d = _endpoints_load()
    keep = {k: v for k, v in (d["konta"].get(acct_id) or {}).items() if k in ("max_field", "tools", "max_tokens")}
    d["konta"][acct_id] = {"base_url": base_ok, "api_key": key, "name": label, "model": model, **keep}
    d["aktywne"] = acct_id
    _endpoints_save(d)
    _ENDPOINT_MODELS_CACHE.pop(acct_id, None)
    _set_provider("endpoint")
    st = load_settings()
    st["model_endpoint"] = f"@{acct_id}/{model}"
    save_settings(st)
    others = [a for a in d["konta"] if a != acct_id]
    print(green(_Lf('✓ Podłączono {0}', label)) + dim(_Lf(' · model @{0}/{1}', acct_id, model)))
    if others:
        print(dim(_Lf('  Masz też: {0}. /model pokazuje modele ze wszystkich kont.', ', '.join(others))))
    print(dim(_L("  Za modele płacisz u dostawcy, Codo nie pobiera kredytów. /konta zarządza kontami.")))
    return 0


def logout_endpoint(acct: str | None = None) -> int:
    d = _endpoints_load()
    if acct and acct not in d["konta"]:
        print(red(_Lf('✗ Nie ma konta „{0}”.', acct)) + dim(_L(" Lista: codo konta")))
        return 1
    removed = [acct] if acct else list(d["konta"])
    for a in removed:
        d["konta"].pop(a, None)
        _ENDPOINT_MODELS_CACHE.pop(a, None)
    if d.get("aktywne") in removed:
        d["aktywne"] = next(iter(d["konta"]), None)
    _endpoints_save(d)
    st = load_settings()
    for k in ("model_endpoint", "model", "model_maddlabs", "model_agent"):
        if str(st.get(k) or "").lstrip("@").split("/")[0] in removed and str(st.get(k) or "").startswith("@"):
            st.pop(k, None)
    if not d["konta"] and st.get("provider") == "endpoint":
        st.pop("provider", None)
    save_settings(st)
    print(green(_L("✓ Usunięto z tego komputera: ")) + ", ".join(removed or ["nic"]))
    return 0


def cmd_accounts(arg: str = "") -> int:
    """/konta, codo konta [dodaj X | usuń X | użyj X]: konta u dostawców modeli."""
    parts = (arg or "").split()
    sub = parts[0].lower() if parts else ""
    if sub in ("dodaj", "add", "podlacz", "podłącz"):
        return login_endpoint(parts[1] if len(parts) > 1 else None, parts[2] if len(parts) > 2 else None)
    if sub in ("usun", "usuń", "remove", "rm", "odlacz", "odłącz"):
        if len(parts) < 2:
            print(red(_L("✗ Podaj nazwę: /konta usuń xai")))
            return 1
        return logout_endpoint(parts[1])
    if sub in ("uzyj", "użyj", "use", "domyslne", "domyślne"):
        if len(parts) < 2 or parts[1] not in endpoint_accounts():
            print(red(_L("✗ Podaj podłączone konto: /konta użyj anthropic")))
            return 1
        d = _endpoints_load()
        d["aktywne"] = parts[1]
        _endpoints_save(d)
        _set_provider("endpoint")
        ep = load_endpoint(parts[1])
        st = load_settings()
        st["model_endpoint"] = f"@{parts[1]}/{ep.get('model')}" if ep.get("model") else None
        save_settings(st)
        print(green(_Lf('✓ Aktywne konto: {0}', _endpoint_name(ep))) + dim(_Lf(' · model {0}', st['model_endpoint'] or 'pierwszy z listy')))
        return 0
    d = _endpoints_load()
    rows = []
    for a, ep in d["konta"].items():
        mark = green("●") if a == d.get("aktywne") and provider() == "endpoint" else dim("○")
        key = (_L("klucz …") + ep["api_key"][-4:]) if ep.get("api_key") else _L("bez klucza")
        rows.append(f"{mark} {bold(a)}  {ep.get('name') or ''} · {ep.get('model') or '?'}  {dim(key + ' · ' + ep['base_url'])}")
    if not rows:
        rows.append(dim(_L("Brak podłączonych kont.")))
    rows += ["", dim(_L("Dodaj: /konta dodaj openai|anthropic|xai|google|mistral|deepseek|groq|openrouter|ollama|lmstudio|URL")),
             dim(_L("Usuń: /konta usuń NAZWA · Aktywne: /konta użyj NAZWA · Model z dowolnego konta: /model"))]
    panel(_L("Twoje konta u dostawców"), rows)
    return 0


def _pick(options: list, title: str) -> str | None:
    """Wybór z listy (strzałki w terminalu, numer w pozostałych)."""
    items = [(key, label, "free") for key, label in options]
    if _tty() and sys.stdin.isatty() and not IS_WIN:
        return _choose_model(items, None, title)
    print(bold(title))
    for i, (_key, label) in enumerate(options, 1):
        print(f"  {i}. {label}")
    try:
        answer = input(_L("  Numer: ")).strip()
    except (EOFError, KeyboardInterrupt):
        return None
    return options[int(answer) - 1][0] if answer.isdigit() and 1 <= int(answer) <= len(options) else None


