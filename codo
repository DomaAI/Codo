def _group_slot_key(brain: str) -> str:
    b = str(brain or "") or str(current_model(None) or "")
    kind = agent_kind(b)
    if kind:
        return "agent:" + kind
    if b in ("lopus", "lopus-pro"):
        return "domaai"
    if b.startswith("@"):
        ep, _mid = _endpoint_split(b)
        if ep and _is_local_url(ep.get("base_url") or ep.get("url") or ""):
            return "lokalny"
        return "konto:" + (b[1:].split("/", 1)[0] or "?")
    if "maddlabs" in b or "bielik" in b.lower():
        return "maddlabs"
    return "domaai" if b else "inne"


def _group_slot_limit(key: str, override: int = 0) -> int:
    if override:
        return max(1, int(override))
    st = load_settings().get("group_slots") or {}
    fam = key.split(":", 1)[0]
    for k in (key, fam):
        try:
            if int(st.get(k) or 0) > 0:
                return int(st[k])
        except (TypeError, ValueError):
            pass
    return _GROUP_SLOT_DEFAULT.get(fam, 3)


class _GroupSlot:
    """Licznik miejsc u jednego dostawcy: czeka na wolne miejsce, ale przerwanie biegu go zwalnia."""

    def __init__(self, limit: int):
        self.limit, self.used = limit, 0
        self.cv = threading.Condition()

    def acquire(self, stop) -> bool:
        with self.cv:
            while self.used >= self.limit:
                if stop():
                    return False
                self.cv.wait(0.25)
            self.used += 1
            return True

    def release(self) -> None:
        with self.cv:
            self.used = max(0, self.used - 1)
            self.cv.notify_all()


def _group_slot(key: str, limit: int) -> _GroupSlot:
    with _GROUP_SLOTS_GUARD:
        s = _GROUP_SLOTS.get(key)
        if s is None:
            s = _GROUP_SLOTS[key] = _GroupSlot(limit)
        else:
            s.limit = limit
        return s


def _group_cost_kind(brain: str) -> str:
    """Jak liczyć koszt członka: kr (kredyty DomaAI), plan (abonament agenta), key (Twój klucz), local."""
    key = _group_slot_key(brain)
    if key.startswith("agent:"):
        return "plan"
    if key == "lokalny":
        return "local"
    if key.startswith("konto:"):
        return "key"
    return "kr"


def _group_brain_ready(brain: str) -> str:
    """Pusty tekst, gdy mózg może ruszyć na tym komputerze, inaczej powód (bez zapytań do sieci)."""
    kind = agent_kind(brain)
    if kind:
        return "" if _agent_bin(kind) else _Lf("{0} nie jest zainstalowany na tym komputerze", _AGENTS[kind]["label"])
    if str(brain).startswith("@"):
        ep, _mid = _endpoint_split(brain)
        return "" if ep else _Lf("nie ma konta {0}", str(brain)[1:].split("/", 1)[0])
    if brain in ("lopus", "lopus-pro") and not (load_device() or load_creds()):
        return _L("brak logowania do DomaAI")
    return ""


def _group_reason(errors: list, fallback_note: str = "") -> str:
    """Krótki powód nieudanej tury z tekstów błędów (dla karty członka)."""
    text = " ".join(str(e) for e in errors).lower()
    if any(w in text for w in ("usage limit", "limit planu", "rate limit", "429", "limit zapytań", "quota")):
        return _L("limit planu albo zapytań")
    if any(w in text for w in ("zaloguj", "log in", "login", "unauthorized", "401", "not logged", "brak logowania")):
        return _L("brak logowania")
    if any(w in text for w in ("402", "kredyt", "credits")):
        return _L("brak kredytów")
    if any(w in text for w in ("internet", "połączeni", "connection", "timed out")):
        return _L("brak połączenia")
    first = next((str(e) for e in errors if str(e).strip()), "")
    return _plain(first)[:160] if first else (fallback_note or _L("tura się nie udała"))


# ── członek: własny proces codo app-server ──

class GroupMemberProc:
    """Jeden członek grupy: `codo app-server` w swoim folderze, ze swoim mózgiem i trybem."""

    def __init__(self, run, member: dict, brain: str, cwd, mode: str):
        import queue
        self.run, self.m, self.brain, self.cwd, self.mode = run, member, brain, str(cwd), mode
        self.q = queue.Queue()
        self.proc = None

    def spawn(self) -> int:
        env = dict(os.environ)
        for k in ("CODO_PROVIDER", "CODO_APP_AGENT", "CODO_UI_DEV", "CODO_ZESPOL_DIR", "CODO_ZESPOL_CZLONEK",
                  "CODO_ZESPOL_ROLA"):
            env.pop(k, None)
        env.update({"CODO_APP_MODE": self.mode, "CODO_APP_LOCAL_ONLY": "1", "DOMA_NO_SYNC": "1",
                    "CODO_NO_HISTORY": "1", "CODO_CLIENT": "group", "CODO_GRUPA_BIEG": self.run.id,
                    "PYTHONUNBUFFERED": "1", "NO_COLOR": "1"})
        pin = (self.m.get("pin") if self.brain == self.m.get("brain") else "") or _team_brain_provider(self.brain)
        if pin:
            env["CODO_PROVIDER"] = pin
        cmd = [*_self_cmd(_team_script())] + (["--model", self.brain] if self.brain else []) + ["app-server"]
        kw = {"cwd": self.cwd, "env": env, "stdin": subprocess.PIPE, "stdout": subprocess.PIPE}
        if IS_WIN:
            kw["creationflags"] = 0x00000200
        else:
            kw["start_new_session"] = True
        (self.run.dir / "log").mkdir(parents=True, exist_ok=True)
        with open(self.run.dir / "log" / f"{self.m['id']}.err", "ab") as err:
            self.proc = subprocess.Popen(cmd, stderr=err, **kw)  # nosec B603 — własny program
        threading.Thread(target=self._read, daemon=True).start()
        return self.proc.pid

    def _read(self) -> None:
        proc = self.proc
        for raw in proc.stdout:
            try:
                ev = json.loads(raw.decode("utf-8", "replace"))
            except ValueError:
                continue
            if isinstance(ev, dict):
                self.q.put(ev)
        self.q.put({"type": "_exit", "code": proc.wait()})

    def send_raw(self, obj: dict) -> bool:
        try:
            self.proc.stdin.write((json.dumps(obj, ensure_ascii=False) + "\n").encode("utf-8"))
            self.proc.stdin.flush()
            return True
        except (OSError, ValueError, AttributeError):
            return False

    def send(self, text: str) -> bool:
        return self.send_raw({"type": "send", "text": text})

    def interrupt(self) -> None:
        self.send_raw({"type": "interrupt"})

    def alive(self) -> bool:
        return self.proc is not None and self.proc.poll() is None

    def stop(self, wait: float = 4) -> None:
        if not self.proc:
            return
        try:
            self.proc.stdin.close()
        except (OSError, ValueError):
            pass
        try:
            self.proc.wait(timeout=wait)
        except subprocess.TimeoutExpired:
            _kill_tree(self.proc)


