def _pid_alive(pid) -> bool:
    """Czy proces żyje. UWAGA Windows: os.kill(pid, 0) NIE sonduje — wywołuje
    TerminateProcess i ZABIJA proces. Dlatego na Windows sondujemy przez
    OpenProcess+GetExitCodeProcess (STILL_ACTIVE=259). Jedna definicja: druga, niżej
    w pliku (tasklist z limitem 10 s), po cichu podmieniała tę aż do 0.28.0."""
    try:
        pid = int(pid)
    except (TypeError, ValueError):
        return False
    if pid <= 0:
        return False
    if IS_WIN:
        try:
            import ctypes
            h = ctypes.windll.kernel32.OpenProcess(0x1000, False, pid)  # QUERY_LIMITED
            if not h:
                return False
            try:
                code = ctypes.c_ulong()
                ok = ctypes.windll.kernel32.GetExitCodeProcess(h, ctypes.byref(code))
                return bool(ok) and code.value == 259  # STILL_ACTIVE
            finally:
                ctypes.windll.kernel32.CloseHandle(h)
        except Exception:
            return False
    try:
        os.kill(pid, 0)
        return True
    except PermissionError:
        return True  # żyje, tylko należy do innego użytkownika
    except OSError:
        return False


def _pid_terminate(pid: int) -> None:
    """Ubija proces przenośnie (Windows: TerminateProcess; POSIX: SIGTERM)."""
    if pid <= 0:
        return
    try:
        if IS_WIN:
            import ctypes
            h = ctypes.windll.kernel32.OpenProcess(0x0001, False, pid)  # TERMINATE
            if h:
                ctypes.windll.kernel32.TerminateProcess(h, 1)
                ctypes.windll.kernel32.CloseHandle(h)
        else:
            os.kill(pid, 15)
    except Exception:
        pass  # nosec B110 — best-effort ubicie; brak procesu = i tak nie żyje


def _autostart_install(folder: Path, auto_yes: bool, site_url: str | None,
                       start_now: bool = True) -> str:
    """Autostart mostka po restarcie: systemd --user (Linux) / launchd (macOS)
    / folder Autostart (Windows — .cmd w shell:startup, bez uprawnień admina).
    start_now=False gdy wołane Z WNĘTRZA działającego serve — inaczej wstałby
    natychmiast DRUGI daemon dla tego samego folderu.
    Zwraca opis wyniku ('systemd'/'launchd'/'startup'/komunikat błędu)."""
    slug = _link_slug(folder)
    if IS_WIN:
        try:
            sdir = _win_startup_dir()
            sdir.mkdir(parents=True, exist_ok=True)
            cmd = sdir / f"doma-serve-{slug}.cmd"
            args = f' serve --dir "{folder}"'
            if auto_yes:
                args += " --yes"
            if site_url:
                args += f' --site "{site_url}"'   # cytowane: spacje/& w URL-u
            content = (
                "@echo off\r\n"
                f"rem {APP_NAME} - mostek codo serve\r\n"
                + (f'start "codo serve" /min "{sys.executable}"{args}\r\n' if FROZEN
                 else f'start "codo serve" /min "{_win_pythonw()}" "{_self_path()}"{args}\r\n'))
            # cmd.exe czyta pliki .bat/.cmd w kodowaniu OEM konsoli (np. cp852
            # dla PL), NIE w UTF-8 — nie-ASCII w ścieżkach (C:\Users\Paweł)
            # w UTF-8 rozjechałoby ścieżkę i autostart by nie wstał.
            enc = "utf-8"
            try:
                import ctypes
                enc = f"cp{ctypes.windll.kernel32.GetOEMCP()}"
                content.encode(enc)  # weryfikacja, że koduje
            except Exception:
                enc = "utf-8"
            cmd.write_bytes(content.encode(enc, errors="replace"))
            if start_now:
                subprocess.Popen(["cmd", "/c", str(cmd)],
                                 creationflags=0x00000008)  # DETACHED_PROCESS
            return "startup"
        except Exception as e:  # noqa: BLE001 — pokaż userowi, co poszło nie tak
            return f"BŁĄD autostartu Windows: {e}"
    if IS_MAC:
        plist_dir = Path.home() / "Library" / "LaunchAgents"
        plist_dir.mkdir(parents=True, exist_ok=True)
        plist = plist_dir / f"im.madd.doma-serve.{slug}.plist"
        prog = [*_self_cmd(), "serve", "--dir", str(folder)]
        if auto_yes:
            prog.append("--yes")
        if site_url:
            prog += ["--site", site_url]
        # Escapowanie XML: folder „R&D” albo adres z „&” psuł plist i mostek nie wstawał.
        from xml.sax.saxutils import escape as _xml
        args_xml = "\n".join(f"      <string>{_xml(a)}</string>" for a in prog)
        plist.write_text(f"""<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0"><dict>
  <key>Label</key><string>im.madd.doma-serve.{slug}</string>
  <key>ProgramArguments</key><array>
{args_xml}
  </array>
  <key>RunAtLoad</key><true/>
  <key>KeepAlive</key><true/>
  <key>StandardOutPath</key><string>/tmp/doma-serve-{slug}.log</string>
  <key>StandardErrorPath</key><string>/tmp/doma-serve-{slug}.log</string>
</dict></plist>
""", encoding="utf-8")
        if start_now:
            r = subprocess.run(["launchctl", "load", "-w", str(plist)],
                               capture_output=True, text=True)
            if r.returncode != 0:
                return f"BŁĄD launchctl: {(r.stderr or r.stdout).strip()[:200]}"
        return "launchd"
    import shutil as _shutil
    if _shutil.which("systemctl"):
        unit_dir = Path.home() / ".config" / "systemd" / "user"
        unit_dir.mkdir(parents=True, exist_ok=True)
        unit = unit_dir / f"doma-serve-{slug}.service"
        # Cytowane argumenty (systemd rozumie "…") — folder/ścieżka ze spacjami
        # nie rozjedzie ExecStart.
        _exec_parts = [*_self_cmd(), "serve", "--dir", str(folder)]
        if auto_yes:
            _exec_parts.append("--yes")
        if site_url:
            _exec_parts += ["--site", site_url]
        # % to w systemd specyfikator (%h, %u…), dosłowny zapisuje się jako %%.
        exec_line = " ".join('"' + p.replace("\\", "\\\\").replace('"', r'\"').replace("%", "%%") + '"'
                             for p in _exec_parts)
        unit.write_text(f"""[Unit]
Description=codo serve (by MADD) — mostek {folder}
After=network-online.target

[Service]
ExecStart={exec_line}
Restart=always
RestartSec=5

[Install]
WantedBy=default.target
""")
        enable = ["systemctl", "--user", "enable"] + (["--now"] if start_now else [])
        for cmd in (["systemctl", "--user", "daemon-reload"],
                    enable + [f"doma-serve-{slug}.service"]):
            r = subprocess.run(cmd, capture_output=True, text=True)
            if r.returncode != 0:
                return f"BŁĄD systemctl: {(r.stderr or r.stdout).strip()[:200]}"
        return "systemd"
    return "BŁĄD: brak systemd/launchd — uruchamiaj `codo serve` ręcznie (np. nohup/tmux)."


def _autostart_uninstall(folder: Path) -> None:
    slug = _link_slug(folder)
    if IS_WIN:
        (_win_startup_dir() / f"doma-serve-{slug}.cmd").unlink(missing_ok=True)
        return
    if IS_MAC:
        plist = Path.home() / "Library" / "LaunchAgents" / f"im.madd.doma-serve.{slug}.plist"
        if plist.exists():
            subprocess.run(["launchctl", "unload", "-w", str(plist)],
                           capture_output=True)
            plist.unlink(missing_ok=True)
        return
    unit = Path.home() / ".config" / "systemd" / "user" / f"doma-serve-{slug}.service"
    if unit.exists():
        subprocess.run(["systemctl", "--user", "disable", "--now",
                        f"doma-serve-{slug}.service"], capture_output=True)
        unit.unlink(missing_ok=True)
        subprocess.run(["systemctl", "--user", "daemon-reload"], capture_output=True)


