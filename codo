def _pptx_slides(pkg) -> tuple:
    pres = pkg.main_part("ppt/presentation.xml")
    doc = pkg.xml(pres)
    out = []
    for sid in doc.getElementsByTagNameNS(_OX_P, "sldId"):
        t = pkg.rel_target(pres, _ox_attr(sid, "id", _OX_R) or "")
        if t and pkg.has(t):
            out.append(t)
    return pres, doc, out


def _pptx_slide(pkg, a: dict, key: str = "slide") -> tuple:
    _pres, _doc, slides = _pptx_slides(pkg)
    try:
        n = int(a.get(key))
    except (TypeError, ValueError):
        raise _OfficeError(f"podaj {key}: numer slajdu od 1") from None
    if not 1 <= n <= len(slides):
        raise _OfficeError(f"prezentacja ma {len(slides)} slajd(ów); {key}={n} nie istnieje")
    return n, slides[n - 1]


def _pptx_replace(pkg, a: dict) -> str:
    find, repl = str(a.get("find") or ""), str(a.get("replace") if a.get("replace") is not None else "")
    if not find:
        raise _OfficeError("podaj find i replace")
    _pres, _doc, slides = _pptx_slides(pkg)
    if a.get("slide"):
        n, part = _pptx_slide(pkg, a)
        targets = [(n, part)]
    else:
        targets = list(enumerate(slides, 1))
    pars, where = [], {}
    for n, part in targets:
        for p in pkg.xml(part).getElementsByTagNameNS(_OX_A, "p"):
            pars.append(p)
            where[id(p)] = (n, part)
    cnt, places = _ox_replace_in(pars, "a", find, repl, bool(a.get("all")), lambda p: f"slajd {where[id(p)][0]}")
    if places:
        raise _OfficeError(f"„{find}” występuje {cnt}× ({'; '.join(places)}). Podaj slide, dłuższy fragment albo all=true")
    if not cnt:
        raise _OfficeError(_ox_not_found(pars, "a", find, "slajdach" if not a.get("slide") else f"slajdzie {a['slide']}"))
    for _n, part in targets:
        pkg.touch(part)
    return f"zamiana {cnt}×"


def _a_paragraphs(doc, like, text: str) -> list:
    out = []
    for line in (str(text).split("\n") if text else [""]):
        p = _ox_new(doc, like, "p", _OX_A)
        lvl = 0
        m = re.match(r"^(\s*)(?:[-•*]\s+)?", line)
        if m and line.strip():
            lvl = min(8, len(m.group(1).replace("\t", "  ")) // 2)
            line = line[m.end():]
        if lvl:
            ppr = _ox_new(doc, p, "pPr")
            ppr.setAttribute("lvl", str(lvl))
            p.appendChild(ppr)
        if line:
            r = _ox_new(doc, p, "r")
            t = _ox_new(doc, p, "t")
            t.appendChild(doc.createTextNode(line))
            r.appendChild(t)
            p.appendChild(r)
        out.append(p)
    return out


def _pptx_set_body(doc, sp, text: str) -> None:
    tx = _ox_kid(sp, _OX_P, "txBody")
    if tx is None:
        tx = _ox_new(doc, sp, "txBody", _OX_P)
        tx.appendChild(_ox_new(doc, sp, "bodyPr", _OX_A))
        tx.appendChild(_ox_new(doc, sp, "lstStyle", _OX_A))
        sp.appendChild(tx)
    for p in _ox_kids(tx, _OX_A, "p"):
        tx.removeChild(p)
    for p in _a_paragraphs(doc, tx, text):
        tx.appendChild(p)


def _pptx_ph(sp):
    nv = _ox_kid(sp, _OX_P, "nvSpPr")
    nvpr = _ox_kid(nv, _OX_P, "nvPr") if nv is not None else None
    return _ox_kid(nvpr, _OX_P, "ph") if nvpr is not None else None


_P_NS = f'xmlns:a="{_OX_A}" xmlns:r="{_OX_R}" xmlns:p="{_OX_P}"'
_P_GRP = ('<p:nvGrpSpPr><p:cNvPr id="1" name=""/><p:cNvGrpSpPr/><p:nvPr/></p:nvGrpSpPr><p:grpSpPr><a:xfrm>'
          '<a:off x="0" y="0"/><a:ext cx="0" cy="0"/><a:chOff x="0" y="0"/><a:chExt cx="0" cy="0"/></a:xfrm></p:grpSpPr>')


def _pptx_notes_master(pkg, pres: str, pdoc) -> str:
    """Wzorzec notatek; prezentacja bez niego dostaje minimalny (z kopią motywu)."""
    have = next((t for t in pkg.rels_of_type(pres, "notesMaster") if pkg.has(t)), None)
    if have:
        return have
    themes = [t for t in pkg.names if re.fullmatch(r"ppt/theme/theme\d+\.xml", t) and pkg.has(t)]
    if not themes:
        raise _OfficeError("prezentacja nie ma motywu (ppt/theme); notatek nie da się dodać")
    theme = pkg.fresh_name("ppt/theme/theme{n}.xml")
    pkg.put(theme, pkg.read(sorted(themes)[0]), _OX_CT + "theme+xml")
    nm = pkg.fresh_name("ppt/notesMasters/notesMaster{n}.xml")
    sz = pdoc.getElementsByTagNameNS(_OX_P, "notesSz")
    cx, cy = (int(sz[0].getAttribute("cx")), int(sz[0].getAttribute("cy"))) if sz else (6858000, 9144000)
    pkg.put(nm, f'<?xml version="1.0" encoding="UTF-8" standalone="yes"?>\n<p:notesMaster {_P_NS}><p:cSld><p:bg>'
                '<p:bgRef idx="1001"><a:schemeClr val="bg1"/></p:bgRef></p:bg><p:spTree>' + _P_GRP +
                '<p:sp><p:nvSpPr><p:cNvPr id="2" name="Slide Image Placeholder 1"/><p:cNvSpPr><a:spLocks noGrp="1" '
                'noRot="1" noChangeAspect="1"/></p:cNvSpPr><p:nvPr><p:ph type="sldImg" idx="2"/></p:nvPr></p:nvSpPr>'
                f'<p:spPr><a:xfrm><a:off x="{cx // 6}" y="{cy // 13}"/><a:ext cx="{cx * 2 // 3}" cy="{cy * 3 // 8}"/>'
                '</a:xfrm><a:prstGeom prst="rect"><a:avLst/></a:prstGeom><a:noFill/><a:ln w="12700"><a:solidFill>'
                '<a:prstClr val="black"/></a:solidFill></a:ln></p:spPr></p:sp>'
                '<p:sp><p:nvSpPr><p:cNvPr id="3" name="Notes Placeholder 2"/><p:cNvSpPr><a:spLocks noGrp="1"/>'
                '</p:cNvSpPr><p:nvPr><p:ph type="body" sz="quarter" idx="3"/></p:nvPr></p:nvSpPr><p:spPr><a:xfrm>'
                f'<a:off x="{cx // 10}" y="{cy * 19 // 40}"/><a:ext cx="{cx * 4 // 5}" cy="{cy * 9 // 20}"/></a:xfrm>'
                '<a:prstGeom prst="rect"><a:avLst/></a:prstGeom></p:spPr><p:txBody><a:bodyPr vert="horz" lIns="91440" '
                'tIns="45720" rIns="91440" bIns="45720" rtlCol="0"/><a:lstStyle/><a:p><a:pPr lvl="0"/><a:r>'
                '<a:rPr lang="en-US"/><a:t>Click to edit Master text styles</a:t></a:r></a:p></p:txBody></p:sp>'
                '</p:spTree></p:cSld><p:clrMap bg1="lt1" tx1="dk1" bg2="lt2" tx2="dk2" accent1="accent1" '
                'accent2="accent2" accent3="accent3" accent4="accent4" accent5="accent5" accent6="accent6" '
                'hlink="hlink" folHlink="folHlink"/><p:notesStyle><a:lvl1pPr marL="0" algn="l" defTabSz="914400" '
                'rtl="0" eaLnBrk="1" latinLnBrk="0" hangingPunct="1"><a:defRPr sz="1200" kern="1200"><a:solidFill>'
                '<a:schemeClr val="tx1"/></a:solidFill><a:latin typeface="+mn-lt"/><a:ea typeface="+mn-ea"/>'
                '<a:cs typeface="+mn-cs"/></a:defRPr></a:lvl1pPr></p:notesStyle></p:notesMaster>',
            _OX_CT + "presentationml.notesMaster+xml")
    pkg.add_rel(nm, "theme", theme)
    rid = pkg.add_rel(pres, "notesMaster", nm)
    root = pdoc.documentElement
    lst = _ox_new(pdoc, root, "notesMasterIdLst", _OX_P)
    el = _ox_new(pdoc, root, "notesMasterId", _OX_P)
    el.setAttributeNS(_OX_R, _pptx_r_prefix(root) + ":id", rid)
    lst.appendChild(el)
    after = _ox_kid(root, _OX_P, "sldMasterIdLst")
    root.insertBefore(lst, after.nextSibling if after is not None else root.firstChild)
    pkg.touch(pres)
    return nm


def _pptx_r_prefix(root) -> str:
    for i in range(root.attributes.length):
        at = root.attributes.item(i)
        if at.prefix == "xmlns" and at.value == _OX_R:
            return at.localName
    root.setAttribute("xmlns:r", _OX_R)
    return "r"


def _pptx_notes(pkg, a: dict) -> str:
    n, slide = _pptx_slide(pkg, a)
    text = str(a.get("text") if a.get("text") is not None else a.get("value") or "")
    notes = next((t for t in pkg.rels_of_type(slide, "notesSlide") if pkg.has(t)), None)
    if notes is None:
        pres, pdoc, _s = _pptx_slides(pkg)
        master = _pptx_notes_master(pkg, pres, pdoc)
        notes = pkg.fresh_name("ppt/notesSlides/notesSlide{n}.xml")
        pkg.put(notes, f'<?xml version="1.0" encoding="UTF-8" standalone="yes"?>\n<p:notes {_P_NS}><p:cSld>'
                       '<p:spTree>' + _P_GRP + '<p:sp><p:nvSpPr><p:cNvPr id="2" name="Slide Image Placeholder 1"/>'
                       '<p:cNvSpPr><a:spLocks noGrp="1" noRot="1" noChangeAspect="1"/></p:cNvSpPr><p:nvPr>'
                       '<p:ph type="sldImg"/></p:nvPr></p:nvSpPr><p:spPr/></p:sp><p:sp><p:nvSpPr>'
                       '<p:cNvPr id="3" name="Notes Placeholder 2"/><p:cNvSpPr><a:spLocks noGrp="1"/></p:cNvSpPr>'
                       '<p:nvPr><p:ph type="body" idx="1"/></p:nvPr></p:nvSpPr><p:spPr/><p:txBody><a:bodyPr/>'
                       '<a:lstStyle/><a:p/></p:txBody></p:sp></p:spTree></p:cSld><p:clrMapOvr>'
                       '<a:masterClrMapping/></p:clrMapOvr></p:notes>',
                _OX_CT + "presentationml.notesSlide+xml")
        pkg.add_rel(notes, "notesMaster", master)
        pkg.add_rel(notes, "slide", slide)
        pkg.add_rel(slide, "notesSlide", notes)
        created = True
    else:
        created = False
    doc = pkg.xml(notes)
    body = None
    for sp in doc.getElementsByTagNameNS(_OX_P, "sp"):
        ph = _pptx_ph(sp)
        if ph is not None and ph.getAttribute("type") == "body":
            body = sp
            break
    if body is None:
        raise _OfficeError(f"notatki slajdu {n} nie mają pola tekstu (body)")
    _pptx_set_body(doc, body, text)
    pkg.touch(notes)
    return f"notatki slajdu {n}" + (" (nowe)" if created else "")


def _pptx_layouts(pkg, pres: str) -> list:
    """[(część układu, typ, nazwa)] ze wszystkich wzorców slajdów."""
    out = []
    for master in pkg.rels_of_type(pres, "slideMaster"):
        for lay in pkg.rels_of_type(master, "slideLayout"):
            if not pkg.has(lay):
                continue
            root = pkg.xml(lay).documentElement
            csld = _ox_kid(root, _OX_P, "cSld")
            out.append((lay, root.getAttribute("type"), csld.getAttribute("name") if csld is not None else ""))
    return out


def _pptx_add_slide(pkg, a: dict) -> str:
    pres, pdoc, slides = _pptx_slides(pkg)
    layouts = _pptx_layouts(pkg, pres)
    if not layouts:
        raise _OfficeError("prezentacja nie ma układów slajdów (slideLayout)")
    want = str(a.get("layout") or "").strip().lower()
    lay = None
    if want:
        lay = next((x for x in layouts if x[2].lower() == want or x[1].lower() == want), None) or \
            next((x for x in layouts if want in x[2].lower()), None)
        if lay is None:
            raise _OfficeError("nie ma układu „{0}”. Układy: {1}".format(
                a.get("layout"), ", ".join(x[2] or x[1] for x in layouts)))
    lay = lay or next((x for x in layouts if x[1] == "obj"), None)
    if lay is None and slides:
        used = pkg.rels_of_type(slides[-1], "slideLayout")
        lay = next((x for x in layouts if used and x[0] == used[0]), None)
    lay = lay or layouts[0]
    ldoc = pkg.xml(lay[0])
    title_ph = body_ph = None
    for sp in ldoc.getElementsByTagNameNS(_OX_P, "sp"):
        ph = _pptx_ph(sp)
        if ph is None:
            continue
        ty = ph.getAttribute("type")
        if ty in ("title", "ctrTitle") and title_ph is None:
            title_ph = ph
        elif ty in ("", "body", "obj", "subTitle") and body_ph is None:
            body_ph = ph
    try:
        after = int(a.get("after") if a.get("after") not in (None, "") else len(slides))
    except (TypeError, ValueError):
        raise _OfficeError("after to numer slajdu, po którym wstawić (0 = na początek)") from None
    after = max(0, min(len(slides), after))
    part = pkg.fresh_name("ppt/slides/slide{n}.xml")

    def ph_xml(ph):
        attrs = "".join(f' {ph.attributes.item(i).name}="{_office_esc(ph.attributes.item(i).value)}"'
                        for i in range(ph.attributes.length) if ph.attributes.item(i).name != "hasCustomPrompt")
        return f"<p:ph{attrs}/>"
    sps, sid = [], 2
    for ph, text, label in ((title_ph, a.get("title"), "Title"), (body_ph, a.get("body"), "Content Placeholder")):
        if ph is None:
            continue
        if isinstance(text, list):
            text = "\n".join(str(x) for x in text)
        sps.append(f'<p:sp><p:nvSpPr><p:cNvPr id="{sid}" name="{label} {sid - 1}"/><p:cNvSpPr><a:spLocks noGrp="1"/>'
                   f'</p:cNvSpPr><p:nvPr>{ph_xml(ph)}</p:nvPr></p:nvSpPr><p:spPr/><p:txBody><a:bodyPr/><a:lstStyle/>'
                   '<a:p/></p:txBody></p:sp>')
        sid += 1
    pkg.put(part, f'<?xml version="1.0" encoding="UTF-8" standalone="yes"?>\n<p:sld {_P_NS}><p:cSld><p:spTree>'
                  + _P_GRP + "".join(sps) + '</p:spTree></p:cSld><p:clrMapOvr><a:masterClrMapping/></p:clrMapOvr>'
                  '</p:sld>', _OX_CT + "presentationml.slide+xml")
    sdoc = pkg.xml(part)
    texts = [x for x in ((title_ph, a.get("title")), (body_ph, a.get("body"))) if x[0] is not None]
    for sp, (_ph, text) in zip(sdoc.getElementsByTagNameNS(_OX_P, "sp"), texts):
        if isinstance(text, list):
            text = "\n".join(str(x) for x in text)
        _pptx_set_body(sdoc, sp, str(text or ""))
    pkg.touch(part)
    pkg.add_rel(part, "slideLayout", lay[0])
    rid = pkg.add_rel(pres, "slide", part)
    root = pdoc.documentElement
    lst = _ox_kid(root, _OX_P, "sldIdLst")
    if lst is None:
        lst = _ox_new(pdoc, root, "sldIdLst", _OX_P)
        ref = next((k for k in _ox_kids(root) if k.localName not in
                    ("sldMasterIdLst", "notesMasterIdLst", "handoutMasterIdLst")), None)
        root.insertBefore(lst, ref)
    ids = [int(x.getAttribute("id") or 0) for x in _ox_kids(lst, _OX_P, "sldId")]
    el = _ox_new(pdoc, lst, "sldId", _OX_P)
    el.setAttribute("id", str(max(ids + [255]) + 1))
    el.setAttributeNS(_OX_R, _pptx_r_prefix(root) + ":id", rid)
    cur = _ox_kids(lst, _OX_P, "sldId")
    lst.insertBefore(el, cur[after] if after < len(cur) else None)
    pkg.touch(pres)
    if not title_ph and a.get("title") or not body_ph and a.get("body"):
        return f"nowy slajd {after + 1} (układ „{lay[2] or lay[1]}” nie ma pola na tytuł lub treść)"
    return f"nowy slajd {after + 1} (układ „{lay[2] or lay[1]}”)"


