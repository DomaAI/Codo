def _msg_text(m: dict) -> str:
    c = m.get("content")
    if isinstance(c, list):
        c = " ".join(str(p.get("text") or "") for p in c if isinstance(p, dict))
    return _strip_codo_context(str(c or ""))


def _strip_codo_context(text: str) -> str:
    return re.sub(r"<!--DOMA-CLI-->.*?<!--/DOMA-CLI-->", "", text, flags=re.S).strip()


def _agent_prompt(kind: str, messages: list, fresh: bool) -> str:
    """Ostatnie polecenie; przy nowej sesji agenta także skrót wcześniejszej rozmowy
    (zmiana modelu w trakcie nie gubi wątku) i pamięć projektu Codo.md."""
    users = [i for i, m in enumerate(messages) if m.get("role") == "user"]
    if not users:
        return ""
    last = users[-1]
    task = _msg_text(messages[last])
    if not fresh:
        # Ta sama sesja agenta, ale w międzyczasie mógł odpowiadać Lopus albo inny agent.
        gap = brain_catchup(f"agent:{kind}", messages)
        return (gap + "\n\n" + _L("Nowe polecenie:") + "\n" + task) if gap else task
    parts = []
    notes = _project_notes() if (kind != "claude" or _agent_acp(kind)) else ""   # Claude: --append-system-prompt
    if notes:
        parts.append("Pamięć projektu (Codo.md):\n" + notes[:6000])
    earlier = brain_catchup(f"agent:{kind}", messages, fresh=True)
    if earlier:
        parts.append(earlier)
    parts.append(("Nowe polecenie:\n" if parts else "") + task)
    return "\n\n".join(parts)


