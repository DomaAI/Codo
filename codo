def _app_capture(fn, *args) -> tuple:
    """Uruchamia funkcję logowania z CLI bez terminala: (kod, ostatni komunikat dla człowieka)."""
    import contextlib
    import io
    buf = io.StringIO()
    old_in = sys.stdin
    sys.stdin = io.StringIO("\n")     # funkcje CLI nie mogą czytać poleceń aplikacji ze stdin
    code = 1
    try:
        with contextlib.redirect_stdout(buf):
            code = fn(*args)
    except SystemExit as e:
        code = int(e.code or 0) if isinstance(e.code, int) else 1
    except BaseException as e:                                   # noqa: BLE001
        buf.write("✗ " + (describe_error(e) if isinstance(e, Exception) else str(e)))
    finally:
        sys.stdin = old_in
    lines = [re.sub(r"\x1b\[[0-9;]*m", "", x).strip() for x in buf.getvalue().splitlines() if x.strip()]
    bad = [x for x in lines if x.startswith("✗")]
    text = (bad[-1] if bad else (lines[-1] if lines else "")).lstrip("✗✓▲ ").strip()
    return code or 0, text


def _app_login(msg: dict) -> None:
    """Logowanie z okna: DomaAI przez przeglądarkę, MaddLabs kluczem, konto API kluczem albo adresem."""
    what = str(msg.get("provider") or "")

    def done(code: int, text: str, **extra) -> None:
        _app_emit("login", provider=what, state="done" if code == 0 else "failed",
                  error="" if code == 0 else (text or _L("Nie udało się zalogować.")), **extra)
        _app_status()
        _app_catalog()
        _app_models()

    if what == "domaai":
        import socket
        if load_device():
            return done(0, "")
        try:
            start = _http("POST", "/cli/pair/start", json_body={"hostname": socket.gethostname(), "cwd": str(Path.cwd())},
                          timeout=20, retries=0)
        except (ApiError, urllib.error.URLError, OSError) as exc:
            return done(1, describe_error(exc))
        digits = "".join(ch for ch in start["code"] if ch.isdigit())
        _app_emit("login", provider=what, state="waiting", url=f"{WEB_URL}/czat/?pair={digits}", code=start["code"])
        threading.Thread(target=lambda: done(*_app_capture(_wait_for_pairing, start)), daemon=True).start()
    elif what == "maddlabs":
        key = str(msg.get("key") or "").strip()
        if not key:
            return done(1, _L("Wklej klucz API MaddLabs."))
        code, text = _app_capture(login_maddlabs_key, key)
        if code == 0:
            _set_provider("maddlabs")
        done(code, text)
    elif what == "account":
        preset = _PRESET.get(str(msg.get("preset") or "").lower())
        spec = preset[0] if preset and preset[3] else str(msg.get("url") or "").strip()
        key = str(msg.get("key") or "").strip()
        if preset and preset[4] and not key:
            return done(1, _Lf('{0} wymaga klucza API.', preset[1]))
        os.environ["CODO_ENDPOINT_KEY"] = key
        try:
            code, text = _app_capture(login_endpoint, spec, str(msg.get("name") or "").strip() or None)
        finally:
            os.environ.pop("CODO_ENDPOINT_KEY", None)
        done(code, text)
    elif what == "logout":
        target = str(msg.get("target") or "")
        if target == "domaai":
            _app_capture(logout)
        elif target == "maddlabs":
            try:
                MADDLABS_FILE.unlink()
            except OSError:
                pass
            if load_settings().get("provider") == "maddlabs":
                _set_provider("domaai" if (load_device() or load_creds()) else "endpoint")
        elif target.startswith("acct:"):
            _app_capture(logout_endpoint, target[5:])
        what = target
        done(0, "", signed_out=True)


# ── Konto DomaAI z okna (23.11.2026): logowanie hasłem, rejestracja, kod z maila, nowe hasło ──
# Okno zbiera dane, silnik rozmawia z API i zapisuje wyłącznie sparowane urządzenie (device.json),
# tak samo jak `codo login --password`: sesja hasłowa żyje tylko do /cli/pair/self, potem /logout.
# Hasło trzymamy w pamięci procesu tylko między krokami (kod z maila, weryfikacja konta), najdłużej
# _ACCOUNT_TTL sekund; nie trafia do zdarzeń, dziennika, historii ani na dysk.
_ACCOUNT: dict = {"pending": None, "lock": threading.Lock()}
_ACCOUNT_TTL = 900
_ACCOUNT_COOLDOWN = 60
ACCOUNT_PLANS_URL = os.environ.get("CODO_PLANS_URL", "https://madd.im/cennik.html")


def _account_pending(email: str | None = None) -> dict | None:
    import time as _t
    p = _ACCOUNT.get("pending")
    if not p or _t.monotonic() - p.get("ts", 0) > _ACCOUNT_TTL:
        _ACCOUNT["pending"] = None
        return None
    if email is not None and p.get("email") != email.strip().lower():
        return None
    return p


def _account_remember(email: str, password: str = "", **extra) -> None:
    import time as _t
    _ACCOUNT["pending"] = {"email": email.strip().lower(), "password": password, "ts": _t.monotonic(), **extra}


def _account_forget() -> None:
    _ACCOUNT["pending"] = None


def _account_detail(exc: "ApiError") -> str:
    """Treść błędu z API bez technicznych wtrąceń w rodzaju „(/resend_verification)”."""
    text = exc.human()
    text = re.sub(r"\s*\(/[a-z_]+\)", "", text)
    text = re.sub(r"\s*RODO Art[^.]*\.", "", text)
    return text.strip()


def _account_failure(exc: BaseException, where: str) -> dict:
    """Błąd po polsku, z kodem dla okna i polem, przy którym go pokazać."""
    if not isinstance(exc, ApiError):
        if isinstance(exc, (urllib.error.URLError, TimeoutError, ConnectionError, OSError)):
            return {"code": "offline", "field": "",
                    "error": _L("Brak połączenia z DomaAI. Sprawdź internet i spróbuj ponownie.")}
        return {"code": "error", "field": "", "error": describe_error(exc) if isinstance(exc, Exception) else str(exc)}
    st, flags = exc.status, exc.payload
    detail = exc.detail if isinstance(exc.detail, dict) else {}
    text = _account_detail(exc)
    low = text.lower()
    if detail.get("code") == "PLAN_REQUIRED" or flags.get("code") == "PLAN_REQUIRED":
        need = str(detail.get("required_plan") or "base")
        return {"code": "plan_required", "field": "", "plan": str(detail.get("plan") or "free"),
                "required_plan": need, "url": ACCOUNT_PLANS_URL,
                "error": _Lf("Codo z modelami DomaAI wymaga planu {0} lub wyższego.", need.capitalize())}
    if st == 429:
        if "kod" in low:
            return {"code": "too_many_codes", "field": "code",
                    "error": _L("Za dużo błędnych kodów. Wyślij nowy kod i wpisz go jeszcze raz.")}
        m = re.search(r"za (\d+) (minut|godzin)", low)
        secs = (int(m.group(1)) * (3600 if m.group(2).startswith("godzin") else 60)) if m else (
            3600 if "godzin" in low else 900)
        return {"code": "rate_limited", "field": "", "retry_after": secs,
                "error": _L("Za dużo prób. Odczekaj chwilę i spróbuj ponownie.")}
    if st == 403:
        if flags.get("account_blocked"):
            return {"code": "blocked", "field": "", "error": _L("To konto jest zablokowane. Napisz do nas: kontakt@madd.im.")}
        if flags.get("account_frozen"):
            return {"code": "frozen", "field": "", "url": f"{WEB_URL}/czat/",
                    "error": _L("Konto jest zamrożone. Odmroź je w DomaAI w przeglądarce.")}
        if flags.get("account_soft_deleted"):
            return {"code": "deleted", "field": "", "url": f"{WEB_URL}/czat/",
                    "error": _L("Konto czeka na usunięcie. Przywróć je w DomaAI w przeglądarce.")}
        if flags.get("requires_tos_acceptance"):
            return {"code": "terms", "field": "", "url": f"{WEB_URL}/czat/",
                    "error": _L("Zmienił się regulamin DomaAI. Zaakceptuj go w przeglądarce, potem zaloguj się tutaj.")}
        if flags.get("requires_email_otp") or flags.get("requires_2fa"):
            return {"code": "bad_code", "field": "code",
                    "error": _L("Ten kod nie pasuje albo już wygasł. Sprawdź go albo poproś o nowy.")}
    if st == 401:
        if where == "login":
            return {"code": "bad_credentials", "field": "password", "error": _L("Nieprawidłowy e-mail lub hasło.")}
        if where in ("verify", "reset", "code"):
            return {"code": "bad_code", "field": "code", "error": _L("Ten kod nie pasuje. Sprawdź go w mailu.")}
    if st == 400:
        if "wygasł" in low or "brak aktywnego kodu" in low:
            return {"code": "code_expired", "field": "code", "error": _L("Kod wygasł. Wyślij nowy kod.")}
        if "hasło" in low:
            return {"code": "weak_password", "field": "password", "error": text}
        if "mail" in low or "adres" in low:
            return {"code": "bad_email", "field": "email", "error": text}
        if "nazwa użytkownika" in low:
            return {"code": "bad_name", "field": "name",
                    "error": _L("Imię musi mieć od 3 do 100 znaków.")}
        if "akceptacja" in low or "wieku" in low:
            return {"code": "consent", "field": "consent", "error": _L("Potwierdź zgody, żeby założyć konto.")}
    if st == 422:
        return {"code": "invalid", "field": "", "error": _L("Uzupełnij wszystkie pola.")}
    if st >= 500:
        return {"code": "server", "field": "", "error": _L("DomaAI chwilowo nie odpowiada. Spróbuj za chwilę.")}
    return {"code": "error", "field": "", "error": text or _L("Nie udało się. Spróbuj ponownie.")}


def _account_emit(action: str, state: str, **data) -> None:
    _app_emit("account", action=action, state=state, **data)


def _account_sign_in(action: str, email: str, password: str, extra: dict | None = None,
                     name_hint: str = "") -> None:
    """Hasło (i ewentualnie kod) → świeża sesja → sparowane urządzenie → wylogowanie sesji."""
    email = email.strip().lower()
    form = {"email": email, "password": password, **(extra or {})}
    try:
        data = _http("POST", "/login", form=form, retries=0, timeout=30)
    except ApiError as exc:
        f = exc.payload
        if exc.status == 403 and f.get("email_verification_required"):
            _account_remember(email, password)
            return _account_emit(action, "verify", email=email, resend=True)
        if exc.status == 403 and (f.get("requires_2fa") or f.get("requires_email_otp")):
            kind = "totp" if f.get("requires_2fa") else "email"
            _account_remember(email, password, need="totp_code" if kind == "totp" else "email_otp")
            if extra:   # podany kod był zły
                return _account_emit(action, "failed", email=email, kind=kind, **_account_failure(exc, "code"))
            return _account_emit(action, "code", email=email, kind=kind)
        return _account_emit(action, "failed", email=email, **_account_failure(exc, "login"))
    _account_finish(action, email, data, name_hint)


def _account_finish(action: str, email: str, data: dict, name_hint: str = "") -> None:
    """Świeża sesja (odpowiedź jak z /login) → sparowane urządzenie → wylogowanie sesji → „done”.
    Bez planu do parowania (403 PLAN_REQUIRED) konto i tak jest potwierdzone: zostaje account.json
    (e-mail, imię, plan; bez tokenów), żeby okno wiedziało, że ktoś się zalogował."""
    import socket
    token = data.get("access_token") or ""
    user = data.get("user") if isinstance(data.get("user"), dict) else {}
    full_name = str(data.get("full_name") or user.get("full_name") or name_hint or "")
    old = load_device()
    try:
        host = socket.gethostname()
        dev = _http("POST", "/cli/pair/self", json_body={"hostname": host, "device_name": host},
                    token=token, retries=0, timeout=30)
        save_device({"device_id": dev["device_id"], "device_secret": dev["device_secret"],
                     "name": dev.get("name") or host, "email": email})
    except (ApiError, urllib.error.URLError, OSError, KeyError, ValueError) as exc:
        _account_forget()
        fail = _account_failure(exc if not isinstance(exc, (KeyError, ValueError)) else OSError(str(exc)), "pair")
        if fail.get("code") == "plan_required":
            save_account_info({"email": email, "name": full_name, "plan": fail.get("plan") or "free"})
            _account_emit(action, "failed", email=email, name=full_name, signed_in=True, **fail)
            return _app_status()
        return _account_emit(action, "failed", email=email, name=full_name,
                             **_account_failure(exc if not isinstance(exc, (KeyError, ValueError)) else
                                                OSError(str(exc)), "pair"))
    finally:
        try:
            _http("POST", "/logout", token=token, retries=0, timeout=15)
        except Exception:                                        # noqa: BLE001
            pass  # nosec B110 — sprzątanie sesji jest najlepszym wysiłkiem, sesja i tak wygaśnie
    _account_forget()
    if old and old.get("device_id") != dev.get("device_id"):
        # Wcześniejsze urządzenie tego Maca (inne konto albo stare parowanie) nie zostaje osierocone.
        try:
            tok = _http("POST", "/cli/pair/token", json_body={"device_id": old["device_id"],
                                                             "device_secret": old["device_secret"]},
                        timeout=15, retries=0)
            _http("POST", "/cli/device/logout", token=tok["access_token"], timeout=15, retries=0)
        except Exception:                                        # noqa: BLE001
            pass  # nosec B110 — urządzenie widać w DomaAI Web → Codo, można je usunąć ręcznie
    plan = ""
    try:
        who = _http("GET", "/cli/whoami", token=device_access_token(force=True), timeout=10, retries=0)
        plan = str(who.get("plan") or "")
        full_name = str(who.get("imie") or full_name)
        save_agent_profile(who)
    except BaseException:                                        # noqa: BLE001
        pass  # nosec B110 — plan i imię są do powitania, logowanie już się udało
    save_account_info({"email": email, "name": full_name, "plan": plan})
    _account_emit(action, "done", email=email, name=full_name, plan=plan,
                  device=(load_device() or {}).get("name") or "")
    _app_status()
    _app_catalog()
    _app_models()
    _app_limits()


# ── Logowanie kodem z maila (23.11.2026, jak w kontrakcie /auth/kod) ──
# send_code → mail z 6 cyframi; check_code → konto istnieje: sesja jak z /login (dalej parowanie jak wyżej),
# nowy adres: bilet rejestracji (tylko w pamięci, 15 min); 2FA: ten sam kod z maila + totp; finish → konto.
def _account_code_failure(exc: BaseException, action: str) -> dict:
    if isinstance(exc, ApiError):
        f, st = exc.payload, exc.status
        if st == 429:
            secs = f.get("ponownie_za")
            try:
                secs = int(secs) if secs is not None else None
            except (TypeError, ValueError):
                secs = None
            if action in ("send_code", "resend_code"):
                return {"code": "too_often", "field": "", "retry_after": secs or _ACCOUNT_COOLDOWN,
                        "error": _L("Kod wysyłaliśmy przed chwilą. Nowy możesz wysłać za moment.")}
            return {"code": "rate_limited", "field": "", "retry_after": secs or 900,
                    "error": _L("Za dużo prób. Odczekaj chwilę i spróbuj ponownie.")}
        if st == 401 and action == "check_code":
            left = f.get("pozostalo_prob")
            try:
                left = int(left) if left is not None else None
            except (TypeError, ValueError):
                left = None
            if left == 0:
                return {"code": "code_dead", "field": "code", "attempts_left": 0,
                        "error": _L("Ten kod już nie zadziała. Wyślij nowy kod.")}
            if left is not None:
                return {"code": "bad_code", "field": "code", "attempts_left": left,
                        "error": _Lf("Nieprawidłowy albo wygasły kod. Pozostało prób: {0}.", left)}
            return {"code": "bad_code", "field": "code",
                    "error": _L("Nieprawidłowy albo wygasły kod. Sprawdź go w mailu.")}
        if action == "finish" and (st == 410 or (st == 400 and "bilet" in _account_detail(exc).lower())):
            return {"code": "ticket_expired", "field": "",
                    "error": _L("Minęło za dużo czasu. Wpisz e-mail jeszcze raz, wyślemy nowy kod.")}
        if st == 400 and action in ("send_code", "resend_code"):
            # Literówka w domenie (cloud.com zamiast icloud.com): serwer podpowiada adres; ponowne
            # wysłanie tego samego adresu przechodzi.
            sug = str(f.get("sugestia") or "") if isinstance(f, dict) else ""
            if sug:
                return {"code": "typo", "field": "email", "suggestion": sug,
                        "error": _Lf("Czy chodziło o {0}? Popraw adres albo wyślij jeszcze raz, jeśli jest dobry.", sug)}
            return {"code": "bad_email", "field": "email", "error": _L("Wpisz poprawny adres e-mail.")}
        if st == 400 and action == "finish":
            text = _account_detail(exc)
            low = text.lower()
            if "imię" in low or "nazwa" in low or "name" in low or "znak" in low:
                return {"code": "bad_name", "field": "name", "error": _L("Imię musi mieć od 3 do 100 znaków.")}
            if "akcept" in low or "wiek" in low or "zgod" in low:
                return {"code": "consent", "field": "consent", "error": _L("Potwierdź zgody, żeby założyć konto.")}
            if "domen" in low or "jednorazow" in low:
                return {"code": "bad_email", "field": "", "error": text}
            return {"code": "error", "field": "", "error": text or _L("Nie udało się. Spróbuj ponownie.")}
    return _account_failure(exc, "code" if action == "check_code" else action)


def _app_account_code(action: str, msg: dict, email: str, code: str) -> None:
    if action in ("send_code", "resend_code"):
        res = _http("POST", "/auth/kod", form={"email": email, "jezyk": ui_lang()}, retries=0, timeout=30)
        _account_remember(email, kind="code")
        try:
            wait = int(res.get("ponownie_za") or _ACCOUNT_COOLDOWN)
        except (TypeError, ValueError):
            wait = _ACCOUNT_COOLDOWN
        return _account_emit(action, "sent", email=email, cooldown=wait)
    if action == "check_code":
        p = _account_pending()
        totp = "".join(ch for ch in str(msg.get("totp") or "") if ch.isalnum())
        accept_tos = bool(msg.get("accept_tos"))
        if totp or accept_tos:
            # Drugi krok (2FA albo nowy regulamin): kod z maila trzymamy w pamięci z pierwszego podejścia,
            # serwer go wtedy nie zużywa.
            if not p or not p.get("code"):
                return _account_emit(action, "failed", code="expired_session", field="",
                                     error=_L("Minęło za dużo czasu. Wyślij nowy kod."))
            email, code = p["email"], p["code"]
            totp = totp or str(p.get("totp") or "")
        if not email or len(code) != 6:
            return _account_emit(action, "failed", code="bad_code", field="code", error=_L("Wpisz cały kod."))
        form = {"email": email, "code": code}
        if totp:
            form["totp_code"] = totp
        if accept_tos:
            form["accept_tos"] = "1"
        try:
            data = _http("POST", "/auth/kod/weryfikuj", form=form, retries=0, timeout=30)
        except ApiError as exc:
            f = exc.payload
            if exc.status == 403 and f.get("requires_2fa"):
                _account_remember(email, kind="code", code=code)
                if totp:
                    return _account_emit(action, "failed", email=email, kind="totp", code="bad_totp", field="code",
                                         error=_L("Ten kod z aplikacji nie pasuje. Spróbuj z nowym."))
                return _account_emit(action, "totp", email=email, kind="totp")
            if exc.status == 403 and f.get("requires_tos_acceptance") and not accept_tos:
                _account_remember(email, kind="code", code=code, totp=totp)
                return _account_emit(action, "terms", email=email, url="https://madd.im/regulamin-doma.html")
            raise
        if str(data.get("status") or "") == "rejestracja" and data.get("bilet"):
            _account_remember(str(data.get("email") or email), kind="register", bilet=str(data["bilet"]))
            return _account_emit(action, "new_account", email=str(data.get("email") or email))
        if not data.get("access_token"):
            return _account_emit(action, "failed", code="server", field="",
                                 error=_L("DomaAI chwilowo nie odpowiada. Spróbuj za chwilę."))
        _account_forget()
        return _account_finish(action, email, data)
    if action == "finish":
        p = _account_pending()
        if not p or not p.get("bilet"):
            return _account_emit(action, "failed", code="ticket_expired", field="",
                                 error=_L("Minęło za dużo czasu. Wpisz e-mail jeszcze raz, wyślemy nowy kod."))
        name = str(msg.get("name") or "").strip()
        if not name:
            return _account_emit(action, "failed", code="bad_name", field="name", error=_L("Wpisz swoje imię."))
        if not msg.get("accepted"):
            return _account_emit(action, "failed", code="consent", field="consent",
                                 error=_L("Potwierdź zgody, żeby założyć konto."))
        yes = "true"
        data = _http("POST", "/auth/kod/rejestracja", form={
            "bilet": p["bilet"], "full_name": name[:100], "accepted_terms": yes, "accepted_privacy": yes,
            "accepted_subscription_terms": yes, "age_acknowledged_16plus": yes, "zrodlo": "codo"},
            retries=0, timeout=30)
        if not data.get("access_token"):
            return _account_emit(action, "failed", code="server", field="",
                                 error=_L("DomaAI chwilowo nie odpowiada. Spróbuj za chwilę."))
        _account_forget()
        return _account_finish(action, p["email"], data, name_hint=name)


# ── Apple i Google w oknie Codo (24.11.2026) ──
# Okno samo pokazuje systemowy arkusz Apple albo arkusz logowania Google i oddaje tu identity_token
# z surowym nonce. Silnik robi resztę jak aplikacja na iPhone'a: /auth/<dostawca>/check → konto jest:
# /auth/<dostawca> (sesja jak z /login → parowanie), nowe konto: strona zgód (finish), nowy regulamin:
# /account/accept_tos tym samym tokenem i jeszcze raz /auth/<dostawca>. Token żyje tylko w pamięci.
_SOCIAL_PROVIDERS = ("apple", "google")


def _social_claims(token: str) -> dict:
    """Podgląd claimów BEZ weryfikacji (tylko e-mail i imię do okna; podpis sprawdza serwer)."""
    import base64
    try:
        part = token.split(".")[1]
        return json.loads(base64.urlsafe_b64decode(part + "=" * (-len(part) % 4)).decode())
    except (IndexError, ValueError, UnicodeDecodeError):
        return {}


def _social_failure(exc: BaseException, provider: str) -> dict:
    if isinstance(exc, ApiError):
        st, text = exc.status, _account_detail(exc)
        if st == 409:
            return {"code": "exists_other", "field": "",
                    "error": _L("Ten adres ma już konto DomaAI. Zaloguj się kodem z maila.")}
        if st == 503:
            return {"code": "provider_off", "field": "",
                    "error": _L("Logowanie tą metodą jest chwilowo wyłączone. Zaloguj się kodem z maila.")}
        if st == 401:
            return {"code": "social_token", "field": "",
                    "error": _L("Logowanie wygasło albo zostało odrzucone. Spróbuj jeszcze raz.")}
        if st == 400 and ("wieku" in text.lower() or "akcept" in text.lower()):
            return {"code": "consent", "field": "consent", "error": _L("Potwierdź zgody, żeby założyć konto.")}
    return _account_failure(exc, "social")


def _social_auth(action: str, p: dict, register: dict | None = None) -> None:
    """POST /auth/<dostawca> z tokenem z pamięci; 403 z nowym regulaminem → strona „terms”."""
    provider = p["provider"]
    form = {"identity_token": p["token"], "nonce": p["nonce"]}
    if p.get("name"):
        form["full_name"] = p["name"][:100]
    if register:
        form.update(register)
    try:
        data = _http("POST", f"/auth/{provider}", form=form, retries=0, timeout=30)
    except ApiError as exc:
        if exc.status == 403 and exc.payload.get("requires_tos_acceptance") and not register:
            _account_remember(p["email"], **{k: v for k, v in p.items() if k not in ("email", "password", "ts")})
            return _account_emit(action, "terms", email=p["email"], provider=provider,
                                 url="https://madd.im/regulamin-doma.html")
        if exc.status == 403 and (exc.payload.get("account_blocked") or exc.payload.get("account_frozen")
                                  or exc.payload.get("account_soft_deleted")):
            raise
        return _account_emit(action, "failed", email=p["email"], provider=provider,
                             **_social_failure(exc, provider))
    if not data.get("access_token"):
        return _account_emit(action, "failed", code="server", field="",
                             error=_L("DomaAI chwilowo nie odpowiada. Spróbuj za chwilę."))
    _account_forget()
    return _account_finish(action, p["email"], data, name_hint=str(p.get("name") or ""))


def _app_account_social(action: str, msg: dict) -> None:
    """action = apple | google: identity_token + nonce (surowy) z arkusza w oknie, opcjonalnie name i email."""
    token = str(msg.get("identity_token") or "").strip()
    nonce = str(msg.get("nonce") or "").strip()
    if token.count(".") != 2 or len(nonce) < 16:
        return _account_emit(action, "failed", code="social_token", field="",
                             error=_L("Logowanie wygasło albo zostało odrzucone. Spróbuj jeszcze raz."))
    claims = _social_claims(token)
    email = str(msg.get("email") or claims.get("email") or "").strip().lower()
    name = str(msg.get("name") or "").strip()
    if not name and action == "google":
        name = str(claims.get("name") or f"{claims.get('given_name', '')} {claims.get('family_name', '')}").strip()
    p = {"email": email, "provider": action, "token": token, "nonce": nonce, "name": name, "kind": "social"}
    try:
        res = _http("POST", f"/auth/{action}/check", form={"identity_token": token, "nonce": nonce},
                    retries=0, timeout=30)
    except ApiError as exc:
        return _account_emit(action, "failed", email=email, provider=action, **_social_failure(exc, action))
    if not res.get("exists"):
        _account_remember(email, provider=action, token=token, nonce=nonce, name=name, kind="social")
        return _account_emit(action, "new_account", email=email, name=name, provider=action)
    return _social_auth(action, p)


def _app_account_social_next(action: str, msg: dict, p: dict) -> None:
    """Drugi krok po Apple/Google: nowy regulamin (check_code + accept_tos) albo nowe konto (finish)."""
    p = dict(p)
    if action == "check_code":   # nowy regulamin: akceptacja tym samym tokenem, potem logowanie
        try:
            _http("POST", "/account/accept_tos", form={"identity_token": p["token"], "nonce": p["nonce"],
                                                      **({"email": p["email"]} if p.get("email") else {})},
                  retries=0, timeout=30)
        except ApiError as exc:
            return _account_emit(action, "failed", email=p["email"], provider=p["provider"],
                                 **_social_failure(exc, p["provider"]))
        p["tos_ok"] = True
        return _social_auth(action, p)
    name = str(msg.get("name") or p.get("name") or "").strip()
    if not name:
        return _account_emit(action, "failed", code="bad_name", field="name", error=_L("Wpisz swoje imię."))
    if not msg.get("accepted"):
        return _account_emit(action, "failed", code="consent", field="consent",
                             error=_L("Potwierdź zgody, żeby założyć konto."))
    p["name"] = name
    yes = "true"
    reg = {"accepted_terms": yes, "accepted_privacy": yes, "accepted_subscription_terms": yes,
           "age_acknowledged_16plus": yes}
    if p["provider"] == "apple":
        reg["is_registration"] = yes
    return _social_auth(action, p, register=reg)


_ACCOUNT_CODE_ACTIONS = ("send_code", "resend_code", "check_code", "finish")


def _app_account(msg: dict) -> None:
    """Okno „Konto DomaAI”: action = send_code | resend_code | check_code | finish (kod z maila), cancel,
    apple | google (token z arkusza w oknie, dalej terms → check_code, nowe konto → finish);
    starsze: login | code | register | verify | resend | forgot | reset."""
    with _ACCOUNT["lock"]:
        _app_account_locked(msg)


def _app_account_locked(msg: dict) -> None:
    action = str(msg.get("action") or "")
    email = str(msg.get("email") or "").strip().lower()
    password = str(msg.get("password") or "")
    code = "".join(ch for ch in str(msg.get("code") or "") if ch.isdigit())
    email_ok = bool(re.fullmatch(r"[^@\s]+@[^@\s]+\.[^@\s]+", email))
    if action == "cancel":
        _account_forget()
        return
    if action in ("login", "register", "forgot", "resend", "send_code", "resend_code") and not email_ok:
        return _account_emit(action, "failed", code="bad_email", field="email",
                             error=_L("Wpisz poprawny adres e-mail."))
    if action in _SOCIAL_PROVIDERS or (action in ("check_code", "finish")
                                       and (_account_pending() or {}).get("kind") == "social"):
        try:
            if action in _SOCIAL_PROVIDERS:
                return _app_account_social(action, msg)
            p = _account_pending() or {}
            if action == "check_code" and not msg.get("accept_tos"):
                return _account_emit(action, "failed", code="expired_session", field="",
                                     error=_L("Minęło za dużo czasu. Spróbuj jeszcze raz."))
            return _app_account_social_next(action, msg, p)
        except BaseException as exc:                             # noqa: BLE001
            if isinstance(exc, (KeyboardInterrupt, SystemExit)):
                raise
            return _account_emit(action, "failed", email=email, **_account_failure(exc, "social"))
    if action in _ACCOUNT_CODE_ACTIONS:
        try:
            return _app_account_code(action, msg, email, code)
        except BaseException as exc:                             # noqa: BLE001
            if isinstance(exc, (KeyboardInterrupt, SystemExit)):
                raise
            return _account_emit(action, "failed", email=email, **_account_code_failure(exc, action))
    try:
        if action == "login":
            if not password:
                return _account_emit(action, "failed", code="missing", field="password", error=_L("Wpisz hasło."))
            return _account_sign_in(action, email, password)
        if action == "code":
            p = _account_pending()
            if not p or not p.get("need"):
                return _account_emit(action, "failed", code="expired_session", field="",
                                     error=_L("Minęło za dużo czasu. Zaloguj się jeszcze raz."))
            if len(code) < 6:
                return _account_emit(action, "failed", code="bad_code", field="code", error=_L("Wpisz cały kod."))
            return _account_sign_in(action, p["email"], p["password"], {p["need"]: code})
        if action == "register":
            if not msg.get("accepted"):
                return _account_emit(action, "failed", code="consent", field="consent",
                                     error=_L("Potwierdź zgody, żeby założyć konto."))
            name = str(msg.get("name") or "").strip()
            if not name:
                local = email.split("@")[0]
                name = local[:1].upper() + local[1:] if len(local) >= 3 else _L("Użytkownik Codo")
            yes = "true"
            res = _http("POST", "/register", form={
                "email": email, "password": password, "full_name": name[:100],
                "accepted_terms": yes, "accepted_privacy": yes, "accepted_subscription_terms": yes,
                "age_acknowledged_16plus": yes}, retries=0, timeout=30)
            _account_remember(email, password, name=name)
            if res.get("user_id") is None:
                # 202: adres już ma konto (serwer celowo tego nie mówi wprost).
                return _account_emit(action, "verify", email=email, maybe_exists=True)
            if res.get("email_verification_required", True):
                return _account_emit(action, "verify", email=email)
            return _account_sign_in(action, email, password, name_hint=name)
        if action == "verify":
            email = email or ((_account_pending() or {}).get("email") or "")
            if len(code) != 6:
                return _account_emit(action, "failed", code="bad_code", field="code", error=_L("Wpisz cały kod."))
            _http("POST", "/verify_email", form={"email": email, "code": code}, retries=0, timeout=30)
            p = _account_pending(email)
            if p:
                return _account_sign_in(action, email, p["password"], name_hint=p.get("name", ""))
            return _account_emit(action, "verified", email=email)
        if action == "resend":
            _http("POST", "/resend_verification", form={"email": email}, retries=0, timeout=30)
            return _account_emit(action, "sent", email=email, cooldown=_ACCOUNT_COOLDOWN)
        if action == "forgot":
            _http("POST", "/forgot_password", form={"email": email}, retries=0, timeout=30)
            return _account_emit(action, "sent", email=email, cooldown=_ACCOUNT_COOLDOWN)
        if action == "reset":
            if len(code) != 6:
                return _account_emit(action, "failed", code="bad_code", field="code", error=_L("Wpisz cały kod."))
            _http("POST", "/reset_password", form={"email": email, "code": code, "new_password": password},
                  retries=0, timeout=30)
            return _account_sign_in(action, email, password)
        _account_emit(action, "failed", code="unknown", field="", error=_L("Nieznane polecenie."))
    except BaseException as exc:                                 # noqa: BLE001
        if isinstance(exc, (KeyboardInterrupt, SystemExit)):
            raise
        _account_emit(action, "failed", email=email, **_account_failure(exc, action))


def _app_use(pid: str, mid: str) -> None:
    """Wybór z okna: dostawca i model jednym ruchem."""
    st = load_settings()
    if pid in ("domaai", "maddlabs"):
        st["provider"] = pid
        key = "model_maddlabs" if pid == "maddlabs" else "model"
        if mid:
