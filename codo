# ── codo serve — mostek WebStudio (zarządzanie tą stroną z czatu web) ───────

def serve(creds: dict, auto_yes: bool, site_url: str | None) -> int:
    """Daemon: rejestruje tę maszynę+katalog w doma i polluje kolejkę zadań.
    Zadania wrzuca Multi-Agent z czatu na madd.im/czat (narzędzie
    server_studio). Wykonanie w 100% lokalne — te same narzędzia co codo code,
    ograniczone do TEGO katalogu. run_command tylko z --yes (zgoda z góry;
    daemon nie może pytać interaktywnie — często działa pod nohup/systemd)."""
    import socket
    import time as _time

    _SERVE["on"] = True   # panel WebStudio: szersze rooty i narzędzia panelu
    dev = load_device()

    # Auto-wykrycie strony z nginx (gdy nie podano --site): domena → site_url,
    # dzięki czemu panel od razu zna adres i podgląd działa bez wpisywania.
    # TYLKO gdy katalog uruchomienia należy do tego vhosta (cwd pod rootem albo
    # root pod cwd) — inaczej mostek odpalony w dowolnym folderze przypisywał
    # sobie pierwszą domenę z maszyny i panel pokazywał cudzą stronę.
    if not site_url:
        try:
            site_url = _nginx_site_for_cwd()
            if site_url:
                print(dim(_Lf('  wykryto stronę z nginx dla tego katalogu: {0}', site_url)))
        except Exception:
            site_url = None  # nosec B110 — detekcja best-effort

    reg_body = {
        "hostname": socket.gethostname(),
        "cwd": str(Path.cwd()),
        "site_url": site_url,
        "allow_commands": auto_yes,
        "cli_version": VERSION,
    }
    if dev:
        reg_body["device_id"] = dev["device_id"]
    reg = api_call(creds, "/cli/daemon/register", reg_body)
    daemon_id = reg["daemon_id"]
    wait_s = int(reg.get("poll_wait_s") or 20)

    # Heartbeat w osobnym wątku: pętla poll jest jednowątkowa i podczas wolnego
    # zadania (fetch+inline strony, testy) nie pingowałaby → backend uznałby
    # mostek za offline i „zrywał połączenie". Ten wątek utrzymuje last_seen.
    import threading
    _hb = {"daemon_id": daemon_id, "stop": threading.Event()}

    def _heartbeat():
        while not _hb["stop"].wait(15):
            try:
                api_call(creds, "/cli/daemon/ping", {"daemon_id": _hb["daemon_id"]})
            except Exception:
                pass  # nosec B110 — heartbeat best-effort, błąd zignoruj

    threading.Thread(target=_heartbeat, daemon=True).start()

    # Pula wątków: zadania wykonują się RÓWNOLEGLE. Wcześniej pętla była
    # jednowątkowa — wolny skan (scan_sites po całym HOME) blokował podgląd i
    # kończyło się 504. Teraz szybki podgląd nie czeka na wolny skan.
    from concurrent.futures import ThreadPoolExecutor
    pool = ThreadPoolExecutor(max_workers=4)

    def _process_job(job):
        name = job.get("tool") or "?"
        args = job.get("args") or {}
        hint = args.get("path") or args.get("command") or args.get("pattern") or ""
        print(f"  {violet('◆')} {name} {dim(str(hint)[:120])}")
        if name in CONFIRM_TOOLS and not auto_yes:
            result = ("ODRZUCONE: daemon działa bez --yes — komendy/testy/"
                      "instalacje wyłączone. Poproś użytkownika o "
                      "`codo serve --yes`.")
        else:
            try:
                result = run_tool(name, args, auto_yes=True)
            except Exception as e:  # nigdy nie zabijaj workera — zwróć błąd
                result = f"BŁĄD narzędzia {name}: {e}"
        ok = not result.startswith(("BŁĄD", "ODRZUCONE"))
        try:
            api_call(creds, "/cli/daemon/result", {
                "job_id": job.get("id"), "ok": ok, "result": result,
            })
        except Exception as e:
            print(red(_Lf('✗ result: {0}', e)))
        status_icon = green("✓") if ok else red("✗")
        print(f"    {status_icon} {dim(result.splitlines()[0][:120] if result else _L('(pusto)'))}")

    who = (dev or {}).get("name") or (creds or {}).get("email") or "?"
    banner(_L("mostek serwera"))
    print(bold(_Lf('codo serve {0}', VERSION)) + dim(_Lf(' · {0} · urządzenie {1}', Path.cwd(), who)))
    print(green(_L("✓ Mostek aktywny.")) + _L(" Zarządzaj tą stroną z czatu: ") + bold(f"{WEB_URL}/czat/") + dim(_L(" (Code)")))
    if auto_yes:
        print(yellow(_L("⏵⏵ --yes: agent może wykonywać komendy shell w tym katalogu.")))
    else:
        print(dim(_L("Komendy shell wyłączone (uruchom z --yes, by je włączyć). Pliki: OK.")))
    print(dim(_L("Ctrl+C zatrzymuje mostek.\n")))

    # Pierwsze uruchomienie w tym folderze → zaproponuj stałe połączenie
    # (autostart mostka po restarcie). Tylko interaktywnie — pod systemd/
    # launchd/nohup stdin nie jest TTY i pytanie by wisiało.
    # sys.stdin bywa None pod pythonw (autostart mostka na Windows) — wtedy
    # NIE pytamy (i nie wywalamy się na .isatty() None-a).
    if sys.stdin and sys.stdin.isatty() and str(Path.cwd()) not in _links_load():
        try:
            # start_now=False: ta sesja już serwuje; unit wstanie po restarcie.
            link_folder(auto_yes, site_url, ask=True, start_now=False)
        except (EOFError, KeyboardInterrupt):
            print()
        print()

    try:
        backoff = 2
        while True:
            try:
                resp = api_call(creds, "/cli/daemon/poll",
                                {"daemon_id": daemon_id, "wait_s": wait_s})
                backoff = 2
            except KeyboardInterrupt:
                raise
            except ApiError as e:
                if e.status in (401, 403):
                    print(red(_L("✗ Mostek zatrzymany: ")) + e.human())
                    return 1
                if e.status == 404:
                    # Backend nie zna daemona (restart/porządki) → re-rejestracja.
                    print(yellow(_L("▲ Ponowna rejestracja mostka…")))
                    reg = api_call(creds, "/cli/daemon/register", reg_body)
                    daemon_id = reg["daemon_id"]
                    _hb["daemon_id"] = daemon_id  # heartbeat na nowy id
                    continue
                print(red(_Lf('✗ poll: {0}', e)) + dim(_Lf(' — ponawiam za {0}s', backoff)))
                _time.sleep(backoff)
                backoff = min(backoff * 2, 60)
                continue
            except Exception as e:  # sieć padła — czekaj i próbuj dalej
                print(red(_Lf('✗ sieć: {0}', e)) + dim(_Lf(' — ponawiam za {0}s', backoff)))
                _time.sleep(backoff)
                backoff = min(backoff * 2, 60)
                continue

            # Zadania wykonujemy równolegle (pula) — poll nie czeka na ich koniec.
            for job in resp.get("jobs") or []:
                pool.submit(_process_job, job)
    finally:
        _hb["stop"].set()
        pool.shutdown(wait=False, cancel_futures=True)


