# ── grupy agentów: nazwane składy z różnych dostawców i sposoby pracy (grupy.json) ──
#
# Grupa to trwały skład: członkowie (stali agenci z okna albo „na chwilę”), każdy z własnym mózgiem, rolą
# i personą, prowadzący i sposób pracy. Bieg grupy (GroupRun) uruchamia każdego członka jako osobny
# `codo app-server`, więc działają naprawdę równolegle; miejsca u dostawców są wspólne dla wszystkich
# biegów w tym procesie (ile naraz na jednym planie). Zdarzenia group_* idą do okna i do pliku
# events.jsonl przebiegu w CONFIG_DIR/grupy-biegi/<run_id>/.

_GROUP_STRATEGIES = {
    "chat": "Rozmowa",
    "parallel": "Równolegle i porównaj",
    "split": "Prowadzący dzieli pracę",
    "review": "Przegląd krzyżowy",
    "vote": "Głosowanie",
    "pipeline": "Potok",
}
_GROUP_LIMITS = {"rounds": 2, "member_minutes": 20, "parallel": 0, "budget_kr": 0}
_GROUP_MAX_MEMBERS = 8
# Ile tur naraz u jednego dostawcy (dla wszystkich biegów w tym procesie). Klucz: agent:<rodzaj>, domaai,
# maddlabs, konto:<nazwa>, lokalny; nadpisuje ustawienie group_slots.
_GROUP_SLOT_DEFAULT = {"agent": 2, "domaai": 4, "maddlabs": 4, "konto": 3, "lokalny": 1, "inne": 3}
_GROUP_SLOTS: dict = {}
_GROUP_SLOTS_GUARD = threading.Lock()
_GROUP_APP: dict = {"runs": {}}
_GROUP_FORWARD = ("delta", "assistant", "tool_start", "tool", "edit", "turn_start", "turn_end", "info", "error",
                  "fallback")
_GROUP_END = ("done", "failed", "stopped", "handoff")


def _group_file() -> Path:
    return CONFIG_DIR / "grupy.json"


def _group_runs_dir() -> Path:
    return CONFIG_DIR / "grupy-biegi"


def _group_now() -> str:
    import time
    return time.strftime("%Y-%m-%dT%H:%M:%S")


def _group_load() -> list:
    try:
        data = json.loads(_group_file().read_text(encoding="utf-8"))
    except (OSError, ValueError):
        return []
    items = data.get("grupy") if isinstance(data, dict) else data
    return [g for g in items or [] if isinstance(g, dict) and g.get("id")]


def _group_write(groups: list) -> None:
    f = _group_file()
    f.parent.mkdir(parents=True, exist_ok=True)
    tmp = f.with_suffix(".tmp")
    tmp.write_text(json.dumps({"version": 1, "grupy": groups}, ensure_ascii=False, indent=1), encoding="utf-8")
    os.replace(tmp, f)


def _group_check(g) -> tuple:
    """Grupa po sprawdzeniu i z wartościami domyślnymi albo (None, opis błędu)."""
    import secrets
    if not isinstance(g, dict):
        return None, _L("Grupa musi być obiektem JSON.")
    name = " ".join(str(g.get("name") or "").split())[:60]
    if not name:
        return None, _L("Podaj nazwę grupy.")
    strategy = str(g.get("strategy") or "parallel")
    if strategy not in _GROUP_STRATEGIES:
        return None, _Lf("Nieznany sposób pracy: {0}.", strategy)
    raw = [m for m in g.get("members") or [] if isinstance(m, dict)]
    if not raw:
        return None, _L("Dodaj do grupy co najmniej jednego członka.")
    if len(raw) > _GROUP_MAX_MEMBERS:
        return None, _Lf("Grupa może mieć najwyżej {0} członków.", _GROUP_MAX_MEMBERS)
    members, ids = [], set()
    for i, m in enumerate(raw):
        mname = " ".join(str(m.get("name") or "").split())[:60] or _Lf("Członek {0}", i + 1)
        base = _slug(str(m.get("id") or mname))[:24].strip("-") or f"c{i + 1}"
        mid, n = base, 2
        while mid in ids or mid in ("all", "human", "lead"):
            mid, n = f"{base}-{n}", n + 1
        ids.add(mid)
        members.append({"id": mid, "name": mname, "brain": str(m.get("brain") or ""),
                        "pin": str(m.get("pin") or ""), "role": str(m.get("role") or "")[:300],
                        "persona": str(m.get("persona") or "")[:12000], "agent": str(m.get("agent") or ""),
                        "writes": bool(m.get("writes", False))})
    lead = str(g.get("lead") or "")
    if lead not in ids:
        # Prowadzący po imieniu albo po stałym agencie, inaczej pierwszy członek.
        lead = next((m["id"] for m in members if lead and lead in (m["name"], m["agent"])), members[0]["id"])
    limits = dict(_GROUP_LIMITS)
    for k, v in (g.get("limits") or {}).items():
        if k in limits:
            try:
                limits[k] = max(0, int(v))
            except (TypeError, ValueError):
                pass
    limits["rounds"] = max(1, min(limits["rounds"] or 2, 5))
    limits["member_minutes"] = max(1, min(limits["member_minutes"] or 20, 240))
    files = str(g.get("files") or "read")
    now = _group_now()
    out = {"id": str(g.get("id") or ("g-" + secrets.token_hex(3))), "name": name, "strategy": strategy,
           "lead": lead, "members": members, "files": files if files in ("read", "copies") else "read",
           "limits": limits, "fallback": str(g.get("fallback") or ""),
           "instructions": str(g.get("instructions") or "")[:4000], "favorite": bool(g.get("favorite")),
           "created": str(g.get("created") or now), "updated": now}
    return out, ""


def _group_list() -> list:
    return _group_load()


def _group_get(ident) -> dict | None:
    key = str(ident or "").strip()
    if not key:
        return None
    groups = _group_load()
    low = key.lower()
    return (next((g for g in groups if g["id"] == key), None)
            or next((g for g in groups if str(g.get("name") or "").lower() == low), None)
            or next((g for g in groups if _slug(str(g.get("name") or "")) == _slug(key)), None))


def _group_save(g) -> tuple:
    out, err = _group_check(g)
    if err:
        return None, err
    groups = _group_load()
    old = next((x for x in groups if x["id"] == out["id"]), None)
    if old:
        out["created"] = old.get("created") or out["created"]
        groups[groups.index(old)] = out
    else:
        if any(str(x.get("name") or "").lower() == out["name"].lower() for x in groups):
            return None, _Lf("Grupa «{0}» już jest. Wybierz inną nazwę.", out["name"])
        groups.append(out)
    _group_write(groups)
    return out, ""


def _group_delete(ident) -> bool:
    g = _group_get(ident)
    if not g:
        return False
    _group_write([x for x in _group_load() if x["id"] != g["id"]])
    return True


