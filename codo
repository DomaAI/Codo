# Narzędzia działają tylko pod aplikacją Codo na Maca: proszą okno przez most („bridge”), okno robi
# i odpowiada. Model nie dostaje obrazów, więc stronę i aplikacje widzi jako listę elementów z numerami;
# zrzuty trafiają do rozmowy dla użytkownika.

_APP_ONLY_TOOLS = {"terminal", "przegladarka", "komputer"}


def _app_call(action: str, args: dict | None = None, timeout: float = 60) -> dict:
    """Prośba do okna Codo; odpowiedź albo {"error": ...}."""
    import time as _t
    if _APP["out"] is None:
        return {"error": _L("To narzędzie działa tylko w aplikacji Codo na Maca.")}
    with _APP["lock"]:
        _APP["n"] += 1
        _APP["cancel"] = False
        cid = "b" + str(_APP["n"])
        ev = threading.Event()
        _APP["calls"][cid] = {"event": ev, "value": None}
    _app_emit("bridge", id=cid, action=action, args=args or {})
    koniec = _t.time() + timeout
    try:
        while not ev.wait(0.2):
            if _APP.get("cancel"):
                _app_emit("bridge_cancel", id=cid)
                return {"error": _L("Zatrzymano."), "stopped": True}
            if _APP["out"] is None or _t.time() > koniec:
                return {"error": _L("Okno Codo nie odpowiedziało.")}
        v = _APP["calls"][cid]["value"]
        return v if isinstance(v, dict) else {"error": _L("Okno Codo nie odpowiedziało.")}
    finally:
        _APP["calls"].pop(cid, None)


def _most_tekst(r: dict, limit: int = 24000) -> str:
    if r.get("error"):
        return "BŁĄD: " + str(r["error"])
    if isinstance(r.get("text"), str) and len(r) <= 2:
        tekst = r["text"]
    else:
        tekst = json.dumps(r, ensure_ascii=False, indent=1)
    return tekst if len(tekst) <= limit else tekst[:limit] + "\n… (obcięte)"


