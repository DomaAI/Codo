def _tool_hint(name: str, args: dict) -> str:
    if name == "task":
        tasks = args.get("tasks") if isinstance(args.get("tasks"), list) else []
        kind = "wykonawca" if str(args.get("kind") or "") == "general" else "zwiad"
        names = ", ".join(str((t or {}).get("description") or "")[:40] for t in tasks[:4] if isinstance(t, dict))
        return f"{len(tasks) or 1} × {kind}" + (f": {names}" if names else "")
    if name == "todo_write":
        todos = args.get("todos") if isinstance(args.get("todos"), list) else []
        done = sum(1 for t in todos if isinstance(t, dict) and t.get("status") == "completed")
        return f"{done}/{len(todos)}"
    for key in ("path", "command", "pattern", "url", "query", "q", "template", "goal",
                "language", "name", "app", "wtyczka", "prompt"):
        v = args.get(key)
        if v:
            v = str(v).replace("\n", " ")
            if key == "path":
                v = _short_path(v, 70)
            elif key == "pattern" and args.get("path"):
                v = f"„{v}” w {_short_path(args['path'], 40)}"
            elif key == "command":
                v = "$ " + v
            return v if len(v) <= 90 else v[:87] + "…"
    if name == "file_op":
        return f"{args.get('action', '')} {_short_path(str(args.get('path') or ''), 40)}" + (
            f" → {_short_path(str(args['dest']), 40)}" if args.get("dest") else "")
    if name == "process":
