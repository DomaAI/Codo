CONVO_DIR = CONFIG_DIR / "rozmowy"     # zapisane rozmowy, osobno dla każdego folderu
_CONVO_KEEP = 40                       # tyle ostatnich rozmów na folder
_ATTACH_MAX = 120_000                  # łączny limit treści dołączonej przez @plik
_ATTACH_FILE_MAX = 60_000              # limit jednego pliku
_SUMMARY_HEAD = "Streszczenie wcześniejszej części rozmowy:\n"
_BANG_SHOW = 30                        # tyle ostatnich linii wyniku !polecenia na ekranie


def _convo_folder_dir(folder: Path | None = None) -> Path:
    import hashlib
    key = hashlib.sha256(str((folder or Path.cwd()).resolve()).encode("utf-8", "replace")).hexdigest()[:16]
    return CONVO_DIR / key


def _convo_title(messages: list) -> str:
    for m in messages:
        if m.get("role") == "user" and not str(m.get("content") or "").startswith(_SUMMARY_HEAD):
            text = str(m.get("content") or "")
            if text.startswith("[TRYB CZATU"):
                text = text.split("]", 1)[-1]
            words = _terminal_text(text).split()
            if words:
                return " ".join(words[:10])[:90]
    return "Rozmowa"


def _convo_save(messages: list) -> None:
    """Zapis rozmowy po każdej turze (codo -c i /resume ją wznawiają). Bez prompta
    systemowego: przy wczytaniu budujemy go od nowa z bieżącym kontekstem."""
    import time
    import uuid
    body = [m for m in messages if m.get("role") != "system"]
    if not any(m.get("role") == "user" for m in body):
        return
    if not SESSION.get("convo_id"):
        SESSION["convo_id"] = time.strftime("%Y%m%d-%H%M%S-") + uuid.uuid4().hex[:6]
    folder = _convo_folder_dir()
    data = {"id": SESSION["convo_id"], "cwd": str(Path.cwd().resolve()), "updated": int(time.time()),
            "title": SESSION.get("custom_title") or _convo_title(body),
            "custom_title": SESSION.get("custom_title") or "", "model": SESSION.get("model") or "",
            "maszyna": bool(SESSION.get("maszyna")),
            "lopus_chat_id": SESSION.get("lopus_chat_id") or "",
            "agent_sid": dict(SESSION.get("agent_sid") or {}), "messages": body}
    try:
        folder.mkdir(parents=True, exist_ok=True)
        try:
            os.chmod(CONVO_DIR, 0o700)
        except OSError:
            pass  # nosec B110 — Windows / cudzy katalog
        path = folder / f"{SESSION['convo_id']}.json"
        tmp = path.with_suffix(f".{os.getpid()}.{uuid.uuid4().hex[:6]}.tmp")   # dwa terminale: osobne pliki
        tmp.write_text(json.dumps(data, ensure_ascii=False), encoding="utf-8")
        try:
            os.chmod(tmp, 0o600)
        except OSError:
            pass  # nosec B110
        os.replace(tmp, path)
        old = sorted(folder.glob("*.json"), key=lambda p: p.stat().st_mtime, reverse=True)[_CONVO_KEEP:]
        for p in old:
