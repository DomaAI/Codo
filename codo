def t_agenci(args: dict, most=None, czekaj_max: int = 1200) -> str:
    """Stali agenci w oknie Codo: lista, wiadomość do jednego z nich (z czekaniem, z odpowiedzią później albo
    bez odpowiedzi), przekazanie całego zadania i stan tego, co przekazane. `most` to droga do okna: wprost
    (app-server) albo przez gniazdo (serwer MCP agenta zewnętrznego)."""
    most = most or _app_call
    akcja = str(args.get("akcja") or "lista")
    if akcja == "lista":
        return _most_tekst(most("agenci.lista", {}))
    if akcja == "zadania":
        return _most_tekst(most("agenci.zadania", {}))
    if akcja == "umiejetnosc":
        nazwa, tresc = str(args.get("nazwa") or "").strip(), str(args.get("tresc") or "").strip()
        if tresc and _secret_like(nazwa + " " + str(args.get("kiedy") or "") + " " + tresc):
            return ("BŁĄD: nie zapisano, treść wygląda na hasło, token albo klucz. Opisz, skąd je wziąć, "
                    "a nie same wartości.")
        if len(tresc) > _SKILL_TEXT_MAX:
            return f"BŁĄD: treść jest za długa ({len(tresc)} znaków, limit {_SKILL_TEXT_MAX}). Skróć ją do sedna: kroki i pułapki."
        return _most_tekst(most("agenci.umiejetnosc", {"nazwa": nazwa[:80], "kiedy": str(args.get("kiedy") or "").strip()[:240],
                                                       "tresc": tresc, "usun": bool(args.get("usun"))}))
    if akcja == "szukaj":
        fraza = str(args.get("fraza") or args.get("tekst") or "").strip()
        if not fraza:
            return "BŁĄD: podaj frazę do szukania."
        try:
            ile = max(1, min(int(args.get("ile") or 8), 30))
        except (TypeError, ValueError):
            ile = 8
        return _most_tekst(most("agenci.szukaj", {"fraza": fraza[:300], "ile": ile}, timeout=60))
    if akcja == "profil":
        fakt = str(args.get("fakt") or args.get("tekst") or "").strip()
        if fakt and _secret_like(fakt):
            return "BŁĄD: nie zapisano, to wygląda na hasło, token albo klucz."
        return _most_tekst(most("agenci.profil", {"fakt": fakt[:300]}))
    if akcja not in ("napisz", "przekaz"):
        return "BŁĄD: akcja to lista, napisz, przekaz, zadania, umiejetnosc, szukaj albo profil."
    kto = str(args.get("agent") or "").strip()
    tekst = str(args.get("tekst") or "").strip()
    if not kto or not tekst:
        return "BŁĄD: podaj agent (nazwę) i tekst."
    pliki = args.get("pliki")
    if isinstance(pliki, str):
        pliki = [pliki]
    pliki = [str(p) for p in (pliki or []) if str(p).strip()][:40] if isinstance(pliki, list) else []
    if akcja == "przekaz":
        return _most_tekst(most("agenci.przekaz", {"agent": kto, "tekst": tekst[:8000], "pliki": pliki,
                                                   "tytul": str(args.get("tytul") or "").strip()[:120]},
                                timeout=45))
    tryb = str(args.get("odpowiedz") or "").strip().lower()
    if tryb not in ("teraz", "pozniej", "nie"):
        tryb = "nie" if args.get("czekaj") is False else "teraz"
    czekaj = tryb == "teraz"
    return _most_tekst(most("agenci.napisz", {"agent": kto, "tekst": tekst[:8000], "czekaj": czekaj,
                                              "odpowiedz": tryb, "pliki": pliki, "limit": czekaj_max},
                            timeout=czekaj_max + 60 if czekaj else 45))


