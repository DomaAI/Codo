def _fetch_url_bytes(url: str, limit: int, timeout: int = 6) -> bytes | None:
    try:
        import urllib.request
        req = urllib.request.Request(
            url, headers={"User-Agent": "doma-webstudio-preview"})
        with urllib.request.urlopen(req, timeout=timeout, context=_ssl_ctx()) as resp:  # nosec B310 — zasób własnej strony
            return resp.read(limit)
    except Exception:
        return None


def _inline_assets_url(html: str, page_url: str) -> str:
    """Inline'uje CSS/JS/obrazy z SERWERA (względem page_url), by podgląd
    renderował się poprawnie w izolowanym iframe (blob). Pobiera zasoby
    RÓWNOLEGLE z twardym budżetem czasu — sekwencyjne pobieranie potrafiło
    przekroczyć timeout joba (60 s) i dawać 504."""
    import base64
    import mimetypes
    import concurrent.futures as cf
    from urllib.parse import urljoin

    CSS1 = r'<link\b[^>]*\brel=["\']stylesheet["\'][^>]*\bhref=["\'](?P<h>[^"\']+)["\'][^>]*>'
    CSS2 = r'<link\b[^>]*\bhref=["\'](?P<h>[^"\']+)["\'][^>]*\brel=["\']stylesheet["\'][^>]*>'
    JS = r'<script\b[^>]*\bsrc=["\'](?P<s>[^"\']+)["\'][^>]*>\s*</script>'
    IMG = r'<img\b[^>]*\bsrc=["\'](?P<s>[^"\']+)["\']'

    def _refs(pat, grp):
        return [m.group(grp) for m in re.finditer(pat, html, re.I)]

    css_refs = _refs(CSS1, "h") + _refs(CSS2, "h")
    js_refs = _refs(JS, "s")
    img_refs = _refs(IMG, "s")
    img_set = set(img_refs)

    def _keep(r):
        return r and not r.startswith("data:")

    all_refs = list(dict.fromkeys(
        [r for r in css_refs + js_refs + img_refs if _keep(r)]))[:60]

    # 1) Pobierz wszystkie zasoby RÓWNOLEGLE (budżet 12 s, timeout 4 s/zasób).
    fetched: dict[str, bytes] = {}

    def _one(ref):
        full = urljoin(page_url, ref)
        if not full.startswith(("http://", "https://")):
            return ref, None
        limit = 512 * 1024 if ref in img_set else 1_500_000
        return ref, _fetch_url_bytes(full, limit, timeout=4)

    if all_refs:
        with cf.ThreadPoolExecutor(max_workers=8) as ex:
            futs = {ex.submit(_one, r): r for r in all_refs}
            done, notdone = cf.wait(futs, timeout=12)
            for fut in done:
                try:
                    ref, data = fut.result()
                    if data:
                        fetched[ref] = data
                except Exception:
                    pass  # nosec B110 — pojedynczy zasób best-effort
            for fut in notdone:
                fut.cancel()

    # 2) Podstaw pobrane zasoby (te nieściągnięte zostają jako zewnętrzne linki).
    def css_sub(m):
        href = m.group("h")
        data = fetched.get(href)
        if not data:
            return m.group(0)
        css = data.decode("utf-8", "replace")
        sheet_url = urljoin(page_url, href)
        css = re.sub(r'url\(\s*["\']?(?!data:|https?:|//)([^"\')]+)["\']?\s*\)',
                     lambda u: f'url("{urljoin(sheet_url, u.group(1))}")', css)
        return f"<style>\n{css}\n</style>"

    html = re.sub(CSS1, css_sub, html, flags=re.I)
    html = re.sub(CSS2, css_sub, html, flags=re.I)

    def js_sub(m):
        data = fetched.get(m.group("s"))
        if not data:
            return m.group(0)
        js = data.decode("utf-8", "replace").replace("</script>", "<\\/script>")
        return f"<script>\n{js}\n</script>"

    html = re.sub(JS, js_sub, html, flags=re.I)

    def img_sub(m):
        src = m.group("s")
        data = fetched.get(src)
        if not data:
            return m.group(0)
        mime = mimetypes.guess_type(src.split("?")[0])[0] or "image/png"
        b64 = base64.b64encode(data).decode()
        return m.group(0).replace(src, f"data:{mime};base64,{b64}")

    html = re.sub(IMG, img_sub, html, flags=re.I)
    return html


def t_fetch_page(args):
    """Pobiera wyrenderowaną stronę spod URL (serwer robi to lokalnie) i inline'uje
    zasoby (CSS/JS/obrazy) — do podglądu w panelu, gdy plik to szablon serwerowy.
    Zwraca samodzielny HTML, który renderuje się poprawnie w izolowanym iframe."""
    url = (args.get("url") or "").strip()
    if not url.startswith(("http://", "https://")):
        return "BŁĄD: podaj adres http(s) swojej strony."
    raw = _fetch_url_bytes(url, 4_000_000, timeout=15)
    if raw is None:
        return "BŁĄD pobierania: serwer nie odpowiedział (sprawdź adres/HTTPS)."
    html = raw.decode("utf-8", "replace")
    # inline domyślnie ON; pomiń tylko na wyraźne żądanie (args.inline == False).
    if args.get("inline", True):
        try:
            html = _inline_assets_url(html, url)
        except Exception as e:  # inline best-effort — surowy HTML lepszy niż błąd
            print(dim(_Lf('  (inline pominięty: {0})', e)))
    if len(html) > 600000:
        html = html[:600000] + "\n<!-- … (obcięte) -->"
    return html


