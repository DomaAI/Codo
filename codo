def _trust_facts(folder: Path) -> tuple[list[str], list[str]]:
    """Krótki opis folderu pod ścieżką (git, liczba plików, Codo.md) i ostrzeżenia:
    katalog domowy, własne komendy projektu, podejrzanie dużo plików. Szybko: najwyżej
    ~2000 wpisów, bez uruchamiania gita."""
    facts: list[str] = []
    warnings: list[str] = []
    home = Path.home().resolve()
    branch = _git_branch()
    if branch:
        facts.append(f"git {branch}")
    count, capped = 0, False
    skip = {".git", "node_modules", ".venv", "venv", "__pycache__", ".build", "build", "dist", "DerivedData"}
    try:
        stack = [folder]
        while stack and not capped:
            with os.scandir(stack.pop()) as entries:
                for entry in entries:
                    if entry.name in skip:
                        continue
                    if entry.is_dir(follow_symlinks=False):
                        if not entry.name.startswith(".") or entry.name in (".codo", ".doma"):
                            stack.append(Path(entry.path))
                    else:
                        count += 1
                    if count >= 2000:
                        capped = True
                        break
    except OSError:
        pass
    if count:
        facts.append((_L("ponad 2000 plików") if capped else f"{count} {_plural(count, ('plik', 'pliki', 'plików'))}"))
    for memo in ("Codo.md", "DOMAAI.md"):
        if (folder / memo).is_file():
            facts.append(memo)
            break
    if folder == home:
        warnings.append(_L("To katalog domowy: zgoda obejmie wszystkie Twoje pliki i nie zostanie zapamiętana. "
                        "Lepiej uruchomić Codo w folderze projektu."))
    elif folder == Path(folder.anchor):
        warnings.append(_L("To katalog główny dysku: zgoda obejmie cały system plików."))
    commands = folder / ".codo" / "commands"
    try:
        own = sorted(c.name for c in commands.glob("*.md"))[:3] if commands.is_dir() else []
    except OSError:
        own = []
    if own:
        warnings.append(_L("Folder ma własne komendy (.codo/commands: ") + ", ".join(own)
                        + _L("). To polecenia dla agenta, przejrzyj je przed użyciem."))
    return facts, warnings


def _choose_trust(lines_above: int) -> bool:
    """Wybór „Nie, wyjdź” / „Tak, ufam temu folderowi” (domyślnie Tak), strzałki,
    Enter, Esc. Bez TTY: zwykłe pytanie t/N."""
    if not sys.stdin or not sys.stdin.isatty():
        # Wejście z potoku albo bez terminala (CI, nohup): nie czytamy zgody ze stdin, bo pierwsza linia
        # to zadanie (do 0.28.0 `echo "popraw X" | codo` kończyło się „Uruchomienie anulowane”).
        print(red(_L("✗ Ten folder nie jest jeszcze zaufany.")) + dim(
            _L(" Uruchom raz `codo` tutaj w terminalu i zgódź się na dostęp, potem działa też z potoku.")),
            file=sys.stderr)
        return False
    if not _tty() or IS_WIN or os.environ.get("TERM") == "dumb":
        try:
            return input(_L("  Ufasz temu folderowi? [t/N] ")).strip().lower() in ("t", "tak", "y", "yes", "1")
        except EOFError:
            return False
    import termios
    import tty
    options = (_L("Nie, wyjdź"), _L("Tak, ufam temu folderowi"))
    selected = 1
    fd = sys.stdin.fileno()
    old = termios.tcgetattr(fd)
    drawn = False
    try:
        tty.setcbreak(fd)
        sys.stdout.write("\033[?25l")
        while True:
            if drawn:
                sys.stdout.write(f"\033[{len(options) + 2}A")
            for i, label in enumerate(options):
                if i == selected:
                    row = violet("❯ ") + _c("1;38;5;141", label)
                else:
                    row = "  " + label
                sys.stdout.write("\r\033[2K  " + row + "\n")
            sys.stdout.write("\r\033[2K\n\r\033[2K  " + dim(_L("Enter potwierdza · ↑↓ wybór · Esc anuluje")) + "\n")
            sys.stdout.flush()
            drawn = True
            ch = _read_terminal_key(fd)
            if ch in ("\r", "\n"):
                return selected == 1
            if ch in ("1", "2"):
                return ch == "2"
            if ch.lower() in ("t", "y"):
                return True
            if ch.lower() == "n" or ch in ("\x1b", "\x03", "\x04", ""):
                return False
            if ch in ("\x1b[A", "\x1b[B", "\x1b[C", "\x1b[D", "\t", "k", "j"):
                selected = 1 - selected
    finally:
        termios.tcsetattr(fd, termios.TCSADRAIN, old)
        total = lines_above + (len(options) + 2 if drawn else 0)
        # cały ekran zgody znika, start zostaje czysty
        sys.stdout.write("\033[?25h" + (f"\033[{total}A\r\033[J" if total else ""))
        sys.stdout.flush()


def trust_workspace() -> bool:
    """Zgoda na pracę w folderze: pytamy raz na folder (zapamiętane w settings
    trusted_folders), katalog domowy pytamy przy każdym starcie."""
    import shutil
    import textwrap
    here_path = Path.cwd().resolve()
    here = str(here_path)
    home = str(Path.home().resolve())
    trusted = load_settings().get("trusted_folders")
    trusted = trusted if isinstance(trusted, list) else []
    if here in trusted and here != home:
        return True
    columns = shutil.get_terminal_size((80, 24)).columns
    width = max(20, columns - 4)
    folder = here
    if folder == home or folder.startswith(home + os.sep):
        folder = "~" + folder[len(home):]
    if len(folder) > width:
        folder = "…" + folder[-(width - 1):]
    facts, warnings = _trust_facts(here_path)
    out: list[str] = [""]
    if _tty():
        out.append(" " + violet("─" * max(10, columns - 2)))
    out.append("  " + _c("1;38;5;141", _L("Dostęp do folderu:")))
    out.append("")
    out.append("  " + bold(folder))
    if facts:
        out.append("  " + dim(" · ".join(facts)))
    out.append("")
    intro = (_Lf('Szybka kontrola bezpieczeństwa: czy to Twój projekt albo taki, któremu ufasz? (Twój kod, znany projekt open source, praca Twojego zespołu.) Jeśli nie, najpierw przejrzyj zawartość folderu.', ))
    out += ["  " + line for line in textwrap.wrap(intro, width)]
    out.append("")
    out += ["  " + line for line in textwrap.wrap(
        _Lf('{0} będzie mógł czytać, edytować i uruchamiać pliki w tym folderze.', APP_NAME), width)]
    for warn in warnings:
        out.append("")
        wrapped = textwrap.wrap(warn, max(10, width - 2))
        out.append("  " + yellow("▲ ") + yellow(wrapped[0]))
        out += ["    " + yellow(line) for line in wrapped[1:]]
    out.append("")
    print("\n".join(out))
    if not _choose_trust(len(out)):
        print(dim(_L("  Uruchomienie anulowane.")))
        return False
    if here != home:
        # zgoda zapamiętana dla tego folderu (katalog domowy pytamy zawsze: tam łatwo o przypadek)
        settings = load_settings()
        trusted = [t for t in (settings.get("trusted_folders") or []) if isinstance(t, str)]
        if here not in trusted:
            settings["trusted_folders"] = (trusted + [here])[-200:]
            save_settings(settings)
    return True


# ── Gospodarz stałych agentów: codo host (21.11.2026) ────────────────────────
# Stali agenci z okna Codo działają tu bez Maca: na własnym serwerze, na Serwerze MADD albo na dowolnym
# komputerze z Pythonem. Każdy agent to proces `codo app-server` w swoim folderze (ta sama rozmowa, te same
# narzędzia i ten sam mózg co w oknie). Gospodarz prowadzi kolejki, regularne sprawdzanie, pocztę między
# agentami i Telegram, a okno Codo łączy się z nim po SSH (`codo host attach`).
#
# Pliki w ~/.config/doma/host: agents.json (definicje z okna), mail.json (poczta agentów), telegram.json
# (token i czat albo {"mode": "shared"} dla wspólnego bota; jego kursor skrzynki w telegram-kursor.json), rozmowy/<id>.jsonl (zapis rozmowy do pokazania w oknie), biurka/<id>/ (foldery agentów),
# wydatki.json (dzisiejsza praca w tle agentów, do dziennego limitu), cisza.json (zgłoszenia wstrzymane w godzinach ciszy).

HOST_DIR = CONFIG_DIR / "host"
_HOST_NOTE = "\n\n[Codo]\n"
_HOST_MAX_DEPTH, _HOST_MAX_OWNERS, _HOST_HOURLY = 6, 5, 60
_HOST_RETRY_AFTER = (8, 25, 60)
_HOST_MAX_FILES, _HOST_MAX_BYTES = 40, 200 * 1024 * 1024
_HOST_QUIET = ("CISZA", "QUIET", "SILENT", "NIC NOWEGO", "NOTHING NEW")


def _host_plain(text: str) -> str:
    """Markdown na zwykły tekst czatu."""
    t = re.sub(r"```[a-zA-Z]*\n?", "", str(text or ""))
    t = re.sub(r"\*\*(.+?)\*\*", r"\1", t)
    t = re.sub(r"(?m)^#{1,6}\s*", "", t)
    return t.replace("`", "").strip()


def _host_quiet(answer: str) -> bool:
    t = re.sub(r"^[^0-9A-Za-zĄĆĘŁŃÓŚŹŻąćęłńóśźż]+|[^0-9A-Za-zĄĆĘŁŃÓŚŹŻąćęłńóśźż]+$", "", (answer or "").upper())
    return not t or t in _HOST_QUIET or t.startswith("CISZA")


def _host_key() -> str:
    import random
    return "".join(random.choice("abcdefghjkmnpqrstuvwxyz23456789") for _ in range(5))  # nosec B311 — etykieta, nie sekret


def _host_headline(text: str) -> str:
    first = next((ln.strip() for ln in str(text).splitlines() if ln.strip()), str(text).strip())
    return first if len(first) <= 90 else first[:88] + "…"


def _host_sock_path() -> str:
    """Gniazdo sterujące; długi folder ustawień dostaje je w tmp (limit ścieżki gniazda uniksowego)."""
    p = str(HOST_DIR / "host.sock")
    if len(p.encode()) > 100:
        import hashlib
        import tempfile
        tag = hashlib.sha256(str(HOST_DIR).encode()).hexdigest()[:12]
        p = os.path.join(tempfile.gettempdir(), f"codo-host-{tag}.sock")
        if len(p.encode()) > 100:
            p = f"/tmp/codo-host-{tag}.sock"   # nosec B108 — gniazdo 0600 właściciela
    return p


def _host_load(name: str, default):
    try:
        return json.loads((HOST_DIR / name).read_text(encoding="utf-8"))
    except (OSError, ValueError):
        return default


def _host_save(name: str, data) -> None:
    HOST_DIR.mkdir(parents=True, exist_ok=True)
    try:
        os.chmod(HOST_DIR, 0o700)
    except OSError:
        pass
    tmp = HOST_DIR / (name + ".tmp")
    tmp.write_text(json.dumps(data, ensure_ascii=False, indent=1), encoding="utf-8")
    os.chmod(tmp, 0o600)
    os.replace(tmp, HOST_DIR / name)


class HostEngine:
    """Silnik jednego agenta: `codo app-server` w jego folderze; zdarzenia idą do kolejki gospodarza."""

    def __init__(self, agent: dict, desk: Path, events_q):
        self.a, self.desk, self.q = agent, Path(desk), events_q
        self.proc = None
        self.ready = False
        self.busy = False
        self.answer = ""
        self.ask_id = None
        self.idle_since = 0.0

    def mode(self) -> str:
        return "read" if not self.a.get("writes") else ("auto" if self.a.get("auto") else "ask")

    def spawn(self) -> None:
        env = dict(os.environ)
        for k in ("CODO_NO_HISTORY", "CODO_PROVIDER", "CODO_UI_DEV", "CODO_ZESPOL_DIR", "CODO_ZESPOL_CZLONEK"):
            env.pop(k, None)
        env.update({"CODO_APP_MODE": self.mode(), "CODO_APP_AGENT": "1", "CODO_APP_LOCAL_ONLY": "1",
                    "DOMA_NO_SYNC": "1", "CODO_CLIENT": "host", "PYTHONUNBUFFERED": "1", "NO_COLOR": "1"})
        env.update(_host_secrets())
        model = str(self.a.get("model") or "")
        pin = _team_brain_provider(model) if model else ""
        if pin:
            env["CODO_PROVIDER"] = pin
        cmd = [*_self_cmd(_team_script())] + (["--model", model] if model else []) + ["app-server"]
        self.desk.mkdir(parents=True, exist_ok=True)
        (HOST_DIR / "log").mkdir(parents=True, exist_ok=True)
        kw = {"cwd": str(self.desk), "env": env, "stdin": subprocess.PIPE, "stdout": subprocess.PIPE}
        if IS_WIN:
            kw["creationflags"] = 0x00000200
        else:
            kw["start_new_session"] = True
        with open(HOST_DIR / "log" / f"{self.a['id']}.err", "ab") as err:
            self.proc = subprocess.Popen(cmd, stderr=err, **kw)  # nosec B603 — własny program
        threading.Thread(target=self._read, daemon=True).start()

    def _read(self) -> None:
        proc, aid = self.proc, self.a["id"]
        for raw in proc.stdout:
            try:
                ev = json.loads(raw.decode("utf-8", "replace"))
            except ValueError:
                continue
            if isinstance(ev, dict):
                self.q.put(("engine", aid, self, ev))
        self.q.put(("engine", aid, self, {"type": "_exit", "code": proc.wait()}))

    last_error = ""
    credits_seen = 0.0     # licznik kredytów z ostatniego turn_end tego procesu (koszt tury = różnica)

    def send(self, obj: dict) -> bool:
        if obj.get("type") == "send":
            self.last_error = ""
        try:
            self.proc.stdin.write((json.dumps(obj, ensure_ascii=False) + "\n").encode("utf-8"))
            self.proc.stdin.flush()
            return True
        except (OSError, ValueError, AttributeError):
            return False

    def alive(self) -> bool:
        return self.proc is not None and self.proc.poll() is None

    def stop(self, wait: float = 5) -> None:
        if not self.proc:
            return
        self.send({"type": "quit"})
        try:
            self.proc.stdin.close()
        except (OSError, ValueError):
            pass
        try:
            self.proc.wait(timeout=wait)
        except subprocess.TimeoutExpired:
            _kill_tree(self.proc)


class _HostWS:
    """Najprostszy klient WebSocket (RFC 6455) na samej bibliotece standardowej: tekst, ping/pong, zamknięcie.
    Wystarcza na bramę Discorda i Socket Mode Slacka; gospodarz nie ciągnie przez to żadnych zależności."""

    def __init__(self, url: str, timeout: float = 30):
        import base64
        import socket
        import ssl
        u = urllib.parse.urlsplit(url)
        secure = u.scheme == "wss"
        port = u.port or (443 if secure else 80)
        raw = socket.create_connection((u.hostname, port), timeout=timeout)
        self.s = ssl.create_default_context().wrap_socket(raw, server_hostname=u.hostname) if secure else raw
        key = base64.b64encode(os.urandom(16)).decode()
        path = (u.path or "/") + ("?" + u.query if u.query else "")
        host = u.hostname + ("" if u.port is None else f":{u.port}")
        self.s.sendall((f"GET {path} HTTP/1.1\r\nHost: {host}\r\nUpgrade: websocket\r\nConnection: Upgrade\r\n"
                        f"Sec-WebSocket-Key: {key}\r\nSec-WebSocket-Version: 13\r\nUser-Agent: codo-host\r\n\r\n").encode())
        head = b""
        while b"\r\n\r\n" not in head:
            chunk = self.s.recv(4096)
            if not chunk:
                raise OSError("websocket: połączenie zamknięte przy powitaniu")
            head += chunk
        head, self.buf = head.split(b"\r\n\r\n", 1)
        if b" 101 " not in head.split(b"\r\n", 1)[0]:
            raise OSError("websocket: " + head.split(b"\r\n", 1)[0].decode("latin-1"))
        self.lock = threading.Lock()
        self.closed = False

    def _read(self, n: int) -> bytes:
        while len(self.buf) < n:
            chunk = self.s.recv(65536)
            if not chunk:
                raise OSError("websocket: połączenie zamknięte")
            self.buf += chunk
        out, self.buf = self.buf[:n], self.buf[n:]
        return out

    def _frame(self, op: int, data: bytes) -> None:
        import struct
        head = bytes([0x80 | op])
        n = len(data)
        if n < 126:
            head += bytes([0x80 | n])
        elif n < 65536:
            head += bytes([0x80 | 126]) + struct.pack(">H", n)
        else:
            head += bytes([0x80 | 127]) + struct.pack(">Q", n)
        mask = os.urandom(4)
        body = bytes(b ^ mask[i % 4] for i, b in enumerate(data))
        with self.lock:
            self.s.sendall(head + mask + body)

    def send(self, text: str) -> None:
        self._frame(0x1, text.encode("utf-8"))

    def recv(self, timeout: float | None = None) -> str | None:
        """Następna wiadomość tekstowa; None = druga strona zamknęła połączenie. Ping dostaje pong."""
        import struct
        self.s.settimeout(timeout)
        parts: list = []
        while True:
            b1, b2 = self._read(2)
            op, n = b1 & 0x0F, b2 & 0x7F
            if n == 126:
                n = struct.unpack(">H", self._read(2))[0]
            elif n == 127:
                n = struct.unpack(">Q", self._read(8))[0]
            mask = self._read(4) if b2 & 0x80 else b""
            data = self._read(n)
            if mask:
                data = bytes(b ^ mask[i % 4] for i, b in enumerate(data))
            if op == 0x8:
                self.close()
                return None
            if op == 0x9:
                self._frame(0xA, data)
                continue
            if op == 0xA:
                continue
            parts.append(data)
            if b1 & 0x80:
                return b"".join(parts).decode("utf-8", "replace")

    def close(self) -> None:
        if self.closed:
            return
        self.closed = True
        try:
            self._frame(0x8, b"\x03\xe8")
        except OSError:
            pass
        try:
            self.s.close()
        except OSError:
            pass


