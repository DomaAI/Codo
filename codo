# Token urządzenia żyje 3 min — cache do ~150 s, potem mint nowego.
_DEV_TOK = {"token": None, "ts": 0.0, "identity": None}
_DEV_TOKEN_LOCK = threading.RLock()


def device_access_token(force: bool = False) -> str | None:
    with _DEV_TOKEN_LOCK:
        return _device_access_token(force)


def _device_access_token(force: bool = False) -> str | None:
    """Krótki JWT z sekretu urządzenia. None gdy maszyna niesparowana.
    Kończy proces z czytelnym komunikatem, gdy urządzenie odparowano."""
    import time as _time
    dev = load_device()
    if not dev:
        return None
    now = _time.monotonic()
    identity = (API_URL, dev["device_id"], dev["device_secret"])
    if not force and _DEV_TOK.get("identity") == identity and _DEV_TOK["token"] and now - _DEV_TOK["ts"] < 150:
        return _DEV_TOK["token"]
    try:
        data = _http("POST", "/cli/pair/token", json_body={
            "device_id": dev["device_id"], "device_secret": dev["device_secret"],
        })
    except ApiError as e:
        if e.status == 401:
            print(red(_L("✗ To urządzenie zostało odparowane od konta.")))
            print(dim(_L("  Sparuj ponownie: codo pair  (kod wygenerujesz w DomaAI Web → Codo)")))
            # A parallel login may already have replaced this device.
            if load_device() == dev:
                DEVICE_FILE.unlink(missing_ok=True)
            _DEV_TOK.update(token=None, ts=0.0, identity=None)
            raise SystemExit(1)
        raise
    _DEV_TOK["token"] = data["access_token"]
    _DEV_TOK["ts"] = now
    _DEV_TOK["identity"] = identity
    return _DEV_TOK["token"]


def logout() -> int:
    """Revoke the device on the server as well as removing local credentials."""
    dev = load_device()
    creds = load_creds()
    try:
        if dev:
            tok = _http("POST", "/cli/pair/token", json_body={
                "device_id": dev["device_id"], "device_secret": dev["device_secret"],
            }, timeout=15, retries=0)
            _http("POST", "/cli/device/logout", token=tok["access_token"], timeout=15, retries=0)
        elif creds:
            _http("POST", "/logout", token=creds["access_token"], timeout=15, retries=0)
    except Exception as exc:
        if not isinstance(exc, ApiError) or exc.status != 401:
            print(yellow(_L("⚠ Nie potwierdzono odparowania na serwerze. Usuń urządzenie także w DomaAI Web → Codo.")))
    finally:
        CRED_FILE.unlink(missing_ok=True)
        DEVICE_FILE.unlink(missing_ok=True)
        AGENT_FILE.unlink(missing_ok=True)
        ACCOUNT_FILE.unlink(missing_ok=True)
        _DEV_TOK.update(token=None, ts=0.0, identity=None)
    print(green(_L("✓ Wylogowano z tego urządzenia.")))
    return 0


