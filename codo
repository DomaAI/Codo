def _read_input() -> str:
    """Jedna wiadomość: linie kończone \\ łączą się, blok \"\"\" … \"\"\" = wiele linii."""
    if LIVE.available() and LIVE.keyboard():
        return LIVE.prompt().strip()
    first = input(_prompt())
    if first.strip() == '"""':
        lines = []
        while True:
            ln = input(dim("… "))
            if ln.strip() == '"""':
                break
            lines.append(ln)
        return "\n".join(lines).strip()
    lines = [first]
    while lines[-1].endswith("\\"):
        lines[-1] = lines[-1][:-1]
        lines.append(input(dim("… ")))
    return "\n".join(lines).strip()


def _undo_stash(path: Path) -> None:
    """Stan sprzed cofnięcia: obok kopii, pod nazwą, której restore i /undo nie biorą za kopię zmiany
    (do 0.30 kopia robiona przy cofaniu stawała się „ostatnią kopią” i drugie /undo przywracało cofniętą zmianę)."""
    import shutil
    import time as _time
    if not path.is_file():
        return
    rel = _backup_rel(path)
    d = Path.cwd() / _BACKUP_DIR / rel.parent
    d.mkdir(parents=True, exist_ok=True)
    _doma_ignored()
    dst = d / f"{rel.name}.{_time.strftime('%Y%m%d-%H%M%S')}.przed-cofnieciem"
    i = 1
    while dst.exists():
        dst = d / f"{rel.name}.{_time.strftime('%Y%m%d-%H%M%S')}-{i}.przed-cofnieciem"
        i += 1
    shutil.copy2(_long_path(path), _long_path(dst))


def _undo_edit(entry: dict) -> str:
    path = entry["path"]
    rel = _rel_shown(path)
    if entry.get("new_file"):
        if path.exists():
            _undo_stash(path)
            path.unlink()
            return _Lf('Usunięto nowy plik {0}', rel) + _L(" (kopia w .doma/backups)")
        return _Lf('Plik {0} już nie istnieje', rel)
    try:
        _, baks = _backups_for(path)
    except ValueError:
        baks = []
    if not baks:
        raise ValueError(_Lf('Brak kopii zapasowej dla {0}; nie da się cofnąć tej zmiany.', rel))
    src = baks[-1]
    data = src.read_bytes()
    _undo_stash(path)
    _atomic_write(path, data)
    try:
        os.replace(src, src.with_name(src.name[:-4] + ".cofnieta"))   # zużyta: następne /undo sięga głębiej
    except OSError:
        pass  # nosec B110
    return _Lf('Przywrócono {0} z kopii {1}', rel, src.name)


def _undo_file_op(op: dict) -> str:
    import shutil
    act, src, dest = op["action"], op["src"], op.get("dest")
    if act == "mkdir":
        try:
            src.rmdir()
            return _Lf('Usunięto pusty katalog {0}', _rel_shown(src))
        except OSError:
            raise ValueError(_Lf('Katalog {0} nie jest pusty; nie usuwam go przy cofaniu.', _rel_shown(src))) from None
    if act == "delete":
        if src.exists() or os.path.lexists(src):
            raise ValueError(_Lf('{0} znowu istnieje; usunięta wersja czeka w {1}', _rel_shown(src), _rel_shown(dest)))
        src.parent.mkdir(parents=True, exist_ok=True)
        shutil.move(str(dest), str(src))
        return _Lf('Przywrócono usunięty {0}', _rel_shown(src))
    if not (dest.exists() or os.path.lexists(dest)):
        raise ValueError(_Lf('{0} już nie istnieje; nie ma czego cofać.', _rel_shown(dest)))
    if act == "move":
        if src.exists():
            raise ValueError(_Lf('{0} znowu istnieje; nie nadpisuję go przy cofaniu.', _rel_shown(src)))
        src.parent.mkdir(parents=True, exist_ok=True)
        shutil.move(str(dest), str(src))
        msg = _Lf('Przeniesiono z powrotem {0} → {1}', _rel_shown(dest), _rel_shown(src))
    else:
        import time as _time
        trash = Path.cwd() / _DOMA_DIR / "trash" / (_time.strftime("%Y%m%d-%H%M%S") + "-cofniete")
        trash.mkdir(parents=True, exist_ok=True)
        _doma_ignored()
        shutil.move(str(dest), str(trash / dest.name))
        msg = _Lf('Usunięto kopię {0}', _rel_shown(dest)) + _L(" (kopia w .doma/trash)")
    if op.get("overwrote"):
        _, baks = _backups_for(dest)
        if baks:
            _atomic_write(dest, baks[-1].read_bytes())
            os.replace(baks[-1], baks[-1].with_name(baks[-1].name[:-4] + ".cofnieta"))
            msg += _Lf('; przywrócono nadpisany {0}', _rel_shown(dest))
    return msg


def _undo_last() -> None:
    """Cofa OSTATNIĄ zmianę agenta (edycję, nowy plik, przeniesienie, kopię, usunięcie), kolejne /undo
    sięgają głębiej, także przy wielu edycjach tego samego pliku. Do 0.30 /undo cofało tylko ostatnią
    edycję każdego pliku, a drugie /undo na tym samym pliku przywracało cofniętą zmianę."""
    edited = list(SESSION.get("edited") or [])
    cands = [e for e in EDIT_LOG if not e.get("undone") and e.get("path") in edited] + \
            [o for o in _FILE_OP_LOG if not o.get("undone")]
    if not cands:
        if not edited:
            print(dim(_L("  Nic do cofnięcia w tej sesji.")))
            return
        path = SESSION["edited"].pop()   # dziennik przepełniony: jak dawniej, ostatnia kopia pliku
        try:
            print(green("  ✓ " + _undo_edit({"path": path, "new_file": not _backups_for(path)[1]})))
        except (ValueError, OSError) as e:
            print(yellow("  " + str(e)))
        return
    item = max(cands, key=lambda e: e["seq"])
    try:
        msg = _undo_file_op(item) if "action" in item else _undo_edit(item)
    except (ValueError, OSError) as e:
        item["undone"] = True   # nie blokuje cofania wcześniejszych zmian
        print(yellow("  " + str(e)))
        return
    item["undone"] = True
    if "action" not in item:
        path = item["path"]
        if not any(e.get("path") == path and not e.get("undone") for e in EDIT_LOG) and path in SESSION["edited"]:
            SESSION["edited"].remove(path)
    print(green("  ✓ " + msg))


