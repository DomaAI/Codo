            _launch_detached([path])
    except OSError as e:
        return f"BŁĄD uruchamiania {path}: {e}"
    extra = (" (uruchomiony bez mostka sterowania — nie znalazłem binarki "
             "blender.exe, app_use nie zadziała)"
             if "blender" in name.lower() else "")
    return f"OK: uruchomiono {Path(path).name} ({path}){extra}"


def t_app_use(args, auto_yes=False):
    """Steruj URUCHOMIONĄ aplikacją. Obsługiwane: app=blender — code (python
    z bpy) wykonuje się w otwartym Blenderze usera (żywy viewport)."""
    import socket as _sock
    app = (args.get("app") or "").strip().lower()
    code_src = args.get("code") or ""
    if app != "blender":
        return ("BŁĄD: app_use obsługuje na razie app=blender. Inne aplikacje: "
                "uruchom przez open_app, a operacje rób ich CLI/API przez "
                "run_command (np. ffmpeg, git, soffice --convert-to).")
    if not code_src.strip():
        return "BŁĄD: puste pole code (python z bpy)."
    _bport, _btoken = _blender_bridge_meta()
    if not _bport:
        return ("BŁĄD: brak aktywnego mostu Blendera. Uruchom Blendera akcją "
                "open_app (name=blender) — dopiero wtedy powstaje most z tokenem.")
    _note("Blender", f"{dim(code_src.splitlines()[0][:100])}")
    if not auto_yes:
        if not confirm_action(_L("Wykonać w Blenderze?"), code_src, ["blender", code_src]):
            return "ODRZUCONE przez użytkownika."
    try:
        c = _sock.create_connection(("127.0.0.1", _bport), timeout=5)
    except OSError:
        return ("BŁĄD: brak połączenia z Blenderem — most nie działa. "
                "Uruchom Blendera akcją open_app (name=blender), odczekaj "
                "kilka sekund i ponów. (Blender otwarty ręcznie przez usera "
                "NIE ma mostka — trzeba go uruchomić przez open_app.)")
    try:
        c.settimeout(60)
        # Protokół: pierwsza linia = token (sekret z pliku 0600), reszta = kod.
        c.sendall((_btoken + "\n" + code_src).encode("utf-8"))
        c.shutdown(_sock.SHUT_WR)
        chunks = []
        while True:
            b = c.recv(65536)
            if not b:
                break
            chunks.append(b)
        reply = b"".join(chunks).decode("utf-8", "replace")
    except _sock.timeout:
        return "BŁĄD: Blender nie odpowiedział w 60s (ciężka operacja?)."
    finally:
        try:
            c.close()
        except OSError:
            pass
    if reply.startswith("ERROR\n"):
        return f"BŁĄD w Blenderze:\n{reply[6:][:6000]}"
    out = reply[3:].strip() if reply.startswith("OK\n") else reply.strip()
    return f"OK (wykonane w Blenderze)\n{out[:6000]}" if out else \
        "OK (wykonane w Blenderze, bez wyjścia)"


def _detect_pm():
    """Wykryj menedżer zależności po plikach projektu."""
    cwd = Path.cwd()
    if (cwd / "requirements.txt").exists() or (cwd / "pyproject.toml").exists():
        return "pip"
    if (cwd / "package.json").exists():
        return "npm"
    return None


def t_install(args, auto_yes=False):
    """Instaluje zależności — pip (w .venv, omija PEP 668) lub npm. Za zgodą
    użytkownika. packages: lista paczek; brak = z requirements.txt/package.json."""
    manager = (args.get("manager") or _detect_pm() or "").lower()
    packages = args.get("packages") or []
    if isinstance(packages, str):
        packages = [packages]
    if manager not in ("pip", "npm"):
        return ("BŁĄD: nie wykryto menedżera zależności (brak requirements.txt / "
                "package.json). Podaj manager=pip|npm albo utwórz plik zależności.")
    if manager == "pip":
        desc = ("pip install " + (" ".join(packages) if packages else "-r requirements.txt")
                + " (w .venv)")
    else:
        desc = "npm install" + (" " + " ".join(packages) if packages else "")
    _note("Instalacja", f"{bold(desc)}")
    if not auto_yes:
        if not confirm_action(_L("Czy zainstalować zależności?"), desc, ["install", manager, packages], reason=args.get("reason") or _L("Pobranie pakietów potrzebnych do uruchomienia projektu.")):
            return "ODRZUCONE przez użytkownika — nie instaluję."
    if manager == "pip":
        venv = Path.cwd() / ".venv"
        if not venv.exists():
            v = subprocess.run([_python_cmd(), "-m", "venv", ".venv"],
                               capture_output=True, text=True)
            if v.returncode != 0:
                return f"BŁĄD tworzenia .venv:\n{(v.stderr or v.stdout)[:2000]}"
        # Windows: pip.exe w Scripts\; POSIX: bin/pip. Gdy brak pliku pip,
        # użyj `python -m pip` (zawsze działa w świeżym venvie).
        bindir = _venv_bindir(venv)
        pip_exe = bindir / ("pip.exe" if IS_WIN else "pip")
        py_exe = bindir / ("python.exe" if IS_WIN else "python")
        if pip_exe.exists():
            base = [str(pip_exe)]
        else:
            base = [str(py_exe) if py_exe.exists() else _python_cmd(), "-m", "pip"]
        cmd = [*base, "install", *(packages or ["-r", "requirements.txt"])]
    else:
        cmd = ["npm", "install", *packages]
    try:
        r = subprocess.run(cmd, capture_output=True, text=True, timeout=600,
                           cwd=str(Path.cwd()))
    except FileNotFoundError:
        return f"BŁĄD: brak narzędzia {cmd[0]} na serwerze."
    except subprocess.TimeoutExpired:
        return "BŁĄD: instalacja przekroczyła 600s."
    out = ((r.stdout or "") + (r.stderr or "")).strip()
    tail = out[-3000:]
    if r.returncode != 0:
        return f"install {desc} → BŁĄD (kod {r.returncode}):\n{tail}"
    hint = ("\nGotowe. Uruchom aplikację przez run_app "
            "(np. command='.venv/bin/python app.py', port=5000)."
            if manager == "pip" else "\nGotowe (npm).")
    return f"install {desc} → OK\n{tail}{hint}"


_RUN_APP: dict = {}   # folder → Popen aplikacji z run_app (poll widzi, że padła)


def t_run_app(args, auto_yes=False):
    """Uruchamia/zatrzymuje aplikację w TLE (dynamiczny serwer, np. Flask/Node) i
    zwraca URL. app_action: start (domyślnie) | stop | status | logs.
    command: polecenie startu; port: na jakim porcie nasłuchuje aplikacja."""
    import socket as _sock
    import time as _time
    act = (args.get("app_action") or "start").lower()
    port = int(args.get("port") or 5000)
    pidfile = Path.cwd() / _DOMA_DIR / "app.pid"
    logfile = Path.cwd() / _DOMA_DIR / "app.log"
    pidfile.parent.mkdir(parents=True, exist_ok=True)

    def _alive():
        proc = _RUN_APP.get(str(Path.cwd()))
        if proc is not None:
            return proc.poll() is None   # własne dziecko: poll odróżnia działający proces od zombie
        try:
            return _pid_alive(int(pidfile.read_text()))
        except Exception:
            return False

    ip = "127.0.0.1"
    try:
        s = _sock.socket(_sock.AF_INET, _sock.SOCK_DGRAM)
        s.connect(("8.8.8.8", 80)); ip = s.getsockname()[0]; s.close()
    except Exception:
        pass

    if act == "stop":
        if pidfile.exists() and _alive():
            try:
                pid = int(pidfile.read_text())
                if IS_WIN:
                    _pid_terminate(pid)
                else:
                    import signal
                    # cała grupa procesów: `cd x && npm run dev` zostawiało do 0.28.0 serwer na porcie
                    try:
                        os.killpg(pid, signal.SIGTERM)
                    except OSError:
                        _pid_terminate(pid)
            except Exception:
                pass  # nosec B110
        proc = _RUN_APP.pop(str(Path.cwd()), None)
        if proc is not None:
            try:
                proc.wait(3)
            except Exception:  # noqa: BLE001
                pass  # nosec B110
        pidfile.unlink(missing_ok=True)
        return "Aplikacja zatrzymana."
    if act == "logs":
        tail = _log_tail(logfile, 80)
        return ("Log aplikacji (ostatnie linie):\n" + tail) if tail else "(brak logów — aplikacja jeszcze nie startowała)"
    if act == "status":
        return (f"Aplikacja DZIAŁA: http://{ip}:{port}/" if pidfile.exists() and _alive()
                else "Aplikacja nie jest uruchomiona (app_action=start).")

    # start
    if pidfile.exists() and _alive():
        return f"Aplikacja już działa: http://{ip}:{port}/ (stop: app_action=stop)"
    command = args.get("command")
    if not command:
        return "BŁĄD: podaj command startu, np. '.venv/bin/python app.py'."
    print(f"\n  {yellow(_L('▶ Uruchomienie aplikacji:'))} {bold(command)}")
    if not auto_yes:
        if not confirm_action(_L("Uruchomić aplikację?"), command, ["run_app", command, port]):
            return "ODRZUCONE przez użytkownika — nie uruchamiam."
    kw: dict = {"stdin": subprocess.DEVNULL, "cwd": str(Path.cwd())}
    if IS_WIN:
        kw["creationflags"] = 0x00000200  # NEW_PROCESS_GROUP
    else:
        kw["start_new_session"] = True     # własna grupa: stop zabija też dzieci powłoki
    log = open(logfile, "wb")
    try:
        proc = subprocess.Popen(command, shell=True, stdout=log, stderr=subprocess.STDOUT, **kw)  # nosec B602 — komenda zatwierdzona
    finally:
        log.close()  # dziecko dziedziczy fd; rodzic nie trzyma uchwytu
    pidfile.write_text(str(proc.pid))
    _RUN_APP[str(Path.cwd())] = proc
    # Do 15 s: czekamy, aż port odpowie albo proces się skończy (do 0.28.0 po 1,5 s zgłaszaliśmy
    # sukces także wtedy, gdy aplikacja padła: proces-zombie wyglądał na żywy).
    listening = False
    deadline = _time.monotonic() + 15
    while _time.monotonic() < deadline:
        if proc.poll() is not None:
            break
        try:
            with _sock.create_connection(("localhost", port), timeout=0.5):   # IPv4 i ::1 (Vite, Node)
                listening = True
                break
        except OSError:
            _time.sleep(0.4)
    if proc.poll() is not None:
        pidfile.unlink(missing_ok=True)
        _RUN_APP.pop(str(Path.cwd()), None)
        return f"BŁĄD: aplikacja zakończyła się zaraz po starcie (kod {proc.returncode}).\n{_log_tail(logfile, 40)}"
    if not listening:
        return (f"Aplikacja działa w tle (pid {proc.pid}), ale po 15 s nic nie nasłuchuje na porcie {port}. "
                "Sprawdź port w logach (app_action=logs) albo podaj właściwy port.\n" + _log_tail(logfile, 20))
    return (f"Aplikacja uruchomiona i odpowiada: http://127.0.0.1:{port}/ (w sieci: http://{ip}:{port}/)\n"
            f"(w tle; logi: app_action=logs, zatrzymanie: app_action=stop. "
            f"Jeśli nie otwiera się z zewnątrz — otwórz port {port} w firewall.)")


