def _c(code: str, s: str) -> str:
    # sys.stdout może być None (pythonw na Windows — autostart mostka).
    if not sys.stdout or not sys.stdout.isatty() or "NO_COLOR" in os.environ or os.environ.get("TERM") == "dumb":
        return s
    return f"\033[{code}m{s}\033[0m"

def dim(s):    return _c("2", s)
def bold(s):   return _c("1", s)
def green(s):  return _c("32", s)
def yellow(s): return _c("33", s)
def red(s):    return _c("31", s)
def violet(s): return _c("38;5;141", s)
def cyan(s):   return _c("38;5;183", s)


def _tty() -> bool:
    return bool(sys.stdout and sys.stdout.isatty())


# Znak startowy (wybór usera 15.11, wariant B): litera A i koniczyna z łodyżką
# zawiniętą pod literę, rysowane półblokami w 3 wierszach (piksel = pół komórki,
# czyli prawie kwadrat). Gradient marki: jasny fiolet u góry, nasycony na dole.
_LOGO_PX = (
    "...##....##.##",
    "..####...#####",
    "..#..#....###.",
    ".######..#####",
    ".#....#..##.##",
    "##....##.#....",
)
_LOGO_TOP, _LOGO_BOTTOM = (214, 190, 255), (124, 58, 237)
_LOGO_FRAMES = 7


def _logo_color(y: int, x: int) -> tuple:
    h, w = len(_LOGO_PX), len(_LOGO_PX[0])
    t = (y / (h - 1)) * 0.75 + (x / (w - 1)) * 0.25
    return tuple(round(a + (b - a) * t) for a, b in zip(_LOGO_TOP, _LOGO_BOTTOM))


def _logo_sgr(rgb: tuple, background: bool = False) -> str:
    lead = "48" if background else "38"
    if _truecolor():
        return f"{lead};2;{rgb[0]};{rgb[1]};{rgb[2]}"
    r, g, b = (round(v / 255 * 5) for v in rgb)
    return f"{lead};5;{16 + 36 * r + 6 * g + b}"


def _logo_rows(reveal: float = 1.0) -> list[str]:
    """Wiersze znaku; `reveal` (0–1) odsłania kolumny od lewej (animacja wejścia).
    Bez kolorów: sam kształt z półbloków."""
    px = _LOGO_PX
    width = len(px[0])
    shown = round(width * reveal)
    plain = "NO_COLOR" in os.environ or not _tty()
    rows = []
    for cy in range(0, len(px), 2):
        out = []
        for x in range(width):
            top = px[cy][x] == "#" and x < shown
            bottom = cy + 1 < len(px) and px[cy + 1][x] == "#" and x < shown
            if not (top or bottom):
                out.append(" ")
                continue
            glyph = "█" if top and bottom else ("▄" if bottom else "▀")
            if plain:
                out.append(glyph)
                continue
            ct, cb = _logo_color(cy, x), _logo_color(min(cy + 1, len(px) - 1), x)
            if top and bottom:
                out.append(f"\033[{_logo_sgr(cb)};{_logo_sgr(ct, True)}m▄\033[0m")
            else:
                out.append(f"\033[{_logo_sgr(cb if bottom else ct)}m{glyph}\033[0m")
        rows.append("".join(out))
    return rows


def banner(subtitle: str = "", details: list[str] | None = None) -> None:
    """Nagłówek: znak A z koniczyną, obok nazwa z wersją i najwyżej dwie linie opisu.
    Prosty tekst dla potoków i wąskich terminali."""
    import shutil
    columns = shutil.get_terminal_size((80, 24)).columns
    if not _tty() or os.environ.get("TERM") == "dumb" or columns < 48:
        print(f"{APP_NAME}  {VERSION}" + (f" · {subtitle}" if subtitle else ""))
        return
    info = details or ([subtitle] if subtitle and subtitle != "agent w Twoim terminalu" else [])
    available = max(1, columns - len(_LOGO_PX[0]) - 7)
    labels = [bold(APP_NAME) + dim(f" {VERSION}")]
    labels += [dim(value if len(value) <= available else value[:available - 1] + "…") for value in info[:2]]
    height = (len(_LOGO_PX) + 1) // 2
    animate = "NO_COLOR" not in os.environ and not os.environ.get("DOMA_REDUCE_MOTION")
    steps = [(i + 1) / _LOGO_FRAMES for i in range(_LOGO_FRAMES)] if animate else [1.0]
    print()
    for number, reveal in enumerate(steps):
        if number:
            import time as _time
            _time.sleep(0.04)
            sys.stdout.write(f"\033[{height}A")
        rows = _logo_rows(reveal)
        for i, row in enumerate(rows):
            label = labels[i] if i < len(labels) and reveal >= 1.0 else ""
            sys.stdout.write("\r\033[2K  " + row + "   " + label + "\n")
        sys.stdout.flush()
    print()


def panel(title: str, lines: list[str]) -> None:
    """Ramka dostosowana do szerokości terminala; bez sekwencji ANSI poza TTY."""
    import shutil
    import textwrap
    columns = shutil.get_terminal_size((80, 24)).columns
    if not _tty() or os.environ.get("TERM") == "dumb" or columns < 44:
        print(f"  {title}")
        for line in lines:
            print(f"  {line}")
        return
    width = min(columns - 4, 72, max(32, len(title) + 8,
                                        max((len(line) + 4 for line in lines), default=0)))
    inner = width - 4
    heading = f" {title} "[:width - 2]
    print("  " + violet("╭─") + bold(heading) + violet("─" * max(0, width - 3 - len(heading)) + "╮"))
    for line in lines:
        for part in textwrap.wrap(line, width=inner, replace_whitespace=False,
                                  drop_whitespace=False) or [""]:
            print("  " + violet("│") + " " + part.ljust(inner) + " " + violet("│"))
    print("  " + violet("╰" + "─" * (width - 2) + "╯"))


