_KONEKTORY_CACHE = {"t": 0.0, "dane": None}


def konektory_stan(odswiez: bool = False) -> dict:
    """Konektory i narzędzia połączonych usług (cache 60 s, bez sieci ostatni znany stan z dysku)."""
    import time as _t
    plik = CONFIG_DIR / "konektory-cache.json"
    if not odswiez and _KONEKTORY_CACHE["dane"] is not None and _t.time() - _KONEKTORY_CACHE["t"] < 60:
        return _KONEKTORY_CACHE["dane"]
    if not (load_device() or load_creds()):
        return {"konektory": [], "narzedzia": [], "blad": _L("Zaloguj się do DomaAI, żeby łączyć usługi.")}
    try:
        d = api_call(load_creds(), "/cli/konektory", {}, method="GET")
        _KONEKTORY_CACHE.update(t=_t.time(), dane=d)
        try:
            _save_private_json(plik, d)
        except OSError:
            pass
        return d
    except ApiError as e:
        return {"konektory": [], "narzedzia": [], "blad": str(e)[:300]}
    except Exception:  # noqa: BLE001 — brak sieci
        try:
            d = json.loads(plik.read_text(encoding="utf-8"))
        except (OSError, ValueError):
            d = {"konektory": [], "narzedzia": []}
        return {**d, "offline": True, "blad": _L("Bez sieci: połączone usługi wrócą, gdy będzie internet.")}


def _konektory_lista_dla_modelu() -> str:
    d = konektory_stan()
    narz = d.get("narzedzia") or []
    if not narz:
        pol = [k["nazwa"] for k in d.get("konektory") or [] if k.get("polaczony")]
        return d.get("blad") or (_L("User nie połączył jeszcze żadnej usługi. Powiedz mu: Ustawienia Codo, Połączenia.")
                                 if not pol else _L("Połączone usługi nie mają narzędzi dostępnych w Codo."))
    linie = []
    for n in narz:
        props = (n.get("schemat") or {}).get("properties") or {}
        wym = set((n.get("schemat") or {}).get("required") or [])
        args = ", ".join(f"{k}{'*' if k in wym else ''}" for k in props)
        zgoda = " [karta zgody]" if n.get("tryb") == "zapytaj" else ""
        linie.append(f"• {n['nazwa']} ({n['konektor']}){zgoda}: {str(n.get('opis') or '')[:220]} args: {args}")
    return _L("Narzędzia połączonych usług (* = wymagane):") + "\n" + "\n".join(linie)


def konektor_wywolaj(narzedzie: str, args: dict, ask=None) -> str:
    if not narzedzie:
        return _konektory_lista_dla_modelu()
    if not (load_device() or load_creds()):
        return _L("Połączenia działają przez konto DomaAI, a to urządzenie nie jest zalogowane. Powiedz userowi: Ustawienia Codo, Konta.")
    args = {k: v for k, v in (args or {}).items() if k != "zgoda_usera"} if isinstance(args, dict) else {}
    body = {"narzedzie": narzedzie, "args": args, "sesja": _google_sesja()}
    try:
        r = api_call(load_creds(), "/cli/konektory/narzedzie", body)
        if r.get("bramka"):
            pytanie = str(r["bramka"])
            zgoda = (ask or (lambda q: confirm_action(_L("Zgoda na akcję w usłudze"), q, reason=_L("skutek poza Codo"))))(pytanie)
            if not zgoda:
                return _L("User NIE zgodził się na tę akcję. Nic nie zostało wysłane ani zmienione; zapytaj, co zmienić.")
            r = api_call(load_creds(), "/cli/konektory/narzedzie", {**body, "zgoda": True})
        return str(r.get("wynik") or "")
    except ApiError as e:
        if e.status == 404:
            return _L("Nie ma takiego narzędzia. Wywołaj `polaczenia` bez argumentów, żeby zobaczyć listę.")
