def _tip(seed: float) -> str:
    """Jedna podpowiedź na turę (zmienia się co 20 s)."""
    import time as _t
    return _TIPS[(int(seed) + int((_t.monotonic() - seed) // 20)) % len(_TIPS)]


class _Editor:
    """Okno pisania: kursor, historia, wiele linii (wklejka, \\ + Enter, Alt+Enter)."""

    def __init__(self, value: str = "", history: list | None = None):
        self.value = value
        self.cursor = len(value)
        self.history = [h for h in (history or []) if h]
        self.hidx = len(self.history)

    def _line_bounds(self):
        start = self.value.rfind("\n", 0, self.cursor) + 1
        end = self.value.find("\n", self.cursor)
        return start, (len(self.value) if end < 0 else end)

    def insert(self, text: str) -> None:
        text = text.replace("\r\n", "\n").replace("\r", "\n").replace("\t", "    ")
        text = "".join(ch for ch in text if ch == "\n" or ch.isprintable())
        self.value = self.value[:self.cursor] + text + self.value[self.cursor:]
        self.cursor += len(text)

    def feed(self, key: str) -> str | None:
        """Zwraca akcję: submit / mode / escape / interrupt / eof / tab / None."""
        if key.startswith(_Keys.PASTE):
            self.insert(key[len(_Keys.PASTE):])
            return None
        if key in ("\r", "\n"):
            if self.value[:self.cursor].endswith("\\"):
                self.value = self.value[:self.cursor - 1] + "\n" + self.value[self.cursor:]
                return None
            return "submit"
        if key in ("\x1b\r", "\x1b\n"):
            self.insert("\n")
            return None
        if key in ("\x1b[Z", "\x14"):
            return "mode"
        if key == "\x1b":
            return "escape"
        if key == "\x03":
            return "interrupt"
        if key == "\x04":
            if not self.value:
                return "eof"
            self.value = self.value[:self.cursor] + self.value[self.cursor + 1:]
            return None
        if key == "\t":
            return "tab"
        start, end = self._line_bounds()
        if key == "\x01":
            self.cursor = start
        elif key == "\x05":
            self.cursor = end
        elif key == "\x15":
            self.value, self.cursor = self.value[:start] + self.value[self.cursor:], start
        elif key == "\x0b":
            self.value = self.value[:self.cursor] + self.value[end:]
        elif key in ("\x17", "\x1b\x7f"):
            left = self.value[:self.cursor].rstrip()
            cut = max(left.rfind(" "), left.rfind("\n")) + 1
            self.value, self.cursor = self.value[:cut] + self.value[self.cursor:], cut
        elif key in ("\x7f", "\b"):
            if self.cursor:
                self.value = self.value[:self.cursor - 1] + self.value[self.cursor:]
                self.cursor -= 1
        elif key in ("\x1b[H", "\x1b[1~", "\x1b[7~"):
            self.cursor = start
        elif key in ("\x1b[F", "\x1b[4~", "\x1b[8~"):
            self.cursor = end
        elif key == "\x1b[3~":
            self.value = self.value[:self.cursor] + self.value[self.cursor + 1:]
        elif key == "\x1b[D":
            self.cursor = max(0, self.cursor - 1)
        elif key == "\x1b[C":
            self.cursor = min(len(self.value), self.cursor + 1)
        elif key in ("\x1b[1;5D", "\x1b[1;3D", "\x1bb"):
            left = self.value[:self.cursor].rstrip()
            self.cursor = max(left.rfind(" "), left.rfind("\n")) + 1
        elif key in ("\x1b[1;5C", "\x1b[1;3C", "\x1bf"):
            m = re.search(r"\S\s", self.value[self.cursor:])
            self.cursor = self.cursor + m.end() - 1 if m else len(self.value)
        elif key in ("\x1b[A", "\x1b[B"):
            self._vertical(-1 if key == "\x1b[A" else 1)
        elif len(key) >= 1 and not key.startswith("\x1b") and key.isprintable():
            self.insert(key)
        return None

    def _vertical(self, step: int) -> None:
        start, end = self._line_bounds()
        col = self.cursor - start
        if step < 0 and start > 0:
            pstart = self.value.rfind("\n", 0, start - 1) + 1
            self.cursor = min(pstart + col, start - 1)
            return
        if step > 0 and end < len(self.value):
            nend = self.value.find("\n", end + 1)
            nend = len(self.value) if nend < 0 else nend
            self.cursor = min(end + 1 + col, nend)
            return
        if not self.history:
            return
        self.hidx = max(0, min(len(self.history), self.hidx + step))
        self.value = self.history[self.hidx] if self.hidx < len(self.history) else ""
        self.cursor = len(self.value)

    def rows(self, width: int, placeholder: str = "") -> tuple[list[str], int, int]:
        """Wiersze do narysowania (z prefiksem ❯) + pozycja kursora (wiersz, kolumna)."""
        width = max(4, width - 2)
        if not self.value:
            return [violet("❯") + " " + dim(placeholder[:width])], 0, 2
        rows, cur_row, cur_col = [], 0, 0
        offset = 0
        for line in self.value.split("\n"):
            chunks, used, chunk = [], 0, ""
            positions = []  # (wiersz w linii, kolumna) dla każdego znaku
            for ch in line:
                w = _cell(ch)
                if used + w > width:
                    chunks.append(chunk)
                    chunk, used = "", 0
                positions.append((len(chunks), used))
                chunk += ch
                used += w
            chunks.append(chunk)
            if offset <= self.cursor <= offset + len(line):
                i = self.cursor - offset
                if i < len(line):
                    r, c = positions[i]
                else:
                    r, c = len(chunks) - 1, used
                    if c >= width:
                        chunks.append("")
                        r, c = len(chunks) - 1, 0
                cur_row, cur_col = len(rows) + r, c
            rows.extend(chunks)
            offset += len(line) + 1
        # Najwyżej 8 wierszy, okno podąża za kursorem.
        top = max(0, min(cur_row - 7, len(rows) - 8)) if len(rows) > 8 else 0
        shown = rows[top:top + 8]
        out = [(violet("❯") if top + i == 0 else (dim("↑") if i == 0 else " ")) + " " + text
               for i, text in enumerate(shown)]
        return out, cur_row - top, cur_col + 2



_FOOTER_MODEL = {"at": 0.0, "value": ""}


def _footer_model() -> str:
    """Model do stopki, odświeżany najwyżej co 2 s: stopka rysuje się kilka razy na sekundę, a
    current_model czyta za każdym razem kilka plików konfiguracji (do 0.28.0: 7 odczytów na klatkę)."""
    import time
    now = time.monotonic()
    if now - _FOOTER_MODEL["at"] > 2:
        _FOOTER_MODEL["value"] = str(current_model(None) or "")
        _FOOTER_MODEL["at"] = now
    return _FOOTER_MODEL["value"]

class _LiveOut:
    """sys.stdout podczas pracy: wszystko, co wypisze program, trafia nad panel."""

    def __init__(self, live, real):
        self._live, self._real = live, real

    def write(self, s):
        self._live.emit(str(s))
        return len(s)

    def flush(self):
        self._real.flush()

    def isatty(self):
        return self._real.isatty()

    def fileno(self):
        return self._real.fileno()

    def __getattr__(self, name):
        return getattr(self._real, name)


def _cursor_row() -> int | None:
    """Wiersz kursora na ekranie (od 1). POSIX: zapytanie DSR, Windows: API konsoli."""
    if IS_WIN:
        try:
            import ctypes
            from ctypes import wintypes

            class _Coord(ctypes.Structure):
                _fields_ = [("X", ctypes.c_short), ("Y", ctypes.c_short)]

            class _Rect(ctypes.Structure):
                _fields_ = [("Left", ctypes.c_short), ("Top", ctypes.c_short),
                            ("Right", ctypes.c_short), ("Bottom", ctypes.c_short)]

            class _Info(ctypes.Structure):
                _fields_ = [("dwSize", _Coord), ("dwCursorPosition", _Coord),
                            ("wAttributes", wintypes.WORD), ("srWindow", _Rect),
                            ("dwMaximumWindowSize", _Coord)]

            k32 = ctypes.windll.kernel32
            info = _Info()
            if k32.GetConsoleScreenBufferInfo(k32.GetStdHandle(-11), ctypes.byref(info)):
                return info.dwCursorPosition.Y - info.srWindow.Top + 1
        except Exception:  # noqa: BLE001 — brak konsoli: bez przyklejania
            return None
        return None
    try:
        import select
        import termios
        import time as _time
        import tty
        fd = sys.stdin.fileno()
        old = termios.tcgetattr(fd)
    except (ImportError, OSError, ValueError, AttributeError):
        return None
    try:
        tty.setcbreak(fd)
        out = sys.__stdout__
        out.write("\033[6n")
        out.flush()
        buf = b""
        end = _time.monotonic() + 0.4
        while _time.monotonic() < end and not buf.endswith(b"R"):
            if not select.select([fd], [], [], max(0.0, end - _time.monotonic()))[0]:
                break
            buf += os.read(fd, 1)
        m = re.search(rb"\x1b\[(\d+);(\d+)R", buf)
        return int(m.group(1)) if m else None
    except OSError:
        return None
    finally:
        termios.tcsetattr(fd, termios.TCSANOW, old)


def _text_rows(text: str, cols: int) -> int:
    """Ile wierszy ekranu zajmie wypisany tekst (z zawijaniem terminala)."""
    return sum(max(1, -(-_display_width(_visible(line).replace("\t", "    ")) // max(1, cols)))
               for line in text.split("\n"))


class _Live:
    """Panel przyklejony do dołu terminala: status pracy, narzędzie w toku,
    pytanie o zgodę i okno pisania. Jeden na proces (LIVE).

    Przyklejenie: znamy wiersz ekranu, od którego zaczyna się panel (`top`,
    z DSR / API konsoli), i dokładamy nad panelem puste wiersze, żeby jego
    dolna krawędź zawsze leżała na ostatnim wierszu ekranu. Tekst wypisany
    przez program wchodzi w miejsce tych pustych wierszy, a gdy ekran się
    zapełni, przewija się normalnie do historii terminala."""

    def __init__(self):
        self.lock = threading.RLock()
        self.read_lock = threading.Lock()
        self.real = None
        self.on = False          # stdout podmieniony, panel narysowany
        self.session = False     # tryb rozmowy: panel stoi cały czas
        self.drawn: list = []    # szerokości widoczne narysowanych wierszy
        self.cur_row = 0         # wiersz panelu, na którym stoi kursor
        self.top = None          # wiersz ekranu (od 1), w którym zaczyna się panel
        self.screen = (0, 0)
        self.need_sync = False
        self.partial = ""        # niedokończona linia z print(..., end="")
        self.preview = ""        # podgląd strumieniowanej odpowiedzi (bez commita)
        self.busy = False
        self.t0 = 0.0
        self.label = ""
        self.detail = ""
        self.tool = ""           # aktualnie wykonywane narzędzie (nagłówek)
        self.tool_paused = False  # nagłówek zszedł do transkryptu przed pytaniem o zgodę
        self.tool_icon = "●"
        self.tool_detail = ""
        self.tool_t0 = 0.0
        self.summary: dict = {}  # zwinięte udane narzędzia: grupa → liczba (jak „Ran 1 shell command”)
        self.thought = 0.0       # ile sekund model myślał w tej turze
        self.tokens = 0
        self.editor: _Editor | None = None
        self.dialog: dict | None = None
        self.menu: list = []
        self.notice = ""
        self.notice_until = 0.0
        self.tick = 0
        self.keys: _Keys | None = None
        self.hold = False
        self.stop_evt = None
        self.thread = None
        self.dirty = False
        self.interactive = False

    # ── dostępność ───────────────────────────────────────────────────────
    @staticmethod
    def available() -> bool:
        return (_tty() and os.environ.get("TERM") != "dumb"
                and not os.environ.get("DOMA_PLAIN"))

    @staticmethod
    def keyboard() -> bool:
        try:
            return bool(sys.stdin and sys.stdin.isatty())
        except (ValueError, OSError):
            return False

    # ── rysowanie ────────────────────────────────────────────────────────
    def _size(self) -> tuple:
        import shutil
        size = shutil.get_terminal_size((80, 24))
        return max(20, size.columns), max(6, size.lines)

    def _columns(self) -> int:
        return self._size()[0]

    def _rows_available(self) -> int:
        return self._size()[1] - 1

    def _top_rule(self, width: int) -> str:
        """Górna kreska okna pisania; po /rc z zielonym znacznikiem po prawej."""
        if not SESSION.get("rc") or width < 30:
            return dim("─" * width)
        tag = _L(" ● /rc · telefon połączony ")
        return dim("─" * max(2, width - len(tag) - 2)) + green(tag) + dim("──")

    def _footer(self, width: int) -> str:
        import time as _time
        if self.notice and _time.monotonic() < self.notice_until:
            return _fit(yellow("  " + self.notice), width)
        mode = _INPUT_MODE
        if mode == "auto":
            left = yellow(_L("  ⏵⏵ tryb auto włączony"))
        elif mode == "read":
            left = cyan(_L("  ⏸ tryb tylko odczyt"))
        else:
            left = dim(_L("  ⏵ pyta o zgodę"))
        model = str(SESSION.get("model") or _footer_model() or "")
        tail = [dim(_L("esc przerywa"))] if self.busy and self.interactive else []
        eff = current_effort()
        if eff != "medium" or _marathon_on():
            tail.append(violet("✥ " + _EFFORT_PL[eff]) + (violet(_L(" · maraton")) if _marathon_on() else ""))
        agents = SESSION.get("agents_running") or 0
        if agents:
            tail.append(violet(f"✻ {agents} {_plural(agents, ('agent', _L('agenci'), _L('agentów')))}"))
        if SESSION.get("rc"):
            tail.append(green("/rc"))
        # Wąski terminal: najpierw znika podpowiedź, potem model, na końcu folder;
        # tryb i „esc przerywa” zostają zawsze.
        variants = (
            [left + dim(_L(" (shift+tab zmienia)"))] + tail + [_where()] + ([dim(model)] if model else []),
            [left] + tail + [_where()] + ([dim(model)] if model else []),
            [left] + tail + [_where()],
            [left] + tail,
        )
        for parts in variants:
            line = dim(" · ").join(parts)
            if _display_width(_visible(line)) <= width:
                return line
        return _fit(line, width)

    def _status(self, width: int) -> str:
        import time as _time
        # Nazwa narzędzia stoi już wiersz wyżej, więc nie powtarzamy jej w liczniku.
        label = _L("Pracuję") if self.tool else (self.label or _L("Myślę"))
        stats = [_duration(_time.monotonic() - self.t0)]
        steps = SESSION.get("turn_steps", 0)
        if steps:
            stats.append(_kroki(steps))
        if self.tokens:
            stats.append(_Lf('↓ {0} tokenów', _tokens_label(self.tokens)))
        if self.thought >= 1:
            stats.append(_Lf('myślał {0}', _duration(self.thought)))
        eff = current_effort()
        if eff in ("high", "xhigh", "max"):
            label = {"high": _L("myśli więcej"), "xhigh": _L("myśli dużo więcej"), "max": _L("myśli najwięcej")}[eff]
            stats.append(yellow(label) + ("\033[2m" if yellow(label) != label else ""))
        line = _clover(self.tick) + " " + _shimmer(_terminal_text(label) + "…", self.tick) \
            + " " + dim("(" + " · ".join(stats) + ")")
        return _fit(line, width)

    def _dialog_rows(self, width: int) -> list:
        d = self.dialog
        rows = [_rgb((0xa8, 0x6a, 0xf0), "─" * width), " " + bold(_terminal_text(d["question"]))]
        shown = (self.tool_detail[2:] if self.tool_detail.startswith("$ ") else self.tool_detail).strip() \
            if self.tool else ""   # bez str.removeprefix: Python 3.8
        if d["detail"].strip() and d["detail"].strip() != shown:
            for line in d["detail"].splitlines()[:6]:
                for part in _wrap_ansi(_terminal_text(line), max(10, width - 6))[:3]:
                    rows.append("   " + cyan(part))
        meta = ([] if self.tool else [f"w {_cwd_label(50)}"]) + ([_terminal_text(d["reason"])] if d["reason"] else [])
        if meta:
            rows.append(_fit(dim("   " + " · ".join(meta)), width))
        rows.append("")
        for i, (_, label) in enumerate(d["options"]):
            if i == d["sel"]:
                rows.append(_fit(" " + violet("❯ ") + bold(label), width))
            else:
                rows.append(_fit("   " + dim(label), width))
        rows.append(_rgb((0xa8, 0x6a, 0xf0), "─" * width))
        rows.append(_fit(dim(_L("  enter wybiera · ↑↓ zmienia · esc odmawia")), width))
        return rows

    def _block(self, width: int):
        lines, cursor = [], None
        for text in (self.preview, self.partial):
            if text:
                for raw in text.split("\n")[-6:]:
                    lines.extend(_wrap_ansi(raw, width)[-6:])
        # Odstępy jak w gotowym transkrypcie (pusta linia przed podsumowaniem
        # i przed narzędziem), żeby po zakończeniu kroku nic nie przeskakiwało.
        if self.summary:
            lines.append("")
            lines.append(_fit(_summary_text(self.summary, running=bool(self.tool)), width))
        if self.tool:
            icon = self.tool_icon or "●"
            dot = _rgb((0xa8, 0x6a, 0xf0), icon) if self.tick % 6 < 3 else dim(icon)
            lines.append("")
            import time as _t
            took = _t.monotonic() - (self.tool_t0 or _t.monotonic())
            clock = dim(f" · {_duration(took)}…") if took >= 2 else ""
            lines.append(_fit(dot + " " + self.tool + clock, width))
            lines.extend(_detail_rows(self.tool_detail, width))
        if self.busy and not self.dialog:
            lines.append("")
            lines.append(self._status(width))
            if self.detail:
                for i, row in enumerate(str(self.detail).split("\n")[:6]):
                    lines.append(_fit(dim(("  ⎿  " if i == 0 else "     ") + _terminal_text(row)), width))
            elif self.interactive:
                lines.append(_fit(dim("  ⎿  " + _tip(self.t0)), width))
        if self.dialog:
            lines.append("")
            lines.extend(self._dialog_rows(width))
        elif self.editor is not None:
            for q in SESSION.get("queued", [])[-3:]:
                lines.append(_fit(dim(_L("  ↳ w kolejce: ")) + _terminal_text(q.replace("\n", " ⏎ ")), width))
            lines.append("")
            lines.append(self._top_rule(width))
            rows, r, c = self.editor.rows(width, _L("Napisz, co mam zrobić…") if not self.busy
                                          else _L("Pisz dalej, wyślę po zakończeniu…"))
            cursor = (len(lines) + r, c)
            lines.extend(_fit(row, width) for row in rows)
            lines.append(dim("─" * width))
            if self.menu:
                for i, (name, desc) in enumerate(self.menu[:8]):
                    col = 12 if not name.startswith("@") else min(40, max(12, max(len(n) for n, _ in self.menu[:8])))
                    item = (violet(name.ljust(col)) if i == 0 else cyan(name.ljust(col))) + "  " + dim(desc)
                    lines.append(_fit("  " + item, width))
            else:
                lines.append(self._footer(width))
        limit = self._rows_available()
        if len(lines) > limit:
            cut = len(lines) - limit
            lines = lines[cut:]
            if cursor:
                cursor = (max(0, cursor[0] - cut), cursor[1])
        return lines, cursor

    def _erase_seq(self) -> str:
        if not self.drawn:
            return "\r"
        cols = self._columns()
        up = sum(max(1, -(-w // cols)) for w in self.drawn[:self.cur_row])
        return "\r" + (f"\033[{up}A" if up else "") + "\033[J"

    def _paint(self) -> None:
        if not self.on:
            return
        cols, rows = self._size()
        if self.screen != (cols, rows) and self.screen != (0, 0):
            self.need_sync = True       # zmiana rozmiaru: po rysunku zmierzymy od nowa
        width = cols - 1
        lines, cursor = self._block(width)
        n = len(lines)
        pad = 0
        if self.top is not None:
            pad = rows - (self.top - 1) - n
            if pad > 0:
                lines = [""] * pad + lines
                if cursor:
                    cursor = (cursor[0] + pad, cursor[1])
            else:
                pad = 0
        out = ["\033[?2026h\033[?25l", self._erase_seq()]
        out.append("\n".join(lines))
        if cursor:
            up = len(lines) - 1 - cursor[0]
            out.append((f"\033[{up}A" if up > 0 else "") + "\r" + (f"\033[{cursor[1]}C" if cursor[1] else ""))
            out.append("\033[?25h")
            self.cur_row = cursor[0]
        else:
            self.cur_row = len(lines) - 1
        out.append("\033[?2026l")
        if self.top is not None and pad == 0:
            self.top = max(1, rows - n + 1)
        self.drawn = [_display_width(_visible(line)) for line in lines]
        self.screen = (cols, rows)
        self.real.write("".join(out))
        self.real.flush()
        self.dirty = False

    def _erase(self) -> None:
        if self.drawn:
            self.real.write(self._erase_seq())
        self.drawn = []
        self.cur_row = 0

    def _sync(self) -> None:
        """Zmierz, gdzie stoi początek panelu (kursor po wymazaniu panelu)."""
        if not self.keyboard():
            self.top = None
            return
        self.real.flush()
        row = _cursor_row()
        self.top = row if row else None
        self.need_sync = False

    def _resync(self) -> None:
        with self.lock:
            if not self.on:
                return
            self._erase()
            self._sync()
            self._paint()

    # ── wyjście programu nad panelem ─────────────────────────────────────
    def emit(self, s: str) -> None:
        with self.lock:
            if not self.on:
                (self.real or sys.__stdout__).write(s)
                return
            if self.summary and s:
                self.flush_tools()
            text = self.partial + s
            if "\n" not in text:
                self.partial = text
                self.dirty = True
                return
            head, _, self.partial = text.rpartition("\n")
            self.real.write("\033[?2026h")
            self._erase()
            self.real.write(head + "\n")
            if self.top is not None:
                cols, rows = self._size()
                self.top = min(rows, self.top + _text_rows(head, cols))
            self._paint()

    # ── cykl życia ───────────────────────────────────────────────────────
    def _attach(self) -> None:
        if self.on:
            return
        self.real = sys.stdout if not isinstance(sys.stdout, _LiveOut) else sys.stdout._real
        sys.stdout = _LiveOut(self, self.real)
        self.on = True
        self.drawn = []
        self._sync()

    def _detach(self) -> None:
        if not self.on:
            return
        with self.lock:
            self._erase()
            if self.partial:
                self.real.write(self.partial + "\n")
                self.partial = ""
            self.real.write("\033[?25h")
            self.real.flush()
            sys.stdout = self.real
            self.on = False
            self.top = None

    def session_start(self) -> bool:
        """Rozmowa: okno pisania stoi na dole cały czas, także w trakcie pracy."""
        if not (self.available() and self.keyboard()):
            return False
        with self.lock:
            self.session = True
            self.interactive = True
            if self.editor is None:
                self.editor = _Editor(SESSION.pop("draft", ""), _history_items())
            self._attach()
            self._paint()
        return True

    def session_end(self) -> None:
        if not self.session:
            return
        self.stop_busy()
        with self.lock:
            self.session = False
            self.editor = None
            self.menu = []
            self._detach()

    def start_busy(self, label: str = "", interactive: bool | None = None):
        import time as _time
        if not self.available():
            return
        with self.lock:
            self.busy = True
            self.t0 = SESSION.get("turn_started") or _time.monotonic()
            self.label, self.detail, self.tool, self.tokens = label, "", "", 0
            self.tool_detail, self.thought = "", 0.0
            self.interactive = bool(SESSION.get("interactive") if interactive is None else interactive) \
                and self.keyboard()
            if self.interactive and self.editor is None:
                self.editor = _Editor(SESSION.pop("draft", ""), _history_items())
            self.menu = []
            self._attach()
            if self.interactive:
                _ensure_sigint()
                self.keys = _Keys().__enter__()
            self._paint()
        self.stop_evt = threading.Event()
        self.thread = threading.Thread(target=self._loop, daemon=True)
        self.thread.start()

    def stop_busy(self) -> None:
        # Esc wciśnięty w chwili kończenia tury wysyłał SIGINT w środek sprzątania:
        # terminal zostawał w trybie cbreak, a spóźniony sygnał zamykał REPL.
        # Sprzątanie jest idempotentne, więc po takim przerwaniu ponawiamy je,
        # a samo przerwanie pomijamy (tura i tak się skończyła).
        while True:
            try:
                self._stop_busy()
                return
            except KeyboardInterrupt:
                continue

    def _stop_busy(self) -> None:
        if not self.busy:
            return
        if self.stop_evt:
            self.stop_evt.set()
        if self.thread and self.thread is not threading.current_thread():
            self.thread.join(1)
        with self.lock:
            self.flush_tools()
            self.busy = False
            self.tool = ""
            self.preview = ""
            self.dialog = None
            if self.keys:
                self.keys.__exit__()
                self.keys = None
            if self.session:
                self._paint()
                return
            if self.editor is not None and self.editor.value:
                SESSION["draft"] = self.editor.value
            self.editor = None
            self.menu = []
            self._detach()

    def _loop(self) -> None:
        import time as _time
        last = 0.0
        while not self.stop_evt.is_set():
            key = None
            if self.keys and not self.hold:
                with self.read_lock:
                    if not self.hold and self.keys:
                        if self.need_sync:
                            self._resync()
                        try:
                            key = self.keys.read(0.04)
                        except (OSError, ValueError):
                            key = None
            else:
                self.stop_evt.wait(0.04)
            with self.lock:
                if not self.on or self.hold:
                    continue
                if key:
                    self._busy_key(key)
                now = _time.monotonic()
                if now - last >= 0.11:
                    self.tick += 1
                    last = now
                    self._paint()
                elif self.dirty or key:
                    self._paint()

    def _busy_key(self, key: str) -> None:
        if self.dialog:
            self._dialog_key(key)
            return
        action = self.editor.feed(key) if self.editor is not None else None
        if action in ("escape", "interrupt") or (self.editor is None and key in ("\x1b", "\x03")):
            if self.stop_evt is not None and self.stop_evt.is_set():
                return                      # tura już się kończy, nie ma czego przerywać
            self.label = "Przerywam"
            _interrupt_main()
        elif action == "submit" and self.editor is not None:
            text = self.editor.value.strip()
            if text:
                SESSION.setdefault("queued", []).append(text)
                self.editor = _Editor("", self.editor.history + [text])
        elif action == "mode":
            _cycle_mode()

    # ── pytanie o zgodę w panelu (okno nie odkleja się od dołu) ──────────
    def can_ask(self) -> bool:
        return bool(self.on and self.busy and self.keys and self.thread and self.thread.is_alive())

    def _dialog_key(self, key: str) -> None:
        d = self.dialog
        opts = d["options"]
        pick = None
        if key in ("\r", "\n"):
            pick = opts[d["sel"]][0]
        elif key in ("1", "2", "3") and int(key) <= len(opts):
            pick = opts[int(key) - 1][0]
        elif key.lower() in ("t", "y"):
            pick = 1
        elif d["remember"] and key.lower() in ("z", "p"):
            pick = 2
        elif key.lower() == "n" or key in ("\x1b", "\x03", "\x04"):
            pick = 0
        elif key in ("\x1b[A", "\x1b[D"):
            d["sel"] = (d["sel"] - 1) % len(opts)
        elif key in ("\x1b[B", "\x1b[C", "\t"):
            d["sel"] = (d["sel"] + 1) % len(opts)
        if pick is not None:
            d["value"] = pick
            d["done"].set()
        self.dirty = True

    def ask(self, question: str, detail: str = "", reason: str = "", remember: bool = False) -> int:
        """0: nie, 1: tak jednorazowo, 2: tak i zapamiętaj (jak _choose_yes_no)."""
        options = [(1, _L("1. Tak, jednorazowo"))]
        if remember:
            options.append((2, _L("2. Tak, i nie pytaj więcej o to w tym folderze")))
        options.append((0, _Lf('{0}. Nie, podam inne wskazówki', len(options) + 1)))
        done = threading.Event()
        with self.lock:
            self.dialog = {"question": question, "detail": detail, "reason": reason,
                           "remember": remember, "options": options, "sel": 0,
                           "value": 0, "done": done}
            self._paint()
        SYNC.set_state("ask", _plain(question), {"pytanie": _plain(question), "szczegol": _plain(detail),
                                                 "powod": _plain(reason),
                                                 "opcje": [{"wartosc": v, "etykieta": label} for v, label in options]})
        try:
            while not done.wait(0.1):
                if not (self.thread and self.thread.is_alive()):
                    break
            value = self.dialog["value"] if done.is_set() else 0
            if self.dialog.get("zdalnie"):
                print(dim("  ⎿  ") + cyan(_L("Odpowiedź z telefonu: ")) + (_L("tak") if value else _L("nie")))
            return value
        finally:
            with self.lock:
                self.dialog = None
                self._paint()
            SYNC.set_state("busy", _plain(self.label))

    @contextlib.contextmanager
    def paused(self):
        """Ekran dla innego programu (menu wyboru, input()): panel znika na chwilę."""
        if not self.on:
            yield
            return
        self.hold = True
        with self.read_lock:
            pass
        with self.lock:
            self.flush_tools()
            tool = self.tool
            self.tool = ""
            self._erase()
            if tool:
                self.real.write("\n" + dim(self.tool_icon) + " " + tool + "\n")
                for row in _detail_rows(self.tool_detail, self._columns() - 1, 12):
                    self.real.write(row + "\n")
                self.tool_paused = True
            if self.partial:
                self.real.write(self.partial + "\n")
                self.partial = ""
            sys.stdout = self.real
            self.on = False
            keys = self.keys
            if keys:
                keys.__exit__()
            self.real.write("\033[?25h")
            self.real.flush()
        try:
            yield
        finally:
            with self.lock:
                if keys:
                    self.keys = keys.__enter__()
                sys.stdout = _LiveOut(self, self.real)
                self.on = True
                self.drawn = []
                self._sync()
                self.hold = False
                self._paint()

    # ── informacje o pracy ───────────────────────────────────────────────
    def flash(self, text: str, seconds: float = 4.0) -> None:
        import time as _time
        with self.lock:
            self.notice, self.notice_until = text, _time.monotonic() + seconds
            self.dirty = True
        if self.on and not self.busy and not self.hold:
            with self.lock:
                self._paint()

    def answer(self, value: int) -> bool:
        """Odpowiedź na pytanie o zgodę z telefonu (/rc)."""
        with self.lock:
            d = self.dialog
            if not d:
                return False
            # „zawsze” z telefonu działa jak jednorazowe „tak”: trwałe zgody na komendy zapisuje się
            # tylko z klawiatury tego komputera (przejęty telefon nie zostawia po sobie stałych uprawnień)
            if value == 2 and any(v == 1 for v, _ in d["options"]):
                value = 1
            d["value"] = value if any(v == value for v, _ in d["options"]) else 0
            d["zdalnie"] = True
            d["done"].set()
            self.dirty = True
            return True

    def status(self, label: str | None = None, detail: str | None = None) -> None:
        with self.lock:
            if label is not None:
                self.label = label
                SYNC.set_state("busy", _plain(label))
            if detail is not None:
                self.detail = detail
            self.dirty = True

    def add_tokens(self, n: int) -> None:
        with self.lock:
            self.tokens += max(0, int(n or 0))

    def set_preview(self, text: str) -> None:
        with self.lock:
            self.preview = text
            self.dirty = True

    def tool_begin(self, header: str, icon: str = "●", detail: str = "", name: str = "", args=None) -> None:
        import time as _t
        extra = {}
        if name:
            # 23.11.2026 Log-Bot: dziennik agenta pokazuje, jakie narzędzie i z jakimi argumentami (sekrety zamaskowane)
            extra = {"nazwa": name, "argumenty": _log_clip(args if isinstance(args, str) else
                                                           json.dumps(args or {}, ensure_ascii=False, default=str))}
        _app_emit("tool_start", naglowek=_plain(header), szczegol=_plain(detail)[:2000], **extra)
        with self.lock:
            self.tool_t0 = _t.monotonic()
            self.tool_icon = icon
            self.tool_detail = detail
            if self.on:
                self.tool = header
                self.dirty = True
                return
        print()
        print(dim(icon) + " " + header)
        for row in _detail_rows(detail, self._columns() - 1, 12):
            print(row)

    def flush_tools(self) -> None:
        """Zwinięte narzędzia do transkryptu jedną szarą linią."""
        with self.lock:
            if not self.summary:
                return
            text = _summary_text(self.summary)
            self.summary = {}
        print()
        print(text)

    def tool_end(self, ok: bool, header: str, result_lines: list[str], icon: str = "",
                 name: str = "", collapse: bool = True, full=None) -> None:
        import time as _t
        icon = icon or self.tool_icon or "●"
        if full is not None:
            # 23.11.2026 Log-Bot: pełny (przycięty, bez sekretów) wynik i czas trwania narzędzia
            _app_emit("tool_result", nazwa=name, naglowek=_plain(header), ok=ok, pelny=_log_clip(str(full)),
                      ms=round((_t.monotonic() - (self.tool_t0 or _t.monotonic())) * 1000))
        with self.lock:
            had = bool(self.tool) or self.tool_paused
            after_prompt = self.tool_paused and not self.tool
            detail = self.tool_detail if (self.tool and self.on) else ""
            sync_detail = detail or self.tool_detail
            group = _summary_group(name) if (name and ok and collapse and self.on
                                             and not self.tool_paused) else None
            self.tool = ""
            self.tool_detail = ""
            self.tool_paused = False
            if group:
                self.summary[group] = self.summary.get(group, 0) + 1
                self.dirty = True
        SYNC.add("tool", {"naglowek": _plain(header), "szczegol": _plain(sync_detail),
                          "wynik": [_plain(x) for x in result_lines][:12], "ok": ok,
                          "ikona": icon})
        if group:
            return
        self.flush_tools()
        if had:
            if not after_prompt:
                print()
            print((bold(icon) if ok else red(icon)) + " " + header)
        rows = _detail_rows(detail, self._columns() - 1, 12) if detail else []
        for row in rows:
            print(row)
        for i, line in enumerate(result_lines):
            print(dim("  ⎿  " if i == 0 and not rows else "     ") + line)

    # ── okno pisania w spoczynku ─────────────────────────────────────────
    def prompt(self) -> str:
        """Czeka na wiadomość; okno pisania stoi przyklejone do dołu."""
        import time as _time
        own = not self.session
        if own and not self.session_start():
            return input(_prompt())
        if self.editor is None:
            self.editor = _Editor(SESSION.pop("draft", ""), _history_items())
        editor = self.editor
        armed_exit = 0.0
        keys = _Keys().__enter__()
        try:
            while True:
                with self.lock:
                    self.menu = _slash_matches(editor.value)
                    if self.need_sync:
                        self._erase()
                        self._sync()
                    self._paint()
                try:
                    key = keys.read(0.3)
                except KeyboardInterrupt:
                    key = "\x03"   # Ctrl+C w cbreak przychodzi jako SIGINT
                if key is None:
                    if SESSION.get("queued"):
                        return SESSION["queued"].pop(0)   # wiadomość z telefonu (/rc)
                    if self.notice and _time.monotonic() >= self.notice_until:
                        self.notice = ""
                    continue
                if key == "":
                    raise EOFError
                at_menu = bool(self.menu) and self.menu[0][0].startswith("@")
                if key == "\t" and at_menu:
                    # @ścieżka: podmieniamy tylko ostatnie słowo; folder bez spacji, żeby iść głębiej
                    pick = self.menu[0][0]
                    cut = max(editor.value.rfind(" "), editor.value.rfind("\n")) + 1
                    editor.value = editor.value[:cut] + pick + ("" if pick.endswith("/") else " ")
                    editor.cursor = len(editor.value)
                    continue
                if key == "\t" and self.menu:
                    editor.value = self.menu[0][0] + " "
                    editor.cursor = len(editor.value)
                    continue
                if key in ("\r", "\n") and self.menu and not at_menu and editor.value.strip() not in [m[0] for m in self.menu]:
                    editor.value = self.menu[0][0]
                    editor.cursor = len(editor.value)
                action = editor.feed(key)
                if action == "submit":
                    value = editor.value
                    if value.strip():
                        _history_add(value)
                    with self.lock:
                        self.editor = _Editor("", editor.history + ([value] if value.strip() else []))
                        self.menu = []
                    return value
                if action == "mode":
                    _cycle_mode()
                elif action == "escape":
                    if editor.value:
                        editor.value, editor.cursor = "", 0
                elif action == "interrupt":
                    if editor.value:
                        editor.value, editor.cursor = "", 0
                    elif _time.monotonic() < armed_exit:
                        raise KeyboardInterrupt
                    else:
                        armed_exit = _time.monotonic() + 2
                        self.notice, self.notice_until = _L("Naciśnij Ctrl+C jeszcze raz, aby wyjść"), armed_exit
                elif action == "eof":
                    raise EOFError
        finally:
            keys.__exit__()
            with self.lock:
                self.notice = ""
                self.menu = []
                self._paint()
            if own:
                self.session_end()

