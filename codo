    if summary:
        lines += [""] + summary.splitlines()[:30]
    panel(_L("Zespół skończył"), lines)
    if "merge" in (ev.get("apply_options") or []):
        print(dim(_Lf("  Scal do projektu: codo team apply {0}  ·  zostaw gałąź: codo team apply {0} --branch", rid)))


def _team_terminal_ask(ev: dict, names: dict) -> int:
    with LIVE.paused():
        print(yellow(f"  [{names.get(ev.get('member'), ev.get('member'))}] ") + bold(str(ev.get("pytanie") or "")))
        if ev.get("szczegol"):
            print(dim("    " + str(ev["szczegol"])[:600].replace("\n", "\n    ")))
        try:
            ans = input(_L("  Zgoda? t = tak, z = tak i pamiętaj, n = nie: ")).strip().lower()
        except EOFError:
            ans = "n"
    return 1 if ans in ("t", "tak", "y", "yes", "1") else 2 if ans in ("z", "2", "a", "always") else 0


def _team_terminal_decide(store, ev: dict, rid: str, interactive: bool) -> None:
    """Plan albo scalenie czekające na człowieka: pytanie w terminalu albo podpowiedź komendy."""
    plan = ev.get("type") == "team_plan"
    if plan and store.load_run().get("status") != "waiting_human":
        return   # odtworzenie starego planu, o którym już zdecydowano
    t = next((x for x in store.board()["tasks"] if x["id"] == ev.get("task_id")), None)
    if not plan and ((t or {}).get("merge") or {}).get("state") != "waiting_human":
        return
    if not interactive:
        print(dim(_Lf("    decyzja: codo team plan {0} ok|nie|\"uwagi\"", rid) if plan else
                  _Lf("    decyzja: codo team merge {0} {1} ok|nie|\"uwagi\"", rid, ev.get("task_id"))))
        return
    with LIVE.paused():
        try:
            ans = input(_L("  Zatwierdzić? t = tak, n = nie, albo wpisz uwagi: ")).strip()
        except EOFError:
            ans = "n"
    ok = ans.lower() in ("t", "tak", "y", "yes", "ok")
    notes = "" if ok or ans.lower() in ("n", "nie", "no") else ans
    if plan:
        store.control(type="plan_decide", approve=ok, notes=notes, by="terminal")
    else:
        store.control(type="merge_decide", task_id=ev.get("task_id"), approve=ok, notes=notes, by="terminal")


def _team_follow(run_dir: Path, interactive: bool, answer: bool = True) -> int:
    """Pierwszy plan: zdarzenia zespołu w terminalu, zgody z prefiksem członka, Ctrl+C wstrzymuje."""
    import time
    store, rid, seq, names, asked = TeamStore(run_dir), Path(run_dir).name, 0, {}, set()
    for m in store.load_run().get("members") or []:
        names[m["id"]] = m["name"]
    names["human"], names["all"] = _L("Ty"), _L("wszyscy")
    try:
        while True:
            for ev in store.events(since=seq):
                seq = int(ev["seq"])
                line = _team_event_line(ev, names)
                if line:
                    print(line)
                if ev.get("type") == "team_ask" and answer and ev.get("ask_id") not in asked:
                    asked.add(ev.get("ask_id"))
                    if interactive:
                        store.control(type="answer", ask_id=ev["ask_id"], value=_team_terminal_ask(ev, names), by="terminal")
                    else:
                        print(dim(_Lf("    odpowiedz: codo team answer {0} {1} t|n|z", rid, ev.get("ask_id"))))
                if answer and (ev.get("type") == "team_plan" or (ev.get("type") == "team_merge"
                                                                  and ev.get("state") == "waiting_human")):
                    _team_terminal_decide(store, ev, rid, interactive)
                if answer and ev.get("type") == "team_question":
                    print(dim(_Lf("    odpowiedz: codo team say {0} {1} \"tekst\"", rid, ev.get("from"))))
                if ev.get("type") == "team_done":
                    _team_print_done(ev, rid)
                    return 0 if ev.get("status") in ("review_final", "done") else 1
            run = store.load_run()
            if run.get("status") == "paused":
                print(dim(_Lf("  Zespół wstrzymany. Wznów: codo team resume {0}", rid)))
                return 0
            if run.get("status") in _TEAM_RESUMABLE and run.get("supervisor_pid") and not _pid_alive(run["supervisor_pid"]) \
                    and _team_age(run.get("heartbeat")) > 30:
                print(red(_L("✗ Nadzorca zespołu przestał działać.")) + dim(_Lf(" Wznów: codo team resume {0}", rid)))
                return 1
            time.sleep(0.3)
    except KeyboardInterrupt:
        print(dim(_L("\n  Wstrzymuję zespół…")))
        store.control(type="pause", by="terminal")
        for _ in range(60):
            if store.load_run().get("status") == "paused" or not _team_sup_alive(store.load_run()):
                break
            time.sleep(0.25)
        print(dim(_Lf("  Wstrzymano. Wznów: codo team resume {0}", rid)))
        return 130


def _team_parse_member(spec: str) -> dict | None:
    parts = spec.split(":")
    if len(parts) < 2 or not parts[0].strip():
        return None
    if parts[1] == "agent" and len(parts) > 2:
        parts = [parts[0], "agent:" + parts[2]] + parts[3:]
    writes = (parts[3].strip().lower() not in ("czyta", "nie", "0", "ro", "read", "false")) if len(parts) > 3 else True
    return {"id": parts[0].strip(), "name": parts[0].strip().capitalize(), "brain": parts[1].strip(),
            "role": parts[2].strip() if len(parts) > 2 else "", "writes": writes,
            "isolation": "copy" if writes else "readonly"}


