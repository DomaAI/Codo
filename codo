def t_scaffold(args):
    """Tworzy projekt od podstaw z gotowego szablonu (nie nadpisuje plików)."""
    template = (args.get("template") or "static").lower()
    rel = args.get("path") or "."
    name = args.get("name") or (Path(rel).name if rel != "." else Path.cwd().name)
    files = _scaffold_files(template, name)
    if files is None:
        return ("BŁĄD: nieznany szablon '%s'. Dostępne: %s. Inny stos (React, Next, Django…) "
                "załóż oficjalnym generatorem przez run_command w trybie nieinteraktywnym."
                % (template, ", ".join(SCAFFOLD_TEMPLATES)))
    base = _safe_path(rel)
    base.mkdir(parents=True, exist_ok=True)
    written, skipped = [], []
    for frel, content in files.items():
        p = _safe_path(str(Path(rel) / frel))
        p.parent.mkdir(parents=True, exist_ok=True)
        if p.exists():
            skipped.append(frel)
            continue
        p.write_text(content, encoding="utf-8")   # jawnie: na Windows domyślne cp1250 psuło polskie znaki
        written.append(frel)
    msg = f"Szablon '{template}' w {base}: utworzono {len(written)} plików"
    if written:
        msg += " (" + ", ".join(written) + ")"
    if skipped:
        msg += f"; pominięto istniejące: {', '.join(skipped)}"
    nxt = _SCAFFOLD_NEXT.get(template)
    if nxt and written:
        msg += f"\nDalej: {nxt}"
    return msg


# ── Plan zadań (trwały w .doma/plan.json) ─────────────────────
_PLAN_FILE = ".doma/plan.json"
_PLAN_ICON = {"todo": "○", "doing": "▶", "done": "✓", "blocked": "✗"}


def _plan_load():
    try:
        return json.loads((Path.cwd() / _PLAN_FILE).read_text())
    except (OSError, ValueError):
        return None


def _plan_save(plan):
    p = Path.cwd() / _PLAN_FILE
    p.parent.mkdir(parents=True, exist_ok=True)
    p.write_text(json.dumps(plan, ensure_ascii=False, indent=2))


def _plan_render(plan):
    if not plan or not plan.get("tasks"):
        return "(brak planu)"
    lines = [f"Cel: {plan.get('goal', '')}"]
    for t in plan["tasks"]:
        mark = _PLAN_ICON.get(t.get("status", "todo"), "○")
        note = f"  — {t['note']}" if t.get("note") else ""
        lines.append(f"  {mark} {t['id']}. {t['title']}{note}")
    done = sum(1 for t in plan["tasks"] if t.get("status") == "done")
    lines.append(f"Postęp: {done}/{len(plan['tasks'])}")
    return "\n".join(lines)


def t_plan_write(args):
    """Utwórz/zastąp plan pracy — lista konkretnych zadań do celu."""
    import time as _time
    raw = args.get("tasks") or []
    tasks = []
    for i, t in enumerate(raw, 1):
        title = t if isinstance(t, str) else (t.get("title") or "")
        tasks.append({"id": i, "title": title, "status": "todo", "note": ""})
    plan = {"goal": args.get("goal", ""),
            "created": _time.strftime("%Y-%m-%d %H:%M:%S"), "tasks": tasks}
    _plan_save(plan)
    return "Plan zapisany:\n" + _plan_render(plan)


def t_plan_update(args):
    """Zmień status zadania (todo|doing|done|blocked) i/lub notatkę."""
    plan = _plan_load()
    if not plan:
        return "BŁĄD: brak planu — najpierw plan_write."
    tid = int(args.get("id") or 0)
    for t in plan["tasks"]:
        if t["id"] == tid:
            st = args.get("status")
            if st in _PLAN_ICON:
                t["status"] = st
            if args.get("note") is not None:
                t["note"] = args["note"]
            _plan_save(plan)
            return _plan_render(plan)
    return f"BŁĄD: brak zadania #{tid}."


def t_plan_status(args):
    return _plan_render(_plan_load())


