WORKFLOWS_FILE = CONFIG_DIR / "workflows.json"
_UI_OFFICE: dict = {"bridge": None, "mem": {}, "key": "", "lock": threading.Lock()}
_UI_OFFICE_KINDS = (".deck.html", ".doc.html", ".sheet.html")
_UI_OFFICE_MIME = {"html": "text/html; charset=utf-8", "css": "text/css; charset=utf-8",
                   "js": "text/javascript; charset=utf-8", "png": "image/png", "jpg": "image/jpeg",
                   "jpeg": "image/jpeg", "gif": "image/gif", "webp": "image/webp", "svg": "image/svg+xml",
                   "avif": "image/avif", "bmp": "image/bmp", "ico": "image/x-icon", "json": "application/json",
                   "woff2": "font/woff2", "woff": "font/woff", "ttf": "font/ttf", "otf": "font/otf"}


def _ui_workflows_read():
    try:
        d = json.loads(WORKFLOWS_FILE.read_text(encoding="utf-8"))
    except (OSError, ValueError):
        return None               # brak pliku: okno zakłada gotowe workflowy (jak WorkflowStore na Macu)
    return d if isinstance(d, list) else None


def _ui_workflows_write(data) -> bool:
    if not isinstance(data, list) or not all(isinstance(w, dict) and w.get("id") for w in data):
        return False
    _atomic_write(WORKFLOWS_FILE, json.dumps(data, ensure_ascii=False, indent=2, sort_keys=True).encode("utf-8"))
    return True


def _ui_office_folder() -> Path:
    env = os.environ.get("CODO_OFFICE_FOLDER")
    if env:
        return Path(env).expanduser().resolve()
    saved = str(load_settings().get("office_folder") or "")
    if saved and Path(saved).is_dir():
        return Path(saved).resolve()
    return (Path.home() / "Documents" / "Codo").resolve()


def _ui_office_path(rel: str) -> Path | None:
    """Plik w folderze Biura (bez wychodzenia poza folder)."""
    base = _ui_office_folder()
    rel = str(rel or "").replace("\\", "/").lstrip("/")
    if not rel or "\x00" in rel:
        return None
    p = (base / rel).resolve()
    return p if str(p).startswith(str(base) + os.sep) else None


def _ui_office_list() -> dict:
    base = _ui_office_folder()
    files = []
    try:
        for p in base.iterdir():
            n = p.name
            kind = next((k for k in _UI_OFFICE_KINDS if n.lower().endswith(k)), "")
            if not kind or n.startswith(".") or not p.is_file():
                continue
            size = ""
            if kind == ".deck.html":
                try:
                    with open(p, "rb") as fh:
                        m = re.search(rb'data-size="([a-z0-9-]+)"', fh.read(600))
                    size = m.group(1).decode() if m else ""
                except OSError:
                    pass
            files.append({"name": n, "kind": kind.split(".")[1], "size": size, "modified": p.stat().st_mtime})
    except OSError:
        pass
    files.sort(key=lambda f: -f["modified"])
    if not _UI_OFFICE["key"]:
        _UI_OFFICE["key"] = os.urandom(18).hex()
    home = base == (Path.home() / "Documents" / "Codo").resolve() or bool(os.environ.get("CODO_OFFICE_FOLDER"))
    return {"folder": str(base), "home": str(Path.home()), "files": files, "key": _UI_OFFICE["key"],
            "guide": "Codo.md" if home else ".office/GUIDE.md"}


def _ui_office_bridge(main) -> "_UiBridge":
    with _UI_OFFICE["lock"]:
        b = _UI_OFFICE["bridge"]
        folder = _ui_office_folder()
        if b is not None and getattr(b, "cwd", None) != folder:
            b.stop()
            b = None
        if b is None:
            folder.mkdir(parents=True, exist_ok=True)
            b = _UiBridge(main.script, main.model)
            b.cwd = folder
            b.start()
            import atexit
            atexit.register(b.stop)
            _UI_OFFICE["bridge"] = b
        return b


def _ui_office_post(path: str, msg: dict, main) -> tuple:
    import base64
    if path == "/api/office/send":
        if msg.get("type") not in _UI_SEND_TYPES:
            return 400, {"ok": False, "error": "type"}
        return (200, {"ok": True}) if _ui_office_bridge(main).write(msg) else (503, {"ok": False})
    if path == "/api/office/folder":
        f = str(msg.get("folder") or "")
        st = load_settings()
        st["office_folder"] = "" if not f or Path(f).expanduser().resolve() == (Path.home() / "Documents" / "Codo").resolve() else str(Path(f).expanduser().resolve())
        if st["office_folder"] and not Path(st["office_folder"]).is_dir():
            return 400, {"ok": False, "error": "folder"}
        save_settings(st)
        return 200, {"ok": True, **_ui_office_list()}
    if path == "/api/office/prepare":
        # Jak OfficeStore.prepare(): style i odtwarzacz w .office/, zasady formatu w Codo.md (folder Biura)
        # albo .office/GUIDE.md (folder projektu). Skrypty edytora tylko w pamięci.
        mem = msg.get("mem") if isinstance(msg.get("mem"), dict) else {}
        if isinstance(msg.get("strings"), dict):
            _UI_OFFICE["strings"] = {str(k): str(v) for k, v in msg["strings"].items()}
        _UI_OFFICE["mem"].update({str(k): str(v) for k, v in mem.items() if k in ("editor.js", "sheet.js", "deck.css", "doc.css", "sheet.css", "view.js")})
        base = _ui_office_folder()
        (base / ".office").mkdir(parents=True, exist_ok=True)
        for name in ("deck.css", "doc.css", "sheet.css", "view.js"):
            text = _UI_OFFICE["mem"].get(name)
            if text is not None:
                dst = base / ".office" / name
                try:
                    if not dst.exists() or dst.read_text(encoding="utf-8") != text:
                        _atomic_write(dst, text.encode("utf-8"))
                except OSError:
                    pass
        guide = str(msg.get("guide") or "").strip()
        if guide:
            home = base == (Path.home() / "Documents" / "Codo").resolve() or bool(os.environ.get("CODO_OFFICE_FOLDER"))
            memory = base / ("Codo.md" if home else ".office/GUIDE.md")
            end = "<!-- /codo-office-guide -->"
            try:
                old = memory.read_text(encoding="utf-8")
            except OSError:
                old = ""
            block = guide + "\n" + end
            a, b = old.find("<!-- codo-office-guide"), old.find(end)
            new = old[:a] + block + old[b + len(end):] if 0 <= a < b else block + ("\n" if not old else "\n\n" + old)
            if new != old:
                _atomic_write(memory, new.encode("utf-8"))
        return 200, {"ok": True, **_ui_office_list()}
    if path in ("/api/office/import", "/api/office/reveal"):
        return _ui_office_import(msg) if path.endswith("import") else _ui_office_reveal(msg)
    if path == "/api/office/workflows":
        ok = _ui_workflows_write(msg.get("workflows"))
        return (200 if ok else 400), {"ok": ok}
    p = _ui_office_path(str(msg.get("p") or ""))
    if p is None:
        return 400, {"ok": False, "error": "path"}
    if path == "/api/office/write":
        if "b64" in msg:
            data = base64.b64decode(str(msg.get("b64") or ""))
        else:
            data = str(msg.get("text") or "").encode("utf-8")
        if msg.get("fresh"):       # nowy plik: wolna nazwa jak OfficeStore.freeURL
            stem, ext = p.name, ""
            for k in _UI_OFFICE_KINDS + (".png", ".jpg", ".jpeg", ".gif", ".webp", ".svg", ".txt", ".md"):
                if stem.lower().endswith(k):
                    stem, ext = stem[:-len(k)], stem[-len(k):]
                    break
            n = 2
            while p.exists():
                p = p.with_name(f"{stem} {n}{ext}" if ext in _UI_OFFICE_KINDS else f"{stem}-{n}{ext}")
                n += 1
        _atomic_write(p, data)
        return 200, {"ok": True, "name": str(p.relative_to(_ui_office_folder())).replace("\\", "/"),
                     "modified": p.stat().st_mtime}
    if path == "/api/office/delete":
        try:
            p.unlink()
        except OSError:
            return 404, {"ok": False}
        return 200, {"ok": True}
    if path == "/api/office/rename":
        to = _ui_office_path(str(msg.get("to") or ""))
        if to is None or to.exists() or not p.exists():
            return 409, {"ok": False}
        p.rename(to)
        return 200, {"ok": True, "name": to.name}
    return 404, {"ok": False}


# Biuro: pliki z innych programów jak na Macu (SheetImport, DocxImport, PptxImport w OfficeExport.swift,
# OfficeSources w OfficeView.swift). Bez dodatkowych bibliotek: zipfile + wyrażenia, PDF przez zlib.
# /api/office/import {name, b64, mode}: mode "open" = nowy plik Biura (arkusz, dokument, prezentacja),
# "source" = materiał dla Codo (tekst w .office/sources/, obrazy w media/). /api/office/reveal: folder w systemie.
_OFFICE_PICTURES = ("png", "jpg", "jpeg", "gif", "webp", "heic", "svg")


def _office_unescape(s: str) -> str:
    return (s.replace("&lt;", "<").replace("&gt;", ">").replace("&quot;", '"').replace("&apos;", "'")
            .replace("&amp;", "&"))


def _office_esc(s: str) -> str:
    return s.replace("&", "&amp;").replace("<", "&lt;").replace(">", "&gt;").replace('"', "&quot;")


def _office_zip(data: bytes):
    import io
    import zipfile
    try:
        return zipfile.ZipFile(io.BytesIO(data))
    except (zipfile.BadZipFile, ValueError, OSError):
        return None


def _office_part(z, name: str, raw: bool = False):
    try:
        if z.getinfo(name).file_size > 64 << 20:      # bez rozpakowywania bomb
            return None
        data = z.read(name)
    except (KeyError, OSError, RuntimeError, ValueError):
        return None
    if not data:
        return None
    return data if raw else data.decode("utf-8", "replace")


def _office_rels(text: str) -> dict:
    out = {}
    for m in re.findall(r"<Relationship [^>]*?/>", text or "", re.S):
        i, t = re.search(r'Id="([^"]+)"', m), re.search(r'Target="([^"]+)"', m)
        if i and t:
            out[i.group(1)] = t.group(1)
    return out


def _office_target(base: str, target: str) -> str:
    """Ścieżka części z relacji: względem folderu części (../media/x.png) albo od korzenia (/ppt/x)."""
    if target.startswith("/"):
        return target[1:]
    parts = base.rstrip("/").split("/") if base else []
    for seg in target.split("/"):
        if seg == "..":
            parts = parts[:-1]
        elif seg and seg != ".":
            parts.append(seg)
    return "/".join(parts)


def _office_add_media(folder: Path, data: bytes, name: str) -> str | None:
    """Jak OfficeStore.addMedia: media/<nazwa>, ten sam plik nie dubluje się."""
    media = folder / "media"
    try:
        media.mkdir(parents=True, exist_ok=True)
    except OSError:
        return None
    stem, _, ext = name.rpartition(".") if "." in name else (name, "", "")
    stem = "-".join(x for x in re.split(r"[^\w-]+", stem) if x).lower()[:40] or "obraz"
    ext = re.sub(r"[^a-z0-9]", "", ext.lower())[:8] or "png"  # nazwa z wnętrza pliku: bez / i ..
    dst, n = media / f"{stem}.{ext}", 2
    while dst.exists():
        try:
            if dst.read_bytes() == data:
                return "media/" + dst.name
        except OSError:
            pass
        dst, n = media / f"{stem}-{n}.{ext}", n + 1
    try:
        _atomic_write(dst, data)
    except OSError:
        return None
    return "media/" + dst.name


def _office_sheet_table(data: bytes, ext: str) -> str | None:
    """SheetImport.table: każdy arkusz skoroszytu jako <table> (nazwa w data-name), CSV jako jedna tabela."""
    sheets = []
    if ext in ("xlsx", "xlsm"):
        z = _office_zip(data)
        if z is None:
            return None
        book, target = _office_part(z, "xl/workbook.xml") or "", _office_rels(_office_part(z, "xl/_rels/workbook.xml.rels") or "")
        shared = [_office_unescape("".join(re.findall(r"<t[^>]*>(.*?)</t>", si, re.S)))
                  for si in re.findall(r"<si>(.*?)</si>", _office_part(z, "xl/sharedStrings.xml") or "", re.S)]
        percent = set()
        xfs = re.search(r"<cellXfs[^>]*>(.*?)</cellXfs>", _office_part(z, "xl/styles.xml") or "", re.S)
        for i, xf in enumerate(re.findall(r"<xf ([^>]*?)/?>", xfs.group(1) if xfs else "", re.S)):
            if 'numFmtId="9"' in xf or 'numFmtId="10"' in xf:
                percent.add(i)
        for m in re.findall(r"<sheet [^>]*?/>", book, re.S):
            rid = re.search(r'r:id="([^"]+)"', m)
            t = target.get(rid.group(1)) if rid else None
            if not t:
                continue
            g = _office_xlsx_grid(_office_part(z, _office_target("xl", t)), shared, percent)
            if g:
                nm = re.search(r'name="([^"]*)"', m)
                sheets.append((_office_unescape(nm.group(1)) if nm else "", g))
        if not sheets:
            g = _office_xlsx_grid(_office_part(z, "xl/worksheets/sheet1.xml"), shared, percent)
            if g:
                sheets = [("", g)]
    else:
        try:
            text = data.decode("utf-8")
        except UnicodeDecodeError:
            text = data.decode("cp1250", "replace")
        text = text.replace("﻿", "")
        first = text[:2000]
        sep = ("\t" if "\t" in first and ";" not in first else ";") if first.count(";") >= first.count(",") else ","
        if ext == "tsv":
            sep = "\t"
        rows, row, field, quoted, i = [], [], "", False, 0
        while i < len(text):
            ch = text[i]
            i += 1
            if quoted:
                if ch == '"':
                    if text[i:i + 1] == '"':
                        field += '"'
                        i += 1
                    else:
                        quoted = False
                else:
                    field += ch
            elif ch == '"':
                quoted = True
            elif ch == sep:
                row.append((field, ""))
                field = ""
            elif ch == "\n":
                row.append((field, ""))
                rows.append(row)
                row, field = [], ""
            elif ch != "\r":
                field += ch
        if field or row:
            row.append((field, ""))
            rows.append(row)
        g = [r[:60] for r in rows[:2000]]
        if g:
            sheets = [("", g)]
    tables = []
    for name, grid in sheets:
        width = max((len(r) for r in grid), default=0)
        if not width:
            continue
        out = "<table" + (f' data-name="{_office_esc(name)}"' if name and len(sheets) > 1 else "") + ">\n<thead>\n"
        for r, row in enumerate(grid):
            tag = "th" if r == 0 else "td"
            out += "<tr>"
            for c in range(width):
                text, formula = row[c] if c < len(row) else ("", "")
                f = f' data-f="={_office_esc(formula)}"' if formula else ""
                if text.endswith("%") and formula:
                    f = ' class="pct"' + f
                out += f"<{tag}{f}>{_office_esc(text)}</{tag}>"
            out += "</tr>\n"
            if r == 0:
                out += "</thead>\n<tbody>\n"
        tables.append(out + "</tbody>\n</table>")
    return "\n\n".join(tables) or None


def _office_xlsx_grid(sheet: str | None, shared: list, percent: set) -> list:
    if not sheet:
        return []
    grid = []
    for row in re.findall(r"<row[^>]*>(.*?)</row>", sheet, re.S)[:2000]:
        line = []
        for attrs, body in re.findall(r"<c\b([^>]*?)(?:/>|>(.*?)</c>)", row, re.S):
            ref = re.search(r'\br="([A-Z]+)\d+"', attrs)
            col = 0
            for ch in (ref.group(1) if ref else ""):
                col = col * 26 + ord(ch) - 64
            if not col:
                col = len(line) + 1
            if col > 60:
                continue
            while len(line) < col - 1:
                line.append(("", ""))
            v = re.search(r"<v>(.*?)</v>", body or "", re.S)
            v = v.group(1) if v else ""
            fm = re.search(r"<f[^>]*>(.*?)</f>", body or "", re.S)
            f = _office_unescape(fm.group(1)) if fm else ""
            text = _office_unescape(v)
            st = re.search(r'\bs="(\d+)"', attrs)
            try:
                d = float(v)
            except ValueError:
                d = None
            if 't="s"' in attrs:
                text = shared[int(v)] if v.isdigit() and int(v) < len(shared) else ""
            elif 't="inlineStr"' in attrs:
                text = _office_unescape("".join(re.findall(r"<t[^>]*>(.*?)</t>", body or "", re.S)))
            elif 't="str"' in attrs or 't="e"' in attrs or 't="b"' in attrs or d is None or d != d:
                pass
            elif st and int(st.group(1)) in percent:
                text = ("%.1f" % (d * 100)).replace(".0", "").replace(".", ",") + "%"
            elif d != round(d):
                text = ("%.2f" % d).replace(".", ",")
            else:
                text = str(int(d))
            line.append((text, f))
        grid.append(line)
    while grid and all(not t and not f for t, f in grid[-1]):
        grid.pop()
    return grid


def _office_docx_html(data: bytes, add_media=None) -> str | None:
    """DocxImport.html: style akapitów to nagłówki, numeracja to listy, tabele zostają tabelami,
    obrazy idą do media/ (na Macu zostają w Wordzie)."""
    z = _office_zip(data)
    if z is None:
        return None
    doc = _office_part(z, "word/document.xml")
    m = re.search(r"<w:body>(.*)</w:body>", doc or "", re.S)
    if not m:
        return None
    body = m.group(1)
    style_name = {a: b.lower() for a, b in re.findall(
        r'<w:style [^>]*?w:styleId="([^"]+)"[^>]*>\s*<w:name w:val="([^"]+)"', _office_part(z, "word/styles.xml") or "", re.S)}
    numbering = _office_part(z, "word/numbering.xml") or ""
    abstract = {a for a, inner in re.findall(r'<w:abstractNum [^>]*?w:abstractNumId="(\d+)"[^>]*>(.*?)</w:abstractNum>', numbering, re.S)
                if (re.search(r'<w:numFmt w:val="([^"]+)"', inner) or [None, ""])[1] == "bullet"}
    bullets = {n for n, a in re.findall(r'<w:num [^>]*?w:numId="(\d+)"[^>]*>\s*<w:abstractNumId w:val="(\d+)"', numbering, re.S) if a in abstract}
    rels = _office_rels(_office_part(z, "word/_rels/document.xml.rels") or "")
    pictures: dict = {}

    def picture(rid: str) -> str:
        if rid in pictures:
            return pictures[rid]
        pictures[rid] = ""
        t = rels.get(rid)
        if t and add_media:
            part = _office_target("word", t)
            raw = _office_part(z, part, raw=True)
            if raw:
                saved = add_media(raw, part.rsplit("/", 1)[-1])
                if saved:
                    pictures[rid] = f'<figure><img src="{_office_esc(saved)}" alt=""></figure>'
        return pictures[rid]

    def runs(p: str) -> str:
        out = ""
        for x in re.findall(r"<w:r[ >](.*?)</w:r>", p, re.S):
            if '<w:br w:type="page"' in x:
                continue
            text = ""
            for piece, t in re.findall(r"(<w:t(?: [^>]*)?>(.*?)</w:t>|<w:br/>|<w:tab/>)", x, re.S):
                text += "<br>" if piece.startswith("<w:br") else (" " if piece.startswith("<w:tab") else t)
            if not text:
                continue
            pm = re.search(r"<w:rPr>(.*?)</w:rPr>", x, re.S)
            props = pm.group(1) if pm else ""

            def on(tag: str) -> bool:
                return f"<w:{tag}/>" in props or (f"<w:{tag} " in props and f'<w:{tag} w:val="0"' not in props
                                                  and f'<w:{tag} w:val="false"' not in props)
            if on("b"):
                text = f"<b>{text}</b>"
            if on("i"):
                text = f"<i>{text}</i>"
            out += text
        return out.replace("</b><b>", "").replace("</i><i>", "")

    out, lst, has_title = [], None, False

    def close_list():
        nonlocal lst
        if lst:
            out.append(f"<{lst[0]}>\n" + "\n".join(f"<li>{i}</li>" for i in lst[1]) + f"\n</{lst[0]}>")
        lst = None

    for b in re.findall(r"<w:tbl>.*?</w:tbl>|<w:p[ >].*?</w:p>|<w:p/>", body, re.S):
        if b.startswith("<w:tbl>"):
            close_list()
            table = "<table>\n"
            for i, row in enumerate(re.findall(r"<w:tr[ >](.*?)</w:tr>", b, re.S)):
                tag, cells = ("th" if i == 0 else "td"), []
                for cell in re.findall(r"<w:tc>(.*?)</w:tc>", row, re.S):
                    text = "<br>".join(t for t in (runs(p) for p in re.findall(r"<w:p[ >].*?</w:p>", cell, re.S)) if t)
                    right = ' class="n"' if '<w:jc w:val="right"' in cell else ""
                    cells.append(f"<{tag}{right}>{re.sub(r'</?b>', '', text) if i == 0 else text}</{tag}>")
                table += (f"<thead>\n<tr>{''.join(cells)}</tr>\n</thead>\n<tbody>\n" if i == 0 else f"<tr>{''.join(cells)}</tr>\n")
            out.append(table + "</tbody>\n</table>")
            continue
        if '<w:br w:type="page"' in b:
            close_list()
            out.append('<hr class="page">')
        for rid in re.findall(r'<a:blip [^>]*?r:embed="([^"]+)"', b):
            pic = picture(rid)
            if pic:
                close_list()
                out.append(pic)
        text = runs(b)
        if not text:
            continue
        pm = re.search(r"<w:pPr>(.*?)</w:pPr>", b, re.S)
        props = pm.group(1) if pm else ""
        sid = re.search(r'<w:pStyle w:val="([^"]+)"', props)
        sid = sid.group(1) if sid else ""
        style = style_name.get(sid, sid.lower())
        num = re.search(r'<w:numId w:val="(\d+)"', props)
        if num and num.group(1) != "0":
            tag = "ul" if num.group(1) in bullets else "ol"
            if not lst or lst[0] != tag:
                close_list()
                lst = (tag, [])
            lst[1].append(text)
            continue
        close_list()
        plain = re.sub(r"</?b>", "", text)
        if style == "title":
            out.append(f"<h2>{plain}</h2>" if has_title else f"<h1>{plain}</h1>")
            has_title = True
        elif style == "heading 1":
            out.append(f"<h2>{plain}</h2>")
        elif style == "heading 2":
            out.append(f"<h3>{plain}</h3>")
        elif style in ("heading 3", "heading 4"):
            out.append(f"<h4>{plain}</h4>")
        elif style in ("subtitle", "lead"):
            out.append(f'<p class="lead">{text}</p>')
        elif style in ("meta", "caption"):
            out.append(f'<p class="meta">{text}</p>')
        elif style in ("quote", "intense quote"):
            out.append(f"<blockquote>{text}</blockquote>")
        else:
            align = ' style="text-align:center"' if '<w:jc w:val="center"' in props else (
                ' style="text-align:right"' if '<w:jc w:val="right"' in props else "")
            out.append(f"<p{align}>{text}</p>")
    close_list()
    return "\n".join(out) or None


def _office_pptx_html(data: bytes, add_media=None) -> str | None:
    """PptxImport.html: tytuły, punkty, obrazy i notatki prelegenta jako slajdy Biura (wygląd z motywu)."""
    z = _office_zip(data)
    if z is None:
        return None
    pres, rels = _office_part(z, "ppt/presentation.xml"), _office_part(z, "ppt/_rels/presentation.xml.rels")
    if not pres or not rels:
        return None
    target = _office_rels(rels)
    order = [target[r] for r in re.findall(r'<p:sldId [^>]*?r:id="([^"]+)"', pres, re.S) if r in target]

    def text(shape: str) -> list:
        lines = []
        for a, b in re.findall(r"<a:p>(.*?)</a:p>|<a:p [^>]*>(.*?)</a:p>", shape, re.S):
            body = a or b
            t = "".join("<br>" if whole == "<a:br/>" else _office_esc(_office_unescape(inner))
                        for whole, inner in re.findall(r"(<a:t>(.*?)</a:t>|<a:br/>)", body, re.S))
            lvl = re.search(r'<a:pPr [^>]*?lvl="(\d)"', body)
            if t.strip():
                lines.append((t, int(lvl.group(1)) if lvl else 0))
        return lines

    out = []
    for n, path in enumerate(order):
        part = _office_target("ppt", path)
        xml = _office_part(z, part)
        if not xml:
            continue
        folder, name = part.rsplit("/", 1)
        rel = _office_rels(_office_part(z, f"{folder}/_rels/{name}.rels") or "")
        title, subtitle, points, extra = "", "", [], []
        for sp in re.findall(r"<p:sp>(.*?)</p:sp>", xml, re.S):
            lines = text(sp)
            if not lines:
                continue
            ph = re.search(r"<p:ph([^>]*)/?>", sp)
            kind = (re.search(r'type="([^"]+)"', ph.group(1)) or [None, "body"])[1] if ph else "box"
            if kind in ("title", "ctrTitle"):
                title = " ".join(t for t, _ in lines)
            elif kind == "subTitle":
                subtitle = " ".join(t for t, _ in lines)
            elif kind == "body":
                points += lines
            elif kind in ("sldNum", "dt", "ftr"):
                continue
            else:
                extra += [t for t, _ in lines]
        picture = ""
        emb = re.search(r'<p:pic>.*?r:embed="([^"]+)"', xml, re.S)
        if emb and emb.group(1) in rel and add_media:
            media = _office_target(folder, rel[emb.group(1)])
            raw = _office_part(z, media, raw=True)
            saved = add_media(raw, media.rsplit("/", 1)[-1]) if raw else None
            if saved:
                picture = f'<div class="media"><img src="{_office_esc(saved)}" alt=""></div>'
        notes = ""
        nt = next((t for t in rel.values() if "notesSlide" in t), None)
        nx = _office_part(z, _office_target(folder, nt)) if nt else None
        for sp in re.findall(r"<p:sp>(.*?)</p:sp>", nx or "", re.S):
            if 'type="body"' in sp:
                notes = " ".join(t for t, _ in text(sp))
        aside = f'\n  <aside class="notes">{notes}</aside>' if notes else ""
        if not title and extra:
            title = extra.pop(0)
        if n == 0 or (not points and not extra and not picture and subtitle):
            out.append(f'<section class="slide title">\n  <h1>{title}</h1>' + (f'\n  <p class="lead">{subtitle}</p>' if subtitle else "")
                       + "".join(f"\n  <p>{e}</p>" for e in extra) + aside + "\n</section>")
            continue
        body = f"\n  <h2>{title}</h2>" if title else ""
        if subtitle:
            body += f'\n  <p class="lead">{subtitle}</p>'
        if len(points) == 1:
            body += f"\n  <p>{points[0][0]}</p>"
        elif points:
            body += "\n  <ul>"
            i = 0
            while i < len(points):
                item, subs, top = points[i][0], [], points[i][1]
                while i + 1 < len(points) and points[i + 1][1] > top and len(subs) <= 20:
                    subs.append(points[i + 1][0])
                    i += 1
                if subs:
                    item += "<ul>" + "".join(f"<li>{s}</li>" for s in subs) + "</ul>"
                body += f"\n    <li>{item}</li>"
                i += 1
            body += "\n  </ul>"
        body += "".join(f"\n  <p>{e}</p>" for e in extra)
        cls = "slide media-right" if picture else "slide"
        out.append(f'<section class="{cls}">{body}' + (f"\n  {picture}" if picture else "") + aside + "\n</section>")
    return "\n\n".join(out) or None


def _office_pdf_text(data: bytes) -> str | None:
    """Zwykły tekst z PDF: strumienie treści stron (FlateDecode przez zlib, strumienie obiektów też),
    napisy z Tj/TJ/'/", czcionki z ToUnicode. Bez szyfrowanych plików i bez rozpoznawania skanów."""
    import zlib
    if not data.startswith(b"%PDF") or re.search(rb"/Encrypt\s", data[-4096:] + data[:4096]):
        return None
    objs: dict = {}

    def inflate(d: bytes, head: bytes) -> bytes | None:
        if b"/FlateDecode" in head or b"/Fl " in head or b"/Fl]" in head:
            try:
                return zlib.decompressobj().decompress(d, 64 << 20)
            except zlib.error:
                return None
        if re.search(rb"/(DCT|JPX|CCITTFax|JBIG2|LZW|RunLength|ASCII85|ASCIIHex)", head):
            return None
        return d

    for m in re.finditer(rb"(\d+)\s+\d+\s+obj\b(.*?)endobj", data, re.S):
        body, stream = m.group(2), None
        s = re.search(rb"stream\r?\n", body)
        if s:
            head, rest = body[:s.start()], body[s.end():]
            e = rest.rfind(b"endstream")
            stream = inflate(rest[:e if e >= 0 else len(rest)].rstrip(b"\r\n"), head)
            body = head
        objs[int(m.group(1))] = (body, stream)
    for num, (body, stream) in list(objs.items()):       # obiekty w strumieniach obiektów (PDF 1.5+)
        if stream and b"/ObjStm" in body:
            n, first = re.search(rb"/N\s+(\d+)", body), re.search(rb"/First\s+(\d+)", body)
            if not n or not first:
                continue
            nums = [int(x) for x in stream[:int(first.group(1))].split()]
            pairs = list(zip(nums[0::2], nums[1::2]))[:int(n.group(1))]
            for i, (on, off) in enumerate(pairs):
                end = pairs[i + 1][1] if i + 1 < len(pairs) else len(stream) - int(first.group(1))
                objs.setdefault(on, (stream[int(first.group(1)) + off:int(first.group(1)) + end], None))

    def ref(b: bytes, key: bytes):
        m = re.search(rb"/" + key + rb"\s+(\d+)\s+\d+\s+R", b)
        return int(m.group(1)) if m else None

    def dict_of(b: bytes, key: bytes) -> bytes:
        r = ref(b, key)
        if r is not None:
            return objs.get(r, (b"", None))[0]
        m = re.search(rb"/" + key + rb"\s*<<", b)
        if not m:
            return b""
        depth, i = 1, m.end()
        while i < len(b) and depth:
            two = b[i:i + 2]
            depth += 1 if two == b"<<" else -1 if two == b">>" else 0
            i += 2 if two in (b"<<", b">>") else 1
        return b[m.end():i - 2]

    cmaps: dict = {}

    def cmap(fnum) -> tuple:
        if fnum in cmaps:
            return cmaps[fnum]
        body = objs.get(fnum, (b"", None))[0]
        r = ref(body, b"ToUnicode")
        cm = objs.get(r, (b"", None))[1] if r is not None else None
        table, width = {}, 2 if b"/Type0" in body else 1
        if cm:
            cs = re.search(rb"begincodespacerange\s*<([0-9A-Fa-f]+)>", cm)
            if cs:
                width = max(1, len(cs.group(1)) // 2)

            def uni(h: bytes) -> str:
                try:
                    return bytes.fromhex(h.decode()).decode("utf-16-be", "replace")
                except ValueError:
                    return ""
            for blk in re.findall(rb"beginbfchar(.*?)endbfchar", cm, re.S):
                for a, b in re.findall(rb"<([0-9A-Fa-f]+)>\s*<([0-9A-Fa-f]*)>", blk):
                    table[int(a, 16)] = uni(b)
            for blk in re.findall(rb"beginbfrange(.*?)endbfrange", cm, re.S):
                for a, b, rest in re.findall(rb"<([0-9A-Fa-f]+)>\s*<([0-9A-Fa-f]+)>\s*(\[[^\]]*\]|<[0-9A-Fa-f]+>)", blk):
                    lo, hi = int(a, 16), int(b, 16)
                    if hi - lo > 65535:
                        continue
                    if rest.startswith(b"["):
                        for i, h in enumerate(re.findall(rb"<([0-9A-Fa-f]*)>", rest)):
                            table[lo + i] = uni(h)
                    else:
                        start = int(rest[1:-1], 16)
                        for i in range(hi - lo + 1):
                            table[lo + i] = chr(start + i) if start + i < 0x110000 else ""
        cmaps[fnum] = (table, width)
        return cmaps[fnum]

    def decode(raw: bytes, font) -> str:
        table, width = cmap(font) if font is not None else ({}, 1)
        if not table:
            mac = font is not None and b"/MacRomanEncoding" in objs.get(font, (b"", None))[0]
            return raw.decode("mac_roman" if mac else "cp1252", "replace")
        out = []
        for i in range(0, len(raw) - width + 1, width):
            code = int.from_bytes(raw[i:i + width], "big")
            out.append(table.get(code, "" if width > 1 else chr(code)))
        return "".join(out)

    def literal(s: bytes, i: int) -> tuple:
        out, depth = bytearray(), 1
        while i < len(s):
            c = s[i]
            i += 1
            if c == 0x5C and i < len(s):          # \
                e = s[i]
                i += 1
                if 0x30 <= e <= 0x37:
                    o = chr(e)
                    while i < len(s) and len(o) < 3 and 0x30 <= s[i] <= 0x37:
                        o += chr(s[i])
                        i += 1
                    out.append(int(o, 8) & 0xFF)
                elif e in b"nrtbf":
                    out += {110: b"\n", 114: b"\r", 116: b"\t", 98: b"\b", 102: b"\f"}[e]
                elif e in b"\r\n":
                    if e == 13 and i < len(s) and s[i] == 10:
                        i += 1
                else:
                    out.append(e)
            elif c == 0x28:
                depth += 1
                out.append(c)
            elif c == 0x29:
                depth -= 1
                if not depth:
                    break
                out.append(c)
            else:
                out.append(c)
        return bytes(out), i

    def run(stream: bytes, fonts: dict) -> str:
        out, stack, font, y, i, n = [], [], None, None, 0, len(stream)
        ws = b" \t\r\n\x00\x0c"

        def nl():
            if out and not out[-1].endswith("\n"):
                out.append("\n")

        def space():
            if out and not out[-1].endswith((" ", "\n")):
                out.append(" ")
        while i < n:
            c = stream[i]
            if c in ws:
                i += 1
            elif c == 0x25:                           # komentarz
                while i < n and stream[i] not in b"\r\n":
                    i += 1
            elif c == 0x28:
                s, i = literal(stream, i + 1)
                stack.append(("s", s))
            elif c == 0x3C and stream[i + 1:i + 2] != b"<":
                e = stream.find(b">", i)
                h = re.sub(rb"\s", b"", stream[i + 1:e if e > 0 else n])
                i = e + 1 if e > 0 else n
                stack.append(("s", bytes.fromhex((h + b"0" * (len(h) % 2)).decode("ascii", "ignore") or "")))
            elif c in b"[]<>{}":
                stack.append(("d", bytes([c])))
                i += 2 if stream[i:i + 2] in (b"<<", b">>") else 1
            elif c == 0x2F:
                j = i + 1
                while j < n and stream[j] not in ws and stream[j] not in b"/[]()<>{}%":
                    j += 1
                stack.append(("n", stream[i + 1:j]))
                i = j
            else:
                j = i
                while j < n and stream[j] not in ws and stream[j] not in b"/[]()<>{}%":
                    j += 1
                tok = stream[i:j] or stream[i:i + 1]
                i = max(j, i + 1)
                try:
                    stack.append(("f", float(tok)))
                    continue
                except ValueError:
                    pass
                op = tok
                if op == b"BI":                       # obraz w treści: pomiń dane
                    e = re.compile(rb"\sEI[\s]").search(stream, i)
                    i = e.end() if e else n
                elif op == b"Tf":
                    names = [v for t, v in stack if t == "n"]
                    font = fonts.get(names[-1]) if names else None
                elif op in (b"Tj", b"'", b'"'):
                    if op != b"Tj":
                        nl()
                    strs = [v for t, v in stack if t == "s"]
                    if strs:
                        out.append(decode(strs[-1], font))
                elif op == b"TJ":
                    for t, v in stack:
                        if t == "s":
                            out.append(decode(v, font))
                        elif t == "f" and v < -200:
                            space()
                elif op in (b"Td", b"TD"):
                    nums = [v for t, v in stack if t == "f"]
                    if len(nums) >= 2 and abs(nums[-1]) > 0.01:
                        nl()
                    elif nums:
                        space()
                elif op == b"Tm":
                    nums = [v for t, v in stack if t == "f"]
                    if len(nums) >= 6:
                        if y is not None and abs(nums[-1] - y) > 0.5:
                            nl()
                        elif y is not None:
                            space()
                        y = nums[-1]
                elif op == b"T*":
                    nl()
                elif op == b"ET":
                    space()
                stack = []
        return "".join(out)

    def fonts_of(page: bytes) -> dict:
        node, seen = page, 0
        while node and seen < 20:
            res = dict_of(node, b"Resources")
            fd = dict_of(res, b"Font") if res else b""
            if fd:
                return {k: int(v) for k, v in re.findall(rb"/([^\s/<>\[\]()]+)\s+(\d+)\s+\d+\s+R", fd)}
            p = ref(node, b"Parent")
            node, seen = (objs.get(p, (b"", None))[0] if p is not None else b""), seen + 1
        return {}

    def pages() -> list:
        root = None
        tm = re.findall(rb"/Root\s+(\d+)\s+\d+\s+R", data)
        if tm:
            root = objs.get(int(tm[-1]), (b"", None))[0]
        else:
            root = next((b for b, _ in objs.values() if re.search(rb"/Type\s*/Catalog", b)), b"")
        out, todo, seen = [], [ref(root or b"", b"Pages")], set()
        while todo and len(seen) < 20000:
            num = todo.pop(0)
            if num is None or num in seen or num not in objs:
                continue
            seen.add(num)
            body = objs[num][0]
            if re.search(rb"/Type\s*/Pages\b", body):
                k = re.search(rb"/Kids\s*\[(.*?)\]", body, re.S)
                todo = [int(x) for x in re.findall(rb"(\d+)\s+\d+\s+R", k.group(1) if k else b"")] + todo
            elif re.search(rb"/Type\s*/Page\b", body):
                out.append(body)
        if not out:
            out = [b for _, (b, _s) in sorted(objs.items()) if re.search(rb"/Type\s*/Page\b", b)]
        return out

    texts = []
    for page in pages():
        c = re.search(rb"/Contents\s*(\[[^\]]*\]|\d+\s+\d+\s+R)", page)
        refs = [int(x) for x in re.findall(rb"(\d+)\s+\d+\s+R", c.group(1))] if c else []
        if len(refs) == 1 and objs.get(refs[0], (b"", None))[1] is None:
            refs = [int(x) for x in re.findall(rb"(\d+)\s+\d+\s+R", objs.get(refs[0], (b"", None))[0])] or refs
        stream = b"\n".join(objs[r][1] for r in refs if r in objs and objs[r][1])
        if stream:
            texts.append(run(stream, fonts_of(page)))
        if sum(len(t) for t in texts) > 4_000_000:
            break
    text = "\n\n".join(t.strip() for t in texts if t.strip())
    text = re.sub(r"[ \t]+\n", "\n", re.sub(r"[ \t]{2,}", " ", text.replace("\x00", "")))
    return re.sub(r"\n{3,}", "\n\n", text).strip() or None


def _ui_office_import(msg: dict) -> tuple:
    import base64
    name = Path(str(msg.get("name") or "plik").replace("\\", "/")).name or "plik"
    try:
        data = base64.b64decode(str(msg.get("b64") or ""))
    except ValueError:
        return 400, {"ok": False}
    ext = name.rsplit(".", 1)[-1].lower() if "." in name else ""
    stem = name[:-len(ext) - 1] if ext else name
    base = _ui_office_folder()

    def add(raw: bytes, nm: str):
        return _office_add_media(base, raw, nm)
    if msg.get("mode") == "open":
        if ext in ("xlsx", "xlsm", "csv", "tsv"):
            kind, body = "sheet", _office_sheet_table(data, ext)
        elif ext == "pptx":
            kind, body = "deck", _office_pptx_html(data, add)
        elif ext == "docx":
            kind, body = "doc", _office_docx_html(data, add)
        else:
            return 400, {"ok": False, "error": "type"}
        return (200, {"ok": True, "kind": kind, "body": body, "name": stem}) if body else (422, {"ok": False})
    if ext in _OFFICE_PICTURES:
        saved = add(data, name)
        return (200, {"ok": True, "image": saved}) if saved else (500, {"ok": False})
    text, kind = None, "html"
    if ext == "pdf":
        text, kind = _office_pdf_text(data), "txt"
    elif ext == "docx":
        text = _office_docx_html(data, add)
    elif ext == "pptx":
        text = _office_pptx_html(data, add)
    elif ext in ("xlsx", "xlsm"):
        text = _office_sheet_table(data, ext)
    if text is None and ext not in ("pdf", "docx", "pptx", "xlsx", "xlsm") and b"\x00" not in data[:4096]:
        try:
            text, kind = data.decode("utf-8"), ext or "txt"
        except UnicodeDecodeError:
            text = None
    if not text or not text.strip():
        return 422, {"ok": False}
    clean = "-".join(x for x in re.split(r"[^\w-]+", stem) if x)[:50] or "zrodlo"
    dst = base / ".office" / "sources" / f"{clean}.{re.sub(r'[^a-z0-9]', '', kind.lower())[:8] or 'txt'}"
    dst.parent.mkdir(parents=True, exist_ok=True)
    _atomic_write(dst, text.encode("utf-8"))
    return 200, {"ok": True, "text": ".office/sources/" + dst.name, "chars": len(text)}


def _ui_office_reveal(msg: dict) -> tuple:
    """Folder Biura (albo plik w nim) w Eksploratorze, Finderze albo menedżerze plików."""
    rel = str(msg.get("p") or "")
    target = _ui_office_path(rel) if rel else _ui_office_folder()
    if target is None or not target.exists():
        return 404, {"ok": False}
    try:
        if os.name == "nt":
            if target.is_file():
                subprocess.Popen(["explorer", "/select,", str(target)])  # nosec B603 B607 - ścieżka z folderu Biura
            else:
                os.startfile(str(target))  # nosec B606 - folder Biura
        elif sys.platform == "darwin":
            subprocess.Popen(["open", "-R", str(target)] if target.is_file() else ["open", str(target)])  # nosec B603 B607
        else:
            subprocess.Popen(["xdg-open", str(target.parent if target.is_file() else target)],  # nosec B603 B607
                             stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    except OSError:
        return 500, {"ok": False}
    return 200, {"ok": True}


