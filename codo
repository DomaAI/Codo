def _choose_model(models: list, selected: str | None, title: str = "Wybierz model") -> str | None:
    """Wybór strzałkami; Esc lub Ctrl+C anuluje bez zmiany modelu."""
    title = _L(title)
    if not models or not (_tty() and sys.stdin.isatty()) or IS_WIN:
        return None
    import termios
    import tty
    fd = sys.stdin.fileno()
    old = termios.tcgetattr(fd)
    index = next((i for i, item in enumerate(models) if item[0] == selected), 0)
    shown = 0
    try:
        tty.setcbreak(fd)
        while True:
            if shown:
                sys.stdout.write(f"\033[{shown}A")
            rows = [_Lf('  {0}  ·  {1}/{2}  ·  ↑↓ przewijaj całą listę  ·  Enter wybiera  ·  Esc anuluje', title, index + 1, len(models))]
            start = max(0, min(index - 3, max(0, len(models) - 7)))
            for i in range(start, min(start + 7, len(models))):
                mid, label, plan = models[i]
                prefix = violet("❯") if i == index else " "
                active = " • aktywny" if mid == selected else ""
                tier = f" · plan {plan}" if plan not in ("free", "base") else ""
                rows.append(f"  {prefix} {label}{tier}{active}")
            for row in rows:
                sys.stdout.write("\r\033[2K" + row + "\n")
            sys.stdout.flush()
            shown = len(rows)
            ch = _read_terminal_key(fd)
            if ch in ("\r", "\n"):
                return models[index][0]
            if ch in ("\x03", "\x04"):
                return None
            if ch == "\x1b":
                return None
            if ch == "\x1b[A": index = (index - 1) % len(models)
            elif ch == "\x1b[B": index = (index + 1) % len(models)
    finally:
        termios.tcsetattr(fd, termios.TCSADRAIN, old)
        if shown:
            sys.stdout.write(f"\033[{shown}A" + "\r\033[2K\n" * shown + f"\033[{shown}A")
            sys.stdout.flush()


