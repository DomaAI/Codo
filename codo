def _ui_upload(name: str, data: bytes) -> str | None:
    """Plik wrzucony do okna (przycisk + albo przeciągnięcie): zapis w CONFIG_DIR/zalaczniki/<data>/, zwraca ścieżkę,
    którą okno wstawia jako @ścieżka (tak jak aplikacja na Maca wstawia plik wybrany z dysku)."""
    import time
    base = re.sub(r"[^\w.\- ]+", "_", Path(str(name or "plik")).name).strip(" .") or "plik"
    folder = CONFIG_DIR / "zalaczniki" / time.strftime("%Y-%m-%d")
    folder.mkdir(parents=True, exist_ok=True)
    target = folder / base[:120]
    stem, suf = target.stem, target.suffix
    n = 2
    while target.exists():
        target = folder / f"{stem} ({n}){suf}"
        n += 1
    _atomic_write(target, data)
    return str(target)


# ── Okno: workflowy i Biuro (26.11.2026), te same pliki co aplikacja na Maca ──────────────────
# Workflowy: ~/.config/doma/workflows.json (lista, format WorkflowStore.swift), okno czyta i zapisuje całość.
# Biuro: folder ~/Documents/Codo (CODO_OFFICE_FOLDER albo wybrany w oknie), pliki *.deck|doc|sheet.html
# jak na Macu. Osobny silnik `codo app-server` w folderze Biura (jak officeEngine na Macu): /api/office/send
# i /api/office/events. Podgląd i edytor pliku: /api/office/v/<klucz>/<plik> w ramce z sandbox (bez dostępu
# do okna i tokenu), skrypty edytora okno oddaje przy starcie (/api/office/prepare), silnik trzyma je w pamięci.
WORKFLOWS_FILE = CONFIG_DIR / "workflows.json"
_UI_OFFICE: dict = {"bridge": None, "mem": {}, "key": "", "lock": threading.Lock()}
_UI_OFFICE_KINDS = (".deck.html", ".doc.html", ".sheet.html")
_UI_OFFICE_MIME = {"html": "text/html; charset=utf-8", "css": "text/css; charset=utf-8",
                   "js": "text/javascript; charset=utf-8", "png": "image/png", "jpg": "image/jpeg",
                   "jpeg": "image/jpeg", "gif": "image/gif", "webp": "image/webp", "svg": "image/svg+xml",
                   "avif": "image/avif", "bmp": "image/bmp", "ico": "image/x-icon", "json": "application/json",
                   "woff2": "font/woff2", "woff": "font/woff", "ttf": "font/ttf", "otf": "font/otf"}


def _ui_workflows_read():
    try:
        d = json.loads(WORKFLOWS_FILE.read_text(encoding="utf-8"))
    except (OSError, ValueError):
        return None               # brak pliku: okno zakłada gotowe workflowy (jak WorkflowStore na Macu)
    return d if isinstance(d, list) else None


def _ui_workflows_write(data) -> bool:
    if not isinstance(data, list) or not all(isinstance(w, dict) and w.get("id") for w in data):
        return False
    _atomic_write(WORKFLOWS_FILE, json.dumps(data, ensure_ascii=False, indent=2, sort_keys=True).encode("utf-8"))
    return True


def _ui_office_folder() -> Path:
    env = os.environ.get("CODO_OFFICE_FOLDER")
    if env:
        return Path(env).expanduser().resolve()
    saved = str(load_settings().get("office_folder") or "")
    if saved and Path(saved).is_dir():
        return Path(saved).resolve()
    return (Path.home() / "Documents" / "Codo").resolve()


def _ui_office_path(rel: str) -> Path | None:
    """Plik w folderze Biura (bez wychodzenia poza folder)."""
    base = _ui_office_folder()
    rel = str(rel or "").replace("\\", "/").lstrip("/")
    if not rel or "\x00" in rel:
        return None
    p = (base / rel).resolve()
    return p if str(p).startswith(str(base) + os.sep) else None


def _ui_office_list() -> dict:
    base = _ui_office_folder()
    files = []
    try:
        for p in base.iterdir():
            n = p.name
            kind = next((k for k in _UI_OFFICE_KINDS if n.lower().endswith(k)), "")
            if not kind or n.startswith(".") or not p.is_file():
                continue
            size = ""
            if kind == ".deck.html":
                try:
                    with open(p, "rb") as fh:
                        m = re.search(rb'data-size="([a-z0-9-]+)"', fh.read(600))
                    size = m.group(1).decode() if m else ""
                except OSError:
                    pass
            files.append({"name": n, "kind": kind.split(".")[1], "size": size, "modified": p.stat().st_mtime})
    except OSError:
        pass
    files.sort(key=lambda f: -f["modified"])
    if not _UI_OFFICE["key"]:
        _UI_OFFICE["key"] = os.urandom(18).hex()
    home = base == (Path.home() / "Documents" / "Codo").resolve() or bool(os.environ.get("CODO_OFFICE_FOLDER"))
    return {"folder": str(base), "home": str(Path.home()), "files": files, "key": _UI_OFFICE["key"],
            "guide": "Codo.md" if home else ".office/GUIDE.md"}


def _ui_office_bridge(main) -> "_UiBridge":
    with _UI_OFFICE["lock"]:
        b = _UI_OFFICE["bridge"]
        folder = _ui_office_folder()
        if b is not None and getattr(b, "cwd", None) != folder:
            b.stop()
            b = None
        if b is None:
            folder.mkdir(parents=True, exist_ok=True)
            b = _UiBridge(main.script, main.model)
            b.cwd = folder
            b.start()
            import atexit
            atexit.register(b.stop)
            _UI_OFFICE["bridge"] = b
        return b


def _ui_office_post(path: str, msg: dict, main) -> tuple:
    import base64
    if path == "/api/office/send":
        if msg.get("type") not in _UI_SEND_TYPES:
            return 400, {"ok": False, "error": "type"}
        return (200, {"ok": True}) if _ui_office_bridge(main).write(msg) else (503, {"ok": False})
    if path == "/api/office/folder":
        f = str(msg.get("folder") or "")
        st = load_settings()
        st["office_folder"] = "" if not f or Path(f).expanduser().resolve() == (Path.home() / "Documents" / "Codo").resolve() else str(Path(f).expanduser().resolve())
        if st["office_folder"] and not Path(st["office_folder"]).is_dir():
            return 400, {"ok": False, "error": "folder"}
        save_settings(st)
        return 200, {"ok": True, **_ui_office_list()}
    if path == "/api/office/prepare":
        # Jak OfficeStore.prepare(): style i odtwarzacz w .office/, zasady formatu w Codo.md (folder Biura)
        # albo .office/GUIDE.md (folder projektu). Skrypty edytora tylko w pamięci.
        mem = msg.get("mem") if isinstance(msg.get("mem"), dict) else {}
        if isinstance(msg.get("strings"), dict):
            _UI_OFFICE["strings"] = {str(k): str(v) for k, v in msg["strings"].items()}
        _UI_OFFICE["mem"].update({str(k): str(v) for k, v in mem.items() if k in ("editor.js", "sheet.js", "deck.css", "doc.css", "sheet.css", "view.js")})
        base = _ui_office_folder()
        (base / ".office").mkdir(parents=True, exist_ok=True)
        for name in ("deck.css", "doc.css", "sheet.css", "view.js"):
            text = _UI_OFFICE["mem"].get(name)
            if text is not None:
                dst = base / ".office" / name
                try:
                    if not dst.exists() or dst.read_text(encoding="utf-8") != text:
                        _atomic_write(dst, text.encode("utf-8"))
                except OSError:
                    pass
        guide = str(msg.get("guide") or "").strip()
        if guide:
            home = base == (Path.home() / "Documents" / "Codo").resolve() or bool(os.environ.get("CODO_OFFICE_FOLDER"))
            memory = base / ("Codo.md" if home else ".office/GUIDE.md")
            end = "<!-- /codo-office-guide -->"
            try:
                old = memory.read_text(encoding="utf-8")
            except OSError:
                old = ""
            block = guide + "\n" + end
            a, b = old.find("<!-- codo-office-guide"), old.find(end)
            new = old[:a] + block + old[b + len(end):] if 0 <= a < b else block + ("\n" if not old else "\n\n" + old)
            if new != old:
                _atomic_write(memory, new.encode("utf-8"))
        return 200, {"ok": True, **_ui_office_list()}
    if path == "/api/office/workflows":
        ok = _ui_workflows_write(msg.get("workflows"))
        return (200 if ok else 400), {"ok": ok}
    p = _ui_office_path(str(msg.get("p") or ""))
    if p is None:
        return 400, {"ok": False, "error": "path"}
    if path == "/api/office/write":
        if "b64" in msg:
            data = base64.b64decode(str(msg.get("b64") or ""))
        else:
            data = str(msg.get("text") or "").encode("utf-8")
        if msg.get("fresh"):       # nowy plik: wolna nazwa jak OfficeStore.freeURL
            stem, ext = p.name, ""
            for k in _UI_OFFICE_KINDS + (".png", ".jpg", ".jpeg", ".gif", ".webp", ".svg", ".txt", ".md"):
                if stem.lower().endswith(k):
                    stem, ext = stem[:-len(k)], stem[-len(k):]
                    break
            n = 2
            while p.exists():
                p = p.with_name(f"{stem} {n}{ext}" if ext in _UI_OFFICE_KINDS else f"{stem}-{n}{ext}")
                n += 1
        _atomic_write(p, data)
        return 200, {"ok": True, "name": str(p.relative_to(_ui_office_folder())).replace("\\", "/"),
                     "modified": p.stat().st_mtime}
    if path == "/api/office/delete":
        try:
            p.unlink()
        except OSError:
            return 404, {"ok": False}
        return 200, {"ok": True}
    if path == "/api/office/rename":
        to = _ui_office_path(str(msg.get("to") or ""))
        if to is None or to.exists() or not p.exists():
            return 409, {"ok": False}
        p.rename(to)
        return 200, {"ok": True, "name": to.name}
    return 404, {"ok": False}


def _ui_office_get(path: str, qs: dict) -> tuple:
    if path == "/api/office/list":
        return 200, _ui_office_list()
    if path == "/api/office/read":
        p = _ui_office_path((qs.get("p") or [""])[0])
        try:
            st = p.stat() if p else None
            return (200, {"text": p.read_text(encoding="utf-8"), "modified": st.st_mtime}) if p else (400, {})
        except (OSError, UnicodeDecodeError):
            return 404, {"error": "read"}
    if path == "/api/office/workflows":
        return 200, {"workflows": _ui_workflows_read()}
    return 404, {}


def _ui_office_view(handler, path: str, port: int) -> None:
    """Plik Biura dla ramki edytora: /api/office/v/<klucz>/<ścieżka>?codo=tryb&i=nr. Bez tokenu okna:
    klucz jest osobny, ramka ma sandbox (inny origin), CSP pozwala tylko na jej własne pliki."""
    import hmac
    rest = path[len("/api/office/v/"):]
    key, _, rel = rest.partition("/")
    rel = urllib.parse.unquote(rel)
    host = (handler.headers.get("Host") or "").strip().lower()
    hosts = {f"127.0.0.1:{port}", f"localhost:{port}"}
    if host not in hosts or not _UI_OFFICE["key"] or not hmac.compare_digest(key, _UI_OFFICE["key"]):
        handler.send_response(403)
        handler.end_headers()
        return
    qs = urllib.parse.parse_qs(urllib.parse.urlparse(handler.path).query)
    data, ext = None, rel.rsplit(".", 1)[-1].lower() if "." in rel else ""
    mem = _UI_OFFICE["mem"]
    if rel.startswith(".office/app/") and rel[12:] in mem:
        data = mem[rel[12:]].encode("utf-8")
    elif rel.startswith(".office/") and rel[8:] in mem:
        data = mem[rel[8:]].encode("utf-8")
    else:
        p = _ui_office_path(rel)
        mode = (qs.get("codo") or [""])[0]
        kind = next((k.split(".")[1] for k in _UI_OFFICE_KINDS if rel.lower().endswith(k)), "")
        try:
            if p and mode and kind:
                text = p.read_text(encoding="utf-8")
                cfg = {"mode": mode, "kind": kind, "index": int((qs.get("i") or ["0"])[0] or 0),
                       "strings": _UI_OFFICE.get("strings") or {}}
                add = ("<script>window.CODO=" + json.dumps(cfg, ensure_ascii=False).replace("</", "<\\/") + ";"
                       "window.webkit={messageHandlers:{codo:{postMessage:function(m){parent.postMessage({codoOffice:m},'*')}}}};"
                       "window.onerror=function(m,s,l){parent.postMessage({codoOffice:{type:'error',text:m+' '+s+':'+l}},'*')};"
                       "addEventListener('message',function(e){var d=e.data;if(e.source!==parent||!d||!d.codoCall)return;var v=null,f=window[d.codoCall];"
                       "try{v=typeof f==='function'?f.apply(null,d.args||[]):null}catch(x){v=null}"
                       "parent.postMessage({codoReply:d.id,value:v===undefined?null:v},'*')});</script>\n")
                if f".office/{kind}.css" not in text:
                    add += f'<link rel="stylesheet" href=".office/{kind}.css">\n'
                add += f'<script src=".office/app/{"sheet" if kind == "sheet" else "editor"}.js"></script>\n'
                i = text.lower().find("</head>")
                text = text[:i] + add + text[i:] if i >= 0 else \
                    f'<!doctype html><html><head><meta charset="utf-8">\n{add}</head><body>\n{text}\n</body></html>'
                data, ext = text.encode("utf-8"), "html"
            elif p and p.is_file():
                data = p.read_bytes()
        except (OSError, UnicodeDecodeError, ValueError):
            data = None
    if data is None:
        handler.send_response(404)
        handler.send_header("Content-Length", "0")
        handler.end_headers()
        return
    anc = " ".join("http://" + h for h in sorted(hosts))
    handler.send_response(200)
    handler.send_header("Content-Type", _UI_OFFICE_MIME.get(ext, "application/octet-stream"))
    handler.send_header("Content-Length", str(len(data)))
    handler.send_header("Cache-Control", "no-store")
    handler.send_header("X-Content-Type-Options", "nosniff")
    handler.send_header("Referrer-Policy", "no-referrer")
    handler.send_header("Content-Security-Policy",
                        "default-src 'none'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; "
                        "img-src 'self' data: blob:; font-src 'self' data:; media-src 'self' data:; "
                        "form-action 'none'; base-uri 'none'; frame-ancestors " + anc)
    handler.end_headers()
    if handler.command != "HEAD":
        handler.wfile.write(data)


INBOX_FILE = CONFIG_DIR / "skrzynka.json"   # „Wyniki i zgody” na stronie Boty: ten sam plik co BotInbox na Macu


def _ui_inbox_read() -> dict:
    """Wpisy skrzynki botów (najnowsze 50) i dzisiejsze ciche przebiegi; okno tylko czyta i oznacza jako widziane."""
    import time as _time
    try:
        d = json.loads(INBOX_FILE.read_text(encoding="utf-8"))
    except (OSError, ValueError):
        d = {}
    entries = [e for e in (d.get("entries") or []) if isinstance(e, dict) and e.get("id")] if isinstance(d, dict) else []
    entries.sort(key=lambda e: str(e.get("at") or ""), reverse=True)
    today = int(_time.time() // 3600) - _time.localtime().tm_hour
    quiet = sum(int(t.get("quiet") or 0) for t in (d.get("ticks") or []) if isinstance(t, dict) and int(t.get("hour") or 0) >= today) \
        if isinstance(d, dict) else 0
    return {"entries": entries[:50], "quiet": quiet}


def _ui_inbox_seen(ids) -> bool:
    """seen: lista identyfikatorów albo "all"; reszta pliku zostaje, jak ją zapisał Mac."""
    try:
        d = json.loads(INBOX_FILE.read_text(encoding="utf-8"))
    except (OSError, ValueError):
        return False
    if not isinstance(d, dict) or not (ids == "all" or isinstance(ids, list)):
        return False
    want = None if ids == "all" else {str(i) for i in ids}
    for e in d.get("entries") or []:
        if isinstance(e, dict) and (want is None or str(e.get("id")) in want):
            e["seen"] = True
    _atomic_write(INBOX_FILE, json.dumps(d, ensure_ascii=False).encode("utf-8"))
    return True


def _convo_preview(d: dict) -> str:
    """Pierwsza linia ostatniej odpowiedzi: podpis pod tytułem rozmowy w panelu bocznym."""
    for m in reversed(d.get("messages") or []):
        if isinstance(m, dict) and m.get("role") == "assistant":
            c = m.get("content")
            if isinstance(c, list):
                c = " ".join(str(x.get("text") or "") for x in c if isinstance(x, dict))
            t = " ".join(str(c or "").split())
            if t:
                return t[:140]
    return ""


_UI_STICKY = ("models", "model", "mode", "status", "limits", "effort", "context", "team_state")
_UI_MAX_BODY = 1 << 20


class _UiBridge:
    """Most między stroną a jednym potomnym `codo app-server` (jedna rozmowa naraz, jak okno na Maca)."""

    def __init__(self, script: str, model: str | None):
        self.script, self.model = script, model
        self.cond = threading.Condition()
        self.wlock = threading.Lock()
        self.events: list = []        # (seq, rodzaj, linia JSON); od „ready” bieżącego silnika
        self.seq = 0
        self.gen = 0
        self.proc = None
        self.err_tail: list = []
        self.clients = 0
        self.ever = False
        self.left_at = 0.0
        self.closing = False

    # ── silnik ──
    def start(self) -> None:
        env = dict(os.environ)
        # Dziecko pisze i czyta UTF-8 także na Windows (cp1250/cp1252 w konsoli), bez kolorów ANSI.
        env.update({"PYTHONIOENCODING": "utf-8", "PYTHONUTF8": "1", "PYTHONUNBUFFERED": "1", "NO_COLOR": "1",
                    "CODO_CLIENT": "web", "CODO_LANG": ui_lang()})
        cmd = [*_self_cmd(self.script)] + (["--model", self.model] if self.model else []) + ["app-server"]
        kw: dict = {}
        if IS_WIN:
            # Własna grupa procesów: Ctrl+C w konsoli nie przerywa silnika w pół zdania, sprzątamy sami.
            kw["creationflags"] = getattr(subprocess, "CREATE_NEW_PROCESS_GROUP", 0x200)
        else:
            kw["start_new_session"] = True
        proc = subprocess.Popen(cmd, cwd=str(getattr(self, "cwd", None) or Path.cwd()), env=env, stdin=subprocess.PIPE,  # nosec B603
                                stdout=subprocess.PIPE, stderr=subprocess.PIPE, **kw)
        with self.cond:
            self.gen += 1
            self.proc = proc
            self.err_tail = []
            self.events = []          # nowy silnik = nowa rozmowa; strona czyści widok po „ready”
            gen = self.gen
        threading.Thread(target=self._read_out, args=(proc, gen), daemon=True).start()
        threading.Thread(target=self._read_err, args=(proc,), daemon=True).start()

    def _read_out(self, proc, gen: int) -> None:
        for raw in iter(proc.stdout.readline, b""):
            line = raw.decode("utf-8", "replace").strip()
            if not line:
                continue
            try:
                kind = str(json.loads(line).get("type") or "")
            except (ValueError, AttributeError):
                continue              # na stdout idzie tylko JSON; resztę pomijamy
            self.push(kind, line)
            if kind == "ready":
                # Każda karta (także otwarta później) dostaje modele, stan konta i saldo z bufora zdarzeń.
                for ask in ("models", "status", "limits"):
                    self.write({"type": ask})
        rc = proc.wait()
        with self.cond:
            stale = gen != self.gen or self.closing
        if not stale:
            tail = [x for x in self.err_tail if x.strip()]
            detail = next((x for x in reversed(tail) if "✗" in x), tail[-1] if tail else "")
            self.push("ui_engine_exit", json.dumps({"type": "ui_engine_exit", "code": rc,
                                                    "detail": detail.replace("✗", "").strip()[:400]},
                                                   ensure_ascii=False))

    def _read_err(self, proc) -> None:
        for raw in iter(proc.stderr.readline, b""):
            text = re.sub(r"\x1b\[[0-?]*[ -/]*[@-~]", "", raw.decode("utf-8", "replace")).rstrip()
            with self.cond:
                self.err_tail = (self.err_tail + [text])[-40:]

    def push(self, kind: str, line: str) -> None:
        with self.cond:
            self.seq += 1
            ready = next((e for e in self.events if e[1] == "ready"), None)
            if kind in ("cleared", "resumed"):
                # Nowa albo wznowiona rozmowa: stara treść nie jest już potrzebna nowej karcie.
                keep, seen = [], set()
                for e in reversed(self.events):
                    if e[1] in _UI_STICKY and e[1] not in seen:
                        seen.add(e[1])
                        keep.append(e)
                self.events = ([ready] if ready else []) + sorted(keep)
            elif len(self.events) > 8000:
                self.events = ([ready] if ready else []) + [e for e in self.events[-6000:] if e is not ready]
            self.events.append((self.seq, kind, line))
            self.cond.notify_all()

    def write(self, msg: dict) -> bool:
        kind = msg.get("type")
        if kind == "send":
            text = str(msg.get("text") or "").strip()
            if not text:
                return True
            self.push("ui_user", json.dumps({"type": "ui_user", "tekst": text}, ensure_ascii=False))
        elif kind == "answer":
            self.push("ui_answer", json.dumps({"type": "ui_answer", "id": str(msg.get("id") or ""),
                                               "value": int(msg.get("value") or 0)}))
        data = (json.dumps(msg, ensure_ascii=True) + "\n").encode("ascii")
        with self.wlock:
            p = self.proc
            if p is None or p.poll() is not None:
                return False
            try:
                p.stdin.write(data)
                p.stdin.flush()
            except (OSError, ValueError):
                return False
        return True

    @staticmethod
    def _kill(p) -> None:
        if p is None or p.poll() is not None:
            return
        try:
            p.stdin.write(b'{"type": "interrupt"}\n')
            p.stdin.flush()
            p.stdin.close()           # koniec wejścia = app-server sam kończy pracę
        except (OSError, ValueError):
            pass
        try:
            p.wait(5)
            return
        except subprocess.TimeoutExpired:
            pass
        if IS_WIN:
            # Całe drzewo (komendy agenta też); bez sygnałów POSIX.
            subprocess.run(["taskkill", "/PID", str(p.pid), "/T", "/F"],  # nosec B603 B607
                           stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, check=False)
        else:
            import signal
            try:
                os.killpg(p.pid, signal.SIGTERM)   # własna sesja: grupa = silnik i jego komendy
            except OSError:
                p.terminate()
        try:
            p.wait(3)
        except subprocess.TimeoutExpired:
            p.kill()
            try:
                p.wait(3)
            except subprocess.TimeoutExpired:
                pass

    def restart(self) -> None:
        with self.cond:
            self.gen += 1             # stary silnik kończy się po cichu, bez karty błędu
            old = self.proc
        self._kill(old)
        self.start()

    def stop(self) -> None:
        with self.cond:
            self.closing = True
            p = self.proc
            self.cond.notify_all()
        self._kill(p)

    def engine_pid(self) -> int:
        p = self.proc
        return p.pid if p is not None and p.poll() is None else 0

    # ── słuchacze (karty przeglądarki) ──
    def enter(self) -> None:
        with self.cond:
            self.clients += 1
            self.ever = True

    def leave(self) -> None:
        import time as _t
        with self.cond:
            self.clients -= 1
            if self.clients <= 0:
                self.left_at = _t.monotonic()

    def idle_for(self) -> float:
        import time as _t
        with self.cond:
            if not self.ever or self.clients > 0:
                return 0.0
            return _t.monotonic() - self.left_at

    def after(self, last: int) -> list:
        i = len(self.events)
        while i > 0 and self.events[i - 1][0] > last:
            i -= 1
        return self.events[i:]

    def stream(self, out, last: int, alive=None) -> None:
        """Server-Sent Events: zaległe zdarzenia jako „replay”, potem na żywo; ping co 15 s.
        `alive()` co 2 s sprawdza, czy karta nie zamknęła połączenia (zamknięcie karty = koniec po chwili)."""
        import time as _t
        with self.cond:
            snap = self.seq
        quiet = _t.monotonic()
        while True:
            with self.cond:
                batch = [] if self.closing else self.after(last)
                if not batch and not self.closing:
                    self.cond.wait(2)
                    batch = [] if self.closing else self.after(last)
                closing = self.closing
            if closing:
                out.write(b"event: bye\ndata: {}\n\n")
                out.flush()
                return
            if batch:
                chunk = []
                for seq, _kind, line in batch:
                    chunk.append(("event: replay\n" if seq <= snap else "") + f"id: {seq}\ndata: {line}\n\n")
                last = batch[-1][0]
                out.write("".join(chunk).encode("utf-8"))
                out.flush()
                quiet = _t.monotonic()
            elif alive is not None and not alive():
                return
            elif _t.monotonic() - quiet > 15:
                out.write(b": ping\n\n")
                out.flush()
                quiet = _t.monotonic()


def _ui_i18n(lang: str) -> dict:
    """Tłumaczenia okna (teksty z aplikacji na Maca, klucz = tekst angielski): {"lang", "strings"}."""
    import base64
    import gzip
    lang = (lang or ui_lang() or "en").strip()
    allx = {}
    dev = Path(__file__).resolve().parent / "ui" / "i18n"
    if os.environ.get("CODO_UI_DEV") and dev.is_dir():
        for f in dev.glob("*.json"):
            try:
                allx[f.stem] = {} if f.stem == "en" else json.loads(f.read_text(encoding="utf-8"))
                extra = dev.parent / "i18n-extra" / f.name
                if f.stem != "en" and extra.exists():
                    allx[f.stem].update(json.loads(extra.read_text(encoding="utf-8")))
            except (OSError, ValueError):
                pass
    else:
        try:
            allx = json.loads(gzip.decompress(base64.b64decode("".join(_CODO_UI_I18N_GZ))).decode("utf-8"))
        except (ValueError, OSError, NameError):
            allx = {}
    if lang not in allx:
        lang = lang.split("-")[0] if lang.split("-")[0] in allx else ("pl" if lang.startswith("pl") else "en")
    return {"lang": lang, "langs": sorted(allx), "strings": allx.get(lang, {})}


def _ui_page() -> str:
    """Strona okna: osadzona w tym pliku (gzip + base64); CODO_UI_DEV=1 czyta static/cli/codo-ui.html obok."""
    if os.environ.get("CODO_UI_DEV"):
        dev = Path(__file__).resolve().parent / "codo-ui.html"
        if dev.exists():
            ui = dev.parent / "ui"
            css = "\n".join(f.read_text(encoding="utf-8") for f in sorted(ui.glob("*.css")))
            js = "\n".join(f.read_text(encoding="utf-8") for f in sorted(ui.glob("*.js")))
            return dev.read_text(encoding="utf-8").replace("/*@@UI_CSS@@*/", css).replace("//@@UI_JS@@", js)
    import base64
    import gzip
    return gzip.decompress(base64.b64decode("".join(_CODO_UI_GZ))).decode("utf-8")


def _ui_handler(bridge: _UiBridge, token: str, port_ref: list, on_quit):
    import hmac
    import secrets
    from http.server import BaseHTTPRequestHandler

    def allowed_hosts() -> set:
        port = port_ref[0]
        return {f"127.0.0.1:{port}", f"localhost:{port}"}

    class Handler(BaseHTTPRequestHandler):
        server_version = "Codo"
        sys_version = ""

        def log_message(self, *a):   # noqa: D401 — bez dziennika żądań w terminalu
            pass

        def _headers(self, code: int, ctype: str, length: int | None = None, extra: dict | None = None) -> None:
            self.send_response(code)
            self.send_header("Content-Type", ctype)
            if length is not None:
                self.send_header("Content-Length", str(length))
            self.send_header("Cache-Control", "no-store")
            self.send_header("X-Content-Type-Options", "nosniff")
            self.send_header("Referrer-Policy", "no-referrer")
            self.send_header("X-Frame-Options", "DENY")
            self.send_header("Cross-Origin-Resource-Policy", "same-origin")
            for k, v in (extra or {}).items():
                self.send_header(k, v)
            self.end_headers()

        def _send(self, code: int, body, ctype: str = "application/json; charset=utf-8", extra: dict | None = None):
            data = body if isinstance(body, bytes) else (
                json.dumps(body, ensure_ascii=False).encode("utf-8") if not isinstance(body, str) else body.encode("utf-8"))
            self._headers(code, ctype, len(data), extra)
            if self.command != "HEAD":
                self.wfile.write(data)

        def _guard(self, post: bool) -> bool:
            host = (self.headers.get("Host") or "").strip().lower()
            origin = (self.headers.get("Origin") or "").strip().lower()
            hosts = allowed_hosts()
            ok = host in hosts and (not origin or origin in {"http://" + h for h in hosts})
            if (self.headers.get("Sec-Fetch-Site") or "").lower() == "cross-site":
                ok = False
            if post:
                given = self.headers.get("X-Codo-Token") or ""
                # application/octet-stream tylko dla plików (też nie jest „prostym” typem CORS: obca strona go nie wyśle)
                want = ("application/octet-stream" if urllib.parse.urlparse(self.path).path == "/api/upload"
                        else "application/json")
                ok = ok and (self.headers.get("Content-Type") or "").split(";")[0].strip() == want
            else:
                qs = urllib.parse.parse_qs(urllib.parse.urlparse(self.path).query)
                given = (qs.get("t") or [""])[0]
            ok = ok and hmac.compare_digest(given.encode("utf-8", "replace"), token.encode())
            if not ok:
                self._send(403, _L("Brak dostępu. Otwórz adres z tokenem, który pokazał terminal (codo ui)."),
                           "text/plain; charset=utf-8")
            return ok

        def _host_events(self):
            """Zdarzenia gospodarza agentów na żywo (SSE): stan, wpisy, prośby o zgodę."""
            import socket
            if not _host_ensure():
                return self._send(503, {"ok": False, "error": "host"})
            try:
                sock = _host_connect()
                sock.sendall(b'{"cmd": "attach"}\n')
            except (OSError, ValueError):
                return self._send(503, {"ok": False, "error": "host"})
            self._headers(200, "text/event-stream; charset=utf-8", None, {"X-Accel-Buffering": "no"})
            buf = b""
            sock.settimeout(15)
            try:
                while True:
                    try:
                        chunk = sock.recv(65536)
                    except socket.timeout:
                        self.wfile.write(b": ping\n\n")
                        self.wfile.flush()
                        continue
                    if not chunk:
                        self.wfile.write(b"event: down\ndata: {}\n\n")
                        self.wfile.flush()
                        break
                    buf += chunk
                    while b"\n" in buf:
                        line, buf = buf.split(b"\n", 1)
                        if line.strip():
                            self.wfile.write(b"data: " + line + b"\n\n")
                    self.wfile.flush()
            except OSError:
                pass
            finally:
                try:
                    sock.close()
                except OSError:
                    pass
            return None

        def do_GET(self):
            path = urllib.parse.urlparse(self.path).path
            if path.startswith("/api/office/v/"):          # ramka edytora Biura: własny klucz, bez tokenu okna
                return _ui_office_view(self, path, port_ref[0])
            if path.startswith("/api/office/"):            # Biuro i workflowy (te same pliki co Mac)
                if not self._guard(False):
                    return None
                if path == "/api/office/events":
                    ob = _ui_office_bridge(bridge)
                    self._headers(200, "text/event-stream; charset=utf-8", extra={"X-Accel-Buffering": "no"})
                    try:
                        self.wfile.write(b"retry: 1500\n\n")
                        self.wfile.flush()
                        raw = self.headers.get("Last-Event-ID") or ""
                        ob.stream(self.wfile, int(raw) if raw.isdigit() else 0)
                    except (OSError, ValueError):
                        pass
                    return None
                code, body = _ui_office_get(path, urllib.parse.parse_qs(urllib.parse.urlparse(self.path).query))
                return self._send(code, body)
            if path not in ("/", "/index.html", "/api/events", "/api/convos", "/api/info", "/api/host/events",
                            "/api/host/config", "/api/i18n", "/api/hive", "/api/inbox"):
                return self._send(404, b"", "text/plain")
            if not self._guard(False):
                return None
            if path in ("/", "/index.html"):
                nonce = secrets.token_urlsafe(16)
                boot = {"lang": ui_lang(), "version": VERSION, "cwd": str(Path.cwd()),
                        "folder": Path.cwd().name or str(Path.cwd())}
                html = (_ui_page().replace('"__CODO_BOOT__"', json.dumps(boot, ensure_ascii=False).replace("<", "\\u003c"))
                        .replace("__NONCE__", nonce))
                csp = ("default-src 'none'; script-src 'nonce-" + nonce + "'; style-src 'unsafe-inline'; "
                       "img-src data:; connect-src 'self'; frame-src 'self'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'")
                return self._send(200, html, "text/html; charset=utf-8", {"Content-Security-Policy": csp})
            if path == "/api/i18n":
                qs = urllib.parse.parse_qs(urllib.parse.urlparse(self.path).query)
                return self._send(200, _ui_i18n((qs.get("lang") or [""])[0]))
            if path == "/api/host/config":
                return self._send(200, _ui_host_config_read())
            if path == "/api/hive":
                return self._send(200, _ui_hive_read())
            if path == "/api/inbox":
                return self._send(200, _ui_inbox_read())
            if path == "/api/host/events":
                return self._host_events()
            if path == "/api/convos":
                items = [{"id": d["id"], "title": d.get("custom_title") or d.get("title") or "",
                          "updated": d.get("updated") or 0, "preview": _convo_preview(d)} for d in _convo_list()[:80]]
                return self._send(200, {"items": items})
            if path == "/api/info":
                return self._send(200, {"version": VERSION, "pid": os.getpid(), "engine_pid": bridge.engine_pid(),
                                        "cwd": str(Path.cwd()), "lang": ui_lang()})
            # /api/events
            raw_last = self.headers.get("Last-Event-ID") or ""
            last = int(raw_last) if raw_last.isdigit() else 0
            self._headers(200, "text/event-stream; charset=utf-8", extra={"X-Accel-Buffering": "no"})
            sock = self.connection

            def alive() -> bool:
                import select
                import socket
                try:
                    readable, _w, _x = select.select([sock], [], [], 0)
                    return not readable or bool(sock.recv(1, socket.MSG_PEEK))
                except (OSError, ValueError):
                    return False
            bridge.enter()
            try:
                self.wfile.write(b"retry: 1500\n\n")
                self.wfile.flush()
                bridge.stream(self.wfile, last, alive)
            except (OSError, ValueError):
                pass                  # karta zamknięta albo przeładowana
            finally:
                bridge.leave()
            return None

        def do_POST(self):
            path = urllib.parse.urlparse(self.path).path
            if path.startswith("/api/office/"):
                if not self._guard(True):
                    return None
                try:
                    size = int(self.headers.get("Content-Length") or 0)
                    msg = json.loads(self.rfile.read(size).decode("utf-8") or "{}") if 0 < size <= 16 << 20 else None
                except (ValueError, UnicodeDecodeError):
                    msg = None
                if not isinstance(msg, dict):
                    return self._send(400, {"ok": False})
                try:
                    code, body = _ui_office_post(path, msg, bridge)
                except OSError as exc:
                    code, body = 500, {"ok": False, "error": str(exc)[:200]}
                return self._send(code, body)
            if path not in ("/api/send", "/api/quit", "/api/restart", "/api/host", "/api/host/config", "/api/hive", "/api/inbox",
                            "/api/upload"):
                return self._send(404, b"", "text/plain")
            if not self._guard(True):
                return None
            if path == "/api/upload":
                try:
                    size = int(self.headers.get("Content-Length") or 0)
                except ValueError:
                    size = -1
                if size <= 0 or size > _UI_UPLOAD_MAX:
                    return self._send(413, {"ok": False})
                name = urllib.parse.unquote(self.headers.get("X-Codo-Name") or "plik")
                saved = _ui_upload(name, self.rfile.read(size))
                return self._send(200 if saved else 400, {"ok": bool(saved), "path": saved or ""})
            try:
                size = int(self.headers.get("Content-Length") or 0)
            except ValueError:
                size = -1
            if size < 0 or size > _UI_MAX_BODY:
                return self._send(413, {"ok": False})
            try:
                msg = json.loads(self.rfile.read(size).decode("utf-8") or "{}") if size else {}
            except (ValueError, UnicodeDecodeError):
                return self._send(400, {"ok": False})
            if not isinstance(msg, dict):
                return self._send(400, {"ok": False})
            if path == "/api/quit":
                self._send(200, {"ok": True})
                threading.Thread(target=on_quit, daemon=True).start()
                return None
            if path == "/api/restart":
                threading.Thread(target=bridge.restart, daemon=True).start()
                return self._send(200, {"ok": True})
            if path == "/api/host":
                if msg.get("cmd") not in _UI_HOST_CMDS:
                    return self._send(400, {"ok": False, "error": "cmd"})
                if not _host_ensure():
                    return self._send(503, {"ok": False, "error": "host"})
                r = _host_call(msg, timeout=30)
                return self._send(200 if r is not None else 503, r if r is not None else {"ok": False})
            if path == "/api/hive":
                ok = _ui_hive_write(msg)
                return self._send(200 if ok else 400, {"ok": ok})
            if path == "/api/inbox":
                return self._send(200, {"ok": _ui_inbox_seen(msg.get("seen"))})
            if path == "/api/host/config":
                ok = _ui_host_config_write(str(msg.get("file") or ""), msg.get("data"))
                if ok and _host_call({"cmd": "state"}, timeout=3):
                    _host_call({"cmd": "reload"}, timeout=10)
                return self._send(200 if ok else 400, {"ok": ok})
            if msg.get("type") not in _UI_SEND_TYPES:
                return self._send(400, {"ok": False, "error": "type"})
            ok = bridge.write(msg)
            return self._send(200 if ok else 503, {"ok": ok})


    return Handler


def _app_window_browser() -> str | None:
    """Edge albo Chrome/Chromium, które otworzą Codo jako osobne okno aplikacji (bez pasków przeglądarki).
    Windows: Edge jest w każdym Windows 10 i 11. Linux: pierwszy znaleziony Chromium. Mac ma natywną aplikację."""
    if os.environ.get("CODO_UI_TAB"):
        return None
    if IS_WIN:
        roots = [os.environ.get(k) for k in ("ProgramFiles(x86)", "ProgramFiles", "LOCALAPPDATA")]
        rels = (r"Microsoft\Edge\Application\msedge.exe", r"Google\Chrome\Application\chrome.exe")
        for rel in rels:
            for root in roots:
                if root and Path(root, rel).is_file():
                    return str(Path(root, rel))
        return None
    if sys.platform == "darwin":
        return None
    import shutil
    for name in ("microsoft-edge", "microsoft-edge-stable", "google-chrome", "google-chrome-stable",
                 "chromium", "chromium-browser", "brave-browser"):
        found = shutil.which(name)
        if found:
            return found
    return None


def _app_window_cmd(exe: str, url: str) -> list:
    """Osobny profil: okno Codo ma swoją ikonę na pasku zadań i nie miesza się z kartami użytkownika."""
    if IS_WIN:
        base = Path(os.environ.get("LOCALAPPDATA") or Path.home() / "AppData" / "Local") / "Codo" / "okno"
    else:
        base = Path(os.environ.get("XDG_DATA_HOME") or Path.home() / ".local" / "share") / "codo" / "okno"
    return [exe, f"--app={url}", f"--user-data-dir={base}", "--no-first-run", "--no-default-browser-check",
            "--window-size=1280,860", "--disable-features=Translate"]


def _open_app_window(url: str) -> bool:
    exe = _app_window_browser()
    if not exe:
        return False
    try:
        flags = 0x08000000 if IS_WIN else 0   # CREATE_NO_WINDOW
        subprocess.Popen(_app_window_cmd(exe, url), stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL,
                         stderr=subprocess.DEVNULL, creationflags=flags, start_new_session=not IS_WIN)
        return True
    except OSError:
        return False


def codo_ui(args: list, model: str | None) -> int:
    """codo ui [folder] [--no-browser] [--port N]: okno Codo w przeglądarce (Windows, Linux, Mac)."""
    import secrets
    import time as _time
    from http.server import ThreadingHTTPServer
    no_browser = "--no-browser" in args
    as_tab = "--tab" in args or "--karta" in args
    port = 0
    rest = []
    i = 0
    while i < len(args):
        a = args[i]
        if a == "--port":
            val = args[i + 1] if i + 1 < len(args) else ""
            if not val.isdigit() or not 0 <= int(val) <= 65535:
                print(red(_L("✗ --port: podaj numer portu od 1 do 65535.")))
                return 2
            port = int(val)
            i += 2
            continue
        if a not in ("--no-browser", "--tab", "--karta"):
            if a.startswith("-"):
                print(red(_Lf('✗ Nieznana opcja {0}', a)) + dim(_L("  (codo help)")))
                return 2
            rest.append(a)
        i += 1
    if rest:
        target = Path(os.path.expanduser(rest[0]))
        if not target.is_dir():
            print(red(_Lf('✗ Nie ma takiego folderu: {0}', rest[0])))
            return 1
        os.chdir(target)
    if sys.stdin and sys.stdin.isatty() and not trust_workspace():
        return 1
    token = secrets.token_urlsafe(24)
    port_ref = [port]
    bridge = _UiBridge(str(Path(__file__).resolve()), model)
    state = {"server": None}

    def quit_all() -> None:
        bridge.stop()
        srv = state["server"]
        if srv is not None:
            srv.shutdown()

    try:
        server = ThreadingHTTPServer(("127.0.0.1", port), _ui_handler(bridge, token, port_ref, quit_all))
    except OSError as exc:
        print(red(_Lf('✗ Nie mogę uruchomić okna na porcie {0}: {1}', port, exc)))
        return 1
    server.daemon_threads = True
    state["server"] = server
    port_ref[0] = server.server_address[1]
    url = f"http://127.0.0.1:{port_ref[0]}/?t={token}"
    try:
        bridge.start()
    except OSError as exc:
        server.server_close()
        print(red(_Lf('✗ Nie mogę uruchomić silnika Codo: {0}', exc)))
        return 1
    try:
        auto_update_start()
    except Exception:
        pass  # nosec B110
    print(bold("Codo") + dim(_L(" w przeglądarce · ")) + str(Path.cwd()))
    print("  " + violet(url), flush=True)
    print(dim(_L("  Ctrl+C kończy. Zamknięcie karty też zatrzymuje Codo po chwili.")), flush=True)
    if not no_browser:
        headless = (not IS_WIN and sys.platform != "darwin"
                    and not (os.environ.get("DISPLAY") or os.environ.get("WAYLAND_DISPLAY")))
        if headless:
            print(dim(_L("  Brak ekranu graficznego: otwórz adres w przeglądarce na tym komputerze.")), flush=True)
        elif as_tab or not _open_app_window(url):
            import webbrowser
            threading.Thread(target=lambda: webbrowser.open(url), daemon=True).start()

    grace = 45.0
    try:
        grace = max(0.5, float(os.environ.get("CODO_UI_GRACE") or 45))
    except ValueError:
        pass

    def watchdog() -> None:
        while not bridge.closing:
            _time.sleep(0.5)
            if bridge.idle_for() > grace:
                quit_all()
                return

    threading.Thread(target=watchdog, daemon=True).start()
    import signal

    def on_signal(*_a) -> None:
        threading.Thread(target=quit_all, daemon=True).start()
    for name in ("SIGTERM", "SIGHUP", "SIGBREAK"):
        sig = getattr(signal, name, None)
        if sig is not None:
            try:
                signal.signal(sig, on_signal)
            except (ValueError, OSError):
                pass
    try:
        server.serve_forever(poll_interval=0.5)
    except KeyboardInterrupt:
        print()
    finally:
        bridge.stop()
        server.server_close()
    print(dim(_L("  Codo w przeglądarce zamknięte.")), flush=True)
    return 0


