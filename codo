FROZEN = bool(getattr(sys, "frozen", False))


def _self_cmd(script: str | None = None) -> list:
    """Jak uruchomić Codo od nowa (mostek okna, zespoły, MCP, praca w tle): python + skrypt,
    a w pojedynczym pliku sam plik. Wcześniej .exe dostawał ścieżkę skryptu jako polecenie i okno nie wstawało."""
