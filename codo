def _lopus_writing(state: dict, data: dict) -> None:
    """Serwer przysyła przyrosty treści pliku pisanego przez agenta (cli_writing): składamy je
    i podajemy oknu Codo jako zdarzenie „writing” (to samo, co przy własnych kontach API)."""
    key = data.get("index") or 0
    cur = state.setdefault(key, {"tekst": "", "stary": ""})
    od = data.get("od") if isinstance(data.get("od"), int) else len(cur["tekst"])
    cur["tekst"] = cur["tekst"][:od] + str(data.get("delta") or "")
    if data.get("stary"):
        cur["stary"] = str(data["stary"])
    plik, tryb = str(data.get("plik") or ""), str(data.get("tryb") or "write")
    if not plik:
        return
    if tryb == "edit":
        _app_emit("writing", plik=plik, tryb="edit", tekst=cur["tekst"], stary=cur["stary"])
    else:
        _app_emit("writing", plik=plik, tryb="write", tekst=cur["tekst"])


def lopus_turn(creds, messages, model, auto_yes, mode, mozg=None):
    SESSION["turn_footer"] = True
    import queue
    import uuid
    events = queue.Queue()
    bridge = _LopusBridge(creds, auto_yes, mode)
    chat_id = _chat_id()
    task = next((m.get("content", "") for m in reversed(messages) if m.get("role") == "user"), "")
    gap = brain_catchup("lopus", messages)
    if gap and isinstance(task, str):
        task = gap + "\n\n" + _L("Nowe polecenie:") + "\n" + task
    payload = {"description": task,
               "kontekst": _env_context(short=True) + _project_notes() + ("\n" + _SKILL_CONTEXT if _SKILL_CONTEXT else "")
               + (f"\nPoziom wysiłku: {_EFFORT_HINT[current_effort()]}" if _EFFORT_HINT.get(current_effort()) else "")
               # 23.11.2026: stały agent z okna Codo na Lopusie nie wiedział, kim jest ani jakich ma kolegów (inne mózgi
               # dostają to w prompcie systemowym): bez tego zamiast Badacza wołał własnego subagenta
               + (("\n\n" + str(SESSION["app_persona"])[:24000]) if SESSION.get("app_persona") else ""),
               # mózg MaddLabs: pełny agent (subagenci, zespoły); serwer sam zejdzie do planu konta
               "variant": "pro" if model == "lopus-pro" or mozg else "lopus", "chat_id": chat_id,
               "daemon_id": bridge.id, "message_id": str(uuid.uuid4())}
    if SESSION.get("maszyna"):
        payload["maszyna"] = True   # projekt na maszynie DomaAI: agent pracuje w chmurze
    if _APP["out"] is not None:
        payload["zywo"] = True      # okno Codo pokazuje plik w trakcie pisania (zdarzenie cli_writing)
    writing = {}
    if mozg:
        # Mózg MaddLabs z narzędziami DomaAI (0.18.2): serwer prowadzi turę na modelu MaddLabs.
        payload["mozg"] = mozg
        payload["model_maddlabs"] = model or ""
    finished, failed, text = False, False, ""
    def receive():
        try:
            token = device_access_token() or (creds or {}).get("access_token")
            for attempt in range(2):
                request = urllib.request.Request(API_URL + "/cli/lopus/stream", data=json.dumps(payload).encode(),
                    headers={"Authorization": f"Bearer {token}", "Content-Type": "application/json", "Accept": "text/event-stream", "User-Agent": f"doma-cli/{VERSION}", **firma_headers()}, method="POST")
                try:
                    response = urllib.request.urlopen(request, context=_ssl_ctx(), timeout=120)
                    break
                except urllib.error.HTTPError as exc:
                    if exc.code == 401 and attempt == 0:
                        token = device_access_token(force=True) if load_device() else refresh(creds)["access_token"]
                        continue
                    try:
                        detail = json.loads(exc.read().decode()).get("detail")
                    except (ValueError, OSError):
                        detail = "Nie udało się uruchomić Lopusa"
                    raise ApiError(exc.code, detail) from None
            with response:
                for event in _sse_frames(response):
                    if bridge.stop.is_set():
                        break
                    events.put(event)
            events.put(("_closed", {}))
        except (Exception, SystemExit) as exc:
            events.put(("_exception", exc))
    threading.Thread(target=receive, daemon=True).start()
    import time as _time
    stream = _AnswerStream()
    thinking, thinking_t0 = "", None
    LIVE.status(_L("Myślę"), _L("MaddLabs · narzędzia DomaAI") if mozg else _L("Lopus Pro") if model == "lopus-pro" else "Lopus")
    try:
        while not finished:
            if not bridge.errors.empty():
                raise ApiError(503, describe_error(bridge.errors.get()))
            try:
                job = bridge.jobs.get_nowait()
            except queue.Empty:
                job = None
            if job is not None:
                stream.finish()
                if not bridge.execute(job):
                    api_call(creds, "/cli/lopus/stop", {"chat_id": chat_id})
                    print(dim(_L("  Działanie anulowane. Napisz nowe wskazówki.")))
                    return False
            try:
                event, data = events.get(timeout=.1)
            except queue.Empty:
                continue
            if not isinstance(data, dict) and event not in ("_exception",):
                data = {"text": str(data)}
            if event == "_exception":
                raise ApiError(getattr(data, "status", 503), describe_error(data))
            if event == "_closed":
                stream.finish()
                print(red(_L("✗ Połączenie zakończyło się przed potwierdzeniem wyniku.")))
                return False
            if event in ("manager_synthesis_chunk", "token", "lead_synthesis_chunk"):
                chunk = str(data.get("chunk") or data.get("content") or "")
                if chunk:
                    if thinking_t0 is not None:
                        # czas myślenia trafia do linii pod odpowiedzią (koniec tury), nie nad nią
                        LIVE.thought += _time.monotonic() - thinking_t0
                        thinking_t0 = None
                    LIVE.status(_L("Piszę odpowiedź"), "")
                    LIVE.add_tokens(max(1, len(chunk) // 4))
                    stream.feed(chunk)
            elif event == "manager_synthesis_replace":
                stream.replace(str(data.get("text") or ""))
            elif event == "cli_writing":
                _lopus_writing(writing, data)
            elif event == "thinking_start":
                thinking, thinking_t0 = "", _time.monotonic()
                LIVE.status(_L("Myślę"), "")
            elif event == "thinking_chunk":
                thinking += str(data.get("chunk") or "")
                LIVE.add_tokens(max(1, len(str(data.get("chunk") or "")) // 4))
                tail = " ".join(thinking.split())[-110:]
                LIVE.status(_L("Myślę"), tail)
            elif event == "thinking_done":
                if thinking_t0 is not None:
                    secs = data.get("elapsed") or (_time.monotonic() - thinking_t0)
                    LIVE.thought += float(secs)
                    SYNC.add("thinking", {"sekundy": round(float(secs), 1), "tekst": thinking[-4000:]})
                    thinking_t0 = None
                LIVE.status(_L("Analizuję"), "")
            elif event in ("react_tool_call", "tool_call_start", "current_tool"):
                tool = str(data.get("tool") or "")
                if tool and tool != "server_studio":
                    args = data.get("args") if isinstance(data.get("args"), dict) else {}
                    label = _TOOL_VERBS.get(tool, tool.replace("_", " "))
                    hint = _terminal_text(_tool_hint(tool, args))
                    LIVE.status(label + (" " + hint if hint else ""))
                    if event == "react_tool_call":
                        stream.finish()
                        LIVE.tool_begin(bold(label) + (" " + dim(hint) if hint else ""), _tool_icon(tool))
                        SESSION["lopus_tool"] = (tool, bold(label) + (" " + dim(hint) if hint else ""))
            elif event == "react_tool_result":
                tool = str(data.get("tool") or "")
                pending = SESSION.pop("lopus_tool", None)
                if pending and pending[0] == tool:
                    preview = str(data.get("result_preview") or data.get("result") or "")
                    failed_tool = preview.startswith(("BŁĄD", "Błąd", "ERROR"))
                    LIVE.tool_end(not failed_tool, pending[1], _result_lines(tool, preview), _tool_icon(tool), name=tool)
                    SESSION["turn_steps"] = SESSION.get("turn_steps", 0) + 1
                LIVE.status(_L("Myślę"), "")
            elif event in ("plan_update", "plan"):
                # Serwer wysyła każdy plan DWA razy: `plan_update` (kroki ze
                # statusem) i starsze `plan` (napisy z emoji ✅/⏳/◯ dla webu).
                # 07.11.2026 wieczór (user: podwójne „☰ Plan” i „☐ ⏳ …”):
                # emoji zdejmujemy i tłumaczymy na stan, a plan o tej samej
                # treści i stanach co poprzednio nie jest drukowany ponownie.
                steps = _plan_steps(data)
                if steps and steps != SESSION.get("last_plan"):
                    SESSION["last_plan"] = steps
                    stream.finish()
                    print("\n" + bold(_icon("plan")) + " " + bold("Plan"))
                    SYNC.add("info", {"plan": [{"tekst": t, "stan": s} for t, s in steps]})
                    for text, state in steps:
                        mark = green("☑") if state == "done" else violet("◐") if state == "doing" else dim("☐")
                        print("  " + mark + " " + _terminal_text(text))
            elif event == "status":
                label = data.get("text") or data.get("status")
                if label:
                    LIVE.status(_terminal_text(str(label))[:80])
            elif event in ("error", "bieg_przerwany", "limit_reached"):
                failed = True
                stream.finish()
                print(red("✗ " + _terminal_text(str(data.get("detail") or data.get("message") or data.get("text") or data))))
            elif event == "done":
                answer = str(data.get("answer") or data.get("response") or "")
                if answer and not stream.text:
                    stream.feed(answer)
                finished = True
                failed = failed or data.get("status") in ("error", "stopped", "cancelled") or data.get("success") is False or bool(data.get("error")) or bool(data.get("awaria"))
            elif event in ("artifact", "artifact_ready", "attachment", "artifact_created"):
                link = data.get("url") or data.get("file_url")
                if link:
                    stream.finish()
                    print("\n" + bold(_icon("file")) + " " + bold(_L("Plik")) + " " + _terminal_text(str(link)))
        stream.finish()
        text = stream.text
        if text:
            messages.append({"role": "assistant", "content": text})
        brain_mark("lopus", messages)
        SESSION["model"] = model
        return not failed
    except KeyboardInterrupt:
        api_call(creds, "/cli/lopus/stop", {"chat_id": chat_id})
        raise
    except Exception:
        if not finished:
            try:
                api_call(creds, "/cli/lopus/stop", {"chat_id": chat_id})
            except Exception:
                pass
        raise
    finally:
        stream.finish()
        bridge.close()



# ── Sesja w aplikacji + zdalne sterowanie z telefonu (/rc) ─────────────────
# Przebieg rozmowy (to, co widać w konsoli, bez pełnych plików) leci w tle
# do konta, więc sesja jest widoczna w DomaAI (web/iOS/Android) jak w
# terminalu. Po /rc aplikacja może pisać do tej sesji, przerwać pracę
# i odpowiedzieć na pytanie o zgodę. Wyłączenie: DOMA_NO_SYNC=1 albo
# "sync_sessions": false w settings.json.

class _SessionSync:
    def __init__(self):
        self.id: str | None = None
        self.creds = None
        self.lock = threading.Lock()
        self.queue: list = []
        self.state: dict | None = None
        self.state_sent = ("", "")
        self.started = False
        self.enabled = False
        self.rc = False
        self.url = ""
        self.wake = threading.Event()
        self.stop = threading.Event()
        self.thread = None
        self.inbox = None
        self.meta: dict = {}
        self.failures = 0
        self.closing = False
        self.why: int | None = None    # kod odmowy serwera, gdy synchronizacja padła
        self.chat_change: str | None = None

    # ── start / koniec ──────────────────────────────────────────────────
    def start(self, creds, model: str | None, mode: str) -> None:
        import uuid
        if os.environ.get("DOMA_NO_SYNC") or load_settings().get("sync_sessions") is False:
            return
        if not load_device() and not load_creds():
            return  # samo MaddLabs: sesje w aplikacji DomaAI wymagają konta DomaAI
        self.id = str(uuid.uuid4())
        self.creds = creds
        self.enabled = True
        env = _env_info()
        import socket
        self.meta = {"id": self.id, "hostname": socket.gethostname()[:255], "cwd": str(Path.cwd())[:1000],
                     "system": env.get("os", "")[:200], "model": model, "tryb": mode,
                     "device_id": (load_device() or {}).get("device_id"), "czat_id": _chat_id()}
        self.thread = threading.Thread(target=self._loop, daemon=True)
        self.thread.start()

    def relink(self, creds, model: str | None, mode: str) -> None:
        """Po /login albo połączeniu z aplikacją w trakcie sesji: sesja przechodzi na aktualne konto
        (nowe urządzenie = nowa sesja po stronie serwera, stara zostaje zamknięta)."""
        dev = (load_device() or {}).get("device_id")
        if self.enabled and self.meta.get("device_id") == dev and (dev or load_creds()):
            self.creds = creds
            return
        if self.enabled:
            self.close()
        self.__init__()
        SESSION["rc"] = False
        self.start(creds, model, mode)

    def close(self) -> None:
        if not self.enabled:
            return
        self.rc = False
        self.closing = True
        self.wake.set()
        if self.thread:
            self.thread.join(3)
        self.stop.set()
        if self.started:
            # W osobnym wątku, najwyżej 3 s: bez sieci (zamknięta klapa, zmiana Wi-Fi) wyjście z Codo
            # czekało do 0.28.0 na limit 240 s i dwie ponowne próby.
            def bye():
                try:
                    api_call(self.creds, f"/cli/sesje/{self.id}/zamknij", {})
                except BaseException:  # noqa: BLE001 — zamknięcie nie może blokować wyjścia
                    pass  # nosec B110
            t = threading.Thread(target=bye, daemon=True)
            t.start()
            t.join(3)

    # ── wpisy ───────────────────────────────────────────────────────────
    def add(self, kind: str, tresc: dict) -> None:
        _app_emit(kind, **tresc)
        if not self.enabled:
            return
        with self.lock:
            if len(self.queue) < 2000:
                self.queue.append({"rodzaj": kind, "tresc": tresc})
        self.wake.set()

    def set_chat(self, czat_id: str) -> None:
        """Nowa rozmowa (/clear): kolejne wpisy i wiadomości z telefonu idą do niej."""
        if not self.enabled:
            return
        self.meta["czat_id"] = czat_id
        with self.lock:
            self.chat_change = czat_id
        self.wake.set()

    def set_state(self, stan: str, opis: str | None = None, pytanie: dict | None = None) -> None:
        if stan != "ask":
            _app_emit("state", stan=stan, opis=(opis or "")[:300])
        if not self.enabled:
            return
        with self.lock:
            self.state = {"stan": stan, "stan_opis": (opis or "")[:300], "pytanie": pytanie,
                          "model": SESSION.get("model"), "tryb": _INPUT_MODE}
        if stan != "busy" or (stan, opis) != self.state_sent:
            self.wake.set()

    def _loop(self) -> None:
        import time as _time
        while not self.stop.is_set():
            self.wake.wait(1.5)
            self.wake.clear()
            try:
                if not self.started:
                    res = api_call(self.creds, "/cli/sesje", self.meta)
                    self.started = True
                    self.rc = bool(res.get("rc"))
                    self.url = res.get("url") or ""
                with self.lock:
                    batch, self.queue = self.queue[:200], self.queue[200:]
                    state = self.state
                    self.state = None
                    chat_change, self.chat_change = self.chat_change, None
                if chat_change:
                    state = dict(state or {}, czat_id=chat_change)
                if not batch and not state:
                    if self.closing:
                        return
                    continue
                body = {"wpisy": batch}
                if state:
                    body.update({k: v for k, v in state.items() if v is not None or k == "pytanie"})
                api_call(self.creds, f"/cli/sesje/{self.id}/wpisy", body)
                if state and "stan" in state:
                    self.state_sent = (state["stan"], state["stan_opis"])
                self.failures = 0
                if len(self.queue):
                    self.wake.set()
            except BaseException as exc:  # noqa: BLE001 — synchronizacja nie może przerwać pracy
                if isinstance(exc, KeyboardInterrupt):
                    raise
                self.failures += 1
                if isinstance(exc, ApiError) and exc.status in (401, 403, 404, 422):
                    self.enabled = False   # brak konta / starszy serwer: pracujemy dalej bez sesji
                    self.why = exc.status
                    return
                with self.lock:
                    if "batch" in locals() and batch:
                        self.queue[:0] = batch
                    if "state" in locals() and state and self.state is None:
                        self.state = state
                _time.sleep(min(30, 2 ** min(self.failures, 5)))
            if not self.enabled:
                return

    # ── zdalne sterowanie ───────────────────────────────────────────────
    def set_rc(self, on: bool) -> str:
        if not self.enabled:
            if not app_linked():
                raise ApiError(400, _L("To urządzenie nie jest połączone z aplikacją DomaAI. Wpisz /rc w terminalu "
                                    "albo: codo login domaai."))
            if self.why is None or not self.creds:
                raise ApiError(400, _L("Sesja nie jest synchronizowana z kontem (DOMA_NO_SYNC lub sync_sessions=false)."))
            # serwer wcześniej odmówił (np. starsza wersja): spróbuj połączyć sesję jeszcze raz
            self.why = None
            self.enabled = True
            self.started = False
            self.failures = 0
            self.thread = threading.Thread(target=self._loop, daemon=True)
            self.thread.start()
        import time as _time
        end = _time.monotonic() + 8
        while not self.started and _time.monotonic() < end:
            self.wake.set()
            _time.sleep(0.2)
        if not self.started:
            if self.why in (401, 403):
                raise ApiError(self.why, _L("Serwer nie przyjął sesji dla tego urządzenia. Zaktualizuj: codo update, albo zaloguj ponownie: codo login."))
            if self.why:
                raise ApiError(self.why, _L("Serwer nie obsługuje jeszcze sesji w aplikacji. Spróbuj po aktualizacji: codo update."))
            raise ApiError(503, _L("Nie udało się połączyć sesji z kontem. Sprawdź internet i spróbuj ponownie."))
        res = api_call(self.creds, f"/cli/sesje/{self.id}/rc", {"wlaczone": on})
        self.rc = bool(res.get("rc"))
        self.url = res.get("url") or self.url
        SESSION["rc"] = self.rc
        self.rc_ruch = _time.monotonic()
        if self.rc and not (self.inbox and self.inbox.is_alive()):
            self.inbox = threading.Thread(target=self._inbox_loop, daemon=True)
            self.inbox.start()
        return self.url

    def _inbox_loop(self) -> None:
        import time as _time
        while self.rc and not self.stop.is_set():
            try:
                res = api_call(self.creds, f"/cli/sesje/{self.id}/skrzynka", {"wait_s": 20})
                self.rc = bool(res.get("rc"))
                SESSION["rc"] = self.rc
                for msg in res.get("wiadomosci") or []:
                    self.rc_ruch = _time.monotonic()
                    _remote_message(msg)
                self.failures = 0
                # zdalne sterowanie nie zostaje otwarte bez końca: po RC_IDLE_H bez wiadomości z telefonu
                # (i bez pracy agenta) wyłącza się samo, /rc włącza je ponownie
                if self.rc and not LIVE.busy and _time.monotonic() - getattr(self, "rc_ruch", 0) > _rc_idle_s():
                    try:
                        self.set_rc(False)
                    except BaseException:  # noqa: BLE001
                        self.rc = False
                        SESSION["rc"] = False
                    LIVE.flash(_L("Zdalne sterowanie wyłączone po bezczynności (/rc włącza ponownie)"))
                    return
            except BaseException as exc:  # noqa: BLE001
                if isinstance(exc, KeyboardInterrupt):
                    raise
                if isinstance(exc, ApiError) and exc.status in (401, 403, 404):
                    self.rc = False
                    SESSION["rc"] = False
                    return
                _time.sleep(3)


def _rc_idle_s() -> float:
    """Po ilu sekundach bez wiadomości z telefonu /rc wyłącza się samo (settings.json: rc_idle_h, 0 = nigdy)."""
    try:
        h = float(os.environ.get("CODO_RC_IDLE_H") or load_settings().get("rc_idle_h", 8))
    except (TypeError, ValueError):
        h = 8.0
    return h * 3600 if h > 0 else float("inf")


SYNC = _SessionSync()


def _remote_message(msg: dict) -> None:
    """Wiadomość z telefonu: tekst do kolejki, przerwanie albo odpowiedź na zgodę."""
    kind = msg.get("rodzaj")
    tresc = msg.get("tresc") or {}
    if SESSION.get("app") and _APP.get("inbox") is not None:
        _app_remote(kind, tresc)
        return
    if kind == "message":
        text = str(tresc.get("tekst") or "").strip()
        if text:
            SESSION.setdefault("remote_texts", []).append(text)
            SESSION.setdefault("queued", []).append(text)
            LIVE.flash(_L("Wiadomość z telefonu") + (": " + text[:60] if text else ""))
    elif kind == "interrupt":
        if LIVE.busy:
            LIVE.flash(_L("Telefon przerywa pracę"))
            _interrupt_main()
    elif kind == "answer":
        LIVE.answer(int(tresc.get("wybor") or 0))


def _take_remote(task: str) -> bool:
    texts = SESSION.get("remote_texts") or []
    if task in texts:
        texts.remove(task)
        return True
    return False


