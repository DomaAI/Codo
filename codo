def disabled_tool_groups() -> set:
    off = load_settings().get("disabled_tools")
    locked = {g[0] for g in _TOOL_GROUPS if g[3]}
    return {str(x) for x in off if str(x) not in locked} if isinstance(off, list) else set()


def disabled_tool_names() -> set:
    off = disabled_tool_groups()
    return {n for g in _TOOL_GROUPS if g[0] in off for n in g[4]}


def enabled_tools(tools: list | None = None) -> list:
    off = disabled_tool_names()
    if _APP["out"] is None:
        off = off | _APP_ONLY_TOOLS   # terminal, przeglądarka i komputer są tylko w oknie Codo
    if _APP["out"] is None or not os.environ.get("CODO_APP_AGENT"):
        off = off | {"agenci"}   # rozmowy z innymi stałymi agentami: tylko stały agent w oknie Codo
    if not _SERVE["on"]:
        off = off | _PANEL_TOOLS   # narzędzia panelu WebStudio tylko w mostku `codo serve`
    if not os.environ.get("CODO_ZESPOL_DIR"):
        off = off | _TEAM_TOOL_NAMES   # narzędzia zespołu tylko u członka zespołu agentów
    else:
        # członek zespołu: bez delegowania i bez narzędzi przez okno (nadzorca nie odpowiada na „bridge”)
        off = off | {"delegate", "agenci", "team_run"} | _APP_ONLY_TOOLS | (
            set() if os.environ.get("CODO_ZESPOL_ROLA") == "lead" else _TEAM_LEAD_TOOLS)
    tools = TOOLS if tools is None else tools
    return [t for t in tools if t["function"]["name"] not in off] if off else tools


