def _hive_date(v):
    """Data z hive.json (sekundy od 2001) na sekundy od 1970; None, gdy jej nie ma."""
    try:
        return float(v) + _HIVE_REF if v is not None and not isinstance(v, bool) else None
    except (TypeError, ValueError):
        return None


def _iso_at(ts: float) -> str:
    import datetime as _dt
    return _dt.datetime.fromtimestamp(ts, _dt.timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ")


def _swarm_scheduled(a) -> bool:
    return isinstance(a, dict) and a.get("repeatKind") in ("hourly", "daily", "weekdays", "weekly") and bool(str(a.get("task") or "").strip())


def _swarm_hours(a: dict) -> list:
    step = max(1, int(a.get("everyHours") or 4))
    h = int(a.get("hour") if a.get("hour") is not None else 8)
    return sorted({(h + i * step) % 24 for i in range(24)})


def _swarm_next(a: dict, after: float, tz=None):
    """Pierwsza zaplanowana pora po `after` (SwarmAuto.next): zegar tego komputera; weekday 1 niedziela … 7 sobota."""
    import datetime as _dt
    kind = a.get("repeatKind")
    minute = int(a.get("minute") or 0) % 60
    hour = int(a.get("hour") if a.get("hour") is not None else 8) % 24
    day = _dt.datetime.fromtimestamp(after, tz).replace(hour=0, minute=0, second=0, microsecond=0)
    if kind == "hourly":
        for _ in range(3):
            for h in _swarm_hours(a):
                t = day.replace(hour=h, minute=minute).timestamp()
                if t > after:
                    return t
            day += _dt.timedelta(days=1)
        return None
    if kind not in ("daily", "weekdays", "weekly"):
        return None
    for _ in range(9):
        w = day.replace(hour=hour, minute=minute)
        if w.timestamp() > after:
            wd = (w.weekday() + 1) % 7 + 1
            if kind == "daily" or (kind == "weekdays" and 2 <= wd <= 6) or (kind == "weekly" and wd == int(a.get("weekday") or 2)):
                return w.timestamp()
        day += _dt.timedelta(days=1)
    return None


def _swarm_group(s: dict, bots: list, a=None) -> dict:
    """Rój jako grupa silnika (hvSwarmGroup w oknie): sposób „pipeline”, miejsca po kolei według strzałek
    (głębokość, potem wysokość na płótnie), kopie bota to kolejne miejsca, najwyżej 8 członków."""
    seats = [x for x in s.get("seats") or [] if isinstance(x, dict) and x.get("id")]
    links = [x for x in s.get("links") or [] if isinstance(x, dict)]
    depth: dict = {}

    def level(sid, guard) -> int:
        if sid in depth:
            return depth[sid]
        ups = [l.get("from") for l in links if l.get("to") == sid and l.get("from") not in guard]
        v = max((level(u, guard | {sid}) for u in ups), default=-1) + 1
        depth[sid] = v
        return v
    for x in seats:
        level(x["id"], frozenset())
    byid = {str(b.get("id") or "").lower(): b for b in bots if isinstance(b, dict)}
    fallback = str(((a or {}).get("fallback") or {}).get("model") or "") if isinstance((a or {}).get("fallback"), dict) else ""
    members = []
    for seat in sorted(seats, key=lambda x: (depth.get(x["id"], 0), float(x.get("y") or 0))):
        b = byid.get(str(seat.get("bot") or "").lower())
        if not b:
            continue
        n = max(1, int(seat.get("count") or 1))
        for i in range(n):
            if len(members) >= 8:
                break
            persona = str(b.get("instructions") or "") + (("\n\n" + str(seat["note"])) if seat.get("note") else "")
            if n > 1:
                persona += f"\n\nJesteś kopią {i + 1} z {n}: weź swoją część."
            target = b.get("target") if isinstance(b.get("target"), dict) else {}
            members.append({"name": (str(b.get("name") or "") or "Bot") + (f" {i + 1}" if n > 1 else ""),
                            "brain": str(target.get("model") or "") or fallback, "role": str(b.get("job") or ""),
                            "persona": persona, "writes": bool(b.get("writes"))})
    return {"name": str(s.get("name") or "") or "Rój", "strategy": "pipeline", "members": members}


def _inbox_line(text: str, limit: int = 140) -> str:
    """Cała odpowiedź jako jedna linia (InboxLogic.oneLine): bez markdownu, ucięta na słowie."""
    words: list = []
    for raw in str(text or "").strip().splitlines():
        line = raw.strip()
        while line and line[0] in "#>*-•":
            line = line[1:].strip()
        line = line.replace("**", "").replace("__", "").replace("`", "")
        if line:
            words.append(line)
        if len(" ".join(words)) > limit:
            break
    out = " ".join(words)
    if len(out) <= limit:
        return out
    cut = out[:limit].rsplit(" ", 1)[0] or out[:limit]
    return cut.rstrip(" ,.;:") + "…"


def _inbox_add(entry: dict, now: float | None = None) -> None:
    """Wpis do skrzynki botów (skrzynka.json, ten sam plik co BotInbox na Macu): najnowsze 200 z 14 dni."""
    import time
    p = HOST_DIR.parent / "skrzynka.json"
    try:
        d = json.loads(p.read_text(encoding="utf-8"))
    except (OSError, ValueError):
        d = {}
    d = d if isinstance(d, dict) else {}
    rows = [e for e in d.get("entries") or [] if isinstance(e, dict) and e.get("id") and e.get("id") != entry.get("id")]
    rows.append(entry)
    edge = _iso_at((now or time.time()) - 14 * 86400)
    rows = sorted((e for e in rows if str(e.get("at") or "") >= edge), key=lambda e: str(e.get("at") or ""), reverse=True)
    d["entries"] = rows[:200]
    d.setdefault("ticks", [])
    p.parent.mkdir(parents=True, exist_ok=True)
    _atomic_write(p, json.dumps(d, ensure_ascii=False).encode("utf-8"))


def _hive_log_add(entry: dict) -> None:
    """Bieg roju w hive-log.json (HiveLogEntry): najnowszy pierwszy, najwyżej 200."""
    p = HOST_DIR.parent / "hive-log.json"
    try:
        rows = json.loads(p.read_text(encoding="utf-8"))
    except (OSError, ValueError):
        rows = []
    rows = [entry] + [r for r in (rows if isinstance(rows, list) else []) if isinstance(r, dict)]
    p.parent.mkdir(parents=True, exist_ok=True)
    _atomic_write(p, json.dumps(rows[:200], ensure_ascii=False).encode("utf-8"))


def _host_swarm_runner(group: dict, task: str, folder: str, emit, run_id: str, keep=None) -> None:
    """Bieg roju w procesie gospodarza: ta sama grupa silnika co puszczenie roju z okna (group_start)."""
    g, err = _group_check(group)
    if err:
        emit("group_error", {"run_id": run_id, "tekst": err})
        return
    run = _group_start(g, task, folder, emit=emit, source={"kind": "hive", "ref": "host"}, run_id=run_id)
    if keep:
        keep(run)
    run.go()


class HostSwarms:
    """Roje bez okna: o stałej porze (hive.json) i „Zleć pracę” z okna z wynikiem na komunikatory."""

    def __init__(self, host, runner=None):
        self.h = host
        self.runner = runner or _host_swarm_runner
        self.runs: dict = {}
        last = _host_load("roje.json", {})
        self.last = last if isinstance(last, dict) else {}    # rój → kiedy gospodarz puścił go ostatnio (od 1970)
        # na Macu roje puszcza aplikacja; gospodarz tam tylko na wyraźne życzenie
        self.on = sys.platform != "darwin" or os.environ.get("CODO_HOST_SWARMS") == "1"
        self.tz = None
        self.spawn = lambda fn: threading.Thread(target=fn, daemon=True).start()

    def state(self) -> list:
        return [{k: r[k] for k in ("run_id", "swarm", "name", "task", "origin", "started", "total")} for r in self.runs.values()]

    def tick(self, now: float) -> None:
        if not self.on:
            return
        hive = _hive_read_host()
        fired = []
        for s in hive.get("swarms") or []:
            a = s.get("auto") if isinstance(s, dict) else None
            if not _swarm_scheduled(a) or not s.get("id"):
                continue
            sid = str(s["id"])
            armed = _hive_date(a.get("armed")) or 0.0
            since = max(armed, _hive_date(a.get("lastRun")) or armed, float(self.last.get(sid) or 0))
            due = _swarm_next(a, since, self.tz)
            if due is None or due > now:
                continue
            self.last[sid] = now
            fired.append(sid)
            if any(r["swarm"] == sid for r in self.runs.values()):
                continue          # rój jeszcze pracuje: ta pora przepada, nie piętrzy się
            # przegapione (komputer spał): raz teraz, bez nadrabiania każdej pory
            self.start(s, hive, str(a.get("task") or ""), "schedule")
        if fired:
            _host_save("roje.json", self.last)
            self.mark(fired, now)

    @staticmethod
    def mark(ids: list, now: float) -> None:
        """lastRun w hive.json, jak na Macu (okno pokazuje ostatni bieg); reszta pliku zostaje."""
        d = _hive_read_host()
        hit = False
        for s in d.get("swarms") or []:
            if isinstance(s, dict) and str(s.get("id")) in ids and isinstance(s.get("auto"), dict):
                s["auto"]["lastRun"] = round(now - _HIVE_REF, 3)
                hit = True
        if hit:
            _atomic_write(_hive_path(), json.dumps(d, ensure_ascii=False, indent=1, sort_keys=True).encode("utf-8"))

    def listeners(self, a: dict, origin: str, report) -> list:
        """Komunikatory, które słyszą o biegu: skąd przyszedł, co wybrano, przełączniki roju; bieg z harmonogramu bez
        żadnego wybranego idzie na wszystkie połączone (HiveStore.listeners)."""
        paired = [n for n, c in self.h.chats.items() if getattr(c, "chat", None)]
        picked = [n for n in paired if n == origin or n in (report or ()) or (a or {}).get(n) is True]
        return paired if origin == "schedule" and not picked else picked

    def say(self, names: list, text: str) -> None:
        for n in names:
            c = self.h.chats.get(n)
            if c is not None and getattr(c, "chat", None):
                c.send(text)

    def start(self, s: dict, hive: dict, task: str, origin: str, report=(), folder: str = "") -> tuple:
        """(id biegu, "") albo ("", co poszło nie tak)."""
        import secrets
        a = s.get("auto") if isinstance(s.get("auto"), dict) else {}
        name = str(s.get("name") or "") or "Rój"
        to = self.listeners(a, origin, report)
        task = str(task or "").strip()
        folder = _trig_expand(folder or a.get("folder") or "")
        if not task:
            return "", "Napisz, co trzeba zrobić."
        if not folder or not os.path.isdir(folder):
            line = "Nie ma projektu do pracy: wybierz folder w ustawieniach roju w Codo."
            self.say(to, line)
            return "", line
        group = _swarm_group(s, hive.get("bots") or [], a)
        if not group["members"]:
            return "", "Ten rój nie ma jeszcze botów."
        rid = "roj-" + secrets.token_hex(5)
        run = {"run_id": rid, "swarm": str(s.get("id") or ""), "name": name, "task": task, "origin": origin,
               "listeners": to, "started": self.h.clock(), "total": len(group["members"]), "handle": None, "stop": False}
        self.runs[rid] = run
        self.say(to, f"«{name}» rusza" + (" (według harmonogramu)" if origin == "schedule" else "") + ": " + task[:300])
        self.h.push({"ev": "swarm", "type": "swarm_started", "run_id": rid, "swarm": run["swarm"], "task": task,
                     "total": run["total"], "origin": origin})

        def emit(kind: str, data: dict, rid=rid) -> None:
            self.h.q.put(("swarm", rid, kind, data))

        def keep(handle, run=run) -> None:
            run["handle"] = handle
            if run["stop"]:
                handle.stop("")

        def work() -> None:
            try:
                self.runner(group, task, folder, emit, rid, keep)
            except Exception as exc:  # noqa: BLE001 — bieg nie może położyć gospodarza
                emit("group_error", {"run_id": rid, "tekst": str(exc)[:300]})
        self.spawn(work)
        self.h.dirty = True
        return rid, ""

    def stop(self, rid: str) -> bool:
        r = self.runs.get(rid)
        if not r:
            return False
        r["stop"] = True
        if r["handle"] is not None:
            r["handle"].stop("")
        return True

    def on_event(self, rid: str, kind: str, data: dict) -> None:
        r = self.runs.get(rid)
        if not r:
            return
        if kind != "group_member_event":      # strumień każdego członka zostaje w biegu, okno dostaje stan
            self.h.push({"ev": "swarm", "type": kind, "swarm": r["swarm"], **dict(data or {}), "run_id": rid})
        if kind == "group_done":
            self.finish(r, data or {})
        elif kind == "group_error":
            self.finish(r, {"status": "failed", "note": str((data or {}).get("tekst") or "")})

    def finish(self, r: dict, d: dict) -> None:
        import uuid
        self.runs.pop(r["run_id"], None)
        now = self.h.clock()
        status = str(d.get("status") or "failed")
        text = str((d.get("result") or {}).get("text") or "").strip() if isinstance(d.get("result"), dict) else ""
        secs = float(d.get("seconds") or max(0.0, now - r["started"]))
        ok = status == "done" and bool(text)
        lid = str(uuid.uuid4()).upper()
        _hive_log_add({"id": lid, "swarm": r["swarm"], "swarmName": r["name"], "origin": r["origin"], "task": r["task"],
                       "started": _iso_at(r["started"]), "seconds": round(secs, 1), "ok": ok, "result": text[:20000]})
        if r["origin"] != "workflow":
            _inbox_add({"id": "swarm-" + lid, "kind": "swarm", "who": r["name"], "at": _iso_at(now),
                        "summary": _inbox_line(_host_plain(text)) if ok else "Zakończył się bez wyniku.", "ok": ok,
                        "seen": False, "ref": r["swarm"]}, now)
        n = max(0, int(secs))
        clock = f"{n // 60}:{n % 60:02d}"
        if status == "stopped":
            msg = f"«{r['name']}» zatrzymane · {clock}"
        elif not text:
            msg = f"«{r['name']}»: brak wyniku · {clock}\n" + (str(d.get("note") or "").strip() or "Bez odpowiedzi")
        else:
            msg = f"«{r['name']}» gotowe · {clock}\n\n" + _host_plain(text)
        self.say(r["listeners"], msg)
        self.h.dirty = True


def _host_trig_command(h, cmd: str, msg: dict) -> dict:
    """Polecenia okna dla wyzwalaczy i rojów (gniazdo gospodarza)."""
    tr, sw = h.triggers, h.swarms
    if cmd == "hook_new":
        return {"ok": True, **tr.new_hook(str(msg.get("agent") or ""))}
    if cmd == "hook_key":
        import secrets
        hook = str(msg.get("hook") or "")
        if hook not in tr.hooks:
            return {"ok": False, "error": "Nie ma takiego adresu."}
        key = secrets.token_urlsafe(24)
        tr.hooks[hook]["key"] = _trig_hash(key)
        _host_save("webhooki.json", tr.hooks)
        return {"ok": True, "hook": hook, "key": key, "url": _trig_hook_cfg()["base"] + "/hook/" + hook}
    if cmd == "hook_delete":
        gone = tr.hooks.pop(str(msg.get("hook") or ""), None)
        _host_save("webhooki.json", tr.hooks)
        return {"ok": gone is not None}
    if cmd == "hook_info":
        c = _trig_hook_cfg()
        return {"ok": True, "base": c["base"], "listening": bool(tr.server), "bind": c["bind"], "port": c["port"]}
    if cmd == "path_check":
        p = _trig_expand(msg.get("path"))
        return {"ok": True, "path": p, "dir": bool(p) and os.path.isdir(p), "git": bool(p) and os.path.isdir(os.path.join(p, ".git"))}
    if cmd == "swarm_run":
        s = msg.get("swarm")
        if not isinstance(s, dict):
            return {"ok": False, "error": "Nie ma takiego roju."}
        report = [str(x) for x in msg.get("report") or [] if isinstance(x, str)]
        rid, err = sw.start(s, _hive_read_host(), str(msg.get("task") or ""), str(msg.get("origin") or "delegate"),
                            report, str(msg.get("folder") or ""))
        return {"ok": not err, "run_id": rid, "error": err}
    if cmd == "swarm_stop":
        return {"ok": sw.stop(str(msg.get("run_id") or ""))}
    if cmd == "swarm_runs":
        return {"ok": True, "runs": sw.state()}
    return {"ok": False, "error": f"nieznane polecenie {cmd}"}


# ── Pokoje (27.11.2026): wspólne wątki użytkownika i kilku stałych agentów, jak AgentRooms.swift na Macu ──
# Ten sam plik DOMA_CONFIG_DIR/agent-rooms.json i ten sam format (Codable Swifta: daty ISO 8601 bez ułamków,
# UUID agentów wielkimi literami), więc pokój zrobiony na Macu otwiera się tu i odwrotnie. Logika żyje
# w gospodarzu agentów, więc agenci odpowiadają sobie w pokoju także przy zamkniętym oknie.
# Kto odpowiada: bez wskazania prowadzący (pierwszy na liście), @Imię ten agent, @all/@wszyscy wszyscy;
# agent, który wspomni innego w odpowiedzi, wciąga go. CISZA = nic do dodania. Między agentami te same
# limity co w ich poczcie: 60 wiadomości na godzinę, 6 kroków bez człowieka.
_ROOM_LAST_LINES, _ROOM_KEEP = 14, 400
_HOST_ROOM_CMDS = ("rooms", "room_create", "room_rename", "room_toggle", "room_lead", "room_clear", "room_delete",
                   "room_say", "room_resend", "room_stop", "room_read")
# notki Codo w pokoju: klucz angielski (okno tłumaczy go na swój język), tekst w pliku po polsku albo po angielsku
_ROOM_NOTES = {
    "Add an agent to this room first.": "Najpierw dodaj agenta do tego pokoju.",
    "The agents have talked %d steps without you: they wait for you now.":
        "Agenci rozmawiali już %d kroków bez Ciebie: teraz czekają na Ciebie.",
    "The limit of messages between agents for this hour is reached. Write again later.":
        "Limit wiadomości między agentami na tę godzinę się wyczerpał. Napisz później.",
    "«%@» could not answer.": "«%@» nie zdołał odpowiedzieć.",
}


def _room_iso(t: float) -> str:
    import datetime as _dt
    return _dt.datetime.fromtimestamp(int(t), _dt.timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ")


def _room_time(v) -> float:
    import datetime as _dt
    try:
        return _dt.datetime.fromisoformat(str(v).replace("Z", "+00:00")).timestamp()
    except (TypeError, ValueError):
        return 0.0


def _room_key() -> str:
    import uuid
    return str(uuid.uuid4())[:12]


def _room_quiet(answer: str) -> bool:
    """AgentDesks.quiet: pusta odpowiedź albo jedno słowo ciszy."""
    t = re.sub(r"^[^\w]+|[^\w]+$", "", str(answer or "").upper())
    return not t or t in ("CISZA", "QUIET", "SILENT", "NIC NOWEGO", "NOTHING NEW") or t.startswith("CISZA")


def _room_clean(answer: str) -> str:
    """Co z odpowiedzi trafia do pokoju: bez linii pamięci i bloków dla Codo."""
    lines, block = [], False
    for line in str(answer or "").split("\n"):
        t = line.strip()
        if t.startswith("```agenci"):
            block = True
            continue
        if block:
            if t.startswith("```"):
                block = False
            continue
        if t.upper().startswith("ZAPAMIĘTAJ:") or t.upper().startswith("REMEMBER:"):
            continue
        lines.append(line)
    return "\n".join(lines).strip()


def _room_norm(r) -> dict | None:
    """Pokój z pliku: wszystkie pola, których wymaga dekoder Swifta, plus nieznane (zostają)."""
    if not isinstance(r, dict) or not r.get("id"):
        return None
    out = dict(r)
    out["id"] = str(r["id"])
    out["name"] = str(r.get("name") or "")
    out["members"] = [str(m) for m in r.get("members") or [] if m]
    msgs = []
    for m in r.get("messages") or []:
        if not isinstance(m, dict) or not m.get("id"):
            continue
        x = dict(m)
        x["id"], x["name"], x["text"] = str(m["id"]), str(m.get("name") or ""), str(m.get("text") or "")
        x["date"] = str(m.get("date") or _now_iso())
        x["depth"], x["system"] = int(m.get("depth") or 0), bool(m.get("system"))
        if not x.get("author"):
            x.pop("author", None)
        msgs.append(x)
    out["messages"] = msgs[-_ROOM_KEEP:]
    out["created"] = str(r.get("created") or _now_iso())
    if not r.get("lastRead"):
        out.pop("lastRead", None)
    return out


class HostRooms:
    """Pokoje u gospodarza: plik, kto pisze, kto dostaje wiadomość, limity, kontekst dla agenta."""

    def __init__(self, host):
        self.h = host
        self.rooms: list = []
        self.writing: dict = {}        # id pokoju → [id agentów, którzy teraz piszą]
        self.halted: set = set()       # (pokój, agent) zatrzymani przez Ciebie: bez notki „nie mógł odpowiedzieć”
        self.stamp = None
        self.load()

    @staticmethod
    def path() -> Path:
        return HOST_DIR.parent / "agent-rooms.json"   # DOMA_CONFIG_DIR, jak ConversationStore.configDir na Macu

    # ── plik ──
    def load(self) -> None:
        p = self.path()
        try:
            st = p.stat()
            data = json.loads(p.read_text("utf-8"))
        except (OSError, ValueError):
            self.rooms, self.stamp = [], None
            return
        self.rooms = [x for x in (_room_norm(r) for r in (data if isinstance(data, list) else [])) if x]
        self.stamp = (st.st_mtime_ns, st.st_size)

    def fresh(self) -> None:
        """Plik zmieniony z zewnątrz (Mac, drugi gospodarz, ręcznie): czytamy go od nowa przed zmianą."""
        try:
            st = self.path().stat()
            now = (st.st_mtime_ns, st.st_size)
        except OSError:
            now = None
        if now != self.stamp:
            self.load()

    def save(self) -> None:
        p = self.path()
        try:
            p.parent.mkdir(parents=True, exist_ok=True)
            tmp = p.with_name(p.name + ".tmp")
            tmp.write_text(json.dumps(self.rooms, ensure_ascii=False, indent=1), "utf-8")
            os.replace(tmp, p)
            st = p.stat()
            self.stamp = (st.st_mtime_ns, st.st_size)
        except OSError:
            pass

    def room(self, rid: str):
        return next((r for r in self.rooms if r["id"] == str(rid or "")), None)

    def view(self, r: dict) -> dict:
        return {**r, "writing": list(self.writing.get(r["id"]) or [])}

    def state(self) -> dict:
        return {"rooms": [self.view(r) for r in self.rooms]}

    def changed(self, r: dict | None, persist: bool = True) -> None:
        if persist:
            self.save()
        if r is not None:
            self.h.push({"ev": "room", "room": self.view(r)})

    # ── kto jest w pokoju ──
    def agents(self, r: dict) -> list:
        """Agenci pokoju, którzy jeszcze są u gospodarza: (id jak w pliku, agent)."""
        out = []
        for mid in r["members"]:
            a = self.h.agents.get(str(mid).lower())
            if a:
                out.append((mid, a))
        return out

    @staticmethod
    def same(a, b) -> bool:
        return bool(a) and bool(b) and str(a).lower() == str(b).lower()

    def recipients(self, r: dict, m: dict) -> list:
        members = self.agents(r)
        low = str(m.get("text") or "").lower()
        author = m.get("author")
        if "@wszyscy" in low or "@all" in low or "@everyone" in low:
            return [mid for mid, _a in members if not self.same(mid, author)]
        named = []
        for mid, a in sorted(members, key=lambda x: -len(x[1].get("name") or "")):
            n = str(a.get("name") or "").lower()
            if n and ("@" + n in low or "@" + n.replace(" ", "") in low) and mid not in named:
                named.append(mid)
        named = [x for x in named if not self.same(x, author)]
        if named:
            return [mid for mid, _a in members if mid in named]       # w kolejności pokoju
        if not author and members:
            return [members[0][0]]
        return []

    # ── polecenia okna ──
    def create(self, name: str, members: list) -> dict:
        self.fresh()
        n = str(name or "").strip() or ("Pokój %d" if ui_lang() == "pl" else "Room %d") % (len(self.rooms) + 1)
        now = self.h.clock()
        r = {"id": "r-" + _room_key()[:8], "name": n[:120], "members": [str(m) for m in members or [] if m],
             "messages": [], "created": _room_iso(now), "lastRead": _room_iso(now)}
        self.rooms.append(r)
        self.changed(r)
        return r

    def change(self, rid: str, fn, persist: bool = True):
        self.fresh()
        r = self.room(rid)
        if r is None:
            return None
        fn(r)
        self.changed(r, persist)
        return r

    def toggle(self, rid: str, member: str):
        def f(r):
            hit = next((x for x in r["members"] if self.same(x, member)), None)
            if hit:
                r["members"].remove(hit)
            else:
                r["members"].append(str(member))
        return self.change(rid, f)

    def lead(self, rid: str, member: str):
        def f(r):
            hit = next((x for x in r["members"] if self.same(x, member)), None)
            if hit:
                r["members"].remove(hit)
                r["members"].insert(0, hit)
        return self.change(rid, f)

    def delete(self, rid: str) -> bool:
        self.fresh()
        r = self.room(rid)
        if r is None:
            return False
        self.stop(rid)
        self.rooms.remove(r)
        self.writing.pop(r["id"], None)
        self.save()
        self.h.push({"ev": "room_gone", "id": r["id"]})
        return True

    def read(self, rid: str):
        return self.change(rid, lambda r: r.__setitem__("lastRead", _room_iso(self.h.clock())))

    def append(self, r: dict, m: dict) -> None:
        r["messages"].append(m)
        if len(r["messages"]) > _ROOM_KEEP:
            del r["messages"][:len(r["messages"]) - _ROOM_KEEP]

    def note(self, r: dict, key: str, *args) -> None:
        text = _ROOM_NOTES.get(key, key) if ui_lang() == "pl" else key
        for a in args:
            text = text.replace("%d", str(a), 1) if "%d" in text else text.replace("%@", str(a), 1)
        self.append(r, {"id": _room_key(), "name": "Codo", "text": text, "date": _room_iso(self.h.clock()), "depth": 0,
                        "system": True, "note_key": key, "note_args": [str(a) for a in args]})

    def say(self, rid: str, text: str):
        t = str(text or "").strip()
        self.fresh()
        r = self.room(rid)
        if not t or r is None:
            return None
        now = self.h.clock()
        m = {"id": _room_key(), "name": "Ty" if ui_lang() == "pl" else "You", "text": t[:20000], "date": _room_iso(now),
             "depth": 0, "system": False}
        self.append(r, m)
        r["lastRead"] = _room_iso(now)
        self.dispatch(r, m)
        self.changed(r)
        return r

    def resend(self, rid: str):
        self.fresh()
        r = self.room(rid)
        if r is None or not r["messages"]:
            return None
        m = r["messages"][-1]
        if m.get("author") or m.get("system"):
            return None
        self.dispatch(r, m)
        self.changed(r)
        return r

    def stop(self, rid: str) -> int:
        who = list(self.writing.pop(str(rid), None) or [])
        self.halted.update((str(rid), mid) for mid in who)
        for mid in who:
            if str(mid).lower() in self.h.agents:
                self.h.stop_agent(str(mid).lower())
        r = self.room(rid)
        if r is not None:
            self.h.push({"ev": "room", "room": self.view(r)})
        return len(who)

    # ── rozmowa ──
    def dispatch(self, r: dict, m: dict) -> None:
        to = self.recipients(r, m)
        if not to:
            if not m.get("author"):
                self.note(r, "Add an agent to this room first.")
            return
        if m.get("author"):
            # agenci wciągający agentów: te same limity co ich poczta
            if int(m.get("depth") or 0) > _HOST_MAX_DEPTH:
                self.note(r, "The agents have talked %d steps without you: they wait for you now.", _HOST_MAX_DEPTH)
                return
            now = self.h.clock()
            self.h.sent = [t for t in self.h.sent if now - t < 3600]
            if len(self.h.sent) + len(to) > _HOST_HOURLY:
                self.note(r, "The limit of messages between agents for this hour is reached. Write again later.")
                return
            self.h.sent.extend([now] * len(to))
        depth = int(m.get("depth") or 0)
        for mid in to:
            a = self.h.agents.get(str(mid).lower())
            if not a:
                continue
            w = self.writing.setdefault(r["id"], [])
            if mid not in w:
                w.append(mid)
            text = self.prompt(m) + _HOST_NOTE + self.context(r, mid, a, m)
            rid = r["id"]

            def back(answer: str, ok: bool, rid=rid, mid=mid) -> None:
                self.answered(rid, mid, answer, ok, depth)
            self.h.tell(a["id"], text, ("room", rid, r["name"]), back=("here", a["id"]), depth=depth, reply=back)

    def answered(self, rid: str, mid: str, answer: str, ok: bool, depth: int) -> None:
        w = self.writing.get(rid)
        if w and mid in w:
            w.remove(mid)
        halted = (rid, mid) in self.halted
        self.halted.discard((rid, mid))
        self.fresh()
        r = self.room(rid)
        a = self.h.agents.get(str(mid).lower())
        if r is None or a is None:
            return
        text = _room_clean(answer)
        if not text or _room_quiet(text):
            if not ok and not halted:
                self.note(r, "«%@» could not answer.", a["name"])
                self.changed(r)
            else:
                self.changed(r, persist=False)
            return
        m = {"id": _room_key(), "author": mid, "name": a["name"], "text": text, "date": _room_iso(self.h.clock()),
             "depth": depth + 1, "system": False}
        self.append(r, m)
        self.dispatch(r, m)
        self.changed(r)

    @staticmethod
    def prompt(m: dict) -> str:
        return m["text"] if not m.get("author") else f"[«{m['name']}» w pokoju]\n" + m["text"]

    def context(self, r: dict, me_id: str, me: dict, m: dict) -> str:
        others = [a for mid, a in self.agents(r) if not self.same(mid, me_id)]
        out = f"Pokój «{r['name']}»: wspólny wątek użytkownika z jego stałymi agentami. Jesteś w nim jako «{me['name']}»"
        lead = r["members"][0] if r["members"] else ""
        out += " i prowadzisz go: odpowiadasz na to, co użytkownik pisze bez wskazania kogoś." if self.same(lead, me_id) else "."
        if others:
            out += "\nInni w pokoju: " + ", ".join(a["name"] + (f" ({a['job']})" if a.get("job") else "") for a in others) + "."
        earlier = [x for x in r["messages"] if x["id"] != m["id"] and not x.get("system")][-_ROOM_LAST_LINES:]
        if earlier:
            rows = []
            for x in earlier:
                who = "Użytkownik" if not x.get("author") else (f"Ty ({x['name']})" if self.same(x.get("author"), me_id) else x["name"])
                rows.append(f"{who}: " + x["text"][:700])
            out += "\n\nOSTATNIE WIADOMOŚCI W POKOJU (od najstarszej):\n" + "\n".join(rows)
        out += ("\n\nTwoja odpowiedź trafi do pokoju i przeczytają ją wszyscy. Pisz krótko, jak na czacie, w swojej roli. "
                "Gdy ktoś z pokoju ma się odezwać, wspomnij go: @Nazwa (dostanie wiadomość). Nie wspominaj nikogo bez potrzeby "
                "i nie odbijaj rozmowy tam i z powrotem. Bez wstępów i bez podsumowań typu „zrobiłem tyle”: sama treść. "
                "Gdy nie masz nic do dodania, odpowiedz dokładnie jednym słowem: CISZA.")
        return out

    def command(self, cmd: str, msg: dict) -> dict:
        rid = str(msg.get("id") or "")
        if cmd == "rooms":
            self.fresh()
            return {"ok": True, **self.state()}
        if cmd == "room_create":
            r = self.create(str(msg.get("name") or ""), msg.get("members") if isinstance(msg.get("members"), list) else [])
            return {"ok": True, "room": self.view(r)}
        if cmd == "room_delete":
            return {"ok": self.delete(rid)}
        if cmd == "room_stop":
            return {"ok": True, "stopped": self.stop(rid)}
        if cmd == "room_rename":
            n = str(msg.get("name") or "").strip()
            r = self.change(rid, lambda x: x.__setitem__("name", n[:120])) if n else None
        elif cmd == "room_toggle":
            r = self.toggle(rid, str(msg.get("member") or "")) if msg.get("member") else None
        elif cmd == "room_lead":
            r = self.lead(rid, str(msg.get("member") or "")) if msg.get("member") else None
        elif cmd == "room_clear":
            r = self.change(rid, lambda x: x.__setitem__("messages", []))
        elif cmd == "room_say":
            r = self.say(rid, str(msg.get("text") or ""))
        elif cmd == "room_resend":
            r = self.resend(rid)
        elif cmd == "room_read":
            r = self.read(rid)
        else:
            return {"ok": False, "error": f"nieznane polecenie {cmd}"}
        return {"ok": r is not None, **({"room": self.view(r)} if r is not None else {})}


class AgentHost:
    """Pętla gospodarza: zdarzenia silników, Telegrama i okna Codo w jednej kolejce, bez wyścigów."""

    def __init__(self, engine_factory=None):
        import queue
        self.q = queue.Queue()
        self.factory = engine_factory or HostEngine
        self.agents: dict = {}
        self.order: list = []
        self.engines: dict = {}
        self.queues: dict = {}
        self.current: dict = {}
        self.turn_sent: dict = {}
        self.stopped: set = set()
        self.posts: list = []
        self.sent: list = []
        self.waiting: dict = {}        # kto na kogo czeka (pytanie z czekaniem)
        self.asks: dict = {}           # klucz zgody → (agent, id pytania w silniku)
        self.timers: list = []         # (kiedy, funkcja)
        self.clients: list = []        # podłączone okna Codo (gniazda)
        self.chats: dict = {}          # komunikatory: telegram, discord, slack, whatsapp
        self.remote: list = []         # stali agenci, którzy zostali na Macu (z agents.json „remote”)
        self.remote_wait: dict = {}    # klucz → co zrobić z odpowiedzią agenta z Maca
        self.talking: dict = {}        # komunikator → agent, z którym toczy się tam rozmowa
        self.exit = False
        self._secrets = _host_secrets()
        self.last_beat_check = 0.0
        self.extra: dict = {}          # ustawienia z agents.json poza agentami: cap, quiet, zone
        self.awake_since = self.clock()   # od kiedy gospodarz działa bez przerwy (nadrabianie sprawdzeń)
        self.last_tick = 0.0
        self.spend = _host_load("wydatki.json", {})    # dzisiejsza praca w tle: {"day", "agents": {id: wydatek}, "noticed"}
        held = _host_load("cisza.json", {})            # zgłoszenia wstrzymane w godzinach ciszy: {id: [{"at", "text"}]}
        self.held = {str(k): v for k, v in held.items() if isinstance(v, list) and v} if isinstance(held, dict) else {}
        self.held_asks: list = []      # prośby o zgodę, które czekają na koniec ciszy
        self.dirty = True
        self.triggers = HostTriggers(self)   # wyzwalacze agentów (folder, PR, poczta, webhook)
        self.swarms = HostSwarms(self)       # roje o stałej porze i „Zleć pracę” z wynikiem na komunikatory
        self.rooms = HostRooms(self)         # pokoje: wspólne wątki z kilkoma agentami (agent-rooms.json)
        self.last_trig_tick = 0.0
        self.load()

    @staticmethod
    def clock() -> float:
        import time
        return time.time()

    @property
    def tg(self):
        return self.chats.get("telegram")

    @tg.setter
    def tg(self, value) -> None:
        if value is None:
            self.chats.pop("telegram", None)
        else:
            self.chats["telegram"] = value

    def chat_word(self, name: str) -> str:
        c = self.chats.get(name)
        return getattr(c, "where_word", "") or {"telegram": "na Telegramie", "discord": "na Discordzie", "slack": "na Slacku",
                                                "whatsapp": "na WhatsAppie", "signal": "na Signalu",
                                                "email": "w mailu"}.get(name, "na czacie")

    def chat_title(self, name: str) -> str:
        c = self.chats.get(name)
        return getattr(c, "title", "") or {"telegram": "Telegram", "discord": "Discord", "slack": "Slack",
                                           "whatsapp": "WhatsApp", "signal": "Signal", "email": "E-mail"}.get(name, name)

    def report_chats(self, aid: str) -> list:
        """Komunikatory, na które agent pisze sam od siebie (sprawdzanie, zgody): wybrane w oknie, a gdy nic, wszystkie."""
        a = self.agents.get(aid) or {}
        want = a.get("reports")
        names = [n for n in self.chats if want is None or n in want]
        return [n for n in names if self.chats[n].chat]

    # ── stan na dysku ──
    def load(self) -> None:
        data = _host_load("agents.json", {})
        self.agents, self.order = {}, []
        for a in data.get("agents") or []:
            if isinstance(a, dict) and a.get("id") and a.get("name"):
                a["id"] = str(a["id"]).lower()
                self.agents[a["id"]] = a
                self.order.append(a["id"])
        self.posts = [p for p in _host_load("mail.json", []) if isinstance(p, dict) and p.get("id")]
        self.remote = [r for r in data.get("remote") or [] if isinstance(r, dict) and r.get("id") and r.get("name")]
        self.profile = _profile_merge(data.get("profile") or [], [])   # wspólny profil użytkownika dla wszystkich agentów
        self.extra = {k: data[k] for k in _HOST_EXTRA if k in data}

    def save_agents(self) -> None:
        _host_save("agents.json", {"agents": [self.agents[i] for i in self.order if i in self.agents], "remote": self.remote,
                                   "profile": getattr(self, "profile", []), **self.extra})

    # ── agenci, którzy zostali na Macu ──
    def find_remote(self, raw):
        name = str(raw or "").strip(" @«»\n").lower()
        if not name:
            return None
        return next((r for r in self.remote if str(r["id"]).lower() == name or r["name"].lower() == name), None) \
            or next((r for r in self.remote if r["name"].lower().startswith(name)), None)

    def remote_call(self, me: dict, r: dict, kind: str, text: str, title: str, on_answer) -> str:
        """Praca dla agenta z Maca: okno Codo (podłączone przez attach) uruchamia go u siebie i odsyła odpowiedź.
        Zwraca komunikat błędu albo "" (poszło)."""
        if not self.clients:
            return (f"«{r['name']}» pracuje na Macu, a Mac jest teraz niedostępny (wyłączony albo bez Codo). "
                    "Zrób to sam albo spróbuj później.")
        no = self.refusal(me["id"])
        if no:
            return no
        import time
        head = {"handoff": "Zadanie", "ask": "Pytanie", "note": "Wiadomość"}.get(kind, "Wiadomość")
        key = _host_key()
        self.remote_wait[key] = on_answer
        self.sent.append(time.time())
        self.push({"ev": "remote_ask", "key": key, "to": r["id"], "from": me["id"], "from_name": me["name"], "kind": kind,
                   "title": title, "text": f"[{head} od «{me['name']}»]" + (" " + title if title else "") + "\n\n" + text})

        def expire() -> None:
            fn = self.remote_wait.pop(key, None)
            if fn:
                fn("", False)
        self.after(4 * 3600, expire)
        return ""

    def remote_answer(self, key: str, text: str, ok: bool) -> bool:
        fn = self.remote_wait.pop(str(key), None)
        if not fn:
            return False
        fn(str(text or ""), bool(ok))
        return True

    def remote_bridge(self, act: str, a: dict, me: dict, reply) -> bool:
        """agenci.napisz / agenci.przekaz do agenta z Maca. False = to nie agent z Maca."""
        if self.find(a.get("agent"), than=me["id"]):
            return False
        r = self.find_remote(a.get("agent"))
        if not r:
            return False
        text = str(a.get("tekst") or "").strip()
        if not text:
            reply({"error": "Pusty tekst."})
            return True
        cur = self.current.get(me["id"]) or {}
        back = tuple(cur.get("back") or ("here", me["id"]))
        if act == "przekaz":
            title = str(a.get("tytul") or "").strip()[:120] or _host_headline(text)

            def done(answer: str, ok: bool) -> None:
                body = (r["name"] + "\n\n" + answer) if answer else (
                    f"«{r['name']}» skończył zadanie «{title}» bez odpowiedzi na piśmie." if ok else f"«{r['name']}» nie dokończył zadania «{title}».")
                self.log(me["id"], "info", f"Wynik od «{r['name']}» (na Macu): " + _host_headline(answer or body), src="remote")
                self.deliver(back, body)
            err = self.remote_call(me, r, "handoff", text, title, done)
            reply({"error": err} if err else {"text": f"Przekazane: «{r['name']}» (na Macu). Wynik trafi prosto do użytkownika; "
                                                      "nie opisuj tego zadania dalej, zakończ turę krótko."})
            return True
        mode = a.get("odpowiedz") if a.get("odpowiedz") in ("teraz", "pozniej", "nie") else ("nie" if a.get("czekaj") is False else "teraz")
        state = {"done": False}

        def later(answer: str, ok: bool) -> None:
            if answer and ok and not _host_quiet(answer):
                self.tell(me["id"], f"[Odpowiedź od «{r['name']}»]\n\n{answer}", ("agent", r["id"], r["name"]), back=back,
                          depth=int(cur.get("depth") or 0) + 1, deliver=True)

        def now(answer: str, ok: bool) -> None:
            if state["done"]:
                later(answer, ok)
                return
            state["done"] = True
            self.waiting.pop(me["id"], None)
            reply({"text": f"Odpowiedź od «{r['name']}»:\n\n" + answer} if answer else
                  {"error": f"«{r['name']}» nie odpowiedział." if not ok else f"«{r['name']}» skończył bez odpowiedzi na piśmie."})
        if mode == "teraz":
            err = self.remote_call(me, r, "ask", text, "", now)
            if err:
                reply({"error": err})
                return True
            self.waiting[me["id"]] = r["id"]
            limit = max(20.0, min(float(a.get("limit") or 1200), 1200.0))

            def late() -> None:
                if state["done"]:
                    return
                state["done"] = True
                self.waiting.pop(me["id"], None)
                reply({"text": f"«{r['name']}» jeszcze nie odpowiedział. Nie czekaj dłużej: jego odpowiedź przyjdzie do Ciebie "
                               "jako osobna wiadomość. Dokończ, co możesz."})
            self.after(limit, late)
            return True
        err = self.remote_call(me, r, "note", text, "", later if mode == "pozniej" else (lambda *_: None))
        reply({"error": err} if err else {"text": f"Zostawiono wiadomość dla «{r['name']}» (na Macu)."
                                                  + (" Jego odpowiedź przyjdzie do Ciebie jako osobna wiadomość." if mode == "pozniej" else "")})
        return True

    def save_queue(self) -> None:
        """Wiadomości, które czekają albo są w toku, żeby restart serwera żadnej nie zgubił. Te z pocztą agentów
        odtwarza mail.json, a pytań z czekaniem nie ma kto odebrać, więc tu trafia reszta (okno, Telegram, sprawdzanie)."""
        rows = []
        for aid in self.order:
            for m in ([self.current[aid]] if aid in self.current else []) + list(self.queues.get(aid) or []):
                if m.get("post") or m.get("reply"):
                    continue
                rows.append({"agent": aid, "text": m["text"], "origin": list(m["origin"]), "back": list(m["back"]),
                             "depth": m["depth"], "deliver": bool(m.get("deliver"))})
        _host_save("queue.json", rows)

    def save_posts(self) -> None:
        keep = []
        for p in self.posts[-150:]:
            q = dict(p)
            q["answer"] = str(q.get("answer") or "")[:6000]
            keep.append(q)
        _host_save("mail.json", keep)

    def desk(self, a: dict) -> Path:
        p = str(a.get("desk") or "")
        if p and os.path.isdir(os.path.expanduser(p)):
            return Path(os.path.expanduser(p)).resolve()
        d = HOST_DIR / "biurka" / a["id"]
