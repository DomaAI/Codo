_GROUP_ASSIGN = re.compile(r"^\s*ZLECAM\s+@?([^:\n]{1,40}):\s*(.+?)\s*$", re.IGNORECASE | re.MULTILINE)


def _group_assignments(text: str, members: list, me: str) -> tuple:
    """Zlecenia „ZLECAM Imię: zadanie” z odpowiedzi: [(id, zadanie)] i tekst bez tych linii."""
    out = []
    by = {}
    for m in members:
        n = str(m.get("name") or "").strip().lower()
        if n:
            by[n] = m["id"]
            by.setdefault(n.split()[0], m["id"])
        by[str(m.get("id") or "").lower()] = m["id"]
    for mt in _GROUP_ASSIGN.finditer(str(text or "")):
        who = by.get(mt.group(1).strip().lower()) or by.get(mt.group(1).strip().lower().split()[0] if mt.group(1).strip() else "")
        task = mt.group(2).strip()
        if who and who != me and task and not any(w == who for w, _ in out):
            out.append((who, task[:1000]))
    rest = _GROUP_ASSIGN.sub("", str(text or "")).strip()
    return out, re.sub(r"\n{3,}", "\n\n", rest)

_GROUP_REACTION = re.compile(r"^\s*REAKCJA:\s*(\S{1,8})\s*(?:\n|$)", re.IGNORECASE)


def _group_reaction(text: str) -> tuple:
    """Emotka z linii „REAKCJA: …” na początku odpowiedzi i reszta tekstu (bez tej linii)."""
    m = _GROUP_REACTION.match(str(text or ""))
    if not m:
        return "", str(text or "").strip()
    return m.group(1), str(text or "")[m.end():].strip()


def _group_addressed(task: str, members: list) -> list:
    """Kogo użytkownik woła po imieniu (@id, pełne imię albo pierwsze słowo imienia). Pusta lista = wszystkich."""
    low = " " + re.sub(r"[^\w@]+", " ", str(task or "").lower()) + " "
    out = []
    for m in members:
        name = str(m.get("name") or "").lower().strip()
        keys = {"@" + str(m.get("id") or "").lower(), name}
        if name:
            keys.add("@" + name.split()[0])
        if any(k and (" " + re.sub(r"[^\w@]+", " ", k).strip() + " ") in low for k in keys):
            out.append(m["id"])
    return [] if len(out) == len(members) else out


_GROUP_PLAIN = ("\n\nOdpowiedz od razu pełną treścią, bez wstępów i bez opisu, jak pracujesz. "
                "Pisz po polsku, chyba że zadanie jest w innym języku.")


def _group_numbered(items: list, names: bool = True) -> str:
    out = []
    for i, (m, text) in enumerate(items):
        label = f"{m['name']} ({brain_label(m.get('brain'))})" if names else f"Propozycja {chr(65 + i)}"
        out.append(f"=== {label} ===\n{str(text).strip()[:12000]}")
    return "\n\n".join(out)


def _group_parse_vote(text: str, letters: list) -> tuple:
    t = str(text or "")
    m = re.search(r"G[ŁL]OS\s*[:=]\s*\**\s*([A-H])\b", t, re.I)
    pick = m.group(1).upper() if m else ""
    if not pick:
        found = [x for x in re.findall(r"\b([A-H])\b", t) if x in letters]
        pick = found[0] if found else ""
    why = ""
    w = re.search(r"DLACZEGO\s*[:=]\s*(.+)", t, re.I | re.S)
    if w:
        why = " ".join(w.group(1).split())[:300]
    return (pick if pick in letters else ""), why


def _group_parse_split(text: str, ids: list) -> dict:
    """Podział od prowadzącego: blok ```podzial z JSON-em {id członka: zadanie}."""
    t = str(text or "")
    m = re.search(r"```(?:podzial|podział|json)?\s*(\{.*?\})\s*```", t, re.S)
    raw = m.group(1) if m else (re.search(r"(\{.*\})", t, re.S) or [None, ""])[1]
    try:
        data = json.loads(raw) if raw else {}
    except ValueError:
        return {}
    if not isinstance(data, dict):
        return {}
    out = {}
    for k, v in data.items():
        key = str(k).strip()
        hit = next((i for i in ids if i == key or _slug(key) == i), None)
        if hit and str(v or "").strip():
            out[hit] = str(v).strip()[:4000]
    return out


# ── bieg grupy ──

class GroupRun:
    """Jeden bieg grupy: członkowie równolegle (każdy we własnym procesie), sposób pracy, wynik."""

    def __init__(self, group: dict, task: str, cwd=None, emit=None, proc_factory=None, run_id: str = "",
                 source: dict | None = None):
        import secrets
        import time
        self.g = group
        self.task = str(task or "").strip()
        self.cwd = Path(cwd or Path.cwd()).resolve()
        self.emit_cb = emit
        self.factory = proc_factory or GroupMemberProc
        self.id = run_id or ("g-" + time.strftime("%Y%m%d-%H%M%S") + "-" + secrets.token_hex(2))
        self.dir = _group_runs_dir() / self.id
        self.dir.mkdir(parents=True, exist_ok=True)
        self.lock = threading.RLock()
        self.seq = 0
        self.stop_all = threading.Event()
        self.stop_one: dict = {}
        self.procs: dict = {}
        self.entries: list = []
        self.result: dict = {}
        self.status = "starting"
        self.t0 = time.monotonic()
        self.source = source or {"kind": "app"}
        self.slots_override = int(group.get("limits", {}).get("per_provider") or 0)
        par = int(group.get("limits", {}).get("parallel") or 0) or len(group["members"])
        self.par = _GroupSlot(max(1, par))
        self.copies: dict = {}
        self.git = {}
        self.members = {}
        for m in group["members"]:
            self.stop_one[m["id"]] = threading.Event()
            self.members[m["id"]] = {
                "id": m["id"], "name": m["name"], "role": m.get("role") or "", "brain": m.get("brain") or "",
                "brain_label": brain_label(m.get("brain") or current_model(None)), "agent": m.get("agent") or "",
                "slot": _group_slot_key(m.get("brain") or ""), "cost": _group_cost_kind(m.get("brain") or ""),
                "lead": m["id"] == group["lead"], "status": "waiting", "doing": "", "seconds": 0.0, "spent_kr": 0,
                "turns": 0, "error": "", "reason": "", "fallback_from": "", "answer": "", "files": {},
                "worktree": "", "branch": ""}

    # zdarzenia
    def ev(self, etype: str, /, **data) -> dict:
        with self.lock:
            self.seq += 1
            e = {"type": etype, "run_id": self.id, "seq": self.seq, **data}
            try:
                with open(self.dir / "events.jsonl", "a", encoding="utf-8") as f:
                    f.write(json.dumps(e, ensure_ascii=False, default=str) + "\n")
            except OSError:
                pass  # nosec B110
        if self.emit_cb:
            self.emit_cb(etype, {k: v for k, v in e.items() if k != "type"})
        return e

    def live(self, mid: str, event: dict) -> None:
        if self.emit_cb:
            self.emit_cb("group_member_event", {"run_id": self.id, "member": mid, "event": event})

    def set(self, mid: str, **kw) -> None:
        with self.lock:
            self.members[mid].update(kw)
            snap = dict(self.members[mid])
        self.ev("group_member", member=snap)

    def elapsed(self) -> float:
        import time
        return round(time.monotonic() - self.t0, 1)

    def spent(self) -> int:
        return sum(int(m.get("spent_kr") or 0) for m in self.members.values())

    def state(self) -> dict:
        with self.lock:
            return {"run_id": self.id, "group": {k: self.g[k] for k in ("id", "name", "strategy", "lead", "files")},
                    "strategy": self.g["strategy"], "strategy_title": _L(_GROUP_STRATEGIES[self.g["strategy"]]),
                    "task": self.task, "status": self.status, "members": [dict(m) for m in self.members.values()],
                    "entries": list(self.entries), "result": dict(self.result), "seconds": self.elapsed(),
                    "spent_kr": self.spent(), "cwd": str(self.cwd), "limits": dict(self.g.get("limits") or {})}

    def save(self) -> None:
        try:
            (self.dir / "run.json").write_text(json.dumps(self.state(), ensure_ascii=False, default=str),
                                               encoding="utf-8")
        except OSError:
            pass  # nosec B110

    def phase(self, name: str, title: str, rnd: int = 0, rounds: int = 0) -> None:
        self.ev("group_phase", phase=name, title=title, round=rnd, rounds=rounds)

    def entry(self, mid: str, phase: str, rnd: int, text: str, ok: bool = True, **extra) -> dict:
        e = {"member": mid, "phase": phase, "round": rnd, "text": str(text or "")[:20000], "ok": ok, **extra}
        with self.lock:
            self.entries.append(e)
        self.ev("group_text", **e)
        return e

    def stopped(self, mid: str = "") -> bool:
        return self.stop_all.is_set() or bool(mid and self.stop_one[mid].is_set())

    def over_budget(self) -> bool:
        b = int(self.g.get("limits", {}).get("budget_kr") or 0)
        return bool(b and self.spent() >= b)

    # polecenia z okna
    def stop(self, mid: str = "") -> None:
        if mid:
            if mid in self.stop_one:
                self.stop_one[mid].set()
                p = self.procs.get(mid)
                if p:
                    p.interrupt()
            return
        self.stop_all.set()
        for p in list(self.procs.values()):
            p.interrupt()

    # miejsca pracy
    def place(self) -> None:
        """Kopie git dla członków, którzy piszą (files=copies). Sposoby po kolei mają jedną wspólną kopię."""
        if self.g.get("files") != "copies":
            return
        code, top, _ = _git_in(self.cwd, "rev-parse", "--show-toplevel")
        if code or not top or _git_in(top, "rev-parse", "--verify", "-q", "HEAD")[0]:
            self.ev("group_note", tekst=_L("Folder nie jest repozytorium git z commitem: członkowie tylko czytają."))
            self.g = {**self.g, "files": "read"}
            return
        project = Path(top).resolve()
        _team_exclude(project)
        base = _git_in(project, "rev-parse", "HEAD")[1]
        self.git = {"project": str(project), "base": base,
                    "subdir": os.path.relpath(self.cwd, project)}
        stem = f"grupa-{_slug(self.g['name'])[:20].strip('-') or 'grupa'}-{self.id[-4:]}"
        root = Path.home() / ".codo" / "kopie" / project.name
        shared = self.g["strategy"] in ("review", "pipeline", "split")
        keys = ["wspolna"] if shared else [m["id"] for m in self.g["members"]]
        for k in keys:
            path, branch = root / f"{stem}--{k}", f"codo/{stem}--{k}"
            err = _team_worktree_add(project, path, branch, base)
            if err:
                self.ev("group_note", tekst=_Lf("Nie udało się zrobić kopii ({0}): członkowie tylko czytają.", err))
                self.g = {**self.g, "files": "read"}
                self.copies = {}
                return
            _team_copy_env(project, path)
            self.copies[k] = {"path": str(path), "branch": branch}
        for m in self.g["members"]:
            c = self.copies.get("wspolna") or self.copies.get(m["id"])
            if c:
                self.members[m["id"]].update(worktree=c["path"], branch=c["branch"])

    def cwd_of(self, mid: str) -> Path:
        c = self.copies.get("wspolna") or self.copies.get(mid)
        if not c:
            return self.cwd
        sub = self.git.get("subdir") or "."
        return Path(c["path"]) / sub if sub != "." else Path(c["path"])

    def mode_of(self, mid: str, writes: bool) -> str:
        return "auto" if writes and self.copies else "read"

    # jedna tura jednego członka
    def turn(self, mid: str, text: str, phase: str, writes: bool = False) -> tuple:
        """(ok, tekst). Czeka na miejsce u dostawcy, po nieudanej turze próbuje mózgu zapasowego grupy."""
        m = self.members[mid]
        spec = next(x for x in self.g["members"] if x["id"] == mid)
        if self.stopped(mid):
            return False, ""
        if self.over_budget():
            self.set(mid, status="skipped", reason=_L("budżet grupy wyczerpany"), doing="")
            return False, ""
        tries = [spec.get("brain") or ""]
        fb = str(self.g.get("fallback") or "")
        if fb and fb not in tries:
            tries.append(fb)
        errors_all = []
        for i, brain in enumerate(tries):
            why = _group_brain_ready(brain)
            if why:
                errors_all.append(why)
                if i + 1 < len(tries):
                    self.set(mid, fallback_from=m["brain_label"], brain_label=brain_label(tries[i + 1]),
                             doing=_Lf("{0}: {1}. Dalej pracuje {2}.", m["brain_label"], why, brain_label(tries[i + 1])))
                    continue
                self.set(mid, status="skipped", reason=why, doing="")
                return False, ""
            key = _group_slot_key(brain)
            slot = _group_slot(key, _group_slot_limit(key, self.slots_override))
            waiting = slot.used >= slot.limit or self.par.used >= self.par.limit
            if waiting:
                self.set(mid, status="queued", doing=_Lf("Czeka na wolne miejsce: {0} ({1} naraz)",
                                                         brain_label(brain), slot.limit), slot=key)
            if not self.par.acquire(lambda: self.stopped(mid)):
                self.set(mid, status="stopped", doing="")
                return False, ""
            try:
                if not slot.acquire(lambda: self.stopped(mid)):
                    self.set(mid, status="stopped", doing="")
                    return False, ""
                try:
                    ok, out, errors = self.one(mid, brain, text, phase, writes)
                finally:
                    slot.release()
            finally:
                self.par.release()
            if ok:
                self.set(mid, status="done", doing="")
                return True, out
            if self.stopped(mid):
                self.set(mid, status="stopped", doing="")
                return False, ""
            errors_all += errors
            reason = _group_reason(errors)
            if i + 1 < len(tries):
                nxt = brain_label(tries[i + 1])
                self.set(mid, fallback_from=m["brain_label"], brain_label=nxt, status="starting",
                         doing=_Lf("{0}: {1}. Dalej pracuje {2}.", m["brain_label"], reason, nxt), error="")
                p = self.procs.pop(mid, None)
                if p:
                    p.stop(wait=2)
                continue
            self.set(mid, status="failed", reason=reason, doing="")
            return False, ""
        self.set(mid, status="failed", reason=_group_reason(errors_all), doing="")
        return False, ""

    def proc(self, mid: str, brain: str, writes: bool):
        p = self.procs.get(mid)
        if p and p.alive() and p.brain == brain and p.mode == self.mode_of(mid, writes):
            return p
        if p:
            p.stop(wait=2)
        spec = next(x for x in self.g["members"] if x["id"] == mid)
        p = self.factory(self, spec, brain, self.cwd_of(mid), self.mode_of(mid, writes))
        p.spawn()
        self.procs[mid] = p
        p.ready = False
        return p

    def one(self, mid: str, brain: str, text: str, phase: str, writes: bool) -> tuple:
        """Wysyła tekst i czeka na koniec tury. (ok, odpowiedź, błędy)."""
        import queue
        import time
        spec = next(x for x in self.g["members"] if x["id"] == mid)
        m = self.members[mid]
        self.set(mid, status="starting", doing=_L("Uruchamia się"), slot=_group_slot_key(brain))
        p = self.proc(mid, brain, writes)
        limit = 60 * int(self.g["limits"].get("member_minutes") or 20)
        t0 = time.monotonic()
        sent = False
        texts, errors = [], []
        credits0 = int(getattr(p, "credits", 0) or 0)
        live_text = ""
        last_emit = 0.0
        interrupted = 0.0
        while True:
            if not sent and getattr(p, "ready", False):
                if spec.get("persona"):
                    p.send_raw({"type": "agent_persona", "text": spec["persona"]})
                if not p.send(text):
                    return False, "", [_L("członek nie przyjął wiadomości")]
                sent = True
                self.set(mid, status="working", doing=_L("Myśli"))
            if self.stopped(mid) and not interrupted:
                p.interrupt()
                interrupted = time.monotonic()
            if interrupted and time.monotonic() - interrupted > 8:
                p.stop(wait=1)
                self.procs.pop(mid, None)
                return False, "", errors or [_L("przerwano")]
            if time.monotonic() - t0 > limit and not interrupted:
                errors.append(_Lf("przekroczony czas: {0} min", limit // 60))
                p.interrupt()
                interrupted = time.monotonic()
            try:
                e = p.q.get(timeout=0.25)
            except queue.Empty:
                if not getattr(p, "ready", False) and time.monotonic() - t0 > 90:
                    p.stop(wait=1)
                    self.procs.pop(mid, None)
                    return False, "", [_L("członek nie uruchomił się")]
                continue
            kind = e.get("type")
            if kind in _GROUP_FORWARD and sent:
                self.live(mid, e)
            if kind == "_exit":
                self.procs.pop(mid, None)
                return False, "", errors + [_L("proces członka zakończył się")]
            if kind == "ready":
                p.ready = True
                if e.get("model"):
                    m["model"] = e.get("model")
            elif not sent:
                continue
            elif kind == "delta":
                live_text += str(e.get("tekst") or "")
                if time.monotonic() - last_emit > 1.2:
                    last_emit = time.monotonic()
                    tail = " ".join(live_text.split())[-140:]
                    if tail:
                        self.set(mid, doing=_Lf("Pisze: {0}", tail))
            elif kind == "assistant":
                texts.append(str(e.get("tekst") or ""))
                live_text = ""
            elif kind in ("tool_start", "tool"):
                head = _plain(str(e.get("naglowek") or e.get("nazwa") or ""))[:140]
                if head:
                    self.set(mid, doing=head)
            elif kind == "edit":
                self.set(mid, doing=_Lf("Edytuje {0}", e.get("plik") or ""))
            elif kind == "error":
                errors.append(str(e.get("tekst") or ""))
            elif kind == "fallback":
                self.set(mid, fallback_from=m["brain_label"], brain_label=str(e.get("label") or m["brain_label"]),
                         doing=str(e.get("tekst") or ""))
            elif kind == "ask":
                # W grupie nikt nie czeka na zgodę: piszący pracują w swojej kopii (auto), reszta tylko czyta.
                p.send_raw({"type": "answer", "id": str(e.get("id")), "value": 0})
            elif kind == "turn_end":
                credits = int(e.get("credits") or 0)
                delta = max(0, credits - credits0)
                p.credits = credits
                ok = bool(e.get("ok")) and not interrupted
                out = "\n\n".join(t for t in texts if t.strip()).strip()
                if ok and not out:
                    ok, errors = False, errors + [_L("pusta odpowiedź")]
                self.set(mid, spent_kr=int(m.get("spent_kr") or 0) + delta, turns=int(m.get("turns") or 0) + 1,
                         seconds=round(float(m.get("seconds") or 0) + float(e.get("seconds") or 0), 1),
                         error=(errors[-1][:300] if errors and not ok else ""), doing="")
                return ok, out, errors

    def parallel(self, jobs: list) -> dict:
        """[(mid, tekst, etap, pisze)] naraz; {mid: (ok, tekst)}."""
        out: dict = {}

        def work(job):
            mid, text, phase, writes = job
            try:
                out[mid] = self.turn(mid, text, phase, writes)
            except Exception as exc:  # noqa: BLE001 — jeden członek nie może wywrócić grupy
                self.set(mid, status="failed", reason=str(exc)[:200], doing="")
                out[mid] = (False, "")
        threads = [threading.Thread(target=work, args=(j,), daemon=True) for j in jobs]
        for t in threads:
            t.start()
        for t in threads:
            t.join()
        return out

    def finish_member(self, mid: str, text: str) -> None:
        if self.members[mid]["status"] not in ("failed", "skipped", "stopped"):
            self.set(mid, status="done", answer=str(text or "")[:6000], doing="")

    # sposoby pracy
    def go(self) -> dict:
        import time
        try:
            self.status = "working"
            self.ev("group_started", state=self.state())
            if not self.task:
                return self.done("failed", _L("Podaj zadanie dla grupy."))
            self.place()
            fn = {"chat": self.s_chat, "parallel": self.s_parallel, "split": self.s_split, "review": self.s_review,
                  "vote": self.s_vote, "pipeline": self.s_pipeline}[self.g["strategy"]]
            fn()
            if self.status in _GROUP_END:
                return self.state()
            if self.stop_all.is_set():
                return self.done("stopped", _L("Bieg przerwany."))
            if not self.result.get("text"):
                why = "; ".join(f"{m['name']}: {m['reason']}" for m in self.members.values() if m.get("reason"))
                return self.done("failed", _L("Nikt z grupy nie odpowiedział.") + (f" {why}" if why else ""))
            return self.done("done", "")
        except Exception as exc:  # noqa: BLE001
            return self.done("failed", _Lf("Bieg grupy przerwał błąd: {0}", exc))
        finally:
            for p in list(self.procs.values()):
                p.stop(wait=2)
            self.procs.clear()
            time.sleep(0)

    def done(self, status: str, note: str) -> dict:
        self.status = status
        for mid, m in self.members.items():
            if m["status"] in ("waiting", "queued", "starting", "working"):
                self.set(mid, status="stopped" if status == "stopped" else "skipped",
                         reason=m.get("reason") or (_L("przerwano") if status == "stopped" else _L("nie był potrzebny")),
                         doing="")
        if self.copies:
            for mid, m in self.members.items():
                c = self.copies.get("wspolna") or self.copies.get(mid)
                if c:
                    head = _team_commit_all(c["path"], f"Codo grupa {self.g['name']}: {m['name']}")
                    m["files"] = _team_diff_stat(c["path"], self.git["base"], head)
        self.save()
        self.ev("group_done", status=status, note=note, result=dict(self.result), seconds=self.elapsed(),
                spent_kr=self.spent(), members=[dict(m) for m in self.members.values()])
        return self.state()

    def ok_members(self, res: dict) -> list:
        return [(next(x for x in self.g["members"] if x["id"] == mid), res[mid][1])
                for mid in [m["id"] for m in self.g["members"]] if mid in res and res[mid][0]]

    def pick_lead(self, prefer_ok: list) -> str:
        lead = self.g["lead"]
        if self.members[lead]["status"] not in ("failed", "skipped", "stopped"):
            return lead
        alt = next((m["id"] for m, _t in prefer_ok), "")
        if alt:
            self.ev("group_note", tekst=_Lf("Prowadzący nie odpowiada ({0}). Zastępuje go {1}.",
                                            self.members[lead].get("reason") or "", self.members[alt]["name"]))
        return alt

    def s_chat(self) -> None:
        """Rozmowa jak na czacie ze znajomymi: wszyscy odpisują naraz, każdy sam od siebie i swoją rolą,
        a wiadomość trafia na czat, gdy tylko ktoś skończy. Wołany po imieniu odpisuje sam. Bez syntezy."""
        g = self.g
        self.phase("chat", _L("Rozmawiają"))
        order = [g["lead"]] + [m["id"] for m in g["members"] if m["id"] != g["lead"]]
        called = _group_addressed(self.task, g["members"])
        if called:
            for mid in order:
                if mid not in called:
                    self.set(mid, status="skipped", reason=_L("wołano kogoś innego"), doing="")
            order = [mid for mid in order if mid in called]
        history = str(g.get("history") or "").strip()
        names = {m["id"]: m["name"] for m in g["members"]}
        said: list = []

        queue: list = []  # zlecenia między agentami: (od, do, zadanie)

        def work(mid, by="", job="", rnd=1):
            m = next(x for x in g["members"] if x["id"] == mid)
            others = [names[x] for x in order if x != mid]
            convo = ("WCZEŚNIEJ NA CZACIE:\n" + history + "\n\n") if history else ""
            convo += "UŻYTKOWNIK PISZE:\n" + self.task
            if job:
                with self.lock:
                    so_far = "\n".join(f"{mm['name']}: {tt}" for mm, tt in said)
                if so_far:
                    convo += "\n\nNA CZACIE PADŁO:\n" + so_far
                convo += f"\n\n{names.get(by, by)} ZLECA CI: {job}\nZrób to i krótko odpisz na czacie, co zrobiłeś."
            elif others:
                convo += "\n\nNa czacie są też: " + ", ".join(others) + ". Odpisują w tej samej chwili co Ty."
            try:
                ok, text = self.turn(mid, _group_head(g, m, _L("rozmowa")) + "\n\n" + convo + _GROUP_CHAT, "chat")
            except Exception as exc:  # noqa: BLE001 — jeden członek nie może wywrócić rozmowy
                self.set(mid, status="failed", reason=str(exc)[:200], doing="")
                return
            reaction, text = _group_reaction(text)
            jobs, text = _group_assignments(text, g["members"], mid)
            if not ok:
                return
            if not text and not reaction and not jobs:
                self.set(mid, status="skipped", reason=_L("nie odpisał"), doing="")
                return
            extra = {}
            if reaction:
                extra["reaction"] = reaction
            if by:
                extra["from"] = by
                extra["job"] = job
            if jobs:
                extra["assigns"] = [{"to": w, "task": t} for w, t in jobs]
            with self.lock:
                if text:
                    said.append((m, text))
                for w, t in jobs:
                    queue.append((mid, w, t))
            self.entry(mid, "chat", rnd, text, **extra)
            self.finish_member(mid, text or reaction)

        def wave(items):
            threads = [threading.Thread(target=work, args=a, daemon=True) for a in items]
            for t in threads:
                t.start()
            for t in threads:
                t.join()

        wave([(mid,) for mid in order])
        # Zlecenia między agentami: najwyżej dwie fale i sześć zadań, żeby rozmowa się nie zapętliła.
        budget = 6
        for rnd in (2, 3):
            with self.lock:
                todo, queue[:] = queue[:budget], []
            if not todo or self.stop_all.is_set():
                break
            budget -= len(todo)
            for frm, to, job in todo:
                self.set(to, status="working", doing=_L("zadanie od") + " " + names.get(frm, frm))
            self.phase("chat", _L("Robią, co sobie zlecili"))
            wave([(to, frm, job, rnd) for frm, to, job in todo])
        if said:
            m, text = said[-1]
            self.result = {"kind": "chat", "member": m["id"], "text": text}
            self.ev("group_result", **self.result)

    def s_parallel(self) -> None:
        g = self.g
        self.phase("answers", _L("Wszyscy odpowiadają"))
        jobs = [(m["id"], _group_head(g, m, _L("odpowiedź")) + f"\n\nZADANIE:\n{self.task}" + _GROUP_PLAIN,
                 "answers", m.get("writes", False)) for m in g["members"]]
        res = self.parallel(jobs)
        ok = self.ok_members(res)
        for m, text in ok:
            self.entry(m["id"], "answers", 1, text)
            self.finish_member(m["id"], text)
        if not ok or self.stop_all.is_set():
            return
        if len(ok) == 1:
            m, text = ok[0]
            self.result = {"kind": "single", "member": m["id"], "text": text,
                           "note": _L("Odpowiedział tylko jeden członek, bez syntezy.")}
            self.ev("group_result", **self.result)
            return
        lead = self.pick_lead(ok)
        if not lead:
            return
        lm = next(x for x in g["members"] if x["id"] == lead)
        self.phase("synthesis", _L("Prowadzący łączy odpowiedzi"))
        prompt = (_group_head(g, lm, _L("synteza")) + f"\n\nZADANIE:\n{self.task}\n\nODPOWIEDZI CZŁONKÓW GRUPY:\n\n"
                  + _group_numbered(ok) + "\n\nPorównaj odpowiedzi: co się zgadza, gdzie się różnią i która jest "
                  "najmocniejsza w czym. Potem podaj jedną najlepszą odpowiedź na zadanie, łącząc mocne strony. "
                  "Zacznij od krótkiego porównania (najwyżej 5 punktów), potem nagłówek „Odpowiedź” i pełna treść.")
        ok_s, syn = self.turn(lead, prompt, "synthesis")
        if ok_s:
            self.entry(lead, "synthesis", 1, syn)
            self.result = {"kind": "synthesis", "member": lead, "text": syn}
        else:
            m, text = ok[0]
            self.result = {"kind": "single", "member": m["id"], "text": text,
                           "note": _L("Synteza się nie udała: wynik to pierwsza odpowiedź.")}
        self.ev("group_result", **self.result)

    def s_review(self) -> None:
        g = self.g
        rounds = int(g["limits"].get("rounds") or 2)
        order = [g["lead"]] + [m["id"] for m in g["members"] if m["id"] != g["lead"]]
        author, draft = "", ""
        self.phase("draft", _L("Autor przygotowuje pierwszą wersję"), 1, rounds)
        for cand in order:
            am = next(x for x in g["members"] if x["id"] == cand)
            ok, draft = self.turn(cand, _group_head(g, am, _L("pierwsza wersja")) + f"\n\nZADANIE:\n{self.task}\n\n"
                                  "Jesteś autorem. Przygotuj pełną wersję; inni członkowie ją zrecenzują." + _GROUP_PLAIN,
                                  "draft", am.get("writes", True))
            if ok:
                author = cand
                break
            if self.stop_all.is_set():
                return
        if not author:
            return
        self.entry(author, "draft", 1, draft)
        reviewers = [m for m in g["members"] if m["id"] != author]
        rnd = 1
        while reviewers and rnd <= rounds and not self.stop_all.is_set():
            self.phase("review", _Lf("Przegląd, runda {0} z {1}", rnd, rounds), rnd, rounds)
            jobs = [(m["id"], _group_head(g, m, _L("przegląd")) + f"\n\nZADANIE:\n{self.task}\n\nWERSJA AUTORA "
                     f"({self.members[author]['name']}):\n{draft[:16000]}\n\nOceń tę wersję jako recenzent w swojej roli. "
                     "Gdy nie trzeba nic zmieniać, zacznij odpowiedź słowem ZATWIERDZAM. W przeciwnym razie zacznij od "
                     "UWAGI: i wypisz konkretne, ważne poprawki (najwyżej 6 punktów), bez przepisywania całości.",
                     "review", False) for m in reviewers]
            res = self.parallel(jobs)
            notes = self.ok_members(res)
            for m, text in notes:
                self.entry(m["id"], "review", rnd, text, approve=text.strip().upper().startswith("ZATWIERDZAM"))
            if not notes:
                break
            if all(t.strip().upper().startswith("ZATWIERDZAM") for _m, t in notes):
                self.ev("group_note", tekst=_Lf("Wszyscy recenzenci zatwierdzili wersję w rundzie {0}.", rnd))
                break
            self.phase("revise", _Lf("Autor poprawia, runda {0} z {1}", rnd, rounds), rnd, rounds)
            am = next(x for x in g["members"] if x["id"] == author)
            ok, new = self.turn(author, _group_head(g, am, _L("poprawka")) + f"\n\nZADANIE:\n{self.task}\n\n"
                                f"TWOJA OSTATNIA WERSJA:\n{draft[:16000]}\n\nUWAGI RECENZENTÓW:\n\n" + _group_numbered(notes)
                                + "\n\nPopraw swoją wersję, biorąc pod uwagę trafne uwagi (nietrafne pomiń i krótko "
                                "napisz dlaczego na końcu). Podaj pełną nową wersję.", "revise", am.get("writes", True))
            if not ok:
                break
            draft = new
            self.entry(author, "revise", rnd, draft)
            rnd += 1
        for m in g["members"]:
            last = next((e["text"] for e in reversed(self.entries) if e["member"] == m["id"]), "")
            if last:
                self.finish_member(m["id"], last)
        self.result = {"kind": "final", "member": author, "text": draft, "rounds": min(rnd, rounds)}
        self.ev("group_result", **self.result)

    def s_vote(self) -> None:
        g = self.g
        self.phase("proposals", _L("Każdy proponuje"))
        jobs = [(m["id"], _group_head(g, m, _L("propozycja")) + f"\n\nZADANIE:\n{self.task}\n\nPrzygotuj swoją "
                 "najlepszą propozycję. Grupa wybierze jedną w głosowaniu." + _GROUP_PLAIN, "proposals",
                 m.get("writes", False)) for m in g["members"]]
        res = self.parallel(jobs)
        props = self.ok_members(res)
        for m, text in props:
            self.entry(m["id"], "proposals", 1, text)
            self.finish_member(m["id"], text)
        if not props or self.stop_all.is_set():
            return
        letters = [chr(65 + i) for i in range(len(props))]
        by_letter = {letters[i]: props[i][0]["id"] for i in range(len(props))}
        if len(props) == 1:
            m, text = props[0]
            self.result = {"kind": "winner", "member": m["id"], "text": text, "votes": {m["id"]: 0}, "ballots": [],
                           "note": _L("Tylko jedna propozycja, bez głosowania.")}
            self.ev("group_result", **self.result)
            return
        self.phase("vote", _L("Głosowanie"))
        voters = [m for m in g["members"] if self.members[m["id"]]["status"] not in ("failed", "skipped", "stopped")]
        jobs = []
        for m in voters:
            mine = next((x for x, mid in by_letter.items() if mid == m["id"]), "")
            listed = [(props[i][0], props[i][1]) for i in range(len(props))]
            body = "\n\n".join(f"=== Propozycja {letters[i]}{' (Twoja)' if letters[i] == mine else ''} ===\n"
                               f"{str(listed[i][1]).strip()[:10000]}" for i in range(len(listed)))
            jobs.append((m["id"], _group_head(g, m, _L("głosowanie")) + f"\n\nZADANIE:\n{self.task}\n\n{body}\n\n"
                         "Wybierz najlepszą propozycję dla użytkownika. Nie głosuj na swoją. Odpowiedz dokładnie w dwóch "
                         "liniach:\nGŁOS: <litera>\nDLACZEGO: <jedno zdanie>", "vote", False))
        res = self.parallel(jobs)
        votes = {mid: 0 for mid in by_letter.values()}
        ballots = []
        for m, text in self.ok_members(res):
            mine = next((x for x, mid in by_letter.items() if mid == m["id"]), "")
            pick, why = _group_parse_vote(text, [x for x in letters if x != mine])
            if pick:
                votes[by_letter[pick]] += 1
                ballots.append({"from": m["id"], "pick": by_letter[pick], "letter": pick, "why": why})
            self.entry(m["id"], "vote", 1, text, pick=by_letter.get(pick, ""))
        best = max(votes.values()) if votes else 0
        tied = [mid for mid in by_letter.values() if votes[mid] == best]
        winner = tied[0]
        note = ""
        if len(tied) > 1:
            lead_pick = next((b["pick"] for b in ballots if b["from"] == g["lead"] and b["pick"] in tied), "")
            winner = lead_pick or tied[0]
            note = _L("Remis: rozstrzygnął głos prowadzącego.") if lead_pick else _L("Remis: wygrała pierwsza propozycja.")
        text = next(t for m, t in props if m["id"] == winner)
        self.result = {"kind": "winner", "member": winner, "text": text, "votes": votes, "ballots": ballots,
                       "note": note}
        self.ev("group_result", **self.result)

    def s_pipeline(self) -> None:
        g = self.g
        prev, prev_mid, n = "", "", len(g["members"])
        for i, m in enumerate(g["members"]):
            if self.stop_all.is_set():
                return
            self.phase("step", _Lf("Krok {0} z {1}: {2}", i + 1, n, m["name"]), i + 1, n)
            body = f"\n\nZADANIE CAŁEJ GRUPY:\n{self.task}"
            if prev:
                body += (f"\n\nWYNIK POPRZEDNIEGO KROKU ({self.members[prev_mid]['name']}):\n{prev[:16000]}\n\n"
                         "Weź ten wynik jako wejście i zrób swoją część w swojej roli. Oddaj pełny wynik dla następnego.")
            else:
                body += "\n\nJesteś pierwszy w potoku: zrób swoją część i oddaj pełny wynik dla następnego."
            ok, out = self.turn(m["id"], _group_head(g, m, _Lf("krok {0} z {1}", i + 1, n)) + body + _GROUP_PLAIN,
                                "step", m.get("writes", True))
            if ok:
                self.entry(m["id"], "step", i + 1, out)
                self.finish_member(m["id"], out)
                prev, prev_mid = out, m["id"]
            else:
                self.ev("group_note", tekst=_Lf("Krok {0} ({1}) pominięty: {2}. Dalej idzie poprzedni wynik.", i + 1,
                                                m["name"], self.members[m["id"]].get("reason") or _L("nie odpowiedział")))
        if prev:
            self.result = {"kind": "final", "member": prev_mid, "text": prev}
            self.ev("group_result", **self.result)

    def s_split(self) -> None:
        g = self.g
        if self.copies and self.git:
            return self.handoff()
        lead = g["lead"]
        lm = next(x for x in g["members"] if x["id"] == lead)
        workers = [m for m in g["members"] if m["id"] != lead] or [lm]
        self.phase("plan", _L("Prowadzący dzieli pracę"))
        roster = "\n".join(f"- {m['id']}: {m['name']}, {brain_label(m.get('brain'))}"
                           + (f", rola: {m['role']}" if m.get("role") else "") for m in workers)
        ok, plan = self.turn(lead, _group_head(g, lm, _L("podział pracy")) + f"\n\nZADANIE:\n{self.task}\n\nCZŁONKOWIE:\n"
                             f"{roster}\n\nPodziel zadanie między członków według ich mocnych stron. Każdy dostaje jedną "
                             "część do zrobienia samodzielnie. Odpowiedz krótkim planem, a na końcu blokiem:\n"
                             "```podzial\n{\"<id członka>\": \"co ma zrobić\"}\n```", "plan")
        parts = _group_parse_split(plan, [m["id"] for m in workers]) if ok else {}
        if ok:
            self.entry(lead, "plan", 1, plan, parts=parts)
        if not parts:
            self.ev("group_note", tekst=_L("Prowadzący nie podzielił pracy: każdy dostaje całe zadanie."))
            parts = {m["id"]: self.task for m in workers}
        self.phase("work", _L("Członkowie robią swoje części"))
        jobs = [(m["id"], _group_head(g, m, _L("twoja część")) + f"\n\nCEL GRUPY:\n{self.task}\n\nTWOJA CZĘŚĆ (od "
                 f"prowadzącego):\n{parts[m['id']]}" + _GROUP_PLAIN, "work", m.get("writes", False))
                for m in workers if m["id"] in parts]
        res = self.parallel(jobs)
        done = self.ok_members(res)
        for m, text in done:
            self.entry(m["id"], "work", 1, text, part=parts.get(m["id"], ""))
            self.finish_member(m["id"], text)
        if not done or self.stop_all.is_set():
            return
        boss = self.pick_lead(done)
        if not boss:
            return
        bm = next(x for x in g["members"] if x["id"] == boss)
        self.phase("synthesis", _L("Prowadzący składa całość"))
        ok, whole = self.turn(boss, _group_head(g, bm, _L("złożenie całości")) + f"\n\nCEL GRUPY:\n{self.task}\n\n"
                              "WYNIKI CZĘŚCI:\n\n" + _group_numbered(done) + "\n\nZłóż z tych części jeden spójny wynik "
                              "dla użytkownika. Uzupełnij luki, usuń powtórzenia." + _GROUP_PLAIN, "synthesis")
        if ok:
            self.entry(boss, "synthesis", 1, whole)
            self.finish_member(boss, whole)
            self.result = {"kind": "synthesis", "member": boss, "text": whole}
        else:
            self.result = {"kind": "single", "member": done[0][0]["id"], "text": "\n\n".join(t for _m, t in done),
                           "note": _L("Złożenie się nie udało: wynik to części jedna po drugiej.")}
        self.ev("group_result", **self.result)

    def handoff(self) -> None:
        """Praca w kodzie z podziałem: przejmuje ją silnik zespołów (tablica, kopie, scalanie)."""
        g = self.g
        lead = next(x for x in g["members"] if x["id"] == g["lead"])
        tpl = {"version": 1, "name": _slug(g["name"])[:32] or "grupa", "title": g["name"],
               "lead": {"brain": lead.get("brain") or "", "instructions": lead.get("persona") or ""},
               "members": [{"id": m["id"], "name": m["name"], "role": m.get("role") or m["name"],
                            "brain": m.get("brain") or "", "writes": True, "isolation": "copy",
                            "instructions": m.get("persona") or ""} for m in g["members"] if m["id"] != g["lead"]]
               or [{"id": lead["id"], "name": lead["name"], "role": lead.get("role") or "", "brain": lead.get("brain") or "",
                    "writes": True, "isolation": "copy"}],
               "tasks": [], "policy": {"parallel": max(1, min(len(g["members"]), 6))}}
        # Kopie grupy nie są potrzebne: zespół robi swoje.
        self.cleanup()
        run_dir, err = _team_create_run(self.cwd, self.task, tpl, {"mode": "auto"}, {"kind": "group", "group": g["id"]})
        if err:
            self.done("failed", err)
            return
        if _APP.get("out") is not None:
            _team_tail_start(run_dir, 0)
        _team_spawn_supervisor(run_dir)
        self.result = {"kind": "handoff", "team_run_id": run_dir.name, "member": g["lead"], "text": ""}
        self.ev("group_result", **self.result)
        self.ev("group_handoff", team_run_id=run_dir.name)
        self.done("handoff", _L("Pracę w kodzie prowadzi zespół: tablica zadań, kopie i scalanie."))

    # po biegu
    def revise(self, mid: str, note: str) -> tuple:
        """Poprawka wyniku: członek (domyślnie autor wyniku) dostaje swoją wersję i Twoje uwagi."""
        mid = mid or self.result.get("member") or self.g["lead"]
        if mid not in self.members:
            return False, _L("Nie ma takiego członka.")
        self.stop_all.clear()
        self.stop_one[mid].clear()
        base = self.result.get("text") if self.result.get("member") == mid else self.members[mid].get("answer")
        m = next(x for x in self.g["members"] if x["id"] == mid)
        self.status = "working"
        self.phase("fix", _Lf("Poprawka: {0}", m["name"]))
        ok, out = self.turn(mid, _group_head(self.g, m, _L("poprawka od użytkownika")) + f"\n\nZADANIE:\n{self.task}\n\n"
                            f"WERSJA DO POPRAWY:\n{str(base or '')[:16000]}\n\nUWAGI UŻYTKOWNIKA:\n{note}\n\nPodaj pełną "
                            "poprawioną wersję." + _GROUP_PLAIN, "fix", m.get("writes", False))
        for p in list(self.procs.values()):
            p.stop(wait=2)
        self.procs.clear()
        if ok:
            self.entry(mid, "fix", 1, out, note=note[:500])
            self.finish_member(mid, out)
            self.result = {"kind": "fix", "member": mid, "text": out, "note": note[:500]}
            self.ev("group_result", **self.result)
        self.done("done" if ok or self.result.get("text") else "failed", "" if ok else _L("Poprawka się nie udała."))
        return ok, out

    def accept(self, mid: str) -> tuple:
        """Przyjmujesz wynik członka; w kopiach git jego zmiany trafiają do projektu."""
        mid = mid or self.result.get("member") or ""
        if mid not in self.members:
            return False, _L("Nie ma takiego członka.")
        text = self.result.get("text") if self.result.get("member") == mid else self.members[mid].get("answer")
        detail = ""
        ok = True
        c = self.copies.get("wspolna") or self.copies.get(mid)
        if c and self.git:
            proj = self.git["project"]
            head = _team_commit_all(c["path"], f"Codo grupa {self.g['name']}: {self.members[mid]['name']}")
            if head == self.git["base"]:
                detail = _L("Bez zmian w plikach.")
            else:
                code, _o, err = _git_in(proj, *_team_ident(proj), "merge", "--no-ff", "-m",
                                        f"Codo grupa {self.g['name']}: {self.members[mid]['name']}", c["branch"],
                                        timeout=300)
                if code:
                    _git_in(proj, "merge", "--abort")
                    ok, detail = False, _Lf("Scalanie się nie udało: {0}", (err or "")[-300:])
                else:
                    st = _team_diff_stat(proj, self.git["base"], "HEAD")
                    detail = _Lf("Scalono: {0} plików, +{1} −{2}.", st["files"], st["added"], st["removed"])
            if ok:
                self.cleanup()
        self.result = {**self.result, "accepted": mid}
        self.ev("group_applied", member=mid, ok=ok, detail=detail, text=str(text or "")[:20000])
        self.save()
        return ok, detail

    def cleanup(self) -> None:
        if not self.git:
            return
        for c in self.copies.values():
            _git_in(self.git["project"], "worktree", "remove", "--force", c["path"], timeout=120)
            _git_in(self.git["project"], "branch", "-D", c["branch"])
        self.copies = {}


def _mtime_ns(p) -> int:
    try:
        return p.stat().st_mtime_ns
    except OSError:
        return 0


def _group_runs_list(limit: int = 30) -> list:
    out = []
    d = _group_runs_dir()
    if not d.is_dir():
        return out
    # ta sama sekunda w nazwie: rozstrzyga chwila założenia, nie losowa końcówka
    for p in sorted(d.iterdir(), key=lambda x: (x.name[:17], _mtime_ns(x)), reverse=True)[:limit]:
        try:
            st = json.loads((p / "run.json").read_text(encoding="utf-8"))
        except (OSError, ValueError):
            continue
        res = st.get("result") or {}
        out.append({"run_id": st.get("run_id") or p.name, "group": (st.get("group") or {}).get("name") or "",
                    "group_id": (st.get("group") or {}).get("id") or "", "strategy": st.get("strategy") or "",
                    "task": str(st.get("task") or "")[:200], "status": st.get("status") or "",
                    "seconds": st.get("seconds") or 0, "spent_kr": st.get("spent_kr") or 0,
                    "winner": res.get("member") or "", "members": len(st.get("members") or [])})
    return out


def _group_brains() -> list:
    return [b for b in _team_brains() if b.get("kind") != "mix"]


def _group_resolve(msg: dict) -> tuple:
    """Grupa z polecenia: pełny opis (z okna) albo id/nazwa zapisanej."""
    if isinstance(msg.get("group"), dict):
        g, err = _group_check(msg["group"])
        return g, err
    g = _group_get(msg.get("group") or msg.get("group_id") or msg.get("name"))
    if not g:
        return None, _L("Nie ma takiej grupy.")
    return _group_check(g)


def _group_start(g: dict, task: str, cwd=None, emit=None, source=None, proc_factory=None, run_id: str = "") -> GroupRun:
    rid = run_id if re.fullmatch(r"[\w-]{4,64}", run_id or "") and not (_group_runs_dir() / run_id).exists() else ""
    run = GroupRun(g, task, cwd, emit=emit, proc_factory=proc_factory, source=source, run_id=rid)
    _GROUP_APP["runs"][run.id] = run
    return run


def _group_app(msg: dict) -> None:
    """Polecenia group_* z okna (osobny wątek, nie czeka na turę głównej rozmowy)."""
    kind = str(msg.get("type") or "")
    rid = str(msg.get("run_id") or "")
    run = _GROUP_APP["runs"].get(rid)

    def emit(k, d):
        _app_emit(k, **d)
    try:
        if kind == "group_list":
            _app_emit("group_list", groups=_group_list(), brains=_group_brains(),
                      strategies=[{"id": k, "title": _L(v)} for k, v in _GROUP_STRATEGIES.items()])
        elif kind == "group_save":
            g, err = _group_save(msg.get("group"))
            if err:
                _app_emit("group_error", tekst=err)
            else:
                _app_emit("group_saved", group=g)
            _app_emit("group_list", groups=_group_list(), brains=_group_brains(),
                      strategies=[{"id": k, "title": _L(v)} for k, v in _GROUP_STRATEGIES.items()])
        elif kind == "group_delete":
            if not _group_delete(msg.get("id") or msg.get("group")):
                _app_emit("group_error", tekst=_L("Nie ma takiej grupy."))
            _app_emit("group_list", groups=_group_list(), brains=_group_brains(),
                      strategies=[{"id": k, "title": _L(v)} for k, v in _GROUP_STRATEGIES.items()])
        elif kind == "group_start":
            g, err = _group_resolve(msg)
            if err:
                _app_emit("group_error", tekst=err, ref=str(msg.get("ref") or ""))
                return
            if msg.get("strategy") in _GROUP_STRATEGIES:
                g["strategy"] = msg["strategy"]
            if msg.get("history"):
                g["history"] = str(msg["history"])[-6000:]
            cwd = msg.get("cwd") if msg.get("cwd") and Path(str(msg["cwd"])).is_dir() else None
            run = _group_start(g, str(msg.get("task") or ""), cwd, emit=emit,
                               source={"kind": str(msg.get("source") or "app"), "ref": str(msg.get("ref") or "")},
                               run_id=str(msg.get("run_id") or ""))
            run.ref = str(msg.get("ref") or "")
            run.go()
        elif kind == "group_runs":
            _app_emit("group_runs", runs=_group_runs_list())
        elif kind == "group_attach":
            d = _group_runs_dir() / rid
            since = int(msg.get("since_seq") or 0)
            try:
                for line in (d / "events.jsonl").read_text(encoding="utf-8").splitlines():
                    e = json.loads(line)
                    if int(e.get("seq") or 0) > since:
                        _app_emit(e.pop("type"), **e)
            except (OSError, ValueError):
                _app_emit("group_error", run_id=rid, tekst=_L("Nie ma takiego biegu."))
        elif not run:
            _app_emit("group_error", run_id=rid, tekst=_L("Ten bieg już nie działa w tym oknie."))
        elif kind == "group_stop":
            run.stop(str(msg.get("member") or ""))
        elif kind == "group_revise":
            note = str(msg.get("note") or msg.get("text") or "").strip()
            if not note:
                _app_emit("group_error", run_id=rid, tekst=_L("Napisz, co poprawić."))
                return
            run.revise(str(msg.get("member") or ""), note)
        elif kind == "group_accept":
            run.accept(str(msg.get("member") or ""))
        elif kind == "group_cleanup":
            run.cleanup()
    except (OSError, ValueError, KeyError, TypeError) as exc:
        _app_emit("group_error", run_id=rid, tekst=str(exc)[:300])


