    if not SYNC.rc:
        panel(_L("Zdalne sterowanie wyłączone"), [_L("Telefon widzi przebieg sesji, ale nie może do niej pisać.")])
        return
    panel(_L("Zdalne sterowanie włączone"), [
        _L("Ta sesja jest rozmową w historii DomaAI (ikona konsoli), na telefon poszło powiadomienie."),
        _L("Pisz w niej normalnie: wiadomości trafią tutaj, odpowiedź wróci do rozmowy."),
