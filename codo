def t_multi_edit(args):
    """Kilka chirurgicznych podmian w JEDNYM pliku, atomowo (all-or-nothing).
    Zmienia TYLKO wskazane fragmenty — nie przepisuje całego pliku. Każda podmiana ma te same
    tolerancje i podpowiedzi co edit_file; kolejne widzą wynik poprzednich."""
    path = _agent_path(args.get("path"), write=True)
    if not path.is_file():
        return f"BŁĄD: nie ma pliku {args.get('path')} (nowy plik: write_file). Nic nie zapisano."
    bad = _not_editable(path)
    if bad:
        return bad
    text = _read_text_keep(path)
    orig = text
    edits = args.get("edits") or []
    if isinstance(edits, str):
        try:
            edits = json.loads(edits)   # część modeli podaje listę jako tekst JSON
        except ValueError:
            return "BŁĄD: `edits` ma być listą obiektów {old_string, new_string}."
    if not edits or not isinstance(edits, list):
        return "BŁĄD: brak `edits` (lista obiektów {old_string, new_string})."
    notes = []
    for i, e in enumerate(edits, 1):
        if not isinstance(e, dict):
            return f"BŁĄD: edit #{i} nie jest obiektem {{old_string, new_string}}. Nic nie zapisano."
        old = str(e.get("old_string") or "")
        new = str(e.get("new_string") or "")
        if not old:
            return f"BŁĄD: edit #{i}: pusty old_string (nic nie zapisano)."
        if old == new:
            continue
        ok, out, n, note = _locate_edit(text, old, new, bool(e.get("replace_all")))
        if not ok:
            return f"BŁĄD: edit #{i} z {len(edits)}: " + out[len("BŁĄD: "):] + (
                " Wcześniejsze zmiany z tej listy też NIE zostały zapisane." if i > 1 else "")
        if note:
            notes.append(f"#{i}{note}")
        text = out
    return _apply(path, orig, text, args, f"multi_edit ({len(edits)} zmian)") + (
        "\n" + "; ".join(notes) if notes else "")


def t_replace_lines(args):
    """Podmiana ZAKRESU linii [start,end] — edytuje tylko te linie, resztę
    zostawia bez zmian. Pusty new_string = usunięcie linii."""
    path = _agent_path(args.get("path"), write=True)
    if not path.is_file():
        return f"BŁĄD: nie ma pliku {args.get('path')}."
    bad = _not_editable(path)
    if bad:
        return bad
    orig = _read_text_keep(path)
    lines = _lines_keep(orig)
    start = int(args["start_line"])
    end = int(args.get("end_line") or start)
    if start < 1 or end < start or start > len(lines):
        return f"BŁĄD: zły zakres {start}-{end} (plik ma {len(lines)} linii)."
    new = args.get("new_string", "")
    if new and not new.endswith("\n"):
        new += "\n"
    if new and end >= len(lines) and not orig.endswith("\n"):
        new = new[:-1]   # plik bez końcowego znaku nowej linii zostaje bez niego
    lines[start - 1:end] = [new] if new else []
    return _apply(path, orig, "".join(lines), args, f"replace_lines {start}-{end}")


def _lines_keep(text: str) -> list:
    """Linie z końcami, dzielone TYLKO po \n: tak samo liczy grep i edytor. str.splitlines dzieli też
    po \x0c, \x0b, \x85 i U+2028, więc numery z read_file rozjeżdżały się z grep i replace_lines
    zmieniało złą linię."""
    return re.findall(r"[^\n]*\n|[^\n]+$", text)


def t_insert_lines(args):
    """Wstawia treść PO wskazanej linii (line=0 → na początku). Nie rusza
    istniejących linii."""
    path = _agent_path(args.get("path"), write=True)
    bad = _not_editable(path) if path.is_file() else ""
    if bad:
        return bad
    orig = _read_text_keep(path, missing_ok=True)
    lines = _lines_keep(orig)
    after = int(args.get("line") or 0)
    if after == -1:
        after = len(lines)   # -1 = na końcu pliku
    if after < 0 or after > len(lines):
        return f"BŁĄD: zła pozycja {after} (plik ma {len(lines)} linii)."
    new = args.get("new_string", "")
    if new and not new.endswith("\n"):
        new += "\n"
    if after == len(lines) and lines and not lines[-1].endswith("\n"):
        lines[-1] += "\n"   # do 0.28.0 dopisek sklejał się z ostatnią linią („b”+„c” → „bc”)
    lines[after:after] = [new]
    return _apply(path, orig, "".join(lines), args, f"insert_lines @ {after}")


