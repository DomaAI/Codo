_PLAN_DONE_MARKS = ("✅", "☑", "✔", "✓")
_PLAN_DOING_MARKS = ("⏳", "◐", "🔄", "▶")
_PLAN_TODO_MARKS = ("◯", "○", "☐", "⬜", "•", "-")


def _plan_steps(data: dict) -> list:
    """Kroki planu jako [(tekst, stan)] ze stanem done/doing/todo, niezależnie
    od tego, czy serwer przysłał `steps` ze statusem, czy `plan` z emoji."""
    raw = data.get("steps") or [{"text": p} for p in (data.get("plan") or []) if isinstance(p, str)]
    out = []
    for st in raw[:12]:
        if not isinstance(st, dict):
            continue
        text = " ".join(str(st.get("text") or st.get("title") or st.get("opis") or "").split())
        state = str(st.get("status") or st.get("stan") or "").lower()
        if state in ("done", "zrobione", "completed", "ok"):
            state = "done"
        elif state in ("doing", "in_progress", "w_toku", "running"):
            state = "doing"
        else:
            state = "todo"
        changed = True
        while text and changed:
            changed = False
            for marks, st_name in ((_PLAN_DONE_MARKS, "done"), (_PLAN_DOING_MARKS, "doing"), (_PLAN_TODO_MARKS, "todo")):
                for m in marks:
                    if text.startswith(m):
                        text = text[len(m):].lstrip(" ️")
                        if st_name != "todo" or state == "todo":
                            state = st_name
                        changed = True
        if text:
            out.append((text, state))
    return out


def _confirm_action(question: str, detail: str = "", scope: object = None, *, reason: str = "") -> bool:
    import hashlib
    # 07.11.2026 wieczór: tura z telefonu (/rc) pyta o zgodę tak samo jak
    # w terminalu - w aplikacji pytanie jest kartą z przyciskami (user:
    # „zgody mają wyskakiwać od razu”). Auto-zgoda dla poleceń
    # z telefonu (0.16.4) wycofana w 0.16.5 po tej decyzji.
    key = None
    settings = load_settings()
    remembered = settings.get("approved_actions", [])
    if not isinstance(remembered, list):
        remembered = []
    if scope is not None:
        raw = json.dumps([str(Path.cwd().resolve()), scope], sort_keys=True, ensure_ascii=False)
        key = hashlib.sha256(raw.encode()).hexdigest()
        if key in remembered:
            print(dim(_L("  Wykorzystano zapamiętaną zgodę dla tej czynności.")))
            return True
    if _APP["out"] is not None:
        choice = _app_ask(question, detail, reason, key is not None)
        if choice == 2 and key is not None:
            remembered.append(key)
            settings["approved_actions"] = remembered
            save_settings(settings)
        return choice != 0
    if SESSION.get("noninteractive") and os.environ.get("CODO_ZGODY_SOCK"):
        # 21.11.2026: codo -p uruchomione spod okna Codo: karta zgody w oknie zamiast cichej odmowy.
        return _zgoda_przez_okno(question + ("\n" + detail if detail else ""))
    if SESSION.get("noninteractive"):
        # codo -p i praca w tle: nikt nie potwierdzi, więc bez --yes (i bez zapamiętanej zgody) odmawiamy
        print(dim(_Lf('  Odrzucono bez pytania (brak terminala do zgody): {0} {1}', question, detail[:120])))
        return False
    if LIVE.can_ask():
        choice = LIVE.ask(question, detail, reason, remember=key is not None)
    else:
        choice = _confirm_classic(question, detail, reason, key is not None)
    if choice == 2 and key is not None:
        remembered.append(key)
        settings["approved_actions"] = remembered
        save_settings(settings)
    return choice != 0


def _confirm_classic(question: str, detail: str, reason: str, remember: bool) -> int:
    print("\n" + bold(_terminal_text(question)) + "\n")
    print(_L("  Środowisko: ") + bold(_L("lokalne")))
    print(_L("  Folder: ") + _terminal_text(str(Path.cwd().resolve())))
    if reason:
        print(_L("\n  Powód: ") + _terminal_text(reason))
    if detail:
        print()
        for line in _terminal_text(detail).splitlines():
            print("  " + cyan("$ " + line))
    print()
    return _choose_yes_no(remember=remember)


