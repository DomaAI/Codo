def _group_head(g: dict, m: dict, what: str) -> str:
    others = [x for x in g["members"] if x["id"] != m["id"]]
    out = f"[Grupa Codo «{g['name']}» · Ty: «{m['name']}»"
    if m.get("role"):
        out += f", rola: {m['role']}"
    out += f" · sposób pracy: {_L(_GROUP_STRATEGIES[g['strategy']])} · etap: {what}]"
    if others:
        out += "\nW grupie są też: " + ", ".join(
            x["name"] + (f" ({x['role']})" if x.get("role") else "") for x in others) + "."
    if g.get("instructions"):
        out += "\nZasady grupy: " + g["instructions"]
    return out


