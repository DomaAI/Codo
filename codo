def _ssl_ctx():
    """Kontekst TLS z działającymi certyfikatami. Python z python.org na macOS
    nie widzi certyfikatów systemu, dopóki ktoś nie odpali „Install
    Certificates.command” (każde połączenie: CERTIFICATE_VERIFY_FAILED).
    Kolejność: domyślne certyfikaty → znane pliki systemu → certifi → eksport korzeni z Keychain
    (cache w katalogu konfiguracji). Weryfikacja zostaje zawsze włączona."""
    if _SSL_CTX:
        return _SSL_CTX[0]
    import ssl
    ctx = ssl.create_default_context()
    paths = ssl.get_default_verify_paths()
    has_ca = any(p and os.path.exists(p) for p in (paths.cafile, paths.openssl_cafile)) \
        or bool(paths.capath and os.path.isdir(paths.capath) and os.listdir(paths.capath))
    if not has_ca and not IS_WIN:
        # Python spoza systemu (prywatna kopia z instalatora, własna kompilacja) szuka
        # certyfikatów w katalogu z czasu budowania; system trzyma je gdzie indziej.
        for bundle in _CA_BUNDLES:
            if os.path.exists(bundle):
                try:
                    ctx.load_verify_locations(bundle)
                    has_ca = True
                    break
                except Exception:
                    pass  # nosec B110 — próbujemy kolejny plik
    if not has_ca and not IS_WIN:
        try:
            import certifi
            ctx.load_verify_locations(certifi.where())
            has_ca = True
        except Exception:
            pass  # nosec B110 — certifi to tylko jedna z dróg
    if not has_ca and IS_MAC:
        pem = CONFIG_DIR / "certyfikaty-macos.pem"
        try:
            if not pem.exists() or pem.stat().st_size < 1000:
                out = subprocess.run(
                    ["security", "find-certificate", "-a", "-p",
                     "/System/Library/Keychains/SystemRootCertificates.keychain"],
                    capture_output=True, text=True, timeout=20).stdout
                if "BEGIN CERTIFICATE" in out:
                    CONFIG_DIR.mkdir(parents=True, exist_ok=True)
                    pem.write_text(out)
            ctx.load_verify_locations(str(pem))
        except Exception:
            pass  # nosec B110 — zostaje kontekst domyślny i czytelny błąd TLS
    _SSL_CTX.append(ctx)
    return ctx


# Kody, przy których ponawiamy: 429 (zwolnij), 502/503 (backend zwraca
# kredyty za nieudany krok, więc ponowienie nie płaci podwójnie). 504 NIE:
# nginx odciął połączenie, ale krok mógł się dokończyć i zostać rozliczony.
_RETRY_STATUSES = (429, 502, 503)


def _http(method: str, path: str, *, token: str | None = None,
          json_body: dict | None = None, form: dict | None = None,
          timeout: int = 240, retries: int = 2) -> dict:
    """Żądanie do API z ponawianiem przy chwilowych błędach (sieć, 429/502/503).
    Timeout odczytu NIE jest ponawiany (żądanie mogło już zostać wykonane)."""
    import socket
    import time as _time
    attempt = 0
    while True:
        try:
            return _http_once(method, path, token=token, json_body=json_body,
                              form=form, timeout=timeout)
        except ApiError as e:
            if e.status not in _RETRY_STATUSES or attempt >= retries:
                raise
        except urllib.error.URLError as e:
            if isinstance(e.reason, (socket.timeout, TimeoutError)) or attempt >= retries:
                raise
        attempt += 1
        _time.sleep(min(2 ** attempt, 8))


def _http_once(method: str, path: str, *, token: str | None = None,
               json_body: dict | None = None, form: dict | None = None,
               timeout: int = 240) -> dict:
    url = f"{API_URL}{path}"
    # X-Codo: maile z kodami i powitaniem idą z marką Codo, nie DomaAI.
    headers = {"User-Agent": f"doma-cli/{VERSION}", "X-Codo": VERSION}
    data = None
    if json_body is not None:
        data = json.dumps(json_body).encode()
        headers["Content-Type"] = "application/json"
    elif form is not None:
        from urllib.parse import urlencode
        data = urlencode(form).encode()
        headers["Content-Type"] = "application/x-www-form-urlencoded"
    if token:
        headers["Authorization"] = f"Bearer {token}"
        headers.update(firma_headers())
    req = urllib.request.Request(url, data=data, headers=headers, method=method)
    try:
        with urllib.request.urlopen(req, timeout=timeout, context=_ssl_ctx()) as resp:
            return json.loads(resp.read().decode() or "{}")
    except urllib.error.HTTPError as e:
        body = e.read().decode(errors="replace")
        try:
            payload = json.loads(body)
            detail = payload.get("detail", body) if isinstance(payload, dict) else body
        except ValueError:
            payload = {}
            detail = body
        raise ApiError(e.code, detail, payload) from None


class ApiError(Exception):
    def __init__(self, status: int, detail, payload=None, kod: str = ""):
        self.payload = payload if isinstance(payload, dict) else {}
        self.kod = kod          # nagłówek X-Doma-Kod (np. WYLACZONE), gdy wołający go czyta
        self.status = status
        self.detail = detail
        super().__init__(f"HTTP {status}: {detail}")

    def human(self) -> str:
        """Komunikat dla człowieka (detail bywa obiektem z polem detail/message)."""
        d = self.detail
        if isinstance(d, dict):
            d = d.get("detail") or d.get("message") or d.get("code") or json.dumps(d, ensure_ascii=False)
        elif isinstance(d, list):
            d = "; ".join(str(x.get("msg", x)) if isinstance(x, dict) else str(x) for x in d)
        d = str(d or "").strip()
        if d.startswith("<"):   # strona HTML z nginx (502/504)
            d = ""
        hint = {401: _L("sesja wygasła, zaloguj się: codo login"),
                413: _L("za dużo kontekstu, zacznij od nowa: /clear"),
                429: _L("za dużo żądań, odczekaj chwilę"),
                502: _L("model chwilowo niedostępny, spróbuj ponownie"),
                503: _L("serwer chwilowo niedostępny, spróbuj za chwilę"),
                504: _L("serwer nie odpowiedział na czas, spróbuj ponownie")}.get(self.status, "")
        return d or hint or _Lf('błąd serwera ({0})', self.status)


def describe_error(e: BaseException) -> str:
    """Jedna linijka zamiast tracebacka dla błędów sieci/API."""
    if isinstance(e, ApiError):
        return e.human()
    if isinstance(e, urllib.error.URLError):
        reason = getattr(e, "reason", e)
        if "CERTIFICATE_VERIFY_FAILED" in str(reason):
            return (_L("Python nie ma certyfikatów TLS. macOS: otwórz Aplikacje → Python 3.x → "
                    "Install Certificates.command, albo: pip3 install certifi. Sprawdź: codo doctor"))
        return _Lf('brak połączenia z {0} ({1}). Sprawdź internet albo uruchom: codo doctor', API_URL, reason)
    if isinstance(e, TimeoutError):
        return _L("serwer nie odpowiedział na czas, spróbuj ponownie")
    return str(e)


# ── Ustawienia lokalne (model, cache wersji) ────────────────────────────────
def load_settings() -> dict:
    try:
        d = json.loads(SETTINGS_FILE.read_text(encoding="utf-8"))
        return d if isinstance(d, dict) else {}
    except (OSError, ValueError):
        return {}


def save_settings(settings: dict) -> None:
    """Zapis przez unikalny plik tymczasowy i os.replace. Ustawienia zapisuje naraz kilka procesów
    (okno Codo, `codo host`, `codo work --bg`, REPL): do 0.28.0 plik był najpierw obcinany, czytelnik
    trafiał na pusty, dostawał {} i jego zapis kasował wszystko (dostawca, model, zaufane foldery)."""
    import tempfile
    try:
        CONFIG_DIR.mkdir(parents=True, exist_ok=True)
        fd, tmp = tempfile.mkstemp(prefix=".settings.", suffix=".tmp", dir=str(CONFIG_DIR))
        try:
            with os.fdopen(fd, "w", encoding="utf-8") as f:
                f.write(json.dumps(settings, indent=1, ensure_ascii=False))
                f.flush()
                os.fsync(f.fileno())
            for attempt in range(5):
                try:
                    os.replace(tmp, SETTINGS_FILE)
                    break
                except PermissionError:
                    # Windows: inny proces Codo akurat czyta plik
                    if not IS_WIN or attempt == 4:
                        raise
                    import time
                    time.sleep(0.05 * (attempt + 1))
        except BaseException:
            try:
                os.unlink(tmp)
            except OSError:
                pass  # nosec B110
            raise
    except OSError:
        pass  # nosec B110 — ustawienia są wygodą, nie warunkiem działania


# ── Język interfejsu (0.22.0): angielski domyślnie, polski z wyboru albo z ustawień systemu ──
# Teksty w kodzie są po polsku; _L()/_Lf() podmieniają je na angielskie z katalogu _EN (koniec pliku).
# Znaczniki dla modelu i wyniki narzędzi (BŁĄD, ODRZUCONE…) zostają po polsku: Codo je rozpoznaje.
_LANG: list = [None]


def _system_locale() -> str:
    for var in ("CODO_LANG", "LC_ALL", "LC_MESSAGES", "LANG"):
        v = os.environ.get(var, "")
        if v and not v.startswith(("C.", "POSIX")) and v != "C":
            return v.lower()
    if sys.platform == "darwin":
        try:
            out = subprocess.run(["defaults", "read", "-g", "AppleLocale"], capture_output=True, text=True,
                                 timeout=3, stdin=subprocess.DEVNULL).stdout
            if out.strip():
                return out.strip().lower()
        except (OSError, subprocess.SubprocessError):
            pass
    try:
        import locale
        return (locale.getlocale()[0] or "").lower()
    except (ValueError, ImportError):
        return ""


_REPLY_LANG_NAMES = {
    "de": "German", "fr": "French", "es": "Spanish", "it": "Italian", "pt-br": "Brazilian Portuguese",
    "pt": "Portuguese", "nl": "Dutch", "sv": "Swedish", "da": "Danish", "cs": "Czech", "uk": "Ukrainian",
    "ro": "Romanian", "hu": "Hungarian", "tr": "Turkish", "ja": "Japanese", "ko": "Korean",
    "zh-hans": "Simplified Chinese", "zh": "Simplified Chinese",
}


def _reply_lang_name() -> str:
    """Język okna Codo spoza pl/en (CODO_LANG=de, pt-BR, zh-Hans…) jako nazwa dla modelu albo ""."""
    v = os.environ.get("CODO_LANG", "").strip().lower().replace("_", "-")
    return _REPLY_LANG_NAMES.get(v) or _REPLY_LANG_NAMES.get(v[:2], "") if v else ""


def _reply_lang_line() -> str:
    name = _reply_lang_name()
    if name:
        return (f"\nLANGUAGE: the user's interface is in {name}. Reply in {name} unless the user writes "
                "in another language, then reply in theirs. Internal markers and tool names stay as defined.")
    return _REPLY_LANG_EN if ui_lang() == "en" else ""


def ui_lang() -> str:
    """„en” albo „pl”. Kolejność: CODO_LANG, wybór w ustawieniach, dotychczasowa instalacja (pl),
    język systemu (pl tylko dla polskiego), w pozostałych przypadkach angielski."""
    if _LANG[0]:
        return _LANG[0]
    env = os.environ.get("CODO_LANG", "").lower()[:2]
    if env in ("pl", "en"):
        _LANG[0] = env
        return env
    if _reply_lang_name():
        # Codo na Maca w innym języku (de, fr, ja…): napisy CLI po angielsku, model odpowiada w języku okna.
        _LANG[0] = "en"
        return "en"
    st = load_settings()
    v = st.get("lang")
    if v not in ("pl", "en"):
        existing = SETTINGS_FILE.exists() or CRED_FILE.exists() or DEVICE_FILE.exists()
        loc = _system_locale()
        v = "pl" if loc.startswith("pl") or (existing and not loc.startswith("en")) or (existing and not loc) else "en"
        if existing:
            st["lang"] = v   # utrwalamy, żeby zmiana ustawień systemu nie przełączała języka w trakcie
            save_settings(st)
    _LANG[0] = v
    return v


def _L(text: str) -> str:
    if ui_lang() == "pl":
        return text
    return _EN.get(text, text)


def _Lf(template: str, *args) -> str:
    return _L(template).format(*args)


_LOCALIZED: dict = {}


def _deep_t(value):
    if isinstance(value, str):
        return _EN.get(value, value)
    if isinstance(value, tuple):
        return tuple(_deep_t(v) for v in value)
    if isinstance(value, list):
        return [_deep_t(v) for v in value]
    if isinstance(value, dict):
        return {k: _deep_t(v) for k, v in value.items()}
    return value


def _apply_lang() -> None:
    """Tabele interfejsu (help, komendy, podpowiedzi, czasowniki narzędzi) w bieżącym języku."""
    g = globals()
    for name in _UI_TABLES:
        if name not in g:
            continue
        if name not in _LOCALIZED:
            _LOCALIZED[name] = dict(g[name]) if isinstance(g[name], dict) else g[name]   # kopia oryginału
        orig = _LOCALIZED[name]
        new = dict(orig) if ui_lang() == "pl" and isinstance(orig, dict) else (orig if ui_lang() == "pl" else _deep_t(orig))
        if isinstance(g[name], dict) and isinstance(new, dict):
            g[name].clear()
            g[name].update(new)   # słowniki bywają trzymane w innych miejscach przez referencję
        else:
            g[name] = new
    if ui_lang() == "en":
        g["_SUMMARY_WORDS"] = _SUMMARY_WORDS_EN
    elif "_SUMMARY_WORDS" in _LOCALIZED:
        g["_SUMMARY_WORDS"] = _LOCALIZED["_SUMMARY_WORDS"]


def cmd_lang(arg: str = "") -> int:
    a = (arg or "").strip().lower()[:2]
    if a not in ("pl", "en"):
        print(_L("Język interfejsu: ") + bold(ui_lang()) + dim(_L("  · /lang en albo /lang pl")))
        return 0
    st = load_settings()
    st["lang"] = a
    save_settings(st)
    _LANG[0] = a
    _apply_lang()
    print(green("✓ " + (_L("Interface language: English") if a == "en" else _L("Język interfejsu: polski"))))
    return 0


def _ver_tuple(v: str) -> tuple:
    return tuple(int(x) for x in re.findall(r"\d+", v or "")[:3])


def update_hint(force: bool = False) -> str | None:
    """Nowsza wersja na serwerze? Sprawdzane najwyżej raz na dobę (cache)."""
    import time as _time
    st = load_settings()
    latest = st.get("latest_version")
    if force or _time.time() - float(st.get("version_checked_at") or 0) > 86400:
        try:
            info = _http("GET", "/cli/info", timeout=4, retries=0)
            latest = info.get("version")
        except Exception:
            # Bez sieci: następna próba za godzinę, nie przy każdym starcie (do 0.28.0 każde
            # uruchomienie offline czekało do 4 s na DNS i limit czasu).
            if not force:
                cur = load_settings()
                cur["version_checked_at"] = _time.time() - 86400 + 3600
                save_settings(cur)
            return None
        cur = load_settings()   # świeży odczyt: nie nadpisujemy zmian innych procesów
        cur.update(latest_version=latest, version_checked_at=_time.time())
        save_settings(cur)
    if latest and _ver_tuple(latest) > _ver_tuple(VERSION):
        return latest
    return None


# ── Żywy panel terminala: status pracy + okno pisania przypięte na dole ─────
# Wszystko, co program wypisuje, ląduje NAD panelem (zwykły print przez
# podmieniony sys.stdout), a panel (koniczyna myślenia, czynność, czas,
# kroki, tokeny, okno pisania, stopka trybu) jest przerysowywany pod spodem.
# Bez regionów przewijania: historia zostaje w scrollbacku terminala, tak
# w pełnym ekranie. macOS/Linux: termios, Windows: msvcrt + sekwencje VT.
import contextlib

_ANSI_RE = re.compile(r"\x1b\[[0-?]*[ -/]*[@-~]|\x1b\][^\x07\x1b]*(?:\x07|\x1b\\)")


def _visible(text: str) -> str:
    return _ANSI_RE.sub("", text)


def _cell(ch: str) -> int:
    import unicodedata
    if unicodedata.combining(ch):
        return 0
    return 2 if unicodedata.east_asian_width(ch) in ("W", "F") else 1


def _wrap_ansi(line: str, width: int) -> list[str]:
    """Dzieli linię (także z kolorami ANSI) na wiersze o szerokości ≤ width."""
    width = max(1, width)
    rows, cur, used, styled = [], "", 0, False
    pos = 0
    while pos < len(line):
        m = _ANSI_RE.match(line, pos)
        if m:
            cur += m.group(0)
            styled = True
            pos = m.end()
            continue
        ch = line[pos]
        pos += 1
        w = _cell(ch)
        if used + w > width:
            rows.append(cur + ("\033[0m" if styled else ""))
            cur, used = "", 0
        cur += ch
        used += w
    rows.append(cur + ("\033[0m" if styled and cur else ""))
    return rows


def _fit(line: str, width: int) -> str:
    """Jeden wiersz: przycina do szerokości, nie psując kolorów."""
    rows = _wrap_ansi(line, width)
    if len(rows) == 1:
        return rows[0]
    first = _wrap_ansi(line, max(1, width - 1))[0]
    return first + ("\033[0m" if "\033" in first else "") + "…"


def _truecolor() -> bool:
