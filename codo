def _host_plain(text: str) -> str:
    """Markdown na zwykły tekst czatu."""
    t = re.sub(r"```[a-zA-Z]*\n?", "", str(text or ""))
    t = re.sub(r"\*\*(.+?)\*\*", r"\1", t)
    t = re.sub(r"(?m)^#{1,6}\s*", "", t)
    return t.replace("`", "").strip()


def _host_quiet(answer: str) -> bool:
    t = re.sub(r"^[^0-9A-Za-zĄĆĘŁŃÓŚŹŻąćęłńóśźż]+|[^0-9A-Za-zĄĆĘŁŃÓŚŹŻąćęłńóśźż]+$", "", (answer or "").upper())
    return not t or t in _HOST_QUIET or t.startswith("CISZA")


def _host_key() -> str:
    import random
    return "".join(random.choice("abcdefghjkmnpqrstuvwxyz23456789") for _ in range(5))  # nosec B311 — etykieta, nie sekret


def _host_headline(text: str) -> str:
    first = next((ln.strip() for ln in str(text).splitlines() if ln.strip()), str(text).strip())
    return first if len(first) <= 90 else first[:88] + "…"


def _host_sock_path() -> str:
    """Gniazdo sterujące; długi folder ustawień dostaje je w tmp (limit ścieżki gniazda uniksowego)."""
    p = str(HOST_DIR / "host.sock")
    if len(p.encode()) > 100:
        import hashlib
        import tempfile
        tag = hashlib.sha256(str(HOST_DIR).encode()).hexdigest()[:12]
        p = os.path.join(tempfile.gettempdir(), f"codo-host-{tag}.sock")
        if len(p.encode()) > 100:
            p = f"/tmp/codo-host-{tag}.sock"   # nosec B108 — gniazdo 0600 właściciela
    return p


def _host_load(name: str, default):
    try:
        return json.loads((HOST_DIR / name).read_text(encoding="utf-8"))
    except (OSError, ValueError):
        return default


def _host_save(name: str, data) -> None:
    HOST_DIR.mkdir(parents=True, exist_ok=True)
    try:
        os.chmod(HOST_DIR, 0o700)
    except OSError:
        pass
    tmp = HOST_DIR / (name + ".tmp")
    tmp.write_text(json.dumps(data, ensure_ascii=False, indent=1), encoding="utf-8")
    os.chmod(tmp, 0o600)
    os.replace(tmp, HOST_DIR / name)


class HostEngine:
    """Silnik jednego agenta: `codo app-server` w jego folderze; zdarzenia idą do kolejki gospodarza."""

    def __init__(self, agent: dict, desk: Path, events_q):
        self.a, self.desk, self.q = agent, Path(desk), events_q
        self.proc = None
        self.ready = False
        self.busy = False
        self.answer = ""
        self.ask_id = None
        self.idle_since = 0.0

    def mode(self) -> str:
        return "read" if not self.a.get("writes") else ("auto" if self.a.get("auto") else "ask")

    def spawn(self) -> None:
        env = dict(os.environ)
        for k in ("CODO_NO_HISTORY", "CODO_PROVIDER", "CODO_UI_DEV", "CODO_ZESPOL_DIR", "CODO_ZESPOL_CZLONEK"):
            env.pop(k, None)
        env.update({"CODO_APP_MODE": self.mode(), "CODO_APP_AGENT": "1", "CODO_APP_LOCAL_ONLY": "1",
                    "DOMA_NO_SYNC": "1", "CODO_CLIENT": "host", "PYTHONUNBUFFERED": "1", "NO_COLOR": "1"})
        env.update(_host_secrets())
        model = str(self.a.get("model") or "")
        pin = _team_brain_provider(model) if model else ""
        if pin:
            env["CODO_PROVIDER"] = pin
        cmd = [*_self_cmd(_team_script())] + (["--model", model] if model else []) + ["app-server"]
        self.desk.mkdir(parents=True, exist_ok=True)
        (HOST_DIR / "log").mkdir(parents=True, exist_ok=True)
        kw = {"cwd": str(self.desk), "env": env, "stdin": subprocess.PIPE, "stdout": subprocess.PIPE}
        if IS_WIN:
            kw["creationflags"] = 0x00000200
        else:
            kw["start_new_session"] = True
        with open(HOST_DIR / "log" / f"{self.a['id']}.err", "ab") as err:
            self.proc = subprocess.Popen(cmd, stderr=err, **kw)  # nosec B603 — własny program
        threading.Thread(target=self._read, daemon=True).start()

    def _read(self) -> None:
        proc, aid = self.proc, self.a["id"]
        for raw in proc.stdout:
            try:
                ev = json.loads(raw.decode("utf-8", "replace"))
            except ValueError:
                continue
            if isinstance(ev, dict):
                self.q.put(("engine", aid, self, ev))
        self.q.put(("engine", aid, self, {"type": "_exit", "code": proc.wait()}))

    last_error = ""
    credits_seen = 0.0     # licznik kredytów z ostatniego turn_end tego procesu (koszt tury = różnica)

    def send(self, obj: dict) -> bool:
        if obj.get("type") == "send":
            self.last_error = ""
        try:
            self.proc.stdin.write((json.dumps(obj, ensure_ascii=False) + "\n").encode("utf-8"))
            self.proc.stdin.flush()
            return True
        except (OSError, ValueError, AttributeError):
            return False

    def alive(self) -> bool:
        return self.proc is not None and self.proc.poll() is None

    def stop(self, wait: float = 5) -> None:
        if not self.proc:
            return
        self.send({"type": "quit"})
        try:
            self.proc.stdin.close()
        except (OSError, ValueError):
            pass
        try:
            self.proc.wait(timeout=wait)
        except subprocess.TimeoutExpired:
            _kill_tree(self.proc)


class _HostWS:
    """Najprostszy klient WebSocket (RFC 6455) na samej bibliotece standardowej: tekst, ping/pong, zamknięcie.
    Wystarcza na bramę Discorda i Socket Mode Slacka; gospodarz nie ciągnie przez to żadnych zależności."""

    def __init__(self, url: str, timeout: float = 30):
        import base64
        import socket
        import ssl
        u = urllib.parse.urlsplit(url)
        secure = u.scheme == "wss"
        port = u.port or (443 if secure else 80)
        raw = socket.create_connection((u.hostname, port), timeout=timeout)
        self.s = ssl.create_default_context().wrap_socket(raw, server_hostname=u.hostname) if secure else raw
        key = base64.b64encode(os.urandom(16)).decode()
        path = (u.path or "/") + ("?" + u.query if u.query else "")
        host = u.hostname + ("" if u.port is None else f":{u.port}")
        self.s.sendall((f"GET {path} HTTP/1.1\r\nHost: {host}\r\nUpgrade: websocket\r\nConnection: Upgrade\r\n"
                        f"Sec-WebSocket-Key: {key}\r\nSec-WebSocket-Version: 13\r\nUser-Agent: codo-host\r\n\r\n").encode())
        head = b""
        while b"\r\n\r\n" not in head:
            chunk = self.s.recv(4096)
            if not chunk:
                raise OSError("websocket: połączenie zamknięte przy powitaniu")
            head += chunk
        head, self.buf = head.split(b"\r\n\r\n", 1)
        if b" 101 " not in head.split(b"\r\n", 1)[0]:
            raise OSError("websocket: " + head.split(b"\r\n", 1)[0].decode("latin-1"))
        self.lock = threading.Lock()
        self.closed = False

    def _read(self, n: int) -> bytes:
        while len(self.buf) < n:
            chunk = self.s.recv(65536)
            if not chunk:
                raise OSError("websocket: połączenie zamknięte")
            self.buf += chunk
        out, self.buf = self.buf[:n], self.buf[n:]
        return out

    def _frame(self, op: int, data: bytes) -> None:
        import struct
        head = bytes([0x80 | op])
        n = len(data)
        if n < 126:
            head += bytes([0x80 | n])
        elif n < 65536:
            head += bytes([0x80 | 126]) + struct.pack(">H", n)
        else:
            head += bytes([0x80 | 127]) + struct.pack(">Q", n)
        mask = os.urandom(4)
        body = bytes(b ^ mask[i % 4] for i, b in enumerate(data))
        with self.lock:
            self.s.sendall(head + mask + body)

    def send(self, text: str) -> None:
        self._frame(0x1, text.encode("utf-8"))

    def recv(self, timeout: float | None = None) -> str | None:
        """Następna wiadomość tekstowa; None = druga strona zamknęła połączenie. Ping dostaje pong."""
        import struct
        self.s.settimeout(timeout)
        parts: list = []
        while True:
            b1, b2 = self._read(2)
            op, n = b1 & 0x0F, b2 & 0x7F
            if n == 126:
                n = struct.unpack(">H", self._read(2))[0]
            elif n == 127:
                n = struct.unpack(">Q", self._read(8))[0]
            mask = self._read(4) if b2 & 0x80 else b""
            data = self._read(n)
            if mask:
                data = bytes(b ^ mask[i % 4] for i, b in enumerate(data))
            if op == 0x8:
                self.close()
                return None
            if op == 0x9:
                self._frame(0xA, data)
                continue
            if op == 0xA:
                continue
            parts.append(data)
            if b1 & 0x80:
                return b"".join(parts).decode("utf-8", "replace")

    def close(self) -> None:
        if self.closed:
            return
        self.closed = True
        try:
            self._frame(0x8, b"\x03\xe8")
        except OSError:
            pass
        try:
            self.s.close()
        except OSError:
            pass


# ── głos na komunikatorach gospodarza (23.11.2026): wiadomość głosowa → tekst, odpowiedź → OGG/Opus ──
_HOST_VOICE_MAX = 25 * 1024 * 1024


def _api_bytes(path: str, body: dict, timeout: int = 120) -> bytes:
    """POST do DomaAI tym samym tokenem urządzenia co api_call, ale odpowiedź to surowe bajty (np. audio/ogg)."""
    def once(tok: str | None) -> bytes:
        headers = {"User-Agent": f"doma-cli/{VERSION}", "Content-Type": "application/json"}
        if tok:
            headers["Authorization"] = f"Bearer {tok}"
            headers.update(firma_headers())
        req = urllib.request.Request(f"{API_URL}{path}", data=json.dumps(body).encode(), headers=headers, method="POST")
        try:
            with urllib.request.urlopen(req, timeout=timeout, context=_ssl_ctx()) as resp:  # nosec B310 — adres API DomaAI
                return resp.read()
        except urllib.error.HTTPError as e:
            raw = e.read().decode(errors="replace")
            try:
                payload = json.loads(raw)
                detail = payload.get("detail", raw) if isinstance(payload, dict) else raw
            except ValueError:
                payload, detail = {}, raw
            raise ApiError(e.code, detail, payload) from None
    try:
        tok = device_access_token()
    except SystemExit:
        raise ApiError(401, "Urządzenie Codo na serwerze nie jest sparowane z kontem DomaAI.") from None
    if tok is None:
        creds = load_creds()
        if not creds:
            raise ApiError(401, "To urządzenie nie jest zalogowane. Uruchom: codo login")
        tok = creds.get("access_token")
    try:
        return once(tok)
    except ApiError as e:
        if e.status != 401:
            raise
        try:
            return once(device_access_token(force=True))
        except SystemExit:
            raise ApiError(401, "Urządzenie Codo na serwerze nie jest sparowane z kontem DomaAI.") from None


def _host_api_detail(e: ApiError) -> str:
    d = e.detail
    if isinstance(d, dict):
        d = d.get("detail") or d.get("message") or ""
    d = str(d or "").strip()
    return "" if d.startswith("<") or len(d) > 200 else d


def _host_transcribe(data: bytes, mime: str) -> tuple:
    """Nagranie na tekst przez DomaAI. Zwraca (tekst, "") albo ("", powód po polsku)."""
    import base64
    if not data:
        return "", "puste nagranie"
    if len(data) > _HOST_VOICE_MAX:
        return "", "nagranie jest za długie"
    try:
        r = api_call(None, "/cli/glos/transkrybuj", {"dane": base64.b64encode(data).decode(), "typ": mime or "audio/ogg"})
    except SystemExit:
        return "", "urządzenie Codo nie jest sparowane z DomaAI"
    except ApiError as e:
        return "", (_host_api_detail(e) or {402: "brak kredytów DomaAI", 413: "nagranie jest za długie",
                                             429: "za dużo nagrań naraz, spróbuj za chwilę"}.get(e.status, f"błąd DomaAI ({e.status})"))
    except (OSError, ValueError):
        return "", "brak połączenia z DomaAI"
    text = str((r or {}).get("tekst") or "").strip()
    return (text, "") if text else ("", "nic nie usłyszałem")


def _host_speech_text(text: str) -> str:
    """Odpowiedź do przeczytania na głos: bez bloków kodu, markdownu i adresów, najwyżej 3000 znaków."""
    t = re.sub(r"```.*?(```|$)", " ", str(text or ""), flags=re.S)
    t = re.sub(r"!?\[([^\]]*)\]\([^)]*\)", r"\1", t)
    t = re.sub(r"https?://\S+", "", t)
    t = re.sub(r"(?m)^\s{0,3}(#{1,6}|>|[-*+•]|\d+[.)])\s+", "", t)
    t = re.sub(r"[*_`~|]+", "", t)
    t = re.sub(r"[ \t]+", " ", t)
    t = re.sub(r"\n{3,}", "\n\n", t).strip()
    if len(t) > 3000:
        cut = t[:3000]
        end = max(cut.rfind(". "), cut.rfind("\n"))
        t = cut[:end + 1] if end > 2000 else cut
    return t.strip()


def _host_tts(text: str) -> bytes | None:
    """Tekst na OGG/Opus przez DomaAI; błąd (brak kredytów, sieć) nie zatrzymuje odpowiedzi tekstem."""
    t = _host_speech_text(text)
    if not t:
        return None
    try:
        return _api_bytes("/cli/glos/mow", {"tekst": t, "format": "ogg"}) or None
    except ApiError as e:
        print(f"[głos] mowa niedostępna ({e.status}): {_host_api_detail(e)}", file=sys.stderr, flush=True)
    except (OSError, ValueError) as e:
        print(f"[głos] mowa niedostępna: {e}", file=sys.stderr, flush=True)
    return None


def _host_multipart(fields: dict, files: list) -> tuple:
    """Treść multipart/form-data: pola tekstowe i pliki (nazwa pola, nazwa pliku, typ, bajty)."""
    boundary = "codo" + os.urandom(12).hex()
    out = b""
    for k, v in fields.items():
        out += (f"--{boundary}\r\nContent-Disposition: form-data; name=\"{k}\"\r\n\r\n").encode() + str(v).encode() + b"\r\n"
    for field, fname, ctype, data in files:
        out += (f"--{boundary}\r\nContent-Disposition: form-data; name=\"{field}\"; filename=\"{fname}\"\r\n"
                f"Content-Type: {ctype}\r\n\r\n").encode() + data + b"\r\n"
    out += f"--{boundary}--\r\n".encode()
    return out, f"multipart/form-data; boundary={boundary}"


_HOST_STALE_BUTTON = "To pytanie już tu nie czeka. Odpowiedz w aplikacji Codo."


class HostChat:
    """Komunikator gospodarza. Każdy wkłada do kolejki ("chat", nazwa, zdarzenie), gdzie zdarzenie to
    {"text"} albo {"button", "ack"} plus "who" (kto pisze) i "where" (gdzie odpisać). Parowanie, właściciela
    i polecenia ogarnia AgentHost, wspólnie dla wszystkich."""

    name = ""
    title = ""
    where_word = ""      # „na Telegramie”: do podpowiedzi dla agenta
    limit = 3800
    hears = False        # odsłuchuje wiadomości głosowe (transkrypcja w DomaAI)
    speaks = False       # umie odpowiedzieć głosem (send_voice)

    def __init__(self, cfg: dict, events_q):
        self.cfg, self.q = cfg, events_q
        self.stop_flag = False
        self.problem = ""
        self.numbered: list = []     # przyciski jako lista „odpisz 1/2/3” (komunikatory bez przycisków)

    @property
    def chat(self):
        return self.cfg.get("chat")

    @property
    def paired(self) -> bool:
        return bool(self.cfg.get("owner") or self.cfg.get("chat"))

    def mine(self, who, where) -> bool:
        """Czy to pisze właściciel (ta sama reguła co w AgentHost.on_chat)."""
        owner = self.cfg.get("owner")
        if owner:
            return str(owner) == str(who)
        return self.cfg.get("chat") is not None and str(self.cfg.get("chat")) == str(where)

    @property
    def voice_mode(self) -> str:
        v = str(self.cfg.get("voice") or "auto")
        return v if v in ("auto", "always", "off") else "auto"

    def heard(self, data: bytes, mime: str, who, where, prefix: str = "") -> None:
        """Nagranie od właściciela: transkrypcja w DomaAI i dalej jak zwykły tekst (z „voice”). Obcych nie odsłuchujemy."""
        if not self.mine(who, where):
            return
        text, why = _host_transcribe(data, mime)
        if not text:
            self.send(f"Nie udało się odsłuchać wiadomości głosowej ({why}). Napisz tekstem.")
            return
        self.emit(text=((prefix.strip() + "\n") if prefix.strip() else "") + text, who=who, where=where, voice=True)

    def speak(self, text: str) -> bool:
        """Odpowiedź głosem (po tekście, w osobnym wątku). Brak mowy w DomaAI nie psuje odpowiedzi tekstem."""
        ogg = _host_tts(text)
        if not ogg:
            return False
        try:
            return bool(self.send_voice(ogg))
        except (OSError, ValueError) as e:
            print(f"[{self.name}] nie wysłano głosu: {e}", file=sys.stderr, flush=True)
            return False

    def send_voice(self, ogg: bytes) -> bool:
        return False

    def numbered_text(self, text: str, buttons: list | None) -> str:
        """Przyciski jako ponumerowana lista; odpowiedź numerem wraca przyciskiem (zob. pick)."""
        flat = [b for row in (buttons or []) for b in row]
        if not flat:
            return text
        self.numbered = [d for _, d in flat]
        return (text + "\n\n" + "\n".join(f"{i + 1}. {t}" for i, (t, _) in enumerate(flat))
                + "\n\nOdpisz numerem: " + "/".join(str(i + 1) for i in range(len(flat))) + ".")

    def pick(self, text: str):
        t = str(text or "").strip().rstrip(".")
        if t.isdigit() and 1 <= int(t) <= len(self.numbered):
            d, self.numbered = self.numbered[int(t) - 1], []
            return d
        return None

    def start(self) -> None:
        threading.Thread(target=self._loop, daemon=True).start()

    def _loop(self) -> None:
        raise NotImplementedError

    def _note(self, why: str) -> None:
        if why != self.problem:
            print(f"[{self.name}] {why}", file=sys.stderr, flush=True)
        self.problem = why

    def emit(self, **ev) -> None:
        self.q.put(("chat", self.name, ev))

    def parts(self, text: str) -> list:
        body = _host_plain(text)
        return [body[i:i + self.limit] for i in range(0, len(body), self.limit)] or [""]

    def send(self, text: str, buttons: list | None = None) -> bool:
        raise NotImplementedError

    def _json(self, url: str, body: dict | None = None, headers: dict | None = None, method: str | None = None,
              timeout: float = 30) -> dict:
        h = {"Content-Type": "application/json; charset=utf-8", "User-Agent": "DiscordBot (https://domaai.pl, 1.0)"}
        h.update(headers or {})
        req = urllib.request.Request(url, data=None if body is None else json.dumps(body).encode(), headers=h,
                                     method=method or ("GET" if body is None else "POST"))
        with urllib.request.urlopen(req, timeout=timeout) as r:  # nosec B310 — adres API komunikatora
            raw = r.read().decode() or "{}"
        return json.loads(raw) if raw.strip().startswith(("{", "[")) else {}


class HostTelegram(HostChat):
    """Bot Telegrama użytkownika: wiadomości do agentów, wyniki i zgody przyciskami."""

    name, title, where_word = "telegram", "Telegram", "na Telegramie"
    hears = speaks = True

    def __init__(self, cfg: dict, events_q):
        super().__init__(cfg, events_q)
        self.api = (os.environ.get("CODO_TELEGRAM_API") or "https://api.telegram.org").rstrip("/")
        self.offset = 0

    def _call(self, method: str, body: dict, timeout: float = 35):
        return self._json(f"{self.api}/bot{self.cfg.get('token')}/{method}", body, timeout=timeout)

    def _loop(self) -> None:
        import time
        while not self.stop_flag:
            try:
                r = self._call("getUpdates", {"timeout": 25, "offset": self.offset, "allowed_updates": ["message", "callback_query"]})
                self.problem = ""
                for u in r.get("result") or []:
                    self.offset = max(self.offset, int(u.get("update_id") or 0) + 1)
                    cb = u.get("callback_query")
                    if cb:
                        chat = (cb.get("message") or {}).get("chat", {}).get("id")
                        cid = str(cb.get("id"))
                        self.emit(button=str(cb.get("data") or ""), who=str(chat), where=chat,
                                  ack=lambda t, cid=cid: self.answer_cb(cid, t))
                        continue
                    msg = u.get("message") or {}
                    chat = (msg.get("chat") or {}).get("id")
                    media = msg.get("voice") or msg.get("audio")
                    if chat is not None and isinstance(media, dict) and media.get("file_id"):
                        self.voice_in(media, chat, str(msg.get("caption") or ""))
                    elif chat is not None and str(msg.get("text") or "").strip():
                        self.emit(text=str(msg["text"]).strip(), who=str(chat), where=chat)
            except urllib.error.HTTPError as e:
                # 409: ten sam bot ma webhook (np. workflow w DomaAI) albo słucha go inny program; Telegram pozwala na jedno
                self._note("Ten bot jest już podłączony gdzie indziej (webhook albo inny program). Zrób osobnego bota dla Codo w @BotFather."
                           if e.code == 409 else f"Telegram odrzucił połączenie ({e.code}).")
                time.sleep(30 if e.code in (401, 409) else 5)
            except (OSError, ValueError):
                time.sleep(5)

    def send(self, text: str, buttons: list | None = None) -> bool:
        if not self.chat or not str(text).strip():
            return False
        ok = True
        parts = self.parts(text)
        for i, part in enumerate(parts):
            body = {"chat_id": self.chat, "text": part}
            if buttons and i == len(parts) - 1:
                body["reply_markup"] = {"inline_keyboard": [[{"text": t, "callback_data": d} for t, d in row] for row in buttons]}
            try:
                self._call("sendMessage", body, timeout=20)
            except (OSError, ValueError):
                ok = False
        return ok

    def voice_in(self, media: dict, chat, caption: str = "") -> None:
        if not self.mine(str(chat), chat):
            return                  # obcych nagrań nie pobieramy i nie odsłuchujemy
        try:
            if int(media.get("file_size") or 0) > _HOST_VOICE_MAX:
                raise ValueError("za duże")
            path = str((self._call("getFile", {"file_id": media["file_id"]}, timeout=20).get("result") or {}).get("file_path") or "")
            if not path:
                raise ValueError("brak pliku")
            req = urllib.request.Request(f"{self.api}/file/bot{self.cfg.get('token')}/{path}", headers={"User-Agent": "codo-host"})
            with urllib.request.urlopen(req, timeout=60) as r:  # nosec B310 — plik z API Telegrama
                data = r.read(_HOST_VOICE_MAX + 1)
        except (OSError, ValueError, KeyError):
            self.send("Nie udało się pobrać wiadomości głosowej z Telegrama. Spróbuj jeszcze raz albo napisz tekstem.")
            return
        self.heard(data, str(media.get("mime_type") or "audio/ogg"), str(chat), chat, prefix=caption)

    def send_voice(self, ogg: bytes) -> bool:
        if not self.chat:
            return False
        body, ctype = _host_multipart({"chat_id": self.chat}, [("voice", "odpowiedz.ogg", "audio/ogg", ogg)])
        req = urllib.request.Request(f"{self.api}/bot{self.cfg.get('token')}/sendVoice", data=body,
                                     headers={"Content-Type": ctype, "User-Agent": "codo-host"}, method="POST")
        with urllib.request.urlopen(req, timeout=60) as r:  # nosec B310 — adres API Telegrama
            r.read()
        return True

    def answer_cb(self, cb_id: str, text: str) -> None:
        try:
            self._call("answerCallbackQuery", {"callback_query_id": cb_id, "text": text[:180]}, timeout=10)
        except (OSError, ValueError):
            pass


class HostTelegramShared(HostChat):
    """Telegram przez wspólnego bota Codo (24.11.2026): na serwerze nie ma tokena bota. Wiadomości i naciśnięcia
    przycisków czekają w skrzynce konta w DomaAI (long-poll /cli/kanal/telegram/odbierz), odpowiedzi idą przez
    /wyslij. Logowanie urządzeniem Codo z device.json, jak WhatsApp. Czat paruje DomaAI, więc wszystko ze skrzynki
    jest od właściciela. Skrzynkę czyta naraz jedno miejsce: Mac oddaje ją serwerowi plikiem telegram.json
    {"mode": "shared", "cursor": N} i sam przestaje ją czytać.

    Kursor (ostatnia obsłużona wiadomość) leży w telegram-kursor.json: po restarcie nic nie wraca drugi raz,
    a to, co skrzynka poda ponownie (dostawa co najmniej raz), odpada po numerze.

    Jeden czytelnik (25.11.2026): gospodarz przedstawia się DomaAI stałym identyfikatorem („kto”, w tym samym pliku
    co kursor). Mac przy każdym oddaniu wpisuje do telegram.json nowe "handed": wtedy gospodarz pierwszym pytaniem
    przejmuje skrzynkę wprost. Gdy DomaAI odpowie, że skrzynkę czyta kto inny (Mac ją zabrał), gospodarz kończy
    Telegram („lost” = "taken"), zamiast czytać na wyścigi.

    Głos: wiadomość `glos` gospodarz pobiera z DomaAI (/plik/{id}) i odsłuchuje jak głosówkę z własnego bota;
    odpowiedź idzie tekstem (wspólny bot nie wysyła nagrań)."""

    name, title, where_word = "telegram", "Telegram", "na Telegramie"
    relayed = True               # właściciela zna DomaAI: bez kodu parowania i bez sprawdzania czatu
    hears = True
    limit = 39000                # na części po 4000 znaków dzieli DomaAI
    wait = 25                    # sekundy jednego czekania na skrzynkę
    pause = 3                    # pierwsza przerwa po błędzie (rośnie do minuty)
    CURSOR_FILE = "telegram-kursor.json"
    _BOX = "/cli/kanal/telegram"

    def __init__(self, cfg: dict, events_q):
        super().__init__(cfg, events_q)
        saved = _host_load(self.CURSOR_FILE, {})
        saved = saved if isinstance(saved, dict) else {}
        self.cursor = max(self._int(saved.get("cursor")), self._int(cfg.get("cursor")))
        self.kto = str(saved.get("kto") or "")
        if not re.match(r"^[A-Za-z0-9_-]{8,64}$", self.kto):
            import secrets
            self.kto = "serwer-" + secrets.token_hex(8)
        self.claimed = str(saved.get("claimed") or "")
        handed = str(cfg.get("handed") or "")
        self.claim = bool(handed) and handed != self.claimed    # nowe oddanie z Maca: przejmij wprost
        self.asked: dict = {}    # id wiadomości z przyciskami → jej tekst (po decyzji wraca z dopiskiem, bez przycisków)
        self.ended = False       # pętla skończona na dobre (odparowane urządzenie albo funkcja wyłączona)
        self.lost = ""           # dlaczego skończona: signedout | off | taken (skrzynkę czyta kto inny); "" = działa
        self._save_cursor()

    def _save_cursor(self) -> None:
        _host_save(self.CURSOR_FILE, {"cursor": self.cursor, "kto": self.kto, "claimed": self.claimed})

    def mine(self, who, where) -> bool:
        return True              # czat paruje DomaAI: wszystko ze skrzynki jest od właściciela

    @staticmethod
    def _int(v) -> int:
        try:
            return max(0, int(v or 0))
        except (TypeError, ValueError):
            return 0

    @property
    def paired(self) -> bool:
        return not self.ended

    @property
    def chat(self):
        return None if self.ended else "owner"

    @property
    def voice_mode(self) -> str:
        return "off"             # wspólny bot odsłuchuje głos, ale odpowiada tylko tekstem

    def _token(self, force: bool = False) -> str:
        try:
            tok = device_access_token(force=force)
        except SystemExit:
            raise ApiError(401, "urządzenie odparowane") from None
        if not tok:
            raise ApiError(401, "brak urządzenia")
        return tok

    def _request(self, method: str, path: str, body: dict | None = None, timeout: float = 30) -> dict:
        """Jedno żądanie tokenem urządzenia (po 401 raz z nowym tokenem). Błąd niesie nagłówek X-Doma-Kod."""
        def once(tok: str) -> dict:
            headers = {"User-Agent": f"doma-cli/{VERSION}", "X-Codo": VERSION, "Accept": "application/json",
                       "Authorization": f"Bearer {tok}"}
            if body is not None:
                headers["Content-Type"] = "application/json"
            req = urllib.request.Request(f"{API_URL}{path}", data=None if body is None else json.dumps(body).encode(),
                                         headers=headers, method=method)
            try:
                with urllib.request.urlopen(req, timeout=timeout, context=_ssl_ctx()) as resp:  # nosec B310 — adres API DomaAI
                    out = json.loads(resp.read().decode() or "{}")
                return out if isinstance(out, dict) else {}
            except urllib.error.HTTPError as e:
                raw = e.read().decode(errors="replace")
                try:
                    payload = json.loads(raw)
                    detail = payload.get("detail", raw) if isinstance(payload, dict) else raw
                except ValueError:
                    payload, detail = {}, raw
                raise ApiError(e.code, detail, payload, kod=str(e.headers.get("X-Doma-Kod") or "")) from None
        try:
            return once(self._token())
        except ApiError as e:
            if e.status != 401:
                raise
        return once(self._token(force=True))

    def _nap(self, seconds: float) -> None:
        import time
        end = time.time() + seconds
        while not self.stop_flag and time.time() < end:
            time.sleep(min(0.2, max(0.0, end - time.time())))

    def _closed(self, e: ApiError) -> bool:
        """Błąd, po którym nie ma po co próbować dalej. Agenci pracują bez zmian; gospodarz spróbuje znowu po `reload`."""
        if e.status == 401:
            self._note("DomaAI nie przyjmuje urządzenia Codo z tego serwera (odparowane albo wylogowane). Telegram przez "
                       "wspólnego bota jest tu wyłączony, agenci pracują dalej. Zaloguj się w Codo na Macu i przenieś "
                       "agentów na serwer jeszcze raz.")
            self.lost = "signedout"
        elif (e.status == 503 and e.kod == "WYLACZONE") or e.status in (404, 405):
            self.problem = "Telegram przez wspólnego bota jest wyłączony w DomaAI."   # po cichu: to nie awaria
            self.lost = "off"
        else:
            return False
        self.ended = True
        return True

    def _taken(self, by: str) -> None:
        """DomaAI mówi, że skrzynkę czyta kto inny (Mac ją zabrał): koniec czytania tutaj, bez wyścigu."""
        self._note(f"Skrzynkę Telegrama czyta teraz {by or 'inne urządzenie'}. Tutaj Telegram przez wspólnego bota "
                   "jest wyłączony, agenci pracują dalej.")
        self.lost = "taken"
        self.ended = True

    def _loop(self) -> None:
        pause = self.pause
        try:
            while not self.stop_flag and not self.ended:
                try:
                    q = f"po={self.cursor}&czekaj={int(self.wait)}&kto={self.kto}&nazwa=serwer" + ("&przejmij=true" if self.claim else "")
                    j = self._request("GET", f"{self._BOX}/odbierz?{q}", timeout=self.wait + 15)
                    if self.stop_flag:
                        return       # skrzynka wróciła na Maca: nic stąd nie bierzemy, kursor stoi
                    if j.get("zajete"):
                        self._taken(str(j.get("odbiorca") or ""))
                        return
                    if self.claim:
                        self.claim, self.claimed = False, str(self.cfg.get("handed") or "")
                        self._save_cursor()
                    if self.problem.startswith(("DomaAI chwilowo", "Brak połączenia")):
                        self.problem = ""
                    pause = self.pause
                    for m in j.get("wiadomosci") or []:
                        if isinstance(m, dict):
                            self._handle(m)
                except ApiError as e:
                    if self._closed(e):
                        return
                    self._note(f"DomaAI chwilowo nie podaje skrzynki Telegrama ({e.status}).")
                    self._nap(pause)
                    pause = min(pause * 2, 60)
                except (OSError, ValueError):
                    self.problem = "Brak połączenia z DomaAI. Codo próbuje dalej."
                    self._nap(pause)
                    pause = min(pause * 2, 60)
        finally:
            if not self.stop_flag:
                self.ended = True

    def _handle(self, m: dict) -> None:
        mid = self._int(m.get("id"))
        if mid <= self.cursor:
            return                   # już obsłużone: skrzynka podaje co najmniej raz
        kind = str(m.get("rodzaj") or "")
        text = str(m.get("tekst") or "").strip()
        if kind == "przycisk":
            msg = self._int(m.get("wiadomosc_id"))
            self.emit(button=str(m.get("dane") or ""), who="owner", where="owner", ack=lambda t, msg=msg: self.decided(msg, t))
        elif kind == "tekst":
            if text:
                self.emit(text=text, who="owner", where="owner")
        elif kind == "glos":
            data, mime = self.recording(mid)
            if data:
                self.heard(data, mime, "owner", "owner", prefix=text)
            else:
                self.send("Nie udało się pobrać wiadomości głosowej. Spróbuj jeszcze raz albo napisz tekstem.")
        else:
            self.send("Przez wspólnego bota Codo czyta tekst i wiadomości głosowe. Napisz albo nagraj, co zrobić.")
        self.cursor = mid
        self._save_cursor()

    def recording(self, mid: int) -> tuple:
        """Nagranie wiadomości `glos` z DomaAI (bajty idą przez serwer DomaAI, token bota zostaje tam): (bajty, typ)."""
        import base64
        try:
            j = self._request("GET", f"{self._BOX}/plik/{mid}", timeout=90)
            data = base64.b64decode(str(j.get("dane") or ""), validate=True)
        except ApiError as e:
            if e.status != 404:          # 404 = tego nagrania już nie ma; skrzynka działa dalej
                self._closed(e)
            return b"", ""
        except (OSError, ValueError):
            return b"", ""
        if not data or len(data) > _HOST_VOICE_MAX:
            return b"", ""
        return data, str(j.get("typ") or "audio/ogg")

    def send(self, text: str, buttons: list | None = None) -> bool:
        if self.ended or self.stop_flag or not str(text).strip():
            return False
        body = _host_plain(text)[:self.limit]
        rows = [[{"tytul": str(t)[:60], "dane": str(d)} for t, d in row if d and len(str(d).encode()) <= 64] for row in buttons or []]
        rows = [r for r in rows if r]
        try:
            r = self._request("POST", f"{self._BOX}/wyslij", {"tekst": body, "przyciski": rows}, timeout=30)
        except ApiError as e:
            if not self._closed(e):
                self._note(f"Telegram nie przyjął wiadomości ({e.status}).")
            return False
        except (OSError, ValueError):
            return False
        if r.get("ok") is False:
            self._note("Czat na Telegramie nie jest już połączony z kontem (odłączony albo bot zablokowany). "
                       "Połącz go ponownie w Codo na Macu.")
            return False
        ids = [self._int(i) for i in r.get("wiadomosci") or []]
        if rows and len(ids) == 1 and ids[0]:
            self.asked[ids[0]] = body
            for old in list(self.asked)[:-60]:
                self.asked.pop(old, None)
        return True

    def decided(self, msg: int, note: str) -> None:
        """Po naciśnięciu: przyciski znikają, a decyzja zostaje pod pytaniem (albo osobno, gdy pytania już nie pamiętamy)."""
        old = self.asked.pop(msg, None) if msg else None
        if msg and not self.ended:
            try:
                self._request("POST", f"{self._BOX}/wyslij",
                              {"tekst": (old + "\n\n→ " + note) if old else "", "przyciski": [], "edytuj": msg}, timeout=20)
            except ApiError as e:
                self._closed(e)
                old = None
            except (OSError, ValueError):
                old = None
        if not old:
            self.send("→ " + note)


class HostDiscord(HostChat):
    """Bot Discorda użytkownika przez bramę (WebSocket): wiadomości prywatne i wzmianki, zgody przyciskami.
    Bez uprzywilejowanych intencji: Discord daje botowi treść wiadomości prywatnych i tych, które go wołają."""
    hears = speaks = True

    name, title, where_word = "discord", "Discord", "na Discordzie"
    limit = 1900

    def __init__(self, cfg: dict, events_q):
        super().__init__(cfg, events_q)
        self.api = (os.environ.get("CODO_DISCORD_API") or "https://discord.com/api/v10").rstrip("/")
        self.gateway = os.environ.get("CODO_DISCORD_GATEWAY") or "wss://gateway.discord.gg/?v=10&encoding=json"
        self.me = str(cfg.get("bot_id") or "")
        self.ws = None

    def rest(self, method: str, path: str, body: dict | None = None, timeout: float = 20) -> dict:
        return self._json(self.api + path, body, headers={"Authorization": "Bot " + str(self.cfg.get("token") or "")},
                          method=method, timeout=timeout)

    def _loop(self) -> None:
        import time
        pause = 3
        while not self.stop_flag:
            try:
                self._session()
                pause = 3
            except urllib.error.HTTPError as e:
                self._note(f"Discord odrzucił połączenie ({e.code}).")
            except (OSError, ValueError) as e:
                if "4004" in str(e):
                    self._note("Discord nie przyjął tokenu bota. Skopiuj go jeszcze raz w Codo.")
                    pause = 60
            if self.stop_flag:
                break
            time.sleep(pause)
            pause = min(pause * 2, 60)

    def _session(self) -> None:
        import time
        ws = self.ws = _HostWS(self.gateway)
        seq = {"n": None}
        hello = json.loads(ws.recv(timeout=30) or "{}")
        every = float(((hello.get("d") or {}).get("heartbeat_interval") or 41250)) / 1000.0
        ws.send(json.dumps({"op": 2, "d": {"token": self.cfg.get("token"), "intents": 512 | 4096,
                                           "properties": {"os": sys.platform, "browser": "codo", "device": "codo"}}}))
        alive = {"on": True}

        def beat() -> None:
            while alive["on"] and not self.stop_flag and not ws.closed:
                time.sleep(every)
                try:
                    ws.send(json.dumps({"op": 1, "d": seq["n"]}))
                except OSError:
                    return
        threading.Thread(target=beat, daemon=True).start()
        try:
            while not self.stop_flag:
                raw = ws.recv(timeout=every * 2 + 10)
                if raw is None:
                    raise OSError("brama zamknęła połączenie")
                m = json.loads(raw)
                if m.get("s") is not None:
                    seq["n"] = m["s"]
                op = m.get("op")
                if op in (7, 9):
                    return            # brama prosi o nowe połączenie
                if op == 1:
                    ws.send(json.dumps({"op": 1, "d": seq["n"]}))
                if op != 0:
                    continue
                self._dispatch(str(m.get("t") or ""), m.get("d") or {})
        finally:
            alive["on"] = False
            ws.close()

    def _dispatch(self, t: str, d: dict) -> None:
        if t == "READY":
            self.me = str((d.get("user") or {}).get("id") or self.me)
            self.problem = ""
        elif t == "MESSAGE_CREATE":
            author = d.get("author") or {}
            if author.get("bot"):
                return
            text = str(d.get("content") or "")
            if d.get("guild_id"):
                if not any(str(u.get("id")) == self.me for u in d.get("mentions") or []):
                    return
            text = re.sub(r"<@!?\d+>", "", text).strip()
            audio = next((a for a in d.get("attachments") or [] if str(a.get("content_type") or "").startswith("audio/")
                          and a.get("url")), None)
            if audio:
                # pobieranie i transkrypcja poza wątkiem bramy, żeby nie przegapić pulsu
                threading.Thread(target=self.voice_in, args=(audio, str(author.get("id")), str(d.get("channel_id")), text),
                                 daemon=True).start()
            elif text:
                self.emit(text=text, who=str(author.get("id")), where=str(d.get("channel_id")))
        elif t == "INTERACTION_CREATE" and int(d.get("type") or 0) == 3:
            user = (d.get("member") or {}).get("user") or d.get("user") or {}
            iid, tok = str(d.get("id")), str(d.get("token"))
            before = str((d.get("message") or {}).get("content") or "")

            def ack(text: str, iid=iid, tok=tok, before=before) -> None:
                try:
                    self.rest("POST", f"/interactions/{iid}/{tok}/callback",
                              {"type": 7, "data": {"content": (before + "\n\n→ " + text)[:1990], "components": []}})
                except (OSError, ValueError):
                    pass
            self.emit(button=str((d.get("data") or {}).get("custom_id") or ""), who=str(user.get("id")),
                      where=str(d.get("channel_id")), ack=ack)

    def voice_in(self, att: dict, who: str, where: str, caption: str = "") -> None:
        if not self.mine(who, where):
            return
        try:
            if int(att.get("size") or 0) > _HOST_VOICE_MAX:
                raise ValueError("za duże")
            req = urllib.request.Request(str(att["url"]), headers={"User-Agent": "DiscordBot (https://domaai.pl, 1.0)"})
            with urllib.request.urlopen(req, timeout=60) as r:  # nosec B310 — załącznik z CDN Discorda
                data = r.read(_HOST_VOICE_MAX + 1)
        except (OSError, ValueError, KeyError):
            self.send("Nie udało się pobrać wiadomości głosowej z Discorda. Spróbuj jeszcze raz albo napisz tekstem.")
            return
        self.heard(data, str(att.get("content_type") or "audio/ogg").split(";")[0], who, where, prefix=caption)

    def send_voice(self, ogg: bytes) -> bool:
        where = self._target()
        if not where:
            return False
        payload = json.dumps({"attachments": [{"id": 0, "filename": "odpowiedz.ogg"}]})
        body, ctype = _host_multipart({"payload_json": payload}, [("files[0]", "odpowiedz.ogg", "audio/ogg", ogg)])
        req = urllib.request.Request(f"{self.api}/channels/{where}/messages", data=body, method="POST",
                                     headers={"Content-Type": ctype, "Authorization": "Bot " + str(self.cfg.get("token") or ""),
                                              "User-Agent": "DiscordBot (https://domaai.pl, 1.0)"})
        with urllib.request.urlopen(req, timeout=60) as r:  # nosec B310 — adres API Discorda
            r.read()
        return True

    def _target(self):
        if self.cfg.get("chat"):
            return self.cfg["chat"]
        if self.cfg.get("owner"):
            try:
                self.cfg["chat"] = str(self.rest("POST", "/users/@me/channels", {"recipient_id": self.cfg["owner"]}).get("id") or "") or None
            except (OSError, ValueError):
                return None
        return self.cfg.get("chat")

    def send(self, text: str, buttons: list | None = None) -> bool:
        where = self._target()
        if not where or not str(text).strip():
            return False
        ok = True
        parts = self.parts(text)
        for i, part in enumerate(parts):
            body: dict = {"content": part}
            if buttons and i == len(parts) - 1:
                body["components"] = [{"type": 1, "components": [
                    {"type": 2, "style": 4 if d.startswith(("an|", "n|")) else 1, "label": t[:80], "custom_id": d[:100]}
                    for t, d in row[:5]]} for row in buttons[:5]]
            try:
                self.rest("POST", f"/channels/{where}/messages", body)
            except (OSError, ValueError):
                ok = False
        return ok


class HostSlack(HostChat):
    """Aplikacja Slacka użytkownika w trybie Socket Mode: bez publicznego adresu na serwerze."""

    name, title, where_word = "slack", "Slack", "na Slacku"
    limit = 2900

    def __init__(self, cfg: dict, events_q):
        super().__init__(cfg, events_q)
        self.api = (os.environ.get("CODO_SLACK_API") or "https://slack.com/api").rstrip("/")
        self.me = str(cfg.get("bot_user") or "")
        self.seen: list = []

    def call(self, method: str, body: dict, app: bool = False, timeout: float = 20) -> dict:
        tok = self.cfg.get("app_token") if app else self.cfg.get("bot_token")
        r = self._json(f"{self.api}/{method}", body, headers={"Authorization": f"Bearer {tok}"}, timeout=timeout)
        if not r.get("ok", False):
            raise ValueError(str(r.get("error") or "slack"))
        return r

    def _loop(self) -> None:
        import time
        pause = 3
        while not self.stop_flag:
            try:
                url = self.call("apps.connections.open", {}, app=True).get("url")
                if not url:
                    raise ValueError("brak adresu")
                self._session(url)
                pause = 3
            except ValueError as e:
                if str(e) in ("invalid_auth", "not_authed", "account_inactive", "token_revoked"):
                    self._note("Slack nie przyjął tokenów aplikacji. Połącz Slacka jeszcze raz w Codo.")
                    pause = 60
            except OSError:
                pass
            if self.stop_flag:
                break
            time.sleep(pause)
            pause = min(pause * 2, 60)

    def _session(self, url: str) -> None:
        ws = _HostWS(url)
        try:
            while not self.stop_flag:
                raw = ws.recv(timeout=120)
                if raw is None:
                    return
                m = json.loads(raw)
                if m.get("envelope_id"):
                    ws.send(json.dumps({"envelope_id": m["envelope_id"]}))
                kind = m.get("type")
                if kind == "hello":
                    self.problem = ""
                elif kind == "disconnect":
                    return
                elif kind == "events_api":
                    self._event(((m.get("payload") or {}).get("event")) or {})
                elif kind == "interactive":
                    self._action(m.get("payload") or {})
        finally:
            ws.close()

    def _event(self, e: dict) -> None:
        if e.get("bot_id") or e.get("subtype") or str(e.get("user") or "") == self.me:
            return
        key = str(e.get("client_msg_id") or e.get("ts") or "")
        if key in self.seen:
            return                # ta sama wiadomość jako message.im i app_mention
        self.seen = (self.seen + [key])[-200:]
        if e.get("type") == "message" and e.get("channel_type") != "im":
            return
        if e.get("type") not in ("message", "app_mention"):
            return
        text = re.sub(r"<@[A-Z0-9]+>", "", str(e.get("text") or "")).strip()
        if text:
            self.emit(text=text, who=str(e.get("user")), where=str(e.get("channel")))

    def _action(self, p: dict) -> None:
        if p.get("type") != "block_actions":
            return
        acts = p.get("actions") or []
        if not acts:
            return
        url = str(p.get("response_url") or "")
        before = str((p.get("message") or {}).get("text") or "")

        def ack(text: str, url=url, before=before) -> None:
            if not url:
                return
            try:
                self._json(url, {"replace_original": True, "text": (before + "\n\n→ " + text)[:2900]})
            except (OSError, ValueError):
                pass
        self.emit(button=str(acts[0].get("value") or acts[0].get("action_id") or ""), who=str((p.get("user") or {}).get("id")),
                  where=str((p.get("channel") or {}).get("id")), ack=ack)

    def _target(self):
        if self.cfg.get("chat"):
            return self.cfg["chat"]
        if self.cfg.get("owner"):
            try:
                self.cfg["chat"] = str((self.call("conversations.open", {"users": self.cfg["owner"]}).get("channel") or {}).get("id") or "") or None
            except (OSError, ValueError):
                return None
        return self.cfg.get("chat")

    def send(self, text: str, buttons: list | None = None) -> bool:
        where = self._target()
        if not where or not str(text).strip():
            return False
        ok = True
        parts = self.parts(text)
        for i, part in enumerate(parts):
            body: dict = {"channel": where, "text": part}
            if buttons and i == len(parts) - 1:
                body["blocks"] = [{"type": "section", "text": {"type": "plain_text", "text": part}},
                                  {"type": "actions", "elements": [
                                      {"type": "button", "text": {"type": "plain_text", "text": t[:75]}, "value": d[:2000],
                                       "action_id": f"codo{n}", **({"style": "danger"} if d.startswith(("an|", "n|")) else {})}
                                      for n, (t, d) in enumerate([b for row in buttons for b in row][:5])]}]
            try:
                self.call("chat.postMessage", body)
            except (OSError, ValueError):
                ok = False
        return ok


class HostWhatsApp(HostChat):
    """WhatsApp na własnym numerze użytkownika, przez skrzynkę DomaAI (urządzenie Codo z device.json).
    Numer i właściciela paruje DomaAI, więc każda wiadomość ze skrzynki jest od właściciela."""

    name, title, where_word = "whatsapp", "WhatsApp", "na WhatsAppie"

    def __init__(self, cfg: dict, events_q):
        super().__init__(cfg, events_q)
        self.numbered: list = []

    @property
    def paired(self) -> bool:
        return True

    @property
    def chat(self):
        return "owner"

    def _api(self, path: str, body: dict) -> dict:
        try:
            return api_call(None, path, body)
        except SystemExit:
            raise ValueError("urządzenie odparowane") from None

    def _loop(self) -> None:
        import time
        pause = 3
        while not self.stop_flag:
            try:
                j = self._api("/cli/roje/skrzynka/odbierz", {"czekaj": 20})
                self.problem = ""
                pause = 3
                for m in j.get("wiadomosci") or []:
                    self._handle(m)
            except ApiError as e:
                self._note("WhatsApp dla Codo jest jeszcze wyłączony w DomaAI." if e.status in (404, 503)
                           else f"DomaAI odrzuciło skrzynkę WhatsApp ({e.status}).")
                time.sleep(60 if e.status in (401, 403, 404, 503) else pause)
                pause = min(pause * 2, 60)
            except (OSError, ValueError) as e:
                if "odparowane" in str(e):
                    self._note("Urządzenie Codo na serwerze zostało odparowane od konta DomaAI.")
                    return
                time.sleep(pause)
                pause = min(pause * 2, 60)

    def _handle(self, m: dict) -> None:
        button = str(m.get("przycisk") or "")
        text = str(m.get("tekst") or "").strip()
        if not button and text.isdigit() and 1 <= int(text) <= len(self.numbered):
            button, self.numbered = self.numbered[int(text) - 1], []
        if button:
            self.emit(button=button, who="owner", where="owner", ack=lambda t: self.send("→ " + t))
        elif text.startswith("[") and text.endswith("]") and " " not in text:
            self.send("Na razie Codo czyta tylko tekst. Napisz, co zrobić.")
        elif text:
            self.emit(text=text, who="owner", where="owner")

    def send(self, text: str, buttons: list | None = None) -> bool:
        if not str(text).strip():
            return False
        flat = [b for row in (buttons or []) for b in row]
        body_text, send = text, []
        if len(flat) > 3:
            self.numbered = [d for _, d in flat]
            body_text += "\n\n" + "\n".join(f"{i + 1}. {t}" for i, (t, _) in enumerate(flat)) + "\n\nOdpowiedz numerem."
        else:
            send = [{"id": d[:200], "tytul": t[:20]} for t, d in flat]
        ok = True
        parts = self.parts(body_text)
        for i, part in enumerate(parts):
            try:
                r = self._api("/cli/roje/skrzynka/wyslij", {"tekst": part, "przyciski": send if i == len(parts) - 1 else []})
                ok = ok and r.get("ok", True) is not False
                if r.get("powod") == "okno_24h":
                    self._note("WhatsApp pozwala odpisać tylko w ciągu 24 godzin od Twojej ostatniej wiadomości. Napisz coś do Codo.")
            except (OSError, ValueError):
                ok = False
        return ok


class HostSignal(HostChat):
    """Signal przez signal-cli w trybie JSON-RPC (stdin/stdout, linia JSON na wiadomość) na numerze bota użytkownika.
    signal-cli instaluje i rejestruje użytkownik; Codo tylko go uruchamia i rozmawia z nim."""
    hears = speaks = True

    name, title, where_word = "signal", "Signal", "na Signalu"

    def __init__(self, cfg: dict, events_q):
        self.proc = None
        super().__init__(cfg, events_q)
        self.lock = threading.Lock()
        self.n = 0

    @property
    def stop_flag(self) -> bool:
        return getattr(self, "_stop", False)

    @stop_flag.setter
    def stop_flag(self, value: bool) -> None:
        self._stop = bool(value)
        p = getattr(self, "proc", None)
        if value and p is not None and p.poll() is None:
            try:
                p.terminate()
            except OSError:
                pass

    @property
    def chat(self):
        return self.cfg.get("owner") or self.cfg.get("chat")

    def _nap(self, secs: float) -> None:
        import time
        end = time.time() + secs
        while not self.stop_flag and time.time() < end:
            time.sleep(min(0.2, max(0.01, end - time.time())))

    def _cli(self) -> str:
        import shutil
        c = str(self.cfg.get("cli") or "").strip()
        if c:
            c = os.path.expanduser(c)
            return c if os.path.isfile(c) and os.access(c, os.X_OK) else (shutil.which(c) or "")
        return shutil.which("signal-cli") or ""

    def _loop(self) -> None:
        import time
        while not self.stop_flag:
            number = str(self.cfg.get("number") or "").strip()
            cli = self._cli()
            if not cli:
                self._note("Nie ma signal-cli na serwerze. Zainstaluj signal-cli i zarejestruj numer: "
                           f"signal-cli -a {number or '+48…'} register, potem signal-cli -a {number or '+48…'} verify KOD.")
                self._nap(60)
                continue
            began = time.time()
            err = self._session(cli, number)
            if self.stop_flag:
                break
            if time.time() - began < 20:
                low = err.lower()
                if any(w in low for w in ("not registered", "unregistered", "no such account", "not found", "specified account does not exist")):
                    self._note(f"Numer {number} nie jest zarejestrowany w signal-cli. Zarejestruj go: signal-cli -a {number} register, "
                               f"potem signal-cli -a {number} verify KOD.")
                else:
                    last = (err.strip().splitlines() or [""])[-1][:200]
                    self._note("signal-cli nie wystartował" + (f": {last}" if last else ".") )
                self._nap(60)
            else:
                self._nap(5)

    def _session(self, cli: str, number: str) -> str:
        cmd = [cli] + (["--config", os.path.expanduser(str(self.cfg["config"]))] if self.cfg.get("config") else []) + ["-a", number, "jsonRpc"]
        try:
            p = subprocess.Popen(cmd, stdin=subprocess.PIPE, stdout=subprocess.PIPE, stderr=subprocess.PIPE,
                                 text=True, encoding="utf-8", errors="replace", bufsize=1)
        except OSError as e:
            return str(e)
        self.proc = p
        err: list = []
        threading.Thread(target=lambda: err.extend(p.stderr), daemon=True).start()

        def healthy() -> None:
            self._nap(8)
            if p.poll() is None and self.proc is p:
                self.problem = ""
        threading.Thread(target=healthy, daemon=True).start()
        try:
            for line in p.stdout:
                if self.stop_flag:
                    break
                try:
                    m = json.loads(line)
                except ValueError:
                    continue
                if isinstance(m, dict) and m.get("method") == "receive":
                    self._receive(m.get("params") or {})
                elif isinstance(m, dict) and m.get("error"):
                    print(f"[signal] {str((m.get('error') or {}).get('message') or m['error'])[:200]}", file=sys.stderr, flush=True)
        finally:
            try:
                p.wait(timeout=5)
            except subprocess.TimeoutExpired:
                p.kill()
        import time
        time.sleep(0.1)          # stderr dociera chwilę po zamknięciu stdout
        return "".join(err)

    def _receive(self, params: dict) -> None:
        env = params.get("envelope") if isinstance(params.get("envelope"), dict) else params
        who = str(env.get("sourceNumber") or env.get("source") or "")
        dm = env.get("dataMessage") or {}
        if not who or not isinstance(dm, dict) or dm.get("groupInfo") or dm.get("groupV2"):
            return                # grupy pomijamy: Codo rozmawia tylko z właścicielem
        text = str(dm.get("message") or "").strip()
        audio = next((a for a in dm.get("attachments") or [] if str(a.get("contentType") or "").startswith("audio/")), None)
        if audio:
            threading.Thread(target=self.voice_in, args=(audio, who, text), daemon=True).start()
            return
        button = self.pick(text) if self.mine(who, who) else None
        if button:
            self.emit(button=button, who=who, where=who, ack=lambda t: self.send("→ " + t))
        elif text:
            self.emit(text=text, who=who, where=who)

    def _attachment_path(self, att: dict) -> Path:
        stored = str(att.get("storedFilename") or "")
        if stored and os.path.isabs(stored):
            return Path(stored)
        base = self.cfg.get("attachments") or (os.path.join(str(self.cfg["config"]), "attachments") if self.cfg.get("config")
                                               else "~/.local/share/signal-cli/attachments")
        return Path(os.path.expanduser(str(base))) / (stored or str(att.get("id") or ""))

    def voice_in(self, att: dict, who: str, caption: str = "") -> None:
        import time
        if not self.mine(who, who):
            return
        path = self._attachment_path(att)
        for _ in range(25):           # signal-cli może dopisywać plik chwilę po powiadomieniu
            if path.is_file():
                break
            time.sleep(0.2)
        try:
            data = path.read_bytes() if path.is_file() and path.stat().st_size <= _HOST_VOICE_MAX else b""
        except OSError:
            data = b""
        if not data:
            self.send("Nie udało się odczytać wiadomości głosowej z Signala. Napisz tekstem.")
            return
        self.heard(data, str(att.get("contentType") or "audio/aac"), who, who, prefix=caption)

    def _rpc(self, method: str, params: dict) -> bool:
        p = self.proc
        if p is None or p.poll() is not None or p.stdin is None:
            return False
        with self.lock:
            self.n += 1
            try:
                p.stdin.write(json.dumps({"jsonrpc": "2.0", "method": method, "params": params, "id": self.n}, ensure_ascii=False) + "\n")
                p.stdin.flush()
                return True
            except (OSError, ValueError):
                return False

    def send(self, text: str, buttons: list | None = None) -> bool:
        to = self.chat
        if not to or not str(text).strip():
            return False
        ok = True
        for part in self.parts(self.numbered_text(text, buttons) if buttons else text):
            ok = self._rpc("send", {"recipient": [str(to)], "message": part}) and ok
        return ok

    def send_voice(self, ogg: bytes) -> bool:
        import time
        to = self.chat
        if not to:
            return False
        folder = HOST_DIR / "glos"
        folder.mkdir(parents=True, exist_ok=True)
        for old in folder.glob("*.ogg"):
            try:
                if time.time() - old.stat().st_mtime > 3600:
                    old.unlink()
            except OSError:
                pass
        path = folder / f"odpowiedz-{_host_key()}.ogg"
        path.write_bytes(ogg)
        os.chmod(path, 0o600)
        return self._rpc("send", {"recipient": [str(to)], "message": "", "attachments": [str(path)]})


_MAIL_MONTHS = ("Jan", "Feb", "Mar", "Apr", "May", "Jun", "Jul", "Aug", "Sep", "Oct", "Nov", "Dec")


def _host_mail_text(msg) -> str:
    """Treść maila bez cytowanej historii: część text/plain (albo HTML na tekst), bez linii „>” i od „W dniu … napisał”."""
    import html as _html
    try:
        part = msg.get_body(preferencelist=("plain", "html"))
    except (AttributeError, KeyError):
        part = None
    if part is None:
        return ""
    try:
        t = part.get_content()
    except (LookupError, ValueError, AttributeError):
        t = (part.get_payload(decode=True) or b"").decode("utf-8", "replace")
    if part.get_content_type() == "text/html":
        t = re.sub(r"(?is)<(script|style)\b.*?</\1>", "", t)
        t = re.sub(r"(?is)<blockquote\b.*?</blockquote>", "", t)
        t = re.sub(r"(?i)<br\s*/?>|</p>|</div>", "\n", t)
        t = _html.unescape(re.sub(r"<[^>]+>", "", t))
    lines = str(t).replace("\r\n", "\n").split("\n")
    out = []
    for i, ln in enumerate(lines):
        s = ln.strip()
        nxt = lines[i + 1].strip() if i + 1 < len(lines) else ""
        if ln.rstrip() == "--" or ln == "-- ":
            break                         # podpis
        if re.match(r"(?i)^(W dniu|Dnia)\b", s) and ("napisał" in s or "napisał" in nxt or s.endswith(":") or nxt.endswith(":")):
            break
        if re.match(r"^On\b", s) and ("wrote" in s or "wrote" in nxt):
            break
        if re.match(r"(?i)^-{2,}\s*(original message|oryginalna wiadomość|wiadomość oryginalna|forwarded message)", s) or re.match(r"^_{8,}$", s):
            break
        if s.startswith(">"):
            continue
        out.append(ln.rstrip())
    return re.sub(r"\n{3,}", "\n\n", "\n".join(out)).strip()


class HostEmail(HostChat):
    """Poczta: IMAP (odpytywanie, tylko nieprzeczytane) i SMTP. Przyjmuje WYŁĄCZNIE maile od adresu właściciela;
    cudzych nie oznacza jako przeczytane i na nie nie odpisuje. Parowanie: pierwszy mail z kodem ustawia właściciela."""
    speaks = True

    name, title, where_word = "email", "E-mail", "w mailu"
    limit = 60000

    def __init__(self, cfg: dict, events_q):
        super().__init__(cfg, events_q)
        self.last: dict = {}          # ostatni mail właściciela: odpowiadamy w jego wątku
        self.skip: set = set()        # cudze maile, których już nie czytamy

    @property
    def chat(self):
        return self.cfg.get("owner") or None

    @property
    def paired(self) -> bool:
        return bool(self.cfg.get("owner"))

    def _addr(self) -> str:
        return str(self.cfg.get("from") or self.cfg.get("user") or "")

    def _nap(self, secs: float) -> None:
        import time
        end = time.time() + secs
        while not self.stop_flag and time.time() < end:
            time.sleep(min(0.2, max(0.01, end - time.time())))

    def _imap(self):
        import imaplib
        host, port = str(self.cfg.get("imap_host") or ""), int(self.cfg.get("imap_port") or 993)
        if port == 143:
            m = imaplib.IMAP4(host, port, timeout=30)
            m.starttls()
        else:
            m = imaplib.IMAP4_SSL(host, port, timeout=30)
        m.login(str(self.cfg.get("user") or ""), str(self.cfg.get("password") or ""))
        return m

    def _loop(self) -> None:
        import imaplib
        while not self.stop_flag:
            try:
                m = self._imap()
                was = self.problem
                self.problem = ""
                try:
                    self.poll(m)        # może zgłosić niepotwierdzonego nadawcę: to zostaje widoczne
                finally:
                    try:
                        m.logout()
                    except (OSError, imaplib.IMAP4.error):
                        pass
                if not self.problem and "nie potwierdza nadawcy" in (was or ""):
                    self.problem = was  # ostrzeżenie trzyma się, póki nie przyjdzie potwierdzony mail
            except imaplib.IMAP4.error:
                self._note("Serwer poczty nie przyjął logowania IMAP. Sprawdź użytkownika i hasło (często potrzebne jest hasło do aplikacji).")
            except (OSError, ValueError):
                self._note(f"Nie mogę połączyć się z serwerem poczty {self.cfg.get('imap_host')}.")
            self._nap(float(self.cfg.get("interval") or 45))

    def poll(self, m) -> None:
        import datetime as _dt
        import email as _email
        import email.policy as _policy
        typ, _ = m.select("INBOX")
        if typ != "OK":
            raise ValueError("brak skrzynki INBOX")
        d = _dt.date.today() - _dt.timedelta(days=2)
        since = f"{d.day:02d}-{_MAIL_MONTHS[d.month - 1]}-{d.year}"
        typ, data = m.uid("SEARCH", None, "UNSEEN", "SINCE", since)
        uids = (data[0] or b"").split() if typ == "OK" and data else []
        for uid in uids:
            if self.stop_flag:
                return
            if uid in self.skip:
                continue
            typ, got = m.uid("FETCH", uid, "(BODY.PEEK[])")      # PEEK: cudzy mail zostaje nieprzeczytany
            raw = next((x[1] for x in got or [] if isinstance(x, tuple) and len(x) > 1), None)
            if typ != "OK" or not raw:
                continue
            msg = _email.message_from_bytes(raw, policy=_policy.default)
            if self.take(msg):
                m.uid("STORE", uid, "+FLAGS", "(\\Seen)")
            else:
                self.skip.add(uid)
                if len(self.skip) > 5000:
                    self.skip = set(list(self.skip)[-2000:])

    def verified(self, msg, sender: str) -> bool:
        """Czy serwer poczty potwierdził nadawcę (DMARC, albo DKIM/SPF z domeny nadawcy).

        Liczy się tylko NAJWYŻSZY nagłówek Authentication-Results (dopisuje go serwer odbierający);
        niższe mógł wstawić sam nadawca. Bez potwierdzenia mail nie wchodzi, chyba że użytkownik
        świadomie ustawi "trust_unverified": true (np. własny serwer poczty bez tych nagłówków)."""
        if self.cfg.get("trust_unverified") is True:
            return True
        heads = msg.get_all("Authentication-Results") or []
        top = str(heads[0]).lower() if heads else ""
        domain = sender.rsplit("@", 1)[-1]
        ok = False
        if re.search(r"\bdmarc=pass\b", top):
            ok = True
        else:
            for m in re.finditer(r"\bdkim=pass\b[^;]*?header\.(?:d|i)=@?([a-z0-9.-]+)", top):
                d = m.group(1)
                if d == domain or domain.endswith("." + d):
                    ok = True
            for m in re.finditer(r"\bspf=pass\b[^;]*?smtp\.mailfrom=(?:[^@\s;]*@)?([a-z0-9.-]+)", top):
                if m.group(1) == domain:
                    ok = True
        if not ok:
            if sender == str(self.cfg.get("owner") or "").strip().lower() or not self.cfg.get("owner"):
                self.problem = ("Serwer poczty nie potwierdza nadawcy (brak DMARC, DKIM ani SPF w nagłówkach), więc maile "
                                "nie są przyjmowane. Jeśli to Twój własny serwer bez tych nagłówków, ustaw w email.json "
                                '"trust_unverified": true.')
            return False
        return True

    def take(self, msg) -> bool:
        """True: mail właściciela (albo z kodem parowania) przyjęty. False: obcy, pomijamy po cichu."""
        from email.utils import parseaddr
        sender = parseaddr(str(msg.get("From") or ""))[1].strip().lower()
        if not sender or sender == self._addr().lower():
            return False
        if str(msg.get("Auto-Submitted") or "no").strip().lower() != "no" or \
                str(msg.get("Precedence") or "").strip().lower() in ("bulk", "list", "junk"):
            return False                  # automaty (autoodpowiedzi, listy): bez pętli maili
        if not self.verified(msg, sender):
            return False                  # nadawca niepotwierdzony: From łatwo podrobić, a agent ma narzędzia
        if "nie potwierdza nadawcy" in (self.problem or ""):
            self.problem = ""
        subject = str(msg.get("Subject") or "")
        body = _host_mail_text(msg)
        owner = str(self.cfg.get("owner") or "").strip()
        if not owner:
            code = str(self.cfg.get("code") or "")
            if code and re.search(r"(?<!\d)" + re.escape(code) + r"(?!\d)", subject + "\n" + body):
                self.remember(msg)
                self.emit(text=code, who=sender, where=sender)
                return True
            return False
        if sender != owner.lower():
            return False
        self.remember(msg)
        text = body or re.sub(r"(?i)^((re|odp|fwd?|pd)\s*:\s*)+", "", subject).strip()
        audio = next((p for p in msg.iter_attachments() if p.get_content_type().startswith("audio/")), None)
        if audio is not None:
            data = audio.get_payload(decode=True) or b""
            threading.Thread(target=self.heard, args=(data, audio.get_content_type(), owner, owner, body), daemon=True).start()
            return True
        first = text.splitlines()[0] if text else ""
        button = self.pick(first)
        if button:
            self.emit(button=button, who=owner, where=owner, ack=lambda t: None)
        elif text:
            self.emit(text=text, who=owner, where=owner)
        return True

    def remember(self, msg) -> None:
        self.last = {"id": str(msg.get("Message-ID") or "").strip(), "refs": str(msg.get("References") or "").strip(),
                     "subject": str(msg.get("Subject") or "").strip()}

    def _message(self, body: str):
        from email.message import EmailMessage
        from email.utils import make_msgid, formatdate
        m = EmailMessage()
        m["From"] = self._addr()
        m["To"] = str(self.chat)
        subj = self.last.get("subject") or ""
        m["Subject"] = (subj if re.match(r"(?i)^(re|odp)\s*:", subj) else "Re: " + subj) if subj else "Codo: wiadomość od agentów"
        if self.last.get("id"):
            m["In-Reply-To"] = self.last["id"]
            m["References"] = (self.last.get("refs", "") + " " + self.last["id"]).strip()
        dom = self._addr().rsplit("@", 1)[-1] if "@" in self._addr() else None
        m["Message-ID"] = make_msgid(domain=dom)
        m["Date"] = formatdate(localtime=True)
        m["Auto-Submitted"] = "auto-replied"
        m.set_content(body)
        return m

    def _smtp(self, m) -> bool:
        import smtplib
        import ssl
        host, port = str(self.cfg.get("smtp_host") or self.cfg.get("imap_host") or ""), int(self.cfg.get("smtp_port") or 465)
        try:
            if port == 465:
                s = smtplib.SMTP_SSL(host, port, timeout=30, context=ssl.create_default_context())
            else:
                s = smtplib.SMTP(host, port, timeout=30)
                s.starttls(context=ssl.create_default_context())
            try:
                s.login(str(self.cfg.get("user") or ""), str(self.cfg.get("password") or ""))
                s.send_message(m)
            finally:
                try:
                    s.quit()
                except (OSError, smtplib.SMTPException):
                    pass
            return True
        except (OSError, smtplib.SMTPException) as e:
            self._note(f"Nie udało się wysłać maila przez {host} ({type(e).__name__}).")
            return False

    def send(self, text: str, buttons: list | None = None) -> bool:
        if not self.chat or not str(text).strip():
            return False
        return self._smtp(self._message(self.numbered_text(_host_plain(text), buttons) if buttons else _host_plain(text)))

    def send_voice(self, ogg: bytes) -> bool:
        if not self.chat:
            return False
        m = self._message("Odpowiedź głosem w załączniku.")
        m.add_attachment(ogg, maintype="audio", subtype="ogg", filename="odpowiedz.ogg")
        return self._smtp(m)


