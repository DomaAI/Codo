def _office_apply_edits(data: bytes, kind: str, edits: list) -> tuple:
    """Edycje na kopii dokumentu w pamięci: (nowe bajty, opis zmian). Błąd którejkolwiek: _OfficeError."""
    from xml.dom import minidom
    from xml.parsers.expat import ExpatError
    pkg = _OfficePkg(data)
    acts = _OFFICE_ACTIONS[kind]
    book = _XlBook(pkg) if kind == "XLSX" else None
    notes = []
    for i, e in enumerate(edits, 1):
        if not isinstance(e, dict):
            raise _OfficeError(f"edycja {i}: oczekuję obiektu z action")
        act = str(e.get("action") or "").strip().lower()
        act = _OFFICE_ALIASES.get(act, act)
        fn = acts.get(act)
        if fn is None:
            raise _OfficeError(f"edycja {i}: {kind} obsługuje akcje: {', '.join(acts)}" + (
                f" (nie „{act}”)" if act else ""))
        try:
            notes.append(fn(pkg, e, book) if book is not None else fn(pkg, e))
        except _OfficeError as err:
            raise _OfficeError(f"edycja {i} ({act}): {err}" if len(edits) > 1 else f"{act}: {err}") from None
    if book is not None:
        book.recalc()
    out = pkg.save()
    import io
    import zipfile
    with zipfile.ZipFile(io.BytesIO(out)) as z:   # kontrola: zip czytelny, zmienione części to poprawny XML
        if z.testzip() is not None:
            raise _OfficeError("zapis dał uszkodzony zip; nic nie zapisano")
        for name in pkg.dirty | set(pkg.added):
            if name in pkg.removed or not name.endswith((".xml", ".rels")):
                continue
            try:
                minidom.parseString(z.read(name))
            except (ExpatError, KeyError) as err:
                raise _OfficeError(f"część {name} po zmianie nie jest poprawnym XML ({err}); nic nie zapisano") from None
    return out, notes


def _apply_bytes(path: Path, old_text: str, new_text: str, data: bytes, args: dict, label: str, kind: str) -> str:
    """Zapis pliku binarnego (dokument biurowy) drogą jak _apply: kopia w .doma/backups, zapis atomowy,
    wpis do dziennika zmian (/undo, zdarzenie edit z diffem TEKSTU dokumentu przed i po)."""
    diff = _unified(path, old_text, new_text)
    if args.get("dry_run"):
        return f"PODGLĄD — {label} (NIE zapisano):\n{diff}"
    if not os.access(_long_path(path), os.W_OK):
        return _write_error(path, PermissionError(13, "read-only"))
    try:
        _backup(path)
    except OSError as e:
        return _Lf('BŁĄD: nie udało się zrobić kopii zapasowej {0} ({1}). Nic nie zapisano.', path.name, e)
    try:
        _atomic_write(path, data)
    except OSError as e:
        return _write_error(path, e)
    a, r = _linedelta(old_text, new_text)
    with _EDIT_LOCK:
        _EDIT_SEQ[0] += 1
        EDIT_LOG.append({"seq": _EDIT_SEQ[0], "path": path, "added": a, "removed": r,
                         "new_file": False, "diff": diff, "format": kind})
    return f"{label} → {path} (+{a}/-{r} linii tekstu, kopia zapasowa zrobiona)"


def t_office_edit(args):
    path = _agent_path(args.get("path"), write=True)
    if not path.exists():
        hint = _similar_paths(str(args.get("path") or ""))
        return (f"BŁĄD: nie ma pliku {args.get('path')}" + (_Lf('. Może chodzi o: {0}', ', '.join(hint)) if hint else "")
                + ". office_edit zmienia istniejące dokumenty; nowy utwórz skryptem (run_code) albo w Biurze.")
    if path.is_dir():
        return f"BŁĄD: {args.get('path')} to katalog."
    kind = _binary_kind(path)
    if kind not in _OFFICE_ACTIONS:
        if kind == "PDF":
            return "BŁĄD: PDF nie jest edytowalny przez office_edit; zmień dokument źródłowy albo użyj run_code (pypdf)."
        return (f"BŁĄD: {path.name} to nie dokument DOCX/XLSX/PPTX/ODT/ODS/ODP"
                + (f" ({kind})" if kind else " (plik tekstowy: edit_file)") + ".")
    if path.suffix.lower() in (".docm", ".xlsm", ".pptm"):
        pass   # makra zostają bajt w bajt (vbaProject.bin nie jest ruszany)
    edits = args.get("edits")
    if not isinstance(edits, list) or not edits:
        edits = [{k: v for k, v in args.items() if k not in ("path", "edits", "dry_run")}]
    try:
        data = _long_path(path).read_bytes()
        old_text = (_document_text(path, kind, data)[0] or "")
        new, notes = _office_apply_edits(data, kind, edits)
        new_text = _document_text(path, kind, new)[0] or ""
    except _OfficeError as e:
        return f"BŁĄD: {e}. Plik bez zmian."
    except OSError as e:
        return f"BŁĄD odczytu {path.name}: {e}"
    label = f"office_edit {kind} ({'; '.join(notes)})"
    out = _apply_bytes(path, old_text, new_text, new, args, label, kind)
    if kind == "XLSX" and not out.startswith(("BŁĄD", "PODGLĄD")):
        out += ". Excel i LibreOffice przeliczą formuły przy otwarciu"
    return out


_BIG_TEXT = 16_000_000   # większe pliki tekstowe czytamy strumieniowo, bez wczytywania całości


def _read_big(p: str, path: Path, off: int, limit: int) -> str:
    """Duży plik tekstowy (logi, zrzuty bazy): linie od offsetu bez ładowania całego pliku do pamięci."""
    with _long_path(path).open("rb") as f:
        head = f.read(65536)
        f.seek(0)
        _t, enc, bom = _decode_bytes(head)
        if enc.startswith(("utf-16", "utf-32")):
            return (f"(plik {p} ma {_human_size(path.stat().st_size)} w kodowaniu {enc}; za duży do czytania w całości. "
                    "Szukaj w nim grep albo przekonwertuj go na UTF-8.)")
        if bom:
            f.read(len(bom))
        rows, used, ln = [], 0, 0
        for raw in f:
            ln += 1
            if ln < off:
                continue
            if len(rows) >= limit:
                break
            line = raw.rstrip(b"\r\n").decode(enc if enc != "latin-1" else "cp1250", "replace")
            row = f"{ln}\t{(line if len(line) <= 2000 else line[:2000] + ' …')}"
            if rows and used + len(row) > MAX_TOOL_RESULT_CHARS - 400:
                break
            rows.append(row)
            used += len(row) + 1
        else:
            if not rows:
                return f"(plik {p} ma {ln} linii, offset={off} jest za końcem; czytaj od offset=1)"
            return "\n".join(rows)
    end = off - 1 + len(rows)
    return "\n".join(rows) + (f"\n… (linie {off}-{end}; plik ma {_human_size(path.stat().st_size)}, czytany fragmentami; "
                              f"dalej: offset={end + 1}; szukanie: grep)")


def _paginate(p: str, text: str, off: int, limit: int, head: str = "") -> str:
    lines = text.split("\n")
    if lines and lines[-1] == "":
        lines.pop()   # końcowy \n nie jest osobną linią (tak liczy grep i edytor)
    if not lines:
        return head + _Lf('(pusty plik {0})', p)
    if off > len(lines):
        return f"(plik {p} ma {len(lines)} linii, offset={off} jest za końcem; czytaj od offset=1)"
    # Budżet znaków: stopka „dalej: offset=…” musi zmieścić się w wyniku (do 0.28.0 przy długich
    # liniach obcinał ją limit wyniku i model nie wiedział, gdzie czytać dalej).
    rows, used = [], len(head)
    for i, l in enumerate(lines[off - 1: off - 1 + limit]):
        l = l[:-1] if l.endswith("\r") else l
        row = f"{i + off}\t{(l if len(l) <= 2000 else l[:2000] + ' …')}"
        if rows and used + len(row) > MAX_TOOL_RESULT_CHARS - 400:
            break
        rows.append(row)
        used += len(row) + 1
    end = off - 1 + len(rows)
    more = f"\n… (linie {off}-{end} z {len(lines)}; dalej: offset={end + 1})" if len(lines) > end else ""
    return head + "\n".join(rows) + more


def _similar_paths(p: str, limit: int = 5) -> list:
    """Podpowiedź przy literówce w ścieżce: pliki o podobnej nazwie."""
    import difflib
    name = Path(p).name.lower()
    names = []
    for directory, dirs, files in os.walk(Path.cwd()):
        dirs[:] = [d for d in dirs if d not in _SKIP_DIRS and not d.startswith(".")]
        for f in files:
            names.append(str((Path(directory) / f).relative_to(Path.cwd())))
        if len(names) > 20000:
            break
    by_name = {n: Path(n).name.lower() for n in names}
    close = difflib.get_close_matches(name, list(set(by_name.values())), n=limit, cutoff=0.6)
    return [n for n in names if by_name[n] in close][:limit]


def _read_one(p: str, offset: int, limit: int) -> str:
    try:
        path = _agent_path(p)
    except ValueError as e:
        return f"BŁĄD: {e}"
    if not path.exists():
        hint = _similar_paths(p)
        return f"BŁĄD: nie ma pliku {p}" + (_Lf('. Może chodzi o: {0}', ', '.join(hint)) if hint else "")
    if path.is_dir():
        return f"BŁĄD: {p} to katalog — użyj list_dir albo find_files."
    off = max(1, offset)
    try:
        size = path.stat().st_size
        kind = _binary_kind(path)
        if kind in _IMAGE_MIME or kind in ("BMP", "ICO", "HEIC"):
            return _read_image(p, path, kind)
        if kind in _DOC_KINDS:
            text, fmt = _document_text(path, kind)
            if not text or not text.strip():
                why = ("PDF bez warstwy tekstowej (skan) albo zaszyfrowany; tekst da OCR (np. run_command: ocrmypdf, "
                       "tesseract)" if kind == "PDF" else "nie udało się wyciągnąć tekstu (uszkodzony albo pusty)")
                return f"({fmt} {p}, {_human_size(size)}: {why})"
            head = (f"({fmt} {p} jako tekst, {_human_size(size)}; edit_file go nie zmieni, " + (
                "zmiany w miejscu przez office_edit)\n" if kind in _OFFICE_ACTIONS else "zmiany skryptem przez run_code)\n"))
            return _paginate(p, text, off, limit, head)
        if kind:
            return _Lf('(plik binarny {0}, {1} — nie czytam treści)', p, _human_size(size)) + f" [{kind}]"
        if path.suffix.lower() == ".ipynb" and size < 50_000_000:
            text = _ipynb_text(_long_path(path).read_bytes())
            if text is not None:
                return _paginate(p, text, off, limit, f"(notatnik Jupyter {p}: komórki i wyniki; edycja: "
                                                      "edit_file na surowym JSON albo NotebookEdit przez run_code)\n")
        if size > _BIG_TEXT:
            return _read_big(p, path, off, limit)
        text, enc, _bom = _decode_bytes(_long_path(path).read_bytes())
        if _eol_of(text) == "\r":
            text = text.replace("\r", "\n")   # stary Mac: same \r
    except PermissionError as e:
        if getattr(e, "winerror", None) in (32, 33) or os.name == "nt":   # open() na Windows: sam Errno 13
            return _Lf("BŁĄD: nie mogę odczytać {0}: plik jest otwarty w innym programie, który go blokuje "
                       "(np. Word, Excel), albo brak uprawnień; zamknij go i spróbuj ponownie.", p)
        return f"BŁĄD: brak uprawnień do odczytu {p}."
    except OSError as e:
        return f"BŁĄD odczytu {p}: {e}" + (_L(" (plik może być zablokowany przez inny program)") if os.name == "nt" else "")
    head = f"(kodowanie {enc})\n" if enc not in ("utf-8",) and off == 1 else ""
    return _paginate(p, text, off, limit, head)


def t_read_file(args):
    offset = int(args.get("offset") or 1)
    limit = max(1, min(2000, int(args.get("limit") or 400)))
    paths = args.get("paths") or ([args["path"]] if args.get("path") else [])
    if not paths:
        return "BŁĄD: podaj path albo paths."
    if len(paths) == 1:
        return _read_one(str(paths[0]), offset, limit)
    out = []
    for p in paths[:10]:
        out.append(f"=== {p} ===\n" + _read_one(str(p), 1, min(limit, 300)))
    return "\n\n".join(out)


def t_list_dir(args):
    path = _agent_path(args.get("path") or ".")
    if not path.is_dir():
        return f"BŁĄD: {args.get('path') or '.'} nie jest katalogiem."
    depth = max(1, min(4, int(args.get("depth") or 1)))
    show_hidden = bool(args.get("hidden"))
    out, count = [], [0]

    def walk(d: Path, level: int, prefix: str) -> None:
        try:
            entries = sorted(d.iterdir(), key=lambda e: (not e.is_dir(), e.name.lower()))
        except OSError as e:
            out.append(prefix + f"(brak dostępu: {e.strerror})")
            return
        for entry in entries:
            if entry.name in _SKIP_DIRS or (not show_hidden and entry.name.startswith(".") and entry.name not in (".env.example", ".github", ".htaccess")):
                continue
            count[0] += 1
            if count[0] > 500:
                return
            if entry.is_dir():
                try:
                    n = sum(1 for _ in entry.iterdir())
                except OSError:
                    n = 0
                out.append(f"{prefix}{entry.name}/  ({n})")
                if level < depth:
                    walk(entry, level + 1, prefix + "  ")
            else:
                try:
                    size = _human_size(entry.stat().st_size)
                except OSError:
                    size = "?"
                out.append(f"{prefix}{entry.name}  {size}")
    walk(path, 1, "")
    if count[0] > 500:
        out.append("… (ponad 500 pozycji — zawęź path albo użyj find_files)")
    return "\n".join(out) or "(pusty katalog)"


def t_find_files(args):
    """Pliki po wzorcu (glob), najnowsze pierwsze. Pomija katalogi zależności i budowania."""
    import fnmatch
    import time as _time
    pattern = (args.get("pattern") or "*").strip()
    root = _agent_path(args.get("path") or ".")
    limit = max(1, min(500, int(args.get("limit") or 200)))
    pat = pattern[3:] if pattern.startswith("**/") else pattern
    # fnmatch nie zna „**”: src/**/*.ts ma łapać także pliki wprost w src/.
    flat = pattern.replace("/**/", "/")
    found = []
    visited, cut = 0, ""
    deadline = _time.monotonic() + 30
    for directory, dirs, files in os.walk(root, followlinks=False):
        dirs[:] = [d for d in dirs if d not in _SKIP_DIRS and d != ".doma"]
        visited += len(files)
        if visited > 200_000 or _time.monotonic() > deadline:
            cut = f"\n… (przeszukiwanie przerwane po {visited} plikach: podaj węższy path)"
            break
        for name in files:
            f = Path(directory) / name
            rel = str(f.relative_to(root)).replace("\\", "/")
            if (fnmatch.fnmatch(rel, pattern) or fnmatch.fnmatch(name, pat) or fnmatch.fnmatch(rel, pat)
                    or (flat != pattern and fnmatch.fnmatch(rel, flat))):
                try:
                    try:
                        shown = f.relative_to(_cwd_real()).as_posix()   # jak na Linuksie: src/a.ts, nie src\\a.ts
                    except ValueError:
                        shown = str(f)
                    found.append((f.stat().st_mtime, shown))
                except OSError:
                    continue
        if len(found) > 20000:
            cut = "\n… (ponad 20 000 pasujących plików: zawęź wzorzec)"
            break
    if not found:
        return f"(brak plików pasujących do {pattern})" + cut
    found.sort(reverse=True)
    out = [p for _, p in found[:limit]]
    return "\n".join(out) + (f"\n… ({len(found)} plików, pokazano {limit} najnowszych)" if len(found) > limit else "") + cut


def t_grep(args):
    """Szukanie w treści: ripgrep, gdy jest (szybki, zna .gitignore), inaczej Python."""
    import fnmatch
    import shutil
    pattern = args["pattern"]
    glob = args.get("glob") or ""
    root = _agent_path(args.get("path") or ".")
    ignore_case = bool(args.get("ignore_case"))
    files_only = bool(args.get("files_only"))
    context = max(0, min(5, int(args.get("context") or 0)))
    limit = max(1, min(500, int(args.get("limit") or 150)))
    rg = shutil.which("rg")
    if rg:
        cmd = [rg, "--no-heading", "--with-filename", "--line-number", "--color", "never", "--max-columns", "300",
               "--max-columns-preview", "--max-filesize", "2M"]
        if ignore_case:
            cmd.append("-i")
        if files_only:
            cmd.append("-l")
        if context:
            cmd += ["-C", str(context)]
        if glob:
            cmd += ["-g", glob]
        # Ukryte pliki też (.github/, .eslintrc, .env.example), .gitignore także poza repozytorium git;
        # bez plików z sekretami (.env, .env.local), żeby ich treść nie trafiała do modelu.
        cmd += ["--hidden", "--no-require-git", "-g", "!.env", "-g", "!.env.*"]
        for d in _SKIP_DIRS:
            cmd += ["-g", f"!{d}/"]
        if IS_WIN:
            cmd += ["--path-separator", "/"]
        # Ścieżka względna: ripgrep wypisze src/app.py także wtedy, gdy cwd na Windows ma krótką nazwę 8.3
        # (C:\\Users\\RUNNER~1), a root po resolve() długą; obcinanie przedrostka cwd zostawiało pełną ścieżkę.
        try:
            rg_root = root.relative_to(_cwd_real()).as_posix()
        except ValueError:
            rg_root = str(root)
        cmd += ["-e", pattern, rg_root]

        def shown(out: str, note: str = "") -> str:
            lines = []
            cwd = str(Path.cwd()) + os.sep
            for line in out.splitlines():
                line = line[len(cwd):] if line.startswith(cwd) else line
                lines.append(line[2:] if rg_root == "." and line.startswith("./") else line)
                if len(lines) >= limit:
                    lines.append(f"… (obcięte do {limit} wierszy — zawęź wzorzec, path albo glob)")
                    break
            return ("\n".join(lines) or "(brak trafień)") + note
        try:
            proc = subprocess.run(cmd, capture_output=True, text=True, encoding="utf-8",  # nosec B603
                                  errors="replace", timeout=60, cwd=str(Path.cwd()), stdin=subprocess.DEVNULL)
            if proc.returncode in (0, 1):
                return shown(proc.stdout)
            if proc.returncode == 2 and proc.stdout.strip():
                # kod 2 = jakiś błąd po drodze (np. jeden plik bez prawa odczytu), ale trafienia są dobre
                return shown(proc.stdout)
            if proc.returncode == 2 and "regex parse error" in (proc.stderr or ""):
                return "BŁĄD: niepoprawne wyrażenie regularne:\n" + proc.stderr.strip()[:600]
        except subprocess.TimeoutExpired as e:
            part = e.stdout.decode("utf-8", "replace") if isinstance(e.stdout, bytes) else (e.stdout or "")
            return shown(part, "\n… (szukanie przerwane po 60 s: zawęź path albo glob)")
        except OSError:
            pass  # spadamy do wersji w Pythonie
    try:
        regex = re.compile(pattern, re.I if ignore_case else 0)
    except re.error as e:
        return f"BŁĄD: niepoprawne wyrażenie regularne: {e}"
    hits: list = []
    files_hit: list = []

    import time as _time
    deadline = _time.monotonic() + 45
    seen = [0]

    def search_file(f: Path) -> None:
        seen[0] += 1
        try:
            if f.stat().st_size > 2_000_000 or _is_binary(f) or re.match(r"\.env($|\.)", f.name) and f.name not in (".env.example", ".env.sample"):
                return
            try:
                rel = f.relative_to(_cwd_real()).as_posix()   # ten sam zapis co ripgrep z --path-separator /
            except ValueError:
                rel = str(f)   # kopia innego członka zespołu poza tym folderem
            lines = _decode_text(f.read_bytes())[0].split("\n")   # cp1250, UTF-16 i BOM jak w read_file
        except OSError:
            return
        for i, line in enumerate(lines, 1):
            if regex.search(line):
                if files_only:
                    files_hit.append(rel)
                    return
                if context:
                    lo, hi = max(1, i - context), min(len(lines), i + context)
                    for j in range(lo, hi + 1):
                        sep = ":" if j == i else "-"
                        hits.append(f"{rel}{sep}{j}{sep} {lines[j - 1][:300]}")
                    hits.append("--")
                else:
                    hits.append(f"{rel}:{i}:{line.rstrip(chr(13))[:300]}")   # ten sam format co ripgrep
                if len(hits) >= limit:
                    return

    if root.is_file():
        search_file(root)
    elif _git_files(root) is not None:
        # bez ripgrepa, w repozytorium: lista plików z gita zna .gitignore i jest wielokrotnie szybsza niż os.walk
        for f in _git_files(root):
            if any(part in _SKIP_DIRS for part in f.relative_to(root).parts[:-1]) or f.is_symlink():
                continue
            if glob and not (fnmatch.fnmatch(f.name, glob) or fnmatch.fnmatch(f.relative_to(root).as_posix(), glob)):
                continue
            search_file(f)
            if len(hits) >= limit or len(files_hit) >= limit:
                return "\n".join(hits or files_hit) + f"\n… (obcięte do {limit} trafień)"
            if seen[0] > 60_000 or _time.monotonic() > deadline:
                return ("\n".join(hits or files_hit) or "(brak trafień)") + (
                    f"\n… (przeszukano {seen[0]} plików i przerwano: zawęź path albo glob)")
    else:
        for directory, dirs, files in os.walk(root, followlinks=False):
            dirs[:] = sorted(d for d in dirs if d not in _SKIP_DIRS)
            for name in sorted(files):
                f = Path(directory) / name
                if f.is_symlink():
                    continue
                if glob and not (fnmatch.fnmatch(name, glob) or fnmatch.fnmatch(str(f.relative_to(root)), glob)):
                    continue
                search_file(f)
                if len(hits) >= limit or len(files_hit) >= limit:
                    return "\n".join(hits or files_hit) + f"\n… (obcięte do {limit} trafień)"
                if seen[0] > 60_000 or _time.monotonic() > deadline:
                    return ("\n".join(hits or files_hit) or "(brak trafień)") + (
                        f"\n… (przeszukano {seen[0]} plików i przerwano: zawęź path albo glob; "
                        "zainstaluj ripgrep (rg), szuka wielokrotnie szybciej)")
    if files_only:
        return "\n".join(files_hit) or "(brak trafień)"
    return "\n".join(hits) or "(brak trafień)"


