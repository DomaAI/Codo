def _ago(ts: int) -> str:
    import time
    s = max(0, int(time.time()) - int(ts or 0))
    if s < 90:
        return _L("przed chwilą")
    if s < 3600:
        return f"{s // 60} min temu"
    if s < 86400:
        return f"{s // 3600} godz. temu"
    d = s // 86400
    return "wczoraj" if d == 1 else f"{d} dni temu"


