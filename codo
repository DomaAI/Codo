    def _alive():
        if not pidfile.exists():
            return False
        try:
            return _pid_alive(int(pidfile.read_text()))
        except Exception:
            return False

    if act == "stop":
        if _alive():
            try:
                _pid_terminate(int(pidfile.read_text()))
            except Exception:
                pass
        pidfile.unlink(missing_ok=True)
        return "Podgląd zatrzymany."

    ip = "127.0.0.1"
    try:
        s = _sock.socket(_sock.AF_INET, _sock.SOCK_DGRAM)
        s.connect(("8.8.8.8", 80)); ip = s.getsockname()[0]; s.close()
    except Exception:
        pass

    if act == "status":
        return (f"Podgląd DZIAŁA: http://{ip}:{port}/" if _alive()
                else "Podgląd nie jest uruchomiony (preview_action=start).")

    if _alive():
        return f"Podgląd już działa: http://{ip}:{port}/"
    proc = subprocess.Popen(
        [_python_cmd(), "-m", "http.server", str(port), "--bind", "0.0.0.0"],
        cwd=str(Path.cwd()), stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,
    )
    pidfile.write_text(str(proc.pid))
    _time.sleep(0.5)
    if not _alive():
        return f"Nie udało się wystartować podglądu na porcie {port} (zajęty?)."
    return (f"Podgląd na żywo: http://{ip}:{port}/\n"
            f"(serwer statyczny w tym katalogu. Jeśli nie otwiera się z zewnątrz, "
            f"otwórz port {port} w firewall. Zatrzymanie: preview_action=stop)")


