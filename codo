def _lokalny_url(url: str) -> bool:
    """Adres projektu na tym Macu (localhost, 127.0.0.1, ::1, *.localhost, plik) albo pusty."""
    if not url.strip():
        return True
    u = url if "://" in url else "http://" + url
    parts = urllib.parse.urlsplit(u)
    if parts.scheme == "file":
        return True
    host = (parts.hostname or "").lower()
    return host in ("localhost", "127.0.0.1", "::1", "0.0.0.0") or host.endswith(".localhost")


def t_przegladarka(args: dict, auto_yes: bool = False) -> str:
    akcja = str(args.get("akcja") or "strona")
    if akcja == "serwer" and not auto_yes:
        cmd = str(args.get("polecenie") or "")
        if not confirm_action(_L("Uruchomić serwer projektu w terminalu Codo?"), cmd, ["terminal", cmd]):
            return "ODRZUCONE przez użytkownika."
    if akcja == "otworz" and not auto_yes and not _lokalny_url(str(args.get("url") or "")):
        # Strona spoza tego Maca: raz na hosta w sesji pyta o zgodę (podgląd nie ma Twoich logowań,
        # ale klikanie i wpisywanie w obcym serwisie to działanie w Twoim imieniu).
        host = urllib.parse.urlsplit(str(args.get("url") or "")).hostname or str(args.get("url") or "")
        dozwolone = SESSION.setdefault("przegladarka_hosty", set())
        if host not in dozwolone:
            if not confirm_action(_Lf("Otworzyć w przeglądarce podglądu stronę {0}?", host), str(args.get("url") or ""),
                                  ["browser", host]):
                return "ODRZUCONE przez użytkownika."
            dozwolone.add(host)
    pola = {k: args[k] for k in ("url", "polecenie", "port", "n", "selektor", "tekst", "enter", "dy") if k in args}
    return _most_tekst(_app_call("browser." + akcja, pola, timeout=90 if akcja == "serwer" else 45))


def t_komputer(args: dict, auto_yes: bool = False) -> str:
    akcja = str(args.get("akcja") or "aplikacje")
    pola = {k: args[k] for k in ("aplikacja", "n", "x", "y", "tekst", "klawisz", "dy") if k in args}
    r = _app_call("computer." + akcja, pola)
    if r.get("ask"):
        # Aplikacja bez nadanego poziomu: karta zgody; „zapamiętaj” nadaje pełny dostęp do tej aplikacji.
        app = str(r.get("app") or args.get("aplikacja") or "")
        wybor = _app_ask(_Lf("Pozwolić Codo sterować aplikacją {0}?", app), str(r.get("detail") or ""),
                         _L("Codo będzie klikać i pisać w tej aplikacji tak jak Ty."), True)
        if wybor == 0:
            _app_call("computer.grant", {"aplikacja": app, "poziom": "zablokowana", "raz": True})
            return "ODRZUCONE przez użytkownika."
        _app_call("computer.grant", {"aplikacja": app, "poziom": "pelny", "raz": wybor == 1})
        r = _app_call("computer." + akcja, pola)
    return _most_tekst(r)


