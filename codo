_DIFF_MAX_ROWS = 28


def _diff_bg(kind: str, strong: bool) -> str:
    """Tło wiersza diffu: przytłumione dla linii, mocniejsze dla zmienionych słów."""
    if _truecolor():
        rgb = {("-", False): (61, 1, 0), ("-", True): (110, 14, 8),
               ("+", False): (2, 48, 4), ("+", True): (10, 96, 20)}[(kind, strong)]
        return "48;2;%d;%d;%d" % rgb
    return {("-", False): "48;5;52", ("-", True): "48;5;88",
            ("+", False): "48;5;22", ("+", True): "48;5;28"}[(kind, strong)]


def _diff_tokens(text: str) -> list:
    return re.findall(r"\w+|\s+|[^\w\s]", text)


def _diff_marks(old: str, new: str) -> tuple:
    """Zakresy zmienionych znaków w parze linii (−/+).
    Zwraca (zakresy_starej, zakresy_nowej); puste, gdy linie są zbyt różne."""
    import difflib
    a, b = _diff_tokens(old), _diff_tokens(new)
    sm = difflib.SequenceMatcher(None, a, b, autojunk=False)
    if sm.ratio() < 0.35:
        return [], []
    ra, rb = [], []
    pa = [0]
    for t in a:
        pa.append(pa[-1] + len(t))
    pb = [0]
    for t in b:
        pb.append(pb[-1] + len(t))
    for op, i1, i2, j1, j2 in sm.get_opcodes():
        if op == "equal":
            continue
        if i2 > i1:
            ra.append((pa[i1], pa[i2]))
        if j2 > j1:
            rb.append((pb[j1], pb[j2]))
    return ra, rb


def _diff_line(kind: str, no: int, text: str, width: int, marks: list) -> str:
    color = sys.stdout and sys.stdout.isatty() and "NO_COLOR" not in os.environ and os.environ.get("TERM") != "dumb"
    gutter = f"{no:>5} " + (kind if kind in "+-" else " ") + " "
    body_w = max(8, width - len(gutter))
    if _display_width(text) > body_w:
        text = text[:body_w - 1] + "…"
        marks = [(a, min(b, len(text))) for a, b in marks if a < len(text)]
    pad = " " * max(0, body_w - _display_width(text))
    if not color:
        return gutter + text
    if kind == " ":
        return "\033[2m" + gutter + "\033[0m" + text
    base, strong = _diff_bg(kind, False), _diff_bg(kind, True)
    fg = "38;5;210" if kind == "-" else "38;5;114"
    out, pos = [f"\033[{base}m\033[{fg}m{gutter}\033[39m"], 0
    for a, b in marks:
        out.append(text[pos:a])
        out.append(f"\033[{strong}m{text[a:b]}\033[{base}m")
        pos = b
    out.append(text[pos:] + pad + "\033[0m")
    return "".join(out)


def _diff_rows(diff: str) -> list:
    """Diff do transkryptu: numery linii, linie kontekstu, pełnej szerokości tło
    czerwone/zielone i mocniej podświetlone zmienione słowa."""
    import shutil
    width = max(30, shutil.get_terminal_size((80, 24)).columns - 4)
    hunks, cur = [], None
    old_no = new_no = 0
    for line in diff.splitlines():
        if line.startswith(("---", "+++")):
            continue
        m = re.match(r"^@@ -(\d+)(?:,\d+)? \+(\d+)", line)
        if m:
            old_no, new_no = int(m.group(1)), int(m.group(2))
            cur = []
            hunks.append(cur)
            continue
        if cur is None or not line or line[0] not in " +-":
            continue
        body = _terminal_text(line[1:]).replace("\t", "    ")
        if line[0] == "-":
            cur.append(["-", old_no, body, []])
            old_no += 1
        elif line[0] == "+":
            cur.append(["+", new_no, body, []])
            new_no += 1
        else:
            cur.append([" ", new_no, body, []])
            old_no += 1
            new_no += 1
    rows, shown = [], 0
    for h_i, hunk in enumerate(hunks):
        # pary −/+ w jednym bloku zmian: podświetlenie słów
        i = 0
        while i < len(hunk):
            if hunk[i][0] != "-":
                i += 1
                continue
            j = i
            while j < len(hunk) and hunk[j][0] == "-":
                j += 1
            k = j
            while k < len(hunk) and hunk[k][0] == "+":
                k += 1
            for off in range(min(j - i, k - j)):
                ra, rb = _diff_marks(hunk[i + off][2], hunk[j + off][2])
                hunk[i + off][3], hunk[j + off][3] = ra, rb
            i = k
        if h_i:
            rows.append(dim("      ⋮"))
        for kind, no, body, marks in hunk:
            if shown >= _DIFF_MAX_ROWS:
                rows.append(dim(_L("      … więcej zmian: /diff")))
                return rows
            rows.append("  " + _diff_line(kind, no, body, width, marks))
            shown += 1
    return rows


def _content_len(m: dict) -> int:
    # Z argumentami wywołań: stare write_file/multi_edit niosą całe pliki, a do 0.28.0 nie były
    # liczone do budżetu kontekstu ani przycinane (wysyłane w każdym kroku, aż do 413).
    c = m.get("content")
    if isinstance(c, list):   # wiadomość z obrazem (read_file): tekst + stała za obraz, bez base64
        return sum(len(str(x.get("text") or "")) if isinstance(x, dict) and x.get("type") == "text" else 1500
                   for x in c)
    return len(str(c or "")) + sum(
        len(str(((tc or {}).get("function") or {}).get("arguments") or "")) for tc in (m.get("tool_calls") or []))


_BULKY_ARGS = ("content", "new_string", "old_string", "edits", "code", "content_b64")


def _shrink_call_args(m: dict) -> None:
    """Stare wywołania zapisu: zamiast pełnej treści krótka notka (ścieżka zostaje, plik jest na dysku)."""
    for tc in m.get("tool_calls") or []:
        fn = (tc or {}).get("function") or {}
        raw = fn.get("arguments")
        if not isinstance(raw, str) or len(raw) < 1500:
            continue
        try:
            args = json.loads(raw)
        except ValueError:
            continue
        if not isinstance(args, dict):
            continue
        for k in _BULKY_ARGS:
            v = args.get(k)
            if isinstance(v, (str, list)) and len(json.dumps(v, ensure_ascii=False)) > 400:
                args[k] = f"<{len(json.dumps(v, ensure_ascii=False))} znaków, już zapisane; aktualną treść czytaj z pliku>"
        fn["arguments"] = json.dumps(args, ensure_ascii=False)


def _context_usage(messages: list, chat: bool = False) -> dict:
    """Ile miejsca w kontekście zajmuje co: instrukcje, narzędzia, rozmowa, wyniki narzędzi (znaki ~ tokeny)."""
    instrukcje = rozmowa = wyniki = pliki = 0
    for m in messages:
        n = len(str(m.get("content") or "")) + sum(len(json.dumps(tc, ensure_ascii=False)) for tc in (m.get("tool_calls") or []))
        rola = m.get("role")
        if rola == "system":
            instrukcje += n
        elif rola == "tool":
            wyniki += n
        elif rola == "user" and "Dołączone przez użytkownika (@):" in str(m.get("content") or ""):
            tekst = str(m.get("content") or "")
            i = tekst.index("Dołączone przez użytkownika (@):")
            rozmowa += i
            pliki += n - i
        else:
            rozmowa += n
    narzedzia = 0 if chat else len(json.dumps(enabled_tools(), ensure_ascii=False))
    uzyte = instrukcje + rozmowa + wyniki + pliki
    return {"instrukcje": instrukcje // 4, "narzedzia": narzedzia // 4, "rozmowa": rozmowa // 4,
            "wyniki": wyniki // 4, "pliki": pliki // 4, "uzyte": (uzyte + narzedzia) // 4,
            "limit": (_CTX_BUDGET + narzedzia) // 4, "wiadomosci": len(messages), "max_wiadomosci": _CTX_MAX_MSGS}


def compact_history(messages: list) -> bool:
    """Przycina historię, gdy zbliża się limit kroku. Zwraca True, jeśli coś
    wycięto. Kolejność: (1) skrócenie starych wyników narzędzi, (2) usunięcie
    najstarszych tur w całości (granica = wiadomość usera, więc pary
    tool_call/tool zostają spójne), (3) skrócenie największych wyników."""
    def over() -> bool:
        return (sum(_content_len(m) for m in messages) > _CTX_BUDGET
                or len(messages) > _CTX_MAX_MSGS)

    if not over():
        return False
    cutoff = len(messages) - _KEEP_RECENT
    # Od najstarszych i tylko tyle, ile trzeba: do 0.28.0 jedno przekroczenie kasowało naraz wszystkie
    # starsze wyniki, a model czytał te same pliki od nowa.
    for i in range(1, max(1, cutoff)):
        if not over():
            return True
        m = messages[i]
        if m.get("role") == "assistant":
            _shrink_call_args(m)
        c = str(m.get("content") or "")
        if m.get("role") == "tool" and len(c) > 600:
            m["content"] = (c[:400] + f"\n… (wynik skrócony przy porządkowaniu kontekstu, "
                            f"{len(c)} znaków; uruchom narzędzie ponownie, jeśli potrzebujesz)")
    if over():
        # Zanim wyrzucimy całe tury: przytnij ogromne świeże wyniki, to zwykle one przepełniają kontekst.
        for m in sorted(messages[1:], key=_content_len, reverse=True):
            c = str(m.get("content") or "")
            if m.get("role") == "tool" and len(c) > 20_000:
                m["content"] = _clip_middle(c, 8_000)
                if not over():
                    return True
    while over():
        # Wiadomości systemowe na początku (prompt + kontekst umiejętności) zostają:
        # wycinanie od indeksu 1 kasowało instrukcje umiejętności w środku tury.
        head = 1
        while head < len(messages) and messages[head].get("role") == "system":
            head += 1
        users = [i for i, m in enumerate(messages) if i > head and m.get("role") == "user" and not m.get("_codo_continue")]
        if users and users[0] < len(messages) - 2:
            del messages[head:users[0]]
            continue
        # Jedna długa tura (codo work): wyrzucamy najstarszy krok asystenta
        # razem z jego wynikami, cel (pierwsza wiadomość usera) zostaje.
        first_user = next((i for i, m in enumerate(messages) if m.get("role") == "user"
                           and isinstance(m.get("content"), str) or m.get("role") == "user" and m.get("content") is None), None)
        start = (first_user or 0) + 1
        if start >= len(messages) - _KEEP_RECENT:
            break
        end = start + 1
        while end < len(messages) and messages[end].get("role") == "tool":
            end += 1
        del messages[start:end]
        note = "\n\n(Starsze kroki usunięte z kontekstu; stan pracy sprawdzisz przez plan_status, git_status albo read_file.)"
        if first_user is not None and note not in str(messages[first_user].get("content")):
            messages[first_user]["content"] = str(messages[first_user].get("content") or "") + note
    if over():
        for m in sorted(messages[1:], key=_content_len, reverse=True):
            c = str(m.get("content") or "")
            if m.get("role") == "tool" and len(c) > 20_000:
                m["content"] = c[:2_000] + "\n… (obcięte, kontekst za duży)"
                if not over():
                    break
    return True


def _step_error(e: ApiError) -> None:
    SESSION["turn_error"] = e.status
    if e.status == 402:
        print(red(_L("✗ Brak kredytów: ")) + e.human())
        print(dim(_L("  Doładuj w aplikacji DomaAI albo na bymadd.pl/app.")))
    elif e.status == 403:
        print(red("✗ ") + e.human())
    else:
        print(red("✗ ") + e.human())


def _print_assistant(content: str) -> None:
    stream = _AnswerStream()
    stream.feed(content.strip() + "\n")
    stream.finish()


_FULL_DETAIL = {"run_command": "command", "install": "packages", "run_app": "command",
                "run_code": "code", "app_use": "code"}


def _tool_header(name: str, args: dict) -> str:
    verb = _TOOL_VERBS.get(name, name)
    if name in _FULL_DETAIL:
        # Pełna treść idzie pod nagłówek; w nagłówku: co i w jakim folderze.
        return bold(verb) + dim(_L(" w ") + _cwd_label(50))
    hint = _terminal_text(_tool_hint(name, args))
    return bold(verb) + (" " + dim(hint) if hint else "")


def _tool_detail(name: str, args: dict) -> str:
    key = _FULL_DETAIL.get(name)
    value = args.get(key) if key else None
    if not value:
        return ""
    if isinstance(value, list):
        value = " ".join(map(str, value))
    value = str(value)
    if name in ("run_command", "run_app"):
        return "$ " + value
    return value


def _result_lines(name: str, result: str, show_full: bool = False) -> list:
    """Krótki opis wyniku narzędzia pod nagłówkiem (pod ⎿)."""
    text = _terminal_text(result or "").strip("\n")
    if not text:
        return [dim(_L("Gotowe"))]
    lines = text.splitlines()
    if show_full:
        return [dim(line) for line in lines[:40]] + ([dim(_Lf('… +{0} linii', len(lines) - 40))] if len(lines) > 40 else [])
    if text.startswith(("BŁĄD", "ODRZUCONE", "ANULOWANE", "PRZERWANE")):
        return [red(lines[0][:200])]
    if name == "run_command" or name in ("run_tests", "lint", "run_code", "install", "format"):
        head = lines[0]
        tail = [line for line in lines[1:] if line.strip()][-3:]
        extra = len(lines) - 1 - len(tail)
        out = [dim(head[:200])] + [dim(line[:200]) for line in tail]
        if extra > 0:
            out.insert(1, dim(_Lf('… +{0} linii', extra)))
        return out
    if name in ("read_file", "read_raw", "read_text"):
        return [dim(_Lf('Wczytano {0} linii', len(lines)))]
    first = lines[0].replace("\t", "  ")[:160]
    more = len(lines) - 1
    return [dim(first + (_Lf('  (+{0} linii)', more) if more > 0 and name in ("read_file", "read_raw", "read_text", "grep", "list_dir", "list_files") else ""))]


def _note(label: str, text: str) -> None:
    """Dopisek narzędzia przed zgodą. W panelu nagłówek już to pokazuje."""
    if LIVE.on:
        return
    print(dim("  ⎿  ") + bold(label) + " " + text)


_THINKING_LABELS = ("Myślę", "Analizuję", "Układam plan", "Kombinuję", "Rozważam",
                    "Składam odpowiedź", "Sprawdzam tropy", "Łączę fakty")


def _thinking_label(step: int, last_tool: str = "") -> str:
    import random
    if step == 0:
        return random.choice(_THINKING_LABELS[:5])
    if last_tool:
        return _L("Analizuję wynik: ") + last_tool
    return random.choice(_THINKING_LABELS)


def agent_turn(creds: dict, messages: list, model: str | None, auto_yes: bool,
               tools: list | None = None, max_steps: int = MAX_STEPS,
               show_results: tuple = (), mode: str = "ask"):
    import time
    # Wybór z okna („Rozmawiaj dalej z…”, lista modeli) leży w ustawieniach: bez niego tura szła
    # do domyślnego modelu DomaAI zamiast do wybranego agenta albo konta.
    model = current_model(model)
    SESSION["turn_started"] = time.monotonic()
    SESSION["turn_steps"] = 0
    SESSION["turn_spent"] = 0
    # tury lokalnych modeli trafiają też do rozmowy w aplikacji (Lopus zapisuje je sam)
    SESSION["turn_lustro"] = model not in ("lopus", "lopus-pro") and (agent_kind(model) is not None
                                                                     or not maddlabs_with_domaai_tools(model))
    LIVE.start_busy(_thinking_label(0))
    ok = False
    try:
        ok = _agent_turn(creds, messages, model, auto_yes, tools, max_steps, show_results, mode)
        return ok
    finally:
        LIVE.stop_busy()
        elapsed = time.monotonic() - SESSION.pop("turn_started", time.monotonic())
        if _tty() and (SESSION.get("turn_steps") or SESSION.pop("turn_footer", False) or LIVE.thought >= 1):
            clock = time.strftime("%H:%M")
            if ok:
                line = _Lf('Myślał {0} · gotowe {1}', _duration(elapsed), clock)
            else:
                line = f"Zatrzymano po {_duration(elapsed)} · {clock}"
            print("\n" + dim("✻ " + line))
            info = [line]
            if SESSION.get("turn_spent"):
                info.append(f"{SESSION['turn_spent']} kr")
            SYNC.add("info", {"tekst": " · ".join(info)})
        SYNC.set_state("idle", "")


def _agent_turn(creds: dict, messages: list, model: str | None, auto_yes: bool,
               tools: list | None = None, max_steps: int = MAX_STEPS,
               show_results: tuple = (), mode: str = "ask"):
    SESSION["turn_error"] = None
    if SESSION.get("maszyna") and model not in ("lopus", "lopus-pro"):
        # Projekt na maszynie DomaAI: pracuje agent DomaAI w chmurze (Lopus), niezależnie od mózgu na Macu.
        model = "lopus-pro" if (load_agent_profile().get("lopus") or "lopus-pro") == "lopus-pro" else "lopus"
    if agent_kind(model):
        try:
            return external_turn(creds, messages, model, auto_yes, mode)
        except (ApiError, urllib.error.URLError, OSError) as exc:
            SESSION["turn_error"] = exc.status if isinstance(exc, ApiError) else "net"
            print(red("✗ ") + describe_error(exc))
            return False
    if model in ("lopus", "lopus-pro"):
        try:
            return lopus_turn(creds, messages, model, auto_yes, mode)
        except (ApiError, urllib.error.URLError, OSError) as exc:
            SESSION["turn_error"] = exc.status if isinstance(exc, ApiError) else "net"
            print(red("✗ ") + describe_error(exc))
            return False
    if maddlabs_with_domaai_tools(model):
        try:
            return lopus_turn(creds, messages, model, auto_yes, mode, mozg="madd")
        except ApiError as exc:
            if exc.status not in (400, 403, 409, 422, 503):
                print(red("✗ ") + describe_error(exc))
                return False
            # Serwer nie da temu modelowi narzędzi DomaAI: do końca sesji wprost przez API MaddLabs.
            SESSION["maddlabs_direct"] = model or ""
            SESSION["turn_lustro"] = True
            print(dim(_Lf('  {0} Pracuję wprost przez API MaddLabs, z narzędziami lokalnymi.', exc.detail)))
        except (urllib.error.URLError, OSError) as exc:
            SESSION["turn_error"] = "net"
            print(red("✗ ") + describe_error(exc))
            return False
    messages[:] = [m for m in messages if not (m.get("role") == "system" and str(m.get("content", "")).startswith("[UMIEJĘTNOŚĆ DOMAAI]"))]
    if _SKILL_CONTEXT:
        messages.insert(1, {"role": "system", "content": "[UMIEJĘTNOŚĆ DOMAAI]\n" + _SKILL_CONTEXT})
    tools = enabled_tools(tools) if tools != [] else []
    SESSION["turn_creds"], SESSION["turn_model"] = creds, model
    _effort_system(messages)
    if max_steps == MAX_STEPS:
        max_steps = _EFFORT_STEPS.get(current_effort(), MAX_STEPS)
    if messages and messages[0].get("role") == "system" and "UMIEJĘTNOŚCI KONTA" not in messages[0].get("content", ""):
        messages[0]["content"] = str(messages[0].get("content", "")) + "\nUMIEJĘTNOŚCI KONTA: gdy zadanie wymaga metodyki, użyj wtyczka bez argumentów, wybierz pasującą umiejętność i wczytaj jej instrukcję przed pracą."
    spent_total = 0
    continued = 0
    with _VISION_LOCK:
        _VISION_QUEUE.clear()   # obrazy z innych dróg (mostek, poprzednia tura) nie trafiają do tej tury
    _vision_detach(messages)
    for _step in range(max_steps):
        if SESSION.get("spend_cap") is not None and SESSION["spent"] >= SESSION["spend_cap"]:
            print(yellow(_L("  Budżet kredytów tej pracy wyczerpany.")))
            return False
        if compact_history(messages):
            print(dim(_L("  (uporządkowano starszy kontekst rozmowy)")))
        if sum(_content_len(m) for m in messages) > 300_000 or len(messages) > 200:
            print(red(_L("✗ Kontekst jest zbyt duży. Skróć ostatnią wiadomość lub użyj /clear.")))
            return False
        body = {"messages": messages}
        if tools:
            body["tools"] = tools   # pusta lista narzędzi (czat) bywa odrzucana przez API
        if model:
            body["model"] = model
        if provider() == "domaai" and not endpoint_model(model) and current_effort() != "medium":
            body["effort"] = current_effort()
        LIVE.status(_thinking_label(_step, SESSION.get("last_tool", "")), "")
        img_budget = None
        if provider() == "domaai" and not endpoint_model(model):
            img_budget = 290_000 - sum(_content_len(m) for m in messages)   # serwer liczy znaki treści (300 tys.)
        n_img = _vision_attach(messages, img_budget) if _VISION_QUEUE else 0
        try:
            try:
                with Spinner():
                    resp = api_step(creds, body)
            except ApiError as e:
                if not n_img or e.status not in (400, 413, 415, 422, 502):   # 502: serwer DomaAI po odmowie dostawcy
                    raise
                # model bez obsługi obrazów (albo obraz za duży u dostawcy): ten sam krok bez obrazu
                _vision_detach(messages, "(Model nie przyjął obrazu; masz tylko opis z read_file.)")
                with Spinner():
                    resp = api_step(creds, body)
        except ApiError as e:
            _vision_detach(messages)
            _step_error(e)
            return False
        except (urllib.error.URLError, TimeoutError, OSError) as e:
            _vision_detach(messages)
            SESSION["turn_error"] = "net"
            print(red("✗ ") + describe_error(e))
            return False
        except BaseException:
            _vision_detach(messages)
            raise
        _vision_detach(messages)
        spent = int(resp.get("credits_spent") or 0)
        spent_total += spent
        SESSION["spent"] += spent
        SESSION["steps"] += 1
        SESSION["turn_steps"] += 1
        SESSION["turn_spent"] = SESSION.get("turn_spent", 0) + spent
        LIVE.add_tokens(int(((resp.get("usage") or {}).get("completion_tokens")) or 0))
        SESSION["model"] = resp.get("model") or SESSION["model"]
        if resp.get("credits_remaining") is not None:
            SESSION["remaining"] = resp.get("credits_remaining")
        msg = resp["message"]
        # Dostawca bez id wywołania (część serwerów zgodnych z OpenAI): własne, unikalne id. Do 0.28.0
        # zastępowała je nazwa narzędzia, dwa read_file miały to samo id i następny krok kończył się 400.
        seen_ids: set = set()
        for tc in msg.get("tool_calls") or []:
            if isinstance(tc, dict) and (not tc.get("id") or tc.get("id") in seen_ids):
                tc["id"] = "call_" + os.urandom(12).hex()
            if isinstance(tc, dict):
                seen_ids.add(tc["id"])
        messages.append(msg)
        if resp.get("thinking"):
            SYNC.add("thinking", {"sekundy": 0, "tekst": str(resp["thinking"])[-4000:]})

        content = (msg.get("content") or "").strip()
        tool_calls = msg.get("tool_calls") or []

        if content:
            _print_assistant(content)
        if not tool_calls and resp.get("finish_reason") == "length" and continued < 2:
            # Odpowiedź ucięta na limicie tokenów: dalszy ciąg zamiast udawania, że to koniec.
            continued += 1
            messages.append({"role": "user", "_codo_continue": True,
                             "content": "(Twoja odpowiedź została ucięta na limicie długości. "
                             "Kontynuuj dokładnie od miejsca przerwania, bez powtarzania.)"})
            continue
        if not tool_calls:
            if not _tty():
                rem = resp.get("credits_remaining")
                rem_s = f" · saldo {rem} kr" if rem is not None else ""
                print(_Lf('\n  {0} kr za turę{1}', spent_total, rem_s))
            return True

        done: set = set()
        with _VISION_LOCK:
            _VISION_QUEUE.clear()
        try:
            early = _parallel_reads(tool_calls, mode)
            for tc in tool_calls:
                fn = tc.get("function") or {}
                name = fn.get("name") or "?"
                tc_id = tc.get("id") or name
                raw = fn.get("arguments") or "{}"
                try:
                    args = json.loads(raw) if isinstance(raw, str) else dict(raw)
                    if not isinstance(args, dict):
                        raise ValueError("not an object")
                except (ValueError, TypeError):
                    # Najczęściej ucięty JSON (model skończył limit tokenów
                    # w środku dużego pliku). Mówimy mu to wprost.
                    print(f"\n{yellow(_tool_icon(name))} {bold(_TOOL_VERBS.get(name, name))} {dim(_L('(ucięte argumenty, proszę o mniejsze kroki)'))}")
                    messages.append({"role": "tool", "tool_call_id": tc_id, "content": (
                        "BŁĄD: argumenty narzędzia nie są poprawnym JSON-em (prawdopodobnie "
                        "ucięte, bo odpowiedź była za długa). Podziel zmianę na mniejsze "
                        "kroki: edit_file / multi_edit zamiast całego pliku naraz.")})
                    done.add(tc_id)
                    continue
                verb = _TOOL_VERBS.get(name, name)
                header = _tool_header(name, args)
                hint = _terminal_text(_tool_hint(name, args))
                LIVE.status(verb + (" " + hint if hint else ""))
                LIVE.tool_begin(header, _tool_icon(name), _tool_detail(name, args), name=name, args=args)
                seq_before = _EDIT_SEQ[0]
                authorized = _authorized_install_call(name, args, messages)
                if mode == "read":
                    allowed = (_READ_ONLY_TOOLS | {"todo_write"} | _TEAM_TOOL_NAMES
                               | ({"process"} if args.get("action") in ("list", "output") else set())
                               | ({"task"} if str(args.get("kind") or "explore") != "general" else set()))
                    result = (early.get(tc_id) or run_tool(name, args, False) if name in allowed else
                              "ODRZUCONE: aktywny tryb tylko do odczytu; zmień tryb /mode.")
                else:
                    result = early.get(tc_id) or run_tool(name, args, auto_yes or authorized)
                shown_full = result
                if name == "render" and not result.startswith(("BŁĄD", "ODRZUCONE")) and len(result) > 4000:
                    # Pełny HTML z wklejonymi zasobami idzie tylko do podglądu; modelowi wystarczy potwierdzenie
                    # (do 0.28.0 każde render dokładało do 60 tys. znaków do każdego kolejnego kroku).
                    result = (f"Podgląd wyrenderowany ({len(result) // 1000} tys. znaków z wklejonymi zasobami) "
                              "i pokazany użytkownikowi. Początek:\n" + result[:1500])
                elif name not in ("read_raw", "read_text") and len(result) > _AGENT_RESULT_CAP:
                    result = _clip_middle(result, _AGENT_RESULT_CAP)
                new_edits = [e for e in EDIT_LOG if e["seq"] > seq_before]
                failed = result.startswith(("BŁĄD", "ODRZUCONE"))
                if name == "todo_write" and not failed:
                    shown_lines = _todo_lines(result)
                elif name == "task" and not failed:
                    shown_lines = _task_lines(result)
                else:
                    shown_lines = [] if new_edits and not failed else _result_lines(name, result, name in show_results)
                LIVE.tool_end(not failed, header, shown_lines, name=name,
                              collapse=not new_edits and name not in show_results
                              and name not in ("todo_write", "task"), full=shown_full)
                for entry in new_edits:
                    _print_edit(entry)
                    if entry["path"] not in SESSION["edited"]:
                        SESSION["edited"].append(entry["path"])
                SESSION["last_tool"] = verb + (" " + hint if hint else "")
                LIVE.status(detail=(_L("Ostatnio: ") + SESSION["last_tool"])[:120])
                messages.append({"role": "tool", "tool_call_id": tc_id, "content": result})
                done.add(tc_id)
                if result.startswith("ODRZUCONE przez użytkownika"):
                    for pending in tool_calls:
                        pending_id = pending.get("id") or (pending.get("function") or {}).get("name") or "?"
                        if pending_id not in done:
                            messages.append({"role": "tool", "tool_call_id": pending_id,
                                             "content": "ANULOWANE: użytkownik odmówił wykonania kroku. Poczekaj na nowe wskazówki."})
                            done.add(pending_id)
                    print(dim(_L("  Działanie anulowane. Napisz, co mam zrobić inaczej.")))
                    return False
        except BaseException as exc:
            # Każde tool_call musi mieć odpowiedź, inaczej następny krok
            # odrzuci dostawca modelu i rozmowa jest zepsuta do /clear. Także przy błędzie
            # w samym Codo (do 0.28.0 łapany był tylko Ctrl+C i zapisywała się zepsuta historia).
            why = ("PRZERWANE przez użytkownika (Ctrl+C)." if isinstance(exc, KeyboardInterrupt)
                   else f"BŁĄD Codo przy wykonaniu narzędzia: {type(exc).__name__}: {exc}"[:400])
            for tc in tool_calls:
                tc_id = tc.get("id") or (tc.get("function") or {}).get("name") or "?"
                if tc_id not in done:
                    messages.append({"role": "tool", "tool_call_id": tc_id, "content": why})
                    done.add(tc_id)
            raise
    print(yellow(_Lf('  Zatrzymano po {0} krokach.', max_steps)) + dim(_L(" Napisz ‘kontynuuj’, aby pracować dalej.")))
    return False


def _kroki(n: int) -> str:
    if ui_lang() == "en":
