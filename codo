            _app_emit("google", agenci=load_settings().get("google_agenci") is not False,
                      **{k: v for k, v in stan.items() if k != "narzedzia"})
        elif kind == "imessage":
            con, blad = _imsg_polacz()
            if con is not None:
                con.close()
            _app_emit("imessage", dostep=con is not None, brak_bazy=not _imsg_baza().exists())
        elif kind == "konektory":
            akcja = str(msg.get("akcja") or "")
            kid = str(msg.get("id") or "")
            try:
                if akcja == "polacz" and kid:
                    if isinstance(msg.get("pola"), dict):
                        konektor_polacz(kid, pola=msg["pola"])
                    else:
                        url = konektor_polacz(kid, domena=str(msg.get("domena") or "")).get("url") or ""
                        _app_emit("konektor_url", id=kid, url=url)
                elif akcja == "odlacz" and kid:
                    konektor_odlacz(kid)
            except ApiError as e:
                _app_emit("konektory", id=kid, blad=str(e)[:300], **{k: v for k, v in konektory_stan().items() if k != "narzedzia"})
                continue
            except Exception:  # noqa: BLE001 — brak sieci
                pass
            stan = konektory_stan(odswiez=True)
            _app_emit("konektory", **{k: v for k, v in stan.items() if k != "narzedzia"},
                      narzedzia_liczba=len(stan.get("narzedzia") or []))
        elif kind == "company":
            if "key" in msg:
                key = str(msg.get("key") or "").strip()
                if key and not key.startswith("dfk_"):
                    _app_emit("company", blad=_L("To nie jest klucz firmy (zaczyna się od dfk_)."))
                    continue
                prev = load_firma()
                save_firma(key or None)
            st = firma_stan()
            if "key" in msg and st.get("blad") and not st.get("offline") and msg.get("key"):
                save_firma(prev["klucz"] if prev else None)
            _app_emit("company", active=bool(load_firma()), **st)
        elif kind == "auto_update":
            # Okno Codo (Windows, Linux), Ustawienia → Aktualizacje: to samo co `codo update --auto on|off`,
            # sprawdzenie nowej wersji i instalacja (tylko gdy ten plik może się sam podmienić).
            if "on" in msg:
                st = load_settings()
                st["auto_update"] = bool(msg.get("on"))
                save_settings(st)

            def _upd(action: str) -> None:
                st = load_settings()
                tgt = str(_update_target()).replace("\\", "/")
                can = not (os.environ.get("CODO_NO_AUTO_UPDATE") or ".app/Contents/" in tgt or tgt.endswith("static/cli/doma")
                           or "site-packages" in tgt) and os.access(_update_target(), os.W_OK)
                out = {"on": st.get("auto_update") is not False, "can": can, "version": VERSION,
                       "latest": st.get("latest_version") or "", "checked_at": float(st.get("version_checked_at") or 0)}
                try:
                    if action in ("check", "install"):
                        out["newer"] = update_hint(force=True) or ""
                        out["checked_at"] = float(load_settings().get("version_checked_at") or 0)
                    if action == "install" and out.get("newer") and can:
                        data, ver = _fetch_update()
                        if data:
                            _install_update(data)
                            out["installed"] = ver or out["newer"]
                except Exception as exc:  # noqa: BLE001 — sieć albo zapis: okno pokazuje powód
                    out["error"] = str(exc)[:300] or exc.__class__.__name__
                _app_emit("auto_update", action=action, **out)
            threading.Thread(target=_upd, args=(str(msg.get("action") or ""),), daemon=True).start()
        elif kind == "backup":
            st = load_settings()
            if "model" in msg:
                st["backup_brain"] = str(msg.get("model") or "")
            if "off" in msg:
                st["backup_brain_off"] = bool(msg.get("off"))
            save_settings(st)
            _app_status()
        elif kind == "send":
            text = str(msg.get("text") or "").strip()
            if text:
                run_turn(text, chat=bool(msg.get("chat")), remote=bool(msg.get("remote")), queued_at=msg.get("_t"))
        elif kind == "workflow":
            # Workflow jako graf: węzły (start, agent, warunek) i połączenia. Każdy węzeł agenta to
            # osobna tura w tej samej rozmowie, na swoim modelu albo agencie; warunek pyta model
            # TAK/NIE i wybiera gałąź. Błąd albo Stop kończy całość. Stary format „steps” też działa.
            name = str(msg.get("name") or "Workflow")[:80]
            task = str(msg.get("input") or "").strip()
            nodes = [x for x in (msg.get("nodes") or []) if isinstance(x, dict) and x.get("id")]
            edges = [x for x in (msg.get("edges") or []) if isinstance(x, dict)]
            if not nodes:
                steps = [x for x in (msg.get("steps") or []) if isinstance(x, dict) and str(x.get("prompt") or "").strip()]
                nodes = [{"id": f"s{i}", "kind": "agent", **x} for i, x in enumerate(steps)]
                edges = [{"from": f"s{i}", "port": "out", "to": f"s{i + 1}"} for i in range(len(steps) - 1)]
            by_id = {str(n["id"]): n for n in nodes}
            incoming = {str(e.get("to")) for e in edges}
            queue = [str(n["id"]) for n in nodes if n.get("kind") == "start"] or \
                    [str(n["id"]) for n in nodes if str(n["id"]) not in incoming][:1]
            work = [n for n in nodes if n.get("kind") in ("agent", "condition")
                    and str(n.get("prompt") or "").strip()]
            # Krok „Wyślij”: wiadomość na kanał (Telegram, Discord, iMessage, powiadomienie) przez okno Codo.
            sends = [n for n in nodes if n.get("kind") == "send"]
            # Krok „Bot lub rój”: zadanie dla bota albo roju z okna Codo; jego wynik widzą następne kroki.
            swarms = [n for n in nodes if n.get("kind") == "swarm" and str(n.get("target") or "")]
            # Krok „Zespół”: zespół agentów Codo w tym projekcie; jego podsumowanie widzą następne kroki.
            teams = [n for n in nodes if n.get("kind") == "team"]
            work = work + swarms + teams
            if not queue or not (work or sends):
                continue
            uses_input = any("{{input}}" in str(n.get("prompt")) for n in work)
            ran, failed, first = 0, False, True
            visits: dict = {}
            carry: list = []       # wyniki botów i rojów dla następnego kroku agenta
            last_out = ""          # ostatni wynik: odpowiedź modelu albo roju
            while queue and ran < 40 and not failed:
                nid = queue.pop(0)
                node = by_id.get(nid)
                if not node:
                    continue
                visits[nid] = visits.get(nid, 0) + 1
                if visits[nid] > 5:      # pętla w grafie: najwyżej 5 przejść przez ten sam węzeł
                    continue
                kind_n, port = node.get("kind") or "agent", "out"
                title = str(node.get("title") or "")[:80]
                text = str(node.get("prompt") or "").strip()
                if kind_n == "swarm" and str(node.get("target") or ""):
                    zadanie = (text or "{{input}}").replace("{{input}}", task).replace("{{last}}", last_out.strip()).strip()
                    if not zadanie:
                        zadanie = task or last_out.strip()
                    _app_emit("workflow", name=name, node=nid, index=ran, total=len(work), title=title,
                              node_kind="swarm", model=str(node.get("target") or ""), prompt=zadanie, state="running")
                    r = _app_call("roj.uruchom", {"cel": str(node.get("target") or ""), "zadanie": zadanie}, timeout=4 * 3600)
                    ran += 1
                    wynik = str(r.get("tekst") or "").strip()
                    if r.get("error") or not wynik:
                        failed = True
                        _app_emit("workflow", name=name, node=nid, index=ran - 1, total=len(work), title=title,
                                  state="failed", node_kind="swarm",
                                  error=str(r.get("error") or _L("Nie dał wyniku.")))
                        break
                    last_out = wynik
                    carry.append(f"Wynik kroku „{title or 'Rój'}” ({r.get('nazwa') or 'rój'}):\n{wynik[:12000]}")
                    _app_emit("workflow", name=name, node=nid, index=ran, total=len(work), title=title,
                              node_kind="swarm", state="node_done", port="out")
                elif kind_n == "team":
                    goal = (text or "{{input}}").replace("{{input}}", task).replace("{{last}}", last_out.strip()).strip() \
                        or task or last_out.strip()
                    res = _team_workflow_node(node, goal, name, nid, ran, len(work), title)
                    ran += 1
                    if res.get("error"):
                        failed = True
                        _app_emit("workflow", name=name, node=nid, index=ran - 1, total=len(work), title=title,
                                  state="failed", node_kind="team", run_id=res.get("run_id") or "", error=res["error"])
                        break
                    last_out = res["summary"]
                    carry.append(f"Wynik kroku „{title or 'Zespół'}” (zespół {res['run_id']}):\n{res['summary'][:12000]}")
                    _app_emit("workflow", name=name, node=nid, index=ran, total=len(work), title=title,
                              node_kind="team", state="node_done", port="out", run_id=res["run_id"])
                elif kind_n == "send":
                    last = last_out or next((_msg_text(m) for m in reversed(messages) if m.get("role") == "assistant"
                                             and _msg_text(m)), "")
                    body = (text or "{{last}}").replace("{{input}}", task).replace("{{last}}", last.strip())
                    body = body.replace("{{wynik}}", last.strip()).strip()
                    kanal = str(node.get("channel") or "notification")
                    _app_emit("workflow", name=name, node=nid, index=ran, total=len(work), title=title,
                              node_kind="send", channel=kanal, state="sending")
                    r = _app_call("kanal.wyslij", {"kanal": kanal, "tekst": body,
                                                   "do": str(node.get("to") or "")}, timeout=90) if body else \
                        {"error": _L("Nie ma czego wysłać: poprzednie kroki nie dały odpowiedzi.")}
                    _app_emit("workflow", name=name, node=nid, index=ran, total=len(work), title=title,
                              node_kind="send", channel=kanal, state="node_done", port="out",
                              sent=body[:1500], to=str(node.get("to") or ""), error=str(r.get("error") or ""))
                elif kind_n in ("agent", "condition") and text:
                    # 0.27.0: model węzła tylko na jego turę (dawniej cmd_model zapisywał go w settings.json)
                    wanted = str(node.get("model") or "").strip()
                    prompt = text.replace("{{input}}", task).replace("{{last}}", last_out.strip())
                    if first and task and not uses_input:
                        prompt += "\n\n" + task
                    first = False
                    if carry:
                        prompt = "\n\n".join(carry) + "\n\n" + prompt
                        carry = []
                    if kind_n == "condition":
                        prompt = ("Decide this for the workflow, based on the conversation so far. Do not change any files.\n\n"
                                  + prompt + "\n\nAnswer with exactly one word on the first line: YES or NO. "
                                  "Then one short sentence saying why.")
                    _app_emit("workflow", name=name, node=nid, index=ran, total=len(work), title=title,
                              node_kind=kind_n, model=current_model(wanted or model), prompt=prompt, state="running")
                    ok = run_turn(prompt, echo=False, brain=wanted)
                    ran += 1
                    last_out = next((_msg_text(m) for m in reversed(messages) if m.get("role") == "assistant"
                                     and _msg_text(m)), "") if ok else last_out
                    if not ok:
                        failed = True
                        _app_emit("workflow", name=name, node=nid, index=ran - 1, total=len(work), title=title,
                                  model=current_model(wanted or model), state="failed")
                        break
                    if kind_n == "condition":
                        last = next((_msg_text(m) for m in reversed(messages) if m.get("role") == "assistant"
                                     and _msg_text(m)), "")
                        head = last.strip().split("\n", 1)[0].strip().upper().strip("*_ .!:")
                        yes = head.startswith(("YES", "TAK")) or (not head.startswith(("NO", "NIE"))
                                                                  and re.search(r"\b(YES|TAK)\b", last.upper()[:80]) is not None)
                        port = "yes" if yes else "no"
                    _app_emit("workflow", name=name, node=nid, index=ran, total=len(work), title=title,
                              state="node_done", port=port)
                for e in edges:
                    if str(e.get("from")) == nid and str(e.get("port") or "out") == port:
                        queue.append(str(e.get("to")))
            if not failed:
                _app_emit("workflow", name=name, index=ran, total=len(work), state="done")


# ── Subagenci (task) i lista zadań (todo_write) ───────────

_SUBAGENT_MAX = 4                 # tylu zwiadowców naraz
_SUBAGENT_STEPS = {"explore": 30, "general": 60}
_SUBAGENT_LOCK = threading.Lock()

_SUBAGENT_PROMPT = """Jesteś subagentem Codo. Główny agent zlecił Ci jedno konkretne zadanie \
w katalogu roboczym użytkownika. Nie widzisz rozmowy z użytkownikiem, masz tylko to zlecenie.
- Pracuj samodzielnie i do skutku, nie zadawaj pytań (nikt Ci nie odpowie).
- Zwiad (explore): tylko czytasz i szukasz (find_files, grep, read_file, outline, git_status, web_fetch). \
Przeszukuj szeroko, równolegle wołaj kilka narzędzi w jednym kroku.
- Na końcu ZWIĘZŁY raport dla głównego agenta: konkretne ścieżki z numerami linii, fakty, wnioski. \
Bez wstępów, bez powtarzania zlecenia. Raport to Twoja ostatnia wiadomość."""


def _subagent_tools(kind: str) -> list:
    blocked = {"task", "todo_write"}
    if kind == "explore":
        allowed = _READ_ONLY_TOOLS - {"wtyczka"}
        return [t for t in enabled_tools() if t["function"]["name"] in allowed]
    return [t for t in enabled_tools() if t["function"]["name"] not in blocked]


def _subagent_run(creds: dict, model: str | None, kind: str, prompt: str, auto_yes: bool,
                  progress: dict, idx: int) -> dict:
    """Jedna pętla subagenta bez własnego interfejsu; postęp w `progress[idx]`."""
    messages = [{"role": "system", "content": _SUBAGENT_PROMPT + _env_context(short=True) + _project_notes()},
                {"role": "user", "content": prompt}]
    tools = _subagent_tools(kind)
    allowed = {t["function"]["name"] for t in tools}
    steps = spent = 0
    for _step in range(_SUBAGENT_STEPS.get(kind, 30)):
        compact_history(messages)
        body = {"messages": messages, "tools": tools}
        if model:
            body["model"] = model
        try:
            resp = api_step(creds, body)
        except (ApiError, urllib.error.URLError, TimeoutError, OSError) as e:
            return {"ok": False, "report": f"BŁĄD subagenta: {describe_error(e)}", "steps": steps, "spent": spent}
        steps += 1
        s = int(resp.get("credits_spent") or 0)
        spent += s
        with _SUBAGENT_LOCK:
            SESSION["spent"] += s
            SESSION["steps"] += 1
            SESSION["turn_spent"] = SESSION.get("turn_spent", 0) + s
            if resp.get("credits_remaining") is not None:
                SESSION["remaining"] = resp.get("credits_remaining")
        LIVE.add_tokens(int(((resp.get("usage") or {}).get("completion_tokens")) or 0))
        msg = resp.get("message") or {}
        messages.append(msg)
        calls = msg.get("tool_calls") or []
        if not calls:
            return {"ok": True, "report": str(msg.get("content") or "").strip() or "(pusty raport)",
                    "steps": steps, "spent": spent}
        for tc in calls:
            fn = tc.get("function") or {}
            name = fn.get("name") or "?"
            try:
                args = json.loads(fn.get("arguments") or "{}") if isinstance(fn.get("arguments") or "{}", str) \
                    else dict(fn.get("arguments"))
            except ValueError:
                args, name = {}, "?"
            hint = _terminal_text(_tool_hint(name, args))
            progress[idx] = (_TOOL_VERBS.get(name, name) + (" " + hint if hint else ""))[:70]
            if name not in allowed:
                result = f"ODRZUCONE: narzędzie {name} niedostępne dla subagenta ({kind})."
            else:
                result = run_tool(name, args, auto_yes)
            if len(result) > 30_000:
                result = result[:30_000] + "\n… (obcięte)"
            messages.append({"role": "tool", "tool_call_id": tc.get("id") or name, "content": result})
    return {"ok": False, "report": "Subagent przekroczył limit kroków. Ostatnia wiadomość: "
            + str(next((m.get("content") for m in reversed(messages) if m.get("role") == "assistant"
                        and m.get("content")), "") or "")[:3000], "steps": steps, "spent": spent}


def t_task(args: dict, auto_yes: bool) -> str:
    """Subagenci: zwiad (explore) równolegle, wykonawca (general) po kolei."""
    import time
    from concurrent.futures import ThreadPoolExecutor
    kind = "general" if str(args.get("kind") or "explore").lower() in ("general", "wykonawca", "work") else "explore"
    raw = args.get("tasks")
    if not isinstance(raw, list) or not raw:
        raw = [{"prompt": args.get("prompt") or "", "description": args.get("description") or ""}]
    tasks = []
    for t in raw[:_SUBAGENT_MAX if kind == "explore" else 3]:
        if isinstance(t, str):
            t = {"prompt": t}
        if isinstance(t, dict) and str(t.get("prompt") or "").strip():
            tasks.append({"prompt": str(t["prompt"]), "description": str(t.get("description") or t["prompt"])[:60]})
    if not tasks:
        return "BŁĄD: podaj tasks=[{description, prompt}] (prompt = pełne, samodzielne zlecenie)."
    creds = SESSION.get("turn_creds") or load_creds()
    model = SESSION.get("turn_model")
    progress = {i: "startuje" for i in range(len(tasks))}
    results: list = [None] * len(tasks)
    t0 = time.monotonic()
    SESSION["agents_running"] = len(tasks)

    def show():
        rows = []
        for i, t in enumerate(tasks):
            mark = "✓" if results[i] else "◌"
            rows.append(f"{mark} {t['description']}" + ("" if results[i] else f" · {progress.get(i, '')}"))
        n = len(tasks)
        LIVE.status(f"{n} {_plural(n, (_L('subagent pracuje'), _L('subagenci pracują'), _L('subagentów pracuje')))}",
                    "\n".join(rows)[:400])
        emit_team()

    def emit_team(done: bool = False):
        # Okno Codo rysuje subagentów na żywo jako klony agenta (karta z orbami).
        if SESSION.get("app"):
            _app_emit("subagents", kind=kind, done=done, seconds=round(time.monotonic() - t0, 1),
                      items=[{"title": t["description"], "done": bool(results[i]),
                              "ok": bool(results[i] and results[i].get("ok")),
                              "progress": "" if results[i] else str(progress.get(i, ""))[:80]}
                             for i, t in enumerate(tasks)])

    try:
        if kind == "explore" and len(tasks) > 1:
            with ThreadPoolExecutor(max_workers=len(tasks)) as pool:
                futures = [pool.submit(_subagent_run, creds, model, kind, t["prompt"], False, progress, i)
                           for i, t in enumerate(tasks)]
                while not all(f.done() for f in futures):
                    for i, f in enumerate(futures):
                        if f.done() and results[i] is None:
                            results[i] = f.result()
                    SESSION["agents_running"] = sum(1 for f in futures if not f.done())
                    show()
                    time.sleep(0.25)
                for i, f in enumerate(futures):
                    results[i] = f.result()
        else:
            for i, t in enumerate(tasks):
                show()
                results[i] = _subagent_run(creds, model, kind, t["prompt"],
                                           auto_yes if kind == "general" else False, progress, i)
                SESSION["agents_running"] = len(tasks) - i - 1
    finally:
        SESSION["agents_running"] = 0
        LIVE.status(detail="")
        emit_team(done=True)
    took = _duration(time.monotonic() - t0)
    n, kr = len(tasks), sum(r["spent"] for r in results)
    out = [f"{n} {_plural(n, ('subagent', 'subagentów', 'subagentów'))} · {took} · "
           f"{_kroki(sum(r['steps'] for r in results))}" + (f" · {kr} kr" if kr else "")]
    for t, r in zip(tasks, results):
        out.append(f"\n## {t['description']} ({'ok' if r['ok'] else 'niedokończone'}, {_kroki(r['steps'])})\n{r['report']}")
    return "\n".join(out)


_TODO_ICON = {"pending": "☐", "in_progress": "◼", "completed": "☒"}


def t_todo_write(args: dict) -> str:
    todos = []
    for t in (args.get("todos") or [])[:30]:
        if isinstance(t, dict) and str(t.get("content") or "").strip():
            status = str(t.get("status") or "pending")
            todos.append({"content": str(t["content"]).strip()[:160],
                          "status": status if status in _TODO_ICON else "pending"})
    if not todos:
        return "BŁĄD: podaj todos=[{content, status: pending|in_progress|completed}]."
    SESSION["todos"] = todos
    SYNC.add("plan", {"kroki": [{"text": t["content"], "status": {"completed": "done", "in_progress": "doing"}
                                 .get(t["status"], "todo")} for t in todos]})
    done = sum(1 for t in todos if t["status"] == "completed")
    lines = [f"Lista zadań ({done}/{len(todos)})"]
    for t in todos:
        lines.append(f"{_TODO_ICON[t['status']]} {t['content']}")
    return "\n".join(lines)


def _task_lines(result: str) -> list:
    """Pod nagłówkiem subagentów: podsumowanie i po jednej linii na każdego."""
    lines = result.splitlines()
    out = [dim(lines[0])] if lines else []
    for line in lines[1:]:
        if line.startswith("## "):
            out.append(dim("✻ " + _terminal_text(line[3:])))
    return out


def _todo_lines(result: str) -> list:
    """Lista zadań pod nagłówkiem: zrobione przekreślone, bieżące pogrubione."""
    out = []
    for line in result.splitlines()[1:]:
        if line.startswith("☒"):
            out.append(dim("☒ \033[9m" + _terminal_text(line[2:]) + "\033[29m"))
        elif line.startswith("◼"):
            out.append(bold("◼ " + _terminal_text(line[2:])))
        else:
            out.append("☐ " + _terminal_text(line[2:]))
    return out or [dim(result[:200])]


