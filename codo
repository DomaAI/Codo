def _ui_file_roots() -> list:
    out = []
    for r in (Path.cwd(), CONFIG_DIR / "zalaczniki"):
        try:
            out.append(r.resolve())
        except (OSError, RuntimeError):
            pass
    return out


def _ui_file_raw_path(raw) -> Path | None:
    """Ścieżka od okna (względna do projektu, absolutna, ~, C:\\…, w cudzysłowie) bez sprawdzania miejsca."""
    raw = str(raw or "").strip()
    if len(raw) > 1 and raw[0] == raw[-1] and raw[0] in "\"'":
        raw = raw[1:-1].strip()
    if raw.startswith("file://"):
        raw = urllib.parse.unquote(urllib.parse.urlparse(raw).path)
        if re.match(r"^/[A-Za-z]:[/\\]", raw):
            raw = raw[1:]
    if not raw or "\x00" in raw or len(raw) > 4096:
        return None
    p = Path(os.path.expanduser(raw))
    if not p.is_absolute():
        p = Path.cwd() / p
    try:
        return p.resolve()
    except (OSError, RuntimeError, ValueError):
        return None


def _ui_file_path(raw) -> Path | None:
    """Plik, który okno może pokazać: w projekcie, w załącznikach albo dołączony wprost przez użytkownika."""
    p = _ui_file_raw_path(raw)
    if p is None:
        return None
    for root in _ui_file_roots() + list(_UI_FILE_EXTRA):
        if p == root or root in p.parents:
            return p
    return None


def _ui_file_info(p: Path) -> dict | None:
    try:
        st = p.stat()
    except OSError:
        return None
    cwd = Path.cwd().resolve()
    try:
        rel = p.relative_to(cwd).as_posix()
    except ValueError:
        rel = ""
    is_dir = p.is_dir()
    ext = "" if is_dir else p.suffix.lower().lstrip(".")
    info = {"ok": True, "path": str(p), "rel": rel, "name": p.name or str(p), "ext": ext, "dir": is_dir,
            "size": 0 if is_dir else st.st_size, "mtime": int(st.st_mtime),
            "attachment": (CONFIG_DIR / "zalaczniki").resolve() in p.parents}
    if is_dir:
        try:
            info["count"] = sum(1 for _ in p.iterdir())
        except OSError:
            info["count"] = 0
    return info


def _ui_file_kind(p: Path, head: bytes) -> str:
    ext = p.suffix.lower().lstrip(".")
    if ext in _UI_IMG_EXT:
        return "image"
    if ext == "pdf":
        return "pdf"
    if ext in ("md", "markdown", "mdx"):
        return "md"
    if ext in ("mp4", "webm", "mov", "m4v"):
        return "video"
    if ext in ("mp3", "wav", "m4a", "ogg", "aac", "flac"):
        return "audio"
    if b"\x00" in head[:8192]:
        return "binary"
    if ext in ("html", "htm"):
        return "html"
    return "text"


