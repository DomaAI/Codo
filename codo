               "next.config.js": "Next.js", "vite.config.ts": "Vite", "vite.config.js": "Vite"}
    try:
        info["project"] = sorted({v for k, v in markers.items() if (cwd / k).exists()})
        info["git"] = (cwd / ".git").exists()
    except OSError:
        info["project"], info["git"] = [], False
    _ENV_CACHE.update(info)
    return _ENV_CACHE


