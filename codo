def _setup_readline() -> None:
    try:
        import readline
    except ImportError:
        return  # Windows bez pyreadline: zwykły input()
    try:
        readline.read_history_file(str(HISTORY_FILE))
    except (OSError, ValueError):
        pass  # nosec B110 — pierwsza sesja albo uszkodzona historia
    readline.set_history_length(1000)

    def _save():
        try:
            CONFIG_DIR.mkdir(parents=True, exist_ok=True)
            readline.write_history_file(str(HISTORY_FILE))
        except OSError:
            pass  # nosec B110

    import atexit
    atexit.register(_save)

    def _complete(text, state):
        opts = [c for c in _SLASH if c.startswith(text)] if text.startswith("/") else []
        return opts[state] if state < len(opts) else None

    readline.set_completer(_complete)
    readline.set_completer_delims(" \t\n")
    if "libedit" in (getattr(readline, "__doc__", "") or ""):
        readline.parse_and_bind("bind ^I rl_complete")
        readline.parse_and_bind(r'bind -s "^T" "/mode\n"')
    else:
        readline.parse_and_bind("tab: complete")
        readline.parse_and_bind(r'"\C-t": "/mode\n"')


def _prompt() -> str:
    if not _tty() or "NO_COLOR" in os.environ or os.environ.get("TERM") == "dumb":
        return "> "
    # \001…\002 = znaki niewidoczne dla readline (inaczej źle liczy szerokość).
    return "\001\033[1;35m\002❯\001\033[0m\002 "


def _display_width(text: str) -> int:
    import unicodedata
    return sum(0 if unicodedata.combining(ch) else 2 if unicodedata.east_asian_width(ch) in ("W", "F") else 1 for ch in text)


def _input_view(value: str, cursor: int, width: int) -> tuple[str, int]:
    """A single visual row; long prompts and wide Unicode cannot wrap the editor."""
    width = max(1, width)
    start = cursor
    budget = max(0, width - 2)
    while start > 0 and _display_width(value[start - 1:cursor]) <= budget:
        start -= 1
    prefix = "‹" if start else ""
    visible = prefix
    for ch in value[start:]:
        if _display_width(visible + ch) > width:
            break
        visible += ch
    return visible, _display_width(prefix + value[start:cursor])


