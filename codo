def _team_place(m: dict, ctx: dict, iso_req: str = "copy") -> dict:
    """Izolacja, kopia, gałąź i pola stanu członka (start przebiegu i team_member_add)."""
    git, sub = bool(ctx.get("git")), ctx.get("subdir") or "."
    writes = bool(m.get("writes", True))
    if m.get("role") == "lead":
        iso = "integration" if git else "shared"
    elif not writes or iso_req == "readonly":
        iso = "readonly"
    elif git and iso_req == "copy":
        iso = "copy"
    else:
        iso = "shared"
    integ = ctx.get("integration_path") or ""
    if iso == "copy":
        wt, branch = Path(f"{integ}--{m['id']}"), f"{ctx['integration_branch']}--{m['id']}"
    elif git:
        wt, branch = Path(integ), ""
    else:
        wt, branch = Path(ctx["project"]), ""
    m.update(writes=writes and iso != "readonly", isolation=iso, worktree=str(wt), branch=branch,
             cwd=str(Path(wt) / sub) if sub != "." else str(wt), status="starting", doing="", task_id=None,
             spent_kr=0, turns=0, seconds=0, edits=0, pid=0, convo_id="", agent_sid="", inbox_seq=0,
             tools=_team_tools_mode(m.get("brain") or ""), error="",
             brain_label=brain_label(m.get("brain") or current_model(None)),
             budget_kr=int(m.get("budget_kr") or 0), max_turns=int(m.get("max_turns") or 30))
    return m


def _team_new_member(run: dict, spec: dict) -> dict:
    """Członek dobrany w trakcie (prowadzący albo człowiek): unikalne id i miejsce pracy."""
    ids = {m["id"] for m in run.get("members") or []} | {"lead", "all", "human"}
    base = _slug(str(spec.get("id") or spec.get("name") or "czlonek"))[:24] or "czlonek"
    mid, n = base, 2
    while mid in ids:
        mid, n = f"{base}-{n}", n + 1
    brain = str(spec.get("brain") or "")
    m = {"id": mid, "name": str(spec.get("name") or mid)[:60], "role": str(spec.get("role") or "")[:200],
         "instructions": str(spec.get("instructions") or "")[:4000], "brain": "" if brain == "mix" else brain,
         "writes": bool(spec.get("writes", True)), "budget_kr": int(spec.get("budget_kr") or 0),
         "max_turns": int(spec.get("max_turns") or 30)}
    return _team_place(m, run, "copy" if m["writes"] else "readonly")


def _team_create_run(cwd, goal: str, template: dict, overrides: dict | None = None, source: dict | None = None,
                     base: str = "head", shared: bool = False) -> tuple:
    """Zakłada .doma/zespoly/<run_id>/ (run.json, tablica z zadaniami startowymi, team_started). Kopie
    git tworzy dopiero nadzorca. Zwraca (run_dir, błąd)."""
    import secrets
    import time
    goal = str(goal or "").strip()
    if not goal:
        return None, _L("Podaj cel zespołu.")
    tpl, err = _team_template_check(template)
    if err:
        return None, err
    cwd = Path(cwd).resolve()
    code, top, _ = _git_in(cwd, "rev-parse", "--show-toplevel")
    in_git = code == 0 and bool(top)
    project = Path(top).resolve() if in_git else cwd
    sub = os.path.relpath(cwd, project) if in_git else "."
    git = in_git and not shared
    base_sha = base_branch = ""
    if git:
        if _git_in(project, "rev-parse", "--verify", "-q", "HEAD")[0]:
            return None, _L("Repozytorium nie ma jeszcze żadnego commita, więc nie da się zrobić kopii dla członków. "
                            "Zrób pierwszy commit albo uruchom zespół bez kopii (--bez-kopii).")
        base_sha = _git_in(project, "rev-parse", "HEAD")[1]
        base_branch = _git_in(project, "rev-parse", "--abbrev-ref", "HEAD")[1]
        if base == "worktree":
            stash = _git_in(project, "stash", "create")[1]   # niezatwierdzone zmiany jako punkt startu
            base_sha = stash or base_sha
    pol = {**_TEAM_POLICY, **(tpl.get("policy") or {})}
    for k, v in (overrides or {}).items():
        if v not in (None, ""):
            pol[k] = v
    if pol.get("mode") not in ("ask", "auto", "read"):
        pol["mode"] = "ask"
    pol["parallel"] = max(1, min(int(pol.get("parallel") or 3), _TEAM_MAX_MEMBERS))
    if pol.get("check_required") and not pol.get("check"):
        pol["check"] = _team_guess_check(project)
        if not pol["check"]:
            return None, _L("Ten szablon wymaga polecenia sprawdzającego. Podaj je: --check \"npm test\".")
    run_id = "z-" + time.strftime("%Y%m%d-%H%M") + "-" + secrets.token_hex(2)
    slug = _slug(tpl["name"] or goal)[:24].strip("-") or "zespol"
    stem = f"zespol-{slug}-{run_id[-4:]}"
    copies = Path.home() / ".codo" / "kopie" / project.name
    integ_path, integ_branch = copies / stem, f"codo/{stem}"
    run_dir = project / ".doma" / "zespoly" / run_id
    (run_dir / "log").mkdir(parents=True, exist_ok=True)
    mix = [""] + ["agent:" + k for k, _p in agents_available()]
    members, n_mix = [], 0
    if tpl["lead"] is not None:
        members.append({"id": "lead", "name": _L("Prowadzący"), "role": "lead", "brain": tpl["lead"].get("brain") or "",
                        "instructions": str(tpl["lead"].get("instructions") or ""), "writes": True,
                        "budget_kr": int(tpl["lead"].get("budget_kr") or 0),
                        "max_turns": int(tpl["lead"].get("max_turns") or 40)})
    for raw in tpl["members"]:
        for k in range(raw["copies"]):
            m = {key: raw[key] for key in ("name", "role", "instructions", "brain", "writes", "budget_kr", "max_turns")}
            m["id"] = raw["id"] if raw["copies"] == 1 else f"{raw['id']}-{k + 1}"
            if raw["copies"] > 1:
                m["name"] = f"{raw['name']} {k + 1}"
            m["_iso"] = raw["isolation"]
            members.append(m)
    ctx = {"git": git, "subdir": sub, "integration_path": str(integ_path), "integration_branch": integ_branch,
           "project": str(project)}
    for m in members:
        if m.get("brain") == "mix":
            m["brain"] = mix[n_mix % len(mix)]
            n_mix += 1
        _team_place(m, ctx, m.pop("_iso", "copy"))
    now = _team_now()
    run = {"version": 1, "id": run_id, "name": tpl["name"], "title": tpl["title"], "goal": goal,
           "status": "starting", "created": now, "updated": now, "finished": None, "heartbeat": "",
           "supervisor_pid": 0, "project": str(project), "subdir": sub, "git": git, "base_branch": base_branch,
           "base_sha": base_sha, "integration_branch": integ_branch if git else "",
           "integration_path": str(integ_path) if git else "", "policy": pol, "spent_kr": 0, "elapsed_s": 0,
           "control_offset": 0, "seq": 0, "source": {"kind": "terminal", "convo_id": "", "channel": "", "reply_to": "",
                                                     **(source or {})},
           "members": members, "pending_asks": [], "summary": ""}
    store = TeamStore(run_dir)
    store.save_run(run)
    store._write("board.json", {"tasks": [], "next_id": 1})
    if tpl["tasks"]:
        items = [{**x, "detail": str(x.get("detail") or "").replace("{{cel}}", goal),
                  "title": str(x.get("title") or "").replace("{{cel}}", goal[:80])} for x in tpl["tasks"]]
        _created, err = store.task_create("template", items)
        if err:
            return None, err
    st = store.state()
    st.pop("seq", None)
    store.append_event("team_started", state=st)
    return run_dir, ""


def _team_spawn_supervisor(run_dir) -> int:
    """Odłączony proces nadzorcy (przeżywa zamknięcie okna i terminala); wyjście w praca.log."""
    import shutil
    run = TeamStore(run_dir).load_run()
    cmd = [*_self_cmd(_team_script()), "team", "supervise", "--dir", str(run_dir)]
    if sys.platform == "darwin" and shutil.which("caffeinate") and (run.get("policy") or {}).get("background", True):
        cmd = ["caffeinate", "-i", *cmd]
    env = {**os.environ, "CODO_NO_CLEAR": "1", "DOMA_PLAIN": "1", "PYTHONUNBUFFERED": "1", "NO_COLOR": "1",
           "PYTHONIOENCODING": "utf-8"}   # praca.log czytany jako UTF-8 (na Windows potok/plik miał cp1252)
    for k in ("CODO_ZESPOL_DIR", "CODO_ZESPOL_CZLONEK", "CODO_ZESPOL_ROLA"):
        env.pop(k, None)
    kwargs = {"stdin": subprocess.DEVNULL, "env": env, "cwd": str(run.get("project") or Path(run_dir).parent)}
    if IS_WIN:
        kwargs["creationflags"] = 0x00000008 | 0x00000200   # DETACHED_PROCESS | CREATE_NEW_PROCESS_GROUP
    else:
        kwargs["start_new_session"] = True
    with open(Path(run_dir) / "praca.log", "ab") as log:
        kwargs["stdout"] = log
        kwargs["stderr"] = subprocess.STDOUT
        proc = subprocess.Popen(cmd, **kwargs)  # nosec B603 — własny program
    return proc.pid


def _team_sup_alive(run: dict) -> bool:
    return _pid_alive(run.get("supervisor_pid")) and _team_age(run.get("heartbeat")) < 30


# ── członek: proces codo app-server ──

class TeamMemberProc:
    """Członek zespołu: `codo app-server` w swojej kopii; zdarzenia idą do wspólnej kolejki nadzorcy."""

    def __init__(self, run_dir, member: dict, events_q, mode: str):
        self.run_dir, self.m, self.q, self.mode = Path(run_dir), member, events_q, mode
        self.proc = None

    def spawn(self) -> int:
        m = self.m
        env = dict(os.environ)
        for k in ("CODO_NO_HISTORY", "CODO_PROVIDER", "CODO_APP_AGENT", "CODO_UI_DEV"):
            env.pop(k, None)
        env.update({"CODO_APP_MODE": self.mode, "CODO_APP_LOCAL_ONLY": "1", "DOMA_NO_SYNC": "1",
                    "CODO_CLIENT": "team", "CODO_ZESPOL_DIR": str(self.run_dir), "CODO_ZESPOL_CZLONEK": m["id"],
                    "CODO_ZESPOL_ROLA": "lead" if m.get("role") == "lead" else "member",
                    "PYTHONUNBUFFERED": "1", "NO_COLOR": "1"})
        pin = _team_brain_provider(m.get("brain") or "")
        if pin:
            env["CODO_PROVIDER"] = pin
        cmd = [*_self_cmd(_team_script())] + (["--model", m["brain"]] if m.get("brain") else []) + ["app-server"]
        (self.run_dir / "log").mkdir(exist_ok=True)
        kw = {"cwd": m.get("cwd") or m.get("worktree"), "env": env, "stdin": subprocess.PIPE,
              "stdout": subprocess.PIPE}
        if IS_WIN:
            kw["creationflags"] = 0x00000200
        else:
            kw["start_new_session"] = True
        with open(self.run_dir / "log" / f"{m['id']}.err", "ab") as err:
            self.proc = subprocess.Popen(cmd, stderr=err, **kw)  # nosec B603 — własny program
        threading.Thread(target=self._read, daemon=True).start()
        return self.proc.pid

    def _read(self) -> None:
        proc = self.proc
        for raw in proc.stdout:
            try:
                ev = json.loads(raw.decode("utf-8", "replace"))
            except ValueError:
                continue
            if isinstance(ev, dict):
                self.q.put((self, ev))
        self.q.put((self, {"type": "_exit", "code": proc.wait()}))

    def send_raw(self, obj: dict) -> bool:
        try:
            self.proc.stdin.write((json.dumps(obj, ensure_ascii=False) + "\n").encode("utf-8"))
            self.proc.stdin.flush()
            return True
        except (OSError, ValueError, AttributeError):
            return False

    def send(self, text: str) -> bool:
        return self.send_raw({"type": "send", "text": text})

    def answer(self, ask_id, value: int) -> None:
        self.send_raw({"type": "answer", "id": str(ask_id), "value": int(value)})

    def interrupt(self) -> None:
        self.send_raw({"type": "interrupt"})

    def alive(self) -> bool:
        return self.proc is not None and self.proc.poll() is None

    def stop(self, wait: float = 5) -> None:
        if not self.proc:
            return
        try:
            self.proc.stdin.close()
        except (OSError, ValueError):
            pass
        try:
            self.proc.wait(timeout=wait)
        except subprocess.TimeoutExpired:
            _kill_tree(self.proc)


# ── nadzorca ──

class TeamSupervisor:
    """Pętla co 0,25 s: polecenia człowieka, zdarzenia członków, limity, plan, scalanie, przydział, wieści."""

    def __init__(self, run_dir, proc_factory=None):
        import queue
        import time
        self.dir = Path(run_dir)
        self.store = TeamStore(run_dir)
        self.factory = proc_factory or TeamMemberProc
        self.q = queue.Queue()
        self.procs: dict = {}
        self.rt: dict = {}
        self.run = self.store.load_run()
        self.pol = {**_TEAM_POLICY, **(self.run.get("policy") or {})}
        self.exit = False
        self.news: list = []
        self.seen: dict = {}
        self.stuck_wakes = 0
        self.merge_thread = None
        self.merge_result = None
        self.pending_emit: set = set()
        self.review_sent: set = set()
        self.review_seen: dict = {}
        self.plan_emit = False
        self.t0 = time.monotonic()
        self.elapsed0 = float(self.run.get("elapsed_s") or 0)
        self.last_save = self.last_beat = self.last_emit = 0.0

    # pomocnicze
    def member(self, mid):
        return next((m for m in self.run.get("members") or [] if m["id"] == mid), None)

    def lead(self):
        return self.member("lead")

    def lead_ok(self) -> bool:
        lead = self.lead()
        return bool(lead and self._alive(lead) and lead.get("status") not in _TEAM_DEAD)

    def elapsed(self) -> float:
        import time
        return self.elapsed0 + time.monotonic() - self.t0

    def save(self, force: bool = False) -> None:
        import time
        if not force and time.monotonic() - self.last_save < 1:
            return
        self.last_save = time.monotonic()
        self.run["elapsed_s"] = int(self.elapsed())
        cur = self.store._read("inbox.json", {})
        for m in self.run["members"]:
            m["inbox_seq"] = int(cur.get(m["id"]) or 0)
        self.store.save_run(self.run)

    def emit_member(self, m: dict) -> None:
        self.pending_emit.discard(m["id"])
        self.store.append_event("team_member", member=dict(m))

    def set_member(self, m: dict, **kw) -> None:
        changed = any(m.get(k) != v for k, v in kw.items())
        m.update(kw)
        if changed:
            self.emit_member(m)
            self.save()

    def set_status(self, status: str) -> None:
        self.run["status"] = status
        self.save(force=True)
        st = self.store.state()
        st.pop("seq", None)
        st.pop("run_id", None)
        self.store.append_event("team_state", **st)

    def mode_for(self, m: dict) -> str:
        if m.get("role") == "lead":
            return self.pol["mode"] if self.run.get("status") == "finishing" else "read"
        if not m.get("writes", True) or m.get("isolation") == "readonly":
            return "read"
        return self.pol["mode"]

    def roster(self) -> str:
        return "\n".join(f"- {m['id']}: {m['name']}, {m.get('role') or ''}, {m.get('brain_label') or ''}"
                         f"{'' if m.get('writes', True) else ', tylko odczyt'}" for m in self.run["members"])

    # start
    def boot(self) -> bool:
        run = self.run
        run["supervisor_pid"] = os.getpid()
        run["heartbeat"] = _team_now()
        resumed = run.get("status") != "starting"
        if run.get("status") == "paused":
            run["status"] = run.get("paused_from") or "running"
        if not resumed:
            err = self._setup()
            if err:
                self.finalize("failed", err)
                return False
        else:
            self._recover()
        for t in self.store.board()["tasks"]:
            self.seen[t["id"]] = t["status"]
        for m in run["members"]:
            if m.get("status") not in ("failed", "over_budget", "stopped", "done"):
                self._spawn(m, resumed)
        if not resumed:
            self.set_status("planning" if self.lead() else "running")
        else:
            self.set_status(run["status"])
        if self.plan_emit:
            self._emit_plan()
        self._emit_budget(False)   # limity od startu, zanim cokolwiek kosztuje
        return True

    def _setup(self) -> str:
        run = self.run
        if not run.get("git"):
            return ""
        proj = run["project"]
        _team_exclude(proj)
        err = _team_worktree_add(proj, run["integration_path"], run["integration_branch"], run["base_sha"])
        if err:
            return _L("Nie udało się utworzyć kopii integracyjnej: ") + err
        _team_copy_env(proj, run["integration_path"])
        paths = [run["integration_path"]]
        for m in run["members"]:
            if m.get("isolation") == "copy":
                err = _team_worktree_add(proj, m["worktree"], m["branch"], run["base_sha"])
                if err:
                    return _Lf("Nie udało się utworzyć kopii dla {0}: {1}", m["name"], err)
                _team_copy_env(proj, m["worktree"])
                paths.append(m["worktree"])
        for path in paths if str(self.pol.get("setup") or "").strip() else []:
            self._setup_copy(path)
        return ""

    def _setup_copy(self, path) -> None:
        setup = str(self.pol.get("setup") or "").strip()
        if not setup:
            return
        try:
            r = subprocess.run(setup, shell=True, cwd=path, capture_output=True, text=True, errors="replace", timeout=600,  # nosec B602: polecenie z szablonu użytkownika
                               stdin=subprocess.DEVNULL)
            ok, out = r.returncode == 0, ((r.stdout or "") + (r.stderr or ""))[-1500:]
        except (OSError, subprocess.SubprocessError) as exc:
            ok, out = False, str(exc)
        for m in self.run["members"]:
            if m.get("worktree") == path:
                m["setup"] = {"ok": ok, "output": out}
                if not ok:
                    m["error"] = _Lf("Przygotowanie kopii ({0}) nie przeszło", setup)

    def _recover(self) -> None:
        """Wznowienie: przerwane scalenie wraca do kolejki, otwarte zgody znikają (stare procesy nie żyją)."""
        run = self.run
        integ = run.get("integration_path")
        if run.get("git") and integ and _git_in(integ, "rev-parse", "-q", "--verify", "MERGE_HEAD")[0] == 0:
            _git_in(integ, "merge", "--abort")
        for t in self.store.board()["tasks"]:
            if t["status"] == "merging":
                self.store.patch_task(t["id"], status="merge_queue", merge={**t.get("merge", {}), "state": "queued"})
        run["pending_asks"] = []
        for m in run["members"]:
            if m.get("status") in ("working", "waiting_approval", "waiting_deps", "starting", "idle"):
                m["status"] = "starting"
        if run.get("status") == "planning" and run.get("plan_sent") and self.store.board()["tasks"]:
            waiting = self.pol.get("approve_plan") and not run.get("plan_approved")
            run["status"] = "waiting_human" if waiting else "running"
            self.plan_emit = bool(waiting)
        run["plan_sent"] = run.get("plan_sent") and run.get("status") != "planning"
        run["koniec_sent"] = False

    def _spawn(self, m: dict, resumed: bool) -> None:
        p = self.factory(self.dir, m, self.q, self.mode_for(m))
        try:
            pid = p.spawn()
        except (OSError, subprocess.SubprocessError) as exc:
            self.set_member(m, status="failed", error=str(exc)[:300])
            return
        self.procs[m["id"]] = p
        self.rt[m["id"]] = {"busy": False, "kind": "", "t0": 0.0, "texts": [], "credits": 0, "reminded": False,
                            "task": None, "rework0": set(), "ready": False, "killed": "", "delta": "", "delta_t": 0.0}
        self.set_member(m, pid=pid, status="starting", doing="", task_id=None)
        if resumed and m.get("convo_id"):
            p.send_raw({"type": "resume", "id": m["convo_id"]})

    # pętla
    def loop(self) -> None:
        while not self.exit:
            self.tick()

    def tick(self, wait: float = 0.25) -> None:
        import time
        self._apply_control()
        if self.exit:
            return
        self._drain(wait)
        self._merge_poll()
        if not self.exit:
            self._check_limits()
        if self.exit:
            return
        self._scan_board()
        status = self.run.get("status")
        lead = self.lead()
        if status == "planning":
            if lead and self._can_send(lead) and not self.run.get("plan_sent"):
                self.run["plan_sent"] = True
                self._send(lead, self._prompt_plan(), "plan")
            elif lead and self._can_send(lead) and self.run.get("plan_notes"):
                notes = self.run.pop("plan_notes")
                self._send(lead, _PROMPT_PLAN_POPRAWKA.format(notes=notes, board=self._board_text()), "plan_poprawka")
            elif not lead or lead.get("status") in _TEAM_DEAD:
                self.set_status("running")
        elif status in ("running", "merging"):
            self._review_step()
            self._merge_start()
            self._assign()
            self._wake_lead()
            if status == "running":
                self._maybe_finish()
            elif not self.merge_thread and not any(rt.get("busy") for rt in self.rt.values()) and not any(
                    t["status"] in ("merge_queue", "merging", "in_progress", "review") for t in self.store.board()["tasks"]):
                self.set_status("running")   # merge=at_end: kolejka scaleń pusta, dalej zwykłe zakończenie
        elif status == "finishing":
            if lead and self._can_send(lead) and not self.run.get("koniec_sent"):
                self.run["koniec_sent"] = True
                self.procs[lead["id"]].send_raw({"type": "mode", "mode": self.pol["mode"]})
                self._send(lead, self._prompt_koniec(), "koniec")
            elif not lead or not self._alive(lead) or lead.get("status") in ("failed", "over_budget", "stopped") \
                    or (self.run.get("koniec_sent") and not self.rt[lead["id"]]["busy"]):
                self.finalize()
        now = time.monotonic()
        if now - self.last_emit >= 1:
            self.last_emit = now
            for mid in list(self.pending_emit):
                m = self.member(mid)
                if m:
                    self.emit_member(m)
        if now - self.last_beat >= 5:
            self.last_beat = now
            self.run["heartbeat"] = _team_now()
            self.save(force=True)
            try:
                if (self.dir / "live.jsonl").stat().st_size > 4_000_000:
                    (self.dir / "live.jsonl").write_text("")
            except OSError:
                pass  # nosec B110
        else:
            self.save()

    def _alive(self, m) -> bool:
        p = self.procs.get(m["id"])
        return bool(p and p.alive())

    def _can_send(self, m) -> bool:
        rt = self.rt.get(m["id"]) or {}
        return self._alive(m) and rt.get("ready") and not rt.get("busy") and \
            m.get("status") not in ("failed", "over_budget", "stopped", "waiting_approval")

    def _apply_control(self) -> None:
        cmds, off = self.store.read_control(int(self.run.get("control_offset") or 0))
        if off == self.run.get("control_offset"):
            return
        self.run["control_offset"] = off
        for c in cmds:
            kind = c.get("type")
            if kind == "answer":
                ask = next((a for a in self.run.get("pending_asks") or [] if a["ask_id"] == c.get("ask_id")), None)
                if not ask:
                    continue
                mid, local = ask["ask_id"].split(":", 1)
                value = int(c.get("value") or 0)
                if mid in self.procs:
                    self.procs[mid].answer(local, value)
                self.run["pending_asks"].remove(ask)
                self.store.append_event("team_ask_done", ask_id=ask["ask_id"], value=value,
                                        by=str(c.get("by") or "terminal"))
                m = self.member(mid)
                if m and m.get("status") == "waiting_approval":
                    self.set_member(m, status="working")
            elif kind == "stop":
                self.finalize("stopped", _L("Zatrzymane przez człowieka."))
                return
            elif kind == "pause":
                self.pause()
                return
            elif kind == "finish":
                self.run["finish_requested"] = True
                if c.get("summary"):
                    self.run["summary"] = str(c["summary"])[:8000]
            elif kind == "plan_decide":
                self._plan_decide(c)
            elif kind == "merge_decide":
                self._merge_decide(c)
            elif kind == "member_add":
                self._member_add(c.get("member") if isinstance(c.get("member"), dict) else {}, str(c.get("by") or "human"))
            elif kind == "member_stop":
                self._member_stop(str(c.get("member") or ""), str(c.get("by") or "human"))
            elif kind == "question":
                q = {"id": str(c.get("id") or ""), "from": str(c.get("frm") or "lead"), "text": str(c.get("text") or "")[:4000],
                     "options": [str(o)[:200] for o in c.get("options") or [] if str(o).strip()][:8]}
                self.run.setdefault("pending_questions", []).append({**q, "ts": c.get("ts") or _team_now()})
                self.store.append_event("team_question", **q)
            elif kind == "answered":
                for q in [q for q in self.run.get("pending_questions") or []
                          if (c.get("id") and q["id"] == c.get("id")) or (not c.get("id") and q["from"] == c.get("to"))]:
                    self.run["pending_questions"].remove(q)
                    self.store.append_event("team_question_done", id=q["id"], by=str(c.get("by") or "human"))
            if self.exit:
                return
        self.save(force=True)

    def _drain(self, wait: float) -> None:
        import queue
        import time
        while True:
            try:
                proc, ev = self.q.get(timeout=wait)
            except queue.Empty:
                break
            wait = 0
            mid = proc.m["id"]
            if self.procs.get(mid) is proc:
                self._on_event(mid, ev)
        now = time.monotonic()
        for mid, rt in self.rt.items():
            if rt["delta"] and now - rt["delta_t"] >= 0.2:
                self._flush_delta(mid)

    def _flush_delta(self, mid) -> None:
        import time
        rt = self.rt[mid]
        if rt["delta"]:
            self.store.live(mid, {"type": "delta", "tekst": rt["delta"]})
        rt["delta"], rt["delta_t"] = "", time.monotonic()

    def _on_event(self, mid: str, ev: dict) -> None:
        m, rt, kind = self.member(mid), self.rt[mid], ev.get("type")
        if kind == "delta":
            rt["delta"] += str(ev.get("tekst") or "")
            return
        if kind != "_exit":
            try:
                self.store._append(f"log/{mid}.jsonl", ev)
            except OSError:
                pass  # nosec B110
        if kind in _TEAM_FORWARD:
            self._flush_delta(mid)
            self.store.live(mid, ev)
        if kind == "ready":
            rt["ready"] = True
            if m.get("status") == "starting":
                self.set_member(m, status="idle")
        elif kind == "turn_start":
            if ev.get("convo_id") and m.get("convo_id") != ev["convo_id"]:
                m["convo_id"] = ev["convo_id"]
                # Od razu na dysk: nadzorca zabity (kill -9, zamknięty laptop) przed następnym zapisem run.json
                # wznawiał członka bez jego rozmowy, bo convo_id było tylko w pamięci.
                self.save(force=True)
        elif kind == "assistant":
            rt["texts"].append(str(ev.get("tekst") or ""))
        elif kind in ("tool_start", "tool"):
            m["doing"] = _plain(str(ev.get("naglowek") or ""))[:160]
            self.pending_emit.add(mid)
        elif kind == "edit":
            m["edits"] = int(m.get("edits") or 0) + 1
            m["doing"] = _Lf("Edytuje {0}", ev.get("plik") or "")[:160]
            self.pending_emit.add(mid)
        elif kind == "error":
            m["error"] = str(ev.get("tekst") or "")[:400]
            self.pending_emit.add(mid)
        elif kind == "fallback":
            self.set_member(m, brain_label=str(ev.get("label") or m.get("brain_label") or ""))
        elif kind == "ask":
            ask = {"ask_id": f"{mid}:{ev.get('id')}", "member": mid, "pytanie": ev.get("pytanie") or "",
                   "szczegol": ev.get("szczegol") or "", "powod": ev.get("powod") or "", "opcje": ev.get("opcje") or []}
            self.run.setdefault("pending_asks", []).append(ask)
            self.store.append_event("team_ask", **ask)
            self.set_member(m, status="waiting_approval")
            self.save(force=True)
        elif kind == "turn_end":
            self._turn_end(m, ev)
        elif kind == "_exit":
            self._member_exit(m, ev)

    def _drop_asks(self, mid: str) -> None:
        for a in [a for a in self.run.get("pending_asks") or [] if a["member"] == mid]:
            self.run["pending_asks"].remove(a)
            self.store.append_event("team_ask_done", ask_id=a["ask_id"], value=0, by="nadzorca")

    def _send(self, m: dict, text: str, kind: str, task_id=None) -> bool:
        import time
        p = self.procs.get(m["id"])
        if not p or not p.alive():
            return False
        if m.get("tools") == "text":
            text = (f"[Zespół Codo · Ty: `{m['id']}` ({m['name']}) · folder {m.get('cwd')}]\n" + text + _TEAM_TEXT_MODE)
        rt = self.rt[m["id"]]
        board = self.store.board()
        rt.update(busy=True, kind=kind, t0=time.monotonic(), texts=[], killed="", task=task_id,
                  rework0={t["id"] for t in board["tasks"] if t.get("claimed_by") == m["id"]
                           and t["status"] == "in_progress" and t["id"] != task_id})
        if not p.send(text):
            rt["busy"] = False
            return False
        self.set_member(m, status="working", task_id=task_id, doing="")
        return True

    # koniec tury
    def _turn_end(self, m: dict, ev: dict) -> None:
        mid, rt = m["id"], self.rt[m["id"]]
        credits = int(ev.get("credits") or 0)
        delta = max(0, credits - rt["credits"])
        rt["credits"] = credits
        m["spent_kr"] = int(m.get("spent_kr") or 0) + delta
        self.run["spent_kr"] = int(self.run.get("spent_kr") or 0) + delta
        m["turns"] = int(m.get("turns") or 0) + 1
        m["seconds"] = round(float(m.get("seconds") or 0) + float(ev.get("seconds") or 0), 1)
        if ev.get("convo_id"):
            m["convo_id"] = ev["convo_id"]
        if delta:
            self._emit_budget()
        kind, killed, task_id = rt["kind"], rt["killed"], rt.get("task")
        text = "\n".join(rt["texts"])
        rt.update(busy=False, kind="", texts=[])
        self._drop_asks(mid)
        m["doing"] = ""
        if self.run.get("status") in _TEAM_RUN_END + ("paused",):
            self.emit_member(m)
            return
        if (m.get("budget_kr") and m["spent_kr"] >= m["budget_kr"]) or m.get("status") == "over_budget":
            killed = killed or _L("budżet członka wyczerpany")
            m["status"] = "over_budget"
        blk = _team_parse_block(text) if m.get("tools") == "text" else None
        if kind == "plan" and ev.get("ok") is False and not self.store.board()["tasks"]:
            self.finalize("failed", _Lf("Prowadzący nie ułożył planu: {0}", m.get("error") or _L("tura się nie udała")))
            return
        if kind in ("plan", "plan_poprawka", "wiesci", "wiadomosci"):
            self._apply_block(m, blk)
            if kind in ("plan", "plan_poprawka") and self.run.get("status") == "planning":
                self._plan_done(text)
        elif kind in ("przeglad", "przeglad_przyp"):
            self._apply_block(m, blk)
            if self._review_turn_end(m, blk, text, kind, task_id):
                self.save()
                return
        elif kind == "koniec":
            self._apply_control()   # team_finish z tej tury (podsumowanie) mógł jeszcze nie zostać odczytany
            if self.exit:
                return
            self._apply_block(m, blk)
            if not self.run.get("summary"):
                self.run["summary"] = str((blk or {}).get("result") or text.strip())[-4000:]
            if self.run.get("git"):
                _team_commit_all(self.run["integration_path"], "zespół: poprawki prowadzącego")
            self.finalize()
            return
        elif kind:
            self._task_turn_end(m, blk, text, ev.get("ok") is not False, killed)
            if rt["busy"]:   # przypomnienie już wysłane
                self.save()
                return
        if m.get("status") not in ("over_budget", "failed", "stopped"):
            m["status"] = "idle"
        m["task_id"] = None
        self.emit_member(m)
        self.save()

    def _apply_block(self, m: dict, blk) -> None:
        if not blk:
            return
        for msg in blk.get("messages") or []:
            if isinstance(msg, dict) and msg.get("text"):
                self.store.send(m["id"], msg.get("to") or "lead", msg.get("text"), msg.get("task_id") or "")
        items = [x for x in blk.get("tasks") or [] if isinstance(x, dict)]
        if items and (m.get("role") == "lead" or self.pol.get("members_create_tasks")):
            _c, err = self.store.task_create(m["id"], items)
            if err and m.get("role") != "lead":
                self.news.append(f"{m['name']}: {err}")

    def _task_turn_end(self, m: dict, blk, text: str, ok: bool, killed: str) -> None:
        mid, rt = m["id"], self.rt[m["id"]]

        def mine():
            return [t for t in self.store.board()["tasks"] if t.get("claimed_by") == mid
                    and t["status"] == "in_progress" and t["id"] not in rt["rework0"]]
        open_ = mine()
        if blk and open_:
            tid = str(blk.get("id") or "") if any(t["id"] == blk.get("id") for t in open_) else open_[0]["id"]
            _t, err = self.store.task_update(mid, tid, str(blk.get("status") or "done"),
                                             str(blk.get("result") or ""), str(blk.get("notes") or ""))
            if err:
                self.news.append(f"{m['name']} ({tid}): {err}")
        self._apply_block(m, blk)
        open_ = mine()
        if open_ and killed:
            for t in open_:
                self.store.patch_task(t["id"], status="failed", result=_Lf("Przerwane: {0}.", killed))
                self.news.append(_Lf("{0} {1} przerwane: {2}", t["id"], t["title"], killed))
            open_ = []
        if open_ and ok and len(text.strip()) >= 10 and not blk:
            for t in open_:   # bez wywołania team_task_update: ostatnia wiadomość jako wynik
                self.store.task_update(mid, t["id"], "done", text.strip()[-4000:])
            open_ = mine()
        if open_:
            if not rt["reminded"] and m.get("status") != "over_budget":
                rt["reminded"] = True
                self._send(m, _PROMPT_PRZYPOMNIJ.format(ids=", ".join(t["id"] for t in open_)), "przypomnienie",
                           open_[0]["id"])
                return
            for t in open_:
                self.store.patch_task(t["id"], status="failed",
                                      result=t.get("result") or _L("Członek nie zakończył zadania."))
        rt["reminded"] = False
        self._commit_done(m)

    def _commit_done(self, m: dict) -> None:
        """Zadania gotowe do scalenia: commit w kopii członka; bez nowych zmian zadanie jest od razu gotowe."""
        queued = [t for t in self.store.board()["tasks"] if t.get("claimed_by") == m["id"]
                  and t["status"] == "merge_queue" and not t.get("commit")]
        if not queued:
            return
        if not (self.run.get("git") and m.get("isolation") == "copy"):
            for t in queued:
                self.store.patch_task(t["id"], status="done")
            return
        wt, integ = m["worktree"], self.run["integration_branch"]
        if _git_in(wt, "rev-parse", "-q", "--verify", "MERGE_HEAD")[0] == 0:
            # konflikt rozwiązywany u wykonawcy: bez znaczników można zatwierdzić scalenie, inaczej kolejna próba
            changed = _git_in(wt, "diff", "--name-only", "HEAD")[1].splitlines()
            left = [f for f in changed if _team_markers(Path(wt) / f)]
            if left:
                _git_in(wt, "merge", "--abort")
                for t in queued:
                    tries = int(t.get("attempts") or 0) + 1
                    self.store.patch_task(t["id"], status="failed" if tries > 3 else "in_progress", attempts=tries,
                                          merge={**t.get("merge", {}), "state": "conflict", "conflicts": left[:50]},
                                          **({"result": _L("Konflikt nierozwiązany po 3 próbach.")} if tries > 3 else {}))
                    self.store.append_event("team_merge", task_id=t["id"], member=m["id"], state="conflict",
                                            files=left[:50], conflicts=left[:50])
                return
        t = queued[-1]
        sha = _team_commit_all(wt, f"zespół {t['id']}: {t['title']}")
        new = _git_in(wt, "merge-base", "--is-ancestor", sha, integ)[0] != 0
        for t in queued:
            if new:
                files = _git_in(wt, "diff", "--name-only", f"{integ}...{sha}")[1].splitlines()[:200]
                t = self.store.patch_task(t["id"], commit=sha, merge={**t.get("merge", {}), "files": files})
                self._after_work(t, m)
            else:
                self.store.patch_task(t["id"], status="done", merge={**t.get("merge", {}), "state": "merged"})
                self.store.append_event("team_merge", task_id=t["id"], member=m["id"], state="merged",
                                        files=[], conflicts=[], sha="")

    def _after_work(self, t: dict, m: dict) -> None:
        """Po commicie: przegląd, zgoda człowieka (approve_merge=each) albo od razu kolejka scaleń."""
        rv = t.get("review") or {}
        if (t.get("needs_review") or self.pol.get("review") in ("lead", "cross")) and rv.get("verdict") != "approve" \
                and t.get("kind") not in ("research", "review"):
            self.store.patch_task(t["id"], status="review", review={**rv, "verdict": ""})
            self._review_step()
            return
        merge = t.get("merge") or {}
        state = "waiting_human" if self.pol.get("approve_merge") == "each" and not merge.get("approved") else "queued"
        self.store.patch_task(t["id"], merge={**merge, "state": state})
        self.store.append_event("team_merge", task_id=t["id"], member=m["id"], state=state,
                                files=merge.get("files") or [], conflicts=[])

    # przeglądy
    def _pick_reviewer(self, t: dict) -> str:
        ex = t.get("claimed_by")
        ok = [m for m in self.run["members"] if m.get("role") != "lead" and m["id"] != ex
              and m.get("status") not in _TEAM_DEAD and self._alive(m)]
        if self.pol.get("review") == "lead" or not ok:
            return "lead" if self.lead_ok() else ""
        pool = [m for m in ok if not m.get("writes", True)] or ok
        load = [x.get("reviewer") for x in self.store.board()["tasks"] if x["status"] == "review"]
        return min(pool, key=lambda m: load.count(m["id"]))["id"]

    def _review_step(self) -> None:
        """Zadania w przeglądzie dostają recenzenta (nowego, gdy poprzedni odpadł)."""
        for t in self.store.board()["tasks"]:
            if t["status"] != "review":
                continue
            rv = t.get("reviewer") or ""
            m = self.member(rv)
            ok = (rv == "lead" and self.lead_ok()) or (rv and rv != "lead" and rv != t.get("claimed_by") and m
                                                       and m.get("status") not in _TEAM_DEAD and self._alive(m))
            if not ok:
                rv = self._pick_reviewer(t)
                if not rv:
                    self.store.task_review("nadzorca", t["id"], "approve", _L("Nie ma kto przejrzeć: przegląd pominięty."))
                    continue
                t = self.store.patch_task(t["id"], reviewer=rv)
            key = (int((t.get("review") or {}).get("round") or 0), rv)
            if self.review_seen.get(t["id"]) != key:
                self.review_seen[t["id"]] = key
                self.store.append_event("team_merge", task_id=t["id"], member=t.get("claimed_by") or "", state="reviewing",
                                        files=(t.get("merge") or {}).get("files") or [], conflicts=[], reviewer=rv)

    def _next_review(self, mid: str):
        return next((t for t in self.store.board()["tasks"] if t["status"] == "review" and t.get("reviewer") == mid
                     and (t["id"], int((t.get("review") or {}).get("round") or 0)) not in self.review_sent), None)

    def _send_review(self, m: dict, t: dict) -> bool:
        self.review_sent.add((t["id"], int((t.get("review") or {}).get("round") or 0)))
        ex = self.member(t.get("claimed_by")) or {}
        diff, where = "", ""
        if self.run.get("git") and t.get("commit"):
            rng = f"{self.run['integration_branch']}...{t['commit']}"
            d = _git_in(self.run["project"], "diff", rng, timeout=120)[1]
            st = _git_in(self.run["project"], "diff", "--stat", rng, timeout=60)[1]
            diff = (f"Commit {t['commit'][:9]} (zrobił go nadzorca), pliki:\n{st}\n" if st else "") + "Zmiany (git diff):\n```diff\n" + d[:20000] + ("\n… (obcięte)" if len(d) > 20000 else "") + "\n```\n"
        if ex.get("worktree") and ex.get("worktree") != m.get("worktree"):
            where = f"Kopia wykonawcy do czytania: {ex['worktree']}\n"
        text = _PROMPT_PRZEGLAD.format(id=t["id"], who=ex.get("name") or t.get("claimed_by"), title=t["title"],
                                       detail=str(t.get("detail") or "")[:3000], result=str(t.get("result") or "")[:3000],
                                       where=where, diff=diff)
        return self._send(m, text, "przeglad", t["id"])

    def _review_turn_end(self, m: dict, blk, text: str, kind: str, tid) -> bool:
        """True, gdy wysłano przypomnienie (członek dalej pracuje)."""
        if blk and blk.get("verdict"):
            self.store.task_review(m["id"], tid, blk.get("verdict"), blk.get("notes") or blk.get("result") or "")
        t = next((x for x in self.store.board()["tasks"] if x["id"] == tid), None)
        if not t or t["status"] != "review" or t.get("reviewer") != m["id"]:
            return False
        if kind == "przeglad" and m.get("status") not in _TEAM_DEAD:
            return self._send(m, _PROMPT_PRZEGLAD_PRZYPOMNIJ.format(id=tid), "przeglad_przyp", tid)
        if m["id"] != "lead" and self.lead_ok():
            self.store.patch_task(tid, reviewer="lead")
        else:
            self.store.task_review("nadzorca", tid, "approve",
                                   _L("Recenzent nie wydał werdyktu; przegląd pominięty. ") + text.strip()[-1500:])
        return False

    # plan i decyzje człowieka
    def _plan_done(self, text: str) -> None:
        if self.pol.get("approve_plan") and not self.run.get("plan_approved") and any(
                t["status"] == "open" for t in self.store.board()["tasks"]):
            self.run["plan_note"] = text.strip()[-2000:]
            self.set_status("waiting_human")
            self._emit_plan()
        else:
            self.set_status("running")

    def _emit_plan(self) -> None:
        self.store.append_event("team_plan", tasks=[t for t in self.store.board()["tasks"] if t["status"] == "open"],
                                note=self.run.get("plan_note") or "", round=int(self.run.get("plan_round") or 0))

    def _plan_decide(self, c: dict) -> None:
        if self.run.get("status") != "waiting_human":
            return
        notes = str(c.get("notes") or "").strip()
        if c.get("approve"):
            if isinstance(c.get("tasks"), list):
                err = self.store.plan_apply("human", c["tasks"])
                if err:
                    self.store.append_event("team_error", tekst=err)
                    return
            self.run["plan_approved"] = True
            self.set_status("running")
        elif notes:
            self.run["plan_notes"] = notes[:4000]
            self.run["plan_round"] = int(self.run.get("plan_round") or 0) + 1
            self.set_status("planning")
        else:
            self.finalize("stopped", _L("Plan odrzucony przez człowieka."))

    def _merge_decide(self, c: dict) -> None:
        t = next((x for x in self.store.board()["tasks"] if x["id"] == str(c.get("task_id") or "")), None)
        if not t or t["status"] != "merge_queue" or (t.get("merge") or {}).get("state") != "waiting_human":
            return
        merge, notes = dict(t.get("merge") or {}), str(c.get("notes") or "").strip()
        if c.get("approve"):
            self.store.patch_task(t["id"], merge={**merge, "state": "queued", "approved": True})
            state = "queued"
        else:
            state = "rejected"
            if notes:
                rv = t.get("review") or {}
                self.store.patch_task(t["id"], status="in_progress", commit="", merge={**merge, "state": ""},
                                      review={"verdict": "changes", "notes": notes[:4000], "by": "human",
                                              "round": int(rv.get("round") or 0)})
            else:
                self.store.patch_task(t["id"], status="cancelled", merge={**merge, "state": ""})
        self.store.append_event("team_merge", task_id=t["id"], member=t.get("claimed_by") or "", state=state,
                                files=merge.get("files") or [], conflicts=[])

    def _member_add(self, spec: dict, by: str) -> None:
        run = self.run
        if len(run["members"]) >= _TEAM_MAX_MEMBERS:
            err = _Lf("Zespół ma już {0} członków (limit).", len(run["members"]))
            self.store.append_event("team_error", tekst=err)
            if by == "lead":
                self.news.append(err)
            return
        m = _team_new_member(run, spec)
        if m["isolation"] == "copy":
            err = _team_worktree_add(run["project"], m["worktree"], m["branch"], run["integration_branch"])
            if err:
                m.update(status="failed", error=err[:400])
            else:
                _team_copy_env(run["project"], m["worktree"])
                self._setup_copy(m["worktree"])
        run["members"].append(m)
        self.emit_member(m)
        self.save(force=True)
        if m["status"] != "failed":
            self._spawn(m, False)
        if by != "lead":
            self.news.append(_Lf("Człowiek dodał do zespołu: {0} ({1}, {2}).", m["id"], m["name"], m.get("role") or ""))

    def _member_stop(self, mid: str, by: str) -> None:
        m = self.member(mid)
        if not m or m.get("status") == "stopped":
            return
        p = self.procs.pop(mid, None)
        if p:
            p.interrupt()
            p.stop(wait=3)
        (self.rt.get(mid) or {})["busy"] = False
        self._drop_asks(mid)
        for t in self.store.board()["tasks"]:
            if t.get("claimed_by") == mid and t["status"] == "in_progress":
                self.store.patch_task(t["id"], status="open", claimed_by="",
                                      assignee="" if t.get("assignee") == mid else t.get("assignee", ""))
            elif t.get("assignee") == mid and t["status"] == "open":
                self.store.patch_task(t["id"], assignee="")
        self.set_member(m, status="stopped", doing="", pid=0, task_id=None)
        if by != "lead" and mid != "lead":
            self.news.append(_Lf("Człowiek zatrzymał członka {0}; jego zadania wróciły na tablicę.", m["name"]))

    def _member_exit(self, m: dict, ev: dict) -> None:
        if self.exit:
            return
        rt = self.rt.get(m["id"]) or {}
        rt["busy"] = False
        self._drop_asks(m["id"])
        for t in self.store.board()["tasks"]:
            if t.get("claimed_by") == m["id"] and t["status"] == "in_progress":
                self.store.patch_task(t["id"], status="failed", result=_L("Proces członka się zakończył."))
                self.news.append(_Lf("{0} {1}: proces członka {2} się zakończył.", t["id"], t["title"], m["name"]))
        tail = ""
        try:
            tail = (self.dir / "log" / f"{m['id']}.err").read_text(encoding="utf-8", errors="replace")[-300:]
        except OSError:
            pass
        self.set_member(m, status="failed", error=(_Lf("Proces zakończył się (kod {0}). ", ev.get("code")) + tail)[:400])

    # limity
    def _emit_budget(self, warn: bool | None = None) -> None:
        b = int(self.pol.get("budget_kr") or 0)
        spent = int(self.run.get("spent_kr") or 0)
        self.store.append_event("team_budget", spent_kr=spent, budget_kr=b, elapsed_s=int(self.elapsed()),
                                hours=self.pol.get("hours") or 0,
                                warn=bool(warn if warn is not None else (b and spent >= 0.8 * b)))

    def _check_limits(self) -> None:
        import time
        b = int(self.pol.get("budget_kr") or 0)
        spent = int(self.run.get("spent_kr") or 0)
        if b and spent >= b:
            self._emit_budget(True)
            self.finalize("over_budget", _Lf("Budżet zespołu wyczerpany: {0} z {1} kr.", spent, b))
            return
        if b and spent >= 0.8 * b and not self.run.get("budget_warned"):
            self.run["budget_warned"] = True
            self._emit_budget(True)
        hours = float(self.pol.get("hours") or 0)
        if hours and self.elapsed() >= hours * 3600:
            self.finalize("timeout", _Lf("Minął limit czasu zespołu ({0} h).", hours))
            return
        minutes = float(self.pol.get("member_turn_minutes") or 0)
        for m in self.run["members"]:
            rt = self.rt.get(m["id"])
            if not rt or not rt["busy"] or rt["killed"]:
                continue
            reason = ""
            if m.get("budget_kr") and int(m.get("spent_kr") or 0) >= m["budget_kr"]:
                reason = _L("budżet członka wyczerpany")
                m["status"] = "over_budget"
            elif minutes and time.monotonic() - rt["t0"] > minutes * 60:
                reason = _Lf("tura trwała ponad {0} min", f"{minutes:g}")
            if reason:
                rt["killed"] = reason
                self.procs[m["id"]].interrupt()
                self.set_member(m, error=reason)

    # przydział
    def _scan_board(self) -> None:
        for t in self.store.board()["tasks"]:
            prev = self.seen.get(t["id"])
            if prev != t["status"]:
                self.seen[t["id"]] = t["status"]
                self.stuck_wakes = 0
                if t["status"] == "cancelled" and prev is not None:
                    for mid, rt in self.rt.items():
                        if rt.get("busy") and rt.get("task") == t["id"] and not rt.get("killed") and mid in self.procs:
                            rt["killed"] = _L("zadanie anulowane")
                            self.procs[mid].interrupt()
                if t["status"] in ("blocked", "failed") and prev is not None:
                    who = (self.member(t.get("claimed_by")) or {}).get("name") or t.get("claimed_by") or ""
                    self.news.append(f"{t['id']} „{t['title']}” ({who}): {_TEAM_TSTATUS_PL.get(t['status'])}. "
                                     f"{str(t.get('result') or t.get('note') or '')[:400]}")

    def _assign(self) -> None:
        working = sum(1 for m in self.run["members"] if m.get("role") != "lead" and (self.rt.get(m["id"]) or {}).get("busy"))
        for m in self.run["members"]:
            if working >= int(self.pol["parallel"]):
                break
            if m.get("role") == "lead" or not self._can_send(m):
                continue
            if int(m.get("turns") or 0) >= int(m.get("max_turns") or 30):
                self.set_member(m, status="over_budget", error=_L("limit tur członka"))
                continue
            if self._start_job(m):
                working += 1
            else:
                board = self.store.board()
                waiting = any(t["status"] == "open" and t.get("assignee") == m["id"] for t in board["tasks"])
                self.set_member(m, status="waiting_deps" if waiting else "idle")

    def _sync(self, m: dict) -> str:
        if not (self.run.get("git") and m.get("isolation") == "copy"):
            return ""
        wt, integ = m["worktree"], self.run["integration_branch"]
        if _git_in(wt, "merge", "--ff-only", "-q", integ)[0] == 0:
            return ""
        if _git_in(wt, *_team_ident(wt), "merge", "--no-edit", "-q", integ, timeout=120)[0] == 0:
            return ""
        _git_in(wt, "merge", "--abort")
        return _Lf("\nUwaga: Twoja kopia nie zsynchronizowała się z gałęzią integracyjną {0} (konflikt). "
                   "Pracuj dalej; scalenie rozwiąże nadzorca.", integ)

    def _start_job(self, m: dict) -> bool:
        rv = self._next_review(m["id"])
        if rv:
            return self._send_review(m, rv)
        board = self.store.board()
        by_id = {t["id"]: t for t in board["tasks"]}
        rework = [t for t in board["tasks"] if t.get("claimed_by") == m["id"] and t["status"] == "in_progress"]
        if rework:
            t = rework[0]
            st, rvw = (t.get("merge") or {}).get("state"), t.get("review") or {}
            kind = "konflikt" if st in ("conflict", "check_failed") else "wznow"
            if st == "conflict":
                text = self._conflict_prepare(m, t)
                if text is None:
                    return self._start_job(m)   # kopia scaliła się bez konfliktu: zadanie wróciło do kolejki
            elif st == "check_failed":
                text = _PROMPT_SPRAWDZENIE.format(id=t["id"], title=t["title"], check=self.pol.get("check"),
                                                  output=str(t["merge"].get("check_output") or "")[-2000:])
            elif rvw.get("verdict") == "changes":
                who = _L("Człowiek") if rvw.get("by") == "human" else (self.member(rvw.get("by")) or {}).get("name") or rvw.get("by")
                info = "" if rvw.get("by") == "human" else _Lf(" (runda {0} z 3)", rvw.get("round"))
                text = _PROMPT_UWAGI.format(id=t["id"], title=t["title"], by=who, info=info, notes=rvw.get("notes") or "")
                kind = "poprawki"
            else:
                text = _PROMPT_WZNOW.format(id=t["id"], title=t["title"], detail=t.get("detail") or "")
            return self._send(m, text, kind, t["id"])
        t, _err = self.store.task_claim(m["id"])
        if not t:
            inbox = [x for x in self.store.inbox(m["id"], mark=False) if x.get("from") in ("human", "lead")]
            if inbox:
                self.store.inbox(m["id"])
                return self._send(m, _PROMPT_WIADOMOSCI.format(inbox=self._fmt_msgs(inbox)), "wiadomosci")
            return False
        sync = self._sync(m)
        deps = ""
        for d in t.get("depends_on") or []:
            dt = by_id.get(d) or {}
            deps += f"\n- {d} „{dt.get('title', '')}”: {str(dt.get('result') or '')[:1500]}"
            if dt.get("status") == "merge_queue" and dt.get("commit") and self.run.get("git") and m.get("isolation") == "copy":
                # merge=at_end: praca zależności jeszcze nie jest w integracji, więc trafia wprost do tej kopii
                wt = m["worktree"]
                if _git_in(wt, *_team_ident(wt), "merge", "--no-edit", "-q", dt["commit"], timeout=120)[0]:
                    _git_in(wt, "merge", "--abort")
                    sync += _Lf("\nUwaga: zmiany z {0} nie weszły do Twojej kopii (konflikt).", d)
        inbox = self.store.inbox(m["id"])
        text = _PROMPT_ZADANIE.format(
            id=t["id"], title=t["title"], detail=t.get("detail") or "",
            files=("Pliki: " + ", ".join(t["files"]) + "\n") if t.get("files") else "",
            deps=("Wyniki zadań, od których zależy to zadanie:" + deps + "\n") if deps else "",
            inbox=("Wiadomości do Ciebie:\n" + self._fmt_msgs(inbox) + "\n") if inbox else "", sync=sync)
        return self._send(m, text, "task", t["id"])

    def _conflict_prepare(self, m: dict, t: dict):
        """Wykonawca scala integrację u siebie: nadzorca zaczyna scalanie (bez commita) i zostawia znaczniki
        konfliktu do rozwiązania. None, gdy kopia scaliła się sama i zadanie wróciło do kolejki."""
        integ = self.run.get("integration_branch")
        if not (self.run.get("git") and m.get("isolation") == "copy"):
            return _PROMPT_WZNOW.format(id=t["id"], title=t["title"], detail=t.get("detail") or "")
        wt = m["worktree"]
        if _git_in(wt, "rev-parse", "-q", "--verify", "MERGE_HEAD")[0] != 0:
            _team_commit_all(wt, f"zespół {t['id']}: przed scaleniem")
            code = _git_in(wt, *_team_ident(wt), "merge", "--no-ff", "--no-commit", integ, timeout=120)[0]
            if code == 0:
                sha = _team_commit_all(wt, f"zespół {t['id']}: scalenie {integ}")
                merge = {**t.get("merge", {}), "state": "queued", "conflicts": []}
                self.store.patch_task(t["id"], status="merge_queue", commit=sha, merge=merge)
                self.store.append_event("team_merge", task_id=t["id"], member=m["id"], state="queued",
                                        files=merge.get("files") or [], conflicts=[])
                return None
        files = _git_in(wt, "diff", "--name-only", "--diff-filter=U")[1].splitlines() or t["merge"].get("conflicts") or []
        return _PROMPT_KONFLIKT.format(id=t["id"], title=t["title"], integ=integ, files=", ".join(files[:30]) or "?")

    def _fmt_msgs(self, msgs: list) -> str:
        return "\n".join(f"- od {x.get('from')}" + (f" ({x['task_id']})" if x.get("task_id") else "")
                         + f": {str(x.get('text') or '')[:2000]}" for x in msgs)

    def _board_text(self) -> str:
        return "\n".join(f"- {t['id']} [{t['status']}] {t['title']} · {t.get('claimed_by') or t.get('assignee') or '-'}"
                         + (f" · po {', '.join(t['depends_on'])}" if t.get("depends_on") else "")
                         for t in self.store.board()["tasks"]) or "- (pusto)"

    def _wake_lead(self) -> None:
        lead = self.lead()
        if not lead or not self._alive(lead) or lead.get("status") in ("failed", "over_budget", "stopped"):
            self.news = []   # bez prowadzącego wieści widać na tablicy i w zdarzeniach
            return
        if not self._can_send(lead):
            return
        rv = self._next_review("lead")
        if rv:
            self._send_review(lead, rv)
            return
        unread = self.store.inbox("lead", mark=False)
        if not (self.news or unread):
            return
        news = list(self.news)
        self.news = []
        if unread:
            self.store.inbox("lead")
            news.append(_L("Wiadomości:") + "\n" + self._fmt_msgs(unread))
        self._send(lead, _PROMPT_WIESCI.format(news="\n".join(f"- {x}" for x in news), board=self._board_text()),
                   "wiesci")

    def _maybe_finish(self) -> None:
        """Koniec, gdy nikt nie pracuje, kolejka scaleń jest pusta i zadania są zamknięte (albo stoją)."""
        if self.merge_thread or self.news or any(rt.get("busy") for rt in self.rt.values()):
            return
        if any(self._alive(m) and not (self.rt.get(m["id"]) or {}).get("ready") for m in self.run["members"]):
            return
        lead = self.lead()
        lead_ok = bool(lead and self._alive(lead) and lead.get("status") not in ("failed", "over_budget", "stopped"))
        if lead_ok and self.store.inbox("lead", mark=False):
            return
        tasks = self.store.board()["tasks"]
        if self.run.get("finish_requested"):
            for t in tasks:
                if t["status"] in ("open", "blocked"):
                    self.store.patch_task(t["id"], status="cancelled")
            tasks = self.store.board()["tasks"]
        queued = [t for t in tasks if t["status"] in ("merge_queue", "merging") and t.get("commit")]
        if queued:
            if self.pol.get("merge") == "at_end" and all((t.get("merge") or {}).get("state") == "queued" for t in queued) \
                    and all(t["status"] in _TEAM_TASK_END + ("merge_queue",) for t in tasks):
                self.set_status("merging")   # merge=at_end: wszystko zrobione, teraz scalenia po kolei
            return
        pending = [t for t in tasks if t["status"] not in _TEAM_TASK_END]
        if pending:
            # nikt nie pracuje, a zadania stoją: raz pytamy prowadzącego, za drugim razem kończymy
            self.stuck_wakes += 1
            if lead_ok and self.stuck_wakes == 1:
                self.news.append(_L("Praca stoi, nikt nie może wziąć tych zadań: ")
                                 + ", ".join(f"{t['id']} ({t['status']})" for t in pending)
                                 + _L(". Dodaj inne zadania albo zakończ."))
                return
            if self.stuck_wakes < 2:
                return
        self.set_status("finishing")
        if not lead_ok:
            self.finalize()

    # scalanie
    def _merge_start(self) -> None:
        import threading as _th
        if self.merge_thread or not self.run.get("git"):
            return
        if self.pol.get("merge") == "at_end" and self.run.get("status") != "merging":
            return
        queued = sorted([t for t in self.store.board()["tasks"] if t["status"] == "merge_queue" and t.get("commit")
                         and (t.get("merge") or {}).get("state") in ("queued", "")],
                        key=lambda t: t.get("updated") or "")
        if not queued:
            return
        t = queued[0]
        m = self.member(t.get("claimed_by")) or {"id": t.get("claimed_by"), "name": t.get("claimed_by")}
        t = self.store.patch_task(t["id"], status="merging", merge={**t.get("merge", {}), "state": "merging"})
        self.store.append_event("team_merge", task_id=t["id"], member=m["id"], state="merging", files=[], conflicts=[])
        self.merge_thread = _th.Thread(target=self._merge_job, args=(t, m), daemon=True)
        self.merge_thread.start()

    def _merge_job(self, t: dict, m: dict) -> None:
        integ = self.run["integration_path"]
        res = {"task": t["id"], "member": m["id"], "conflicts": [], "check_output": "", "sha": ""}
        res["files"] = _git_in(integ, "diff", "--name-only", f"HEAD...{t['commit']}")[1].splitlines()[:200]
        code, _o, err = _git_in(integ, *_team_ident(integ), "merge", "--no-ff", "-m",
                                f"zespół: {t['id']} {t['title']} ({m.get('name')})", t["commit"], timeout=300)
        if code:
            u = _git_in(integ, "diff", "--name-only", "--diff-filter=U")[1].splitlines()
            _git_in(integ, "merge", "--abort")
            res.update(state="conflict", conflicts=u[:50] or res["files"][:50], check_output=err[-1000:])
            self.merge_result = res
            return
        res["sha"] = _git_in(integ, "rev-parse", "HEAD")[1]
        check = str(self.pol.get("check") or "").strip()
        if check:
            self.store.append_event("team_merge", task_id=t["id"], member=m["id"], state="checking",
                                    files=res["files"], conflicts=[], sha=res["sha"])
            try:
                r = subprocess.run(check, shell=True, cwd=integ, capture_output=True, text=True, errors="replace",  # nosec B602: polecenie z szablonu użytkownika
                                   timeout=int(float(self.pol.get("check_timeout") or 15) * 60),
                                   stdin=subprocess.DEVNULL)
                rc, out = r.returncode, (r.stdout or "") + (r.stderr or "")
            except subprocess.TimeoutExpired:
                rc, out = 124, _L("Przekroczony limit czasu sprawdzenia.")
            except OSError as exc:
                rc, out = 127, str(exc)
            if rc != 0:
                _git_in(integ, "reset", "--hard", "-q", "HEAD~1")
                res.update(state="check_failed", check_output=out[-3000:], sha="")
                self.merge_result = res
                return
        res["state"] = "merged"
        self.merge_result = res

    def _merge_poll(self) -> None:
        if not self.merge_thread or self.merge_thread.is_alive():
            return
        self.merge_thread, res = None, self.merge_result
        self.merge_result = None
        if not res:
            return
        t = next((x for x in self.store.board()["tasks"] if x["id"] == res["task"]), None)
        if not t:
            return
        merge = {**(t.get("merge") or {}), "state": res["state"], "sha": res["sha"], "conflicts": res["conflicts"],
                 "check_output": res["check_output"] if res["state"] == "check_failed" else ""}
        if res["state"] == "merged":
            self.store.patch_task(t["id"], status="done", merge=merge)
        elif int(t.get("attempts") or 0) >= 3:
            self.store.patch_task(t["id"], status="failed", merge=merge,
                                  result=(t.get("result") or "") + _L(" (scalenie nie wyszło po 3 próbach)"))
        else:
            self.store.patch_task(t["id"], status="in_progress", merge=merge, commit="",
                                  attempts=int(t.get("attempts") or 0) + 1)
        self.store.append_event("team_merge", task_id=t["id"], member=res["member"], state=res["state"],
                                files=res["files"], conflicts=res["conflicts"], sha=res["sha"],
                                **({"check_output": res["check_output"][-3000:]} if res["state"] == "check_failed" else {}))

    # prompty
    def _prompt_plan(self) -> str:
        tasks = self.store.board()["tasks"]
        start = ("\nNa tablicy są już zadania startowe:\n" + self._board_text()) if tasks else ""
        lead = self.lead() or {}
        text = _PROMPT_PLAN.format(goal=self.run["goal"], max=_TEAM_MAX_TASKS, roster=self.roster(), start=start)
        return text + (("\n\nWskazówki prowadzącego:\n" + lead["instructions"]) if lead.get("instructions") else "")

    def _prompt_koniec(self) -> str:
        res = "\n".join(f"- {t['id']} „{t['title']}” [{t['status']}]: {str(t.get('result') or '')[:800]}"
                        for t in self.store.board()["tasks"]) or "- (brak zadań)"
        check = self.pol.get("check")
        return _PROMPT_KONIEC.format(path=self.lead().get("cwd") if self.lead() else "", results=res,
                                     check=(f"Polecenie sprawdzające: `{check}`. Uruchom je na końcu.\n" if check else ""))

    # zakończenie
    def stop_all(self) -> None:
        self.exit = True
        for p in list(self.procs.values()):
            if p.alive():
                p.interrupt()
        for p in list(self.procs.values()):
            p.stop()

    def pause(self) -> None:
        self.run["paused_from"] = self.run.get("status") if self.run.get("status") != "paused" else "running"
        self.stop_all()
        for mid, rt in self.rt.items():
            self._drop_asks(mid)
        for m in self.run["members"]:
            if m.get("status") not in ("failed", "over_budget", "stopped"):
                m.update(status="idle", doing="", pid=0)
                self.emit_member(m)
        self.run["supervisor_pid"] = 0
        self.set_status("paused")

    def finalize(self, status: str | None = None, reason: str = "") -> None:
        if self.run.get("status") in _TEAM_RUN_END:
            self.exit = True
            return
        self.stop_all()
        for m in self.run["members"]:
            if m.get("status") not in ("failed", "over_budget"):
                m.update(status="done" if not status else "stopped", doing="", pid=0)
                self.emit_member(m)
        for mid in list(self.rt):
            self._drop_asks(mid)
        run = self.run
        diff = {"files": 0, "added": 0, "removed": 0}
        if run.get("git"):
            diff = _team_diff_stat(run["project"], run["base_sha"], run["integration_branch"])
        options = ["merge", "branch"] if run.get("git") and diff["files"] else []
        if options and _git_in(run["project"], "remote", "get-url", "origin")[0] == 0:
            options.append("pr")
        final = status or ("review_final" if options else "done")
        if not run.get("summary"):
            done = [t for t in self.store.board()["tasks"] if t["status"] == "done"]
            run["summary"] = "\n".join(f"{t['id']} {t['title']}: {str(t.get('result') or '')[:400]}" for t in done)
        if reason:
            run["summary"] = (reason + "\n\n" + run["summary"]).strip()
        run["finished"] = _team_now()
        run["pending_asks"] = []
        run["supervisor_pid"] = 0
        self.set_status(final)
        merged = [t["id"] for t in self.store.board()["tasks"] if (t.get("merge") or {}).get("state") == "merged"]
        self.store.append_event("team_done", status=final, summary=run["summary"], spent_kr=run.get("spent_kr") or 0,
                                seconds=int(self.elapsed()), diff_stat=diff, apply_options=options, merged=merged,
                                source=run.get("source") or {})
        if final == "review_final" and self.pol.get("approve_merge") == "never":
            team_apply(self.dir, "merge", by="nadzorca")


def team_supervise(run_dir) -> int:
    """codo team supervise --dir DIR: proces nadzorcy (wewnętrzne)."""
    import signal
    import traceback
    store = TeamStore(run_dir)
    run = store.load_run()
    if not run:
        print(_Lf("✗ Nie ma przebiegu zespołu w {0}", run_dir))
        return 1
    if run.get("supervisor_pid") != os.getpid() and _team_sup_alive(run):
        print(_L("✗ Ten zespół ma już działającego nadzorcę."))
        return 1
    sup = TeamSupervisor(run_dir)
    if not IS_WIN:
        signal.signal(signal.SIGTERM, lambda *_a: store.control(type="pause", by="nadzorca"))
    try:
        if sup.boot():
            sup.loop()
    except Exception as exc:  # noqa: BLE001 — błąd nadzorcy kończy przebieg z opisem zamiast wisieć
        traceback.print_exc()
        try:
            sup.finalize("failed", _Lf("Błąd nadzorcy: {0}", exc))
        except Exception:  # noqa: BLE001
            pass
        return 1
    finally:
        sup.stop_all()
    return 0


# ── po zakończeniu: scalenie do projektu i sprzątanie ──

def team_apply(run_dir, how: str = "merge", by: str = "terminal", title: str = "") -> dict:
    store = TeamStore(run_dir)
    run = store.load_run()

    def out(ok: bool, detail: str, **extra) -> dict:
        ev = store.append_event("team_applied", how=how, ok=ok, detail=detail, **extra)
        if ok:
            run["status"] = "applied" if how == "merge" else run.get("status")
            run["applied"] = {"how": how, "by": by, "ts": _team_now(), **extra}
            store.save_run(run)
        return ev
    if run.get("status") not in ("review_final", "done", "stopped", "over_budget", "timeout", "failed", "applied"):
        return out(False, _L("Zespół jeszcze pracuje. Poczekaj na koniec albo go zatrzymaj."))
    if not run.get("git"):
        return out(False, _L("Zespół pracował bez kopii: zmiany są już w folderze projektu."))
    if run.get("applied", {}).get("how") == "merge":
        return out(False, _L("Zmiany zespołu są już scalone do projektu."))
    integ = run.get("integration_branch")
    if not _team_diff_stat(run["project"], run.get("base_sha") or "HEAD", integ)["files"]:
        return out(False, _L("Zespół nie zostawił zmian do scalenia."))
    if how == "branch":
        return out(True, _Lf("Zmiany zostają na gałęzi {0}.", integ))
    if how == "pr":
        body = (str(run.get("summary") or "").strip() + "\n\n" + _Lf("Cel zespołu: {0}", run.get("goal") or "")).strip()
        try:
            r = pr_create(title or "Codo: " + _team_short_title(str(run.get('goal') or run.get('name') or '')), body,
                          branch=integ, base=run.get("base_branch") or "", repo=run["project"])
        except (ValueError, OSError, subprocess.SubprocessError) as exc:
            return out(False, str(exc))
        return out(True, _Lf("PR gotowy: {0}", r.get("url") or integ), pr_url=r.get("url") or "", branch=integ)
    if how != "merge":
        return out(False, _L("Wybierz scalenie, gałąź albo PR."))
    proj = run["project"]
    if _git_in(proj, "status", "--porcelain", "--untracked-files=no")[1].strip():
        return out(False, _Lf("W projekcie są niezatwierdzone zmiany w śledzonych plikach. Zatwierdź je albo odłóż "
                              "(git stash) i spróbuj ponownie, albo zostaw pracę zespołu na gałęzi {0}.", integ))
    code, _o, err = _git_in(proj, *_team_ident(proj), "merge", "--no-ff", "-m",
                            f"Codo: zespół {run.get('name')}: {str(run.get('goal') or '')[:60]}", integ, timeout=300)
    if code:
        _git_in(proj, "merge", "--abort")
        return out(False, _Lf("Konflikt z nowszymi zmianami w projekcie. Praca zespołu zostaje na gałęzi {0}; "
                              "scal ją ręcznie albo przez PR.", integ) + (" " + err[-300:] if err else ""))
    return out(True, _Lf("Scalono gałąź {0} do projektu.", integ), sha=_git_in(proj, "rev-parse", "HEAD")[1])


def team_cleanup(run_dir, keep_branches: bool = False) -> dict:
    store = TeamStore(run_dir)
    run = store.load_run()
    if run.get("status") not in _TEAM_RUN_END + ("paused",) or _team_sup_alive(run):
        return {"ok": False, "detail": _L("Zespół jeszcze pracuje. Zatrzymaj go najpierw (codo team stop).")}
    removed, left = 0, []
    if run.get("git"):
        proj = run["project"]
        paths = [m["worktree"] for m in run.get("members") or [] if m.get("isolation") == "copy"]
        paths.append(run.get("integration_path"))
        for p in dict.fromkeys(x for x in paths if x):
            if Path(p).exists() and _git_in(proj, "worktree", "remove", "--force", p, timeout=120)[0] == 0:
                removed += 1
        _git_in(proj, "worktree", "prune")
        branches = [m["branch"] for m in run.get("members") or [] if m.get("branch")] + [run.get("integration_branch")]
        for b in branches if not keep_branches else []:
            if b and _git_in(proj, "branch", "-d", b)[0] != 0 and _git_in(proj, "rev-parse", "--verify", "-q", b)[0] == 0:
                left.append(b)   # niescalona gałąź zostaje (git branch -d jej nie usuwa)
    run["cleaned"] = True
    store.save_run(run)
    return {"ok": True, "removed": removed, "branches_left": left,
            "detail": _Lf("Usunięto kopie: {0}.", removed) + (_Lf(" Niescalone gałęzie zostały: {0}", ", ".join(left)) if left else "")}


def _team_runs_list(cwd=None) -> list:
    base = _team_root(cwd) / ".doma" / "zespoly"
    out = []
    try:
        dirs = [d for d in base.iterdir() if (d / "run.json").exists()]
    except OSError:
        dirs = []
    for d in dirs:
        run = TeamStore(d).load_run()
        if not run:
            continue
        out.append({"run_id": run.get("id") or d.name, "name": run.get("name") or "", "goal": run.get("goal") or "",
                    "status": run.get("status") or "", "spent_kr": run.get("spent_kr") or 0,
                    "updated": run.get("updated") or "", "created": run.get("created") or "",
                    "resumable": run.get("status") in _TEAM_RESUMABLE and not _team_sup_alive(run)})
    out.sort(key=lambda r: r["created"], reverse=True)
    return out


def _team_find(ident: str | None, cwd=None) -> tuple:
    runs = _team_runs_list(cwd)
    if not runs:
        return None, _L("W tym folderze nie było jeszcze zespołu. Zacznij: codo team run \"cel\"")
    if not ident:
        return _team_root(cwd) / ".doma" / "zespoly" / runs[0]["run_id"], ""
    hit = [r for r in runs if r["run_id"] == ident] or [r for r in runs if ident in r["run_id"]]
    if len(hit) != 1:
        return None, _Lf("Nie ma jednoznacznego zespołu {0}. Lista: codo team", ident)
    return _team_root(cwd) / ".doma" / "zespoly" / hit[0]["run_id"], ""


def _team_resume(run_dir) -> str:
    run = TeamStore(run_dir).load_run()
    if run.get("status") not in _TEAM_RESUMABLE:
        return _Lf("Tego zespołu nie da się wznowić (stan: {0}).", run.get("status"))
    if _team_sup_alive(run):
        return _L("Nadzorca tego zespołu wciąż działa.")
    _team_spawn_supervisor(run_dir)
    return ""


