def _clean_agent(msg: dict) -> dict:
    """Pola z kreatora, sprawdzone tak samo jak na serwerze."""
    hexok = lambda v: isinstance(v, str) and re.fullmatch(r"#[0-9A-Fa-f]{6}", v) is not None  # noqa: E731
    name = " ".join(str(msg.get("name") or "").split())[:24]
    if len(name) < 2:
        raise ValueError(_L("Imię agenta musi mieć co najmniej 2 znaki."))
    colors = [c for c in (msg.get("colors") or []) if hexok(c)][:5]
    color = msg.get("color") if hexok(msg.get("color")) else (colors[0] if colors else "#7C5CFF")
    shares = [max(1, min(100, int(x))) for x in (msg.get("shares") or []) if isinstance(x, (int, float))][:5]
    if len(shares) != len(colors):
        shares = []
    tone = msg.get("tone") if msg.get("tone") in _TONY_AGENTA else "rzeczowy"
    traits, seen = [], set()
    for c in msg.get("traits") or []:
        k = str(c).split(":")[0]
        if c in _CECHY_AGENTA and k not in seen:
            seen.add(k)
            traits.append(c)
    eyes = msg.get("eyes") if hexok(msg.get("eyes")) else ""
    shape = msg.get("shape") if msg.get("shape") in _KSZTALTY_AGENTA else "kula"
    return {"agent": name, "kolor_agenta": color, "kolory_agenta": colors or [color], "udzialy_kolorow": shares,
            "kolor_oczu": eyes, "przezroczystosc": max(0, min(80, int(msg.get("transparency") or 0))),
            "przezroczystosc_plynu": max(0, min(90, int(msg.get("glass") or 0))), "ton": tone, "cechy": traits,
            "prompt": str(msg.get("prompt") or "").strip()[:2000], "ksztalt": shape}


